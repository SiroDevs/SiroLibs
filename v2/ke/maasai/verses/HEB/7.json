          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olapolosani oji Melkisedek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.17+GEN.14.18+GEN.14.19+GEN.14.20"
              },
              "items": [
                {
                  "text": "Enk 14.17-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amu ore ele oji Melkisedek, olaiguanani le Salem, naa olapolosani le Enkai, netii shumata te pooki, netanang'are ninye Abraham eshukunye aing'uaa enjore natimirie laiguanak, nemayian ninye; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa ninye etoorikia Abraham ematua e tomon e pooki toki. Eituruk ninye, te newaluni enkarna enye, aa olaiguanani le supatisho, naa olaiguanani le Salem, eji Olaiguanani le seriani. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.2",
            "verseOrgIds": [
              "HEB.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeta ninye menye anaa ng'otonye, nemeeta entipat, nemeeta eneiting'ie enkishui enye, kake etiu anaa ilo Oinoti le Nkai, ora olapolosani ntarasi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ura eneba enkitoo enye! Eishoo papa lang Abraham ninye ematua e tomon oo yarunot. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Enki 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naa ore lelo le ishoi e Lawi oong'amu empolosare neetae naitanapaki ti atua nkitanapat meishoo olorere ninche ematua e tomon, naaton lalashera lenye, hoo naa le ishoi e Abraham sii ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ematua e tomon naishoo Abraham nemayian ninye ilo apa otang'amua nkisiligat. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.6",
            "verseOrgIds": [
              "HEB.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metii enchankar inchere olkitok ake omayian oloti, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te ne, iltung'ana ooyooki aaye, oong'amu ematua e tomon, ore te ine, naa ilo obo oitadedeyieki aajo keishu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keidim doi ninye oltung'ani atejo ore ninye Lawi makewan, oishoro metang'amu ematua e tomon, eishooyie ematua e tomon te Abraham, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.9",
            "verseOrgIds": [
              "HEB.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu eton apa etioyo too sapo too sapo e nkakuyiaa lenye pee enang'are Abraham Melkisedek.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore taata te naa ketumoyu apa bayaroti te mpolosare oo le Lawi, amu te ninye etang'amutua ilo orere nkitanapat, ainyoo eitokini aayieunye likae apolosani olotu to lkerreti le Aron? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.11",
            "verseOrgIds": [
              "HEB.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu te neibelekenyi lapolosak neibelekenyi sii ninche nkitanapat. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.12",
            "verseOrgIds": [
              "HEB.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore ele oimaki kuna baa naa ole likae osho lemeeta ninche ae kata oltung'ani lenye otopolosishe to lperere lo lasar. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.13",
            "verseOrgIds": [
              "HEB.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eibala olosho le Yuda etoikioki Olaitoriani lang, naa ore te ilo osho, neitu ejo Musa ae naipirta ilapolosak.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olikae apolosani onyaanyukie Melkisedek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keitoki ena bae awang'u oleng te neinyototo likae apolosani lo rreikie le Melkisedek, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ajo eitaaki olapolosani neme to rrekie loo nkitanapat anaa te ntipat o sesen ake eeta engolon, kake te nkidimata enkishui nemeidimi aaishie. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Olke 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eitaikiaki ninye shakenisho nchere, “Iraiyie olapolosani ntarasi to rrekie le Melkisedek.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nabo alo, eiwuang'ieki enapa kitanapata naituruku te nkaraki nashal nemeeta dupoto, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu meetae entoki naiputakine te nkaraki nkitanapat, ore te nkae alo, eyawuaki osiligi oikash, laa te ninye kinyikaki iyiook Enkai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitu easi ina metii olmumai. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Olke 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore lelo apa ooitera aaku ilapolosak netaa metii olmumai, kake ore ele netolimuoki to lmumai, “Einosa Olaitoriani olmumai nemeibelekeny enatejo inchere, ‘Ira iyie olapolosani intarasi.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena naishoo Yesu meitadedeyie osotua olusoo to likae.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lapa apolosak ooiturukutuo naa kumok esiana enye, amu etomitikio enkeeya ebikoo te mpolosare; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake eibung'ita ninye empolosare enye nemeiting, amu ebik ninye intarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.24",
            "verseOrgIds": [
              "HEB.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina pee eidim ninye aitajeu nkatitin pooki lelo ooimu ninye epuonu aanyikaki Enkai, amu eishu oshi ake ninye netumoki atoomonoki ninche.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
