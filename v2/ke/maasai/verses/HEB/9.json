          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neme keitoki ninye aigiligil aishooyo kewan, anaa enaiko ilo apolosani kitok ejing atua ine Wueji Sinyati anaake to lari eeta osarge leme o lenye; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
