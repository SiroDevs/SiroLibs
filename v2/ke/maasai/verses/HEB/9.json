              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore doi ninye ilo sotua le dukuya neeta apa irrekiei le seremare o ewueji sinyati e nkop. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
