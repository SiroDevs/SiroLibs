              "items": [
                {
                  "text": "Ena 24.6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore apa, keimaki ake Musa enkitanapata ake pooki enena aliki olorere nedumu osarge loo lasho o loo lkineji, te nebo enkare olpapit oonyokie loo ntare o lchani oji hisop, neisuaaki embuku kewan o lelo tung'ana pooki, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejoito, “Osarge ele lo sotua oitanapa intae Enkai.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
