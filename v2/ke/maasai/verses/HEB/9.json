              "items": [
                {
                  "text": "Ilaw 8.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neiko sii neijia ilo sarge eisuaaki kunda pokira are, ilo ng'obor o ntokitin pooki naasishoreki te seremare. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
