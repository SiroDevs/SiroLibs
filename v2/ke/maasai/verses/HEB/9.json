              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore anaa enaitanapishoteki metuata iltung'ana nabo kata ake, ore pee elusoo ina nelotu enkiguana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
