          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eitu eitijing'i Kristo, ewueji sinyati naitobiraki too nkaik naa enkitanyaanyukoto ake e idia nasipa, kake atua shumata kewan, paa keitashe taata te dukuya Enkai terishata ang.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        }
      ]
    },
