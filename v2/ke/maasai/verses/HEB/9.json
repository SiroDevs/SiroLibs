              },
              "items": [
                {
                  "text": "23.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eitobiraki olng'obor li oriong, laa atua ninye etii olkilang'et o emesa omukateni e nkitoduaaroto; neji ine Ewueji Sinyati. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ena 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore ti oriong olkarasha li aare neitashe olng'obor oji Sinyati Oleng, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
