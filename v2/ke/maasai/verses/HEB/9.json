                  "text": "Ilaw 17.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Esipa nchere, ore to lkerreti loo nkitanapat o sarge apake eipoki pooki toki to sarge, naa ore eitu eibukori osarge nemeetae empalakinoto oo ng'ok.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        }
