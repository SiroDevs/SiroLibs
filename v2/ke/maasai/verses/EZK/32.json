          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Etii sii ilkituaak le moikuape ine ninche pooki tenebo ile Sidon pooki lelo ooshomo abori te nkurruna tenebo lelo ootaraki, tenebo ina kirutoto pooki nayautua te nkaraki olkirutoto lenye eirragie ninche memurata tenebo lelo ootaraki to lalem, nenap enkurruna enye tenebo lelo oodoyio aapuo enemeneng'a engumoto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
