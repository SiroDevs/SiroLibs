            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eti sii Elam ine, nemanita ninye olorora lenye pooki enkurare enye; netaraki pooki, aabatat to lalem, lelo lememurata ooshomo atua olodo le nkop, lelo oidapashaa olkirutoto teina kop oo loishu, neya enkurruna enye tenebo lelo oopuo abori eng'umoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitobirakita ninye endapash tenebo lelo ootaraki to lalem tenebo olorara nemanita ninye inkuraren enyena, lelo pooki lememurata lelo ootaraki to lalem; amu eidapashakaki olkirutoto lenye ninche ina kop oo looishu, nenap ninche enkurruna enye tenebo lelo oopuo adoyio aapuo eitaboitakaki ninche lelo ootaraki to lalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
