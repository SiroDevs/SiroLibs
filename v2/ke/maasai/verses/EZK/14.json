            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.8"
              },
              "items": [
                {
                  "text": "Emb 6.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Amu neijia ejo Olaitoriani Enkai: Kebaa elang tenairriwaki Yerusalem nena kitamiot aainei ong'uan enkiguana, olalem, olameyu, ing'uesi torrok o lmeitai, pee adung'oo tung'ani o eng'ues tiatua! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake eyia, tenelo neing'uari tiatua ilooleku pee erik aaipang'ie ilayiok o ntoyie, tenepuo nepuonu enitii nidol inkoitoi enye o yasat enye, naa aikintagoli iyie teina torrono nayau shumata e Yerusalem, te nena pooki nayaua shumata ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.22",
            "verseOrgIds": [
              "EZK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa keitagol ninche intae, tinidolidolo inkoitoi enye o yasat enye; niyiolouu aajo eitu aas ina meeta enataasie pooki nataasa te ninye, ejo Olaitoriani Enkai.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.23",
            "verseOrgIds": [
              "EZK.14.23"
            ]
          }
        }
      ]
    }
