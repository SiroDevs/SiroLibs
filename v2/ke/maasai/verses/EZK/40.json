          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilgilat lenyena loo mbat, o ng'apeta enyena, tenebo ilgorieti lenyena nerisioro o lkulikae; neeta ilusien naamanita, ore enkadori enye naa intemat e nkaina tikitam o imiet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
