              "EZK.40.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.1+1KI.6.2+1KI.6.3+1KI.6.4+1KI.6.5+1KI.6.6+1KI.6.7+1KI.6.8+1KI.6.9+1KI.6.10+1KI.6.11+1KI.6.12+1KI.6.13+1KI.6.14+1KI.6.15+1KI.6.16+1KI.6.17+1KI.6.18+1KI.6.19+1KI.6.20+1KI.6.21+1KI.6.22+1KI.6.23+1KI.6.24+1KI.6.25+1KI.6.26+1KI.6.27+1KI.6.28+1KI.6.29+1KI.6.30+1KI.6.31+1KI.6.32+1KI.6.33+1KI.6.34+1KI.6.35+1KI.6.36+1KI.6.37+1KI.6.38"
              },
              "items": [
                {
                  "text": "1 Ilai 6.1-38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.1+2CH.3.2+2CH.3.3+2CH.3.4+2CH.3.5+2CH.3.6+2CH.3.7+2CH.3.8+2CH.3.9"
              },
              "items": [
                {
                  "text": "2 Int 3.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naa ng'ura, etii apa esuntai namanita ine wueji e oriong netii enkaji e Nkai, ore enkadori e ina tiyani natemishoreki natii enkaina e ilo tung'ani naa intemat ile enkaina enkadori, ore pooki nabo enye naa entemata enkaina nabo o endap te nkadori; metaa etetema ina kirrushai eina suntai, naa entiyani nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.5",
            "verseOrgIds": [
              "EZK.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ninye alo ina kishomi naipirare oloosaen, eilep too nkedeta enyena, neipim entonata eina kishomi, entiyani nabo eng'uton; o lgilat oomanita, entiyani nabo enkadori, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.6",
            "verseOrgIds": [
              "EZK.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ilgilat loo mbaat naa entiyani nabo enkadoro ore erishata e lelo gilat loo mbaat naa intemat emiet e nkaina; ore ine neitasheyie ina kishomi te mbata o lgoriet tenejing'ieki kishomi naa entiyani nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.7",
            "verseOrgIds": [
              "EZK.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ninye atem olgoriet le kishomi, intemat enkaina isiet; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.8",
            "verseOrgIds": [
              "EZK.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tenebo ineeitasheyie enyena, intemat are enkaina; ore olgoriet le kishomi netii enkalo enkiting'oto e atua e kishomi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.9",
            "verseOrgIds": [
              "EZK.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii ilgilat pokira okuni loo mbaat inkaloli pokira e kishomi oloosaen; ore nena pokira uni nerisio pooki; ore ing'apeta oo nkaloli pokira nerisioro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.10",
            "verseOrgIds": [
              "EZK.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina peyie etem endapasho eine nebolieki kishomi, intemat tomon; o endapasho e ina kishomi, intemat tomon oo kuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.11",
            "verseOrgIds": [
              "EZK.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii apa enerisha dukuya lelo gilat okuni loo mbat naa entemata nabo enkaina te pooki shoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.12",
            "verseOrgIds": [
              "EZK.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina peyie atem ina kishomi tioriong enkalo olgilata obo ometabaiki oriong olikae, neeta endapasho o ntemat imiet o ntemat tikitam eiteru te kutuk aji ometabaiki enkae kutuk aji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.13",
            "verseOrgIds": [
              "EZK.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ake sii atem olgoriet, intemat tikitam enkaina; ore ine emanaroto e ilo goriet netii olodung'oro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.14",
            "verseOrgIds": [
              "EZK.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te dukuya ina kishomi teine nejing'ieki o metabaiki ine enkiting'oto olgoriet liatua leina kishomi naa intemat onom. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.15",
            "verseOrgIds": [
              "EZK.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ine wueji nejing'ieki kishomi neeta ilusien naamanita naapirik ijing atua nena ng'apeta enye tiatua lelo gilat loo mbat, neeta ake sii ilo goriet ilusien naamanita tiatua, ore too ng'apetae kutuk aji netii iltuka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endung'oroto e oriong",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naariku nanu atua endung'oroto e oriong; naa ng'ura, etii ilgilat olgos o manaa teilo odung'oro; ilgilat tomoni uni ootii dukuya ilo gos. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.17",
            "verseOrgIds": [
              "EZK.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neim ilo gos embata nena shomito, eipirare ina adori e nena shomito; ele apa olgos le abori. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ninye atem enkadori eiteru tiatua tenkalo e dukuya enkalo e atua eina kishomi e abori o metabaiki oriong tenkalo e dukuya ea atua olgoriet, intemat iip nabo enkaina.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kishomi e moikuape",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neituruk ninye te dukuya nanu alo enkalo e moikuape, naa ng'ura etii apa enkishomi naing'orita enkalo e moikuape, enaa ene nkalo olodung'oro lioriong. Netem enkadori enye o endapasho enye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.20",
            "verseOrgIds": [
              "EZK.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lgilat lenyena loo mbat, okuni ake te pooki matua, o ng'apeta enyena tenebo olgorieti lenye laa erisiori o nekua e kishomi e dukuya; ore enkadori naa intemat enkaina onom o imiet. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.21",
            "verseOrgIds": [
              "EZK.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilusien enyena, o lgorieti enyena, tenebo iltuka lenyena naa erisiori nabo anaa lelo leina kishomi ina naing'orita enkalo oloosaen; naa inkedeta naapishana ninche naailepaki ine; netii olgoriet atua ine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.22",
            "verseOrgIds": [
              "EZK.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore tenkae alo naipirare kishomi tenkalo e moikuape, anaa enatiu tenkalo o loo ntoluo netii enkishomi natii atua olgoriet; netem eiteru te kishomi o metabaiki kishomi, intemat e nkaina iip nabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.23",
