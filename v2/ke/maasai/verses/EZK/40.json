          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii ilgorieti oomanita, intemat e nkaina tikitam o imiet enkadori naa intemat imiet endapasho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olgoriet lenye neipirare olodung'oro li oriong netii iltuka ing'apeta enyena, ore enekedieki enye neeta inkedeta isiet.",
          "type": "text",
          "attrs": {
