              "EZK.43.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Ena 27.1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.1"
              },
              "items": [
                {
                  "text": "2 Ilai 4.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kuna ninche ntemat olperere lo lasar too ntemat (entemata enkaina nalulung'a o ndapasho enkaina.) Ore entonata enye naa keaku entemata enkaina nabo eilep naa entemata enkaina nabo endapasho, tenebo enkamanaa nabo namanita osegel lenye. Naa ena ninye naaku enkadori olperere lo lasar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eiteru te ntonata enkop o metabaiki enkedet enye e abori, naa intemat are enkaina, neeta endapasho entemata enkaina nabo; ore eiteru te nkedet kiti o metabaiki enkedet sapuk, naa intemet ong'uan e nkaina, neeta endapasho entemet enkaina nabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ewueji enkima olperere lo lasar, naa intemat ong'uan enkaina; ore epuku te wueji enkima olperere lo lasar eilep shumata naa imowuarak ong'uan entemata nabo enkaina eilep. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ine wueji enkima olperere lo lasar naa keaku kerisioro pooki intemat tomon aare enkaina enkadoro, naa intemat tomon oare enkaina endapasho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore sii ninye enkedet naa kerisioro te pooki aloli, intemat enkaina tomon oong'uan enkadoro, naa intemat enkaina tomon oong'uan endapasho, neeta enkamanaa namanita ninye olpisiai le ntemata e nkaina endapasho, ore entonata enye naa entemata nabo e nkaina emanita. Ore inkedeta e ilo perere lo lasar neipirare enkalo o loosaen.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkitisinyata olperere lo Lasar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki ninye nanu, “Enkerai e tung'ani, inji ejo Olaitoriani Enkai: Kuna ninche inkitanapat naaipirta olperere lo lasar: Ore teina olong naitasheyieki ninye peyie eitaini olasar opejori teshumata ninye o pee ebukokini osarge shumata ninye, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "incho ilo apolosani loo Lawi lolmarei le Sadok, ilo laanyikaki nanu aisiai, ejo Olaitoriani Enkai oloing'oni meitainyie olasar le ng'oki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa iya iyie embata osarge lenye, nipik ninye nena mowuarak ong'uan o lperere lo lasar, nipik ilpijat oong'uan le nkedet, nipik ina amanaa aitaman neaku neijia inko tinimpok olperere lo lasar aitisiny, nintayu olning'o lo sotua te ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iya sii ilo oing'oni lo lasar le ng'oki, nepeji ninye te ine wueji negeluno e nkaji e Nkai, tiauluo ine wueji nesinya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkolong e are nintayu oloro lemeeta entioto te nkaraki olasar le ng'oki; naa keipoki olperere lo lasar, anaa apa peyie eipoki te ilo oing'oni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore peyie indip aipoo ninye, nintayu oloing'oni lemeeta entioto olmeregesh oing'uaa intare nemeeta entioto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninchooyo ninche te dukuya Olaitoiriani, naa keisuaaki ilapolosak emunyan shumata ninche neitayu ninche anaa olasar opejori aitaiki Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too nkolong'i naapishana, naa intayu anaake enkine te nkaraki olasar le ng'oki, tenebo oloing'oni tenebo olmeregesh oing'uaa intare, lemeeta entioto, ninye eitaini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitayu ninche olasar lo lning'o lo sotua too nkolong'i naapishana te nkaraki olperere lo lasar aipok ninye aitisiny, neiteng'elakini ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
