          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
