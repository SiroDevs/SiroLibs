                }
              ]
            }
          ]
        },
        {
          "text": " Nelotu ororei lo Laitoriani enatii naajoki: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Enkerai e tung'ani, intorioki enkomom ino enkalo e Sidon, nimbonoki aarare ninye ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nijo inji ejo Olaitoriani Enkai: Ing'ura ajo kaarare iyie, oi iyie Sidon, naa kaibalie enkitoo ai tiatua iyie, naa keyiolou ninche aajo ara nanu Olaitoriani, ina kata nayau inkiguanat shumata ninye, naibalunye esinyatisho ai tiatua ninye; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu kairriu olmeitai atua ninye, nairriwaki osarge inkoitoi enyena naalala enkanasa; ore lelo oari to lalem nebatata tiatuaninye, te ilo alem oarare ninye too nkaloli pooki. Ina pee eyiolou ninche aajo ara nanu Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        }
      ]
    },
