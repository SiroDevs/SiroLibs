              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.16",
            "verseOrgIds": [
              "PHP.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.16"
              },
              "items": [
                {
                  "text": "1 Ilkor 4.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.1"
              },
              "items": [
                {
                  "text": "11.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ilalashera, embung'ata entaa lasujak laainei, ning'oring'oro lelo ootiu neijia te nkishon enye amu iatata enkitanyaanyukoto te iyiook. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.17",
            "verseOrgIds": [
              "PHP.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore ilkumok laa ketii ilaidipa atoliki intae, naa kaliki sii taata intae, ebaiki too lkiyio, naa ilmang'ati lo salaba le Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.18",
            "verseOrgIds": [
              "PHP.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "te nkishui enye neng'idare enkurruna enye naa ntokitin e nkop eenikino ndamunot enye. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.19",
            "verseOrgIds": [
              "PHP.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake kira iyiook ile nkop natii shumata, naa ine eing'uaa Olaitajeunoni likiaanyita, Olaitoriani lang Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.20",
            "verseOrgIds": [
              "PHP.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "laa ninye oyooki aibelekeny ele sesen lang odou metotiwuo anaa ilo sesen lenye le nkitoo te ina golon naidimie ninye metipika ebaiki ntokitin pooki abori enkitoria enye makewan.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.21",
            "verseOrgIds": [
              "PHP.3.21"
            ]
          }
        }
      ]
    }
