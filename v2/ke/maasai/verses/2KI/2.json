        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
