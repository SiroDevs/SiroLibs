        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
