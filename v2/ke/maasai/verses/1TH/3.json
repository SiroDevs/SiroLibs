              "1TH.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Iat 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kake ore taata eewuo Timoteo enikitii eing'uaa enitii intae, neinosaki iyiook ilomon sidain le nkirukoto o enyorrata inyi, nelimu inchere idamumu oshiaake iyiook too sidain niyieuwu oleng nidolidolo iyiook anaa enikiyieu sii iyiook nikidol intae. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkaraki ena lo alashera, eilejilejaki yiook ti alo emion o sinaitin lang pooki te nkaraki nkirukoto inyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore taata naa aikinchu iyiook, tinintasheshe intae nimiwuatiwuatata ti atua Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kebaa enashe nikindim aaishoo Enkai te nkaraki intae, te ng'ida pooki nikiaata te nkaraki intae te dukuya e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiomon aaitirrish kewarie o dama pee kitum aatodol intae e notote inkomomi, pee kitum aaishoo intae ina nang'or ti atua enkirukoto inyi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore taata Enkai ang naa Papa makewan, o Laitoriani lang Yesu Kristo meitorioki enkoitoi ang, enitii intae; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "metoponai Olaitoriani enyorrata te rishata inyi intae maate o too ltung'ana pooki anaa enikitiu iyiook te intae, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee etum ninye aitagolo iltauja linyi meeta entiyoto te sinyatisho te dukuya e Enkai ang naa Papa lang te lotunoto o Laitoriani lang Yesu te nebo isinyat lenyena pooki.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
              "1TH.3.13"
            ]
          }
        }
      ]
    }
