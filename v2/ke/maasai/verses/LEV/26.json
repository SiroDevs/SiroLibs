          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna ninche nkiguanat o nkikoot o nkitanapat naaitobira Olaitoriani te rishata enye o ltung'ana le Israel te nchumata oldoinyo le Sinai aimunye Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
