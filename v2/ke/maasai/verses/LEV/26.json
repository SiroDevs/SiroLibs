              },
              "items": [
                {
                  "text": "27.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Emintobirakiki intae ate nkitanyaanyukot oo nkaitin nimishetishete nkitanyaanyukot oo nkaitin naaguetuno aashu e ng'ape, nimintasheyieyie intae osoit le nkitanyaanyukoto tiatua enkop inyi, pee irrugokinono ninche; amu ara nanu Olaitoriani Enkai inyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embung'a intae isabatoni aainei niyanyititi emanyisho ai sinyati. Ara nanu Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
