            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Teneas oltung'ani ake duoo eng'oki eitu eotiki aas ae nabo oo mbaa naaitanapishe Olaitoriani pee measi, neaku oloitarruoyie, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ake pee eitayioloi ninye ina ng'oki nataasa neyau ninye aitaa enkishoroto enye enkine, esupen nemeeta entioto, te nkaraki ina ng'oki nataasa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiteleiki ninye enkaina enye endukuya eina kine o lasar le ng'oki, neyieng ilo asar le ng'oki te wueji neyieng'ieki ilasarri oopejori. ",
          "type": "text",
          "attrs": {
