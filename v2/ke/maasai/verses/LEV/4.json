              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "neiteleiki enkaina enye, endukuya eilo asar le ng'oki neyieng ninye aitaa olasar opejori. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
              "LEV.4.33"
            ]
