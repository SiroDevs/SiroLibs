              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teneas oloitoreisho eng'oki, neas eitu eotiki ae nabo oo mbaa pooki naaitanapishe Olaitoriani Enkai enye pee measi, neaku oloitarruoyie, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore pee eitayioloi ninye ina ng'oki nataasa, neyau ninye anaa olasar lenye enkine, ositima lemeeta entioto, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "neiteleiki ninye enkaina enye endukuya eina kine, neyieng ninye te wueji neyieng'ieki lelo asarri oopejori te dukuya Olaitoriani; olasar le ng'oki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neya olapolosani embata eilo sarge lo lasar le ng'oki to lkimojino lenye nepik imowuarak olperere lo lasar opejorieki lasarri, neibukoo olikae sarge te ntonata olperere lo lasar opejorieki lasarri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkurriny enye pooki nepejoo te nchumata o lperere lo lasar, anaa enkurriny olasar loo nkishorot e seriani; neitobir olapolosani olning'o lo sotua te nkaraki ninye too ng'ok enyena, naa kepalakini ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
