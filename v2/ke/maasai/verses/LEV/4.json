        },
        {
          "text": "“Teneyau ninye olkuoo le ker metaa enkishoroto enye o lasar le ng'oki, nchoo ninye eyau esupen nemeeta entioto, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
