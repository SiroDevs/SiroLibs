            }
          ]
        },
        {
          "text": " Nimiboitare ake eng'ues pooki aisarkionie kewan te ninye, nemeisho enkitok kewan eng'ues metaboitare, entaboi ina.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
