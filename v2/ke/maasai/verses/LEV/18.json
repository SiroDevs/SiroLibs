        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emisarkionie ate tiae nabo e kuna baa, amu te kuna pooki eisarkionie ate lelo oshon pooki laaraa nanu te dukuya intae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku enkop enaisarkionieki, neaku aitamio nanu enkitarruorroto enye, nelopu enkop lelo oomanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake embung'a intae nkitanapat aainei o nkiguanat aainei nimiasiasa ae nabo e kuna tabo, aa oinoti aashu ilo dokunoti oidurrua alotu atua intae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Amu ore kuna baa o lminong pooki etaasa apa iltung'ana lena kop, lelo apa ootii dukuya intae, neaku eisarkionieki enkop); ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee melopu ake intae enkop, tenisarkionienie, anaa apa enatolopua ilo osho otii dukuya intae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore oloba anaa oloas nabo e kuna baa olminong, ore lelo tung'ana oas neiwuang'ieki too ltung'ana lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa embung'a enkitanapata ai nimiasiasa aikata ae nabo e kuna tabo oo lkuaki apa ootaasaki te dukuya intae, nimisarkionienie ate te ninche: ara nanu Olaitoriani Enkai inyi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        }
      ]
    }
