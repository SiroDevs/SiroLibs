    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkishorot e nchula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tenaa ore enkishoroto o ltung'ani naa olasar le seriani, neishooyo ninye enkiteng te luata, olbung'ae aashu entawuo, nchoo eishooyo ina nemeeta entioto te dukuya Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.1",
            "verseOrgIds": [
              "LEV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiteleiki ninye enkaina enye endukuya eilo asar lenye neyieng ninye te kutuk aji eilo ng'obor le ntumo; ore lelo ayiok le Aron, lelo apolosak neisuaaki ilo osarge ilo perere lo lasar aaitaman. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore teilo asar le seriani oishoruaki, anaa enkishoroto naishori te nkima Olaitoriani, neishooyo ninye enkurriny pooki naimulumulita enkoshoke o enkurriny pooki e nkoshoke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lairakuj pokira oare tenebo ina kurriny naimulumulita ninche oilo kina le moinyua oya ninye tenebo ilairakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepejoo ilayiok le Aron te nchumata olperere lo lasar ti oriong ilo asar opejori, otii enchumata oo nkeek te nkima, olasar le mpejoroto te nkima, esong'ouna narropil to Laitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tenaa ore enkishoroto enye o lasar le seriani oishori Olaitoriani naa enkiteng naing'ua eluaata olbung'ae aashu entauo neishoru enemeeta entioto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teneishoru ninye olkuoo le ker aitaa olasar lenye, neishoru ninye te dukuya Olaitoriani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "eiteleiki enkaina enye endukuya eilo asar lenye, neyieng ninye te dukuya ilo ng'obor le ntumo; ore lelo ayiok le Aron neisuaaki osarge ilo perere lo lasar aaitaman. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore teilo asar le seriani anaa enkishoroto napejokini te nkima Olaitoriani, neishooyo ninye eilata enye, eilata o lkidong'oe, aitabaiki oloito le nkoriong oina kurriny naimulumulita enkoshoke, o enkurriny pooki e nkoshoke, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "o lairakuj pokira oare oina kurriny naimulumulita ninche, oilo kina le monyua neya ninye tenebo ilairakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepejoo olapolosani ninche te nchumata olperere lo lasar anaa endaa naishoruaki tialo enkima aaisho Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tenaa ore enkishoroto enye naa enkine, nchoo eishoru ninye te dukuya Olaitoriani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "neiteleiki enkaina enye endukuya enye neyieng ninye te dukuya ilo ng'obor le ntumo, ore lelo ayiok le Aron neisuaaki osarge olperere lo lasar aaitaman. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netum taa aishooi te ninye, anaa olasar lenye oishori te nkima Olaitoriani, ina kurriny naimulumulita enkoshoke o enkurriny pooki enkoshoke, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "o lairakuj pokira oare tenebo ina kurriny enye, oilo kina le monyua oya ninye tenebo ilairakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
            "verseOrgIds": [
              "LEV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepejoo olapolosani ninche te nchumata olperere lo lasar anaa endaa naishoori te nkima metaa esong'ouna narropil. Ore enkurriny pooki naa eno Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keaku ena enkitanapata e anaake tiatua iishoritin inyi pooki, tiatua imanyishoritin inyi pooki, nchere minyanya intae enkurriny aashu osarge.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
            "verseOrgIds": [
              "LEV.3.17"
            ]
          }
        }
      ]
    }
