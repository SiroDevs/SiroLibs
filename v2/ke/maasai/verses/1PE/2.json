                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.6"
              },
              "items": [
                {
                  "text": "7.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.2"
              },
              "items": [
                {
                  "text": "14.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.2"
              },
              "items": [
                {
                  "text": "Isa 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Irara intae olorere ogeluno, inkasisin e nkaji e nkitoo, olorere sinyati, iltung'ana le Enkai makewan, pee itumutumu aainosai inkiaasin enyena e nking'asia, oloipotuo intae entung'uai enaimin aitijing atua ewang'an enye naing'asiasho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.23"
              },
              "items": [
                {
                  "text": "Hos 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Intae ilemera olorere apa; kake irara taata olorere le Enkai Ileitu apa etum olng'ur kake itang'amutua olng'ur.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isinkan le Nkai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilanyor laainei asai intae, anaa ilomon o laisikak pee ipaasharere ing'uarrat o sesen naashet enjore naarare iltauja linyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niaakuku ilooata orrekie sidai ti atua Loreren lemeiruk, pee te neiro neiteleiki intae mbaa anaa laasak loo ntorrok, neidim te nedol too nkiasin inyi sidain, aaisisa Enkai te nkolong e muta.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyanyita pooki kitoria oo ltung'ana to lbae lo Laitoriani, te naa ko laiguanani kitok, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "anaa ilooti te ninye ooirriwuaki meitamio lelo ooas intorrok neisis lelo ooas isidain. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eyieunoto e Enkai inchere ore te yasata oo sidain nintigiriri emodai oo ltung'ana oomoda. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entotoni anaa iltung'ana oolakuno, nimintaa elakunoto inyi entoki nintiemorierie entorroni, kake entobik anaa ilaisiaayiak le Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyanyita iltung'ana pooki, entonyor ilalashera, entureita olaiguanani kitok.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkitanyaanyukoto o sina le Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo aisiaayiak entadou ate, niyanyititi oleng ilaitoriak linyi, neme ake isupati nebor, kake o metabaiki lelo ooisomit intae. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu keishori oltung'ani enchunet te naa, ore nkaraki nadamu Enkai neng'iri te neidong'i metii esipata. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kaa dupoto ina, te neitamei intae enkata niaasiasa intorrok? Kake te niaasiasa isupati, ning'iriri te neisilisili intae niaatata enchunet te Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
