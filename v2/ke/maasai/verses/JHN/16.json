        },
        {
          "text": "Newaliki Yesu ninche ajoki, “Iruko taata? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
