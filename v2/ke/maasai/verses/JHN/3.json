        "style": "s1"
      },
      "items": [
        {
          "text": "Oloewuo eing'uaa keper",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.30",
            "verseOrgIds": [
              "JHN.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oloewuo eing'uaa keper netii shumata e pooki; ore oloing'uaa enkop naa enkop eing'uaa neiro ninye ine nkop. Ore ilo oing'uaa keper netii shumata pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eishakenu ninye ina natoduaa, o enatoning'o ore ake eyia, nemeetae olong'amaa shakenisho enye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olotang'amayie shakenisho enye netipika olmishire lenye ena nchere asipani Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oirriwua Enkai ninye oiro orerei le Nkai, amu meishoru Enkai Enkiyang'et te ntemakinoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mat 11.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.22"
              },
              "items": [
                {
                  "text": "Lk 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enyor papa Enkerai, neishoo intokitin pooki metijing'a atua enkaina enye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oloiruk Enkerai eeta enkishui oo ntarasi; ore ologolong'aki Enkerai nemedol enkishui: kake keipirare ninye enkiguana e Nkai.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
      ]
    }
