              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu ninche, “Esipa, esipa, ajoki intae, ore eton meetae Abraham, ‘Atii nanu.’ ” ",
          "type": "text",
          "attrs": {
