            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepuo ninche aasujaa Olaitoriani, naa keikurrukur ninye anaa olng'atuny, ee keikurrukur, ore layiok lenyena nepuonu eikirikira eing'uaa enkalo o loo ntoluo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuonu ninche eikirikira anaa ntaritik naaing'uaa Misiri, o anaa nturkuluni eing'uaa enkop e Asiria; naa karriny nanu ninche meshomo inkang'itie enye, Olaitoriani ojo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etudungokoki Israel o Yuda enkiguana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aatang'adua nanu Efraim te lejare, naang'adu enkaji e Israel too monko; kake eton eyioloi Yuda te Nkai, naa keisiligayu ninye te ilo Osinya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.12",
            "verseOrgIds": [
              "HOS.11.12"
            ]
          }
        }
      ]
