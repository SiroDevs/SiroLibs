      },
      "items": [
        {
          "text": "Etipike Yeremia enchata oo lmong'i e murt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
