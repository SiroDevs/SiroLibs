            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Int 36.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu nji ejo Olaitoriani tialo Shalom olayioni le Yosia, olaiguanani le Yuda, laa ninye oitoreisho te rishata e Yosia papaai lenye. Naa ninye oshomo aing'uaa ewueji enye: “Meitoki aekata ninye ashukunye ene, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake tiatua ine wueji netanapaki ninye aaya eyararoto, teine eye ninye, nemeitoki ae kata ninye aigil adol ena kop.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
