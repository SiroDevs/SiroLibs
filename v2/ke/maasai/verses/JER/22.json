    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olkilikuai le Yeremia oipirta enapukoki Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
