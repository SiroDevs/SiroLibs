              "items": [
                {
                  "text": "2 Int 36.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neaku nji ejo Olaitoriani tialo Yehoiakim olayioni le Yosia, olaiguanani le Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
