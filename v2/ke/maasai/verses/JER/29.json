        "style": "s1"
      },
      "items": [
        {
          "text": "Empalai e Yeremia too Lyahudi ootii Babilon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
