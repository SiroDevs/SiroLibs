                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Amu nji ejo Olaitoriani: Teneishunye ilarin ntomoni naapishana te Babilon, namutan nanu intae, naa kaitabaya nanu te intae enkisiligata ai narrinyu intae ayau ene wueji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ayiolo nanu nkitobirat naata te intae, Olaitoriani ojo, nkitobirat olmabarishoi neme ine ntorroni, pee eisho intae osiligi too nkolong'i naapuonu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa eikimpotipoto intae nanu nikipoununu aaomon nanu, naa kaning nanu intae. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Enkig 4.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eiking'oruru intae nanu nikitumutumu; teniking'oruru to ltauja linyi pooki, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikitumutumu nanu, Olaitoriani ojo, naa kaitopok nanu intae naiturrur intae aitung'uaa iloshon pooki o wuejitin pooki apa naterewa intae, Olaitoriani ojo, narrinyu nanu intae ayau ine wueji apa naterewa intae enchom eyararoto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore enkaraki nitejo intae, ‘Etudumaka iyiook Olaitoriani iloibonok tiatua Babilon,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nji ejo Olaitoriani tialo ilo aiguanani otonita to lorika le nkitoo le Daudi, o tialo lelo tung'ana pooki oomanya atua ena anasa, lelo alashera linyi leitu apa eipang aapuo tenebo intae tiatuaeyararoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nji ejo Olaitoriani loo lororani, ng'ura, kairriwaki nanu ninche olalem, o lameyu, o lmeitai, naa kaitotiu nanu ninche anaa ilng'abolo ootarruoitie lemeinosayu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasujaa nanu ninche to lalem, to lameyu o to lmeitai, naitaa ninche enkuretisho too nkitoriat pooki e nkop, pee eaku oldeket, o enkuretisho, o enkiputukuny o esulare tiatua iloreren pooki laterewa nanu ninche, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu eitu ninche ening ilomon laainei, Olaitoriani ojo, lelo laitirrishaka nanu airriwaki intae too sinkan laainei lelo oibonok, kake mining'ining'i intae, Olaitoriani ojo!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entoning ororei lo Laitoriani, intae pooki le yararoto apa laterewa nanu aitung'uaa Yerusalem nareu Babilon: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nji ejo Olaitoriani loo lororani, Enkai e Israel, tialo Ahab olayioni le Kalaya o Sedekia olayioni le Ma-asea, lelo ooibonu elejare te intae te nkarna ai: Ng'ura, kayau nanu ninche apik atuaenkaina e Nebukadnesa olaiguanani le Babilon, naa kear ninye ninche metuata te dukuya nkonyek inyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore tenkaraki ninche ketumi aadekishore ele deket lelo pooki le yararoto ooing'uaa Yuda ootii atua Babilon: ‘Mikintotiwuo Olaitoriani anaa Sedekia o Ahab, ootapejo olaiguanani le Babilon te nkima.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkaraki nataasa entaboi tiatua Israel, etololoitote too nkituaak oo lelatia enye, neiroro ninche, te nkarna ai irorei le lejare leitu nanu aitanap ninche. Nanu ilo oyiolo naa nanu olchakeni, Olaitoriani ojo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Empalai e Shemaia",
          "type": "text"
        }
      ]
    },
    {
