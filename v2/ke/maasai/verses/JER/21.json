            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ele rorei oewuo enetii Yeremia eing'uaa Olaitoriani, ina kata apa pee eirriwaki ninye olaiguanani Sedekia Pashur olayioni le Malkia o Sefania olapolosani, Maasia, ejo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
