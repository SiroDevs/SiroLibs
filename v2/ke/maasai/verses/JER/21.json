        "style": "s1"
      },
      "items": [
        {
          "text": "Eibonuoki aajo keisulieki Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
