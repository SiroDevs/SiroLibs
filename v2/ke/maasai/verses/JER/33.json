                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Amu nji ejo Olaitoriani: Melau ae kata Daudi oltung'ani otonie olorika le nkitoo le nkaji e Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
