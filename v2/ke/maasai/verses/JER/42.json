{
  "id": "JER.42",
  "number": "42",
  "bookId": "JER",
  "reference": "Yer 42",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
