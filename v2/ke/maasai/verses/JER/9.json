        },
        {
          "text": "“Ng'ura, kepuonu nkolong'i, Olaitoriani ojo, pee aitame nanu lelo pooki oomurata kake memurata sii ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
