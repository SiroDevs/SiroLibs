              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tenelo akenya neiwuang'ie Olaitoriani Enkai inyi te dukuya intae lelo oshon lipuopuo intae aaya enkop enye, niwuang'ieng'ie intae ninche nimanyimanya enkop enye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "entodol ate mijing'ijing'i ake orreshet aasujaa ninche, eidipaki aaidaikie ninche te dukuya nkonyek inyi, niminkilikuanunu nkaitin enye, ijojo, ‘Kaji apa eiko kulo oshon teneisiai nkaitin enye? - Pee aiko sii nanu neijia!’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mias iyie ina to Laitoriani Enkai ino; amu ore pooki toki nara olminong naiba Olaitoriani eitaasa apa ninche nkaitin enye; amu kepejoo doi ninye ilayiok o ntoyie enye te nkima aapejoki nkaitin enye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
