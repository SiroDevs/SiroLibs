                "loc": "2KI.9.27"
              },
              "items": [
                {
                  "text": "9.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nemeponiki sii kewan nkituaak, pee meibelekenya ake oltau lenye; nemeponiki sii kewan oleng enkosholai o sahabu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naa teneton ninye to lorika lenye le nkitoo, neigeroki kewan tiatua embuku ena kitanapata, teina naitore ilapolosak le Lawi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "neaku ina kitanapata tenebo ninye, neisum ninye nkolong'i pooki enkishui enye, pee eyiolou aturia Olaitoriani Enkai enye, te nkibung'ata oo rorei pooki lena kitanapata, o kuna kiguanat, neas ninche; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
