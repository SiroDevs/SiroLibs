          },
          "items": [
            {
              "text": "\n        Ilaw 13.1–14.54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ing'ura tenikijing enkeeya oo lbolot, toduaa pee, ias terisioroto e nena pooki nikiutaki lelo apolosak loo Lawi; anaa apa enaitanapa nanu ninche, ina taasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
