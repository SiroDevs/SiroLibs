                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Enki 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tadamu ina apa naitaasa Olaitoriani Miriam ina kata te nkoitoi ipuonunu aaing'uaa Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
