              },
              "items": [
                {
                  "text": "Mk 10.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Teneya oltung'ani enkitok ayam, nelo neaku eitu etum omom too nkonyek enyena te nkaraki natoduaa ninye embae suuji te ninye, neigeroki ilo moruo ninye empalai eoro nepik enkaina enye, nearaa ninye aitung'uaa enkaji enye, nelo ina kitok te nkaji enye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tenelo ninye aaku enkitok e likae moruo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ilo likae nemenu ninye neigeroki empalai eoro nepik enkaina enye nearaa ninye te nkaji enye, tenelo neye ilo moruo le siadi apa oowa ninye aitaa enkitok enye, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ilo moruo apa le dukuya otaarayie ninye meshomo, nemeidim anyaaki aawa ninye ayama eidipaki aatipik olduruk. Amu olminong ilo te dukuya Olaitoriani, nemeishiakino teniyauu entorroni shumata ena kop naisho intae Olaitoriani Enkai inyi entujung.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulie kitanapat",
          "type": "text"
        }
      ]
    },
    {
