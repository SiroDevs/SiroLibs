                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Teninturrur enkurma ino aisampu, nikirikino ilkuti ng'osil loo lukuny tiatua enkurma mirrinyo alo ayau; nchoo eaku oleilo tung'ani omoni, o lokishi, o enkoliai; pee kitum Olaitoriani Enkai ino atamayiana te siaai pooki oo nkaik inono. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenirrarru ilng'anayio linono, ming'il arrarru aishu; nchoo eaku ileilo tung'ani omoni, o lokishi, o enkoliai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenisotu isabibu linono ming'il asotu nchoo eaku ileilo tung'ani omoni, o lokishi o enkoliai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
