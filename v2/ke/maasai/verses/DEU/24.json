        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore enayamishore oltung'ani, nemeishiakino ninye nelo enjore aashu ae siai; nchoo ninye eton tiang olari obo, pee eshipa tenebo oina kitok enye nayama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
