            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mimbooki enkop olaisiaayiani aisinani oigeroki aa obo loo lalashera linono aashu aa obo loo lomon ootii enkop inyi, atua nkang'itie inyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nchoo ninye olmushaara lenye te nkolong naishiaakino, eton eitu edoyio enkolong amu oltung'ani aisinani ninye ina eisiliga oltau lenye; pee mikinchiraki ake to Laitoriani, neaku eng'oki te iyie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
