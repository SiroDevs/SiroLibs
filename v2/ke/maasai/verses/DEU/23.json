              "items": [
                {
                  "text": "Mat 5.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Teninos olmumai to Laitoriani Enkai ino, miyiata te laata, amu keikilikuanu tukul Olaitoriani Enkai ino te iyie, naa keaku eng'oki teyie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
