          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ing'ura pee intabaya ina naimua enkutuk ino, amu te yieuna ino inosie olmumai Olaitoriani Enkai ino teina nisiligishore te nkutuk ino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
