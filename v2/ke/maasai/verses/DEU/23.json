                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Enkig 15.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Misilenoki iyie te dupoto olalashe lino, te dupoto oo mpisai, aashu te dupoto e ndaa aashu te dupoto e pooki toki ake ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore to ltung'ani leiking'a indim iyie aisilenoki te dupoto kake ore to lalashe lino misilenoki te dupoto; pee kitum Olaitoriani Enkai ino atamayiana teina pooki nilo aas teina kop niloito aya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
