            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Enki 28.26-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nteru nkena iwikii naapishana; ntera nkenu nena wikii naapishana ebaiki ina kata nisampu ina kurma ina nauno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintoki aibung ina wiki oo wikii to Laitoriani Enkai, too nkishorot o lpela naaing'uaa enkaina ino, ninchooyo iyie anaa enikitamayiana Olaitoriani Enkai ino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ida iyie te dukuya Olaitoriani Enkai ino, o sinka lino lee o esinka ino ng'oruoi, oilo tung'ani loo Lawi otii atua nkang'itie inono, o lomoni, o lokishi, o enkoliai natii atua intae, teine wueji negelu Olaitoriani Enkai ino, pee eitamany enkarna enye ine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tadamu nchere ira orrindik te Misiri ning'or pee imbung kuna kitanapat.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
