              },
              "items": [
                {
                  "text": "Enkig 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ore teina jung'ore nilo aibung teina kop nikincho Olaitoriani Enkai ino metaa enino, miwuang'ie olpolosie lo le latia ino, apa otipika iltung'ana le dukuya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inaaipirta ilchakenini",
          "type": "text"
        }
      ]
    },
