                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.28"
              },
              "items": [
                {
                  "text": "Ilh 10.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Meidip olchakeni obo to ltung'ani le ntorroni ake ninye pooki, aashu tiae ake ninye kitapong'oto naitapong'o ninye. Too lchakenini oare ake aashu okuni eidimi aaitisipa endung'oto enkiguana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenedumunye olchakeni le nkeleekisho aitang'or likae tung'ani te nkitarruoroto, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nepuonu nena aloli naaitarrikinote dukuya Olaitoriani, dukuya ilapolosak o larishak laa ninche ootii lorikan te nena olong'i; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "neikilikuanishore ilarishak aabaraki naa tenaa olelejare ilo shakeni, neitang'oro olalashe lenye te lejare, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nintaasiasa ninye ina duoo nayieu ninye neitaas olalashe lenye, pee itum aaibooi entorroni te mpolos inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nening lelo kulikae, neureyu, nemeigil aekata entorroni natiu nji tiatua intae. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
