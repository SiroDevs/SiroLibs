                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki Olaitoriani Musa ina kata, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Takedo ele doinyo le Abarim, oldoinyo le Nebo, otii enkop e Moab, oipirakinore Yeriko; ning'or ina kop e Kanaan naisho nanu iltung'ana le Israel meitaa enenye; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilo iyie aye teilo doinyo liked enchumata, nikinturrurrokini iltung'ana linono, anaa apa enatua Aron olalashe lino to ldoinyo le Hori neiturrurrokini iltung'ana lenyena: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "enkaraki apa neitu intae kirukuruku nanu tiatua iltung'ana le Israel too nkariak e Moribat-Kardesh, to lpurkel le Sin; enkaraki neitu intae kiyanyitutu aaitaa sinyati te mpolos oo ltung'ana le Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu idol iyie ina kop te dukuya iyie kake milo iyie ine, atua ina kop naishoo nanu iltung'ana le Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
