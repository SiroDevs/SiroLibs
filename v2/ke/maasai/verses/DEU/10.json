                "loc": "ROM.2.11"
              },
              "items": [
                {
                  "text": "Irm 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Ilg 2.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.9"
              },
              "items": [
                {
                  "text": "Efe 6.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore Olaitoriani Enkai ino naa Enkai oo nkaitin naa Olaitoriani loo laitoriak. Ina Ai kitok magilani naitureisho, nemeeta olkep nemeropayu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keiguanare ninye te sipata olokishi o enkoliai, nenyor ninye ilo omoni, neisho ninye endaa o nkilani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyorra naa ilo ora omoni; amu irara sii apa intae omon te nkop e Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shomo turia Olaitoriani Enkai ino, shomo isiayia ninye nimbung'are ninye, naa te nkarna enye inosinoso olmumai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninye enkisisa inyi, ninye Enkai inyi, ina nataasa kuna baa kituaak naaitureisho naatoduaa nkonyek inyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.5"
              },
              "items": [
                {
                  "text": "Enk 15.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "22.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.27"
              },
              "items": [
                {
                  "text": "46.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eshomo apa iloo papaai linyi Misiri aa iltung'ana ntomoni naapishana; ore taata neitotiuo intae Olaitoriani Enkai inyi anaa ilakir le shumata te nkumoi.",
          "type": "text",
          "attrs": {
