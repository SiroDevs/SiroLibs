              },
              "items": [
                {
                  "text": "Enkig 24.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore lelo ng'anayio le dukuya ooituruku too lng'anayio le dukuya le nkop ino niyau atua enkaji o Laitoriani Enkai ino. Nimiyierie olkuoo kule e ng'otonye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
