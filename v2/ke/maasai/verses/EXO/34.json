            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Enki 28.26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ning'or aibung osirua loo wikii, olng'anayio le dukuya le nkisampuare e nkano, osirua lenkiturrurrorre te siadi ari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katitin uni to lari eliooyu ilewa linono pooki te dukuya Olaitoriani Enkai, Enkai oo Siraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kanang'aa nanu aiturraa iloreren te dukuya ntae; naitalala nanu ilpolosien linyi; nemetii oltung'ani ong'uar enkop inyi, ti nilepu alo alioyu te dukuya Olaitoriani Enkai ino katitin uni tolari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
