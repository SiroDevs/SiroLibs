                  "text": "Ilh 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ning'or nchere, intobira te nkitanyaanyukoto enye, apa nikintoduaaki to ldoinyo.",
          "type": "text",
