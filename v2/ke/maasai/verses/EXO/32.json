          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaki Olaitoriani olmeitai iltung'ana, enkaraki naitayutuo ilo ashe oitayio Aron.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
