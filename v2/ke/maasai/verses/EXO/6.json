            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etiaka Olaitoriani Musa, “Idol taata iyie ina naitaas Farao; amu te nkaina nagol eisho ninche meshomo, ee te nkaina nagol earaa ninche meshomo aaing'uaa enkop enye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eipoto Enkai Musa",
          "type": "text"
        }
      ]
    },
