  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilkilani loo lapolosak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niyau iyie aitinyiku Aron, olalashe lino, o layiok lenyena te nebo ninye, laa ninche ti atua iltung'ana loo Siraeli laaisiaai anaa ilapolosak. Aron o layiok lenyena, Nadab o Abihu o Eliesa o Isamar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintaiki Aron olalashe lino ilkilani oosinya, te nkitoo o te sidano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirorie lelo pooki oata enkidimata, lelo laishoo eng'eno, pee eitobir ilkilani le Aron, pee eitisinyi te mpolosare ai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna inkilani naaitobir ninche, enkila o lgoo, enkila dorrop, olkila oado, enkila e oriong naikodo o enkarasha e lukunya, o enkimeita; neitobir ninche nkilani naasinya te nkaraki Aron olalashe lino o layiok lenyena pee aaisiaai ninche anaa ilapolosak.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neng'amu ninche sahabu o nkarash pusi o morijo o mpilei o enkatani napuyiapui napiyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitobir ninche enkila dorrop te sahabu, too usin pusi, o too morijo, o too mpilei o te katani napuyiapui napiyaya te nkarriayiano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeta inkeenta are ooronyi too lpijat lenyena pee eitutumieki te nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O enkimeita naitobiruno te nkarriyiano te nena tokitin, pee eenieki; te sahabu o too usin pusi o sinteti o naanyokie, o naaibor sidain. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niya isoito are barrikon naaji oniks niguetaki asiraki ninche nkarn oo layiok le Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkarn enye ile to soit obo, ore nkulie ile naaleku ning'eroki olikae soit, too inot enye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa enkarriyiano olaguetani omishir isoito, neijia sii iyie inkuna eng'uetakinoto e lelo soito oare nkarn oo layiok le Israel; nipik nena nitaguetua te sahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipik lelo soito pooki inkaloli ooronyi le ina kila dorrop, pee eaku isoito oodamunyeki ilayiok le Israel; nenap Aron inkarn enye te dukuya o Laitoriani too ronyi lenyena pee edamuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipik nkikodot are e sahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lpisia oare le sahabu nasila, ooirina anaa empito nipik nimbung'ie ina sahabu naikodore enkila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkila o lgoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nintobir sii ina kila o lgoo e nkiguana, te nkarriyiano, anaa ina kila dorrop, te sahabu, o too usin pusi o morijo o mpilei o kitani napuyiapui napiyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerisioroyu nkaloli pooki, netasha, entemata e ndap enkadoro o entemata e ndap endapasho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipik ilkererin oong'uan loo soito, olkereri lo ltotoi barrikoi, oltotoi onyori o oltotoi onyokie oleng oaku olkereri le dukuya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olkereri li are naa oltotoi sintet, oltotoi pus oata iltiil o ltotoi sidai oji almasi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore olkereri li okuni naa oltotoi pile, oltotoi owang oji agat, o ltotoi pile oji ametist ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore olkereri li ong'uan naa oltotoi oji beril, oltotoi oji oniks oltotoi pus oji Jaspa. Neitobir te nkikodo e sahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepik isoito tomon o are o nkarn enye anaa inkarn oo layiok le Israel. Netiu ninche anaa olmishire, meetae ake olemeguetuno enkarna enye, too loshon tomon aare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintobiraki ina kila o lgoo ilpisia ooipila anaa impi, le sahabu nasila; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nintobiraki ina kila o lgoo ilgiso oare le sahabu nipik lelo giso oare ilpijat pokira oare le mbene o lgoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipik lelo pisia aare le sahabu ooipila atua lelo giso ootii ile mowuarak le mbene o lgoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ineeiting'ie lelo pisia oare ooipila nimbung'ie lelo kererin oare le nkikodo e sahabu, nimbung'ie te nkalo e dukuya te nena keenta e nkila dorrop naatii ironyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintoki aitayu ilgiso aare le sahabu nimbungie lelo lemowuarak aare le nkila to lgoo te nkalo e atua te mbata e ina kila dorrop. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nintoki aitayu ilgiso aare le sahabu, nimbung'ie ninche te nkalo e dukuya ti abori nena keenta are e nkila dorrop natii ironyi, te nchumata ina kimeita e nkila dorrop naripuno te nkarriyiano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitutum ninche ina kila o lgoo too lgiso lenyena o lgisoi le ina kila dorrop te nkeene pus, pee eirrag te ina kimeita e nkila dorrop naripuno te nkarriyiano, pee melolong'u ina kila o lgoo teina kila dorrop.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nenap ninye Aron inkarn oo layiok le Israel te ina kila o lgoo e nkiguana, to ltau lenye, te nelo ninye atua ine wueji nesinya, pee edamuni ninche anaake te dukuya Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
