                  "text": "2 Int 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore embata e lelo ayiok linono likitoikioki naa keyai sii ninche. Naa kepuo aaku sunaishi oogelema ti atua enkaji o laiguanani le Babilon.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Hesekia ajoki Isaya, “Ore ilo rorei lo Laitoriani liroro iyie naa eisidai.” Amu etejo apa ninye, “Kelo atii eseriani too nkolong'i aainei.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
