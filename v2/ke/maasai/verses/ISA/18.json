              "ISA.18.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.12"
              },
              "items": [
                {
                  "text": "Sefa 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuaak, enkop oo naipuko naaikurrukur natii lido kekun ilkejek le Etiopia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ina nairriwaa ilbalusuni lenyena aimie olkeju le Nail, too mpeuti naaitobiraki te narau oo nkujit naapor nkariak! Enchom intae, intae olkilikuai oneneng ina kop e lelo adoru oosipa seseni, enetii ilo orere ourei te netaana o te nelakua, ilo osho magilani otimirishe, odung ilkejek enkop enye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore intae kulo ootii enkop pooki, intae lelo oomanya enkop, te nedumuni olmonekie too ldoinyo, eng'ura! Te neoshi emowuo, entoning! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu nji nanu aatiaaka Olaitoriani: “Kaitirring'a nanu aing'orisho te manyisho ai, aing'or asipu anaa te ndama eirowuaja, anaa enkatampoi e nkoiliolio te nkata e nkisampuare eirowuaju.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore eng'or enkisampuare, eidipa enkurma aitapuka, neibelekenya ntapuka aaku ilng'anayio, nedung'oo ninye lelo ng'osil to lalem odung'ishoreki, ore lelo ng'osil oo luaari nedung'oo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neing'uari ninche pooki, meinosa nena taritik e ong'ata naatoni too ldoinyo, neing'ueikini ing'uesi e ntim. Neked ilmotonyi shumata ninche te nkata e nkirowuaj, netonie ing'uesi e ntim ninche te nkata e nkirobi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kenya te ina kata neyauni nkishorot aaisho Olaitoriani loo lororani, naaing'uaa lelo tung'ana adoru nesipa seseni, lelo tung'ana oourei te netaana o te nelakua, ilo osho magilani omirisho, odung ilkejek enkop enye, o metabaiki oldoinyo le Sion, ine wueji e nkarna o Laitoriani loo lororani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    }
  ],
