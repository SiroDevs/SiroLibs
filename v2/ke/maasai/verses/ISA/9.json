              "ISA.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.15"
              },
              "items": [
                {
                  "text": "Mat 4.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kake meetae osina te ina apa naata emion. Ore too nkatitin e dukuya neishoo ninye metemenare enkop e Sebulon o enkop e Naftali, kake ore too nkolong'i e siadi naa keisho ninye meitaai kitok ina oitoi e naiposha, ina kop natii lido kekun le Yordan, Galilaya oo loreren.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keitame Olaitoriani Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eirriwayie Olaitoriani olkilikuai lo larrabal te nkaraki Yakobo, naa kelo aitawang'aki Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kepuo iltung'ana pooki aayiolou, aa taa, Efraim o lelo oomanya Samaria, lelo oojo to lwuasa o te nkitokoos oo ltauja: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Etusulari isoito kake eikishet iyiook too soito oogueta; eturoyioki oreteti aadung, kake eikipik iyiook iltarakua erishata enye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku kedumaki ninche Olaitoriani ilmang'ati, neputu ilmang'ati lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.11",
            "verseOrgIds": [
              "ISA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo le Siria ootii enkalo o loo saen o lelo le Filisti ootii enkalo o loo ntoluo, kepuo aamut te nkutuk nang'a. Amu ore te kuna pooki eitu eiwuang'ieki engoro enye neitorioyioki enkaina enye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitu eibelekenyakino iltung'ana ilo otoosho ninche, neitu eing'oru Olaitoriani loo lororani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.13",
            "verseOrgIds": [
              "ISA.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkaraki ina etudung'oyie Olaitoriani te Israel endukuya o lkidong'oi; nedung ilng'osil loo ltuka o seyia te nkolong nabo - ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.14",
            "verseOrgIds": [
              "ISA.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelo payiani kituaak ooyanyit ninche endukuya, ore ilo oiboni oibonisho te lejare ninye olkidong'oe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.15",
            "verseOrgIds": [
              "ISA.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu ore lelo oorikoo ele orere naa keitapong'oo ninche, ore lelo oorikori naa keijori. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.16",
            "verseOrgIds": [
              "ISA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkaraki ina meshipakino Olaitoriani elelero enye, nemeetayie olng'ur lelo okishin o nkolia; amu ore pooki ng'ae lenye nepaashare orrekie le Nkai naa laasak loo ntorrok, ore pooki kutuk neiro ine modai. Ore te kuna pooki neitu eiwuang'ieki engoro enye neitorioki enkaina enye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.17",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.17",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eyupuyupito entorroni anaa enkima, neinos isuut o lkiku; neinos isanagi le ntim, neilep ninche shumata te mpuruo kitok. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.18",
            "verseOrgIds": [
              "ISA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti atua engoro o Laitoriani loo lororani etapejoki enkop, netotiutuo iltung'ana anaa ilkeek le nkima; meetae oltung'ani oing'urrie olalashe lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.19",
            "verseOrgIds": [
              "ISA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewuapaa ninche too ntateniaa, neton ake eisumash, nedaa ninche too nkedienyaa, kake eitu eraposho; neinos ake oltung'ani nkiri e ilo le latia enye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
              "ISA.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neinos Manase Efraim, neinos Efraim Manase, ore ninche pokira nedumakino Yuda. Ore te kuna pooki neitu eiwuang'ieki engoro enye, Neitorioki enkaina enye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.21",
            "verseOrgIds": [
              "ISA.9.21"
            ]
          }
        }
      ]
    }
  ],
