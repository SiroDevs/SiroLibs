                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.74.14"
              },
              "items": [
                {
                  "text": "Olke 74.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.26"
              },
              "items": [
                {
                  "text": "104.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore kenya te ina olong eibung'ita Olaitoriani ilo alem lenye kitok ogol, nelo ninye aitame Lefiatan, ilo asurai oisikita, ilo asurai ojo lefiatan omerregela, near ninye metua ina kukuu natii atua enaiposha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te ina olong: “Neranyaki enkurma sidai oo sabibu ninye! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu Olaitoriani olaing'urani lenye; kabukoki nanu enkare pooki kata. Melotu ake likae tung'ani ainyal, karrip nanu kewarie o dama. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maata nanu engoro. Tenaa naaji kaata nanu ilkiku o entiaati pee airragakinye ninche, anaata apejoo ninche pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa nchoo ninche eibung esarunoto ai, nchoo ninche eitobir osotua o nanu, nchoo ninche eitobir osotua o nanu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too nkolong'i naapuonu neibung Yakobo ntona, neitapuku Israel neiu ntilitan neiput enkop pooki ilng'anayio lenyena. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketoosho ninye ninche anaa apa enatoosho lelo mang'ati lenye? Anaa ketasesekuana ninye ninche anaa apa enatasesekuanaki lelo asesesekuanak? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te nkiririkinoto iyie intamio ninche, airreu ninche meshomo eyararoto; iwuang'ie ninche te ngoro ino napi, te ina olong o lkutati lo loo saen. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkaraki ina naa kepalakini enkitarruorroto e Yakobo naa kelo ena aaku olng'anayioi olulung'a le nkitayunoto e ng'oki enye: te nelo ninye aitobir isoito pooki loo lperereni loo lasarri, nerrorro anaa ilboro le nturoto, meitoki atii Asherim anaa lasarri le nkorropil ooitoki aaitashe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore ina anasa nasheta netomijoono emanyisho apa naidurrieki nepuoi aaing'uaa, etotiuo anaa ong'ata, te ine edaa lasho, neirrag te ine negil ilng'osil lenyena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kenya te netoyu lelo ng'osil lenyena, negili; nepuonu nkituaak aaitayunye enkima. Amu olorere ele lememuso; ore enkaraki ina, ore ilo oitobira ninche meduaaki ninche olng'ur, ore ilo oitobirua ninche meisho ninche omom.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kenya te ina olong, ebaiki olkeju le Frati o metabaiki oerata le Misiri, naa keiturrur Olaitoriani iltung'ana lenyena moobo, anaa oltung'ani osilu isuut te nkano. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore akenya te ina olong kepuoi aaosh entarumpeta kitok, ore lelo apa ooimina te nkop e Asiria, o lelo oopuonu ootarayioki Misiri nepuonu aaserem Olaitoriani te nchumata ele doinyo sinyati te Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
              "ISA.27.13"
            ]
          }
        }
      ]
    }
  ],
