              "items": [
                {
                  "text": "Irm 15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore kenya te ina olong naa keitashe entonai e Yese anaa enkitoduaaroto too loreren; keaku ninye eing'oru loreren, ore emanyisho enye neaku ewueji e nkitoo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kenya te ina naa keitorioo Olaitoriani enkaina enye aigil eni are, pee errinyu ilo pisiai apa otelekua loo ltung'ana lenyena, aitung'uaa Asiria, o Misiri, o Patros, o Etiopia, o Elam, o Shina, o Hamat, neitung'uaa sii olomanaa le naiposha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kedumaki ninye nkuapi olmonekie pee eiturrurru lelo apa ooidapashari le Israel, neiturrur lelo ooidapashari le Yuda meetu aaing'uaa ilubot pokira oong'uan e nkop. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keiwuang ilo lom le Efraim, ore lelo ooiture Yuda neiwuang'ieki; meigil Efraim aatayie olom Yuda, nemeigil Yuda aiture Efraim. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa keor ninche ebaiki oloililai loo filisti te nkalo o loo ntoluo, neibung'a ninche te nebo aaidaikie iltung'ana lo loosaen. Nepik ninche nkaik enye enkop e Edom o Moab, ore ile Amon neiruk ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Emb 16.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naa keishie Olaitoriani katukul olkina le naiposha e Misiri; naa keyuk ninye enkaina enye te shumata olkeju, te ilo kutati lenye opejisho, naa keosh ninye aitaa inong'ot naapishana pee eim iltung'ana anaa enkop natoyio. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa keaku keetae enkoitoi kitok naing'uaa Asiria, te nkaraki ilo pisiai otelekuaki loo ltung'ana lenyena, ina kata apa pee epuonu ninche eing'uaa enkop e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.16",
            "verseOrgIds": [
              "ISA.11.16"
            ]
          }
        }
      ]
    }
  ],
