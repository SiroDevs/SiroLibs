                  "text": "22.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kepuku enkaitubului te nkobei e Yese, nebulu olng'osila te nena tona enyena.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kerrinyunye iltung'ana apa ootaarayioki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
