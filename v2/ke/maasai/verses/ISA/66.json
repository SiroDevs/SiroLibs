                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Emb 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Amu ore anaa ina keper ng'ejuk o enkop ng'ejuk nalo nanu aitobiru, nelo atii dukuya nanu, Olaitoriani ojo, neijia elo atiu iishoritin ino, o enkarna ino, kepuo aabikoo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
