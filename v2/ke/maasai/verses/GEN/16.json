              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.22"
              },
              "items": [
                {
                  "text": "Ilg 4.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neiki Haga Abram enkayioni, neipot Abram enkarna enkayioni enye natoikio Haga ajo Ishmael. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa Abram naa oloo larin ntomoni isiet o ile pee eiki Haga ninye Ishmael.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
    }
  ],
