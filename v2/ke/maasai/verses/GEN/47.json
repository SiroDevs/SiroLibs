            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayieu nikinukaa nanu te Misiri, kake tunukayioki nanu tiatua inkuraren oo loo papa; tanapaki nanu intung'uayioki Misiri nikilo aturoo nanu te wueji enye neturorie olorere.” Newal ninye ajo, “Ekaas anaa enitejo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
