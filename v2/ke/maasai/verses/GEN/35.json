          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etabaitie ina kata inkolong'i e Isaak ilarin iip o ntomoni isiet. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye ninye, nelo eneiturrurrorre iltung'ana lenyena apa ootuata, etaa oltung'ani moruo oiputakinote nkolong'i, ore ilayiok lenyena Esau o Yakobo nenukaa ninye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
            "verseOrgIds": [
              "GEN.35.29"
            ]
          }
