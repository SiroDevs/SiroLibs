            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nelotu Yakobo enetii Isaak papaai lenye te wueji neji Mamre, aashu Kiriat-tarba (aa ninye taa eji Hebron), ine apa etamanya Abraham o Isaak. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
