            }
          ]
        },
        {
          "text": " Nenya Yosef olmumai too layiok le Israel ejoki, “Kemutan intae Enkai, naa entanap iloik lainei entung'uai ena kop.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
            "verseOrgIds": [
