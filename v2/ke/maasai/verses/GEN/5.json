        },
        {
          "text": " Ore ena buku naa ene ishoi e Adam. Ore peyie eitayu Enkai oltung'ani, eitayio ninye te nkitanyaanyukoto enye makewan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
