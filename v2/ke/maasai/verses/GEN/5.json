          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa ore inkolong'i pooki e Lamek naa iip naapishana o ntomoni naapishana o naapishana, neye ninye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.31",
