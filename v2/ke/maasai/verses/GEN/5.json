              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore peyie ebik Enosh ilarin intomoni naaudo, neaku menye le Kanan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.9",
            "verseOrgIds": [
              "GEN.5.9"
            ]
          }
        },
        {
