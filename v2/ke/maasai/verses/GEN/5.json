          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebik Enosh eidipaki aatoiu Kanan ilarin iip isiet o tomon o imiet, neeta apa kulikae ayiok o ntoyie, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.10",
            "verseOrgIds": [
              "GEN.5.10"
