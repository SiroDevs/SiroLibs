                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.6"
              },
              "items": [
                {
                  "text": "Mk 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eitayio ninye olee o eng'oruoi nemayian ninche neipot ninche ajo, tung'ani peyie eitobiru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore peyie eishu Adam ilarin iip nabo o tomoni uni, neaku ninye menye lo layioni laa ninye kewan enyaanyukie, neipot ninye ajo Seti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore inkolong'i e Adam anaa peyie eaku menye le Seti naa ilarin iip isiet. Neeta apa kulikae ayiok o ntoyie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa ore inkolong'i pooki e Adam naa ilarin iip naaudo o tomoni uni, neye ninye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
    {
