              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eishua Seti ilarin iip nabo o imiet, neaku menye le Enosh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
