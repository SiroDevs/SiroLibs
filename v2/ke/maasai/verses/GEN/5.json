            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebik seti anaa peyie eini Enosh ilarin iip isiet o naapishana, neeta apa kulikae ayiok o ntoyie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa ore inkolong'i pooki e Seti naa ilarin iip naaudo o tomon aare, neye ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
