              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.20"
              },
              "items": [
                {
                  "text": "2 Ilai 8.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Keaku olalem lino ninye inchuyie, niaku oloisiaai olalashe lino, naa tinigelunye te nkitoria enye, nigil enchata oo lmong'i natii emurt ino.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
