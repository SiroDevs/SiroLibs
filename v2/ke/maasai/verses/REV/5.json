              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo nena ng'uesi ong'uan naaishu, “Esai.” Nebatata ilpayiani aaserem.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
