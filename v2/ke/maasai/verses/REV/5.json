            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.10"
              },
              "items": [
                {
                  "text": "Isa 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nerany osinkolio ng'ejuk aajo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
