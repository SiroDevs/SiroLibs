              "type": "text"
            }
          ]
        },
        {
          "text": "pee inosinoso nkiri oo ilaiguanak, o ilarikok loo njorin, o nkiri oo ltung'ana magil, nkiri oo mbartan o noo lookedito ninche, o nkiri oo ltung'ana pooki, loolakuno o rrindiki, ndung'ot pokira, ilooti o lkituaak.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        },
