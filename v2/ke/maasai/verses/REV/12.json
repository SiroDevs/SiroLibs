              "REV.12.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.9+JOB.1.10+JOB.1.11"
              },
              "items": [
                {
                  "text": "Yoa 1.9-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.1"
              },
              "items": [
                {
                  "text": "Saka 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naning oltoilo sapuk te shumata ejo, “Eewuo taata enjeunoto, o engolon, o enkitoria e Enkai ang, o enkidimata e Kristo lenye. Amu etanang'akaki enkop olaitang'oroni loo lalashera lang, laa ninye oitang'or ninche dama o kewarie te dukuya Enkai ang. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netimira ninche ninye te ilo sarge lo Lkuoo le Ker, o to rorei le nchakenisho enye, amu eitu enyorru ninche enkishui enye o metabaiki keeya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ting'idayu naa, iyie shumata o intae lelo pooki ootii atua. Kake wooi, intae nakop o enaiposha, amu etadowuo shetani enitii te ngoro sapuk. Amu eyiolo ajo dorrop enkata enye.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee edol ilo asurai ajo etanang'aki enkop, nemir ina kitok natoiwuo enkayioni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.25"
              },
              "items": [
                {
                  "text": "Dan 7.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.7"
              },
              "items": [
                {
                  "text": "12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake eishooki ina kitok inaipuko are naaijo ino lkurragos sapuk loo lmurran, pee elotie ti ai ailany ilo asurai, nelo ong'ata, ine ewueji neitotiyieki aaitagol, te nkata, o too nkatitin, o lpisiai le nkata. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuku ilo asurai enkare naaijo olkeju eing'uaa enkutuk enye te siadi ina kitok ejo pee eoroo to loirrag le nkare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etaretuo enkop ina kitok, neng'a enkop enkutuk neijoo ilo keju otonotua ilo asurai te nkutuk enye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negorokino taa ilo asurai ina kitok nelo aitainye olarrabal eishoi natelekua e ina kitok, lelo pooki leton eibung'ita nkitanapat e Enkai, neishakenoki Yesu. Neitashe ninye to sinyai le naiposha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
