                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa 49.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "25.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ilo Kuoo le Ker otii empolos o lorika le nkitoo oaku olchekut lenye, anaa kerikoo ninche too nchorroi oo nkariak naaishu. Naa kejut Enkai pooki kiyioi too nkonyek enye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
              "REV.7.17"
            ]
          }
        }
