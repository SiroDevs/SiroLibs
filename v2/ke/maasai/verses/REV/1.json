                  "text": "37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ng'ura elotu ninye too nkatampo, naa kedol pooki ong'u ninye, lelo pooki ootaremo ninye ore loshon pooki le nkop, neyietu neishir te nkaraki ninye. Neijia taa Esai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "Emb 22.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.14"
              },
              "items": [
                {
                  "text": "Ena 3.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ara nanu Alfa o Omega,” Olaitoriani Enkai ojo, Otii taata, netii apa, naa ninye olotu, Olaidimani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enduaata e Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
