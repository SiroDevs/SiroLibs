            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embolunoto e Yesu Kristo, naishoo Enkai ninye meitaduaa isinkan lenyena, imbaa nemeeta nchere meaku aasioki; neisho metayiolouni te nkirriwakinoto nairriwaka olmalaika osinka lenye Yohana, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "oishakenoko ororei le Enkai o enchakenisho e Yesu Kristo, ebaiki nena pooki naatoduaa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emayiana ilo oisoma metoning'i irorei le naibon nemayiana lelo ooning, neibung nena naaigero te ine, amu etataana enkata.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkirorokino nairriwakaki nkanisani naapishana",
          "type": "text"
        }
      ]
    },
    {
