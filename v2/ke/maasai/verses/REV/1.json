                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanu Yohana oigeroki isirito naapishana e Asia: Metaa eninyi empiris o eseriani eing'uaa ilo otii taata, netii apa, naa ninye kenya olotu netii neing'uaa sii inkiyang'eta naapishana naatii dukuya olorika le nkitoo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.4"
              },
              "items": [
                {
                  "text": "Isa 55.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27"
              },
              "items": [
                {
                  "text": "Olke 89.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " neing'uaa Yesu Kristo olchakeni osipa, laa ninye olkikau loo lootuata, naa Olaitoriani loo laiguanak ootii enkop.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
