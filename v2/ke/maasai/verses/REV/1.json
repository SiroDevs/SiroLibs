                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Emb 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " neitaa iyiook kituaak, o lapolosak le Enkai Menye lenye, metaa enenye enkisisa o enkitoo ntarasi o ntarasi. Esai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        },
