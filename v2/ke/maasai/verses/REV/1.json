            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu Yohana olalashe linyi ong'arie intae ti atua Yesu, osina o enkitoo o eng'iriata o enkisulata, atii apa lemankale",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.9",
              "type": "text"
            },
            {
              "text": "lemankale",
              "type": "text"
            },
            {
              "text": "olodung'oro le nkare",
              "type": "text"
            }
          ]
        },
        {
          "text": " le naiposha oji Patmos te nkaraki ororei le Enkai o enchakenisho e Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naainepu Enkiyang'et te nkolong o Laitoriani, naning oltoilo kitok te siadi nanu laaijo ole ntarumpeta, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejo, “Ingero nena nidol ti atua embuku nirriwaki nena sirito pokira naapishana, ene Efeso, o Smirna o Pergamum o Tiatira o Sardis o ene Filadelfia o Laodikea.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
