                "loc": "EXO.38.21"
              },
              "items": [
                {
                  "text": "Ena 38.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore te siadi ena naing'orisho, ore enkaji e Enkai o lng'obor le nchakenisho ti atua shumata neboli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipang'u ti atua ina aji e Enkai lelo malaika oopishana ooata ilmeita oopishana, eishopito nkilani nemeiduruk naawang oleng neenita too lgooitie lenye inkimeitani e sahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nabo e nena ng'uesi ong'uan naaishu, neisho lelo malaika oopishana ngirran naapishana e sahabu naabore engoro e Enkai, naishu ntarasi o ntarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
