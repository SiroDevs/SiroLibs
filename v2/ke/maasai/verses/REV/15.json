    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilmalaika oota ilmeita oo bayie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitoki adol entoki sapuk enking'asia te shumata, kitok naa ene nking'asia, ilmalaika oopishana ooata ilmeita oopishana laa ninche oobayie, laa te ninche etimitunye engoro e Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitoki adol entoki naikununo anaa enaiposha e kiook nashulare enkima. Ore lelo ootimira ina ng'ues o enkitanyaanyukoto enye o esiana e nkarna enye, neitashe te mbata e ina aiposha e kiook, neibung'ita nkinantani e Enkai too nkaik enye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.1"
              },
              "items": [
                {
                  "text": "Ena 15.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nerany osinkolio le Musa ilo sinka le Enkai o sinkolio lo Lkuoo le ker, ejo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
