          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene isiet Yeshaia, o layiok lenyena, o lalashera lenyena pokira tomon oare, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
          }
        },
        {
