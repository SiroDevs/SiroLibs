          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene tomon oobo Asarel, o layiok lenyena, o lalashera lenyena pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
