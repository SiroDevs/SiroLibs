          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ene tomon oo ng'uan nedoiki Matitia, o layiok lenyena, o lalashera lenyena, pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
