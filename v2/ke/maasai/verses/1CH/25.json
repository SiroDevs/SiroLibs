          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ene tomon oimiet, nedoiki Yeremot, o layiok lenyena, o lalashera lenyena pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.22",
