            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene tomon oare Hashabia, o layiok lenyena, o lalashera lenyena, pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
