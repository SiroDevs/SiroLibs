          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene tomon ookuni Shubael, o layiok lenyena, o lalashera lenyena pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
