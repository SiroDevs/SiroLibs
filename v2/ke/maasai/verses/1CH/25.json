          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene tomon Shimei, o layiok lenyena, o lalashera lenyena, pokira tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
