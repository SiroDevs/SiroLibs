          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedoiki ene naaudo Matania, o layiok lenyena, o lalashera lenyena pokira, tomon oare; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
