              "type": "text"
            }
          ]
        },
        {
          "text": " Ore ake pee emoruau Daudi, neitaa Solomon olayioni lenye metaa olaiguanani le Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
