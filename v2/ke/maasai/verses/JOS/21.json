          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te lelo le Gershon, lo olmarei obo loo lmareita le Lawi, neishori olpisiai le nkop e Manase, Golan te Bashan te nebo iwuejitin enyena neeirritishoreki - nkanas are; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore to losho le Isaakar neishori Kishion te nebo iwuejitin enyena neeirritishoreki, Daberat te nebo iwuejitin enyena neeirritishoreki, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarmut te nebo iwuejitin enyena neeirritishoreki, En-ganim te nebo iwuejitin enyena neeirritishoreki - nkanas ong'uan; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
