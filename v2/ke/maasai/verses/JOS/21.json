          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimna te nebo iwuejitin enyena neeirritishoreki, Nahalal te nebo iwuejitin enyena neeirritishoreki - nkanas ong'uan; ",
          "type": "text",
          "attrs": {
