          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedemot te nebo iwuejitin enyena neeirritishoreki, o Mefaat te nebo iwuejitin enyena neeirritishoreki - nkanas ong'uan; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
