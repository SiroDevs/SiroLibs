              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa nkanas oo le Lawi ti atua ina kop oo ltung'ana le Israel naa nkanas artam o isiet pooki te nebo iwuejitin enye neeirritishoreki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kuna anas neeta ake pooki anasa ewueji enye neirritishoreki namanita ninye; neijia apa etiu te kuna anas pooki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ewaita Israel enkop aaitaa enenye",
          "type": "text"
        }
      ]
    },
    {
