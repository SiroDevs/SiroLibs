              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore to losho le Ruben neishori Beser te nebo iwuejitin enyena neeirritishoreki, Yahas te nebo iwuejitin enyena neeirritishoreki, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
