{
  "id": "ACT.16",
  "number": "16",
  "bookId": "ACT",
  "reference": "Iat 16",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eiriamariyie Timoteo Paulo o Sila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelotu sii Derbe o Listra, naa ng'ura, eetae apa oloiteng'eni te ine oji Timoteo, olayioni le nkitok Yahudi nairuko, kake Olyunani menye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neimaki lalashera ninye aarrep ilootii Listra o Ikonio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninye etegelua Paulo pee eiriamariyie; neibung nemurat te nkaraki lelo Yahudi le ilo kirine; amu keyiolo pooki aajo Olyunani apa menye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore epuoito te nkoitoi eimaa nkang'itie, neisho napa baa meibung'a, naaitanapishote lkipaareta o lpayiani ootii Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa nedupayu nena sirito enkirukoto, neponari esiana anaa ake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etoduaa Paulo te nkidetidet oltung'ani le Makedonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neimaa olkirine le Frigia o Galatia, etirishie Enkiyang'et Sinyati pee melikioo ilo rorei te Asia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee epuonu aaipirare Misia, netem aajo matijing Bitinia; neitu eisho Enkiyang'et e Yesu meshomo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "neim embata e Misia nedou aapuonu Troas. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipang'aki Paulo enduaata kewarie, oltung'ani oitashe le Makedonia, osaita ninye ajoki, “Wou talang'u Makedonia, taretu iyiook.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee edol Paulo ina, neiteru nabo kata aing'oru elototo nalo Makedonia, etumuta ajo Enkai naipoto iyiook maape aaliki ninche ele rorei supat.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eiruko Lidia te Filipi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee kijing empeut te Troas, nikipolos aaitoriokino Samotrake, nikiyiooki te ntaaisere aapuo Neapolis; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikidumunye te ine aapuo Filipi; enkanasa e Makedonia, naa ninye enkanasa kitok te ilo kerenket, naa abori oo Roma etii: nikibik te ina anasa nkolong'i naaje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkolong e sabato nikimpang auluo kishomi e ina anasa, te mbata o lkeju, kijo ebaiki neetae ewueji e nkomono te ine; nikitoni, aairorie nkituaak naatoni te nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii enkitok naji Lidia naa enkamirani oo lkarash oodo, naa ene nkanasa naji Tiatira, naserem ninye Enkai, nening iyiook. Nebol Olaitoriani e ltau lenye, metoning'o mbaa naairoro Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eibatisai ninye o enkaji enye, nesai iyiook, ajoki, “Te nikitoduaa intae aajo kaisiligayu to Laitoriani, wootu entijing enkaji ai, entotoni.” Neidimu iyiook.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eteenaki Paulo o Sila te Filipi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ore kipuoito ine wueji e nkomono, nenang'are iyiook esila naata e nkiyang'et e naibon nadol imbaa, netopokie lkituaak lenyena ninye too masaa naayaki te ina aibon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesuj ninye Paulo o iyiook nebuaku eishir ajo, “Ore kulo tung'ana ilaisiaayiak le Nkai natii Shumata Aisui te pooki, naa intae eliki enkoitoi e njeunoto.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiko neijia nkolong'i kumok. Kake ore Paulo, etanyamala oleng neibelekenya nejoki ilo oirirua, “Aaitanapa iyie te nkarna e Yesu Kristo tupuku tung'uai ninye.” Nepuku aing'uaa te ina saa ake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore pee edol ilopeny aajo eshomo osiligi le ina dupoto enye, neibung Paulo o Sila, neikurtutaa aaya enetii laitoriak te nemirishoreki, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore pee eyau enetii iladung'ok le nkiguana, nejo, “Ore kulo tung'ana, loo Lyahudi, eitanyamalita naleng ena anasa ang, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "aalimu lkerreti lemeishoruno matang'amai arashu kisuj, kira Iroma.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedumakino esiamo pooki te nebo nepololoki lkilani lenye aaoru, neitanapisho meidong'i too ng'udisin. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eitudupaki ninche iwoshot kumok, nenang'akini korokoroni, neitoriakini olarriponi meitirrisha oleng. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eng'amu ilo ina kitanapata, nepik ninche korokoroni e atua, neen nkejek enye akurraki too lgarrameta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore etaa keitorito enkewarie eomonito Paulo o Sila neranyaki Enkai isinkoliotin; neinining'ito ilooena ninche; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore nabo kata, neikirikira enkop, neigirigiro lkitamanyunot le ina aji e korokoroni; nebolo nabo kata nkutukie enyena pooki; nelaa lgarrameta loo looena pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee einyiototo olarriponi etuputuoki too njo, nedol inkutukie e korokoroni ebolo, neshutu olalem neaku kejo aar kewan, ejo keisika ilooena aapuo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etabuaa Paulo to ltoilo sapuk, nejo, “Miar kewan, kitii pooki ene.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipotu lkilangilang'eta, nengorokino atua, eikirikira te nkuretisho, nebatatakino Paulo o Sila, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitupuku, nejoki, “Lo kituaak, kaji aiko pee ajeu?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ninche, “Iruko Olaitoriani Yesu, pee ijeu iyie o enkaji ino.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neinosaki ninye ororei lo Laitoriani, te nebo lelo pooki ootii enkaji enye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedumu ninye ninche te ina saa ake e nkewarie, neisuj nena oshot enye, neibatisae ninye nabo kata o lelo lenyena pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neriku ninche enkaji enye, neisho endaa, neshipa oleng o enkaji enye pooki, eiruko Enkai.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ekenyu, neirriu iladung'ok le nkiguana lsikarini nejoki, “Enchoo lelo tung'ana epuo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyaki olarriponi le korokoroni Paulo ilo rorei, ajoki, “Eirriutua iladung'ok le nkiguana olkilikuai meishori intae enchom, enyeito naa taata naa enchom te seriani.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etiaaka Paulo ninche, “Etaara iyiook te dukuya olorere, eitu eiguanareki iyiook, nikira sii ile Roma, netanang'akita iyiook korokoroni; neyieu taata neitupuku iyiook too nkurrat? Mme neijia; kake enchoo epuonu ninche maate aaitupuku iyiook.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuo lelo sikarini aainosaki iladung'ok le nkiguana lelo rorei, neureishoyu, etoning'o aajo ile Roma ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuonu aasai ninche; ore pee eitupuku, neikilikuan te naa kepuo aaing'uaa ina anasa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuku ninche te korokoroni, nepuo enkaji e Lidia: ore pee eidip aatodol ilalashera, neilejilej ninche nepuo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    }
