        },
        {
          "text": "Neaku etegelutua ltung'ana aare: Yosef oji Barsabas (neji sii Yustus), o Matias. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
