          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neomon ninche nejo, “Olaitoriani, iyiolo iyie ltauja loo ltung'ana pooki. Ore te nkaraki ina, Olaitoriani, tuutaki iyiook olitudutayie te kulo pokira aare, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
