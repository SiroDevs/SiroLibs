              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ojing ena rishata aaku olkipaaret neisiaaisho amu eshomo Yudas ewueji enye apake.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
