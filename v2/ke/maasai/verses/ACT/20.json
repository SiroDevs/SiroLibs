          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neishiraki pooki ninye oleng, nemuataki Paulo nkaik neng'utut ninye, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
