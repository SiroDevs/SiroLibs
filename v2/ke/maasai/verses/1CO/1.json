                  "text": "Yer 9.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Peyie, anaa enajo lkigerot, “Ore ake oloyieu neng'ida nchoo eng'idare Olaitoriani.”",
          "type": "text",
          "attrs": {
