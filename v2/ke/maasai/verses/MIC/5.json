      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitamanaki intae esuntai, etamanaki iyiook aamuat to ngudi etoosho ninche eseder o Laitoriani le Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eisiligishore Olaitoriani olaiguanani oing'uaa Betlehem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
