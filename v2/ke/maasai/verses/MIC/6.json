          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.23+1CH.16.24+1CH.16.25+1CH.16.26+1CH.16.27+1CH.16.28+1CH.16.29+1CH.16.30+1CH.16.31+1CH.16.32+1CH.16.33+1CH.16.34"
              },
              "items": [
                {
                  "text": "1 Int 16.23-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.25+1CH.21.26"
              },
              "items": [
                {
                  "text": "21.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu imbung'a iyie nkikoot e Omri, o siaaitin pooki e nkaji e Ahab; nimbung'a iyie nkikoot enye, pee aatum nanu aitaa iyie olmuaate naitaa emanyisho ino entoki naimakini; neaku inap iyie esukeny oo ltung'ana.”",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    }
