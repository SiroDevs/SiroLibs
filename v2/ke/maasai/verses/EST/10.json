      },
      "items": [
        {
          "text": "Enkitoo e Serser o Mordekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitalaku olaiguanani Serser kodi te ina kop o to loomanaa loo naaiposha. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iasat enyena pooki o engolon o enkidimata, o lomon pooki le nkitoo e Mordekai, naishoo olaiguanani ninye, aimeigero kuna te mbuku oo nkoon oo laiguanak le Media o Parsia? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu Mordekai ilo Yahudi naa ninye apa osujita te nkitoo olaiguanani Serser, naa aikitok too Lyahudi nening'o to lorora loo lalashera lenyena, amu eing'orua olmabarishoi loo ltung'ana lenyena neiro eseriani too ltung'ana lenyena pooki.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
