          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newal Elihu olayioni le Barakel le Busi ajo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
