                {
                  "text": "Ilari 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore apa te nena olong'i nemeetae olaiguanani te Israel; etaasa ake pooki tung'ani enaishiaakino too nkonyek enyena.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
