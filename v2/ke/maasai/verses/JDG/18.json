              "JDG.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyau ninche nena tokitin apa naaitobirua Mika, o ilo apolosani apa ora olenye, nepuonu lelo tung'ana le Dan Laish, enetii iltung'ana oobor lememuso, nesesekuan ninche te nepi o lalem, nepejoo ina anasa te nkima. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemeetae apa olakordunoni amu kelakuaniki apa ninye Sidon, nemetii apa kulikae tung'ana ooata enabaikinore ninche. Etii atua oerata le Bet-rehob. Neitoki apa ninche aashet ina anasa nemany atua. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neisho apa ina anasa enkarna aajo Dan, aaipotie nkakuyiaa lenye, apa otoiuo Israel; amu keji apa enkarna e ina anasa te dukuya Laish. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitasheikinye apa lelo tung'ana le Dan ate ina kitanyaanyukoto naguetuno; naa Yonasan ilo ayioni le Geshom, olayioni le Musa, o layiok lenyena apa ilapolosak lo losho le Dan o metabau ina olong apa natarayoki ilo osho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eitasheyie apa ninche ina kitanyaanyukoto e Mika naguetuno, naitayio ninye ina kata pooki apa natii enkaji e Nkai te Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
      ]
