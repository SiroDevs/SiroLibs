      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olerrinyore le ng'eno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkerai ai, tining'amaa irorei laainei, nishum aiteng'el inkitanapat aainei tenebo iyie, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nincho inkiyiaa inono einining aasipu eng'eno, nirrugu oltau lino aaku oloyiolou; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ee tininchiru aomonu ening'unoto oo rorei oogut, nidumu oltoilo lino aaku oloning'u. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tining'oru ninye anaa enkosholai, nijurru aing'oru ninye oleng anaa enoshi toki e tipat naisudoro. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku iyiolou iyie euriata o Laitoriani, nitum eng'eno e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu Olaitoriani ninye oishoru eng'eno; enkutuk enye epukunye eng'eno o eyiolounoto. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiteng'ela ninye eng'eno sidai te lelo ooitashe too sipat; ninye elong'o e lelo oopuo te mborron. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Errip inkoitoi oo sipat negolie enkoitoi oo sinyat lenyena.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina pee indimidimi aatayiolo esipata o enkiguana e sipata o emborron, o pooki oitoi sidai. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kelotu eng'eno atua oltau lino, ore eyiolounoto neaku aisidai tiatua oltau lino. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aikirrita iyie eyiolounoto; nikirrip eyiolounoto iyie. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.11",
            "verseOrgIds": [
              "PRO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikintajeu iyie aitung'uaa enkoitoi oo ntorrok, aitung'uaa iltung'ana ooiro nkirorot torrok, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lelo oing'uaa inkoitoi e nkitashoto sidai aaim inkoitoi e naimin. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshipa te neas intorrok, neshipakino ina kiminata e ntorroni, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iltung'ana laa ore inkoitoi enye naa keriwuo naa inaapaashaa neimin ninche tiatua inkoitoi enye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aikintajeuni iyie te ina kitok naibor onyek, ina kitok nairo te nkutuk enye irorei oo melook. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.16",
            "verseOrgIds": [
              "PRO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina kitok apa natung'uayie olpayian lenye le lelero, nerikino ninye osotua le Nkai enye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore enkaji enye naa keimis adoiki keeya, ore inkoitoi enyena nepuo enetii ilootuata. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeta ololo enetii ninye oitoki ashukunye nemeitoki aatum inkoitoi empuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.19",
            "verseOrgIds": [
              "PRO.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa ilo iyie te nkoitoi oo ltung'ana supati, nimbung nena oitoi oo lasipak. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.20",
            "verseOrgIds": [
              "PRO.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu lelo ooitashe too sipat oomany ena kop, ore iltung'ana oobor naa kebikoo tiatua, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.21",
            "verseOrgIds": [
              "PRO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake kedung'ori ilarruok te ina kop, ore ilaitang'orok nedotuni too ntona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.22",
            "verseOrgIds": [
              "PRO.2.22"
            ]
          }
        }
      ]
    }
  ],
