          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ina natoduaa inkonyek inono, misioki aisosion ayau atua enkiguana; anaa kaa ias te siadi; tinikilo ole latia ino aitukurru?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
