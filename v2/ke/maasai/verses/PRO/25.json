              "type": "text"
            }
          ]
        },
        {
          "text": "Amu inturrurroki ninye inkuk naishu shumata endukuya enye, naa aikilaaki iyie Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.22",
