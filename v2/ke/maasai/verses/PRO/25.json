              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa enatiu olgisoi le sahabu arashu e masaai e sahabu neija etiu ilo ng'en oisikong enkiok naning'isho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
