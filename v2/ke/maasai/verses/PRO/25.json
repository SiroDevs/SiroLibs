              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olkutati oing'uaa moikuape naa keyau enchan; ore olng'ejep okurrisho neyau engoro. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.23",
            "verseOrgIds": [
