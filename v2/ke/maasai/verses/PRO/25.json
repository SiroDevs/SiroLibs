          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu enaikash tinikijokini, “wou ilepu ene” alang tinikintadoyiori te netii olaiguanani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
