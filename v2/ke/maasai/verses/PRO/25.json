              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "meyau ake ilo oning enkurruna shumata iyie, nitum enkurruna nemeeta enkiting'oto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
