              "type": "text"
            }
          ]
        },
        {
          "text": " Mipik kewan dukuya ine netii olaiguanani arashu doi intashe te ine wueji olkitok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
