          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enaikash tinimany olpijata le nchumata enkaji, alang tiniboitare te e nkaji enkitok naata enchankar. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.24",
            "verseOrgIds": [
              "PRO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa enatiu enkare nairobi to ltau oota enkure, neija etiu ilomon supati ooing'uaa enkop nalakua.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.25",
            "verseOrgIds": [
              "PRO.25.25"
            ]
          }
        }
