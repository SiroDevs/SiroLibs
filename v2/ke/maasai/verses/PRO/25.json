          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwuang'ie lelo torrok te dukuya olaiguanani naa keitasheyieki olorika lenye le nkitoo te sipata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
