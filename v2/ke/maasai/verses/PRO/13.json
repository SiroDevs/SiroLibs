        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo omenaa ororei le nkikoo neyaki kewan enkidaata, kake ore ilo oyanyit enkitanapata naa ketum olerrinyore.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
