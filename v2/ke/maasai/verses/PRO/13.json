          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore to lwuasa neishankarra lelo lemening'isho, kake ore lelo ooibung enkikoo netum eng'eno nagut.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
