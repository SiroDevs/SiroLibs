        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore endamunoto sidai netum omom, kake ore enkoitoi e lelo le meeta enkirukoto naa enkidaaroto enye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
