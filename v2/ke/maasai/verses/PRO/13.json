          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejing'aki aisinanisho o esulare ilo lemeitaa toki iutarot, kake ore ilo oning'u inkisikong'at naa keanyituni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
            ]
          }
        }
      ]
    },
