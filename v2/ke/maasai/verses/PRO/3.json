              "PRO.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.17"
              },
              "items": [
                {
                  "text": "Yoa 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enkerai ai, mimenaa enkitamioto e utaroto nikiosh Olaitoriani; arashu inauru te rerioroto nikirere, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.5+HEB.12.6"
              },
              "items": [
                {
                  "text": "Ilh 12.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.19"
              },
              "items": [
                {
                  "text": "Emb 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " amu kererioo Olaitoriani ilo onyor anaa olpayian orerioo enkerai enye nanyor. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emayiana oltung'ani otum eng'eno nagut, oltung'ani otum eyiolounoto. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore dupoto enye nelang dupoto e nkosholai ore sii dupoto enye nelang sahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeta ninye tipat alang isoito oogol enkinyang'a, nemeeta entoki niyieu nindim aitanyaanyukie ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etii enkishui naado atua enkaina enye e tatene, ore atua enkaina enye e kedienye netii enkarsisisho o enkanyit. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.16",
            "verseOrgIds": [
              "PRO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore inkoitoi enyena naa inaaitishipisho, ore nkoitoi enyena pooki naa eseriani. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.17",
            "verseOrgIds": [
              "PRO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ninye naa olchani le mpuaan te lelo ooibung ninye; ore lelo oibung aakurraki naa keji ilooshipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.18",
            "verseOrgIds": [
              "PRO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitobira Olaitoriani enkop te ng'eno nagut, ore te yiolounoto eitasheyie keper o ntokitin naatii. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.19",
            "verseOrgIds": [
              "PRO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ng'eno enye eitayio ineegut, ore inkatampo neitadou enkoileelio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.20",
            "verseOrgIds": [
              "PRO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkerai ai, imbung'a eng'eno sidai o eyiolounoto; mincho ninche kisik aaing'uaa, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.21",
            "verseOrgIds": [
              "PRO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa keaku enkishui to ltau lino, naa emasaai sidai e murt ino. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.22",
            "verseOrgIds": [
              "PRO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ilo te nkoitoi ino iserian, nemerrorro enkeju ino. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.23",
            "verseOrgIds": [
              "PRO.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinilo niton, nimiata enkuretisho; tinirrag airura, naa kemelok injo inono. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.24",
            "verseOrgIds": [
              "PRO.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miure olkirutoto likiluam, arashu emutata oo larruok te nelotu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.25",
            "verseOrgIds": [
              "PRO.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu keaku Olaitoriani osiligi le nkitashoto ino, naa kerrip enkeju ino pee meibung'i.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.26",
            "verseOrgIds": [
              "PRO.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.26",
            "verseOrgIds": [
              "PRO.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimitiki isidain ilooishaakino ina kata aa iyie oota enkidimata pee ias. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.27",
            "verseOrgIds": [
              "PRO.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mijoki olelatia lino, “Shomo pee intoki ashukunye, ekaaisho metabaiki” – ti niata ina kata ina toki. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.28",
            "verseOrgIds": [
              "PRO.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mintobiraki ole latia ino entorroni ainyal, lelo ootoni kisilig tembata ino. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.29",
            "verseOrgIds": [
              "PRO.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miarare oltung'ani metii esipata, eitu kintaas iyie entorroni. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.30",
            "verseOrgIds": [
              "PRO.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migilaki ong'u oltung'ani onyor olarrabal, nimigelu hoo nabo oo nkoitoi enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.31",
            "verseOrgIds": [
              "PRO.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore oltung'ani ogolong'u naa olminong",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.32",
            "verseOrgIds": [
              "PRO.3.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.32",
              "type": "text"
            },
            {
              "text": "olminong",
              "type": "text"
            },
            {
              "text": "enturuj, entoki naiduruk naa entaboi teneasi",
              "type": "text"
            }
          ]
        },
        {
          "text": " to Laitoriani, kake ore lelo ooitashe too sipat netii atua enkisiligata enye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.32",
            "verseOrgIds": [
              "PRO.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etii oldeket le Nkai shumata enkaji oo larruok, kake kemayian ninye emanyisho oo supati. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.33",
            "verseOrgIds": [
              "PRO.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.6"
              },
              "items": [
                {
                  "text": "Yko 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.5"
              },
              "items": [
                {
                  "text": "1 Pet 5.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore lelo oomenisho naa kemanaa ninye, kake ore iloobor neisho omom. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.34",
            "verseOrgIds": [
              "PRO.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani ng'en naa kejung enkanyit, kake ore ilmoda netum enkurruna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.35",
            "verseOrgIds": [
              "PRO.3.35"
            ]
          }
        }
      ]
    }
  ],
