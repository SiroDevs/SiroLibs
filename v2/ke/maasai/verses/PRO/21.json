          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oiken enkiok enye pee mening enkishirata e lelo aisinak, naa keishir sii ninye nemeetae oloning ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        }
      ]
    },
    {
