          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo torrono naa elakunoto eilo supat, ore olemeisiligayu naa elakunoto oloitashe too sipat.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        }
      ]
    },
    {
