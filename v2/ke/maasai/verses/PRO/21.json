          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltau leilo torrono neyieu intorrok, metum olelatia enye olng'ur too nkonyek enyena.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.10",
            "verseOrgIds": [
              "PRO.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te neitamei oloikordodisho, neng'enu olmodai ore te neutari oltung'ani ng'en, netum eng'eno.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.11",
            "verseOrgIds": [
              "PRO.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore isupati neing'or enkaji eilo torrono; enang'akini iltorrok enkidaaroto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.12",
            "verseOrgIds": [
              "PRO.21.12"
            ]
          }
        }
      ]
    },
    {
