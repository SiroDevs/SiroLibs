      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltau lo laiguanani naa ereyiet e nkare tiatua enkaina o Laitoriani. Neibelekenyaki ninye pooki wueji neyieu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.1",
            "verseOrgIds": [
              "PRO.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki oitoi te tung'ani naa sidai too nkonyek enyena, kake Olaitoriani ninye oineneng' oltau.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
            "verseOrgIds": [
              "PRO.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Easata oo supati o esipata, ninye nang'amaroyu too nkonyek o Laitoriani alang enkitayunoto o lasar.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.3",
            "verseOrgIds": [
              "PRO.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nkonyek olwuasa tenebo oltau o wuasa, oltaa loo ltorrok naa ing'ok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
            "verseOrgIds": [
              "PRO.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nkitobirat e ilo oota enyuata osipa erikoki ninye puaan te nkumoi, kake ore pooki osioki neiting ake te yieunoto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olchumati litum tolng'ejep olejisho, netiu anaa enkinuku nasiooyo aish naa orreshet le keeya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkinyala oo ltorrok naa keoroo ninche aishu, amu etanyaita eas ina nasipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.7",
            "verseOrgIds": [
              "PRO.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkoitoi eilo torrono naa kekordilo, kake ore olkuaak leilo supat naa aisidai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.8",
            "verseOrgIds": [
              "PRO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enaikash tinimany olpijata le nchumata enkaji, alang tinitii enkaji e nkitok naata ororei.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.9",
            "verseOrgIds": [
              "PRO.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
