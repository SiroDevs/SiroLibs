        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani olo aing'uaa enkoitoi e ning'unoto netum eneeng'iyeng'are to lturrur loo loo tuata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.16",
            "verseOrgIds": [
              "PRO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
