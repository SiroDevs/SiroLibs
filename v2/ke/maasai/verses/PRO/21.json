          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkishooroto naishoruni too nkisudorot naa keshuk engoro; ore eropare oo nkishorot neitigir engoro sapuk.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
