          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.16",
            "verseOrgIds": [
              "PRO.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo tung'ani onyor esikar naa keaku oltung'ani aisinani ore ilo onyor enaisho o ila nemeaku karsis.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.17",
            "verseOrgIds": [
              "PRO.21.17"
            ]
          }
        }
      ]
    },
    {
