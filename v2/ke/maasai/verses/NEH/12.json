            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.12"
              },
              "items": [
                {
                  "text": "26.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Etaasa apa ninche esiaai e Nkai enye o esiaa nkitisinyata anaa enataasa ilaranyak o larripok le kishomi, te risioroto e nkitanapata e Daudi o layioni lenye Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore apa too nkolong'i e Daudi o Asaf, tiapa, neetae olkitok loo laranyak, neetae isinkolioitin le nkisisa o enkishooroto e nashe te Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Israel pooki too nkolong'i e Serubabel o too nkolong'i e Nehemia, neisho erubata e anaake lelo aranyak, o larripok le kishomi; neiteng'el ninche ina rubata oo Lawi; neiteng'el ile Lawi ina rubata oo layiok le Aron.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
