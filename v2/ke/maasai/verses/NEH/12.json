              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olikae turrur le lelo ooishooyo enashe, nepuo enkalo e kedienye, nasujaa nanu ninche tenebo olpisiaai le lelo tung'ana ootii enchumata e suntai, te nchumata o ltalet le wueji nepejishoreki, o metabaiki esuntai nalala, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "o metabaiki kishomi e Efraim, o embata e kishomi musana, o embata e kishomi o sinkirri o ltalet le Hananel, o ltalet le iip o metabaiki kishomi oo nkerra. Nepuonu ninche aaitashe te kishomi oo larripok. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa ore lelo turrurri pokira oare le lelo ooishooyo enashe neitashe tiatua enkaji e Nkai; ore nanu o lpisiaai loo nkituaak tenebo nanu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "o lapolosak, Eliakim o Maaseia, o Miniamin, o Makaia, o Elioenai, o Sekaria, o Hanania, eeta ntarumpetani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "o Maaseia, o Shemaia, o Eleasa, o Eusi, o Yehoahanan, o Malkija, o Elam, o Eser. Neranyisho ilaranyak erikoo Yesrahia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitayu ninche ilasarri sapuki ina olong, neshipayu amu Enkai naitishipa ninche te ng'ida sapuk; neshipa sii nkituaak o nkera. Nening'ori enchipai e Yerusalem tenelakua oleng.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkishorot te nkaraki eseremata tiatua enkaji e Nkai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
