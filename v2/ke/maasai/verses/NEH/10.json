                "loc": "EXO.30.11+EXO.30.12+EXO.30.13+EXO.30.14+EXO.30.15+EXO.30.16"
              },
              "items": [
                {
                  "text": "Ena 30.11-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinteleikitia sii ate olola pee kintalak ate te pooki ari erubata e uni e shekeli te nkaraki enkisiaayiare e nkaji e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te nkaraki emukate e nkitoduaaroto, o lasar le ntapa le anaake, o lasar opejori le anaake, o sabatoni, o lapaitin ng'ejuko, o siruai gelunot, o ntokitin sinyat, o lasarri le ng'oki ooitobirieki olning'o lo sotua te nkaraki Isirael, o te nkaraki esiaai pooki e Nkai ang. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitoosho sii enkukuo, ilapolosak, o Lawi, o ltung'ana, te nkaraki nkiri olasar loo lkeek, pee eyauni atua enkaji e Nkai ang, te risioroto oo nkajijik oo loo papa, too nkatitin naategeluaki, te pooki ari. Pee einoki te nchumata o lperere lo lasar lo Laitoriani Enkai ang anaa enaigero too nkitanapat. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Ena 23.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.26"
              },
              "items": [
                {
                  "text": "34.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "Enkig 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kitudung'okitio iyiook ate, pee kiyau ilng'anayio le dukuya te nkop ang, o lng'anayio le dukuya le pooki shani, te pooki ake ari, enkaji o Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ena 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikiyau sii atua enkaji e Nkai ang, aayaki lelo apolosak ooisiaaisho tiatua enkaji e Nkai ang, ilkikaunot lang o lkikaunot loo nkishu ang, anaa enaigero too nkitanapat, o lkikaunot loo nkishu ang o loo ntare ang. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Enki 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nikiyaki sii ilapolosak ina tapa ang e dukuya e nkisampuare, o nkishorot ang, o lng'anayio le pooki shani o enaisho oo sabibu o eilata nikiya ilgilat le nkaji e Nkai ang, nikiyaki Ilawi ematua e tomon naing'uaa nkurman ang, amu Ilawi oosotu imatuan e tomon, too nkang'itie ang pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.26"
              },
              "items": [
                {
                  "text": "Enki 18.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore olapolosani olayioni le Aron, naa keetii tenebo Ilawi ina kata nang'amu imatuan e tomon neyau Ilawi ematua e tomon oo matuan e tomon e nkaji e Nkai ang nepik ilgilat o mpechen. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu keyau iltung'ana le Israel o layiok le Lawi nkishorot e ntapa, o enaisho oo sabibu, o eilata atua lelo gilat, ine netii imasaa e wueji sinyati, o lapolosak ooisiaaisho o larripok le kishomi o laranyak. Mikipalaa iyiook enkaji e Nkai ang.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
