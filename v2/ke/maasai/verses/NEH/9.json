          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Esra:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eigero iltung'ana embae natoning'okinoteki",
          "type": "text"
        }
      ]
    }
  ],
