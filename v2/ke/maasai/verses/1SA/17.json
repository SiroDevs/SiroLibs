              "1SA.17.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 17:50"
          },
          "items": [
            {
              "text": "50",
