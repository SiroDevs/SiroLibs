      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki sii Daudi aya Ahinoam e Yesreel; neaku ninche pokira are nkituaak enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.14+2SA.3.15+2SA.3.16"
              },
              "items": [
                {
                  "text": "2 Sam 3.14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neishoo apa Saul Mikal, entito enye, ina kitok e Daudi, Palti olayioni le Laish, laa olayioni le Galim apa ninye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
            "verseOrgIds": [
              "1SA.25.44"
            ]
          }
        }
      ]
