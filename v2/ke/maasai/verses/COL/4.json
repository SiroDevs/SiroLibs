              "attrs": {
                "loc": "EPH.6.21+EPH.6.22"
              },
              "items": [
                {
                  "text": "Efe 6.21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tikikos olotu aliki intae mbaa aainei; olalashe lai lanyor naa olaisiaayiani oisiligayu naa osinka le ncholiek ai ti atua Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu oirriwua enitii ajo pee, itumutumu aatayiolo enikitiu netum ailejileja iltauja linyi, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Fil 10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " neiriamunore Onesimas olalashe onyorri neisiligayu, laa obo linyi. Ninche oopuonu aainosaki intae mbaa pooki naataasate te ne.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
