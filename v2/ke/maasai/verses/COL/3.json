        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.22"
              },
              "items": [
                {
                  "text": "Efe 5.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kituaak, entoning ilpayiani linyi, anaa enaitoriori ti atua Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Efe 5.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.7"
              },
              "items": [
                {
                  "text": "1 Pet 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lo payiani, entonyor inkituaak inyi, emisomit. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.1"
              },
              "items": [
                {
                  "text": "Efe 6.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na kera, entoning intoiwuo inyi too mbaa pooki, amu ena naitiship Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.20",
            "verseOrgIds": [
              "COL.3.20"
            ]
          }
        },
        {
