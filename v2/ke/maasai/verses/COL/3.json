              "COL.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.2"
              },
              "items": [
                {
                  "text": "Efe 4.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anaa ilgelunot, le Enkai, oosinya nenyorri enchopo enanai e nkoshoke, olng'ur, emoolisho emborron o eng'iriata, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.32"
              },
              "items": [
                {
                  "text": "Efe 4.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ning'iriri oltung'ani ake te likae, naa teneeta ake oltung'ani enkigunyung'uny to likae, nepalaki olikae anaa pee kitapalaka sii iyie Olaitoriani, neaku eishiaakino sii iyie pee ipalaki. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.13",
            "verseOrgIds": [
              "COL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enaituruk te kuna pooki enchopo enyorrata, te naboisho nabaya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.14",
            "verseOrgIds": [
              "COL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa enchoo eseriani e Kristo eitoreisho ti atua iltauja linyi, amu ina eipotokoki intae ti atua ilo sesen obo. Naa enoto enashe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
            "verseOrgIds": [
              "COL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.19+EPH.5.20"
              },
              "items": [
                {
                  "text": "Efe 5.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enchoo ororei le Kristo emany atua intae te nkarsisisho, inteng'enana niutaroro olikae o likae te ng'eno pooki, iranyiranya Olkerempe le Nkai o sinkolioitin le nkishui inchosho Enkai enashe ti atua iltauja linyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.16",
            "verseOrgIds": [
              "COL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore embae ake pooki niaasiasa, to rorei aashu too nkiaasin, entaas pooki toki te nkarna o Laitoriani Yesu. Inchosho Enkai Papa enashe te ninye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.17",
            "verseOrgIds": [
              "COL.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Barare e ina kishui ng'ejuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
