              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore esiaai inyi pooki entaas too ltauja, anaa Olaitoriani iasakiki neme iltung'ana, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
