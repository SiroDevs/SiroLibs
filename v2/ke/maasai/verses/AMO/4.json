            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ataara indaiki inyi te nkeeya naitomijoon inkurman inyi aitoi isabibu linyi; ore ilng'abolo o loirienito linyi neinos olmaati; ore eyia neitu kishukokinono nanu,” Olaitoriani ojo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Airriwaka nanu atua intae olmeitai anaa apa enaikununo te Misiri; naar nanu ilbarnot linyi to lalem; naya nanu imbartan inji aiwuang'ie naya nanu olng'usil loo lng'oborri linyi apik nkumeishin inyi; ore eyia eitu intae kishukokinono nanu,” Olaitoriani ojo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
