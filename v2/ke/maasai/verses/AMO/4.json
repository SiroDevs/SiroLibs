              "items": [
                {
                  "text": "Enk 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Aidakie nanu ilkulikae te ntae, anaa apa pee eidaikie Enkai Sodom o Gomora, nitiuu apa anaa olmishire oitayioki tiatua enkima nayupuyup; ore eyia eitu intae kishukokinono nanu,” Olaitoriani ojo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
