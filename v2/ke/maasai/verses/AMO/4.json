          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neaku ena nanu aaitaas, iyie Israel, ore enkaraki naa kaas nanu ena terretenayu pee itumore Enkai ino iyie Israel!”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        }
      ]
    },
