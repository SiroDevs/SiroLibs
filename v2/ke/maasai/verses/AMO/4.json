            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore ilo oitobira ildoinyo neitayu osiuo, neibalakinye iltung'ana enaikununo endamunoto enye; ilo oitomisimis enkakenya neroro ineeika enkop–Olaitoriani, Enkai oo lororani, ninye enkarna enye!",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.13",
            "verseOrgIds": [
              "AMO.4.13"
            ]
          }
        }
      ]
