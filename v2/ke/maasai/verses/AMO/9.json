            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.16+ACT.15.17+ACT.15.18"
              },
              "items": [
                {
                  "text": "Iat 15.16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ore akenya te ina olong naitasheiyie nanu enkaji e Daudi apa naturori naitobir nanu ineetarruoitie, nashumu nanu ineeturori, naitoki nanu ashet metotiuo anaa apa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pee etum ninche aawaita olpisiai le Edom o lelo oreren pooki ooipoti te nkarna ai,” Olaitoriani ilo oas ena, ojo nji.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        }
      ]
    }
