                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore pee edol ninye olorere netum olng'ur te ninche amu eteekate ninche, nelepori neidapashari netiu anaa ntare nemeeta olchekut. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
