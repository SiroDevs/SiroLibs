          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eipung'o nepuo aaibulunye ilomon lenyena ilo kerenket pooki.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
