                  "text": "Lk 10.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki ninye ilooiteng'eni lenyena, “Esipa aisapuk enkisampuare kake kuti ilaisiaayiak. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
