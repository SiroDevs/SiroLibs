              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ejo Petero, “Ineeiking'a.” Nejoki Yesu ninye, “Neijia etiu, metii nkera enye siana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.26",
            "verseOrgIds": [
              "MAT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
