              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eiturrurro te Galilaya nejoki Yesu ninche, “Etaa epiki Enkerai e Tung'ani nkaik oo ltung'ana; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
