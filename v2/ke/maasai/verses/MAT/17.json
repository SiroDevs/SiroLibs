              "items": [
                {
                  "text": "Lk 3.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore eton eiro, ng'ura, neitushur enkatampoi nawang; naa ng'ura, nepuku oltoilo te ina atampoi ojo, “Enkerai ai ena nanyor, natishipe te ninye. Entoning ninye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.5",
            "verseOrgIds": [
              "MAT.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
