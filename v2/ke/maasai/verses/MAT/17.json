              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake mepuku eneeijo ena mme te nkomono o te mpukoroto.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eigila ake Yesu alimu enkeeya o empiunoto enye",
          "type": "text"
        }
