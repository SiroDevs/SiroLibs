                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu esipa ajoki intae, keikashieki enkang e Sodom te nkolong e nkiguana aaitulusoo te iyie.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
