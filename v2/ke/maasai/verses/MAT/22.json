              "items": [
                {
                  "text": "Lk 10.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neikilikuan olang'eni obo lenye atem ninye, ajoki, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
