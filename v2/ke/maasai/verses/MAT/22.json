            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nejoki, “Tonyorra Olaitoriani Enkai ino to ltau lino pooki ote nkishui ino pooki o te ng'eno ino pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
