          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ninye ninche, “Kaji naa etiu pee eipot Daudi te Nkiyang'et Sinyati ajo ‘Olaitoriani’, ejo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
