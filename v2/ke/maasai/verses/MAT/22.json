              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eiturrurro lelo Farisayo neikilikuan Yesu ninche ajoki, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
