            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.1+LUK.5.2+LUK.5.3"
              },
              "items": [
                {
                  "text": "Lk 5.1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neitoki aiteru aiteng'enisho te mbata e naiposha. Neiturrurrokino olorora kitok oleng, o metijing'a atua empeut aton ti atua te naiposha; neton ilo orora te nkop natoyio te mbata e naiposha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neutaki ninche mbaa kumok too nkitanyaanyukot nejoki,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Entoning! Ng'ura, eshomo olaunoni aunisho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eunisho nedoiki kulikae anterera embata e nkoitoi, nepuonu ntaritik aanya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedoiki kulikae enkop oo soito nemetii nkulupuok kumok, nesioki aabulu, naa ore ake pee ebulu amu megut nkulupuok; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore pee eilepu enkolong nepej, naa ore amu meeta ntana netoyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedoiki kulikae anterera atua lkiku nebulu lelo kiku negor, metaa eitu eiu ilng'anayio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedoiki kulikae anterera atua nkulupuok sidain nebulu neiu ilng'anayio, neponari aaiu maa tomoni uni, maa ntomoni ile, maa iip.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.8",
            "verseOrgIds": [
              "MRK.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tipat oo nkitanyaanyukot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore etaa ninye ake, neikilikuan lelo ooboitare te nebo ilooiteng'eni lenyena enajo nena kitanyaanyukot. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki, “Eishooki intae entayiolo mbaa nemeibala e nkitoria e Nkai, kake ore te lelo ootii auluo, etiu mbaa pooki anaa nkitanyaanyukot; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.9+ISA.6.10"
              },
              "items": [
                {
                  "text": "Isa 6.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " pee te neing'or, neing'or nemedol, naa te nening, nening nemejing'aa, pee meibelekenyakino ake Enkai, nepalakini.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.12",
            "verseOrgIds": [
              "MRK.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eibalakinye ninche ina kitanyaanyukoto o launoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.12",
            "verseOrgIds": [
              "MRK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ninye ninche, “Aimining'ung'u ena kitanyaanyukoto? Kaji naa inkoko pee ining'ung'u nkulie kitanyaanyukot pooki?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore olaunoni, ororei eun. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kulo ilootii embata e nkoitoi, ine neunieki ororei; ore pee ening; nelotu shetani nabo kata aya ilo rorei otuunoki ti atua ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa inji etiu lelo ootuunoki te nkop oo soito, lelo laa, ore pee ening ororei, neng'amu nabo kata te ng'ida; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemeeta ntana ti atua ate, kake ebikie enkiti kata; kake ore pee elotu osina anaa enkisilisilore te nkaraki ilo rorei, nerrorro nabo kata. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo ootunokoki atua lkiku; naa lelo ooning ilo rorei, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ore pee ejing'aki nyamalitin e nkop, o eng'ida oo masaa, o eng'uarrata e kulie tokitin, negor ilo rorei, metaa meisho etum ilng'anayio. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore lelo ootuunokoki enkulupuoni sidai, naa lelo ooning ilo rorei neiruk nepik iltauja neiu ilng'anayio maa tomoniuni, maa ntomoni ile, maa iip.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.20",
            "verseOrgIds": [
              "MRK.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oltaa oitoiporo to ltoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.20",
            "verseOrgIds": [
              "MRK.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.15"
              },
              "items": [
                {
                  "text": "Mat 5.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.33"
              },
              "items": [
                {
                  "text": "Lk 11.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki Yesu ninche, “Keyauni oltaa nepising'ari to ltoo, aashu epiki orunku le erruat? Mme eneiperere epiki? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.26"
              },
              "items": [
                {
                  "text": "Mat 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.2"
              },
              "items": [
                {
                  "text": "Lk 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu meetae entoki naisudoyioki neme keji ake pee eibalunyeki; nemeetae entoki natunukaki neme keji ake pee eibalayu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oloata nkiyiaa naaning'ishore, toning'o.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        }
      ]
    },
