              "MRK.8.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.38"
              },
              "items": [
                {
                  "text": "Mat 10.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.27"
              },
              "items": [
                {
                  "text": "Lk 14.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neipotu olorere te nebo ilooiteng'eni lenyena meetu enetii ninye, nejoki ninche, “Te neyieu oltung'ani naasuj nanu, nchoo metanya inaayieu oltau lenye, nedumu osalaba lenye naasuj nanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mat 10.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "Lk 17.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Yhn 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore olojo aitopok enkishui enye neiminie; ore oloiturraa enkishui enye te nkaraki ele rorei supat, neitajeu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ainyoo edupore oltung'ani, te netum enkop pooki neiturraa enkishui enye? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa ainyoo einosie oltung'ani enkishui enye? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore olodol isora te naaimaki nanu aashu ororei lai tena ishoi oo ng'ok naloloito nedol sii ninye enkerai e Tung'ani isora eimaki ninye te ina olong elotu te nkitoo e Menye eiriamunore ilmalaika sinyat.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
      ]
    }
