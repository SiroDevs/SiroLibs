          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.9+ACT.1.10+ACT.1.11"
              },
              "items": [
                {
                  "text": "Iat 1.9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neaku ore pee eidip Olaitoriani Yesu airorie ninche, neilepieki aaya shumata, neton te nkaina e tatene e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.19",
            "verseOrgIds": [
              "MRK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedumunye ninche aapuo aalikioo ilo rorei too wuejitin pooki, neasisho Olaitoriani te nebo ninche neitadedeyie ilo rorei too lmonek ooiriamariyie. Esai.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.20",
            "verseOrgIds": [
              "MRK.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
