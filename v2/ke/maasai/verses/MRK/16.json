          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "[ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.20",
            "verseOrgIds": [
              "MRK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etolikio Petero too ndorropu, o lelo ooboitare nena naatolikioki ninche. Ore te siadi nena, neitanap Yesu makewan ninche mewaita enkilepunoto neya endoyioroto elikioroto sinyati e njeunoto nemeish nebik intarasi.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        }
      ]
