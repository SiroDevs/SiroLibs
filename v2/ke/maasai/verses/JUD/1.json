                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayieu naitoki aitadamu intae, hoo naidipa apa aitayiolo intae nchere ore ilo oitajewuo iltung'ana aitung'uaa enkop e Misiri, nenyaaka amut lelo leitu eiruk. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo malaika leitu egolie ewueji enye neing'uaa emanyisho enye naishiaakino, neteena ninche too lpisia loo ntarasi ti abori te nemisimis metabau ina olong kitok e nkiguana; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
