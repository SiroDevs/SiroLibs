              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entotoni intae maate ti atua enyorrata e Nkai, entaanyu olng'ur lo Laitoriani lang Yesu Kristo oitabaiki intae ina kishui oo ntarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JUD 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entudupa ilkulikae leton eing'ashing'ash. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JUD 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entajeu ilkulikae entawuapu ninche ti atua enkima eng'urrie lelo kulikae to lturiaki nimbayuyu ebaiki ninye enkila naidurukie osesen.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
            "verseOrgIds": [
              "JUD.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkomono o enkisisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
