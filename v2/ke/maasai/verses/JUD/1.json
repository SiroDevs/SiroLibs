              "items": [
                {
                  "text": "Enk 19.1-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " anaa enaikunaki Sodom o Gomora o nkang'itie naamanita naatusuja sii ninche ng'uarrat oo loirerioni torrok, neitamioki ninche te nkima oo ntarasi pee eaku enkitanyaanyukoto te pooki.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
