        },
        {
          "text": "Yuda, osinka le Yesu Kristo naa olalashe le Yakobo, oigeroki lelo ooipotoki, oonyorri ti atua Enkai Papa lang ooiteng'elaki te nkaraki Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JUD 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metoponikini intae olng'ur o eseriani o enyorrata.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
      ]
    },
    {
