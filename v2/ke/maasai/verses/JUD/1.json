          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore taata ilo oidim atorripo intae mibatatata, neitoduaaya intae te dukuya enkitoo enye miaatata eleyiata, iatata eng'ida, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
            "verseOrgIds": [
              "JUD.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JUD 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "laa ninye ake Enkai Olaitajeunoni lang, ti atua Yesu Kristo Olaitoriani lang, metaa enenye enkitoo, enkisisa, o enkitoo, o engolon, te dukuya nkatitin pooki o taata o ntarasi. Esai.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.25",
            "verseOrgIds": [
              "JUD.1.25"
            ]
          }
        }
