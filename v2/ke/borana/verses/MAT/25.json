          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi shilingi kunki diddama iti kennani kaani d'ufe waan jed'e, Atini kunki diddama nati kennite, ilaali, kunkiini diddama d'ibileeni tana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
