              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaani hojattu taani guddo ture gadi deebie, henna suni ch'ufa worra woliini tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi kunki shantama iti kennani kaani d'ufe, kunki shantama d'ibi iti kenne waan jed'e, Atini kunki shantama nati kennite, ilaali, kunkiini shantama d'ibileeni tana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaani waan jed'eeni, Aka d'iiraa tolchite, atini aka dansaa daldalte, tanaafi anini waan guddo harka keetiti kenna. Kooti, woliini gammanna.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        }
      ]
    },
