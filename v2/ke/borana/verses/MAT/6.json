                "loc": "LUK.18.10+LUK.18.11+LUK.18.12+LUK.18.13+LUK.18.14"
              },
              "items": [
                {
                  "text": "Luk 18.10-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yo Waaqa kad'attani, aka nama kiyyibu intahiina! Wonti akanatiifi worri Maneeni Waaqa iti kad'atani keesafi d'aatu kara ejaanjani kad'achu fed'ani, aka nami worra argu. D'uguma, waan anini isaniini jed'u, Worri suni gati ufi ya argate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo atini yo Waaqa kad'attu mana kanke keesa seeni, balbala ch'ufi Abbaani kanke ka waan atini d'ossani tolchitu argu galata sii baasa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kad'acha keesati dubbi woma imbaane ind'eeresiina, aka worri Waaqa imbeenne tolchu; worri waan maro dubbi heddutiifi kad'acha d'agayaniifi seha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka worra intahiina; Abbaani keesani ato isani woma injed'ini waan isani feetani ch'ufa beekha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.8",
            "verseOrgIds": [
              "MAT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aki kad'atani akana:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.9",
            "verseOrgIds": [
              "MAT.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo waan hamtu nuraa d'owi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.25+MRK.11.26"
              },
              "items": [
                {
                  "text": "Mar 11.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti akanatiifi yo isani wollaala namaa araaramtani, Abbaani keesani ka gubbaleeni isani araarama. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo isani wollaala namaa inaraaramne, Abbaani keesanileeni wollaala isanii inaraaramu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan agabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo Waaqa kad'achaafi agabdani, fuula iyakatiina, aka worra kiyyiba. Worri fuula yakata, aka agabu worraa nami argu. D'uguma, waan anini isaniini jed'u, Worri suni gati ufi ya argate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo agabdu, fuula d'iqad'u, mata filad'u, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka nami agabu tante inagarre; ammo Abba kanke ka d'ossa jiru ch'allati arga. Abbaani kanke ka waan d'ossani argu galata sii baasa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Durooma gubbaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
