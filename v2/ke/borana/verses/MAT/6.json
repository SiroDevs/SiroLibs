            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eegad'a aka huji teesani dansa nama durati intolchine aka nami argu. Yo akasi tolchitani Abba keesani ka gubba jiru galata ira inargattani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
      ]
