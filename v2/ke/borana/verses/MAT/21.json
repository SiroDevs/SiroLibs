  "reference": "Matayo 21",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "MAT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerusalemuti d'iaannaani, Bethfage fulla Gaara Ejersa jed'ani d'ufani. Achiti Yesoni d'aamsa kanaani jara ufi lama erge: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olla nu dura suni d'aqa, harre bukhura isii woliini mukhati hid'ani gartani. Hiikha, natiini koota jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami tokoleeni woi jed'e, waan jettaniini, Motichati fed'a jed'a, inni hurrise erga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari suni deeme waan Yesoni jed'eeni tolche, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.6",
            "verseOrgIds": [
              "MAT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "harrefi bukhura isitiini d'ufani, woya ufi rara tolchani, Yesoni yaabate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.7",
            "verseOrgIds": [
              "MAT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini guddooni woya ufi kara keesa afte, nami gari dame mukhaa ch'ire lafa afe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.8",
            "verseOrgIds": [
              "MAT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25"
              },
              "items": [
                {
                  "text": "Far 118.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gumiini Yeso dura yaatufi ta duuba yaatu iyite waan jette, Ilmi Daudi ha guddifamu. Ka maqa Aabbootiini d'ufu ha eebifamu! Waaqa ha faarsani jed'ani!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni Yerusalemu seennaani diri ch'ufti wolti kae. Kuni eennu? jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.10",
            "verseOrgIds": [
              "MAT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini taani waan jette, Inni raaga Yeso jed'ani, ka Nazareti Galilaya keesaa d'ufu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni Mana Waaqa qulqulleesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni Mana Waaqa olseene, worra keesati woi bitatufi ka gurguratu had'e, mesa worra hori jijirutiifi barch'uma worra sabaliisa gurguru ch'ufa garagalche ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa 56.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " waan jed'eeni, T'aafi keesati waan Waaqi jed'e, Mana kiyya mana kad'acha jed'aniini, ammo isani goda hattu tolchitani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ballafi naafi ch'ufti Mana Waaqa keesati isati d'ufe, inni worra fayyise. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaalole gugurdofi jari Seera beekhu waan dansaa inni tolcheefi ijoolle Mana Waaqa keesati iyite, Ilmi Daudi ha guddifamu jettu d'ageennaani dalanani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.2"
              },
              "items": [
                {
                  "text": "Far 8.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri waan Yesoni jed'e, Waan worri jed'u d'ageeta? Ind'agaya jed'e. T'aafi keesa taka insoomne? Isani ya ijoolleefi daima aka faaru d'uga baaftu barsiiftani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni worra biraa deeme, Bethania d'aqe achi bule.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni mukha oda abaara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diirama lameeso, ato dira d'aqu jiru, Yesoni beelae. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oda toko d'aatu karaati arge, jennaani d'aqe ammo baala male woma iraa d'abe waan jed'eeni, Iti deebite mid'aani ind'aliini. Hojuma suni mukhi kaani gogoge. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari isaa waan kana arge jennaani mame, Odaani eesa akana hurrise gogoge? jed'ani wolgaafatani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mat 17.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1 Kor 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, D'uguma, waan anini isaniini jed'u, Yo isani d'ugefattani, woljaji keesa injirre, isani dandeetani waan anini mukha oda kana tolche tolchitani. Tana ch'allaleniti, ammo yo gaara kanaleeni, Kai, galaana keesa bui jettani, duuba intaati. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo d'ugefattani waan kad'attani ch'ufa inargattani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan jabeenna Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni Mana Waaqa olseene; ato nama barsiisu, qaalole gugurdofi jari gugurdaani Yahudi isati d'ufani waan jed'aniini, Atini jabeenna kamiini waan kana tolchita? Eentu jabeenna kana sii kenne? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, Anileeni gaafi toko isani gaafad'a; yo isani naa deebiftani, anileeni jabeenna waan kana tolchuuni isaniti hima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.24",
            "verseOrgIds": [
              "MAT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisooni Yohana eesaa d'ufte? Waaqa biraa d'ufte mo nama biraa d'ufte? Worri wolmorme waan jed'e, Maani jenna? Yo nu Waaqa biraa d'ufte jenne, inni waan nuuni jed'u, Maafi Yohana ind'ugefatiina re? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo nu nama biraa d'ufte jenne, nu biyya sodaanna, waan nami ch'ufti Yohana raaga sehuufi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi worri waan Yesoni jed'e, Nu imbeennu. Inni waan worraani jed'e, Yoosi, anileeni jabeenna waan kanaani tolchu isaniti inhimu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mammaasa ilmaani lama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani maani seetani? Nama ilmaani lama qabuti jira. Inni gara angafa d'aqe waan jed'eeni, Oobru zabibu arra d'aqi keesa hojad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.28",
            "verseOrgIds": [
              "MAT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gurbaani kaani, Ani indeemu jed'eeni; ammo eege herega ufi jijirate kae deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.29",
            "verseOrgIds": [
              "MAT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaani gara ilma mand'icha d'aqe akasuma jed'eeni. Aabbo, hayye ind'aqa jed'e, ammo d'aqu dide. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.30",
            "verseOrgIds": [
              "MAT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eentu fed'i abba ufi guute? Angafa jed'aniini. Yesoni waan jed'e, Waan anini isaniti himu, sharmut'afi worri damoosa guuru isani durati Finna Waaqa argata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.12"
              },
              "items": [
                {
                  "text": "Luk 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29+LUK.7.30"
              },
              "items": [
                {
                  "text": "7.29-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yohanani nama batisu d'ufe kara d'uga isani agarsiise, ammo isani d'ugefachu diddani; tatule worra damoosa guurufi sharmut'ileeni isa d'ugefatte. Eegi waan kana gartanile, qalbi teesani garagalchitani isa d'ugefachu diddani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mammaasa oobru zabibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.1+ISA.5.2"
              },
              "items": [
                {
                  "text": "Isa 5.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mammaasa kana ch'aqasa. Abba oobru toko jira ka oobru zabibu oobrate, dallaani marse, fulla daad'i iti ch'ach'arasanifi doofi oobru jaarate. Oobru ufi harka namati lakise, imaltu d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoi zabibu murani geennaani, inni tissele ufi erge, aka qooda mid'aani argatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari oobru qorqoratu kaani tisse toko d'aane, toko ijeese, toko mata d'od'oose. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle abbaani oobru kaani tissele d'ibi erge, ta haga qara ira jirtu, ammalle jari oobru qorqoratu kaani akasuma worra tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muumme qit'issu, ilma ufi erge, Ilma kiyya inuma sodaatani jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri oobru qorqoratu kaani ilma arginaani waan woliini jed'e, Ilmi abba oobru kana, koota inijeemna; duuba d'aala ch'ufa imfud'anna. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isa qabani, oobru keesaa baasani ijeesani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, Abbaani oobru, yo d'ufu, maani worra oobru qorqoratu kana tolcha seetani? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan jed'eeni, Inni d'uguma worra daba suni fit'eti, oobru nama d'ibiti kenna, ka qooda mid'aani yo hojjaani geete, isaa kennu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22+PSA.118.23"
              },
              "items": [
                {
                  "text": "Far 118.22-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Isani waan t'aafiini jettu taka insoomne?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaalole gugurdofi Farisayooni mammaasa Yeso d'ageennaani, aka inni waan worra dubbatu hubatani; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "isa qabu fed'ani, ammo gumi sodaatani, ta Yeso raaga seete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mammaasa jila fuud'a",
          "type": "text"
        }
      ]
    }
