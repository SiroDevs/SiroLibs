              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Yoh 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nazareti bahe d'aqe Kapernaumu tae, d'aatu galaana, lafa Zabulonifi Naftali keesa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
