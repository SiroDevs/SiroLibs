              "items": [
                {
                  "text": "Luk 3.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aka Yohana qabani d'ageennaani Yesoni Galilayati deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
