        },
        {
          "text": "Bara suni Yohanani nama batisu lafa aloo ta Yudea d'ufe nama barsiise waan jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
