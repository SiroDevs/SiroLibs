              "items": [
                {
                  "text": "Luk 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Qonqooni gubba baate waan jette, Kunini Ilma kiyya ka anini jaalad'u, inni guddo na gammachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yeso lafa aloo keesati ilaalatani",
          "type": "text"
        }
      ]
