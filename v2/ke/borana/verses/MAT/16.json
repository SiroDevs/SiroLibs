            }
          ]
        },
        {
          "text": "Jennaani Yesoni waan jara ufitiini jed'e, Yo nami tokoleeni na gula deemu fed'e ha ufi mormate, maskali ufi baate na gula deemuti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
