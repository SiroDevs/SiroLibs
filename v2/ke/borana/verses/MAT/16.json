                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti akanatiifi nami jireenna ufi baasu fed'u ch'ufti ind'aba; ammo nami jireenna ufi naa jed'e balleesu inargata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo waan lafa ch'ufa argatani ammo jireenna ufii d'abani, maani namaa baati? Nami maani dandae gati jireenna ufiti baasa? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
