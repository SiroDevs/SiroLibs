                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilmi Nama malaika ufi woliini guddinna Abbaatiini d'ufa, duuba nama ch'ufa huji isaa gula waan isaa male kennaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
