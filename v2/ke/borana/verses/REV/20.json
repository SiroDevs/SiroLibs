          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan 7.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani anini barch'uma guddinnatiifi worra ira tatau arge. Jabeenna worri woiini qoru kennaniifi. Ammalle anini lubbu nama, maro worri d'uga Yesoni mulliseefi dubbi Waaqa odeese ijeesani arge. Worri bineensa inguddimne yokhaani akheekha isale, yokhaani beesisa isaa harkafi adda ira inqabu. Worri aka hayyoota tahe, Kristo woliini ganna kunki toko lafa fide. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.4",
            "verseOrgIds": [
              "REV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nami qara due kaani haga ganna kunki toko duisa keesaa inkaane.) Kunini kaisa qara ka nama dueeti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayyaanafi gammada worra kaisa qara kana keesa qooda qabuuti. Doti lameeso dandeete worra indabsattu, worri qaalole Waaqatiifi ta Kristo tahe, isa woliini haga ganna kunki tokoti lafa fida.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sheet'ana dabsatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
