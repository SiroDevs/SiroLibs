              "REV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9+DAN.7.10"
              },
              "items": [
                {
                  "text": "Dan 7.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani anini barch'uma guddinna adi guddafi nama ira taule arge. Lafafi gubbaleeni isa dura baqatte, fulla d'abde. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle anini nama due, diqaafi guddale, ka barch'uma guddinna dura tatau arge. Kitaaba heddu banani ammalle toko d'ibile banani, kitaaba worra jiru. Worra qara due waan worri tolche gula qorani, akuma kitaaba keesati t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani galaani nama keesati due ch'ufa gadi yaase. Duisafi fullaani ekheraani teetuleeni nama isi keesati due ch'ufa gayaafte. Nama ch'ufa waan inni tolche gula qorani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duisafi fulla Ekheraani teetu galaana ibida keesa buusani. Galaani ibida kunini duisa lameesooti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama maqa isaa kitaaba worra jiru keesati int'aafiini ch'ufa galaana ibida keesa buusani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gubba haraafi lafa hareeti",
          "type": "text"
        }
      ]
    }
