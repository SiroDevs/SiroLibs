            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini malaika d'ibi ta gubbaa gadi buutu arge; isiini fura boola guddotiifi haada sibiila gudda harkaa qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Uum 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isiini jawe guddo, bofa dullacha kaani, ka Ibiliisi yokhaani Sheet'ana jed'ani qabde, haga ganna kunki toko hiite. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani boola keesa isa buufte, ch'ufte, beesisa ira keyatte, aka inni haga ganni kunki toko hobauti nama tokole insomne. Eegi suni diqo toko isa hiikhu malani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
