          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi ganni kunki toko hobae, Sheet'ana hid'aansa keesaa gadi lakisani, inni ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.7.2"
              },
              "items": [
                {
                  "text": "Eze 7.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.2"
              },
              "items": [
                {
                  "text": "38.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " d'aqeti gosa lafa ch'ufa keesa firfirfamte, akasi jechaani Gogifi Magogi jechu, soba. Sheet'ani had'iisafi worra ch'ufa wolti yaama, akuma maansa afaani galaana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri lafa ch'ufa keesa yae, gumi Waaqatiifi dira inni jaalatu marse. Ammo ibidi gubba gadi bue worra hobaase. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Sheet'ana, ka worra sobe, galaana ibida keesa buusani, fulla bineensafi raaga d'ara qara buusani, halkani guyya haga hegeri worra gaargalchani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qorsuma eege",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
