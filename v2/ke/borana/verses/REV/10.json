                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani malaikaani anini galaanafi lafa goddu gubba ejitu arge taani harka mirga olfud'atte, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "maqa Waaqa ka haga hegeri jiruufi ka gubbafi waan keesa jira ch'ufa uume, lafafi waan keesa jira ch'ufaafi galaanafi waan keesa jira ch'ufale uumeeni kakhate. Malaikaani waan jette, ammaa achi wonti kunini iti deebite inturtu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo malaikaani torbeeso magalata ufi d'oofte, Waaqi herega ufi ka d'ossani inguuta, akuma inni hojattu ufi raagootati odeese.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
