                  "text": "65.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nama dabsatu anini utuba Mana Waaqa kiyya tolcha, inni haga jiru keesaa imbahu. Maqa Waaqa kiyyatiifi maqa dira Waaqa kiyyale, Yerusalemu hareeti, ta gubba fulla Waaqa kiyyati baatu, isa irati t'aafa. Anileeni maqa kiyya haraa irati t'aafad'a.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.12",
            "verseOrgIds": [
              "REV.3.12"
            ]
          }
        }
