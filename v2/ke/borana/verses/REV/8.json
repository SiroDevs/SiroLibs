              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani lameeso magalata ufii d'oofte. Waan guddo gaara gudda ibidi iraa bobau fakaatu galaana keesa buusani. Qoodi sadii ka bisaani galaana d'iiga tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodi sadeeso ka waan bisaani keesa jira ch'ufti raawate, qoodi sadeeso ka hobolo bisaani keesa jirtu balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
