                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaikaani eele hit'aana ta worqi harka qabdu d'ufte, fulla waan sorio irati qalani ejatte. Hit'aana heddu iti kennani, aka isiini kad'acha worra Waaqaati darte ammalle waan sorio irati qalani ta barch'uma guddinna dura ejitu, dura keetu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aari hit'aana aarsani kad'acha jara qulqullo woliini oli deeme, harka malaika fuula Waaqa dura ejitu keesa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
