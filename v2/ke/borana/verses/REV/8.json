              "items": [
                {
                  "text": "Yer 9.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maqaani urji suni Had'aa. Qoodi sadeeso ka bisaani had'ae, nami hedduuni ka bisaani suni d'uge raawate, waan guddo had'aniifi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
