              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmeeni Hoola beesisa torbeeso ch'absinnaani woniti ch'ufti gubbaa Ch'aqali jette ch'allifte haga nusa saa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini malaika torbaani ta Waaqa dura ejaanjitu arge; magalata torba worraa kennani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
