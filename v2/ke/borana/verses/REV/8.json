            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani malaikaani sadeeso magalata ufi d'oofte. Urjiini guddooni, ta aka ifse bobeetu, gubbaa gadi buute, qooda sadeeso ka galaanatiifi ka maddo ira buute. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
