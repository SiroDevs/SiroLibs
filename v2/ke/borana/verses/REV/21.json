              "items": [
                {
                  "text": "2 Pet 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani anini gubba haraafi lafa hareeti arge. Lafa qaratiifi gubbaani qara badde, galaanileeni bade. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
