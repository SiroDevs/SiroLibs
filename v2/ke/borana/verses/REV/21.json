          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka shaneeso bule, ka jaeeso diima fakaata, ka torbeeso daalacha, ka saddeeteeso doti fakaata, ka sagaleeso baricha, ka kud'anneeso haama fakaata, ka kud'ani tokeeso bule had'icha, ka kud'ani lameeso had'o fakaata. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fullooni kud'ani lamaani dooqa kud'ani lamaati fullo ch'ufa dooqa tokooni mid'aasani karaani dira worqi ch'alla, guddo bibiliqa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
