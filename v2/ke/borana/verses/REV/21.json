                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Diri ifse adutiifi jia imfed'u, waan guddinni Waaqa iti ifse, Ilmeeni Hoolaleeni ifsa taatuufi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
