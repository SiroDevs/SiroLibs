          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Ilmeeni Hoola beesisa afreeso ch'absite; waan lubbu qaba ka afreeso ka kooti naani jettu d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.7",
            "verseOrgIds": [
              "REV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.21"
              },
              "items": [
                {
                  "text": "Eze 14.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini millannaani farda borora toko arge. Nama isa yaabatu maqaani isa Duisa, Fullaani ekheraani teetuleeni isa gula deemte. Jabeenna qooda afreeso ka lafa kennaniifi, aka sheeftifi beelafi d'ukubafi bineensa alaatiini nama fit'ani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
