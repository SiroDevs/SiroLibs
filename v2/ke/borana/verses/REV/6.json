              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini millannaani farda borora arge. Nami isa yaabatu guube harkaa qaba, sure hayyuma kennaniifi. Inni aka nama nama dabsatu dabsachu d'aqe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
