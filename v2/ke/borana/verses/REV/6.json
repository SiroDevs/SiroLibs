              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmeeni Hoola ammalle beesisa lameeso ch'absite. anini waan lubbu qaba kaani ka lameeso kooti naani jettu d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
