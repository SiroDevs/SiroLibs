                }
              ]
            }
          ]
        },
        {
          "text": " urjiini ch'ufti gubba lafati jidde, aka mid'aani oda, yo bubbeeni d'ooftu, lafati jigani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
