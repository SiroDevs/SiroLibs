              "REV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Ilmeeni Hoola beesisa shaneeso ch'absite waan sorio irati qalani jalati, anini lubbu worra maro dubbi Waaqa dubbatte isa d'ugeeseefi, ijeesani arge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qonqo guddooni iyani waan jed'ani, Waaqa Gudda, qulqullofi ka d'uga! Atini yoomi worra lafaa wollaala iti murte, maro worri nu ijeeseefi worra gaargalchita? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama ch'ufa woya adi kennaniifi, Diqo toko boqod'a jed'aniini, haga henni oboleyaani teesaniifi nama isani woliini hojatu, ka aka isani ijeesani sila ijeesani guutamuuti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
