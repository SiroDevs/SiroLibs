                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "6.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Fardi d'ibiini diimaani d'ufe. Nama isa yaabatu jabeenna inni lola lafatiini d'ufu kennaniifi, aka nami wolijeesu; ammalle sheefti guddo toko kennaniifi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
