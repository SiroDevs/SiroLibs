                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gubbaani aka woraqata dachaasani badde, gaarafi lafti jiddu bisaani keesa jirtu ch'ufti fulla ufiiti deemte. ",
          "type": "text",
          "attrs": {
