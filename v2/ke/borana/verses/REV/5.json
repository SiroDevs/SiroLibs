          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmeeni Hoola taani d'at'e woraqata harka mirga nama barch'uma guddinna gubba tau keesaa fuute. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
