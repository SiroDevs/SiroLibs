              "items": [
                {
                  "text": "Isa 29.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini harka nama barch'uma guddinna gubba tau kaani keesati woraqata toko ka duraafi duubale t'aafani, ka beesisa torbaani ch'ufani arge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika guddo toko ta qonqo guddooni, Eentu beesisa ch'abse woraqata kana banu male? jettu d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo gubbafi lafafi lafa jala keesaleti nama woraqata suni bane keesa ilaalu d'abani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini guddo bohe, waan nama woraqata suni bane keesa ilaalu d'abaniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
