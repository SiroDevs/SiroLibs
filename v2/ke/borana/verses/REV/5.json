                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani anini Ilme Hoola, ta jiddu barch'uma guddinna ejitu arge ta waan lubbu qaba afraanifi jaaroleeni marsite. Ilmeeni Hoola waan ijeesani fakaatti. Gaafa torbaafi ila torba qabdi; isileeni lubbu Waaqa torbaani ta lafa ch'ufati ergani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
