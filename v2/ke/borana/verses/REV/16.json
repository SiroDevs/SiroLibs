            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani malaikaani shaneeso qori ufi barch'uma guddinna bineensati jissite. Guddinni bineensa dukanae, nami ch'ufti d'ukubsate, araba ufi ch'iniine, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maro madaafi d'ukubsacha ufitiifi, Waaqa gubbaa arabsa; ammo hameenna ufi iraa indeebine.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
