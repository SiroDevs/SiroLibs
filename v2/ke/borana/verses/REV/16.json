              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini qonqo guddo ta Mana Waaqa keesa malaika torbaaniini dubbattu d'agaye: Beena, d'aqa, qori torbaani ta dalansu Waaqa lafati jissa jette.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
