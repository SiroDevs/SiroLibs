                  "text": "Bah 9.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani qara d'at'e qori ufi lafati jissite. Madaani hamtuuni worra beesisa bineensa ufira qabuufi worra akheekha isaa guddiseeni baate. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani lameeso qori ufi galaanati jissite. Bisaani ch'ufti aka d'iiga nama due tahani, wonti galaana keesa jira ch'ufti rawatte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
