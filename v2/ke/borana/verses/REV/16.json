                  "text": "Isa 11.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani malaikaani jaeeso qori ufi galaana Efratiti jissite. Galaani gogoge, aka hayyooti mirgaa kara argatte taakitu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini jinni hamtu sadi arge, ta raacha fakaattu, ta afaani jawetiifi afaani bineensatiifi afaani raaga d'ara keesaa yaatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini lubbu jinni ta waan mama tolchitu. Lubbuuni tunini sadeeni gara hayyoota lafa ch'ufa yaati, aka hayyoota tana guyya jaba ka Waaqa Gudda had'iisafi wolti yaamtu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
      ]
