            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Qab-Ser 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Guyya jaa huji teesani ch'ufa tolfad'a, ammo guyyaani torbeeso guyya Sabato qulqullo, ka AABBO Waaqa keesaniti, oola, nama guyya Sabato suni hojate inijeesani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi worri Israeli ha d'aloota worra ch'ufa keesa guyya Sabato qaabate guyya oolma tolfate, akasiini akheekha wold'aqisa garsiisu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Bah 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Guyyaani suni akheekha haga jiru jireennati, ka jiddu tiyyafi worra Israeli jiru; wonti akanatiifi anini, AABBO Waaqi, guyya jaa keesati lafafi gubba uume, guyya torbeeso oole hafuura baafad'e.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
