          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi Waaqi gaara Sinai irati dubbi Musani jed'e ch'ufa buufate, inni d'akha hafalicha ka inni harka ufitiini seera irati t'aafe kaani iti kenne.",
          "type": "text",
          "attrs": {
