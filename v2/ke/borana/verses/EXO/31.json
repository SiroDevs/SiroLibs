              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu, Guyya kiyya ka Sabato jabeesa, wonti akanatiifi guyyaani kunini akheekha jiddu tiyyafi teesani jiru, haga d'aloota keesani ch'ufa, ka aka anini, AABBO Waaqi, isani nama kiyya tolfad'e agarsiisu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya Sabato qaabad'a, guyya oolma tolfad'a, wonti akanatiifi guyyaani kunini guyya qulqullo. Nama aada guyya suni balleese ha ijeesani. Ammalle nama guyya suni huji hojate ha gosa keesaa baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
