            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja Harunini fulla qulqullo olseenu, inni ha ukha maqa ilmaani Israeli irati qorani kaani ufira qabaatuti, aka hojja olseenu ch'ufa AABBO Waaqi ilmaani Israeli qaabatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
