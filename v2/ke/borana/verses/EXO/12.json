              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Misiri worra Israelitini, Hurrisa lafa teenna keesaa baha, yokhaani nu ch'ufti indoona jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba biyyiti qit'a bukho inqamne kaani fuute qori duri qit'a iti bukheesani taani guute woyaani hiite gurmu ira keeyatte yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.21+EXO.3.22"
              },
              "items": [
                {
                  "text": "Bah 3.21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri Israeli, akuma Musani jed'e, faaya worqifi qarsiini mid'aasanifi woyale worra Misiri kad'ate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi worra Misiri worra Israeliti saalfachiise, worri waan worri fed'u ch'ufa kenneefi. Akanaani worri Israeli worra Misiri saamate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli lafa Misiri keesaa bahe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
