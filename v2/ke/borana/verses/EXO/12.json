              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani worri Israeli waan AABBO Waaqi Musafi Harunini jed'e tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
