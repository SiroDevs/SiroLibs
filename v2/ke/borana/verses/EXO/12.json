              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aadaani tunini ha ta gosa Israelitiifi ta worra iti galale taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
