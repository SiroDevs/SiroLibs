                }
              ]
            }
          ]
        },
        {
          "text": "Duuba Musafi worri Israelileeni faaru tanaani AABBO Waaqa faarsani:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
