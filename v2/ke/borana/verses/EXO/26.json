                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hooko golla sunitifi ta gubbaa Waaro jirtu taani wolti hookisi, ammalle Sanduqa Wold'aqisa ka d'akhaani hahafalicha lamaani kaani keesa jiru golla suni duuba kayi. Golli suni ha fulla qulqulloofi fulla ira qulqullo gargari baasu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qadaada Sanduqa Wold'aqisa ira kayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
