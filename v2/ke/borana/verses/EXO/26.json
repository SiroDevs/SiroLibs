              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golla woya boofta, ka liilana bulefi bule diimafi ammalle diimani d'aani mid'aasi. Golla sunile akheekha waan lubbu qaba ka koolatiini barreesi ch'okhi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba utuba d'adacha afuri ka nafa isaa ch'ufa mullachu d'owani worqiini duuchani hooko iti naqani, ammalle waan afuri ka qarsiini mid'aasani ira d'ad'aabaniti fannisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
