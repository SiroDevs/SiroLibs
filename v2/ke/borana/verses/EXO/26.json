              "type": "text"
            }
          ]
        },
        {
          "text": "Utuba d'adacha shani ka nafa isaa ch'ufa worqiini duuchani hooko worqi iti naqani golla kanaa mid'aasi.",
          "type": "text",
          "attrs": {
