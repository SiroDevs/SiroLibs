          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla ira qulqullootini ala, gama mirga, d'aatu Waaro Woyyuma, mesa kayi, ammalle waan ifseeni ira ejitule gama bitaa kayi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
