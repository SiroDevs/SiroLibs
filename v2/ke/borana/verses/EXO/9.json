          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Faraoni garaa jabeefate gosa Israeli galakisu dide, akuma AABBO Waaqi Musani jed'e kaani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
