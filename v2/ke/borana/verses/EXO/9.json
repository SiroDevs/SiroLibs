            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waan jed'eeni, Akuma dira keesa baheeni, anini harka olqabad'e AABBO Waaqa yaamad'a. Duuba mandisuuni ch'itte, bokai d'akhaani roobu kulleeni ch'aama, akanaani aka lafti ta AABBO Waaqaa beeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini imbeekha, sifi hojattuuni tante ammalle AABBO Waaqa insodaattani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        }
      ]
    },
