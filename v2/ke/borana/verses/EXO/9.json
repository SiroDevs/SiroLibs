    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi waan Musani jed'e, Beeni, gara hayyu d'aqi waan jettuuni, AABBO Waaqi, Waaqa Ebrania, waan jed'u, Worra kiyya gad'iisi, aka worri na kad'atu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo atini worra yau d'owarte, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini gaargala guddaani isaniti d'ufe d'ukuba hama hori keesaniti buusa — farda keesani, harre, gaala, looni ammalle ree. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini beesisa hori Israelitiifi hori Misiri gargari baasuni tolcha, aka horiini Israeli tokoleeni idoone. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini AABBO Waaqi ya dubbi tana buufad'e, aka waan kana bori lafa tanati tolchu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba boriyya AABBO Waaqi waan kana tolche; looni worra Misiri ch'ufti hobaani, ammo horiini gosa Israeli tokoleeni indoone. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraoni waan tahe gaafate jennaani aka horiini gosa Israeli tokoleeni induiini iti himani. Ammo Faraoni ammalle garaa jabaate worra Israeli gad'iisu dide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'ulla",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musafi Harunini jed'e, Fulla faara iti gubani keesaa daara harka guutad'a fuud'a, duuba ha Musani fuula hayyu durati oldarbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaraani suni aka awaara lafa ch'ufa qabate, woni isiini ira baate ch'ufti, namaa sai lafa Misiri ch'ufti d'ulla fuud'e, nafi mamadaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.2"
              },
              "items": [
                {
                  "text": "Mul 16.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba worri daara fulla faara iti gubani fuud'e, Musani Farao dura ejate daara oldarbate, daaraani sunini namafi horile d'ulla iti taate nafa bubuqacheesite. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri wo tolchu kaani Musa dura eju dad'abe, wonti akanatiifi d'ullaani ya worraafi worra Misiri ch'ufa qabate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo AABBO Waaqi garaa Farao jabeese, inni akuma AABBO Waaqi Musani jed'e, worra ch'aqasu dide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokaya d'akhaani roobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Ganama lafaa kai, waan ati Faraoni jettu, AABBOONI, Waaqi Ebrania, waan jed'u, Worra kiyya gad'iisi, aka worri deeme na kad'atu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro tana hojatu tanteetiifi worra Misiri ch'alla ingaargalchu, ammo sile ingaargalcha, aka akasiini atini aka Waaqi d'ibiini na male lafa keesa injirre beetu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini sila yoona harka olfud'ad'e d'ukuba sifi nama kanke ch'ufati buuse, lafa keesa isani balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.17"
              },
              "items": [
                {
                  "text": "Rum 9.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo wonti anini isani fit'u dideefi, aka isani irre tiyya agartani, gurri kiyya lafa ch'ufaa gahu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini ammalle guddo ufi olfuute worra kiyya gad'iisu didde. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini bori yoona bokaya d'akhaani roobu, ka haga lafti Misiri uumamte taka imbuini rooba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma waan taatu, nama ergi, loonifi hori kanke ka ala jiru ch'ufa galchi, manati olnaqi. Wonti akanatiifi bokai d'akhaani roobu suni namafi hori ala jiru ch'ufa, yo ato ingalchiini, iti roobe inhobaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojattuuni Farao ta gari dubbi AABBO Waaqa d'ugeefate sodaate, tisseleefi hori ufii ch'ufa manati galfatte. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri dubbi AABBO Waaqa d'ugefachu dide kaani tisseleefi hori ufile alati lakise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Harka d'eerefad'i olqabi, aka bokai d'akhaani roobu lafa Misiri keesafi namafi horifi ammalle waan oobru ke jiru ch'ufati roobu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.22",
            "verseOrgIds": [
              "EXO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musani ule isaa taani Waaqati olqabe, AABBO Waaqi mandisufi bokaya d'akhaani roobu lafa Misiri keesati buuse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.7"
              },
              "items": [
                {
                  "text": "Mul 8.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.21"
              },
              "items": [
                {
                  "text": "16.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bokeeni d'akhaani roobu bue, angaasuuni gargari inch'inne bokaya suni keesati angaate, ka taka haga lafti Misiri uumamte nami inargini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokeeni d'akhaani roobu suni waan lafa Misiri ka mana keesa injirre ch'ufa, namafi horile, iti roobe hobaase, mukha ch'ufa ch'ach'abse mid'aanile ch'ufa d'aane balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arda Gosheni ka Israeliini teetu ch'alla bokeeni d'akhaani roobu suni hanqate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        }
      ]
    },
