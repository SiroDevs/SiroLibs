              "EXO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Faraoni Musafi Haruni yaame waan jed'eeni, Arra ya ch'ubbame, AABBO Waaqi d'uga qaba, anumafi worra kiyyati wollaala qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa na kad'ad'a, mandisufi bokeeni d'akhaani roobu ya nati guddate; anini isani gad'iisa, aka isani deebitani arma inteenne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        }
      ]
    },
    {
