          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani Farao biraa deeme dira keesaa bahe harka olfud'ate AABBO Waaqa kad'ate jennaani mandisuuni ch'itte, bokai d'akhaani roobu kaanifi bokeeni ch'ufti ch'aame. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraoni waan kana ch'ufa ka tahe arginaani ch'ubbu taaniti deebie, isaafi hojattuuni isaaleeni akuma kaani garaa jabeefatani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
