          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan garbuuni mura geeteefi ammalle jibriini daraara baasu jirtuufi, jibrifi garbuleeni ch'ufti badde. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo dargayeeni, waan eege bilchaatuufi imbanne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
      ]
    },
