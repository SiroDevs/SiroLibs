              "type": "text"
            }
          ]
        },
        {
          "text": "Qarsi kilo sodoma ta hafteeni Bezalelini uleefi hookofi kalchoofi fiit'e isiile ch'ufa mid'aase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
