          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.7+2CO.3.8+2CO.3.9+2CO.3.10+2CO.3.11+2CO.3.12+2CO.3.13+2CO.3.14+2CO.3.15+2CO.3.16"
              },
              "items": [
                {
                  "text": "2 Kor 3.7-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafa Musani gaara Sinai iraa gabue, ka d'akha lamaani Seera irati t'aafani kaani harkaa qabu, fuuli isaa imbibiliqa, waan isaafi AABBO Waaqi woliini hasaaniifi. Ammo inni aka fuuli isaa bibiliqu imbeekhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunifi worri Israeli ch'ufti aka fuuli Musa bibiliqu arge sodaa iti d'iaachu dad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Musani Harunifi jaarole gugurdo yaame, worri achi d'aqe duuba Musani worraani dubbate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni worri Israeli ch'ufti Musati d'ufe, inni seera AABBO Waaqi gaara Sinai gubba kenneefi worra barsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani dubbi buufannaani fuula hagogate worra d'ofate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo Musani AABBO Waaqaani dubbachu d'aqu ch'ufa, inni hagogo fuula iraa fud'ata, haga Waaqa biraa bahuti. Yo inni achii bahe dubbi Waaqi jed'e taani worra Israeliti hime. ",
          "type": "text",
