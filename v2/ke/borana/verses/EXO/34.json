        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa d'ibi tokole inkad'atiini, wonti akanatiifi anini, AABBO Waaqi, waan d'ibi ka naani morku dandae inoobsu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya lafa suni keesa jirtuuni wolti imataqiini, wonti akanatiifi worri hegeri sagale sorio, ta waaqoota isaani ka d'araatiini kad'atani iti si yaame si nyaachisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani tante hegeri dubra worra suni fuute, dubriti sunini waan waaqoota worra hamtu kaani worra barsiifte, eegee duuba worri kara kiyya iraa gore waaqoota hamtu suni gula yaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
