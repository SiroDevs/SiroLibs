        },
        {
          "text": "Ganna keesa maro sadi d'iirti tante ch'ufti ha d'ufte naa, AABBO Waaqa Israeli, kad'attu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
