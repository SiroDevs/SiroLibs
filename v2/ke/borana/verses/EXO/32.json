              "items": [
                {
                  "text": "Mul 3.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amma ch'ubbu worraa araaramiifi; yo araaramuu baate, anini si kad'ad'a, maqa kiyya kitaaba maqa gumi tante keesati t'aafte keesaa baasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
