          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma beeni deemi, gumi tana lafa anini siini jed'e taaniti geesi. Ammo beekhi, malaikaani tiyya si tissite si woliini deemti. Ammo hojaani anini worra kana maro ch'ubbu worraatifi gaargalchu inuma d'ufti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
