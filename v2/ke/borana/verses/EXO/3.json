            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.35+EXO.12.36"
              },
              "items": [
                {
                  "text": "Bah 12.35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini worra Misiri isani saalfachiise, yo yaatanile harka duwa iyyaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.21",
            "verseOrgIds": [
              "EXO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nad'eeni Israeli ch'ufti nad'eeni olla ufii ta Misiri, yokhaani keessuma mana isii keesa jirtu, d'at'e, woya, faaya nafaa ka worqifi qarsiini mid'aasani kad'atti. Duuba worri Israeli waan kana ch'ufa ilmaani isaaniti naqe, akasiini worra Misiri iraa wo boojia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.22",
            "verseOrgIds": [
              "EXO.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Waaqi jabeenna waan mamatiini tolchani Musaa kenne",
          "type": "text"
        }
      ]
    }
  ],
