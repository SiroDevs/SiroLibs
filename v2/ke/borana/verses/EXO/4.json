          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Harunini jed'e, Beeni, lafa alooti d'aqi, Musa argi. Inni kae deeme, Musa fulla gaara qulqullooti arge d'ungate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani waan ch'ufa ka AABBO Waaqi gaafa isa erge isaani jed'e iti hime, ammalle akheekha ch'ufa ka inni, Tolchi jed'eeni iti haasae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musafi Harunini yaani jaarole Israeli ch'ufa wolti baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunini waan AABBO Waaqi Musani jed'e ch'ufa iti haasae akheekha kaanile biyya durati tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti dubbi suni ind'ugeefatte, ammalle aka AABBO Waaqi worra Israeliti d'ufe gaargala worraa arge d'ageennaani, mataani lafati gajejed'ani isa guddisani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        }
      ]
