          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani sodda isaa Nagayaati jed'eeni gad'iise, jennaani soddaani isa kae lafa ufiiti gale.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gumi Israeli fulla gaara Sinai",
          "type": "text"
        }
      ]
    }
