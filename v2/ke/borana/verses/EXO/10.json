              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waan jed'eeni, Ha taatu, akuma jette ani deebie si dura ineju.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
