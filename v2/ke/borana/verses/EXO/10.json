          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Faraoni waan Musani jed'e, Na biraa deemi! Ilti tiyya deebite si inargini! Guyya anini si argu indoota! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
