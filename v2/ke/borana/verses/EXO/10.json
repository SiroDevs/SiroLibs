              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi garaa Farao jabeese, inni worra galakisu dide. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
