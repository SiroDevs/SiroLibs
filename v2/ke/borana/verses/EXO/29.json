          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handaraafa elemo eeba Haruniti qalani suni olfuud'i, aka AABBO Waaqa baasani agarsiisi. Inni ha qooda kanke tahuti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        }
      ]
    },
