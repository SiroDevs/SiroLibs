          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Harka kanke galaana ira qabi, ha bisaani worra Misiritiifi gaari worraatifi farda worrale ch'ufa ira deebianiti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani harka isaa galaana ira qabe, lafti bariinaani bisaani galaana irre jabduuni deebiani. Worra Misiri ka jiddu baqachuu jiru AABBO Waaqi bisaani ira deebise hobaase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bisaani deebiani, gaari fardi hirkisufi worra fardaani yaufi worra Farao ch'ufa ira deebiani, tokole bahu d'owani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri Israeli lafa goddu ira galaana keesa jiddu bisaani goorae ejaati kaani taake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        }
