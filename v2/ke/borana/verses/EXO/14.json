            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani AABBO Waaqi guyya suni worra Israeli harka worra Misiri keesaa baase. Worri Israeli reefa worra Misiri ka afaani galaana ch'iisu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
