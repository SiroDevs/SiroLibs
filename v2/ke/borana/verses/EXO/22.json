          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle anini guddo dallane lola keesati harka kiyyaani isani balleese, nad'eeni teesanileeni haad'a hiyyeesaa taate ilmaani teesanileeni hiyyeeyi taati.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
