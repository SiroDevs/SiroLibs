                  "text": "Qab-Ser 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo isani woya namaa aka qabdo iraa fuutani, ato aduuni ind'iini, deebisaafi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
