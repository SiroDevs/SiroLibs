          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo abbaani isii aka inni isi fuud'u dide, namichi ha abba intalaati beese haga qarata dubraa baasufi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
