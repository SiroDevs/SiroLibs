                }
              ]
            }
          ]
        },
        {
          "text": "Nama gosa d'ibi iti ch'ubbamtani indabsina; qaabad'a, aka isanileeni lafa Misirileti keessuma taatani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
