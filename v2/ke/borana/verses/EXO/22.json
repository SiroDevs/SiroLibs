              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mid'aanifi daad'i teesani keesaa sorio naa baasa; ammalle ilmaani teesani ta d'iira ta angafa naa kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
