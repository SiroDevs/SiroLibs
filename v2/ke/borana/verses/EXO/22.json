                {
                  "text": "Qab-Ser 22.28-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo nami intala dubra ta kad'a inqamne hawadate, inni ha qarata baase fuud'uti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
