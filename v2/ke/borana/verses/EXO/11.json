      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Anini gaargala toko d'ibi Faraofi lafa Misiritiini d'ufa. Eegi suni inni isani gad'iisa. Yo isani gad'iisele, ufira isani gussa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma worra Israeli ch'ufati dubbad'i waan jettuuni, Nami ch'ufti d'iirafi nad'eenileeni nama woliini jirtani faaya worqifi qarsiini mid'aasani iraa kad'ad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi worra Misiri worra Israeliti saalfachiise. Tana male, hojattu Faraotiifi nami Misiri ch'ufti Musa aka nama gudda heregani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waan jed'eeni, AABBO Waaqi waan jed'u, Yo halkani woli qit'aani anini lafa Misiri keesa deeme, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmaani angafa ch'ufa, ilma Farao ka hayyuma ira d'aalu iti keeyad'e ilma niiti tisse ta mid'aani daattu d'aabe, ch'ufa fit'a. Yabbiyeeni goroomuma d'alatteleeni ch'ufti iraawatti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa Misiri ch'ufa keesa boha guddo ta takuma duraani inargini ta yokhaani iti deebianile ingarreti d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worra Israelitiifi hori worrale sareleeni iti induttu. Akanaani aka anini AABBO Waaqi worra Misiritiifi worra Israeli gargari baasu beetani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani ammalle waan jed'eeni, Hojattuuni tante ch'ufti na durati gajette waan naani jettu, Nu si kad'anna, worra kanke ch'ufa guurad'i, armaa yaa. Eegi suni duuba anini indeema. Jennaani ka dallansu injirre kae Farao biraa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Faraoni haguma jiru si inch'aqasu, haga anini lafa Misiri tana keesati waan mama d'ibile tolchuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi Haruni waan mama kana ch'ufa Farao durati tolchani, ammo AABBO Waaqi garaa isaa jabeese, inni duuba worra Israeli lafa isaa keesaa bahu d'owe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jila Pasaka",
          "type": "text"
        }
      ]
    }
