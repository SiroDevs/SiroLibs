            }
          ]
        },
        {
          "text": "Ammo anini ato guyyaani AABBO Waaqaa, ka rifannoota qabu, ingeenne, raaga Eliya isaniti erga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
