          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni abbaafi ilmaani wolti mid'aasa, aka anini d'ufe lafa suni abaarsaani imballeesine.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
