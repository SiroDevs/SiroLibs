          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani waan hojattuuni tiyya Musani duri isani barsiise, aadaafi seera anini worra Israeliti jed'e gaara Sinai irati isaa kenne, qaabad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        },
