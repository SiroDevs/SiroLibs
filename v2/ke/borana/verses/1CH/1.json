          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani Esau tana: Elifazi, Reueli, Yeushi, Yalamu, Kora, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
            "verseOrgIds": [
              "1CH.1.35"
            ]
          }
