          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "gochiti Elifazi iraa baate tana: Teemani, Omari, Sefo, Tatamu, Kenazi, Timna, Amaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
