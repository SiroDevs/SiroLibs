          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini gaarayu Abrahamu toko ta Ketura jed'ani ilmaani d'iira jaa d'alteefi: Zimrani, Yokshani, Medani, Midiani, Ishbaki, Shua. Yokshanini ilmaani lama qaba; Shebafi Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
