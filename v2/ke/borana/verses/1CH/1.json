              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi Abrahamu Isaaqooni ilmaani d'iira lama qaba, Esaufi Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
            "verseOrgIds": [
