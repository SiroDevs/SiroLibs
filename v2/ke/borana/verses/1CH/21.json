  "reference": "1 Odu Duri 21",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheet'ani kae worra Israeli gaargalchu fed'e jennaani, d'ufe Daudi sobe worra Israeli hedi jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.1",
            "verseOrgIds": [
              "1CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Daudini Yoabufi worra gugurda askarti isaa kaani yaame waan jed'eeni, Beena, askarti teesani fud'ad'a, gosa Israeli ch'ufa haga Dani iti keeyattani Beershebati d'aaba, heda. Anini henna worraa haga beekhu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.2",
            "verseOrgIds": [
              "1CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoabuni waan hayyichaani jed'e, AABBO Waaqi gosa Israeli harka d'ibba haga amma ira dabarsinna! Ee hayyicha, worri kunini ch'ufti hojatu tante, atini maanifi waan kana tolchite gosa Israeli ch'ufa ch'ubbu keesa buufta? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.3",
            "verseOrgIds": [
              "1CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hayyichi Yoabu dubbi suni guuchisise, duuba Yoabuni kae lafa Israeli ch'ufa keesa deeme, eege Yerusalemuti deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.4",
            "verseOrgIds": [
              "1CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni henna nama woraana guutu hayyichatini d'ufe waan jed'eeni, Nami Israeli keesa jiru nama muumme inqamne — kuma maro kumatifi ammalle kuma d'ibba toko, ka Yuda nama kuma d'ibba afuritiifi torbatama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.5",
            "verseOrgIds": [
              "1CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Yoabuni jecha hayyu suni inquufiniifi, inni worra gosa Lawitifi ka Benjamini inhenne, lakise. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan tolchani suni jibbe worra Israeli gaargalani iti d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.7",
            "verseOrgIds": [
              "1CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Daudini waan Waaqaani jed'e, Anini ya ch'ubbu hamtu tolche ka waan kana tahe! Aabbo, biraa naa deemi, anumati daalae. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.8",
            "verseOrgIds": [
              "1CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan raaga Daudi ka Gadi jed'aniini jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.9",
            "verseOrgIds": [
              "1CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beeni, d'aqi, Daudini waan jettu, AABBO Waaqi waan jed'u, waan sadi woli bira qabad'i, ka feetu gula bahi, ka taatefu siuma tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gadini isati gad'ufe waan jed'eeni, waan AABBO Waaqi sini jed'u, Kana kama fohata? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oola ganna sadi ta lafa teti d'uftu mo? Jia sadi ka nyaapa kanke baqatu mo? Guyya sadi ka AABBO Waaqi woraana ufiitini si had'e, d'ukuba ch'iisa hama lafa teeti buuse, malaika isaatini duisa lafa Israeli ch'ufatini d'ufu mo? Kama feeta? Anini qonqo tami Waaqati deebisa?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini waan Gadini jed'e, Anini ya ufi jibbaad'e lubbuuni na d'ufte, harka namaatiini duu imfed'u; tanaafi AABBO Waaqumani, ka naasu, ha waan fed'u na tolchu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi ch'iisa d'ukuba hama worra Israeliti buuse, nami kuma torbatama hobae. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni malaika ufi, ta dira Yerusalemu balleesitu, erge, ammo eege herega jijirate waan malaikaani jed'e, Laki, ta qaraatu ya geete, yaala bahi! Yo suni malaikaani oobdi Arauna, ka gosa Yebusi, d'aatu ejiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini malaika goraade qabdu, ta kurfo jirtu aka Yerusalemu balleesitu, gubba qilleensa keesati arge. Jennaani Daudifi jaaroleeni Israeli, ta worri ch'ufti ch'arqi naqatu, lafati gajejed'ani addaani lafa tuqani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.16",
            "verseOrgIds": [
              "1CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini Waaqa kad'ate waan jed'e, Ee Waaqa nami woi balleese anuma, anumati, biyya heda jed'e, worri woma keesa injirre kunini maani yake? Ee AABBO Waaqa kiyya, anaafi worra kiyya balleese, gumi tante tana baasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani AABBO Waaqa waan Gadini jette, Beeni, Daudini, fulla AABBO Waaqa sorio iti qalani oobdi Arauna keesati jaari jed'i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini jecha AABBO Waaqa guute, akuma Gadini jed'eeni kaani kae tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla oobdi suni Araunafi ilmaani isaa afraani, ka taani mid'aani d'aanani malaika argani jennaani, ilmaani isaa orite d'okhate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma hayyu Daudi ka iti gadi deemu argeeni Araunani oobdi biraa deeme isa durati gadi jed'e, fuulani lafa tuqe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini waan isani jed'e, oobdi tante naa gurguri, fulla Waaqa sorio iti qalani keesati jaara, aka inni d'ukuba ch'iisa hama kana lafa keesaa balleesu. Anini waan isiini bitamtuni ch'ufa sii keenna. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araunani waan jed'eeni, Ee hayyicha, fud'ad'i, waan feetu ch'ufa tolfad'i sangoleeni qotiyo ta atini gubde sorio baaftuleeni tana, mukhi mid'aani irati d'aanani, ka atini aka qoraani bobeesituleeni kanuma, ammalle dargayeeni atini Waaqaa baaftuleeni tanuma, ch'ufa ya sii kenne, fud'ad'i.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hayyichi waan jed'eeni, Laki, anini Hori sii baasa; anini waan kanke ka woma iti imbaasini AABBO Waaqa sorio baasu imfed'u. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni oobdi Arauna suni worqi d'ibba jaatiini iraa bitte, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "artiti fulla sorio iti qalani AABBO Waaqaa jaare, sorio gubanifi sorio wold'ageeti Waaqaa baase. Jennaani Waaqa kad'ate, AABBO Waaqi kad'a isaa d'agayeefi, ibida gubba gadi buuse sorio sunini gube.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan malaikaani jed'e, Goraade tante deefad'u, jennaani isiini deefate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani Daudini aka AABBO Waaqi kad'acha isaa d'agayeefi arge jennaani, oobdi Araunati sorio qale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
