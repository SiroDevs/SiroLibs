          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti worri kunini fud'ate iti qubate, dira Bethelitifi ka d'aatu jiru ch'ufa haga Naara ilaborutifi Gezerifi dira d'aatu jiru ch'ufa, ka iladu. Ammalle lafti worraa dira Shekemutifi Ayatifi dira d'aatu jiru ch'ufale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        }
      ]
    },
