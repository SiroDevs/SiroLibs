          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberini ilmaani d'iira sadi qaba. Yafleti, Shomeri, Hothamu; ammalle intala Shua jed'ani toko qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
