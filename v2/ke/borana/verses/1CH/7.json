          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimuni intala Sheera jed'ani toko qaba, isiini nama dira Beth-Horoni ka gubbatiifi ka golbatiifi Uzan-Sheeraale jaare.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        }
