          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo ilmaani Manase dira Beth-Shanifa ka Taanakifa Megidofa Dorifi dira d'aatu jiru ch'ufa mohatti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
