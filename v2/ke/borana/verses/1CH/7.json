          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle Efraimuni ilma toko ka Reefa jed'ani qaba, ilmi sunileeni worra kana d'ale: Reeshefu, Tela, Tahani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        },
