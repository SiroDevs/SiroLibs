              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berini ilmaani d'iira lama qaba, Heberifi Malkieli. (Malkielini nama dira Birzathi jaare.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
