          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini nama Asherini d'ale. Inni ilmaani d'iira afuri qaba, Imna, Ishua, Ishvi, Beria; ammalle intala toko ta Sera jed'ani qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        }
