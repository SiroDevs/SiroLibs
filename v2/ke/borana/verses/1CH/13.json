            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1+1SA.7.2"
              },
              "items": [
                {
                  "text": "1 Sam 7.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba Daudini worra Israeli, ka haguma seera lafa Misiri ta bitati eje haga kaarra Himathi ta mirgati eje ch'ufa wolti yaame, aka Sanduqa Wold'aqisa Waaqa Kiriath-Yearimu fuud'ani Yerusalemuni d'ufani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Bah 25.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudifi worri Israeli dira Baala d'aqani (Baala jechaani Kiriath-Yearimu jechu) aka Sanduqa Wold'aqisa Waaqaa, ka maqa AABBO Waaqa, ka barch'umani isa akheekha waan lubbu qaba ka koola gubbaa jiru, achi fuud'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri mana Abinadabu d'ufe Sanduqa Wold'aqisa keesaa fuud'e gaari hareesa ka looni hirkisani gubbaa kayani. Uzafi Ahiyooni gaari suni oofani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Daudifi worri Israeli ch'ufti aka jaba sirbe Waaqa faarse guddisa, kiraarifi dibbeefi bilbilafi magalata d'aani sirbani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri fulla oobdi ta Shidoni jed'aniini bahe jennaani karaabdi gugufate, Uzani saame Sanduqa Wold'aqisa gaari irati qabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Uzati dallane, hojuma suni isa ijeese, waan inni Sanduqa Wold'aqisa qabateefi. Inni achumati AABBO Waaqa durati due, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "tanaafi arti asi fulla sunini Perez-Uza jed'aniini. Daudileni waan AABBO Waaqi Uza dallansu keesa ijeesefi guddo dallane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Daudini Waaqa sodaate waan jed'e, Anini akami dandae Sanduqa Wold'aqisa fuud'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni Yerusalemuti ingeesine ammo mana namicha toko ka Obed-Edomu jed'ani, ka lafa Gathiti, lakise. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.4+1CH.26.5"
              },
              "items": [
                {
                  "text": "1 Od-dur 26.4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sanduqi sunini jia sadi achi tae, jennaani AABBO Waaqi worra Obed-Edomutifi waan inni qabu ch'ufa eebise.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Daudini Yerusalemu keesati tolche",
          "type": "text"
        }
      ]
    }
  ],
