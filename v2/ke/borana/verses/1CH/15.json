          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Sanduqa suni diratini yaanu, intalti Saulo Mikalini qaa manatini millate aka Daudini AABBO Waaqa durati sirbe ch'ech'eu agarte, jennaani isa tufate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
