              "items": [
                {
                  "text": "2 Sam 6.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani nami ch'ufti kae worra ufiti gale, Daudileni gale worra ufi woliini tae.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubbi Nathanini Daudini jed'e",
          "type": "text"
        }
      ]
