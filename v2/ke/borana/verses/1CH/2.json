            "sid": "1CH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni ilmaani d'iira kud'ani lama qaba: Reubeni, Simeoni, Lawi, Yuda, Isakari, Zabuloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.1",
            "verseOrgIds": [
              "1CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dani, Yusufu, Benjamini, Naftali, Gadi, Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.2",
            "verseOrgIds": [
              "1CH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yudaani ilmaani d'iira shani qaba. Niitiini isaa ta gosa Kanaani, ta Bathshua jed'ani, ilmaani sadi d'alteefi: Eri Onani, Shela. Ilmi isaa angafa ka Eri jed'ani, waan hamtu tahe jennaani AABBO Waaqi ijeese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.3",
            "verseOrgIds": [
              "1CH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiti ilma isaa ta Tamari jed'ani, Yudaani ilmaani lama iraa d'ale Peresifi Zera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.4",
            "verseOrgIds": [
              "1CH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peresini ilmaani lama qaba, Hesronifi Hamuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.5",
            "verseOrgIds": [
              "1CH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboleesi isaa Seerani ilmaani shani qaba: Zimri, Ethani, Hemani, Kalkoli, Darda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.6",
            "verseOrgIds": [
              "1CH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.1"
              },
              "items": [
                {
                  "text": "Yos 7.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aanini, ilmi Karmi, ka d'aloota Zera waan boojiani Waaqa olkayani fud'ate akasiini baddi worra Israelitini d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.7",
            "verseOrgIds": [
              "1CH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethanini ilma toko qaba, ka Asaria jed'ani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra hayyu Daudini keesaa d'alate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.8",
            "verseOrgIds": [
              "1CH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesronini ilmaani d'iira sadi qaba: Yerameeli, Ramu, Kalebu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.9",
            "verseOrgIds": [
              "1CH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini maqa worra Ramufi Yese jiddu jiru: Ramu, Aminadabu, Naashoni (inni nama gudda gosa Yuda keesa), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.10",
            "verseOrgIds": [
              "1CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salmoni, Boazi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.11",
            "verseOrgIds": [
              "1CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obedi, Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.12",
            "verseOrgIds": [
              "1CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeseni ilmaani d'iira torba qaba. Maqaani worra aka worri wolti aane d'alateeni kana: Eliabu, Abinadabu, Shama, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.13",
            "verseOrgIds": [
              "1CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nethaneli, Raadai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.14",
            "verseOrgIds": [
              "1CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozemu, Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.15",
            "verseOrgIds": [
              "1CH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni ilmaani dubra lama qaba, Seruyafi, Abigaili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalti Yese ta Seruya jed'ani ilmaani d'iira sadi qabdi: Abishai, Yoabufi Asaheli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.16",
            "verseOrgIds": [
              "1CH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalti isaa ta Abigaili jed'ani, ta Yetherini nami d'aloota Ishmaeli fuud'e, gurba toko ka Amasa jed'ani d'alte.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilmaani Hesroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.17",
            "verseOrgIds": [
              "1CH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi Kalebu, ka Hesroni jed'ani, Azubu fuud'e, intala Yeriothi jed'ani iraa d'ale. Isiini ilma sadi d'alte: Yesheri, Shobabu, Ardooni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.18",
            "verseOrgIds": [
              "1CH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azubuni doonaani Kalebuni Efrathi fuud'e, gurba Huri jed'ani iraa d'ale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.19",
            "verseOrgIds": [
              "1CH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huriini Uri d'ale, Urileeni Besaleli d'ale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.20",
            "verseOrgIds": [
              "1CH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesronini ganna jaatama gahe jennaani dubra Makiri, oboleeti Gileadi fuud'e, isiini Segubu d'alteefi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.21",
            "verseOrgIds": [
              "1CH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Segubuleeni Yaeri d'ale. Yaerini dira diddami sadi lafa Gileadi keesaa qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.22",
            "verseOrgIds": [
              "1CH.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri Geshuritifi Aramu dira jaatama ka lafa sunitifi olla Yaeritifi ka Kenathitiifi dira d'aatu jirule ch'ufa woliini had'e dabsate nami achi tau ch'ufti d'aloota Makiri, ka abba Gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.23",
            "verseOrgIds": [
              "1CH.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesronini doonaani ilmi isa ka Kalebu jed'ani, Efrathi, niiti abbaani isaa iraa due, fuud'e. Isiini gurba Ashuru jed'ani ka dira Takoa jaare, d'alteefi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aloota Yerameeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.24",
            "verseOrgIds": [
              "1CH.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerameelini, ka angafa Hesroni ilmaani d'iira shani qaba: Angafi isaa Ramla, taani d'ibiini, Buna, Oreni, Ozemu, Ahiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.25",
            "verseOrgIds": [
              "1CH.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ramuuni ilmaani d'iira sadi qaba: Maasi, Yaamini, Ekheri, Yerameelini niiti d'ibi Ataara jed'ani fuud'e, ilma Onamu jed'ani iraa d'ale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.26+1CH.2.27",
            "verseOrgIds": [
              "1CH.2.26",
