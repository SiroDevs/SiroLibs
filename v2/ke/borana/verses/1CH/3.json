            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini ilmaani Daudi, ta gaafa inni Hebroni jiru d'alateefi maqaani worraa, aka worri woli gula d'alate gula, kana: Amnoni, ka haati isa Ahinoamu, ta dira Yezreeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1+1CH.3.2+1CH.3.3",
            "verseOrgIds": [
              "1CH.3.1",
              "1CH.3.2",
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
