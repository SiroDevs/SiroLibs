              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri bulti sadi Daudi woliini bule achiti sagale gochiti isaani worraa kurfeesite nyaatani woliini d'ugaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
