    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Israeli ch'ufa namu worra isaani gula t'aafani odu sunile ch'ufa kitaaba Odu Hayyoota Israeli keesati t'aafaniti t'aafani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Yuda, maro wollaala isaanitifi qara boojiani lafa Babiloni geesani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.27"
              },
              "items": [
                {
                  "text": "Ezr 2.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.73"
              },
              "items": [
                {
                  "text": "Neh 7.73",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami qara worraafi arda keesaa baheeti gale, worra Israeli ka qaalole intahinifi qaaloleefi worra Lawitifi, worra Mana Waaqa keesa hojatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Yerusalemu keesa qubate, worra gosa Yudatifi, ka Benjaminitifi ka Efraimutifi, ka Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa Yuda, ka Yerusalemu keesa qubate mana d'ibba jaatiifi sagaltama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ultaini, ilmi Amihudi, ka ilma Omri, ka ilma Imri, ka ilma Bani worra Peresini, ilmi Yuda d'ale ch'ufa iti gudda Asayani gudda worra isaani ammalle inni worra Shelani, ilmi Yuda, d'ale ch'ufa iti mata, Yeulini gudda worra Zeraani, ilmi Yuda, d'ale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4+1CH.9.5+1CH.9.6",
            "verseOrgIds": [
              "1CH.9.4",
              "1CH.9.5",
              "1CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gosa Benjamini, ka Yerusalemu keesa qubate, kana: Salu, ilma Mershulamu, ka ilma Hodavia ka ilma Hasema",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7+1CH.9.8",
            "verseOrgIds": [
              "1CH.9.7",
              "1CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7+1CH.9.8",
            "verseOrgIds": [
              "1CH.9.7",
              "1CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa suni ka achi tau mana d'iba sagalitiifi shantami jaa. Worri maqa d'aani kunini ch'ufti abbooti worraa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qaalole Yerusalemu keesa teete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleeni Yerusalemu keesa teete tana: Yedaya, Yehoyaribu Yakini, Azaria, ilma Hilkia (ka gudda huji Mana Waaqa); worri inni keesaa d'alate kana Meshulamu, Sadoki, Merayothi, Ahitubu; Adaya, ilma Yerohamu, ka ilma Pashuri, ka ilma Malkia; Maasai, ilma Adieli, ka ilma Yasera, ka ilma Meshulamu, ka ilma Meshilemithi, ka ilma Imeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10+1CH.9.11+1CH.9.12",
            "verseOrgIds": [
              "1CH.9.10",
              "1CH.9.11",
              "1CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10+1CH.9.11+1CH.9.12",
            "verseOrgIds": [
              "1CH.9.10",
              "1CH.9.11",
              "1CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleeni worra isaani mata, ta aka jaba huji Mana Waaqa guutu, nama kuma tokotifi d'ibba torbafi jaatama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra Lawi ka Yerusalemu keesa tae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Lawi, ka Yerusalemu keesa tae, kana: Shemaya, ilma Hashubu, ka ilma Azirikamu, ka ilma Hashabia, ka balbala gosa Merari; Bakbakari, Hereshi, Galali, Mataani, ilma Mika, ka ilma Zikri, ka ilma Asafu; Obadia, ka ilma Shemaya, ka ilma Galali, ka ilma Yeduthuni; Berekia ilma Assa, ka ilma Elkana, ka arda gosa Netofathi keesa tau.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14+1CH.9.15+1CH.9.16",
            "verseOrgIds": [
              "1CH.9.14",
              "1CH.9.15",
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra Yerusalemu keesati Mana Waaqa eegu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14+1CH.9.15+1CH.9.16",
            "verseOrgIds": [
              "1CH.9.14",
              "1CH.9.15",
              "1CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yerusalemu keesati Mana Waaqa eegu kana: Shalumu, Akubu, Talmoni, Ahimani. Guddaani worra suni Shalumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.17",
            "verseOrgIds": [
              "1CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haguma duriti haga bara suni, worri balbala gosa worraa fullo ilaboru, ta fullo hayyu jed'ani eega. Duri worri suni fullo ollowaani Lawi eega.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumuni, ilmi Kore, ka ilma Ebiasafu, nama fiit'a isaa, ka balbala gosa Kora, woliini fullo balbala Waaro Woyyuma eegani, akuma duri ababooti isaa Waaro Woyyuma eedde. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasini ilmi Eleazari — Waaqi isaa eebisinna! Duri bara toko yayu worra suni gudda iti tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekariani, ilmi Meshelemialeeni, nama fullo Waaro Woyyuma eegu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami fohatani fullofi balbala eegu ch'ufti wolti nama d'ibba lamatiifi kud'ani lama, ammalle worra namu, ollowaani isaani gula t'aafani. Nami worra kana huji jabdu suni kenne Daudifi Samueli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.22",
            "verseOrgIds": [
              "1CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worraafi ilmaani worraa fullo Mana Waaqa eegani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Waaqa gama ch'ufa fulloti jira, ta eegani, gama mirgaatifi ka bitatifi, ka ilaborutifi ka ilaadule, fullooni tuni ch'ufti nama iti mata ka eegu qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.24",
            "verseOrgIds": [
              "1CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama fullo eegu kana ch'ufa fiit'a isaani ta ollowaaniti galtuti qarqaara, ammalle worri kunini bulti torba faro farooni lafa eega. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.25",
            "verseOrgIds": [
              "1CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami afraani worra kanati mata gosa Lawi. Ammalle d'iibu Mana Waaqatifi waan keesati oli kayanile worrati harkaa qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.26",
            "verseOrgIds": [
              "1CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini worra aka Mana Waaqa eegani diirama ch'ufa balbala banani, tanaafi worri d'aatu Mana Waaqati gala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra d'ibi gosa Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Lawi kaani d'ibiini miha Mana Waaqa keesani hojatani qorqorata. Worri hojja miha suni hujii gadi baasanifi deebisanile tohata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.28",
            "verseOrgIds": [
              "1CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri d'ibiini miha woyyumatiifi dargaye qit'aani d'aabanifi daad'iifi d'ad'afi hit'aanafi waan sagale mieesa ka iti darani qorqorata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.29",
            "verseOrgIds": [
              "1CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nami waan sagaleeni mieesani suni wolti daru qaalole ch'alla.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi Lawi toko, ka Matithia jed'ani, ka angafa Shaluma, ka balbala gosa Kora, huji qit'a d'aabani iti mata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri balbala gosa Kohathi, guyya Sabato ch'ufa, Mana Waaqaa keesa hojate qit'a Waaqaa baasani Waaqa dura kaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.32",
            "verseOrgIds": [
              "1CH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri Lawi, ka d'ibiini, Mana Waaqa keesa sirba. Nami worra kanaa mataa maneeni d'aatu Mana Waaqa jirtuti gale, huji d'ibi lakise halkanifi guyya huji suni ch'alla hojate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami maqa d'aani kunini ch'ufti nama gugurda gosa Lawi keesa aka wolgula d'alatani gula. Worri kunini worra balbala isaniti nama gugurda ka Yerusalemu ke tae.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ababootafi nama hayyu Sauloni d'ale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeielini dira Gibeoni jaare keesa qubate niiti isa maqaani Maaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma isa ka angafa maqaani Abdoni, ammalle ilmaani isaa ta d'iira taani maqaani Suri, Kishi, Baali, Neri, Nadabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedori, Ahiyo, Zekaria, Miklothi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.37",
            "verseOrgIds": [
              "1CH.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashimeya. Ilmaani worraleeni Yerusalemu keesa d'aatu worra balbala gosa isaani teeti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.38",
            "verseOrgIds": [
              "1CH.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerini abba Kishi Kishini abba Saulo. Sauloni ilmaani d'iira afuri qaba. Yonathani, Malkishua, Abinadabu, Eshbaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.39",
            "verseOrgIds": [
              "1CH.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonathanini abba Meribaali, ka abba Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.40",
            "verseOrgIds": [
              "1CH.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaani ilmaani d'iira afuri qaba; Pithoni, Meleki, Tarea, Ahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.41",
            "verseOrgIds": [
              "1CH.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazini abba Yara, ka ilmaani d'iira sadi qabu; Alemethi, Azmawethi, Zimri. Zimrini abba Mosa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.42",
            "verseOrgIds": [
              "1CH.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosani abba Binea, Bineani abba Refaya. Refayaani abba Eleasa, Eleasani abba Aseli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.43",
            "verseOrgIds": [
              "1CH.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aselini ilmaani d'iira jaa qaba: Azirikamu, Bokeru, Ishmaeli, Shearia, Obadia, Hanani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duisa hayyu Saulo",
          "type": "text"
        }
      ]
    }
