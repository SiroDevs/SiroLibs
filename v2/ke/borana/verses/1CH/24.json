        },
        {
          "text": "Jara kana ch'ufa, huji worraa gula, maqa t'aafani, aka worri Mana Waaqa d'aqe huji ababooni worraa Harunini jecha AABBO Waaqa Israeli gula duri worraa kenne hojatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
