              "items": [
                {
                  "text": "Ebr 2.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaafi ilmaani AABBO Waaqi naa kenne kunooti. AABBO Waaqi guddaani, ka gaara Sioni gubba tau, yayu nu erge, aka nu akheekhafi beesisa worra Israeliti taanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo biyyiti waan isaniini jettu, Nama wo himu falfaltu, worra ekhera yaamatu, ka woch'e haasaani wo dubbatu, gaafad'a. Worri waan jed'u, silaaftu nami ergattu gara ekheraati d'ufte maro nama jiruti jed'e wo gaafata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan isani jettaniini, waan AABBO Waaqi isaniini jed'u ch'aqasa, Worra ekhera yaamatu inch'aqasina — wonti worri isaniini jed'u woma isaani imbaatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guyya gaargala",
          "type": "text"
        }
      ]
    },
