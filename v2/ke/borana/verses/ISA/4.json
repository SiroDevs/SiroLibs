            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba gaara Sionitiifi nama achiti wolti d'ufu AABBO Waaqi guyyaa dumansa iti erge halkanile aarafi ibida bobau iti erga. Guddinni Waaqaa dira suni dumansaani d'ossa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guddinni isaa gaadisa tahe oowa guyyaa balleese, fulla nagaya, ta bokayafi bubbe iti qobatani, tolcha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sirba oobru zabibu",
          "type": "text"
        }
      ]
    }
