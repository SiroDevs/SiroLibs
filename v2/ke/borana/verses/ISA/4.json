          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi nad'eeni torba d'iira toko qabde waan jettuuni, Nu dandeenne daara ufi baamne sagale ufi kenninna, ammo atini ch'eera nu d'owi, d'iirsa nuu tahi, ha maqa kanke ch'allaani nu yaamaniti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yerusalemu eegi inni badde deebisani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani ind'ufa, ka AABBO Waaqi dame lafa keesa jirtu ch'ufa guddise mid'aadu tolchu. Nami Israelii ch'ufti, ka hafe, mid'aani lafti sunini baaftu iraa gammade, kiyyibaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Yerusalemu keesati Waaqi hambise qulqullo jed'aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabeenna isaatini AABBO Waaqi nad'eeni Yerusalemu qulqulleese ch'ubbu worratiifi d'iiga achiti jissani d'iqa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
