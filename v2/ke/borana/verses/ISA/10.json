          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani irre isaatini, akuma dame mukha ch'irani, worra ch'ire lafa buusa, ka kiyyibe ufi olifuud'u murre gadi buusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi akuma mukeeni garaa badda keesa d'agaraani ch'irani worra ch'ira. Akuma mukeeni Lebanoni dadansaani jiddu, worrileeni jiga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
              "ISA.10.34"
            ]
          }
        }
      ]
