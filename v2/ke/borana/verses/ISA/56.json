        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle AABBO Waaqi nama gosa d'ibi ka gumi isati darame isaa jaalate isa hojate, guyya Sabato guute wold'aqisa isaa jabeesuni, waan jed'uuni, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
