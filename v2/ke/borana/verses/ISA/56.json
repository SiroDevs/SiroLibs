              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, D'ugaafi qajeeluma tolcha, wonti akanatiifi baafami kiyya ya d'iaate. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nama guyya Sabato jabeese guute, akasiini t'ureesu didu, ka waan hamtu tolchu didu, ineebisaafi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa d'ibi ka gumi AABBO Waaqati darame, AABBO Waaqi gumi isati na inheregu injed'ini, nami sangisisanileeni, Anini deebie woma ind'alu akuma mukha gogoge jira ufiini injed'ini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan nama akasi sunini jed'u: yo atini naa saalfate, guyya Sabato jabeesite waan na gammachiisa tolchite wold'aqisa kiyyale jabeesite, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "maqa kanke mana kiyya keesafi gumi tiyya keesaleti inuma qaabatani, haga nama ilmaani d'iiratifi ta dubra qabule ira. Haga jiru jireenna si inded'ani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
