              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami t'iyaafi guubeeni oobruu suni keesaa adamo yaa, waan lafti raasa qoraatitiifi ta mogore taateefi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
