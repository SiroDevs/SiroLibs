              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.23",
            "verseOrgIds": [
              "ISA.1.23"
            ]
          }
        },
        {
          "name": "verse",
