      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
              "ISA.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani waan duri mukha kad'attani oobru woyyoomsitaniifi ingaabitani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani akuma mukha gogu gogoddani, oobru bisaani d'abde taatani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
              "ISA.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma buuyo goddu qaanqeeni qabsiiftu, akasuma jari irre qabu huji ufii ta ch'ubbutiini badde, nami worra baddu d'owu injiru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.31",
            "verseOrgIds": [
              "ISA.1.31"
            ]
          }
        }
      ]
    },
