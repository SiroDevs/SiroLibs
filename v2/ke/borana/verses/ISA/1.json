            "sid": "ISA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan AABBO Waaqi d'uga qabuufi Yerusalemu baase ammalle nama keesa jiru, ka ch'ubbu iraa deebiule ch'ufa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.27",
            "verseOrgIds": [
              "ISA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni nama ch'ubbu tolche, ka isa didu, balleese, nama isa lakisu hobaasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
              "ISA.1.28"
            ]
          }
        }
      ]
    },
    {
