            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara suni Hezekiani fayya d'abe duu gahe. Raagi Isayaani, ilmi Amozi, isa argu d'aqe waan jed'eeni, AABBO Waaqi waan siini jed'u waan kanke ch'ufa mid'aafad'u, d'aamad'u atini d'ukuba kana iraa inhaftu, indoota.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Hezekiani fuula manati deefate Waaqa kad'ate waan jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee AABBO Waaqa aka anini garaa tokooni si hojad'e si saalfad'e woma atini feetu ch'alla tolche qaabad'u akasi jed'e aka hama bohe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Isayaani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deebii, waan Hezekiani jettu, Anini, AABBO Waaqi, Waaqi ababo kanke Daudi, yayu kad'acha tante d'agaye imimaani kanke arge. Amma ganna kud'ani shani guyya kanketi sii dara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini ammalle siifi dira Yerusalemu kana harka hayyu Ashuru keesaa baase, dira sunile jabeese, nyaapa iraa d'owa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi akheekha kana sii kenne akanaani kakhu isaa guuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faano hayyu Ahazini jaare gubbaa AABBO Waaqi gaandidu ejata kud'ani dudda duubati deebisa. Duuba gaandiduuni ejata kud'ani dudda duubati deebite.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiani fayya d'aba fayye jennaani faaru tana t'aafe waan jed'e,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.20",
            "verseOrgIds": [
              "ISA.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Isayaani qara waan jed'e, Mid'aani oda fuud'a, d'ulla isaati mat'ansa, duuba inni infayya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti inni akasi jed'eefi hayyu Hezekiani qara, Akheekhi anini Mana Waaqatini seenu kami? Jed'e isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nama Babiloni d'aamsani d'ufe",
          "type": "text"
        }
      ]
    }
  ],
