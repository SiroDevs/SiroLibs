            "sid": "1SA 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba guyya suni Saulofi Samuelini sagale woliini nyaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri fulla eeba suni kae dirati gabue jennaani, Saulo sire mana gubbati mid'aasanifi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni achi rafe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Samuelini Saulo muude",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
