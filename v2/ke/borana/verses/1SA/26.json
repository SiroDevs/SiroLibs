              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma arra anini lubbu si baase kana AABBO Waaqi akasuma lubbu na baase gaargala ch'ufa keesaa na baasina!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
