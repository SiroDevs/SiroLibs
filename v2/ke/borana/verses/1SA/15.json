                "loc": "1SA.10.1"
              },
              "items": [
                {
                  "text": "1 Sam 10.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuelini waan Sauloni jed'e, Nami AABBO Waaqi si muuditi erge ana, aka atini hayyu worra isaa ka Israeli tatu. Amma tana waan AABBO Waaqi guddaani jed'u ch'aqasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14"
              },
              "items": [
                {
                  "text": "Bah 17.8-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Qab-Ser 25.17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti AABBO Waaqi guddaani jed'e tana, anini worra Amaleki ingaargalcha, waan worri gaafa gochiti Israeli duri lafa Misiriti gad'ufte qarqaaru dideefi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beeni, d'aqi gosa Amaleki had'i, hobaasi, waan worri qabu ch'ufa balleesi, woma tokole imhambisini; d'iira, nad'eeni, ijoolle didiqole ch'ufa hobaasi; looni, ree gaala, harreele ch'ufa hobaasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauloni askarti isaa ch'ufa Telemuti wolti baase tohate; askartini Israeli kuma d'ibba lamati, ta Yudaleeni kuma kud'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isaafi askartini isaa kaani, dira Amaleki d'aqaani, laga keesati d'okhatani worra eegani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni qonqo gara worra Keni, ka duri ababooti worraa worra, Israeli qarqaarte gaafa worri lafa Misiri keesaa bahe, erge waan jed'e, Worra Amaleki biraa godaana, aka anini worra suni woliini isaani imballeesine. Tanaafi worri Keni kae biraa godaane.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Sauloni worra Amaleki had'e dabsate haga Havilaa fuud'e haga Shuri, ta lafa Misiritiini ilaboru jirtuti d'aabe; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni hayyu Amaleki ka Agagi jed'ani qabe worra isa ch'ufa hobaase. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Saulofi askartini isaa Agagi lubbu baafte, hooliyeefi looni gagabbo dadansa, yabbiyefi ilmoole gagabbo dadansa yokhaani waan dadansa ch'ufa hobaasu didani. Worri waan hamamtu tufatani ka woma keesa injirre ch'alla hobaase.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka hayyuma Saulo didani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Samuelini jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan Saulo hayyu tolcheefi guddo gaabe. Inni naraa gore naa saalfachu dide. Samuelini dubbi suni ira guddo laalefate halkani suni ch'ufa AABBO Waaqati boha bule. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyyaate lafaa kae Saulo barbaadu d'annaani waan jed'aniini yayu dira Karmeli d'aqe, achiti akheekha woi, ka isaani qaabattani, jaarate duuba Gilgaliti dabre. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuelini Sauloti d'ufe jennaani Sauloni isa nagaya fuud'e waan jed'eeni, AABBO Waaqi si eebisinna! Anini dubbi AABBO Waaqa ya gula deeme guute.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Samuelini waan jed'eeni, Marriti loonitifi ta ree ta anini d'agayu tunini maani re?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauloni waan jed'eeni, Askarti tiyyati worra Amaleki iraa boojie. Worri loonifi hooliye ira gagabbo hambise, aka AABBO Waaqa kanketi sorio baasu. Ammo nu hori kaani ch'ufa yayu hobaamne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuelini waan Sauloni jed'e, Lakisi afaani qabad'i, waan AABBO Waaqi edda nani jed'e siti hima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauloni waan jed'eeni, Hayye, nati himi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Samuelini waan jed'eeni, Ato atini nama diqa woma keesa injirre ufi seetele, atini hayyu gosa Israeli ch'ufaani deemu. AABBO Waaqi si fohate, si muude hayyu Israeli si tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni si erge, Beeni, worra hamama Amaleki suni ch'ufa balleesi haga maqa worraa lafa d'abaniti ch'ufa had'i siini jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.18",
            "verseOrgIds": [
              "1SA.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini maanifi dubbi AABBO Waaqa gula indeemini re? Atini maafi worra saamte, waan worra guurate, waan AABBO Waaqi infeene taate?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauloni waan jed'eeni, Anini dubbi AABBO Waaqa ya gula deeme. Anini erga isaa guute, hayyu Agagi boojie worra Amaleki ch'ufa fit'e. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
              "1SA.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo askartini tiyya hooliyeefi looni gagabbo ijeesu dide boojite, aka Gilgalini d'ufte sorio AABBO Waaqa kanketi baaftu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
