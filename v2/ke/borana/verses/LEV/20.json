            }
          ]
        },
        {
          "text": "Hojja nami d'iira akuma nama uwatiin rafu woliini rafe worri ya waan hamtu tolche, worra lachu ha ijeesani. D'iigi worraa gubbuna worrati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
