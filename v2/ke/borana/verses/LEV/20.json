          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nad'eenileeni horini wolti jallatani isiifi hori sule ha ijeesani. D'iigi worraa gubbuma worrati.",
          "type": "text",
          "attrs": {
