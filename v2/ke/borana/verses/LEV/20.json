        },
        {
          "text": "Hojja nami nad'eeni aada uwa qabdu bira rafe, worra lachu gumi keesaa baasu malani, wonti akanatiifi worri yayu aada qulqulluma ch'abse.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        }
      ]
    },
