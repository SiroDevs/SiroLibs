                  "text": "27.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nad'eeni abba isaa bira rafe ya abba ufi ch'eerse, isaafi niiti sunile ha ijeesani. D'iigi worraa gubbuma worraati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Law 18.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja nami niiti ilma isaatini rafe isaafi niiti sunile ha ijeesani, worri ya waan male tahe, d'iigi worraa gubbuma worraati.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
