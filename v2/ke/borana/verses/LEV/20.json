              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu: Isanifi worra gosa d'ibi, ka isani keesa godaanule, yo nami toko ilmaani ufi waaqa Moleki jed'ani sorio baase nama suni ha gumiini ch'ufti d'akhaachani d'aanite ijeeftu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.2",
            "verseOrgIds": [
              "LEV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami tokoleeni ilmaani isaa Moleki suni kenne Waaro Woyyuma t'ureese maqa kiyyale ch'eerse, anini nama suniti garagale, deebie gumi tiyyati isa inheregu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hojja gumiini isa lakifte d'akhaani ijeesu didde, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anumati nama sunifi worra isaatiifi nama isa gula bahe na lakise Moleki kad'ate ch'ufa iti garagale balleesa. Anini deebie gumi tiyyati worra inheregu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami worra ekhera wogaafatu gorsa iraa fud'achu d'aqu, anini nama suniti garagale deebie nama suni gumi tiyyati inheregu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi ufi qulqulleesa, qulqullo taha. Wonti akanatiifi anini AABBO Waaqa keesani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seera kiyya guuta, gula deema; wonti akanatiifi anini AABBO Waaqa isani qulqulleesu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        }
      ]
    },
