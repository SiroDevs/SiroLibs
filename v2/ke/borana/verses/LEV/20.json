                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja nami horiti jallate, nama sunifi hori sunite ha ijeesana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
