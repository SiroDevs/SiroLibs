          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.12+LEV.18.13+LEV.18.14"
              },
              "items": [
                {
                  "text": "Law 18.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja nami adada yokhaani arera ufi bira rafe, worra lachu wollaali gubba worraati, waan worri waan ch'eera woltolcheefi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami niiti abbuya isaa yokhaani nad'eeni oboleyaani abbaa isaatini rafe inni ya nama suni ch'eerse, isaafi niitiini sunileeni gati ufi argatani, deebiani ijoolle ind'alani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.16"
              },
              "items": [
                {
                  "text": "Law 18.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo nami niiti oboleesa isaa fuud'e, worri ijoolle ind'alu. Inni yayu waan qulqullo intahini tolche oboleesa isaa ch'eerse.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
