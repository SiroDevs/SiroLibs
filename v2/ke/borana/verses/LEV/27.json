            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Qab-Ser 14.22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami tokoleeni dandae waan qara AABBO Waaqaa kenne beese baase, e, ira indeefatu, yokhaani ingurguru, ato wonti sunini nama, yokhaani hori yokhaani oobrule taate. Wonti sunini haga jirtu ch'ufa ta AABBO Waaqati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namale ka kara sunini Waaqaa kennani dandaani indeefatani, nama suni ijeesu malani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
