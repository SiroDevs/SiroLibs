              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti qara horini d'ale ch'ufti ka AABBO Waaqaati, tanaafi nami tokoleeni waan suni aka sorio fed'i gula baasaniti herege imbaasini. Watiye taanaani, ilmoole hoolatifi ta laleesa taanaani ch'ufti ta AABBO Waaqaati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo waan bineensi qulqullo intahini qara d'alu dandaani deefatani, gati gaafasi gula, ammalle shani keesa toko iti daru malani. Yo abbaani deefachu baate dandaani gati suni gula nama d'ibii gurgurani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
