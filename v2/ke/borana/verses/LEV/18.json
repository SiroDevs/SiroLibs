            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.12"
              },
              "items": [
                {
                  "text": "Law 20.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Niiti ilma keeti yokhaani wosila tante bira irafini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15+LEV.18.16",
            "verseOrgIds": [
              "LEV.18.15",
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.14"
              },
              "items": [
                {
                  "text": "Law 20.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Qab-Ser 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Haad'afi ilme wolti bira irafini, ammalle akowaani isiile bira irafini ijoolleeni suni haad'a suni fiit'a, hujiini akasi huji dabaati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboleeti niiti tanteeti, haga niitiini tante jirtu, bira irafini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        }
      ]
    },
