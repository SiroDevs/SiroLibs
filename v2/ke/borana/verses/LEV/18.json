                "loc": "NEH.9.29"
              },
              "items": [
                {
                  "text": "Neh 9.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.9"
