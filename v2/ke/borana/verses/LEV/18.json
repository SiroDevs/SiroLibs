            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolle tante tokole gubde waaqa Moleki jed'ani sorio imbaasini wonti akanatiifi yo akasi taate atini ya maqa AABBO Waaqa ch'eersite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Law 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami d'iira aka nad'eeniini rafu woli bira irafini: Waaqi huji akasi guddo jibba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'iira yokhaani ka uwa bineensati injalatini; hujiini sunini waan karaa male tolchani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan akana kana tokole tolchitani ufi int'ureesina; wonti akanatiifi gochiti anini isani duraa baasu, waan akana kana tolchite ufi t'ureesite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini worraa lafa t'ureesite jennaani anini lafa suni maro t'uri sunitifi balleese, laftileeni nama isi keesa tau ufiraa gussite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri suni waan hamtu akana tolche, lafa t'ureese, ammo isani akasi tolchu himmalle. Isani ch'ufti Israeli taanaani nama gosa d'ibi ka isani keesa godaanu taanaani, aadaafi seera kiyya guutu maltani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26+LEV.18.27",
            "verseOrgIds": [
              "LEV.18.26",
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba yo isani akasi taatani lafti ufiraa isani ingussitu, aka isiini worra duri isani dura lafa suni keesa tae tolchite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani imbeetani, aka nama waan hamtu akana tolche ch'ufa gumi Waaqati anini inherenne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        }
      ]
    },
