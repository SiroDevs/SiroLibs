      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu, Nami sorio wold'ageeti baasu ha gama toko AABBO Waaqaa kennu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha harkuma isaatini waan gubani AABBO Waaqaa baasanini d'ufu. Inni gabbinna hori suni ha handaraafa woliini olqabe aka AABBO Waaqaa baasani garsiisuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi ha gabbinna waan mesa fakaata irati gubuti, ammo handaraafi ka qaaloleeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miila mirga ka lukha ka sorio wold'ageeti ha ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "qaallu d'iigaafi gabbinna sorio baasu kennani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handaraafa olqabani, aka AABBO Waaqaa baasani garsiisani kaanifi miila mirga ka lukha kaani, anini yayu worra Israeli iraa fuud'e Harunifi ilmaani isaati kenne aka wonti kunini waan guyya ch'ufa worra Israeli iraa fuud'ani taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti kunini qooda sagale sorio gubani keesaa fuud'ani gaafa Harunifi ilmaani isaa eebisani qaallu AABBO Waaqa tolchani kennaniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya worra muudani suni, AABBO Waaqi worra Israelitini, waan suni worraa kenna jed'e. Tunini aada worri Israeli haga jiru jireenna guutu male. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aadaani sorio dabaani ufiraa baasanifi waan gati sorio baasanifi waan guyya qaalole eebisani muudani baasanifi ammalle ta sorio wold'ageetileeni tana; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi aada tana Musa gaara Sinai, lafa aloo keesati, kenneefi, guyya inni worra Israelitini sorio AABBO Waaqa baasa jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aada gaafa Harunifi ilmaani isaa qaalole tolchani eebisanifi",
          "type": "text"
        }
      ]
    }
