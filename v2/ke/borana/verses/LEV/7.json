                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani fulla jirtani ch'ufa d'iiga simpirre yokhaani bineensafi horile tokole insoortina. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
