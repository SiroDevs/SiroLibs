  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "LEV 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torbaani jila qaaloleeni eebisani dabrani jennaani, Musani Harunifi ilmaani isaatiifi jaarole Israeli wolti yaame, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.1",
            "verseOrgIds": [
              "LEV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan Harunini jed'e, Jibicha korma tokofi elemo toko, ka kamu aabo inqamne fuud'i, AABBO Waaqaa baasi, jibicha sorio dabaani ufi iraa baasani baasi, Elemo sorio gubani baasani baasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.2",
            "verseOrgIds": [
              "LEV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle waan atini worra Israelitini jettu, Korbeesa toko fuud'a, sorio dabaani ufi iraa baasani baasa, ammalle jibicha ganna tokotifi Elemo ganna toko, ka kamu aabo inqamne, fuud'a, sorio gubani baasa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle jibicha kormatifi Elemo tokole fuud'a, sorio wold'ageeti baasa waan kana ch'ufa AABBO Waaqa durati sorio baasa, ammalle waan kana woliini mid'aani d'ad'ani makhani baasa, wonti isani akasi taatanifi AABBO Waaqi arra isaniti mullata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan Musani kootani jed'eeni kaani ch'ufa Waaro Woyyuma duraani d'ufe, gumiini ch'ufti achiti wolti baate, AABBO Waaqa dura ejite. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musani waan jed'e, wonti AABBO Waaqi, tolcha isaniini jed'e tana, aka guddinni AABBO Waaqa isaniti mullatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.7.27"
              },
              "items": [
                {
                  "text": "Ebr 7.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani inni waan Harunini jed'e, waan mesa fakaata kaani d'aqi, sorio dabaani ufi iraa baasanifi, sorio gubani ta daba kanketifi daba gumile baaftu baasi. Sorio daba gumitini baasani tana baasi akuma AABBO Waaqi jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Harunini waan mesa fakaata kaani d'aqe, jibicha korma ka daba isaatini baasani qale. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
              "LEV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani isaa d'iigaani d'ufte, jennaani inni quba keesa kaye, gaafa afraani waan mesa fakaata kaani ibse, ka hafe kaani mesa suni jalati jisse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni gabbinnafi kaleefi arabicho tirulle, waan aka mesa suni gubbati, akuma AABBO Waaqi Musani jed'e kaani, gube. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo foonifi goga alati baase fageese gube. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
              "LEV.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni hori gubani sorio baasanile qale. Duuba ilmaani isaa d'iigaani d'ufte, inni d'iiga suni waan mesa fakaata kaani gama afraaniti jisse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle matafi fooni hori suni iti kennite jennaani inni waan mesa fakaata suni irati gube. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni miha garaatifi miila lukha lamaani d'iqe, waan mesa fakaata kaani irati sorio gubani taani woliini gube. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeegi suni inni waan gumiini baafte baase, korbeesa daba gumitini baasani fuud'e korbeesa daba gumitini baasani fuud'e qare sorio baase, akuma inni sorio daba isaatini baasani taani baase. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.15",
            "verseOrgIds": [
              "LEV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni hori gubani sorio baasanile d'ufeeni, akuma kaani aada gula sorio baase. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
              "LEV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba mid'aani Waaqaa baasanile d'ufeeni, mid'aani daakhani suni harka guutafe, fuud'e waan mesa fakaata suni irati gube. (Waan kana ch'ufa waan guyya ch'ufa gubani waaqaa baasani male baasani.) ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.1+LEV.3.2+LEV.3.3+LEV.3.4+LEV.3.5+LEV.3.6+LEV.3.7+LEV.3.8+LEV.3.9+LEV.3.10+LEV.3.11"
              },
              "items": [
                {
                  "text": "Law 3.1-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni kormafi Elemo sorio wold'ageeti biyyaa qale. Duuba ilmaani isaa d'iigaani d'ufte, inni d'iiga suni waan mesa fakaata kaani gama afraaniti jijisse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunini gabbinna kormatifi ka elemole ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "handaraafa hori suni gubba kaye, waan mesa fakaatiti geese. Ammalle gabbinna waan mesa fakaata irati gube, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "handaraafafi miila lukha ka mirga lamaani olqabe, aka AABBO Waaqaa baasani garsiise, akuma Musani isaani jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
