              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami Israeli tokoleeni, waan nami gosa isa qabdo iti lakise deebisuufi dide, yokhaani woi iraa hate, yokhaani woi iraa Saame, yokhaani waan bade ka inni arge mormate, Anini ingarre jed'e akanaani AABBO Waaqati ch'ubbame, nami sunini sorio baasu male. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2+LEV.6.3",
            "verseOrgIds": [
              "LEV.6.2",
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami kara suni tokoleeni ch'ubbame, inni waan kara maleeni argate suni ha abba dabse iraa fud'ate kaani deebisu. Guyya ch'ubbuuni isaa mullatu, inni ha nama dabse kaani waan isaa deebise, ammalle waan shani keesa toko iti daruufi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4+LEV.6.5",
            "verseOrgIds": [
              "LEV.6.4",
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni ha elemo yokhaani korbeesa ka kamu aabo inqamne AABBO Waaqa gati baase qaallutini d'ufu. Gati hori suni ha aada Waaro Woyyuma gula laalaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi ha sorio daba nama sunitini baasani baase, akasiini daba araaramanifi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sorio gubani baasani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
