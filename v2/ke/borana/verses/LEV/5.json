          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami danu seera AABBO Waaqa ch'abse ch'ubbu seene, inni gati baasu male. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha elemo yokhaani korbeesa, ka kamu aabo inqamne, gati baase qaallutini d'ufu. Gati hori suni ha aada Waaro Woyyuma gula laalaniti. Qaallichi sorio daba nama sunitini baasani baase, akasiini daba isaa araaramanifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni sorio suni waan AABBO Waaqati ch'ubbamefi gati baase.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
