            "sid": "LEV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami looni isaa keesa toko sorio wold'ageeti AABBO Waaqa durati baase, wonti inni baasu suni korma taanaani, yokhaani d'ala taanaani, ha waan aabo inqamne taatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.1",
            "verseOrgIds": [
              "LEV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi ha hori d'ufeeni suni harka mata ira keeyate harirate, fulla balbala Waaro Woyyumati gorau. Duuba qaaloleeni ilmaani Haruni ha d'iiga isaa suni waan aka mesa jira kaani gama afraaniti fifit'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "fooni hori suni kaani gubde AABBO Waaqaa sorio baaftu: gabbinnafi moora miha garaa ch'ufafi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaleefi gabbinna isiitiifi arabicho tirulle ch'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleeni ha waan kana ch'ufa waan gubani sorio Waaqaa baasani woliini gubde sorio baaftu, aka akasiini ch'inch'aani waan kana AABBO Waaqa gammachiiftu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami ree isaa keesa toko sorio wold'ageeti baasu, wonti inni baasu suni ha kormafi yokhaani d'altu aabo inqamne taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami hoola sorio AABBO Waaqaa baasu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni ha hoola suni harka mata ira keeyate harirate, Waaro Woyyuma durati gorauti. Duuba qaaloleeni ha d'iiga isaa waan mesa fakaata kaani gama afraaniti fifit'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "fooni hori suni kaani gubde AABBO Waaqaa sorio baaftu; gabbinna duba isaa ch'ufa, gabbinnafi moora miha garaa ch'ufa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaleefi gabbinna isi arabicho tirulle ch'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi ha waan kana ch'ufa waan mesa fakaata kaani irati gube, AABBO Waaqaa sorio baasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
