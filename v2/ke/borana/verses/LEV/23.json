                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya jaa hojad'a, ammo guyyaani torbeeso guyya Sbato, ka huji lakisani boqatani wolti bahani Waaqa kad'atani. Sabatoni ta AABBO Waaqa fulla isani jirtani ch'ufati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jila AABBO Waaqa tana yo isiini martu ch'ufa wolti hima tolfad'a.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
      ]
    },
