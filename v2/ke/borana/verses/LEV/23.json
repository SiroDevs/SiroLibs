                "loc": "EXO.34.22"
              },
              "items": [
                {
                  "text": "34.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya kud'ani shaneeso ka jia torbeeso, ka isani mid'aani keesani galfatani, jila tana guyya torba AABBO Waaqaa tolcha. Guyya qaraatiifi ka saddeeteeso lachu guyya boqotati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya qara mid'aani dadansa mukhi keesani baasu fuud'a, qooti meet'itifi ta dame mukha d'ibi ch'ira, guyya torba AABBO Waaqa keesani durati gammada. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna ch'ufa jila tana guyya torba AABBO Waaqaa tolcha. Aadaani tunini ta d'alooti keesani haga jiru jireenna guutu male; jia torbeeso tolfad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya torba hoosa keesati gala. Nami Israeli keesaa d'alate ch'ufti ha hoosati galuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka akanaani d'alooti keesani aka anini worra Israeli duri hoosa keesati galche beekhu, gaafa anini lafa Misiri keesaa baase. Anini AABBO, Waaqa keesani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        }
      ]
    },
