              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu: Jilti AABBO Waaqa ta isani worri Israeli wolti d'ufe na kad'atu tana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
