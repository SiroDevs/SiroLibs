                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pasakani jiltu AABBO Waaqa galgala guyya kud'ani afreeso ka jia qara jalaqabati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
