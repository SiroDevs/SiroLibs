              },
              "items": [
                {
                  "text": "Eze 44.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Harunini ha Waaro Woyyuma seene, woya qaallu, ta inni ato Fulla Fulla Ch'ufa Ira Qulqullo inseeniini keeyate taani, ufira baase achiti lakisu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni ha Fulla Quilqullooti nafa d'iqate woya ufi keeyatu. Eegi suni, inni ha gabahe, sorio gubani, ta ch'ubbu isaatiifi ta biyyale balleesitu, baasu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle gabbinna hori sorio dabaani ufi iraa baasani kaani ha waan mesa fakaata irati gubuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi korbeesa kaani lafa aloo gara Azazeli gusse, ha woya miich'ate nafa d'iqatu, ato ollatu indeebiini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Ebr 13.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kormafi korbeesa sorio dabaani ufi iraa baasani baasani, ka d'iiga isaani Fulla Fulla Ch'ufa Ira Qulqullootini d'ufani dabaani balleesani, ha olla keesaa alati baasani goga, fooni, marumale ch'ufa gubani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami waan suni gubuleeni ha ato ollati indeebiini woya miich'ate nafa d'iqatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka aada guyya daba gumi iraa fuud'ani jabeesani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
