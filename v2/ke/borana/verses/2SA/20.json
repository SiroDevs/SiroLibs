              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheranini nama tatabe hayyu t'aafu; Sadokifi Abiatharini qaalole isaati; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
