                  "text": "2 Sam 17.27-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Barzilaini namichi Gileadi Rogolemu bahe hayyicha galaana Yordani taakisiisu d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.31",
            "verseOrgIds": [
              "2SA.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barzilaini nama jaare hobae, ka ganni isaa saddeetama gahe. Inni dureesa, hori gudda qaba ammalle gaafa hayyuuni Mahanaimu jiru guddo isa gololche. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.32",
            "verseOrgIds": [
              "2SA.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi waan isani jed'e, Yerusalemuti nu galchi, si qorqorad'a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.33",
            "verseOrgIds": [
              "2SA.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.33",
            "verseOrgIds": [
              "2SA.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Barzilaini waan jed'eeni, Guyyaani kiyya ya ala hobae anini maanifi Yerusalemu si woliini deema? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.34",
            "verseOrgIds": [
              "2SA.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nami ganna saddeetama waan dansaafi hamtu gargari imbeekha? Wonti nyaatani d'ugani nati imiofti? qonqo sirbale dandae ind'agaya? Laki ufumaa ulfinna siti tahe si gaargalcha, na eebisi, ee hayyicha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.35",
            "verseOrgIds": [
              "2SA.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti guddooni akanaleeni naa imale, tatule diqo Yordani gama suni si gegeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.36",
            "verseOrgIds": [
              "2SA.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini deebie d'aatu awaala abbooti tiyyaati dua, ammo ilmi kiyya kana kimhamu fud'ad'i ha sii hojatuti atileeni waan feetu ch'ufa tolchifi ee, hayyicha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.37",
            "verseOrgIds": [
              "2SA.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.37",
            "verseOrgIds": [
              "2SA.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi waan jed'eeni, Anini kimhamuni deeme waan atini feetu tolchaafi. Sile waan atini himatu ch'ufa sii guuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.38",
            "verseOrgIds": [
              "2SA.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Daudifi jari isaa ch'ufti galaana Yordani taake. Inni Barzilai d'ungate eebisefi Barzilaini kae gale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.39",
            "verseOrgIds": [
              "2SA.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Yudatifi ka Israeli hayyu irati wolmormani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.39",
            "verseOrgIds": [
              "2SA.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2SA 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yudatifi worri Israeli hagi gari, ka hayyuu gegeesu d'ufe isa woliini galaana takaani Gilgali d'aqani kimhamuleeni isa gula deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.40",
            "verseOrgIds": [
              "2SA.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2SA 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Israeli ch'ufti gara hayyu d'aqe waan jed'eeni, Ee hayyicha, oboleyaani teenna worri Yuda maanifi nu dabse, armaa siifi worra keetifi worra si woliini yaule ch'ufa fuud'e, galaana Yordani isani takisise? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.41",
            "verseOrgIds": [
              "2SA.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Yuda waan jed'eeni, Hayyuuni gosa teennaniti? Isani maanifi dallantani, nu taka waan isa toko inyaanne yokhaani woma iraa infud'anne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2SA 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli waan worra Yudatini jed'e, Ato inni gosa teesanile taate, isani gosa toko ch'alla, nu gosa kud'ani; tanaafi Daudileni isani ira nuti aana. Isani maanifi nu tufattani? Nami qara waan galisa hayyu dubbate nuuniti? Ammo worri Yuda haga worra Israeli ira miira hamate, oowe, dubbi jajabdu dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Shebani Daudini morke",
          "type": "text"
        }
      ]
    }
