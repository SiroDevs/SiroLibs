        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37+2SA.13.38",
            "verseOrgIds": [
              "2SA.13.37",
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.3"
              },
              "items": [
                {
                  "text": "2 Sam 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Absalomuni baqate gara hayyu Geshuri ka Talmai ilma Amihuri jed'ani, d'aqe ganna sadi achi tae. Daudini guyya hedu ilma isaati bohe; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37+2SA.13.38",
            "verseOrgIds": [
              "2SA.13.37",
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo inni eegi lubbu gurba isaa Amnoni bira dabre, ilma isaa Absalomu guddo garaani iti eje qaabate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yoabuni deebii Absalomu kurfeese",
          "type": "text"
        }
      ]
    }
