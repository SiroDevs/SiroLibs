          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan worri tolcheefi ammalle aka worri kara isaani hama kaani iraa deebiele arginaani herega ufii jijire, worraa nahe, badi sila worra balleesu taani lakise.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dallansu Yonatiifi naasu Waaqaa",
          "type": "text"
        }
      ]
    }
