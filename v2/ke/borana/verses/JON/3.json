              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi maro lameeso Yona yaame waan jed'eeni, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kai, dira Ninawi, dira gudda suni, d'aqi, dubbi anini siti himu tana diideesi nama ch'ufati odeesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yonaani akuma AABBO Waaqi jed'eeni kaani kae dira Ninawi d'aqe. Diri sunini aka male gudda, ballinni isaa deema guyya sadi fud'ata. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12.41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.32"
              },
              "items": [
                {
                  "text": "Luk 11.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yonaani deema guyya toko dira suni keesa deeme lalabe waan jed'e, Guyya afurtama keesati Ninawi imballeesani!",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
