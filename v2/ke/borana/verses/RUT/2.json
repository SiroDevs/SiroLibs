            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.25"
              },
              "items": [
                {
                  "text": "Law 25.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomiini waan Ruthiini jette, AABBO Waaqi naasu isaatini nama nama ka jirufi ka due qaabate sunii eebisinna. Ammalle Naomiini waan jette, Namichi sunii fiit'a teenna, inni nuu miilo aanti, nama sila nu d'aalu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Ruthiini, Ta gosa Moabu, waan jette, Suni male inni waan naani jed'e, Hojattu tiyya biraa imfagaatiini, haga mid'aani ch'ufa galaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.21",
            "verseOrgIds": [
              "RUT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Naomiini waan Ruthiini jette, Ee, intala tiyya, aki hojattu isaa ta uwa woliini hojattani sii fulla, aka oobru d'ibi keesati nami si ingaargalchine. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.22",
            "verseOrgIds": [
              "RUT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "RUT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi isiini ato haad'a d'iirsa isii woliini teetu, d'aatu hojattu Boazi hojatte, garbufi dargaye filatte guurte, haga mid'aani ch'ufa galchaniti.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.23",
            "verseOrgIds": [
              "RUT.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Ruthiini d'iirsa argatte",
          "type": "text"
        }
      ]
    }
  ],
