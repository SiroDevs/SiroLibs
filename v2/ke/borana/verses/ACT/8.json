        "style": "s1"
      },
      "items": [
        {
          "text": "Sauloni gumi Waaqa gaargalcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
