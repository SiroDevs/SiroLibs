              },
              "items": [
                {
                  "text": "26.9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo Sauloni gumi Waaqa guddo gaargalche, mana ch'ufa seene, d'iirafi nad'eenile hid'aansati guure.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
