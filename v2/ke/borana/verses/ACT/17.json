              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Pauloni jiddu worraati kae deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
