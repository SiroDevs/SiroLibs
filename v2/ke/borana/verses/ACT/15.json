                {
                  "text": "Huji 13.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo Pauloni aka isa fuud'ani imfeene, maro inni Pamfiliati worra lakise worra woliini huji tolchu dideefi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri guddo wolmorme gargari bahe. Jennaani Barnabani Mariko fuud'e haga Kiproni hobolooni d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo eegi oboleyaani aka inni eeba Aabbo argatu Waaqa kad'ateefi Pauloni sila fuud'e iti d'aabate. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
