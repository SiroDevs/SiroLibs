              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulofi Barnabani Antiokia keesa taani, dubbi Aabbo barsiisani nama d'ibi heddu woliini hasaani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
