          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi bulti diqo toko Pauloni waan Barnabani jed'e, Gara oboleyaani teenna, ta dira nu dubbi Waaqa iti hasoomne ch'ufu keesa jirtu, dachaane waan worri keesa jira ilaalu male. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
