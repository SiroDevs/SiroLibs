            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aabbooti, ijoolle teesani imufachisiina, ammo barsiisafi gorsa Aabbootiini guddisa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
