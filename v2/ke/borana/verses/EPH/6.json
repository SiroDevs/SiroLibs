        },
        {
          "text": " Ijoolle, maro Kristotiifi worra keesani saalfad'a, wonti kunini waan tolchu malani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
