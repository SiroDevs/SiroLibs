          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi anini isa gara keesani erga, aka waan nuuni ch'ufti keesa jirru inni isani beesise garaa isani jabeesu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
