                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Qab-Ser 5.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jechi abbeetiifi haateti saalfad'a jed'u kakhu d'ibi iti darani qaba; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakhuuni suni waan jettu, aka lafa Aabbo Waaqi sii kennu keesati lubbuuni tante d'eeratu jetti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        }
      ]
    },
