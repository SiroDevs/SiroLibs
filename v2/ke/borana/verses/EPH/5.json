                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nad'eeni ha d'iirsole ufiti ch'eerfatuuti, akuma Aabbo ch'eerfattu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma Kristoni mata gumi isaa, d'iirsileeni mata niiti isaati; Kristoleeni ufi isaati Qarqaarsa gumi, ta nafa isaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi nad'eeni aka dansa d'iirsole ufiiti ch'eeru malte, akuma gumiini Waaqa Kristo ch'eertu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
