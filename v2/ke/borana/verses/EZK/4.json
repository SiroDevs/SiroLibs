        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan jed'e, Namicha, matofaara fuud'i, ufi dura kayi, akheekha dira Yerusalemu irati tatarari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.1",
            "verseOrgIds": [
              "EZK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba fakeenna boolatiifi biyye olbaasanifi, bultofi waan balbala diratini ch'absanile ka aka dira sunini marsani garsiiftu, irati tatarari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daboola sibiila fuud'i, siifi dira jiddu aka dalla, old'aabi. Duuba fuula dira suniti deefad'i, dira suni ya marsani, nami marsu jiruleeni siuma. Wonti kunini ch'ufti worra Israeliti akheekha taati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba gama kanke ka bitaati ch'iisi, anini ch'ubbu worra Israeli ch'ufa sira kaya. Atini bulti d'ibba sadiifi sagaltama artuma ch'iifte, maro daba worrati jette gaargalta. Akuma worri ganna d'ibba saditifi sagaltama gaargala keesa tau, atinileeni bulti d'ibba saditifi sagaltama gaargala keesa teeta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.4+EZK.4.5",
            "verseOrgIds": [
              "EZK.4.4",
              "EZK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo tana hobaaftele akuma worri Yuda ganna afurtama gaargala agarte, gama mirgaati garagali, bulti afurtama garagali, ch'iisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.6",
            "verseOrgIds": [
              "EZK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira Yerusalemu ka marsani ila iti qabi qubale iti irbi badi isaa fagi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.7",
            "verseOrgIds": [
              "EZK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga marsitini dira kana marsani tunini dabartuti aka atini gama tokoleti gara ingalle anini haadani si hid'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba amma dargaye, garbu, halquqa, d'engo, misinga, t'aafi daakhi, wolti makhi, qit'a d'aabad'i. Wonti atini bulti d'ibba saditifi sagaltama, ka atini gama bitaati ch'iiftu, nyaatu tana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba sagale tana wonti atini guyya toko nyaachu malte waan aka moqa gudda shanii; tana male bori asi sagaleeni atini argatu d'ibiini injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle bisaani wonti atini guyyaati d'ugu malte muduunu lama ch'alla. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibidale, wonti atini bobeefatuni kosi udaani namaa; duuba ibida sunini qit'a d'aabad'i, fulla nami ch'ufti si argu tai nyaad'i.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'e, Akuma kana worri Israeli sagale sila nyaachu himmalini, gaafa boojiani lafa d'ibi geesani, nyaata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini waan jed'eeni, ee AABBO Waaqa gudda, akasi intau, anini takaa ufi int'ureesine, haguma d'alad'ele takaa fooni waan ufiini due yokhaani ka bineensi d'ibiini nyaate inyaanne. Anini taka sagale nami lagatu insooranne.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan jed'e, Hayye dansa, yoosi fulla suni kosi loonitini qit'a d'abad'u.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni waan jed'e, Namicha, anini sagale worri Yerusalemu argatu iraa kuta. Nami achi keesa tau, ato sagaleefi bisaani qusatu, yaadae gaargala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.16",
            "verseOrgIds": [
              "EZK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri sagaleefi bisaanile d'abe, maro daba ufitifi ufi jibbaate, akanumati raawata.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.17",
            "verseOrgIds": [
              "EZK.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Ezekielini mata haadate",
          "type": "text"
        }
      ]
    }
  ],
