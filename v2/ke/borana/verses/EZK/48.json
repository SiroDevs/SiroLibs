          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda lafaa ta gosa Gaditi kennani moga bita, seeri Tamari iraa bahe, maddo Kadeshiti qajeele, laga seera Misiri ira bahu gula deeme Baariini Guddaani bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'e, Aki lafa gosa Israeliti qoodani kennanifi akana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
