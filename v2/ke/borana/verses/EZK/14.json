        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani jaaroleeni Israeli hagi toko d'ufte woi na gaafate. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.1",
            "verseOrgIds": [
              "EZK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.2",
            "verseOrgIds": [
              "EZK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, jari kunini yayu Waaqa d'ara, ka harkaani boch'ani kana jaalate gula yae, akanaani ch'ubbu keesa ufi buuse. Worri waan anini dubbi worra jalaa qabu seha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.3",
            "verseOrgIds": [
              "EZK.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.3",
            "verseOrgIds": [
              "EZK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba amma waan worraani jettu, wonti AABBO Waaqi guddaani jed'u tana: Nami Israeli ch'ufti, ka waan harkaani boch'ani kana jaalate, gula deeme akanaani ch'ubbu keesa ufi buuse, duuba eege raaga woi gaafachu d'ufu, anumati waan harkaani boch'ani, ka inni gula deemu suni gula, waan isa male kennafi!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.4",
            "verseOrgIds": [
              "EZK.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.4",
            "verseOrgIds": [
              "EZK.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti harkaani boch'ani sunini ch'ufti yayu worra Israeli naraa garagalchite, ammo anini dubbuma tiyya tanaani worra ufi gula deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.5",
            "verseOrgIds": [
              "EZK.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.5",
            "verseOrgIds": [
              "EZK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan atini worra Israelitini jettu, wonti AABBO Waaqi jed'u tana: Kara hama qara keesa jirtani suni iraa deebia, waan harkaani boch'ani kana lakisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.6",
            "verseOrgIds": [
              "EZK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.6",
            "verseOrgIds": [
              "EZK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami Israeli toko, yokhaani nami gosa d'ibi, ka lafa Israeli keesa godaanu, naraa garagale, waan harkaani boch'ani kad'ate d'aqe raaga woi gaafatu, ana, AABBO Waaqati, jecha isaa male jed'ani! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.7",
            "verseOrgIds": [
              "EZK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini isati kae, gumi tiyya keesaa isa balleese, akanaani inni akheekha worraa taha. Duuba akasiini aka anini AABBO Waaqa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.8",
            "verseOrgIds": [
              "EZK.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.8",
            "verseOrgIds": [
              "EZK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo raagi sobame dubbi d'ara fage, nami isa sobe ana, AABBO Waaqa. Duuba anini isati kae, gumi Israeli keesaa isa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.9",
            "verseOrgIds": [
              "EZK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raagafi nama isa wo gaafatule woma takaati qabata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.10",
            "verseOrgIds": [
              "EZK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani anini worra Israeli ufiraa garagalu d'owe, ch'ubbu hamtu worra t'ureesitu iraa deebisa. Duuba akanaani worri gumi tiyya tae aninileeni Waaqa worraa taha. Nami dubbi tana jed'e ana, AABBO Waaqa gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.11",
            "verseOrgIds": [
              "EZK.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nuhufi Danielifi Ayubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.11",
            "verseOrgIds": [
              "EZK.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.12",
            "verseOrgIds": [
              "EZK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, yo lafti toko ch'ubbu tolchite naraa gorte, anini harka kiyya d'eereefad'e sagale iraa kute, oola iti buuse, namafi saa isiile ch'ufa fit'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.13",
            "verseOrgIds": [
              "EZK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Nuhufi Danielifi Ayubu, jari kunini saaddeeni achi jiraatele, dansumti worraa worruma ch'alla baafti. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokhaani anini bineensa ala, ka worra suni fit'u iti erge, bineensi sunini lafa suni ch'ufa balleese, namileeni sodaa keesaa bahu dad'aba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.15",
            "verseOrgIds": [
              "EZK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle ato worri sunini sadeenu arti jiraatele haga anini AABBO Waaqi guddaani jiru imbaasu. Worri lubbu ufi ch'alla baasa, ammo laftileeni badde ona taati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokhaani anini had'iisa lafa sunitini d'ufe woraana hama namaafi saa hobaasu iti erga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle ato worri sunini sadeeni arti jiraatele haga anini AABBO Waaqi guddaani jiru — jari kunini dandae ilmaani ufi imbaasu, lubbu ufi male.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ammalle anini ch'iisa d'ukuba hama lafa sunitini d'ufe dallansu keesa namaafi saala hobaase, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.19",
            "verseOrgIds": [
              "EZK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato Nuhufi Danielifi Ayubuleni arti jiraatanile — jari kunileeni dandae ilmaani worrale imbaasu. Dansumti worraa lubbuma worra ch'allaa baafti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        }
      ]
    },
