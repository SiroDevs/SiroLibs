                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.1",
            "verseOrgIds": [
              "EZK.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, fuula kanke lafa Amoniti deefad'i abaari waan jettuuni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbi AABBO Waaqa gudda d'agaya, wonti inni jed'u tana: Isani Mana kiyya ka t'ureesanifi lafa Israeli ta balleesanifi gumi Yuda ta boojiani agarraani gammaddani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan isani waan suni jettani gammaddanifi, anini harka gosa lafa gamooji ta ilaboru keesaa d'uftuti isani kenne, worri isani dabsata. Worri bulto jaarate achi qubata, mid'aanifi aanani isani sila nyaatani d'uddani nyaate d'uga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini dira Raba balleese, lafa gaali keesaa oolu tolche, lafa Amoni ch'ufa fulla hooliyeeni ooltu tolcha, duuba akanaani aka anini AABBO Waaqaa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti AABBO Waaqi guddaani jed'u tana: Isani gammaddani, harka d'ooftani sirbitani lafa Israeli tufattani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan isani waan kana taatanifi, anini harka gosa d'ibi ka waan keesani hatte isani saamtuti isani kenna. Anini aka takaa inargini isani balleese fiiga isani d'owe, aka isani itumaa deebitani gosa intaane yokhaani lafa inhoranne isani tolcha. Duuba akanaani aka anini AABBO Waaqaa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Moabu ka fagani",
          "type": "text"
        }
      ]
    },
