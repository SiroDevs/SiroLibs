                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'e, Waan worri Moabu worri Yuda akuma worra lafa d'ibi jira jed'eefi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini dira seera lafa Moabu nyaapa ira d'owu nyaapa iti erge haasisa. Dira, Beth-Yeshmothitifi, Baal-Meonitifi Kirathamule. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle anini gosa lafa gamooji, ta ilaboru teetu, Moabufi Amoni dabsachiisa, aka Moabuni deebite gosa intaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini worra Moabu balleesa, duuba worri akanaani aka anini AABBO Waaqaa beekha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
      ]
    },
