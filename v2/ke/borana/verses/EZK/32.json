            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Misiritiifi askartini isaa worra kana ch'ufa ka woraanaani hobae arginaani garaa jabaatte. Nami dubbi tana jed'e AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anumati hayyu Misiritini, nama jiru mudamsiisi jed'e, ammo isaafi askarti isaale woraanaani hobaasani, worra qabanqaba inqabatini ka woraanaani raawate woliini boola ekherati galcha. Nami waan kana jed'e AABBO Waaqa gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi Ezekieli nama lafa eegu tolche",
          "type": "text"
        }
      ]
    }
