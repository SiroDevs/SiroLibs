              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaarole lafa mirga mohatufi worri Sidonileeni achi jirani. Worri gaafa duri irre qabu nama mudamsiise, ammo ammatana nama woraanaani hobae ka qabanqaba inqabatini, woliini ch'eersani, boola ekhera keesa ch'ibsisani. Worri sunini qooda worra ch'eeraani boola ekherati gale agarta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
