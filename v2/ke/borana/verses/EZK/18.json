            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.24",
            "verseOrgIds": [
              "EZK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isani waan jettani, Wonti Aabbo Waaqi tolchu kunini qajeeltuniti. Worra Israeli, me na ch'aqasa! Isani karaani anini woini tolchu qajeelaniti jettani? Keesanumati qajeela intahini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.25",
            "verseOrgIds": [
              "EZK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami d'ugaa qajeelani qajeeluma ufi lakise, ch'ubbu gula bahe, duu, inni woma ch'ubbu tolcheefi dua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja ch'ubbichi daba lakise waan d'uga qajeeltu tolchu, inni lubbu ufi baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.27",
            "verseOrgIds": [
              "EZK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hameenna tolchu jiru arge iraa deebia, tanaafi inni induu, lubbu bula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
              "EZK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isani worri Israeli waan jettani, wonti Aabbo Waaqi tolchu kunini qajeeltuniti. Isani kara kiyyaani qajeelaniti jettani, akasumayu? Keesanumati qajeela intahini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
