        },
        {
          "text": "AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
