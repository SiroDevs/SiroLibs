                "loc": "LUK.10.13+LUK.10.14"
              },
              "items": [
                {
                  "text": "Luk 10.13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bulti qara ta jia, ta ganna kud'ani tokeeso ka haga nu boojiani teenne, AABBO Waaqi na yaame waan ani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, wonti worri Tiro gammadufi tana. Worri iyye waan jed'u, Yerusalemuni ya badde balbala isii ch'ufa ya ch'absani, daldali isii ya ch'ite. Eegi isiini badde, nu amma woi horanna!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma wonti AABBO Waaqi guddaani jed'u tana: Ee dira Tiro, anini ya siti nyaape. Anini gosa heddu ta aka d'awa galaana woli d'oofte, d'ufte si haatu sitini d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri naabo dira suni ch'ach'abse doofi isaale ch'ufa butucha. Duuba anini biyyele ch'ufa hare, d'akha diidati gabaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri qurt'umi guuruleeni d'akhuma suni ka afaani galaana ch'iisu irati t'urura goffata. Nami dubbi tana jed'u ana, AABBO Waaqa gudda. Gochiti d'ibiini Tiro saamte, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle goraadeeni worraatini nama dira afaani baariini keesa jiru ch'ufa fit'i. Duuba akanaani worri Tiro aka anini AABBO Waaqa beekha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u, Anini hayyu Babiloni ka Nebukadreza jed'ani, ka hayyu ch'ufa ira jiru, Tironi d'ufe haasisa. Inni duula gudda fardafi gaari fardi hirkisufi askarti miilaani yaatu qabuuni mirgaa d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dira afaani Baariini keesa tau woraanaani hobaasani. Nyaapi d'ufe, boola dira sunini marse qote, biyye olbaase wonte ufitini ch'ibra keeyata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri naabo teesani jigeesa mukhatini butuche, doofi teesanile konfi sibiilatini ch'absa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awarti fardi worraa kaasu lafa isaniti duuchite, iyyanti farda worraa, ka gaarini hirkise balbala dira ta ch'absanini olduudu, lafafi naabo dirale ch'ufa isaniti chochoofti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari worraa ka farda yabatuleeni dira keesaniti baafate, nama keesani goraadeeni kara keesati fit'e, utuba keesani gugurddale ch'ufa qaqarisani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaapi keesani suni hori keesani ka daldala ch'ufa saame boojie, naabo teesani ch'ufa ch'ach'abse maneeni teesani dadansa ch'ufa bulleese, d'akhaafi mukhaafi ch'abdo maneeni suni ch'ufa fuud'e baariini keesati jissa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22"
              },
              "items": [
                {
                  "text": "Mul 18.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini faaru teesani imballeesa, duuba deebiani qonqo kirari teesani ind'agayani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini d'akha t'urura qurt'umi irati afatani ch'alla lakisa. Dira kana deebiani injaarani. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti AABBO Waaqi dira Tirotini jed'u tana: Hojja nyaapi isani had'u, nami afaani baariini tau iyyanna nama hobaasanitiifi gurra qabata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.9+REV.18.10"
              },
              "items": [
                {
                  "text": "Mul 18.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayyooti lafa afaani galaana ch'ufti ta hobolo qabdu, woya isii mimid'aadufi ubaara babaricha yaafate mudamte holate ga teteete. Lubbuuni worra d'ufte worri aka male holate waan tahu d'aba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba faaru boha tanaani si faarsani: Diri gurra gudda qabu ya bade! Hobolo tante yayu baariini keesaa balleesani. Nami dira kana duri baariini mohate, nama d'aatu jiru ch'ufale mudamsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma tana, guyya dira kana balleesani, lafti bisaani marsanileeni ch'ufti holatte, nami keesa tauleeni badi teesani arginaani guddo naha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti AABBO Waaqi guddaani jed'u tana: Anini aka dira bade ona tae nami keesa injirre si tolche, bisaani baariini siti fach'aase si liqimsiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini boola ekhera keesa si buuse, worra haguma duriti achi jiruti si dara. Worra gadi ka due, ona worra suni keesa woliini teetani, deebie nami siti inqubatu, yokhaani atinileeni lafa nama jiru deebite keesa inteetu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Mul 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini aka hama si balleese, deebiani si inargani. Si barbaadani, ammo deebiani si inargani. Nami dubbi tana jed'e AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Tiro faarsani bohanifi",
          "type": "text"
        }
      ]
    }
