      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'e, Namicha, gaareeni Israeli tanati dubbad'i waan jettu, Ee gaareeni Israeli, dubbi AABBO Waaqa d'agaya; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.1",
            "verseOrgIds": [
              "EZK.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyaapi keesani qilit'ame waan jed'e, Amma tana gaareeni Israeli ta duri jirtu ch'ufti teenna!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.2",
            "verseOrgIds": [
              "EZK.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.2",
            "verseOrgIds": [
              "EZK.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi amma fagi waan jettuuni, AABBO Waaqi guddaani waan jed'u: gaafa gochiti d'ibiini ta nyaapa keesani isani qabde isani saamte, worri gaafasi worra Israeli miid'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.3",
            "verseOrgIds": [
              "EZK.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi ee, gaareenii Israeli waan AABBO Waaqi guddaani jed'u d'agaya. Wonti inni gaareenifi kubileefi maddafi baleefi onneeni teesanifi dira keesani ka nyaapi keesani balleese waan keesa jira ch'ufa saame, iti tabateeni jed'u tana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.4",
            "verseOrgIds": [
              "EZK.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.4",
            "verseOrgIds": [
              "EZK.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi guddaani, owa dallansu tiyya keesa, yayu gosa d'aatu teesani jirtu ch'ufa, keesuma gosa Edomuti dubbad'e. Worri na tufate lafa tiyya waan isiini qabdu ch'ufa saame gammaddani fud'ate.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.5",
            "verseOrgIds": [
              "EZK.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.5",
            "verseOrgIds": [
              "EZK.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan lafa Israeli fagi; gaareenifi kubileefi maddafi baleeni waan jettu, AABBO Waaqi guddaani waan jed'u, waan gochiti d'ibiini isani arabsite isani ch'eersiteefi, anini obsu dad'abe dallansu tiyya keesa worrati dallana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.6",
            "verseOrgIds": [
              "EZK.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi guddaani waan jed'u, Anini inkakhad'a, aka gochiti d'aatu teesani jirtu tunini ch'ufti ch'eeraani baddu male inteenne. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isani, gumi tiyya ta Israeli gaareeni teesani gubba mukeeni deebite obeensaafi mid'aanile baafti Isanileeni d'iotu lafa teesaniti galtani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.8",
            "verseOrgIds": [
              "EZK.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini gama keesani jira waan ch'ufa keesati isani eebise, isani lafa qotattani fach'aafattani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.9",
            "verseOrgIds": [
              "EZK.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nama keesani daraarse, lafa ira dabarse isani dira keesani ka duri bade ona tae kaani ch'ufa jaartani iti qubattani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.10",
            "verseOrgIds": [
              "EZK.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini namaafi saa keesani ch'ufa horsiise lafa ira dabarsa. Isani lafa ira dabartani, ilmaani heddu d'altani. Anini akuma duri isani achi teetani kaani achi isani teesise, haga duri kaanile ira isani horsiise, isani deebansa. Duuba akanaani aka anini AABBO Waaqa beetani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.11",
            "verseOrgIds": [
              "EZK.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini isani, gumi tiyya ta Israeli, lafa tanati deebise iti isani qubsisa. Lafti tunini teesani taati, ilmaani teesanileeni deebite imbeeloftu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u, Duri lafti goorjama namati taate nama nyaate ilmaani nama jalaa guurate jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.13",
            "verseOrgIds": [
              "EZK.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo armaa achi lafti deebite goorjama taate ilmaani teesani inguuratu. Nami dubbi tana jed'e ana, AABBO Waaqa gudda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.14",
            "verseOrgIds": [
              "EZK.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti deebite gosa isi goyeesitufi nama isi miid'u inch'aqaftu lafti deebite ilmaani nama jalaa inguuratu. Nami dubbi tana jed'e ana, AABBO Waaqa gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Finna haareesa worri Israeli fidamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.16",
            "verseOrgIds": [
              "EZK.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, gaafa worri Israeli lafa ufi keesa tau kaani, worri woma taheeni lafa ufi t'ureese. Anini ammalle worra suni jibbe, worri niiti aada uwa qabdu, ta qulqullo intahini nati fakaate. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.17",
            "verseOrgIds": [
              "EZK.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan worri lafa suni keesati nama fit'e Waaqa harkaani boch'ani kad'ateefi, anini worrati dallane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.18",
            "verseOrgIds": [
              "EZK.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini finna worra kana jibbe lafa gosa d'ibi keesati worra firfirse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.19",
            "verseOrgIds": [
              "EZK.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri fulla yau ch'ufati maqa kiyya qulqullo balleese; wonti akanatiifi nami worra argu ch'ufti waan jed'u, worri kunini gumi AABBO Waaqati, ammo lafa inni kenneefi suni keesumaa baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan worri Israeli fulla deemu ch'ufati maqa kiyya qulqullo yakeefi, garaani na hammaate.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi amma tana waan atini worra Israelitini jettu, AABBO Waaqi guddaani waan jed'u, anini waan amma tolchu kana isani worra Israeliti jed'e intolchu, ammo maro maqa kiyya, ka isani fulla yaatani ch'ufati balleesitanifi, tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo anini gosa ch'ufa qulqullooma maqa kiyya jaba, isani nama ch'ufa durati balleesitani kana garsiisu — worri hojja suni aka anini AABBO Waaqa beekha. Nami dubbi tana jed'e ana, AABBO Waaqa gudda. Anini isaniini qulqullooma kiyya gosa ch'ufa garsiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.23",
            "verseOrgIds": [
              "EZK.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini gosa ch'ufafi lafa ch'ufa keesaa wolti isani guure lafa teesaniti isani galcha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.24",
            "verseOrgIds": [
              "EZK.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini bisaani qullo isaniti fifit'e, akasiini waaqoota d'ara ka isani kad'atanifi waan hamtu isani ufiini t'ureesitani ch'ufa isani iraa qulqulleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.25",
            "verseOrgIds": [
              "EZK.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
