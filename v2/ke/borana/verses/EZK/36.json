            "number": "36",
            "style": "v",
            "sid": "EZK 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u, Anini ammalle kad'acha worra Israeli d'agaye, waan worri fed'u ch'ufa guutaafi: Anini worra daraarse deebanse aka hoola ree lafa ira dabarsa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.37",
            "verseOrgIds": [
              "EZK.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira amma bade ona tae kana akuma duri dira Yerusalemu hooliyeeni jila sorioti qalani guute, akasuma nami guuta. Duuba akasiini aka anini AABBO Waaqa beekhani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.38",
            "verseOrgIds": [
              "EZK.36.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bale lafele namaa",
          "type": "text"
        }
      ]
    }
