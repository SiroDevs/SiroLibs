        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.3",
            "verseOrgIds": [
              "EZK.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba namichi suni waan nani jed'e, Namicha laali, ch'aqasi, waan anini si agarsiisu kana ch'ufa aka dansaa hubad'i. Wonti armaani si d'ufanifi tana; duuba waan agartu ch'ufa worra Israeliti himi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.4",
            "verseOrgIds": [
              "EZK.40.4"
            ]
          }
        }
      ]
    },
