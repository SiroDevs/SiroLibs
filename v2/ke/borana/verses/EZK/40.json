        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.1"
              },
              "items": [
                {
                  "text": "Mul 11.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.15"
              },
              "items": [
                {
                  "text": "21.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni maneeni sunitini na d'iannaani, anini nama aka sibiila diima bibiliqu arge. Inni haada horogeetiifi ule woini biimani harkati qabate, balbala mana toko keesa eja.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.3",
            "verseOrgIds": [
              "EZK.40.3"
            ]
          }
        }
      ]
    },
