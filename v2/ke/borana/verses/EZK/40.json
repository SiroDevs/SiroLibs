                {
                  "text": "Mul 21.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "daayya keesa lafa Israeli na geese gaara d'eera ira na d'aabe. Anini ufi durati maneeni heddu dira fakaatu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.2",
            "verseOrgIds": [
              "EZK.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
