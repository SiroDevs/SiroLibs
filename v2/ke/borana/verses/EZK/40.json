          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani namichi ammalle fullo mirgatini na d'aqe. Inni fullo naabo suni biime, biimani isi qit'uma fullo naabo taani taate. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
