            "number": "36",
            "style": "v",
            "sid": "EZK 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma fullo taani, tunileeni d'iibufi kuta barreesanifi dinqaafi deresha gama ch'ufa qabdi. D'eerinni isii d'und'uma shantama, ballinni d'und'uma diddami shani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dinqi isii naabo alaati fuula deefata. Kuta karaati aantu ch'ufa waan aka meet'i irati boch'ani barreesani. Faano saddeetiti jira, ta balbala fullo sunitini oli korani.",
          "type": "text",
          "attrs": {
