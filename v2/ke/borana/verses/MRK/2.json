              "items": [
                {
                  "text": "1 Sam 21.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Isani waan Daudini duri gaafa isaafi jari isaa sagale d'abe beelae jennaani tolche insoomne? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.9"
              },
              "items": [
                {
                  "text": "Law 24.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni bara Abiatharini qaallicha gudda, Mana Waaqa seene qit'a Waaqa baasani nyaate, ka sila Seera gula qaalole male nami d'ibiini nyaachu himmalini; ammalle jara isa woliini jirule qoode. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan worraani jed'e, Sabato maro namatiifi mid'aasani male, nama maro Sabatotiifi inuumne. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi Ilmi Nama abba Sabatooti.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.28",
            "verseOrgIds": [
              "MRK.2.28"
            ]
          }
        }
