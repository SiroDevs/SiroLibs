                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini Jaarsi, gara Gayo ka anini guddo jaalad'u t'aafa.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
