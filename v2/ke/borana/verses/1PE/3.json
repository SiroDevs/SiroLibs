                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kol 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akasuma isani nad'eeni, d'iirsole teesani ch'eera, aka yo d'iirsoleeni gari dubbi Waaqa ind'ugefannele, adabi keesani Waaqati worra deebisu. Duuba ato isani nami tokoleeni woma injed'iini, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "worri adaba keesani dansaafi qulqullo arge maacha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tim 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mata filachafi faahi naqachafi woya naqatani keesati shoobu himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo mid'aagumti teesani ta garaa keesa tahinna, mid'aaguma lubbu laanafi obsa ta injaare; tunini Waaqa durati waan guddo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara kanaani nad'eeni duri ta Waaqa abdatte ufi mid'aasite, d'iirsole ufiiti ch'eerte. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Uum 18.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sarani duri akasi taate; isiini Abrahamu ch'eerte aka Abba ufi heregatte. Isani amma ijoolle isii taatani, yo waan dansa tolchitani woma insodaanne.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
