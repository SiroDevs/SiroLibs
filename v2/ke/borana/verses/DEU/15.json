              "DEU.15.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.35"
              },
              "items": [
                {
                  "text": "Law 25.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo dira lafa taatefu, ka AABBO Waaqi keesani isanii kennu tana keesa, gosa teesani keesaa deegi jiraate, garaa jabaatani, ufo taatani, qarqaaru indidina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo arja taha, haga inni fed'u gati kennaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganni gati nama lakisani ya d'aate jettani, waan hamtu hereddani, gati ind'owatiina. Heregi akasi hamaani suni qalbi teesani inseeniini. Yo isani gati d'owattani, inni AABBO Waaqati bohe, isani ch'ubbu keesa seentani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbi male garaa tokooni isaa kenna, duuba AABBO Waaqi waan isani tolchitani ch'ufa keesa isani eebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.11"
              },
              "items": [
                {
                  "text": "Mat 26.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.7"
              },
              "items": [
                {
                  "text": "Mar 14.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.8"
              },
              "items": [
                {
                  "text": "Yoh 12.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Deega haguma jirani lafa teesani keesa ind'abani; tanaafi anini amma qarqaara wo kennaafi isaniini jed'a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan tissele tolchani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
