              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18+HEB.12.19"
              },
              "items": [
                {
                  "text": "Ebr 12.18-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilmaani teesani iti hima, aka isani duri d'at'ani hunda gaara aarii dumansa d'osse bobai ibida waaqati eje jala ejaanjitani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.11",
            "verseOrgIds": [
              "DEU.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle aka AABBO Waaqi ibida keesa isaaniini dubbate, ammo ka isani, dubbi isaa male waan isa fakaata tokole inarginile ch'ufa iti hima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.12",
            "verseOrgIds": [
              "DEU.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.18"
              },
              "items": [
                {
                  "text": "Bah 31.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.28"
              },
              "items": [
                {
                  "text": "34.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.10"
              },
              "items": [
                {
                  "text": "Qab-Ser 9.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni aka isani wold'aqisa inni isani woliini tolfate kaani jabeesitani ya isaniti hime — isani Seera kud'annaani inni d'akha lamaani hahafalicha kaani irati t'aafe jabeesitani guutuu maltani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.13",
            "verseOrgIds": [
              "DEU.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.1"
              },
              "items": [
                {
                  "text": "Bah 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqati seera ch'ufa ka isani lafa isani amma fud'atani iti qubachu geetani tana keesati guutu maltani worra barsiisi naani jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka waan harkaani boch'ani kad'atani nama seerani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
