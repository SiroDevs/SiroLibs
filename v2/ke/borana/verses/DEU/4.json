                {
                  "text": "27.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aka isani waan boch'ani kad'attani d'iira yokhaani nad'eeni ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.16",
            "verseOrgIds": [
              "DEU.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
