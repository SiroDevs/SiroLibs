          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan garaani lafa ira loatifi qurt'umi, mid'aafatani ch'ubbu intolchine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.18",
            "verseOrgIds": [
              "DEU.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufi eegad'a aka ilaalacha keesa seentani waan gubbati gartani adu jia, yokhaani Urjiifa guddiftani kad'atani inhojanneefi. AABBO Waaqi keesani yayu waan kana biyya taani d'ibii kenne, aka worri kad'atu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.19",
            "verseOrgIds": [
              "DEU.4.19"
            ]
          }
        },
