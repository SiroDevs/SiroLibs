          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.23"
              },
              "items": [
                {
                  "text": "Rum 1.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yokhaani bineensafi, simpirre, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.17",
            "verseOrgIds": [
              "DEU.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
