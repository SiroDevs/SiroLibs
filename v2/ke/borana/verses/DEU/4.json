              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16+EXO.19.17+EXO.19.18"
              },
              "items": [
                {
                  "text": "Bah 19.16-18",
                  "type": "text"
