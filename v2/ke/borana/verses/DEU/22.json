        },
        {
          "text": "Yo nami niiti nama d'ibitini rafe, isaafi isiile ha ijeesaniti. Akanaani hameenna akasi duraa baatani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
