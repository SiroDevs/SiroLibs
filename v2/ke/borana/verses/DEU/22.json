        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja isani mana hareesa jaarratani gubba isaa woini marsa. Duuba yo nami iraa d'aqate duele isani inhaalatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
