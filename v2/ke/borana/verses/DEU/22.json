          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami intala qaraa nama d'ibi fuud'aa kennani dira keesati arge buufate, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "worra lachu ha dira keesaa alati baasani, d'akhaani d'aanani ijeesaniti. Wonti intala ijeesaniifi, waan isiini, ato dira keesa jirtu, ka nami d'aatu miju, iyyu diddefi. Ammalle wonti namicha ijeesaniifi, waan inni intala qaraa nami d'ibi fuud'aa kennani buufatefi. Akanaani hameenna akasi duraa baatani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
