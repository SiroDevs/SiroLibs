              "items": [
                {
                  "text": "Law 19.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oobru teesani ta zabibu mid'aani d'ibi iti inoobrina yo oobritani, mid'aani zabibutifi mid'aani kaani d'ibile nyaachu himmalle.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
