            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.37+NUM.15.38+NUM.15.39+NUM.15.40+NUM.15.41"
              },
              "items": [
                {
                  "text": "Hen 15.37-41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Woya isani uyifattani handaara moga afraaniti hod'a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
