          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua ilmi Nuni waan Musani harka ira kaye eebiseefi qarooma gudda argate.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        }
      ]
