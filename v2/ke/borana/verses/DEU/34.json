            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Tunini lafa anini Abrahamufi Isaaqofi Yakobooti kakhad'e, ilmaani teesaniti kenna jed'e. Anini ya sii agarsiise ammo atini achi ingeetu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
