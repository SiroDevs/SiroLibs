          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani diida Moabuti deeme, gaara Nebo, haga fiit'e gaaraa Pisga, ka dira Yerikotini ilaboru kore. Achiti AABBO Waaqi lafa ch'ufa isa agarsiise: lafa Gileadi haga dira Dani gama mirga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "lafa Naftali ch'ufa; lafa Efraimutifi ta Manase; lafa Yuda haga Baariini Gudda ila adu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lafa Yuda gama bita; ammalle diida Zoarifi Yeriko dira meet'iti eju. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
              "DEU.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
