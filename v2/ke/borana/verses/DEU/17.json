              },
              "items": [
                {
                  "text": "9.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni farda heddu inqabaatiini, yokhaani namale lafa Misiriti erge farda imbitatiini; wonti akanatiifi AABBO Waaqi qara, deebitani, achi ind'aqina ya isaniini jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
