              },
              "items": [
                {
                  "text": "1 Sam 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eegi isani lafa AABBO Waaqi keesani isani kennu fud'attani iti qubattani, nu hayyu aka gosa d'ibi feena jettani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama AABBO Waaqi keesani fohate fohattani hayyu tolfattani, nami sunini ha nama gosa teesani tahuti: keessuma hayyu intolfatina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.28"
              },
              "items": [
                {
                  "text": "1 Hay 10.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.16"
