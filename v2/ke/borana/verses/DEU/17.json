                }
              ]
            }
          ]
        },
        {
          "text": "Yo isani keesa, yokhaani dira keesani ka AABBO Waaqi isanii kenne keesa, nami d'iiratifi ka uwale, taanaani ka AABBO Waaqa durati daba tolche jiraate, ka ammalle waaqa d'ibi, yokhaani adu yokhaani jia yokhaani urji, ka anini qara seere, hojatte kad'ate akasiini wold'aqisa isaa ch'abse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2+DEU.17.3",
            "verseOrgIds": [
              "DEU.17.2",
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo dubbi akasi suni d'ageetani, aka dansaa qorad'a. Yo dubbini hamtuni akasi sunini, ka Israeli keesati taate, mirkama taate, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba nama waan hamtu suniini d'ufe dira keesaa baasa, d'akhaani d'aana ijeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
