              },
              "items": [
                {
                  "text": "Ebr 10.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo hojja nami lamafi sadi aka inni hameenna suni keesa jiru hime yo suni ch'alla isaa ijeesu malani; ammo dubbi nama toko gula isaa ijeesu himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Kor 5.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri qara isa hime sunini ha qara d'akhaani d'aanuti. Duuba akanaani hameenna akasi suni ufi keesaa baatfani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
