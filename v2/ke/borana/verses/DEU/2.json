        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
