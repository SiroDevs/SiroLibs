              "items": [
                {
                  "text": "Hen 21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nu kaane lafa aloo keesa qajeele galaana Diimati iti d'aabanne, akuma AABBO Waaqi nuuni jed'e, haga guyya heddu nu lafa gaareeni ta Edomu keesa godaanne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
