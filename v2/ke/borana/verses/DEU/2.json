            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi nu Moabu keesa dabarre, AABBO Waaqi waan nuuni jed'e Amma kaa, galaana Arnoni taaka. Anini Sioni, hayyu Amori, ka Heshboni jed'anifi lafa isale harka keesaniti kenna. Isaa had'a, lafa isaa fud'ad'a, iti qubad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arraa achi anini nama ch'ufa isani sodaachisa. Nami ch'ufti yo maqa keesani ka d'ahani d'agaye, mudame holata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli hayyicha Sioni jed'ani dabsate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini ergattu lafa aloo ta Kedemothi keesa hayyu Heshboni ka Sioni jed'ani d'aamsa nagaya kanaani erge waan jed'e: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa tante tana keesa, ka kara iraa ingore, qajeele dabarraa nu gad'iisi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu sagale nyaanufi bisaani d'unnule sii baamna. Wonti nu feenu lafa tante ta keesa dabarru ch'alla, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "haga nu galaana Yordani taakine lafa AABBO Waaqi nu kennuni baanuti. D'alooti Esau ka Edomu taufi worri Moabu ka Ari tauleeni ya lafa worraa keesa nu dabarse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hayyuuni Sioni jed'ani aka lafa isaa keesa dabarru nu gadi ind'iimne. Wonti akanatiifi AABBO Waaqi, keesani ya garaa isa jabeese, nama woi didu isa tolche, aka akasiini isa dabsanne lafa isaa fud'anne iti qubannu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan naani jed'e, Ilaali, anini yayu hayyu Sioni jed'anifi lafa isale isani durati irre d'owe, lafa isaa fud'ad'a, iti qubad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihonini nama isaa ka lola ch'ufa fud'ate, d'aatu dira Yahesa nu had'u d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo AABBO Waaqi keenna isaa harka keenna keesa kaye, nu isaafi ilmaani isaatiifi nama isaa ch'ufa hobaamne. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni dira ch'ufa qamne balleesine, ammalle nama ch'ufa, d'iira, nad'eeni, ijoollele ch'ufa hobaamne, nama tokole inhambimne. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu looni fud'anne dira saamne bombeesine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira worra ch'ufa AABBO Waaqi, keenna haga Aroeri ka afaani bale Arnoniti fuud'e, dira wod'aka, bale jirtu d'aabe, haga Gileadi ch'ufa nu dabsachiise. Diri tokoleeni ka naaboni isaa jabaatte nu ch'absu dad'amne injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nu lafa Amoriti yokhaani afaani galaana Yaboki yokhaani dira lafa gaareeni yokhaani lafa d'ibi ta AABBO Waaqi ind'aqina nuni jed'e tokole iti ind'iaanne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli hayyu Ogu dabsate",
          "type": "text"
        }
      ]
    }
