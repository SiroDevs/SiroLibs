      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi lafa AABBO Waaqi keesani isanii kennu fud'attani iti qubattani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Bah 23.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami keesani ch'ufti mid'aani qara inni muratu dadu keesa kaye, fulla AABBO Waaqi keesani fohate, ta iti kad'atani taani, ha geesuti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallicha guyya suni huji harkaa qabu gara isaa d'aqa waan jettani, Nu arra AABBO Waaqa keennati himna, aka lafa inni ababoota teennati kakhate fud'anne iti qubanne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi kaani dadu isani iraa fuud'e fulla sorio AABBO Waaqa iti baasani taani dura kaya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqa durati isani dubbi tana jettani: Ababooni keenna nama gogodaanu, ka gosa Arami, ka worra ufii fud'ate lafa Misiri keesa qubate tae. Worri gaafa achii d'aqe nama diqa, ammo eege gosa guddo irre qabdu tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Misiri waan hamtu nu tolche nu dabse tisse nu tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba nu AABBO Waaqa ababoota teennati bone, inni boha teenna d'agaye gaargalafi d'ibafi d'ipu teenna arge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni harka isaa jabaani lafa Misiri keesaa nuu baase, waan mamatiifi ka mamisa tolche, nama sodaachise mudamsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni arma lafa aananifi dammi aka lola yauni nu d'ufe nuu keenne. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi amma nu AABBO Waaqa mid'aani qara muranne bamanaafi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba dadu suni AABBO Waaqa dura kaya, isa kad'ad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan dansa AABBO Waaqi keesani isanifi worra keesaniti kenne jed'a galata deebisaafi: ammalle isanifi worra Lawitifi keessuma isaani keesa jirtuleeni woliini gammada.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
