              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami fulla ch'ufa d'ufe ch'ufti woini d'ufeefi — waan qarsifi worqiini mid'aasanifa, woya fa, miha lola fa, qumbifa fardaafi gaangele. Waan kana ganna ch'ufa akasuma d'ufaniini.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
