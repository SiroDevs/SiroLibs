                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.31"
              },
              "items": [
                {
                  "text": "Luk 11.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayyitiini lafa Sheba gura Solomoni d'ageete jennaani imaltu gara Yerusalemu d'ufte, dubbi jajabdu isa gaafatte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini namafi geejiba gaala hedu, ka qumbifi d'akhaaye ch'uch'ulut'ufi worqi muumme inqamne baatu woliini d'ufte. Isiini Solomonini woli arginaani waan garaa qabdu ch'ufa gaafate. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan isiini gaafate ch'ufa himeefi; wonti tokoleeni ka jajabaatte inni himu d'ad'abe injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyitiini Sheba qarooma Solomonitifi mana inni jaarelle ch'ufa agarte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini ammalle sagale isaani gololchanifi. Fulla hojattuuni isaa iti galtufi aka hojattuuni isaa hojattufi woya worri naqatufi hojattu guyya jila isa gololchitufi sorio inni Mana Waaqa keesati baasule ch'ufa agarte jennaani aka male mamte afaani qabate. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isiini waan hayyuuni jette, wonti kanke ka anini lafa tiyyati d'agaye, ka nafa keetitifi qaroomileeni ch'ufti waan jiraati! Amma tana d'ufe arge jennaani d'ugeefad'e male qara ind'ugeefanne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle wonti anini d'agaye diqo, qaroomafi duroomi kanke haga anini d'agaye ch'ufa guddo ira jira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nad'eeni tante akami milki qabdi, ta guyya ch'ufa sibira ejite qarooma kanke ch'aqaftu! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa kanke ha faarsani! Inni si maache hayyu Israeli si tolche. Waan inni haga jiru jireenna Israeli jaalateefi inni hayyu worraa si tolche, aka atini d'ugaani worra fide seerale jabeesitu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan d'ufteeni ch'ufa Solomonii kennite: Worqi haga kilo kuma afurifa, ammalle qumbifi d'akhaaye ch'uch'ulut'u muumme inqamne. Taka nami haga qumbi isiini kenniteefi suni inkennineefi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hobolooni Hiramu, ta lafa Ofiriti worqiini d'ufte, mukha woddeesa fakaatu tokofi d'akhaaye ch'ulut'uleeni d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomonini mukha suni dongora mana isaatiifi ka Waaqa tolche, ammalle kiraarifi waan sirbanini d'ibile tolche. Mukhi sunini guddo mimid'aaga, taka lafa sunini ind'umne yokhaani eegi sunile taka ingarre.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Solomonini waan hayyitiini Sheba isa kad'ate ch'ufa kenneefi, waan inni fed'i ufitiini kenneefi male. Jennaani isiifi hojattuuni isii lafa isaaniti galani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Durooma hayyu Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna ch'ufa Solomonini worqi kilo kuma diddami sadi argate. Tana malele inni damoosa worri bunat'u isaa baasufi Tirfi bunaqatifi gibira hayyooti lafa ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araftitifi worri gugurdaani lafa Israeli arda arda mohatu isa baasele argate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomonini wonte gugurdo d'ibba lama mid'aase, nafa isii ch'ufa worqi kilo torbatini duuche. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni wonte didiqo d'ibi d'ibba sadi mid'aase, nafa isii ch'ufa worqi kilo lamatini duuche. Duuba wonte tana ch'ufa mana inni jaare, ka Mana Badda Lebanoni jed'ani kaani, keesa naqe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ammalle barch'uma hayyu gudda toko mid'aase. Nafa isaa haga toko ilka arbaatini mid'aasani, kaani worqi dansaani mid'aasani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barch'uma suni faano jaa ta oliini korani qaba, ammalle faano suni ch'ufa gama lachu akheekha nyeench'a irati mid'aasani, duuba akheekhi nyeench'a suni ch'ufti wolti kud'ani lama. Barch'uma gama isaa ka duuba mata korma looni irati mid'aasani, ammalle barch'uma suni fulla d'aatu looni irati mid'aasani, ammalle barch'uma suni fulla d'aatu, ta harka ira keeyatani, gama lachu nyeench'a irati mid'aasani. Barch'uma hayyu ka akasi suni taka lafa d'ibi keesati imid'aasine.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19+1KI.10.20",
            "verseOrgIds": [
              "1KI.10.19",
              "1KI.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19+1KI.10.20",
            "verseOrgIds": [
              "1KI.10.19",
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muduununi Solomoni ch'ufti ta worqiti, ammalle mihi woini sooratani ka Mana Badda Lebanoni jed'ani kaani ke jiru ch'ufa worqi ch'allaani mid'aasani. Mihi suni tokole qarsiini imid'aasine, wonti akanatiifi bara Solomoni suni qarsi womatu indarani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hobolo heddu, ta lafa fago hobolo Hiramu woliini yaatu, qaba. Duuba hobolooni suni, hojja ganni sadi dabru, dachaate, worqifi qarsifi ilka arbaatifi jaldeesa gaaratifi qamaleeni d'ufti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Solomoni hayyu ch'ufa ira qalbiifi hori qaba, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba nami lafa keesa jiru ch'ufti guddo d'ufe qarooma Waaqi isaa kenne suni argu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
