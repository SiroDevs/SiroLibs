                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Qab-Ser 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gati bunaqa farda, ka Misirifi Kilikia d'ufu ch'ufa, hojattu hayyuuti harka qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle gati gaari fardi hirkisu ka Misiri d'ufule worrati harka qaba. Ammalle worri hayyoota Hitifi Shamu gaari fardi hirkisu iti gurgure; gaari fardi hirkisu toko qarsi d'ibba jaatiini gurgurani, farda toko qarsi d'ibbafi shantama.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
