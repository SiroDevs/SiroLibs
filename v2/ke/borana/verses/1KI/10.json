              },
              "items": [
                {
                  "text": "Qab-Ser 17.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafasi Yerusalemu keesa qarsiini lafa ira dabarte akuma d'akhati heregani, hind'eesale akuma mukha dambiti heregani, ka fulla ch'ufa jiru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
