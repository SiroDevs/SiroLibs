                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Solomonini ammalle miha Mana Waaqa, ka worqiini mid'aasani, mid'aase: Waan sorio irati baasani, mesa qit'a Waaqaa baasani ira kayani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        },
