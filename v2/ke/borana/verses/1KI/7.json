          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "muduunu, waan ifseeni d'aanfani, qori, waan hit'aana keesati aarsani, daboola ch'ile ibidatini fuud'ani; ammalle sibiila mikhikila balbala Fulla Fulla Ch'ufa Ira Qulqullootifi balbala alalle. Miha kana ch'ufa worqiini mid'aasani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
