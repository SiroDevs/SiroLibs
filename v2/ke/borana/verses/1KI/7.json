              },
              "items": [
                {
                  "text": "Bah 25.31-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "waan ifseeni ira ejaanjitu kud'ani, ta Fulla Fulla Ch'ufa Ira Qulqullo dura ejaanjitu, ta shani gama mirga ejite shanileeni gama bitaa ejitu: Daraara, ifse, qad'abe; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
