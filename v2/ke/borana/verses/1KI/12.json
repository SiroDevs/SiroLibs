            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33+LEV.23.34"
              },
              "items": [
                {
                  "text": "Law 23.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamuni guyya kud'ani shaneeso ka jia saddeeteeso, jila aka Yuda keesati tolfatani taani tolfate. Fulla sorio iti qalani ta Betheliti, inni sorio korma worqi kaanii baase, ammalle achiti qaalole fulla inni jaare suni hojattu tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle guyya kud'ani shaneeso ka jia saddeeteeso, guyya inumaani fohate kaani, inni Betheli d'aqe, fulla sorio irati baasani taaniti sorio baase jila inni worra Israeliti jed'e tolche taani tolfate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
