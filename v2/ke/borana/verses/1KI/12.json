    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamuuni Shekemu fulla worri Israeli ch'ufti aka isa hayyu tolchu wolti bahe d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.1",
            "verseOrgIds": [
              "1KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamuni, ilmi Nebati, ka qara lafa Misiriti hayyu Solomoni baqate, dubbi tana d'agaye jennaani Misiri ga deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.2",
            "verseOrgIds": [
              "1KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Israeli sunini isa yaame, gara Rehoboamu woliini d'aqani waan jed'aniini, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.3",
            "verseOrgIds": [
              "1KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaani kanke nu dabse ulfinna jaba nura kaye. Hojja atini ulfinna suni nuraa Sablifte finna dansaani nuu d'ufte, nu aka dansaa si gula yaana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.4",
            "verseOrgIds": [
              "1KI.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.4",
            "verseOrgIds": [
              "1KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Sadi bula, gadi dachaa. Jennaani worri kae yae.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.5",
            "verseOrgIds": [
              "1KI.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.5",
            "verseOrgIds": [
              "1KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyu Rehoboamuuni jaarole abba isaati mala d'ooftu dubbi suni gaafate waan jed'eeni, Mala d'aa, dubbi anini worra kanaani jechu male nati hima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.6",
            "verseOrgIds": [
              "1KI.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.6",
            "verseOrgIds": [
              "1KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan jed'eeni, Yo atini arra aka dansaa worra kana hojachu feete, worra dubbi dansa iti dubbad'i, duuba worri haga jiru jireenna aka dansaa sii hojata.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.7",
            "verseOrgIds": [
              "1KI.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.7",
            "verseOrgIds": [
              "1KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni mala jaarole suni dide, dubbi suni hariya isaatini gahe, mala na d'aa waan anini worra, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.8",
            "verseOrgIds": [
              "1KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulfinna nuraa fuud'i nani jed'u kana jed'uuni nati hima jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.9",
            "verseOrgIds": [
              "1KI.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.9",
            "verseOrgIds": [
              "1KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri hariya isaa sunini waan jed'eeni, Wonti atini worraani jechu malte tana: qubi kiyya diqani hid'aana abba kiyya ira furda! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.10",
            "verseOrgIds": [
              "1KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worraani jettu, Abbaani kiyya ulfinna gudda isani ira kaye, ammo anini hagasi irale isaniti guddisa. Inni lichooni isani d'aane ammo anini ogoraani isani d'aana!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.11",
            "verseOrgIds": [
              "1KI.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.11",
            "verseOrgIds": [
              "1KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultiini sadeeni taani hobaate jennaani Yeroboamufi gumiini taani ch'ufti akuma Rehoboamuuni jed'eeni kaani isati d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.12",
            "verseOrgIds": [
              "1KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi mala jaarole taani dide, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.13",
            "verseOrgIds": [
              "1KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala hariya isaa kaani gula bahe, dubbi jajabdu worrati dubbate waan jed'eeni, Abbaani kiyya ulfinna gudda isani ira kaye, ammo anini hagasi irale isaniti guddisa. Inni lichooni isani d'aane, ammo anini ogoraani isani d'aana! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.14",
            "verseOrgIds": [
              "1KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBUMA Waaqati hayyicha biyya ch'aqasu d'owe, aka akasiini dubbini inni raaga Ahiya jed'aniini Yeroboamu ilma Nebatiti himi jed'e guutamtu. (Raagi suni nama Shiloti.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        }
      ]
    },
