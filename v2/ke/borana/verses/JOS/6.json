  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOS 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fullo Yeriko keesafi alallee ch'ufa hid'ani jabeesani eegani aka worri Israeli inseene. Nami tokoleeni ka seene yokhaani bahu injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.1",
            "verseOrgIds": [
              "JOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Yoshuani jed'e, Anini dira Yerikotifi hayyufi askarti isaa jajannale harka kanketiti kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.2",
            "verseOrgIds": [
              "JOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siifi askartini tante guyya ch'ufa maro toko, haga guyya jaa, dira kana ira mara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.3",
            "verseOrgIds": [
              "JOS.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleeni torba ta magalataani yaatu ha Sanduqa Wold'aqisa dura yaatu. Guyya torbeeso, ato qaaloleeni magalata suni d'ooftu, siifi askartini tante maro torba dira ira mara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.4",
            "verseOrgIds": [
              "JOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba hojja magalata suni ka guddisani d'aani d'ageetani, nami ch'ufti ha lalabe iyyuuti. Duuba naaboni dira suni ch'ach'abde qaqarite, askartini ch'ufti hojuma suni dira seenti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.5",
            "verseOrgIds": [
              "JOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoshuani ilmi Nuni, qaalole wolti yaame waan jed'eeni, Sanduqa Wold'aqisa fuud'a, isani nami torba magalata fuud'a dura yaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.6",
            "verseOrgIds": [
              "JOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba waan inni biyyaani jed'e, Beena yaa, dira ira mara, worri lola ha Sanduqa Wold'aqisa AABBO Waaqa dura dabruti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.7",
            "verseOrgIds": [
              "JOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akuma Yoshuani biyyaani jed'e qaaloleeni torba ta magalataani yaatu Sanduqa Wold'aqisa AABBO Waaqa dura magalata d'aa yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.8",
            "verseOrgIds": [
              "JOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri lola yau qaalole magalata d'ooftu dura yae, askartini d'ibileeni Sanduqa suni eege yaate; haga kana ch'ufa magalati d'au illakimne. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.9",
            "verseOrgIds": [
              "JOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yoshuani qara waan biyyaani jed'e, Iniyyina dubbini tokoleeni afaani keesani keesaa imbahini, haga guyyaani anini iyya isaniini jed'u gahuti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.10",
            "verseOrgIds": [
              "JOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni biyya Sanduqa Wold'aqisa baatuni, maro toko dira mara jed'eeni worri mare dachae bule.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.11",
            "verseOrgIds": [
              "JOS.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoshuani ganama lafa kae, qaaloleleeni Sanduqa Wold'aqisa AABBO Waaqa olfuute. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.12",
            "verseOrgIds": [
              "JOS.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleeni torbaani taani, ta magalataani Sanduqa Wold'aqisa AABBO Waaqa dura yaatu magalata ufi d'aa dabarte. Ammalle askartini lola worra dura yaate, askartini d'ibileeni Sanduqa Wold'aqisa AABBO Waaqa eege yaate. Haga kana ch'ufa magalata inuma d'aani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.13",
            "verseOrgIds": [
              "JOS.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya lameesole maro torba dira ira marani bulti dachaani. Guyya jaa akanuma tolchani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.14",
            "verseOrgIds": [
              "JOS.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya torbeeso baraaqa lafaa kaani, akuma kaani dira ira marani, ammo guyya suni maro torba marani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.15",
            "verseOrgIds": [
              "JOS.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka maro torbeeso maru jirani qaaloleeni magalata d'oofte jennaani Yoshuani waan biyyaani jed'e, Iyya, AABBO Waaqi ya dira kana isanii kenne! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.16",
            "verseOrgIds": [
              "JOS.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dirafi waan keesa jira ch'ufa maro Waaqi jibbeefi balleesa. Sharmut'iti Rahabu jed'anifi nama mana isii keesa jiru ch'alla lakisa, waan isiini jara nu dooya ergine d'ossiteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.17",
            "verseOrgIds": [
              "JOS.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo waan balleesu malani tokole infud'atina. Yo fud'attani gaargalafi badi worra Israelitini d'uftani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.18",
            "verseOrgIds": [
              "JOS.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo waan qarsiifi worqifi sibiila diimafi guraachani mid'aasani ya AABBO Waaqa olkayani, ha fulla miha AABBO Waaqa olkayaniti olkayani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.19",
            "verseOrgIds": [
              "JOS.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.30"
              },
              "items": [
                {
                  "text": "Ebr 11.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani qaaloleeni magalata d'oofte, biyyiti akuma qonqo magalata suni d'ageeteni lalabde iyyite, naaboni dira suni ch'ach'abde qaqarite. Duuba askartini ch'ufti gaara korte, dira fud'atte. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goraade ufiitini worri nama dira suni keesa jiru ch'ufa fit'e diqaafi guddafi d'iiraafi nad'eenile. Ammalle worri looni, ree, harrele ch'ufa fit'e.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuani waan worra lamaani dooyaa yae kaaniini jed'e, Beena mana sharmut'iti isani d'ossite taani d'aqa, isiifi fiit'a isiile ch'ufa gafuud'a, akuma qara jettanini. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri yae, Rahabufi abbaafi haad'afi oboleyaani isiitiifi fiit'a isii ch'ufaani d'ufe. Worri nama isii ch'ufafi tissele worrale ch'ufa fuud'e d'aatu olla Israeliti qubsise. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri dira kaani ibida iti kae, waan keesa jira ch'ufa ka worqifi qarsiifi sibiila diimafi guraachani mid'aasani male ch'ufa gube. Ammo worqifi qarsiifi sibiila diimafi guraachale fulla miha AABBO Waaqa iti olkayaniti olkayani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.31"
              },
              "items": [
                {
                  "text": "Ebr 11.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo Yoshuani niiti sharmut'iti Rahabu jed'anifi fiit'a isiile ch'ufa lubbu baase, waan isiini worra dooyaa lamaani Yerikoti ergani kaani d'ossiteefi. (D'alooti isii haga arrale ch'ufa Israeli keesa taa.) ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.34"
              },
              "items": [
                {
                  "text": "1 Hay 16.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafasi Yoshuani seera gudda baase waan jed'e, Nama iti deebie dira Yeriko kana ammalle injaara jed'e, abaarsa Waaqati qabata. Nami yayaba dira kana jaare ilma ufi ka angafa d'abe, ka fullo jaarelleeni ilma ufi maand'icha d'aba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi Yoshua waan ch'ufa keesa qarqaare, gurri isaa lafa ch'ufa gahe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        }
      ]
