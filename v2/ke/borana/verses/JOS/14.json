              "JOS.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Hen 14.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya toko jari toko, ka gosa Yuda, Gilgaliti Yoshuati d'ufe. Worri sunini nami toko, ka Kalebu ilma Yefune jed'ani, ka gosa Kenizi waan isaani jed'e, Atini waan AABBO Waaqi Kadesh-Barneati, namicha Waaqa ka Musa jed'ani kaani waan kiyyafi kanke jed'eeni imbeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.1+NUM.13.2+NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15+NUM.13.16+NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30"
              },
              "items": [
                {
                  "text": "Hen 13.1-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafa hojattuuni AABBO Waaqa Musani Kadesh-Barnea keesa dooya lafa tanati na erge, ganni kiyya afurtama. Anini dubbi d'uga isatini deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gaafasi na woliini yae worra kenna sodaachise, ammo anini garaa tokooni AABBO Waaqa kiyyaa saalfad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.24"
              },
              "items": [
                {
                  "text": "Hen 14.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waan anini akasi tolcheefi, Musani naa kakhate aka anaafi ilmaani tiyya lafa anini gubba deeme ch'ufa d'aala argannu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo amma laali, haga AABBO Waaqi dubbi tana Musani jed'e asi ganna afurtami shaniiti. Gaafasi gaafa gochiti Israeli lafa aloo keesa godaantu, ammalle AABBO Waaqi akuma kakhate ya haga gaafasiiti lubbu na bulche. Amma laali ganni kiyya saddeetami shani, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini arrale akuma gaafa Musani na erge kaani jaba. Anini ammalle lolaafi waan ch'ufaleeti, akuma duri kaani jaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba amma lafa gaareeni ta gaafa anaafi jari wahela kiyya waan isii Musati himne, ta AABBO Waaqi naa kakhate naa kenni. Nu gaafasi ya siti himne, aka worri gugurdaani d'ed'eerani, gosa Anaki, dira gugurda naaboni jaarate keesa tau. Hegeri AABBO Waaqi na woliini jiraate akuma inni jed'e kaani, anini worra arti keesaa baasa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoshuani Kalebu ilma Yefune eebise, dira Hebroni d'aala kenneefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diri Hebroni haga arrale ka d'aloota Kalebu ilma Yefune ka gosa Keniziti, waan inni garaa tokooni AABBO Waaqa Israeliti saalfateefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tana durati dira Hebroni sunini Arba jed'ani. (Arbaani kunini namicha gudda toko ka gosa Anaki.) Duuba eegi suni lafti sunini nagaya argatte.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lafa gosa Yudati kennani",
          "type": "text"
        }
      ]
    }
  ],
