              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini d'aala lafa ta qaallicha Eleazari jed'anifi Yoshua ilma Nunitifi jaaroleeni worra Israeliti mataa, lafa Kanaani keesati worra Israeliti qoode. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.52+NUM.26.53+NUM.26.54+NUM.26.55+NUM.26.56"
              },
              "items": [
                {
                  "text": "Hen 26.52-56",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.13"
              },
              "items": [
                {
                  "text": "34.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akuma AABBO Waaqi Musani jed'e, lafa gosa sagalitifi gosa Manase ta haga gari ta Yordanini ila adu hit'aani argatani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Hen 32.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.14+NUM.34.15"
              },
              "items": [
                {
                  "text": "34.14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12+DEU.3.13+DEU.3.14+DEU.3.15+DEU.3.16+DEU.3.17"
              },
              "items": [
                {
                  "text": "Qab-Ser 3.12-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musani qara d'aala gosa lamaani taanifi gosa Manase ta gari ta Yordani gama jirtu, kenne; ammo gosa Lawiti d'aala tokole inkennineefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yusufu gosa lama, Manaseefi Efraimu. Musani gosa Lawiti lafa tokole d'aala inkennineefi ammo dirafi lafa horiini worraa, loonifi reeni ooltu, kenneefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli, akuma AABBO Waaqi Musani jed'e, lafa qoodate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka dira Hebroni Kalebu kennani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
