                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Yoshuani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Israelitini waan jettu, Dira jaa ka iti baqatani, ka anini Musani isaniti hime fohad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami danu nama ijeese dandae arti d'aqa, aka nama sila isa ijeese haalo baafatu baqatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni dandae dira kana tokoti baqate fulla fullo, ta jaaroleeni iti koratu d'aqe, waan tahe jaaroleeti hima. Duuba worri aka inni dira seenu ee jed'e, fulla inni tau kennaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo namichi isa ijeese haalo baafachu fed'u kaani barbaada isaa d'ufe, worri dira suni harka isaati isa kennu himalle. Wonti akanatiifi inni danu nama suni ijeese, worri taka wolind'amne. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni dira suni keesa taa haga dubbi isaa jaaroleeni qortuti, ammalle haga qaallichi guddaani gaafasi huji harkaa qabu duuti. Eegi suni namichi dandae dirafi worra isaa ka qara keesa baqateti gala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani galaana Yordani ilaboruti, dira Kadeshi, ka Galilaya, lafa gaareeni ta Naftali keesa, ammalle Shekemu, lafa gaareeni ta Efraimu keesa, Hebronile, lafa gaareeni ta Yuda keesa fohatani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle galaana Yordani ilaboru dirra lafa gamooji, ka Yerikoni ilaboru keesa, Beezeri ka lafa Reubeni keesa jiruufi Ramothi ka Gileadi lafa Gadi keesa jiruufi Golani ka Bashanile, ka lafa Manase keesa jiru fohatani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diri jaani kuni dira Israeliini fohate, aka worraafi keessumani worraleeni iti baqatu. Nami nama danu ijeese dandae achiti nama ijeechaa isa barbaadu duraa baha; haga dubbi isa jaaroleeni qortuti isa inijeesani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dira heddu gosa Lawiti kennani",
          "type": "text"
        }
      ]
    }
