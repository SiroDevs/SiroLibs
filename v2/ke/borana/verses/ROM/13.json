              },
              "items": [
                {
                  "text": "Luk 20.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maro waan kanatifi isani gibira baaftani; wonti akanatiifi jari wo fidu kunini, yo hojatu, Waaqaa hojachu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan worraa baasu malani baasa; damoosafi gibira baasa, guddinnaafi ulfinna worra ch'ufa agarsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Woljaalachu malani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
