                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Law 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Seeri, d'iirafi nad'eeni wolbarate garayu woliintolfatini: Nami inijeesiini; inhatiini; womayu ind'araiini jed'ufi ka d'ibiini ch'ufti seera oboleesa kanke aka ufi jaalatu jaalad'u jed'u keesa jira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami oboleesa ufi aka ufi jaalatu jaalatu wollaala iti intolchu. Yoosi, jaalalti seera ch'ufa guuti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana tolchu maltani, waan saati beetaniifi: hojjaani isani hiriiba keesaa kaatani ya geete. Hojjaani nu baafamnu ya haga qara nu d'ugefanne ira gadi d'iaatte. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani ya ala hobaani, lafti diquma imbariini. Waan dukana lakisu malle. Miha lola ka ifsa naqachu malle. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adaba dansaani deema, aka nama ifsa guyya keesa deemu. farso d'ugitiifi machifi, foko d'abaafi woldidiisafi qot'e lakimna. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo miha lola ka Aabbo Yeso Kristo keyad'a, adaba keesani ka daba, ka d'araa nafa keesani quufsu lakisa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    },
    {
