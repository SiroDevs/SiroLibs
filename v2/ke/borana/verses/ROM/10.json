              "items": [
                {
                  "text": "Far 19.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ammo woni anini gaafad'u, Worri dubbi d'uguma ind'ageenne? Laki, ya d'agayani, akuma t'aafiini jettu:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
