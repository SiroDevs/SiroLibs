                "loc": "PSA.44.22"
              },
              "items": [
                {
                  "text": "Far 44.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma t'aafiini jettu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
