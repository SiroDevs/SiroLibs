  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ROM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan maro d'ugefachatifi d'uga nu hereganiifi nu amma Waaqaani wolti nagaya qamna, maro Aabbo keenna Yeso Kristotiifi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ya d'ugefacha teennaani, eeba Waaqaatiini nuu d'ufe, ta nu amma keesa jiru tana. Nu maro abdi, aka guddinna Waaqa qoodannu qamnuufi gammanna! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keenna keesaleti ingammanna, waan nu aka gaargali obsaani d'ufu beennuufi; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "obsi amalani d'ufa, amali abdiini d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.4",
            "verseOrgIds": [
              "ROM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abdiini tunini nu inch'eersitu, waan Waaqi jaalala ufi Lubbu Qulqullooni garaa keenna keesa dambalaaseefi. Lubbuuni Qulqullooni suni qarqaarsa Waaqi nuu kenne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jaalati Waaqa duisa Kristo keesati mullatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa duri nu qarqaarsa inqamne, Kristoni maro worra dabaatiifi due, guyya Waaqi fohate. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.6",
            "verseOrgIds": [
              "ROM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan guddo d'ibaati, aki nami maro nama d'ugatiifi duu. Hegeri nami toko maro nama dansaatiifi ufi baase dua. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.7",
            "verseOrgIds": [
              "ROM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Waaqi ya jaalala ufi nu agarsiise; ato nu daba keesa jirru Kristoni nuu jed'e due! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.8",
            "verseOrgIds": [
              "ROM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan maro d'iiga isaatiifi d'uga nu hereganiifi hagasi ira dalansu Waaqa dura nu baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.9",
            "verseOrgIds": [
              "ROM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu duri nyaapa Waaqaati, ammo inni duisa Ilma ufitiini jaalaani nu tolfate. Amma nu jaalaani Waaqaati, tanaafi jireenni Kristo hagasi ira nu baasa! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.10",
            "verseOrgIds": [
              "ROM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana ch'allaaniti; nu maro Aabbo keenna Yeso Kristotiifi Waaqa keesa gammanna, ka amma jaalaani Waaqa nu tolche.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Adamutiifi Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.6"
              },
              "items": [
                {
                  "text": "Uum 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Dabi nama toko gula lafa seene, ammalle dabi isaa suni duisa lafaani d'ufe. Tanaafi duisi nama ch'ufa gahe, maro nami ch'ufti dabeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato seerale imbaasiini dabi lafa jira, ammo maro seeri injirreefi daba namati inheregani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo haga Adamutiifi haga Musa dooti nama ch'ufa mohate, worra seera Waaqa aka Adamuni ch'abse inch'absiinile mohate.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamuni fakeenna nama hegeri d'ufuuti. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri lamaani takaaniti; wonti akanatiifi toli Waaqa aka daba Adamu injiru. D'uguma nami hedduuni daba nama tokocha suni gula raawate. Ammo eebiti Waaqa hagasi ira jirti, ammalle toli inni nama heddu kennu, maro eeba nama toko Yeso Kristotiifi, hagasi ira jira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle tola Waaqaatiifi dabi nama woli imfakaatu. Eegi daba toko tolchani qorsumaani wollaala namati murtu d'ufte; ammo eegi daba heddu tolchani, dubbi qorani, wollaala inqabdu jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'uguma daba nama toko gula dabi nama mohate, maro nama sunitiifi, Ammo wonti nami toko Yeso Kristoni tolche hagasi ira jirti! Nami eeba Waaqaatiifi tola d'uga isaa argatu ch'ufti jiraate lafa mohata, maro Yeso Kristotiifi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi akuma daba nama toko gula wollaala nama ch'ufati murani, akasuma hujiini dansaani toko, ta nami toko tolche, nama ch'ufa baafte jireenna kennitiifi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.18",
            "verseOrgIds": [
              "ROM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma nami hedduuni maro wollaala nama tokotiifi nama daba tolchu tahe, akasuma nami hedduuni waan nami toko Waaqa ch'aqaseefi d'uga argata.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka daba heddeesaniifi Seeraani d'ufani, ammo fulla dabi iti heddate eebiti Waaqaleeni hagasi ira guddatte. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.20",
            "verseOrgIds": [
              "ROM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi akuma dabi maro duisatiifi nama mohate, akasuma eebiti Waaqaleeni maro d'ugatiifi nama mohatte maro Yeso Kristo Aabbo keennatiifi jireenna nuu kenniti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.21",
            "verseOrgIds": [
              "ROM.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jireenna haraa Kristo keesa",
          "type": "text"
        }
      ]
    }
  ],
