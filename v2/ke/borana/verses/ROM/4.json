          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.4+GEN.17.5+GEN.17.6"
              },
              "items": [
                {
                  "text": "Uum 17.4-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17+GEN.22.18"
              },
              "items": [
                {
                  "text": "22.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.29"
              },
              "items": [
                {
                  "text": "Gal 3.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waaqi Abrahamufi d'aloota isaati kakhate, Lafa ch'ufa sii kenna jed'eeni, Wonti kakhu tana kennaniifi waan Abrahamuuni Seera jabeeseeniti, ammo waan inni d'ugefannaani Waaqi d'uga heregeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yo waan Waaqi khakhate sila worra seera jabeese kennani, d'ugefachaani nama woma keesa injirtu, ammalle khakhuuni Waaqa woma imbaatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri dalansu Waaqaatiini d'ufa; ammo fulla Seeri injirre Seera ch'absitileeni injirtu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
