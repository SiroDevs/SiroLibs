            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Israeli, AABBO Waaqa keesaniti deebia, dabi keesani ya gufachiise isani buuse. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqati deebia, dubbi dansaani waan jettaniini, Ch'ubbu teenna ch'ufa nuu araarami, kad'acha teenna ch'ufa nuu d'agayi, duuba akuma qara jenne kaani si faarsina. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Ashuru dandae nu imbaasu, ammalle fardi lolaleeni dandae woma nuraa ind'owu. Nu iti deebine waan harka keennaani boch'ine waaqa jenne inkad'annu. Ee AABBO Waaqa, nami hiyyeeyiini naasu iraa argatu siuma.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi finna d'ibi Israelii kennu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubbi eegee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami qalbi qabu ha dubbi tana hubate, nami qaroleeni ha beekhuti. Karaani AABBO Waaqaa qajeela, nami qajeelani kara suni gula deema, ammo nami daba keesati gufata.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    }
