              "HOS.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.1+GEN.29.2+GEN.29.3+GEN.29.4+GEN.29.5+GEN.29.6+GEN.29.7+GEN.29.8+GEN.29.9+GEN.29.10+GEN.29.11+GEN.29.12+GEN.29.13+GEN.29.14+GEN.29.15+GEN.29.16+GEN.29.17+GEN.29.18+GEN.29.19+GEN.29.20"
              },
              "items": [
                {
                  "text": "Uum 29.1-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobooni lafa Mesopotamia baqate achiti nama d'ibii ree tisse, akasiini niiti fuud'e. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.50+EXO.12.51"
              },
              "items": [
                {
                  "text": "Bah 12.50-51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi raaga erge worra Israeli tissooma lafa Misiri keesaa baase tisse qorqorate. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli ya aka taka inargini AABBO Waaqa dallansiise; maro ch'ubbu sunitiifi duu malani. Waan worri isa ch'eerseefi, AABBO Waaqi worra gaargalcha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
            "verseOrgIds": [
              "HOS.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan taka tana worra Israeliti murani",
          "type": "text"
        }
      ]
    }
  ],
