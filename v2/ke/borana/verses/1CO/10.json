              "items": [
                {
                  "text": "Law 7.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gosa Israeli qaabad'a; worri waan sorio baasani nyaatu huji fulla sorio iti qalani inqoodata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
