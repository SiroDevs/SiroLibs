            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti kunini ch'ufti akheekha nuu taati, aka nu akuma worraa waan hamtu ind'araane, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.6"
              },
              "items": [
                {
                  "text": "Bah 32.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yokhaani aka nu akuma worraa waan harkaani boch'ani inkad'anne, akuma t'aafiini jettu, Biyyiti teteete nyaate d'udde kaate sirbite, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3+NUM.25.4+NUM.25.5+NUM.25.6+NUM.25.7+NUM.25.8+NUM.25.9+NUM.25.10+NUM.25.11+NUM.25.12+NUM.25.13+NUM.25.14+NUM.25.15+NUM.25.16+NUM.25.17+NUM.25.18"
              },
              "items": [
                {
                  "text": "Hen 25.1-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nu algalooma tolchu himmalle aka worri gari tolche, guyya tokooni nami kunki diddami sadii raawate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.5+NUM.21.6"
              },
              "items": [
                {
                  "text": "Hen 21.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aabbole lalaachu himmalle, aka worri nami gari tolche, duuba bofi ide worra balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.41+NUM.16.42+NUM.16.43+NUM.16.44+NUM.16.45+NUM.16.46+NUM.16.47+NUM.16.48+NUM.16.49"
              },
              "items": [
                {
                  "text": "Hen 16.41-49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yokhaani gungumu himmalle, aka worri nami gari tolche, duuba Malaikaani Dua worra balleesite.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        }
      ]
