              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba waan tolchitani ch'ufa, yo nyaattani d'uuddanile, maro guddinna Waaqaatiifi tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahudifi gosa d'ibiifi gumi Waaqaa ingufachiisina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma anini tolchu tolcha: waan tolchu ch'ufaani anini nama gammachiisu fed'a, waan dansooma tiyya inheregu, ammo dansooma nama ch'ufa herega, aka nami ch'ufti baafamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.33",
            "verseOrgIds": [
              "1CO.10.33"
            ]
          }
        }
      ]
