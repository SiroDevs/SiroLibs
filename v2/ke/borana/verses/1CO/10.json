          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.12"
              },
              "items": [
                {
                  "text": "1 Kor 6.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami gari, Wonti ch'ufti nu halaala jed'a; ammo wonti suni ch'ufti isanii dansaaniti. Wonti ch'ufti nu halaala jed'ani, ammo wonti ch'ufti inqarqaartu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami tokoleeni waan ufi ch'alla yaalu himmalle, ammo waan nama d'ibile yaalu male.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
