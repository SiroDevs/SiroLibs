              "items": [
                {
                  "text": "Fil 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma anini Kristo akeesu isanileeni na akeesa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
