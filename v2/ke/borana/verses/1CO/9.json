          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi anini fulla hobaatiiti utaala; anini aka nama wold'aanu ka tontomo woli ira ingorsine jira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.26",
            "verseOrgIds": [
