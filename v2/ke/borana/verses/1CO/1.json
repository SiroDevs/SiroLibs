            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaani kiyya Paulo, ka fed'i Waaqatiini yaamani aka ergattu Kristo Yeso tahu, ammalle oboleesa keenna Sosthene woliini jirra —",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        }
