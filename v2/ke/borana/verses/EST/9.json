  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani kud'ani sadeeso ka jia Adari jed'ani, ka seeri hayyu guutame nyaapi Yahudi sila worra dabsate mohatu geennaani, Yahudiini dubbi suni hanqifte, garagalte nyaapa ufii kaani dabsatte. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira lafa hayyichi Ahasueroni fidu ch'ufa keesa Yahudiini moga ufiti wolti baate, nama gosa worraa balleesu fed'u ch'ufa iti kaate haate. Fulla ch'ufa biyyiti worra sodaate, nami tokoleeni dura eju dad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gugurdaani ch'ufti, ka hayyu hojatu, jaallaba taanaani, makala taanaani, soda Mordekaiti jed'ani Yahudi qarqaarani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi lafa hayyuuni fidu ch'ufa keesa, aka Mordekaiini jabaate gurra baafate nama ch'ufa ira guddinna argate, aka dansaa beekhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yahudiini waan feete ch'ufa nyaapa ufii tolchite sheeftiini haate balleesite fitt'e.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira gudda Shushani ch'alla keesati Yahudiini nama d'ibba shani fitt'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra fit'ani suni keesa ilmaani d'iira ta Hamani, ilma Hamedatha, ka nyaapa Yahudi, kud'aniti jira: maqaani ilmaani suni kana: Parshandatha, Dalfoni, Aspatha, Poratha, Adalia, Aridatha, Parmashta, Arisai, Aridai, Waizatha. Ammo ha taatu, miha worraa tokole insaamne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7+EST.9.8+EST.9.9+EST.9.10",
            "verseOrgIds": [
              "EST.9.7",
              "EST.9.8",
              "EST.9.9",
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7+EST.9.8+EST.9.9+EST.9.10",
            "verseOrgIds": [
              "EST.9.7",
              "EST.9.8",
              "EST.9.9",
              "EST.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayyuma suni nama dira Susa keesati fit'ani haga isaa hayyuti himani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni Waan hayyiti Estani jed'e Yahudiini dira Susa ch'alla kesaati nami d'ibba shani fitt'e ilmaani d'iira kud'annani Hamanitini wolti. Yo atini seetu wori arda kaani d'ibi keesati waan tolche! Amma maan feeta? Waan feetu inargata. Waan d'ibi feetu nati himi, inargata.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estani waan jetteeni, Ee hayyicha, yo sii taate, Yahudiini dira Susa keesa jirtu ha borile waan arra tilchite kana tolchitu. Ammalle reefa ilmaani Hamani kud'annanille mukha irati fannisa jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennani hayyichi waan kana ch'ufa tolcha jed'e, dubbi suni dira Susa keesati lalabani. Reefa ilmaani Hamani kud'annani nama ch'ufa durati fafannisani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya kud'ani afreeso ka jia Adari jed'ani Yahudiini dira Susa wolti baate ammalle nama d'ibba sadi ka dira suni fitt'e. Ammo ha taatu waan tokole insaamne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahudiini lafa d'ibi hayyuuni fidu keesa jirtu wolti baate, nyaapa ufiraa d'owarte dabsatte, nama kuma torbatami shani, ka worra jibbe, fitt'e; ammo ha taatuti, miha worraa tokole insaamne. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani suni guyya kud'ani sadeeso ka jia Adari. Boriyya guyya kud'ani afreeso hafuura baafatani, wolti bahani gammadaani jila tolfatani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yahudiini dira Shushani keesa jirtu guyya kud'ani sadeesotiifi kud'ani afreeso had'iisa nyaapati wolti baate, guyya kud'ani shaneeso hafuura baafatte gammadaani jila tolfatte. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi Yahudiini dira didiqa keesa teetu guyya kud'ani afreeso, ka jia Adari jed'ani, qaabate jila tolfatte, guyya wo nyaatani sagale woli kennani tolfatti.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jila Puri jed'ani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaiini dubbi tana ch'ufa t'aafsise, tatabe gara Yahudi lafa hayyuuni fidu ch'ufa keesa, ta fagofi d'io jirtuleti erge, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'e, Jia Adardari, guyya kud'ani afreesotiifi ka kud'ani shaneesole qaabad'a, ganna ch'ufa keesa ooluma tolfad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani lamaani suni guyya Yahudiini nyaapa ufi dabsatte hobaafte; jii sunini qara jia laalalatiifi ufi jibbaata, ammo eege garagale jia gammadatiifi ka bad'aad'a tahe. Duuba waan jed'aniini, Guyya kana qaabad'a, wolti baha, sagale woli keenna, nyaad'a, gammada, hiyyeesale wo keenna. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yahudiini ch'ufti jecha Mordekai gula yaate, jilti suni aada ganna ch'ufa tolfatani worraa taate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.7"
              },
              "items": [
                {
                  "text": "Est 3.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hamaniini, ilma Hamedatha, ka gosa Agagi, nyaapa Yahudi, yayu hit'a buufate (ka Puri jed'ani), aka akasiini guyya Yahudi had'ani balleesani beekhu; inni sila aka worra ch'ufa fit'u malate, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo Estani gara hayyu d'at'e, hayyichileeni dubbi baase, dubbi suni t'aafani, akanaani Hamaniini duisa inni Yahudi malate ufi due — isaafi ilmaani isaale mukha irati fannisani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi guyya oolmaa lamaani suni Puri jed'ani, maqa Puri suni gula. Maro waan tatabe Mordekai keesa t'aafanifi ammalle maro waan worri tahe ch'ufatiifi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahudiini aada baafte ta ijoolle isiitiifi nami isiiti galuleeni gula deemu, aka yo ayyaani suni mare ganna ch'ufa, guyya lamaani kaani qaabatani, jecha Mordekai gula. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti worri wolti buufate, aka worri Yahudi ch'ufti, d'alooti worraa ka d'ufuleeni, lafa ch'ufafi dira ch'ufa keesati, guyya Puri jed'ani suni qaabate, guyya jaba haga jiru jireenna tolfatu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
    },
