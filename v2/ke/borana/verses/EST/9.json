            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatabe suni gara Yahudi ta lafa d'ibba tokotifi diddami torba, ta hayyichi fidu keesa jirtuti ergani. Tatabeeni suni ta d'aamsa nagayatiifi bultuma Yahudi qabdu, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle isiini waan jettu, Isanifi ijoolleeni teesani guyya mara ayyaana Puri suni qaabad'a, akuma isani guyya ufi agabsani yokhaani guyya boha qaabatani. Dubbi tana Mordekaifi hayyiti Estati, Tolcha jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
