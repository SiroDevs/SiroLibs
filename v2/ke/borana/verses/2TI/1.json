              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaani kiyya Paulo, anini fed'i Waaqa gula ergatta Yeso Kristoti, isati na erge, aka anini jireenna maro Yeso Kristotitiifi nuu kakhatani odeesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
