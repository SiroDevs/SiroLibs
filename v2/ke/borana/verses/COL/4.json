              "type": "text"
            }
          ]
        },
        {
          "text": " Qalbefad'a, worra d'ugefacha inqamne dura adabaani yaa, qoomni argattani ch'ufa imballeesina, woiini tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo hasooftani dubbi dansa miooftu hasaa. Ammalle nama woi isani gaafate qajeelcha deebisaafi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
