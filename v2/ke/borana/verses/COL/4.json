              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan huji inni isanii hojate isaniti himu indandaa, ta gumi Laodikiafi Hierapolile. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
