              "items": [
                {
                  "text": "Film 10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onesimoni, oboleesa keenna ka d'uga ka gumi teesani keesa jiru, wahela isaati. Waan nu keesa jirru ch'ufa worrati isaniti odeesa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
