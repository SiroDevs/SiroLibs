          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni ka Yusto jed'anileeni nagaya d'aama. Worri Yahudi ka d'ugefate, ka Finna Waaqati jed'e nu woliini hojatu jara kana ch'alla; worri guddo na qarqaare.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
