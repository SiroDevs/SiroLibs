        },
        {
          "text": " Oboleesi keenna Tikikoni, ka aka dansa ufi baase huji Aabbo na woliini hojate odu tiyya ch'ufa isaniti odeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi anini isa gara keesani erga, aka inni waan nu keesa jirru isaniti hime isani gammachiisu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
