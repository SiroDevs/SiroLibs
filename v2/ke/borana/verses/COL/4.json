        },
        {
          "text": "Hojja ch'ufa kad'ad'a, indad'abiina, ilaafiina, Waaqaa galata deebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
            ]
          }
        },
        {
