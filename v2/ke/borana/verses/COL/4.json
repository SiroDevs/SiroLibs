            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nule Waaqa kad'ad'a, aka inni balbala nu bane nu dubbi isaa odeesine waan d'ossa Kristo himnu. Maro waan sunitiifi anini hid'aansa keesa jira. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa kad'ad'a, aka anini kara qajeelaani odeese nami hubatu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        }
      ]
