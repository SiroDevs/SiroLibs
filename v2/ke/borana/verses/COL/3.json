              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan tolchitani ch'ufa keesa garaa tokooni tolcha, aka waan nama inhojanne ammo Aabbo hojattani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
