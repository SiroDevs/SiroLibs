        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
