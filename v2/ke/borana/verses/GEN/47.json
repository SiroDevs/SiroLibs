              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gochiti Israeli lafa Misiri arda Gosheni keesa teete achiti horte daraarte ilmaani heddu d'alte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni lafa Misiri keesa ganna kud'ani torba tae, duuba akanaani ganna d'ibbafi afurtami torba guute. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
