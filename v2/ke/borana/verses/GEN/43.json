    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 43:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.28",
            "verseOrgIds": [
              "GEN.43.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 43:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufuuni oboleesa isaa Benjamini, ka isaani garaa, arge jennaani waan jed'e, Ila, gurbaani isani baantani, ka oboleesa keesani kaani, kana? Waaqi si eebisinna, gurba kiyya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.29",
            "verseOrgIds": [
              "GEN.43.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 43:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasi jed'e jennaani maro oboleesa isaatiifi onneeni laafte bohu fed'e, worra biraa deeme dinqa olseene bohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.30",
            "verseOrgIds": [
              "GEN.43.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 43:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani fuula d'iqate gabahe ufi d'owe, Sagale nuu baasa jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.31",
            "verseOrgIds": [
              "GEN.43.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 43:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu sagale kobaa baasani, oboleyaani isaale akasuma kobaa baasani, worra Misirile, ka achiti nyaatu kobaa baasani, wonti akanatiifi worri Misiri worra Ebraniatini woliini nyaachaani worraa falfala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.32",
            "verseOrgIds": [
              "GEN.43.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 43:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboleyaani Yusufu isati fuula deebisani tetesisani, akuma isiini d'aloota wolti aantuuni. Akasi argani jennaani woli mimilatani mamani maadefatani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.33",
            "verseOrgIds": [
              "GEN.43.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 43:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba sagale mesa Yusufuuni irati nyaatu iraa fuud'ani worra ch'ufaa kennani, ammo sagale Benjamini kennani ta worra kaani ira maro shani dabarsani. Duuba nyaatani d'ugani quufani, Yusufu woliini gammadani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.34",
            "verseOrgIds": [
              "GEN.43.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muduunu d'abani",
          "type": "text"
        }
      ]
    }
