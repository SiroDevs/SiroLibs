          ]
        },
        {
          "text": "Jennaani AABBO Waaqi maruma toko ibidaafi dillo aka ibida bobeetu Sodomafi Gomora gubbati roobe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan dira lamaani suni ke jirafi ka bale ke jirale ch'ufa, nama taanaani, mukha taanaani, ch'ufa balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.32"
              },
              "items": [
                {
                  "text": "Luk 17.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo niitiini Lutu ufi duuba millatte, akanumati kooba soodaa taate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyya diirama Abrahamuuni kae fulla inni Waaqa iti arge taani d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gara lafa Sodomafi Gomoratiifi bale lafa suni ch'ufa millate jennaani aara gudda lafa suni keesaa kau, ka aka aara boola ibida keesaa bahu fakaatu, arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa Waaqi lafa Sodomafi Gomora balleese suni, inni Abrahamu qaabate Lutule nagayaani achi keesaa baase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aloota Moabutiifi Amoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lutuuni Zoari keesa tau sodaate, isaafi dubrati isaa lamaani goda gaarati galani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalti isaa guddooni waan diqooni jette, Abbaani keenna ya jaare, d'iirti tokoleeni lafa keesa injirtu, ta nu fuute nu ira ilme argannu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kooti, aabbo daad'i kennineefi macheesine bira ramna, aka ilme isaani argannu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani suni worri abba daad'i obaase, inni machae jennaani intalti guddooni bira rafte. Ammo abbaani guddo machae waan suni beekachu dad'abe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyya intalti guddooni waan diqooni jette, Edda ani isa bira bule, kooti, arrale imacheesina, aka atini eddanna bira bultu. Akanaani inni nu lachu ijoolle ira d'ala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma kaani daad'iini macheesani, ka inni imbeenne intalti maand'aleeni bira bulte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani dubra lachu abbaani garaacheese. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalti guddooni ilma d'alte maqa Moabu baafteefi. Inni abba gosa amma tana Moabu jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalti maand'aleeni ilma d'alte maqa Benami baafteefi. Inni abba gosa amma tana Amoni jed'ani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abrahamufi Abimeleki",
          "type": "text"
        }
      ]
