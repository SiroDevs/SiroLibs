                  "text": "Jal 13.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobooni waan jed'e, Amma maqa kee nati himi. Ammo namichi, Maafi maqa kiyya beekhu feeta? jed'e, eege Yakobo eebise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
