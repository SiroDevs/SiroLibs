          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni fulla suni Penieli maqa baase waan jed'e, Ya Waaqaani fuula keesa wolargine iraa hafe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aduuni banaani Yakobooni, ka tafa hokolu, Penieli keesaa bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga arrale gochiti Israeli fooni tafa inyaattu, waan fulla suni Yakobo d'aanifi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
      ]
