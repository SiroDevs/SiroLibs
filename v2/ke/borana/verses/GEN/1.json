          "text": "Akanaani Waaqi fakeenna ufii gula nama uume. Inni nama uwafi nama d'iira uume ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "verse",
