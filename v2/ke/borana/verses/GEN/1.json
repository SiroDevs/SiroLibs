          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Waaqi waan jed'e, Anini mukha mid'aani killetiifi ka mich'iraani qabuufi ka inqamnele ch'ufa ya isanii kenne, nyaad'a quufa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
