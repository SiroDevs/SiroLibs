              "type": "text"
            }
          ]
        },
        {
          "text": "eebiseefi waan jed'eeni, Ilmaani hora, lafa guuta fida, ammalle qurt'umi baariinitifi waan gubbaa barisatiifi waan lubbu qaba ka deemu ch'ufa mohad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        },
        {
