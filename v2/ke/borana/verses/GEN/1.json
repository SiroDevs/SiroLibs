          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo bineensa miilaani lafa ira yaufi ka gubbaa barisufi ka lafa ira lohuleeni, ka lubbu qabu ch'ufti ha marraani fidamu; duuba akuma suni taate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.30",
            "verseOrgIds": [
              "GEN.1.30"
            ]
          }
        },
        {
