        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Waaqi waan jed'e, Bisaani waan lubbu qaba heddu ha d'alani; simpirreleeni ha gubba qilleensa keesa bariftu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani Waaqi bineensa gugurdafi didiqa ka bisaani keesa galu, simpirre gosa ch'ufale woliini uume. Waaqi wonti kunini dansa arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan kana ch'ufa eebise waan jed'e, Hora bula, baariini guuta; simpirreleeni, Hora, lafa ira dabra jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani galgali tahe diiramileeni tahe; kunini guyya shaneeso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
