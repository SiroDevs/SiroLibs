    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi ganni lama dabre, Faraoni oobjate, oobju suni keesati aka d'aatu galaana Nile eju ufi arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.1",
            "verseOrgIds": [
              "GEN.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba looni gagabbooni mimid'aagooni torba galaana keesaa bahani d'aatu d'eedani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.2",
            "verseOrgIds": [
              "GEN.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani looni torba d'ibileeni haaluuni goblooli, galaana keesaa bahani looni gagabbo kaani bira afaani galaana ejaanjani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.3",
            "verseOrgIds": [
              "GEN.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looni haaluuni suni looni gagabbo kaani nyaatani hobaasani. Eegi suni Faraoni damaqe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.4",
            "verseOrgIds": [
              "GEN.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle iriibati deebie maro lameeso oobjate mid'aani toko ka mata torba qaba, ka ch'ufti mid'aani ilaa bilchaato qaba arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.5",
            "verseOrgIds": [
              "GEN.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani mataani torba d'ibiini qaqallaani, ka bubbeeni owituuni lafa alooti d'ufte d'oofte gubde gadi bahe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.6",
            "verseOrgIds": [
              "GEN.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mataani qaqallaani kaani, ka ila qabu, mimid'aago kaani liqimse. Hayyuuni damaqe, aka wonti sunini ch'ufti oobju arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.7",
            "verseOrgIds": [
              "GEN.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.2"
              },
              "items": [
                {
                  "text": "Dan 2.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lafti bariinaani waan oobjate kaani d'ind'ise, worra wa himufi worra qaqaro, ka lafa Misiri keesa jiru, ch'ufa wolti yaame waan oobju ufii iti haasae, ammo nama waan isii himu d'abani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani gololchituuni daad'i kaani waan Faraoni jed'e, Arra wollaala kiyya ya qaabad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.9",
            "verseOrgIds": [
              "GEN.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa atini naafi d'aabdu qit'ati dallante mana gudda askarti keesati nu hite, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.10",
            "verseOrgIds": [
              "GEN.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "halkani toko nu lachu oobjanne, oobjuuni teenna waan waan himte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.11",
            "verseOrgIds": [
              "GEN.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gurba kaima tokoti, ka gosa Ebrania, ka hojattu gudda askarti, gaafasi nu woliini jira; duuba oobju teenna iti himne jennaani waan isiini d'ooftu nuti hime. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.12",
            "verseOrgIds": [
              "GEN.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma inni hime suni taate; na huji tiyyati na deebisani, ammo d'aabdu qit'aa kaani mukhati fannisani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Faraoni nama erge, Yusufu hurrisa boola hid'aansa suni keesaa fuud'a, kootaani jed'e. Yusufuuni areeda haadate woya jijirate Farao dura d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.14",
            "verseOrgIds": [
              "GEN.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Faraoni waan jed'eeni, Anini oobju oobjad'e, ammo nama waan isiini d'ooftu nati himu d'abe; aka atini waan oobju himtu ya d'agaye, tanaafi si yaame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufuuni waan jed'eeni, Aabbo kiyya, anini himu indandau, ammo Waaqumati himaansa dansa sii kenna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Faraoni waan jed'eeni, Ani oobjad'e, oobju tiyya keesa d'aatu galaana Nile eja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.17",
            "verseOrgIds": [
              "GEN.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ani jed'e, looni torba gagabbooni mimid'aagooni galaana keesaa bahani afaani galaana d'eedani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.18",
            "verseOrgIds": [
              "GEN.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani looni torba d'ibiini haaluuni goblooli, ka ani taka lafa Misiri keesati inargini, faana kaani d'ufani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.19",
            "verseOrgIds": [
              "GEN.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looni haaluuni kaani looni gagabbo kaani nyaatani hobaasani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.20",
            "verseOrgIds": [
              "GEN.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yo ani jed'e, akuma qara kaani huqo, woma iraa inhiinne, nami tokoleeni dandae, Looni kaani ya nyaatani injed'u. Jennaani damaqe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.21",
            "verseOrgIds": [
              "GEN.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle iriibati deebie maro lameeso oobjad'e, mid'aani toko ka mata torba qaba, ka ch'ufti mid'aani ilaa bilchaato qaba arge. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.22",
            "verseOrgIds": [
              "GEN.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani mataani torba d'ibiini qaqallaani, ka bubbeeni owituuni lafa alooti d'ufte d'oofte gubde, mid'aanuma kaani iraa bahe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.23",
            "verseOrgIds": [
              "GEN.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mataani qaqallaani kaani mid'aani ilaa bilchaato kaani liqimse. Oobju tana lachu worra wo himuti haasae, ammo tokoleeni waan isi nati himu dad'abe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufuuni waan Faraoni jed'e, Oobjuuni tante lachu waan taka himti; Waaqi ya waan tolchu fed'u si beesise. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.25",
            "verseOrgIds": [
              "GEN.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looni gagabbooni kaani torbaani ganna torba, mataani mid'aani ilaa torbaani kaanileeni ganna torba. Oobjuuni tunini woma taka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.26",
            "verseOrgIds": [
              "GEN.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looni haaluuni torbaani kaani, ka faana looni kaani d'ufanifi mataani qaqallaani torbaani bubbeeni owituuni lafa alooti d'ufte d'oofte gubde kaani ganna torba ka beela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.27",
            "verseOrgIds": [
              "GEN.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma anini siini jed'e kaani, Waaqi waan tolchu fed'u la si garsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.28",
            "verseOrgIds": [
              "GEN.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa Misiri keesa ganna torba ka quufa guddati d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.29",
            "verseOrgIds": [
              "GEN.41.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni ganna torba d'ibi ka beela, ka quufa sule ch'ufa nama deesisuti d'ufa. Beelti suni lafa balleesite ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.30",
            "verseOrgIds": [
              "GEN.41.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ganna quufa suni nama deesifti, waan beelti faana d'uftu sunini guddo hamtutiifi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.31",
            "verseOrgIds": [
              "GEN.41.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti oobjuuni tante lama taateefi, Waaqi ya waan kana mure buufate, d'iotu tolcha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma duuba nama qaro malticha fohad'i, finna lafa Misiri ch'ufa harka isaati deebisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.33",
            "verseOrgIds": [
              "GEN.41.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jara d'ibi ka isa jala hojatule tolchi, haga ganna torba ka lafti quufa qabdu, mid'aani argatani keesa, kintaala shani keesaa, toko olkayi jed'iini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.34",
            "verseOrgIds": [
              "GEN.41.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 41:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mid'aani ganna quufa ka gad'ufu kana dira ch'ufa keesati wolti guura, fulla tokoti jabeesa olkaya, badi d'owa jed'iini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.35",
            "verseOrgIds": [
              "GEN.41.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagaleeni olkayani suni, gaafa ganni torbaani beela ka lafa Misiriti d'ufu, nama ch'ufa geete, akanaani biyya sila beelaani dootu duu d'owarti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yusufu gudda lafa Misiri tolchani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 41:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mali Yusufuuni d'aefi kunini Faraofi hojattu isaa quubse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.37",
            "verseOrgIds": [
              "GEN.41.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 41:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraoni waan jed'eeni, D'iiro, nama Yusufu ira jiru, ka lubbuuni Waaqaa ke jirtu, inarganna? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.38",
            "verseOrgIds": [
              "GEN.41.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 41:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Faraoni waan Yusufuuni jed'e, Eegi Waaqi waan kana ch'ufa si garsiise, nami tokoleeni ka aka kanke malafi qaroomale qabu injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.39",
            "verseOrgIds": [
              "GEN.41.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.10"
              },
              "items": [
                {
                  "text": "Huji 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini gudda lafa tiyya ch'ufa sii tolche, nami kiyya ch'ufti si ch'aqasa. Ana male nami tokoleeni si dura injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 41:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma tana gudda lafa Misiri ch'ufa la si tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.41",
            "verseOrgIds": [
              "GEN.41.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 41:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.29"
              },
              "items": [
                {
                  "text": "Dan 5.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba Faraoni qube baafate quba Yusufuti kaye, woya boofta uyiseefi, looti worqi mormati kayeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.42",
            "verseOrgIds": [
              "GEN.41.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 41:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaari fardi hirkisu ka mid'aaguma ka hayyuti aanu kenneefi, nama isa dura yae lalabe, Duraa gora! Dura gora! jed'u tolcheefi. Akanaani Yusufuuni gudda lafa Misiri ch'ufa tolchani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.43",
            "verseOrgIds": [
              "GEN.41.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 41:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraoni waan jed'eeni, Anini hayyu lafa Misiri; nami tokoleeni waan atini inquufiini intolchu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.44",
            "verseOrgIds": [
              "GEN.41.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Yusufu maqa afaani Misiri Safenath-Panea baaseefi, ammalle intala Asenathi jed'ani, ta dubra Potifa qaallicha dira Oni, fuusise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45+GEN.41.46",
            "verseOrgIds": [
              "GEN.41.45",
              "GEN.41.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa Yusufuuni huji Farao seene ganni isaa sodoma. Duuba Farao biraa deeme arda Misiri ch'ufa keesa imaltu d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45+GEN.41.46",
            "verseOrgIds": [
              "GEN.41.45",
              "GEN.41.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 41:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa ganna torbaani quufaa kaani, lafti aka taka inargini mid'aani baafte; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.47",
            "verseOrgIds": [
              "GEN.41.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 41:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba Yusufuuni mid'aani suni ch'ufa wolti guure dira lafa suni ch'ufa keesati olkaye. Dira suni ch'ufa keesa inni mid'aani d'aatuti bahe olkaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.48",
            "verseOrgIds": [
              "GEN.41.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufuuni mid'aani haga inqamne, ka aka biyye tana, wolti guure, eegee hedule dad'abani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 41:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ganni beela ingahiinu niitiini Yusufu, ta Asenathi jed'ani taani, ijoolle lama d'alteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.50",
            "verseOrgIds": [
              "GEN.41.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 41:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni much'a angafa maqa Manase baase waan jed'e, Waaqi ya gaargala kiyyafi worra kiyya na deesise. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.51",
            "verseOrgIds": [
              "GEN.41.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka maand'a maqa Efraimu baaseefi waan jed'e, Waaqi ya lafa anini keesa gaargale keesati na daraarse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 41:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa Misiri keesati ganni torbaani quufaa kaani dabre, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 41:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.11"
              },
              "items": [
                {
                  "text": "Huji 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akuma Yusufuuni jed'e ganni torbaani beelaa kaani d'ufe. Lafa Misiri male lafti d'aatu taani ch'ufti beelaani badde. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 41:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.5"
              },
              "items": [
                {
                  "text": "Yoh 2.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eegee lafa Misirile beelti seente, duuba Farao d'aqani, Sagale nuu kenna jed'ani. Faraoni waan jed'eeni. Beena, gara Yusufu d'aqa, waan inni isani tolchu taha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "GEN 41:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beelti hammaatte lafa ch'ufa qabatte jennaani Yusufuuni mana mid'aani keesa olkayani kaani ch'ufa bane worra lafa Misiriti mid'aani gurgure. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "GEN 41:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro beelti guddo jabaatteefi, nami lafa ch'ufa keesa lafa Misirii d'ufe, aka sagale Yusufu iraa bitatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
            "verseOrgIds": [
              "GEN.41.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka oboleyaani Yusufu lafa Misiri mid'aani bitachu d'at'e",
          "type": "text"
        }
      ]
    }
