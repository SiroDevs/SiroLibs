                  "text": "Uum 1.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waaqi Nuhufi ilmaani isaati eebise waan jed'eeni, Hora bula, daraara, lafa ira dabra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi ch'uftinu, simpirre taanaani, qurt'umi taanaani, bineensa garaani lafa ira lohu taanaani ch'ufti harka kanke ke jira, si sodaata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan lubbu qaba ch'ufa, mukhaafi bineensale, ya sii kenne, aka isiini sagale sii taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
