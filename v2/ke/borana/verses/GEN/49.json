                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Achiti Abrahamufi niiti isaa Sara awaalani; achiti Isaaqofi niiti isaa Rebeka awaalani; ammalle artumati anileeni Lea awaale. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobrufi goda keesa jirule gosa Hiti iraa bitani; achumati na awaali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
