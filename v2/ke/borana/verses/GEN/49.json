              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri kunini gosa kud'ani lama ta Israeli; ammalle wonti abbaani worrani jed'e gaafa Nagayaati jed'e eebiseefi suni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
