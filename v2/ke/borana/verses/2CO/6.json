        },
        {
          "text": "Huji teenna ta nu Waaqa woliini hojannu keesati nu isani kad'anna: ya eeba Waaqa argattani, imballeesina. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
