                  "text": "Isa 49.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waan Waaqi jed'e ch'aqasa:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
