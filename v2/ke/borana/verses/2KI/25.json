                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Hay 7.23-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5"
              },
              "items": [
                {
                  "text": "2 Od-dur 4.2-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri Babiloni utuba sibiila diimani mid'aasanifi waan gaari fakaata ka Mana Waaqa keesa jiru ch'ufafi haro gingiti sibiila diimani mid'aasanile ch'ufa ch'abse, sibiila diima ch'ufa lafa Babiloniti geese. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.45"
              },
              "items": [
                {
                  "text": "1 Hay 7.45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Od-dur 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle worri daboolafi eele daara iti haranifi miha ifseeni qorqoratanifi qori d'iiga sorio iti naqanifi qori hit'aana iti aarsanifi miha Mana Waaqatini hojattani, ka sibiila diimani mid'aasani ch'ufa, itiini d'aabatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri waan worqifi qarsiini mid'aasanifi qori didiqofi daboolaa ch'ile ibidatini fuud'anile, ch'ufa fuud'ani itiini d'aabatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miha Solomonini sibiila diimani Mana Waaqaati mid'aase utuba lamaanifi waan aka gaari kaanifi haro gingitini taanile dandaani ulfinna isii imbiimani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utubaani lamaani haguma taka: old'eerinni isaa d'und'uma kud'ani saddeeti, ka kamu waan aka sure ta d'und'uma sadii sibiila diimani mid'aasani mata gubba kayani. Waan aka sure suni ch'ufa looti sibiila diimani mid'aasani marsani, waan aka okhoku ka sibiila diimani mid'aasanini ch'okhaani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worra Yuda Babiloni geesani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tana male Nebuzaradanini ka gudda askarti, qaallicha gudda Seraya jed'anifi, Sefania ka isati aanufi ammalle jara gugurda Mana Waaqa keesa hojattu, nama sadi qaqabe Babiloni geese. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira keesa, inni nama askarti ch'ufaa matatifi, nama shani ka makala hayyu, ka dira keesati hafefi namicha nama askartii matati aanu, ka waan askarti lafa suni ch'ufa t'aafufi ammalle nama jaatama d'ibi ka gurra qabu ch'ufa woliini qabe geese. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradanini, ka gudda askarti, worra kana ch'ufa guure, hayyu Babiloni, ka Ribla jiruti, geese. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiti lafa Hamathiti hayyicha worra d'aane lubbule fit'e. Duuba akanaani worra Yuda lafa worra keesaa boojiani lafa d'ibi geesani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gudda lafa Yuda ka Gedalia jed'ani",
          "type": "text"
        }
      ]
    },
