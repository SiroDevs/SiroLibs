                  "text": "Eze 24.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sedekiani hayyu Nebukadreza ka Babiloniti gargale jennaani, hayyu Nebukadrezani askarti isaa ch'ufaani d'ufe, guyya kud'anneeso ka jia kud'anneeso, ganna sagaleeso, ka Sedekiani lafa mohate keesa Yerusalemu had'u d'aqe, d'aatu isiiti qubate boola qote marseeni, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "haga ganna kud'ani tokeeso ka Sedekiani lafa mohate artuma tae had'e. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya sagaleeso, ka jia afreeso ka ganna suni, beelti dira suni keesati guddatte, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Eze 33.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami sagale nyaatule d'abe, naabo dira sunile ch'absani. Ato worri Babiloni dira suni marsele askartini ch'ufti halkaniini fullo naabo lamaani jiddu jirtu, ta d'aatu oobru hayyuutini baqatte gara bale Yordani iti d'aabatte. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo askartini Babiloni hayyu Sedekia reebde diida Yerikoti d'aqabde jennaani askartini isaa ch'ufti biraa baqatte. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isa qabani hayyu Babiloni ka Ribla jiruti geesani, achiti hayyu Nebukadrezani ijeecha iti mure. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Eze 12.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilmaani isaa ila isaa durati fit'ani isale ila keesa guurani sansalatani hid'ani Babiloni geesani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Mana Waaqa gubani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya torbeeso ka jia shaneeso, ganna kud'ani sagaleeso ka Nebukadrezani hayyu Babiloni lafa mohate Nebuzaradanini ka makala hayyu, ka ammalle inni gudda askarti isaa, Yerusalemu d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Mana Waaqatifi mana hayyuutifi maneeni nama gugurda ka Yerusalemu ch'ufa gube, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "askartini isaleeni naabo diraani marsani jaarani ch'ufa ch'ach'absite. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Nebuzaradani worra dira Yerusalemu keesati hafefi hogeeyiifi nama worra isaani lakise hayyu Babiloniti baqate fuud'e Babilonitini gale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni hiyyeeyi woma inqamne lafa Yudati lakise, aka worri zabibu tisse oobrule qotu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
