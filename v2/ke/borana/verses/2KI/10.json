            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehuni akuma sorio baaseni jara isaa kaani yaame waan jed'eeni, Olduuda, nama ch'ufa hobaasa, tokoleeni infiigini. Worri goraadeeni olduude, ch'ufa hobaase reefa alati guure. Jennaani worri fulla qulqullo mana suni olduude, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuba mana Baali ch'ufa guure alati gube. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.26",
            "verseOrgIds": [
              "2KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akanaani utuba qulqulloofi mana Baali suni balleesani, fulla iti udaanifi ta iti finch'aani tolchani, haga arrale akasuma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        }
      ]
