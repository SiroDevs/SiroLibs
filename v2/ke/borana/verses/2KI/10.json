          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi AABBO Waaqi aka lafa Israeli iraa kute diqeesu iti kae. Hazaelini, hayyuuni Shamu, lafa Israeli ch'ufa ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta galaana Yordanitini ilaboru, haga dira Aroeni ka d'aatu galaana Arnoni bitaa dabsate. Lafti sunini lafa Gileaditifi ta Bashani, fulla gochiti Gaditifi Reubenitifi ta Manase ta ilaboru teetu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
