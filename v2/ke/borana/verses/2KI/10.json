                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Hay 12.28-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo inni faana Yeroboamu bahe ch'ubbu inni worra Israeli keesa buuse, gaafa korma worqi mid'aase Bethelifi Dani keesa kaye tolche, ufile tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Yehuni jed'e, Atini waan anini tolchi sini jed'e ch'ufa yayu d'aloota Ahabu tolchite, tanaafi anini siti kakhad'a, aka d'alooti kanke haga d'aloota afreeso hayyu Israeli, tahu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yehuni Seera AABBO Waaqa Israeli guddo jabeese gula indeemne, fulla suni inni faana Yeroboamu, ka worra Israeli ch'ubbu keesa buuse, gula bahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
    {
