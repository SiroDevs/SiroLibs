          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Yehuni tolche ch'ufafi jannooma isaale kitaaba Odu Hayyoota Israeli keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
