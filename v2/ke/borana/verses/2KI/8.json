                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Hay 11.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ammo AABBO Waaqi worra Yuda balleesu dide; wonti akanatiifi inni duru hojattu isaa Dauditi kakhate, aka d'alooti isaa haguma jiru jireenna lafa Yuda mohatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
