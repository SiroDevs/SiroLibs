            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani AABBO Waaqi Eliya bubbeeni gubbati olfuud'u geennaani Eliyaafi Elishani Gilgali kaani yaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato worri yau Eliyaani waan Elishani jed'e, Abbo, atini asuma hafi, AABBO Waaqi ya Betheliti na erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Elishani waan jed'eeni, Anini maqa kanketifi ka AABBO Waaqatini kakhad'a, aka si jala inhamne. Jennaani worri Betheliti woliini iti d'aabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
