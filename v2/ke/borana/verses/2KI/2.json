          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani waan Elishani jed'e, Abbo, atini asuma hafi, AABBO Waaqi ya Yerikoti na erge. Ammo Elishani waan jed'eeni, Anini maqa kanketifi ka AABBO Waaqatini kakhad'a, aka si jala inhamne. Tanaafi worri kae Yerikoti woliini iti d'aabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
