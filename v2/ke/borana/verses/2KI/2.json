          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani waan Elishani jed'e, Aabbo, atini asuma hafi, AABBO Waaqi yayu galaana Yordaniti na erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
