            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini raagoota ta achi teetu, gara Elisha d'at'e waan jetteeni, Atini aka AABBO Waaqi arra abba kanke si bira fuud'u beeta?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
