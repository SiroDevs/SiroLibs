          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna sodomi sagaleeso ka Uziani lafa Yuda mohate, Shalumuni, ilmi Yabeshi, hayyu Israeli tahe, duuba jia toko Samaria keesa lafa mohate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemuni, ilmi Gadi, Tirsa bahe, Samaria d'aqe, Shalumu ijeese, fulla isaa hayyu tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Shalumuni tolche ch'ufafi mala inni hayyu kaaniini ijeesele ch'ufa kitaaba Odu Hayyoota Israeli keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Menahemuni Tirsa d'ufu jiru, inni dira Tapuatifi nama keesa jirufi lafa d'aatu isaa ch'ufa had'e balleese waan nami dira suni isati harka kennachu dideefi. Inni nad'eeni garaachale ch'ufa garaa babaqase.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
