              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna lameeso ka Pekani, ilmi Remalia hayyu Israeli tahe, Yothamuni, ilmi Uzia, hayyu Yuda tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
