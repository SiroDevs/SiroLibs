                  "text": "2 Hay 10.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Duuba akasiini wonti AABBO Waaqi duri hayyu Yehuti kakhate guutamte: d'alooti kanke haga d'aloota afreeso hayyu Israeli taha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
