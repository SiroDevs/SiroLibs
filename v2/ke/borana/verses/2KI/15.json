        {
          "text": "Ganna shantameeso ka Uziani hayyu Yuda tahe, Pekahiani, ilmi Menahemuni hayyu Israeli tahe, ganna lama Samaria keesa lafa mohate. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
