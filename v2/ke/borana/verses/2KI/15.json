          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni faana Yeroboamu, ilma Nabathi, ka worra Israeli ch'ubbu keesa buuse, gula bahe, AABBO Waaqa durati ch'ubbu tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
