          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi ganni isaa diddami shani, inni ganna kud'ani jaa Yerusalemu keesa lafa mohate. Haad'a isa maqaani Yerusha, isiini dubra Sadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
