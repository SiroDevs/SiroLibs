          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi gudda askarti Pekahia toko, ka maqaani isa Peka, ilma Remalia, nama shantama ka Gileaditini wolti malatani, fulla jajabdu mana hayyu ka Samaria keesati Pekahia ijeese, fulla isa Hayyu tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
