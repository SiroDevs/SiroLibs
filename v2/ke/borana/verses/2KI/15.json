              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Yothamuni tolche ch'ufa, kitaaba Odu Hayyoota Yuda keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
