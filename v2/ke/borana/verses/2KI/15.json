      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hayyu Israeli ka Shalumu jed'ani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
