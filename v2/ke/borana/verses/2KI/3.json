          ]
        },
        {
          "text": "Ammo worri fulla sunini bahe jennaani worri Israeli kae, worra had'e ufira deebise, reebuma reebe, worra hobaase, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
