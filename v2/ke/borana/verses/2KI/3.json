              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni Moabu aka dabsatani arginaani, nama d'ibba torba, ka goraade qabu, fuud'e, irreeni nyaapa isaa kaani keesa dabru fed'e, aka sila gara hayyu Shamuti baqatu, ammo indad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
