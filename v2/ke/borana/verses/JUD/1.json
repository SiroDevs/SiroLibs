              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasufi nagayafi jaalala guddisa argad'a!",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
          }
        }
