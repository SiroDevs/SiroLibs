                  "text": "Bah 12.51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ato isani waan kana ch'ufa aka dansa beetanile, anini aka Aabbooni gosa Israeli lafa Misiri keesaa baase, ammo eegi suni worra isa ind'ugefatiini ch'ufa balleese isani qaabsiisu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikoota fulla ufi lakifte fulla isi himmalini yaate qaabad'a. Waaqi worra ya haga jiru jireenna haada sibiilatiini dukana lafa jala keesati hid'e aka guyya jaba ka wollaala iti murani eegattu. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
