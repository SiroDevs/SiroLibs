              "JUD.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JUD 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra garaa lama qabuu naha: ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JUD 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibida keesaa worra baasa. Nama d'ibile ch'ufaa naha, ammo sodaad'a, woya dabi worra t'ureesele jibba.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
            "verseOrgIds": [
              "JUD.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kad'acha Waaqaani faarsani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
