          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Waaqa imbeenne ka baanani kunileeni akasuma taha, oobju keesa nafa ufiti dabe, jabeenna Waaqa tuffate, guddinna gubba ka jabeenna qabu arabse. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
