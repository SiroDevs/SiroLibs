                  "text": "12.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaikaani guddooni Mikaelileeni waan akana kana taka intolchine. Gaafa inni reefa Musa irati Sheet'anaani woldidani, Mikaelini Sheet'ana arabsu dide waan jed'eeni, Aabbooni si gorsinna! ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri kunini waan inhubanne arabsa, ammalle wonti worri aka bineensa suufe beekhu waan worra balleesa ch'alla. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
