                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Inni nafa ufi nuu kenne, aka hameenna ch'ufa keesaa nuu baase, gumi isaa qulqullo, ta waan dansa tolchu feetu nu tolchu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
