          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana nama barsiisi, jabeenna kanke ch'ufaani nama si ch'aqasu ch'ufa jabeesi, gorsi. Nami tokoleeni si intufatiini.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
