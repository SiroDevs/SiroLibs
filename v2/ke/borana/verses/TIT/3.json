                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo anini Artema yokhaani Tikiko siti ergu, jabaad'u, Nikopoliti nati kooti, anini ya aka haga bulti qabanna achi tau heregad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
