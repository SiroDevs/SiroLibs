            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli, aka Abimelekini due arginaani, kaani galani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
            "verseOrgIds": [
              "JDG.9.55"
