  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JDG 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri Israeli Waaqa durati waan hamtu tahe, duuba Waaqi ganna torba worra harka worra Midianiti kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Midiani sunini worra guddo irre worra Israeli ira qabu, tanaafi worri Israeli godaafi boola gaareeni keesati, fulla nyaapi nama ingareeti duraa d'okhate. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri Israeli mid'aani fach'aasu, worri Midianitifi ka Amalekitifi, ka ilaboru d'ufani worra had'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri lafa worra Israeli keesa qubate, mid'aani worra duraa balleese, haga dira Gazaa. Ammalle loonifi reefi harrele fud'atani, waan worri Israeli jiraatuni ch'ufa duraa fud'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri aka awaanisa loonifi waaro worraatini lafati baafate, gaali worraleeni lafa ira dabre toachu dad'abani. Duuba d'ufani lafa barbadesani, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle worri Israeli waan tahu d'abe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Israeli waan worri Midiani worra tolcheefi AABBO Waaqati bohe, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba inni raaga worraa erge, ka d'aamsa AABBO Waaqa Israeli hime waan jed'e. Anini lafa Misiri ta isani tisse iti taatani keesaa isani baase. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini harka worra Misiritiifi nama isani dabse ch'ufa keesaa isani baase, worra isani duraa gusse, lafa isaani isanii kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle anini waan isaniini jed'e, Anini AABBO Waaqa keesani; waaqoota worra Amori ka amma isani lafa isaani keesa teetani inkad'atiina. Ammo isani dubbi tiyya d'agayu diddani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani AABBO Waaqaa olla Ofrati d'ufte, mukha gudda toko ka Yoashi gosa Abiezeri, jala teete. Hojja suni ilma isaa Gideoni dargaye, fulla daad'i, iti mid'aasaniti d'ossaani d'aanuti jira, aka worri Midiani isaa inagarre. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani AABBO Waaqa fulla suniti isati d'ufte waan jetteeni, Atini namicha janna jaba, AABBO Waaqi si woliini jira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideonini waan jed'eeni, Aabbo Sila wo si gaafachu fed'a, yo d'uguma AABBO Waaqi nu woliini jiraate, wonti kunini ch'ufti maanifi nu d'aqabdi? Wonti mama ka duri inni abbooti teenna tolche, ka nu worra ira d'ageenne — aka inni worra lafa Misiri keesa baase meeti? AABBO Waaqi ya lafa nu buuse harka worra Midianiti nu lakise.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan jed'eeni, Jabeenna kanke Kanaani deemi, worra Israeli harka worra Midiani keesaa baasi, nami si ergu anuma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideonini waan jed'eeni, Aabbo, anini akami dandae worra Israeli baasa? Balbalti tiyya gosa Manase keesa laaftu, aninileeni worra keenna keesa nama maqa qabuniti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'eeni, Insodaatini, indandeeta, anumati si woliini jira. Atini worra Midiani yoosu balleesita, aka nama toko balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideonini waan jed'eeni, Yo atini d'uguma na jaalatte, akheekha anini siini d'ugeefad'u na agarsiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbo, armaa indeemini haga anini woini sii d'ufuti malaikaani taani waan jetteeni, Haga atini gadeebituti anini armuma taa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Gideonini mana ufi d'aqe, korbeesa diqa toko qale, dargaye kilo kud'ani ta daakhani bukho male qit'a d'aabe, fooni kaani dadu keesa kaye fuuto qoriti naqe, mukha gudda kaani jalati malaika AABBO Waaqati d'ufeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani waan jetteeni, Foonifi qit'a d'akha kana ira kayi, fuuto gubbati buusi. Gideonini akasuma tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani AABBO Waaqa harka d'eerefate fiit'e ule harka qabdutini foonifi qit'a kaani tut'e. Ibidi d'akha suni keesaa bahe foonifi qit'a kaani gube. Jennaani malaikaani ila isaa duraa badde.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Gideonini aka malaika AABBO Waaqa arge hubate, sodaate waan jed'e, Ee AABBO Waaqa gudda, anini malaika AABBO Waaqa ya iluma tiyyaani ufi birati arge!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo AABBO Waaqi waan jed'eeni, Naguma, insodaatini, aka d'ibi indootu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideonini waan sorio AABBO Waaqa irati baasani artiti jaare, Nageenni AABBO Waaqa jed'e maqa baaseefi (wonti sunini arrale olla Ofra, ka balbala Abiezeri, jirti). ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani suni AABBO Waaqi waan Gideonini jed'e, Korma abbeetitifi korma d'ibi, ka ganna torba, fuud'i, waan abbaani kanke waaqa Baali jed'ani sorio irati baasu ch'ach'absi. Akheekha waaqa Ashera jed'ani, ka d'aatu eju, ch'iri balleesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan sorio irati baasani, ka aka dansa mid'aasani, quqa kana irati Waaqaa jaari. Duuba korma lameeso fuud'i, ch'ufa gubi, Waaqaa baasi, akheekha Ashera ka atini ch'irte kaani qoraani tolchi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Gideonini hojattu ufi kud'ani fuud'e, waan AABBO Waaqi isani jed'e kaani tolche, ammo maro inni worra ufitifi nama dira suni sodaateefi, waan suni guyya tolchu dide halkani tolche.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri dira suni boriyyaa ganama lafaa kae jennaani waan sorio Baali irati baasanifi akheekha Asherale ch'ufa ka ch'ach'absani balleesani argani, ammalle korma lameeso ka waan sorio irati baasani, ka artiti jaarani suni, irati gubani argani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba wolgaafatani, Eenuti akana tolche? woliini jed'ani. Worri dubbi suni barbaade, aka Gideonini akasi tolche arge. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani waan Yoashini jed'ani, Ilma kanke gabaasi, inijeemna! Nami waan sorio Baali irati baasani ch'ach'abse, akheekha Ashera ka d'aatu jiru ch'ire isuma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yoashini waan worra isati baafate sunini jed'e, Isani Baali kalchitani isa qarqaaru feetani? Nama isaa kalchu ch'ufa, ato lafti imbariine, fit'ani. Hojja Baalini Waaqa taate ha ufi qarqaaruti, wonti ch'ach'absani suni ch'ufti kama isaati. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya suni asi Gideoni maqa Yerubaali baasani; wonti akanatiifi Yoashini waan jed'e, Baalini ha ufi qarqaartu, wonti ch'ach'absani suni ch'ufti tama isaati.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Midianitifi ka Amalekitifi worri ilaboru ch'ufti wolti bahe, galaana Yordani taake, bale Yesereli keesa qubate. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuuni AABBO Waaqa Gideoni ira bute, inni magalata d'ae, worra balbala Abiezeri ufiti yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle lafa gosa Manase ch'ufa keesa nama erge, worra ch'ufa ufiti yaame. Nama gara gosa Asheritifi ka Zabulonitifi ka Naftalile erge, duuba worrileeni iti d'ufe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Gideonini waan Waaqaani jed'e, Hojja atini Israeli harka kiyyaani baasu feetu, akuma atini jettu, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me ilaali, anini qoola dabbasa qabu fulla dargaye iti daanani kayu jira. Yo bori diirama fit'eesi qola suni gubbaa jiraate, ka ammo lafa injirre, anini aka atini worra Israeli harka kiyyaani baaftu sunini beekha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti ch'ufti akasuma taate. Hojja Gideonini boriyya ganama lafaa kae. Inni qoola suni wolti kuuch'e, fit'eesa qori guddo guutu iraa woraabe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Gideonini waan Waaqaani jed'e, Nati indallanini, ammalle tokotu wojed'a; ammalle maro lameeso qoola kanani wo laala. Maro tana qoli ha gogoge, lafti jiituti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani suni Waaqi akasuma tolche. Yo lafti bariite, qooli sunini gogoga, ammo lafti injiiti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Gideonini worra Midiani dabsate",
          "type": "text"
        }
      ]
    }
