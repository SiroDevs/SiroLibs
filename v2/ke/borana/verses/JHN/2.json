            "number": "21",
            "style": "v",
            "sid": "JHN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo mani inni baane nafa isaati. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi duisa keesaa isa kaamnaani, jari isaa aka inni waan kana jed'e qaabate, t'aafifi dubbi Yesoni jed'e d'ugefate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni nama ch'ufa beekha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
