              "items": [
                {
                  "text": "Mat 11.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.22"
              },
              "items": [
                {
                  "text": "Luk 10.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abbaani Ilma jaalate waan ch'ufa harka isati kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Ilma d'ugefatu jireenna hegeri qaba; nami Ilma d'ugefachu didu haguma jiru jireennale jireenna inargatu, ammo Waaqi haga jiru jireenna isati dallana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
      ]
    },
    {
