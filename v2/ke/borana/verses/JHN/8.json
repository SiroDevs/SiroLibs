{
  "id": "JHN.8",
  "number": "8",
  "bookId": "JHN",
  "reference": "Yohana 8",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JHN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yesoni gara gaara Ejersa jed'ani d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti bariinaani inni Mana Waaqati deebie. Nami ch'ufti gara isaa d'ufe, duuba inni tae worra barsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jara Seera beekhufi Farisayooni niiti sharmut'iti toko ta ato isiini nama woliini raftu qabde isatiini d'ufte, jiddu biyyatiini geete, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan isaani jette, Aabbo niiti tana ato isiini nama d'iiratini raftu qabani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Law 20.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.22+DEU.22.23+DEU.22.24"
              },
              "items": [
                {
                  "text": "Qab-Ser 22.22-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Duuba Seera keesa Musani nad'eeni akana tana, D'akhaani d'aana, ijeesa nuuni jed'e. Ammo atini maani jetta? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti dubbi suni jed'aniifi aka afaani fuud'ani waan himataniini isa iraa argatani, ammo Yesoni gajed'e, qubaani lafa tataraare. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato worri isa wo gaafatu, inni oljed'e waan worraani jed'e, Nami daba inqamne isani keesa ha qara d'akhaani isi d'au. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle gajed'e, quba ufiitini lafa taraare. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri d'ageennaani namu toko tokooni kae yae, qara jaaroleeni yaate, kaimilleeni gula yae. Yesoni koba hafe ka niitileeni achuma ejitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni oljennaani waan isiini jed'e, Intala, beeni si himate me? Tokoleeni wollaala siti imurre? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan jetteeni, Tokoleeni injiru, Aabbo. Yesoni waan jed'eeni, Anileeni wollaala siti imuru. Beeni, ammo deebite daba intolchiini.]",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni ifsa lafaati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
