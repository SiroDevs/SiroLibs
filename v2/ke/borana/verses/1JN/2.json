              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti isani haguma duriiti d'ageetani ha isani keesa teetu. Yo wonti isani haguma duriiti d'ageetani isani keesa teete, isani Ilmaafi Abba keesa teetani. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
