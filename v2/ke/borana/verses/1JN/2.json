        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayu muudani; haga Lubbuuni suni isani woliini jirtu, nama isani barsiisu imfeetani. Lubbuuni waan ch'ufa isani barsiifti, wonti isiini isani barsiiftu waan d'ugaati, d'araaniti. Barsiisa Lubbu ch'aqasa, Kristo keesa taa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
