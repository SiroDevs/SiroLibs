          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, ijoolle tiyya, Kristo keesa taa, aka yo inni mullate, nu jabaanne, Guyya inni d'ufu inch'eere. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo isani aka Kristoni d'uga beetani, aka nami waan d'uga tolchu ch'ufti ijoolle Waaqa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
