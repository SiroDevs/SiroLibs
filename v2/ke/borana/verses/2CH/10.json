              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Biyyiti aka hayyuuni worra ch'aqasu dide argite jennaani waan jette, Nu Daudi maani ira qamna? Ilmi Yese maani nuu baha? Worra Israeli, kaa, nu galcha! Rehoboamuni ha qofa hafuti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akanaani worri Israeli Rehoboamuti garagale, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "worra Yudati isa lakise, kae bira yae.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyu Rehoboamuni Adoniramu ka worra huji irreeni hojachiisaniti mataa, worra Israeliti erge, ammo worri d'akhaani d'aane ijeese. Jennaani Rehoboamuni arifate gaari ufi yaabate Yerusalemuti baqate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi arti asi worri Israeli nama d'aloota Daudi ch'ufa iti garagale dide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
    },
