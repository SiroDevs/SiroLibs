  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CH 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamuni Shekemu, fulla worri Israeli ch'ufti aka isa hayyu tolchu wolti bahe, d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
            "verseOrgIds": [
              "2CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamuni, ilmi Nebati, ka qara lafa Misiriti hayyu Solomoni baqate, dubbi tana d'agaye jennaani worra ufiti deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Israeli sunini isa yaame, gara Rehoboamu woliini d'aqani waan jed'aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaani kanke nu dabse, ulfinna jaba nura kaye. Hojja atini nuraa sablifte, finna dansaani nu d'ufte, nu aka dansaa si gula yaana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Dubbi teesani ya d'agaye, inherega, sadi bula, gadi dachaa. Jennaani worri kae yae.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba hayyu Rehoboamuni jaarole abba isaati mala d'ooftu dubbi suni gaafate waan jed'eeni, Mala naa d'aa, dubbi anini worra kanani jechu male nati hima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan jed'eeni, Yo atini worra kana naate dubbi dansa worra gammachiiftu jetteeni, worri haga jiru jireenna aka dansaa si hojata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni mala jaarole suni dide, dubbi suni hariya isaatini gahe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.8",
            "verseOrgIds": [
              "2CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala na d'aa, waan anini worra ulfinna nura fuud'i naani jed'u kana jed'uuni nati hima jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.9",
            "verseOrgIds": [
              "2CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri hariya isaa sunini waan jed'eeni, Wonti atini worraani jechu malte tana: qubi kiyya diqaani hid'aana abba kiyya ira furda! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.10",
            "verseOrgIds": [
              "2CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worraani jettu, Abbaani kiyya ulfinna gudda isani ira kaye, ammo anini hagasi irale isaniti guddisa. Inni lichooni isani d'aane ammo anini goraani isani d'aana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultiini sadeeni taani hobaate jennaani, Yeroboamufi gumiini taani ch'ufti Rehoboamuti d'ufte, akuma inni jed'eeni kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi mala jaarole taani dide, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala hariya isaa kaani gula bahe, dubbi jajabdu worrati dubbate waan jed'eeni, Abbaani kiyya ulfinna gudda isani ira kaye, ammo anini hagasi irale isaniti guddisa. Inni lichooni isani d'aane, ammo anini goraani isani d'aana! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
            "verseOrgIds": [
              "2CH.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBUMA Waaqati hayyicha biyya ch'aqasu d'owe, aka akasiini dubbini inni raaga Ahiya jed'ani, ka Shilo bahe, Yeroboamu ilma Nebatiti himi jed'e, guutamtu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.15",
            "verseOrgIds": [
              "2CH.10.15"
            ]
          }
        }
      ]
    },
