            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri kanke ka Israeli maro worri siti dabeefi nyaapi dabsate, ammo duuba eege worri siti deebie, Mana kanati d'ufe garaa laafe araarsa si kad'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "gubbaa worra ch'aqasi. Daba gumi tanteeti araaramifi, lafa atini ababoota worraati kennite worraa deebisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja atini maro worri kanke si durati wollaaleefi bokaya worra roobu didde, ammo duuba hojja worri wollaala suni iraa deebie, Mana kanati fuula deefate, garaa laafe si kad'atu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee AABBO Waaqa, gubbati worra ch'aqasi, daba hojattu tante worra Israeli biraa deemifi, waan d'uga worra barsiisi. Duuba, Ee AABBO Waaqa, lafa tante tana, ta atini d'aala worra kanketi kennite, bokaya roobifi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja oolaani jabduuni yokhaani ch'iisi hamani lafati bue, yokhaani qilleensa hamafi raamofi, awaanisafi buqatani mid'aanti buute balleesitu, yokhaani hojja nyaapi worra kanke had'e, yokhaani hojja d'ukubafi fayyad'abi worrati bue, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha worraa d'agayifi. Hojja worri kanke ka Israeli nami toko gargala ufi arge, harka ufi gara Mana Waaqa kana qabe Waaqa kad'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha isaa d'agayifi. Mana kanke ka gubbati worra ch'aqasi, araaramifi. Si ch'allati herega nama ch'ufa beekha, tanaafi nama ch'ufa waan isaa male tolchita, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka worri kanke, hojja lafa atini ababoota worraati kennite keesa tau, si sodaate si ch'aqasu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami gosa d'ibi, ka lafa fago tau, guddinnaafi jabeenna kanke d'agaye, waan atini namaa tolchitu hubate, aka si kad'atu Mana kanati gadi d'ufe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha isa d'agayifi. Gubbaa, fulla worra keetiti, isa ch'aqasi, waan inni fed'u guutiifi, aka gochiti lafa keesa jirtu ch'ufti si beete sii saalfatu, akuma worra kanke ka Israeli. Duuba akanaani worrileeni imbeekha, aka Mani anini jaare kunini fulla iti si kad'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja atini worra kanke, nyaapa haad'a jette ergite, worrileeni fulla jiruti dira atini fohate kanafi Mana anini si jaare kanaleti fuula deefate si kad'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha worraa d'agayifi, gubbati worra ch'aqasi, dabsacha kennifi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri kanke siti ch'ubbame — qarale nami ch'ubbu intolchine injiru — duuba atini dallansu keesa harka nyaapa worraati kennite, nyaapi sunini worra boojie lafa d'ibiti geese, ato lafti sunini fagole taate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha worra kanketi d'agayifi. Yo lafa suni keesati worri ch'ubbu iraa deebie, si kad'ate, dabaafi ch'ubbu ufi siti himate, Ee AABBO Waaqa, kad'acha worraa d'agayifi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo lafa suni keesati worri d'uguma daba ufi iraa deebie, fuula lafa atini ababoota teenna kenniteefi dira atini fohate kanafi Mana anini si jaare kanati daefate si kad'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kad'acha worraa d'agayifi. Mana kanke ka gubbati ch'aqasi, worraa nahi, ch'ubbu worraa ch'ufa araaramifi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma, Ee Waaqa kiyya, nu ilaali, kad'acha fulla tanati kad'atani nuu ch'aqasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.8+PSA.132.9+PSA.132.10"
              },
              "items": [
                {
                  "text": "Far 132.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ee AABBO Waaqa, amma kai, Sanduqa Wold'aqisa ka akheekha irre teeti garsiisu woliini Mana Waaqa seeni, haga jiru jireenna achi tai. Qaalole tante huji worra ch'ufa keesati eebisi, gumiini tante ch'uftileeni maro dansuma tanteetifi ha gammadu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee AABBO Waaqa, hayyu atini fohate muude indidini, jaalala atini hojattu tante Daudi jaalate qaabad'i.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.42",
            "verseOrgIds": [
              "2CH.6.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Mana Waaqa eebisani",
          "type": "text"
        }
      ]
    }
