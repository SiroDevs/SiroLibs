      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna torbeeso, qaallichi Yehoiyadani garaa jabaate, jara shanani gugurda askarti kanaani woliini malatani; Azaria ilma Yehoramu, Ishmaeli ilma Yehohanani, Azaria ilma Obedi, Masseya ilma Adaya, Elishafathi ilma Zikri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri sunini dira Yuda ch'ufa d'aqe, worra Lawitifi worra mata balbala gosa Israeli ch'ufa Yerusalemutini d'ufe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
