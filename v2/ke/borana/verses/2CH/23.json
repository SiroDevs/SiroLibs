          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
