      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna sodomi jaeeso ka Asani lafa mohate, Baashani, hayyuuni Israeli, lafa Yuda had'e, dira Rama jabeese jaare, aka nami tokoleeni dira suni keesaa bahe yokhaani inseene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.1",
            "verseOrgIds": [
              "2CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba hayyu Asani qarsifi worqi Mana Waaqatifi ka mana hayyu keesaa guure, Damaskiti gara Benhadadi hayyu Shamuti erge waan jed'eeni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kooti, aka abbooti teenna goli woli taana qarsifi worqiini tunini waan anini sii ergu. Amma tana wold'aqisa siifi Baashani hayyuuni Israeli woliini qabdani ch'absi, aka inni askarti isaa lafa tiyya keesaa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benhadadini dubbi Asa d'agaye, askarti isaatiifi worra gugurda askarti isaa dira Israeliti had'iisaa erge. Jennaani worri dira Iyonitifi Danitifi Abel-Beth-Maakatifi dira Naftali ka sagale keesati olkayani ch'ufa dabsate fud'ate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.4",
            "verseOrgIds": [
              "2CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Baashani waan tahe suni ch'ufa d'agaye jennaani dira Rama, ka jabeesani jaaru jirani kaani, lakise biraa deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.5",
            "verseOrgIds": [
              "2CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyichi Asani qonqo lafa Yuda ch'ufati erge nama ch'ufa wolti yaame, aka nami ch'ufti haguma gaunu d'ufe, d'akhaafi mukha Baashani dira Ramatini jaare guure, dira Gebaatifi ka Mispa sunumaani jabeesani jaarani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raaga Hanani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi raagi Hanani jed'ani toko gara Asa d'aqe waan jed'eeni, Waan atini AABBO Waaqa kanke lakifte hayyu Shamu qarqaarsa heregateefi, duuli hayyu Israeli ya baqate si duraa bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gosa Kushitifi ka Lubi, askarti heddufi gaari heddufi yaabatu fardale heddu inqabu? Ammo maro atini AABBO Waaqa qarqaarsa heregateefi inni si dabsachiise. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi lafa ch'ufa ilaale tisse nama isa d'ugeefatu jabeesa. Waan atini aka daale tateefi, armaa achi worraani lafa tante keesaa imbahu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbini tunini aka male Asa dallansifte jennaani inni raaga suni fuud'e sansalatani hid'e. Duuba bara suni Asa garaani hammate, nama gari, naasu male, aka hama gaargalche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duisa Asa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan hayyu Asani tolche ch'ufa, haguma geetunu, kitaaba Odu Hayyoota Yudatifi ta Israeli keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna sodomi sagaleeso ka Asani lafa mohate inni, d'ukuba hama fuud'e miilaa naafate; ammo tatule inni qarqaarsa AABBO Waaqa ira infed'anne, ch'ireeyyi iraa fed'ate. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ganna lama teennaani due ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "awaala goda d'akha ka inni mid'aafate, dira Daudi keesati, isa awaalani. Inni doonaani qumbifi d'ad'a urgaa nafa isaa ibsani, ibida gudda goolani isaa bohani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yehoshefathini hayyu tahe",
          "type": "text"
        }
      ]
    }
  ],
