              "items": [
                {
                  "text": "Qab-Ser 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Solomonini fardoole lafa Musiritifi lafa d'ibile ch'ufa iraa bitate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
