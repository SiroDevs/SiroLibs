              "items": [
                {
                  "text": "Qab-Ser 17.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gaafasi Yerusalemu keesa qarsiini lafa ira dabarte akuma d'akhaati heregani, hind'eesale akuma mukha dambiti heregani, ka fulla ch'ufa jiru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
