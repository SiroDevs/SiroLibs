                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni hayyoota lafa haga galaana Efrati ejite lafa Filistitifi seera lafa Misiriti ejitu ch'ufa mohata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
