        },
        {
          "text": " Solomonini kad'acha ufi hobaase. Jennaani ibidi gubba gadi bue, sorio baasani taani ch'ufa gube, guddinni AABBO Waaqa ka bibiliqu mana isaa guute. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Mana Waaqa suni guddinni bibiliqu sunini guuteefi, qaaloleleeni seenu dad'abde. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
