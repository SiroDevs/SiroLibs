              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raagi Yeremiaa jed'ani faarse isaa bohe arti asi sirbituni Israeli, d'iirafi nad'eenileeni, hojja isaa bootu faaru tanani bootifi. Faaruni sunini kitaaba Boha keesa jirti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
