                }
              ]
            }
          ]
        },
        {
          "text": "Guyya qaraa ka gaafa jila mid'aani murani, hojja isani mid'aani keesani ka qaraa murattani AABBO Waaqa baaftani, guyya suni woliwoldaa, huji inhojatina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan gubani Waaqaa baasani, ka ch'inch'aani isii AABBO Waaqa gammachiiftu baasa: jiboota koromi lama, elemo toko, elemiye ilmoole hoola torba, ta ganna tokoti, ta kamu aabo womatu inqamne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dargaye daakhani ta d'ad'ani wolti makhanile, baasa: kilo sadi jiboota koromi suni woliini, kilo lama elemo kaani woliini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle kilo toko elemiye taani ch'ufa woliini baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle korbeesa toko sorio dabaani ufi ira baasani baasa, akanaani biyya qulqulleesa, aada guutafi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan guyya ch'ufa gubani Waaqaa baasanifi mid'aani Waaqaa baasani male, sorio tanaafi daad'ile Waaqaa baasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
            "verseOrgIds": [
              "NUM.28.31"
            ]
          }
        }
      ]
    },
