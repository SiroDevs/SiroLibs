    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli godaane diida Moabu ka Yordanini ilaboru, Yeriko gama qubate. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni Moabu ka Balaki ilma Sipori jed'ani, waan worri Israeli worra Amori, tolcheefi ammalle aka worri nama hedu d'ageennaani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaafi worri isaa mumudame, lubbuuni d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Moabu waan jaarole Midianitini jed'e, Tuuti nama ta muumme inqamne tunini amumatana waan d'aatu teenna jira ch'ufa araabdi, akuma qotiyoni marra araabde fit'u. Tanaafi Balakini ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.8"
              },
              "items": [
                {
                  "text": "Hen 31.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.15+2PE.2.16"
              },
              "items": [
                {
                  "text": "2 Pet 2.15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.11"
              },
              "items": [
                {
                  "text": "Yud 11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " gara Balamu ilma Beori, ka Pethori jiru, d'aatu galaana Efrati lafa Amawi, nama iti erge yaame. Worri ergani suni waan jed'eeni, Balakini waan sini jed'u gochiti toko, ta muumme inqamne, ya lafa Misiriti d'ufte, nu mudamsiifte lafa teenna fud'achu feeti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri heddu, nura jira, tanaafi kooti, worra kana falfali, abaari. Yo atini hegeri abaarte nu worra dabsanne lafa teenna keesaa baamna. Anini imbeekha, nami atini eebiftufi eeba argata, ammo ka atini abaartu abaarsa argata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba jaaroleeni Moabutifi ta Midiani beese worra Israelitini abaarani fud'atte, Balamu d'at'e d'aamsa Balaki iti himte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamuni waan jaaroleeni jed'e, Arra arma bulla, bori waan AABBO Waaqi nani jed'u isaniti hima. Duuba jaaroleeni Moabu fulla Balamu bulte.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Uum 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "49.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani Waaqi Balamuti d'ufe waan jed'eeni, Jari atini bulchite kunini eenu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Balaki hayyu Moabuti jaarole tana nati erge waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.10",
            "verseOrgIds": [
              "NUM.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gochiti toko ta lafa Misiriti d'ufte ya lafa ch'ufa qabate; kooti, nuraa falfali, abaari yo atini abaarte anini hegeri dandae worra had'e lafa keesa balleesa naani jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan Balamuni jed'e, Worra kana gula indeemini, ammalle worra Israelile falfalte inabaarini, wonti akanatiifi worri eeba tiyya qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti bariite jennaani Balamuni lafaa kae jaarole suni d'aqe waan jed'eeni, kaa gala; AABBO Waaqi yayu isani gula deemu na d'owe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri Balakiti d'ufe waan jed'eeni, Balamuni ya nu gula d'ufu dide.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Balakini jaarole heddu d'ibi ta jaarole taani ira gurra qabdu erge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.15",
            "verseOrgIds": [
              "NUM.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Balamuti d'ufe waan jed'eeni, Balakini waan siini jed'u, Wonti tokoleeni d'ufiisa atini gara kiyya d'uftu inhanqisiini! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.16",
            "verseOrgIds": [
              "NUM.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan atini feetu ch'ufa sii tolche yokhaani sii kenna: Inolini, kooti, worra kana falfali, naraa abaari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.17",
            "verseOrgIds": [
              "NUM.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Balamuni waan jed'e, Ato Balakini mana isaa ka qarsifi worqiini guute sunile naa kenne, anini dandae dubbi AABBO Waaqa kiyya diqole indabru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hataatuti, isanileeni akuma jaarole taani halkani kana bula, aka anini dubbi AABBO Waaqa iraa eegad'u.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani suni Waaqi Balamuti d'ufe waan jed'eeni, Yo jari kunini sii yaamu d'ufe, kai, gula deemi, ammo waan anini tolchi siini jed'u ch'alla tolchi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba boriyyaate Balamuni harre ufi kora iti faate yaabate jaarole Moabu taani gula deeme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Balamufi harreeni isaa taate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Waaqi waan Balamuni deemefi iti dallane; duuba ato Balamuni harre ufi yaabate hojatu isaa lamaani woliini deemu, malaikaani AABBO Waaqa isa dura ejite dabru d'owarte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.22",
            "verseOrgIds": [
              "NUM.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreeni taani, malaika goraade harkaa qabdu, ta kara keesa ejitu arginaani kara iraa gorte oobru seente. Ammo Balamuni harre suni d'aane karaati deebise. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.23",
            "verseOrgIds": [
              "NUM.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani fulla karaani iti qalatu, ta jiddu oobru zabibu lamaani, ta d'akhaani marsani aka dalaa jaarani, ejite. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
              "NUM.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreeni taani malaika arginaani d'akha aka dalaa kaaniti riiqate, miila Balamu ch'arasite. Jennaani Balamuni ammalle isi d'aane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle malaikaani dura deemte fulla karaani aka male qalatu, ka nami dandae wold'aatu imbaane, ejiti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
              "NUM.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro tana harreeni malaika arginaani gach'iifte. Balamuni aka hama dallane, harre uleeni d'aane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi harre dubbachiise, isiini waan Balamuni jette, Anini maani si tolcheefi, atini maro sadi uleeni na d'aanta?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamuni waan jed'eeni, Waan atini nati tabattefi si d'aane, ule lakisi, ato sila goraade qabaad'e si ijeesa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreeni taani waan jetteeni, Anini harre tante, ta atini haguma d'alate yaabateniti? Anini arra male, taka ya akana sitolche? Inni, Hiyo jed'eeni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi ila Balamu bane, inni malaika goraade harkaa qabdu, ta kara keesa ejitu arge, duuba Balamuni gajed'e isa durati jige. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani AABBO waan jetteeni, Atini maanifi harre tante maro sadi akana d'aanta? Anini kara sii d'owu d'ufe, wonti akanatiifi atini sila imaltu tana deemu himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo harreeni tante na agarte jennaani maro sadi kara iraa gorte; ato isiini sila goru baate anini sii ijeese, isi baasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Balamuni waan malaika AABBO Waaqatini jed'e, Anini ya ch'ubbu tolche; aka atini, kara keesa ejite na d'owarte anini imbenne; ammo amma tana hojja atini deema tiyya tana ira hameenna agarte keesa deebia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo malaikaani waan jetteeni, Indeebiini, jara kana woliini yaa, ammo waan anini siini jed'u male waan d'ibi injed'ini. Duuba worri kae woliini yae.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Balakini Balamu fuula keesa deeme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakini aka Balamuni d'ufu jiru d'agaye jennaani, dira Ari, ka seera Moabu galaana Arnoni d'aatu jiruti, argu d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.36",
            "verseOrgIds": [
              "NUM.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakini waan isaani jed'e, Atini maanifi gaafa anini qara si yaame ind'ufini? Waan anini waan guddo sii kennu qabu inseetu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.37",
            "verseOrgIds": [
              "NUM.22.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.37",
            "verseOrgIds": [
              "NUM.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Balamuni waan jed'eeni, Anini ya d'ufeeniti? Ammo qara irreeni anini qabaad'e wojed'uuni tami, ta Waaqa male? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.38",
            "verseOrgIds": [
              "NUM.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Balamuni haga dira Kiriath-Husothi Balaki woliini yaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.39",
            "verseOrgIds": [
              "NUM.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiti Balakini loonifi ree sorio qaqale, fooni gari Balamufi jaarole isa woliini jirtuu kenne.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fagiisa qara Balamuni fage",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyyaate Balakini Balamu fuud'e, Bamoth-Baali woliini korani; achiti Balamuni worra Israeli ufi durati arge.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
