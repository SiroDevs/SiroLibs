              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musafi Harunini jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.26",
            "verseOrgIds": [
              "NUM.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini dabdoleeni tunini yoomi nati gungumu lakifti? Gungumsuni worraa tunini ya naa geete! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.27",
            "verseOrgIds": [
              "NUM.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma waan atini worraani jettu: AABBO Waaqi waan jed'u, D'uguma, haga anini jiru waan isani kad'attani kana anini isanumaa tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.17"
              },
              "items": [
                {
                  "text": "Ebr 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani raawattani, reefa keesani lafa aloo tana keesati firfirsani. Maro isani nati gungumtanifi isani nami ganna diddamati oli tokoleeni, ka lafa tana seenu, injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.29",
            "verseOrgIds": [
              "NUM.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini qara yayu kakhad'e, Isani achi teetani jed'e, ammo amma tana Yoshuafi Kelebu male nami lafa suni keesa tau injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.30",
            "verseOrgIds": [
              "NUM.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani waan jettani, ijoolle teenna boojiani, ammo anini ijoolle suni lafa isani diddanitini d'ufe, isiini duuba achi qubati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.31",
            "verseOrgIds": [
              "NUM.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isani lafuma aloo tana keesati hobaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.32",
            "verseOrgIds": [
              "NUM.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.36"
              },
              "items": [
                {
                  "text": "Huji 7.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ijoolleeni teesani lafa aloo tana keesa ganna afurtama marte, maro gaargala keesanitifi gaargalti, haga isani nami ch'ufti duuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.33",
            "verseOrgIds": [
              "NUM.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro isani bulti afurtama dooyaa d'at'ani galtanifi, ganna afurtama ka isani lafa tana teetani, gati wollaala keesani argatani, ganna toko bulti toko gula. Isani waan nami anini nyaapa iti tahe tahu inagartani! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.34",
            "verseOrgIds": [
              "NUM.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini inkakhad'a, aka anini isani worri ch'ubbu, ka wolti bahe na dide, waan kana tolchu. Lafa aloo tana keesati, isani ch'ufti indootani. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari Musani dooya erge kaani dubbi d'araatiini biyyati gale. Jennaani dubbi d'ara suni gula biyyiti AABBO Waaqati gungumte. Duuba AABBO Waaqi ch'iisa d'ukuba hama iti buuse nama hobaase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36+NUM.14.37",
            "verseOrgIds": [
              "NUM.14.36",
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra dooya kud'ani lamaani kaani keesa Yoshuafi, Kalebu ch'allati iraa hafe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maro qara ta worri lafa had'u fed'e",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
