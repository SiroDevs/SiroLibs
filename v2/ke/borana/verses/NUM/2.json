          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri Israeli qubatu ch'ufa, nami ch'ufti ha bandera gosa isaatiifi ka balbala isaa gula qubatuti. Ollani ch'ufti ha Waaro Woyyuma marse qubatuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
