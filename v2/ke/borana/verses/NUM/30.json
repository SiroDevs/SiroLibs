              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani jaarole gosa Israeliti matatiini waan jed'e, Wonti AABBO Waaqi jed'e tana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
