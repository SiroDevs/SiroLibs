          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle kilo toko elemiye taani ch'ufa woliini baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
