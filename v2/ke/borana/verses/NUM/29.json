              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sorio gubani AABBO Waaqaa baasa, ta ch'inch'aani isii isa gammachiiftu: jibicha korma toko, elemo toko, elemiye ilmoole hoola torba, ta ganna toko, ta kamu aabo womatu inqamne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
