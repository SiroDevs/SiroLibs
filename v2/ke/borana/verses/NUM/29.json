        },
        {
          "text": "Guyyaani kud'anneeso ka jia torbeeso guyya qulqullo, woliwoldaa; sagale inyaatina, hujile inhojatina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
