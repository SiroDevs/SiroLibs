              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan atini worra Israelitini jettu, Hojja nami d'iira yokhaani ka uwa kakhu kakhate, aka aada worra Naziri jed'ani gula deeme AABBO Waaqati ufi kennu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Luk 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nami akasi kunini ha daad'ifi farso lagatu. Yokhaani inni waan zabibu iraa mid'aasani, ka d'uganifi ka nyaatanile ch'ufa ha lagatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga inni aada Naziri suni keesa jiru, inni waan zabibu iraa baha killefi qola mid'aani isiile taanaani tokole inyaatini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle haga aada Naziri tana keesa jiru, inni mata ch'irate yokhaani inhaadatini. Haga guyyaani inni AABBO Waaqa kakhate isaati ufi kenne, aada suni gula deemu iraa hobauti, inni ha rifeensa isaa ka matatifi ka areeda galakisuti, aka inni d'ed'eeratu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rifeensi isa akheekha aka inni AABBO Waaqati ufi kenne agarsiisu; tanaafi inni reefa tokoleti d'iaate ufi t'ureesu himmalle, ka abbaatifi ka haad'atifi ka oboleesafi oboleetile taanaani iti d'iaachu himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6+NUM.6.7",
            "verseOrgIds": [
              "NUM.6.6",
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga aada Naziri suni keesa jiru ch'ufa inni qulqullo, ka AABBO Waaqati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami d'aatu isaati due, ka duuba akanaani rifeensi isaa ka aada kaani t'urae, inni guyya torba bule duuba matafi areeda ha haadatuti, duuba ha akanaani ufi qulqulleesuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya saddeeteeso inni ha sabaliisa lama yokhaani ilmaani sabaliisa lama qaallichatini d'ufuti, fulla balbala Waaro Woyyumati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi sabaliisa toko ha aka sorio dabaani ufiraa baasani baasuti, kaanile ha aka sorio gubani baasani baasuti, aka akanaani namicha reefati d'iaate t'urae kaani qulqulleesu. Guyyuma suni namichi ha ammalle rifeensafi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nafa ufi AABBO Waaqaa kenne aada Naziriti deebiuti. Haga inni qara aada suni keesa jiru iti inheregani, wonti akanatiifi aada isaa ta qara taani t'ureesani. Ammalle inni elemo ganna toko maro wollaala sunitifi ha d'ufuuni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
