            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aadaani nama kakhu Naziri kakhatu tana; ammo yo namichi aada Naziri ke jiru kaani waan kakhachu male ira kakhate, inni kakhu inni kakhate suni ha guututi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
