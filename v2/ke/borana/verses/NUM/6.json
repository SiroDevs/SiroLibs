          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini Harunifi ilmaani isatini jettu, Akanaani gumi Israeli eebisa, waan jettaniini ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        },
        {
