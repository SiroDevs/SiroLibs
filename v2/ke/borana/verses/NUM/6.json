          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi ha isani eebise isani qorqoratu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.24",
            "verseOrgIds": [
              "NUM.6.24"
            ]
          }
        }
