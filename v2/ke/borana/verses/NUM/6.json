                "loc": "ACT.21.23+ACT.21.24"
              },
              "items": [
                {
                  "text": "Huji 21.23-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hojja nami aada Naziri keesa jiru guyyaani inni kakhate dabre, inni aada tana tolchu male. Inni ha fulla balbala Waaro Woyyuma deeme, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "hori sadi ka aabo inqamne AABBO Waaqaa baasu: elemo ganna toko ka sorio gubani Waaqaa baasani, karso ganna toko ta sorio dabaani ufi iraa baasani, ammalle elemo toko ka sorio wold'ageeti baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ammalle dadu qit'a bukho inqamne ha baasuti: qit'a fufurda dargaye ka d'ad'ani wolti makhani mid'aasanifi qit'a hahapicha didiqa d'ad'a dibani, ammalle mid'aanifi daad'i ta baasu malani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi ha waan kana ch'ufa AABBO Waaqatini d'ufe, sorio dabaani ufi iraa baasanifi ta gubanile baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha elemo suni ka sorio wold'ageeti AABBO Waaqaa baasuti, dadu qit'a taani woliini; ammalle inni ha mid'aanifi daad'i ta baasuu malani baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla balbala Waaro Woyyuma, namichi aada Naziri keesa jiru suni, ha rifeensa haadate ibida sorio wold'ageeti gubbati gubani kaaniti jissuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eegi balleensu elemo kaani d'aabani, qaallichi ha fuud'e, qit'a fufurda kaani tokofi qit'a hahapicha didiqa kaani toko woliini, harka namicha aada Naziri keesa jiru kaani keesa kayuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni qaallichi waan kana ch'ufa AABBO Waaqati ha oliqabuuti woni kunini ch'ufti qooda qulqullo qaallu kennani, handaraafafi miila elemo kaani ka seera gula qaallicha baasani male. Eegi suni namichi aada Naziri keesa jiru kaani, yo fed'e, dandae daad'i d'uga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
