        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
