          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani ee jed'e, ilmaani angafa ch'ufa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
