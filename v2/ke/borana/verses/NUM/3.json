              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan ilmaani angafa ka worra Israeli nama d'ibba lamafi torbatami sadini worra Lawi ira jirtuufi, ilmaani ira hafte suni bitachu malte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
