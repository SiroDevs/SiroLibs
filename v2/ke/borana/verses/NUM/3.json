          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalti Merari mana Mahlitifi Mushi qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
