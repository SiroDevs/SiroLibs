              "NUM.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Lawi gayaami, biyya duraani kooti, hojattu qaallicha Haruni jed'ani worra tolchi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri ha huji Waaro Woyyumati malteefi ta qaaloleetifi ta gumi ch'ufa hojatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri ha miha Waaro Woyyuma jabeese huji worra Israelile hojatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini worri Lawi hojachu male toko ch'alla aka Harunifi ilmaani isaa hojatani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle Harunifi ilmaani isaa ka atini qaalole tolchite, ha huji suni hojatani; nama d'ibi ka huji suniti d'iaatu ha ijeesaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.11",
            "verseOrgIds": [
              "NUM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Bah 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri gosa Lawi amma kiyya. Gaafa anini angafa worra Misiri ch'ufa hobaase, anini ilma angafa ka worra Israeli ch'ufafi waan horini worra gorooruma d'ale ch'ufa fohad'e qulqulleese. Amatana fulla angafa Israeli anini ya worra Lawi fohad'e fud'ad'e: Worri kiyyuma. Anini AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12+NUM.3.13",
            "verseOrgIds": [
              "NUM.3.12",
              "NUM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Henna gosa Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12+NUM.3.13",
            "verseOrgIds": [
              "NUM.3.12",
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa aloo ta gamooji ta Sinai keesati, AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.14",
            "verseOrgIds": [
              "NUM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra gosa Lawi manafi balbala gosa gula hedi: Ijoolle d'iira ta haga d'alate jia toko teete oli ch'ufa henna keesa t'aafi: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.15",
            "verseOrgIds": [
              "NUM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani akuma AABBO Waaqi isaani jed'e kaani tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.16",
            "verseOrgIds": [
              "NUM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawiini ilmaani sadi qaba; Gershoni, Kohathi, Merari; worri kunini abbooti balbala gosa worra. Gershonini ilmaani lama qaba: Libni, Shimei, Kohathini ilmaani afuri qaba Amramu, Ishari, Hebroni, Uzieli; Merarileeni ilmaani lama qaba: Maheifi, Mushi. Nami gosa worra ch'ufti worra kana iraa hore.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20",
            "verseOrgIds": [
              "NUM.3.17",
              "NUM.3.18",
              "NUM.3.19",
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20",
            "verseOrgIds": [
              "NUM.3.17",
              "NUM.3.18",
              "NUM.3.19",
              "NUM.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalti Gershoni, mana Libnitifi Shimei qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.21",
            "verseOrgIds": [
              "NUM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'iira, ka haga d'alate jia toko oli, ka henna keesa t'aafani, nama 7,500. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalti tunini Waaro Woyyuma duuba, gama ila adu qubati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami balbala suni mataa Eliasafu ilma Laeli jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
              "NUM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini Waaro Woyyuma ta worri kuni hojatu aka, golla isii ka keesatifi ka alaatifi golla balbala isiitiifi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "golla naabo Waaro Woyyumatiifi waan aka mesa ka sorio irati baasani marsufi, golla balbala naabo sunile jabeesani qorqoratani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
