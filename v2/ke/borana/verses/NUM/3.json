          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta haga d'alate jia toko oli maqa t'aafe: henni sunini ch'ufti wolti nama 22,273.",
          "type": "text",
          "attrs": {
