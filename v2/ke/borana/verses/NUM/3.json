          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla ilma angafa ch'ufa ka Israeli, worra Lawi eebisi, kiyya tolchi ammalle fulla waan qara d'alate ka looni Israeli looni gosa Lawi eebisi kiyya tolchi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
