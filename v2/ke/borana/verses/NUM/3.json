          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'iira, ka haga d'alate jia toko oli, ka henna keesa t'aafani, 6,200. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbati tunini Waaro Woyyuma gama mirga qubati. Nami balbala suni mataa Surieli ilma Abihaili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini worra kanaa kennani, aka utuba Waaro Woyyumatiifi waan ira dadagalchaniifi waan jala d'ad'abaniifi waan woltiini d'aabani jabeesani qorqoratani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hujiini d'ibiini worri hojatu, aka utuba naabo alaatifi waan inni ira ejaanjufi d'isa naabotiifi haada isiile jabeesani qorqoratani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
