          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataani gosa Lawi ch'ufa Eleazari, ka ilma qaallicha Haruni. Inni nama Fulla Qulqullo hojatu ch'ufa iti gudda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
