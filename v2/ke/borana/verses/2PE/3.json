                "loc": "ISA.65.17"
              },
              "items": [
                {
                  "text": "Isa 65.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "66.22",
                  "type": "text"
                }
