                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.15"
              },
              "items": [
                {
                  "text": "Mul 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo Guyyaani Aabbo aka hattu d'ufa. Guyya suni gubbaani iyana guddooni badde, wonti gubba jira ch'ufti gubatte hobaate, lafafi wonti isi keesa jira ch'ufti imbaddi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro wonti kunini ch'ufti akana badduufi, isani nama akami tahu maltani? Jireenni keesani ch'ufti ha qulqullae Waaqa durati qit'au, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.11",
            "verseOrgIds": [
              "2PE.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato Guyya Waaqaa eeddanu, jabaad'a aka Guyyaani suni hurrise d'ufu — Guyya gubbaani gubatte badde, wonti gubba jira ch'ufti bat'e baddu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.12",
            "verseOrgIds": [
              "2PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
