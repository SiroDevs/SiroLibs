            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ammo waan kana inded'ina, jaalaani tiyya! Waaqa durati guyya tokofi ganni kunki tokoleeni haguma taka. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbooni kakhu ufi inuma guuta, aka nami gari sehuniti. Ammo inni guddo isani obsa; wonti akanatiifi inni nama tokole ka badu imfed'u, ammo nama ch'ufa ka daba iraa deebiu fed'a.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.9",
            "verseOrgIds": [
              "2PE.3.9"
            ]
          }
        }
      ]
    },
    {
