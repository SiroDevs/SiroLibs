              "items": [
                {
                  "text": "Mul 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo nu waan Waaqi nuu kakhate lafa hareetifi gubba hareeti d'ugani guutamte teenne eeganna.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        }
