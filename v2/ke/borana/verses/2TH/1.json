              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulofi Silwanofi Timotheoti tatabe tana gara gumi Thesalonike, ta Abba keennafi Aabbo Yeso Kristoni taka taate t'aafa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa Abbaafi Aabbo Yeso Kristoni eebafi nagaya isanii kenninna.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qorsuma gaafa Kristoni deebiu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu hojja ch'ufa maro teesaniifi Waaqa galata deebisu malle, oboleyaani. Nu akasi tolchu malle, maro d'ugefachaani teesani guddo daramte, ammalle jaalalti isani woljaalattani guddatteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi nu gumi Waaqa keesa dansooma keesani dubbanna. Aka isani obsitani d'ugefattani dubbanna, gaargalafi d'ipu isani argattani keesa.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beesisi qorsuma Waaqa ta d'ugaa kana, maro waan kana ch'ufatiifi isani Finna Waaqa ka isani amma gaargalufiti jirtani kana ya maltani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi waan qajeela intolcha: inni worra isani gaargalchu ingaargalcha, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.6",
            "verseOrgIds": [
              "2TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gaargaltanile isanifi nule inqarqaara. Inni gaafa Aabbo Yesoni malaika isaa guddo woliini gubba mullatu waan kana tolcha, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibida bobauuni, aka worra Waaqa imbeenneefi ka d'aamsa qulqullo Yeso Kristo inch'aqamne gaargalchu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.8",
            "verseOrgIds": [
              "2TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.10"
              },
              "items": [
                {
                  "text": "Isa 2.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri Waaqa imbeenne suni fuula Waaqaatiifi jabeenna isaa gudda duraa kaasani gaargala haga jiru jireenna argata. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya Yesoni guddinni gumi ufitiifi ulfinna nama isaa d'ugefate, ch'ufa ira argachu d'ufu, isanileeni worra suni keesa jirtani, maro isani d'aamsa nu isaniti hime d'ugefataniifi.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti nu hojja ch'ufa Waaqa isanii kad'annuufi tana. Nu Waaqa keenna isanii kad'anna, aka isani jireenna inni iti isani yaame argattani. Jabeenna isaatiini inni yaada dansa ka isani feetani isanii kenne huji teesani dansa ta d'ugefacha guutinna. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.11",
            "verseOrgIds": [
              "2TH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara kanaani maqaani Aabbo keenna Yeso guddinna isani ira argata, isanileeni isa ira argattani, eeba Waaqaatiifi ta Aabbo Yeso Kristotiini.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.12",
            "verseOrgIds": [
              "2TH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'ufiisa Nama Hama",
          "type": "text"
        }
      ]
    }
  ],
