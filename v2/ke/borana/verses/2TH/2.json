                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Waan d'ufiisa Aabbo keenna Yeso Kristotiifi woldeenna nu isa woliini wolwoldeennu: anini isani kad'ad'a, oboleyaani, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.1",
            "verseOrgIds": [
              "2TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka iworere yokhaani indalanne, yo guyyaani Aabbo ya d'ufe jed'ani. Hegeri waan kana nama fage yokhaani ka barsiisuti jed'e, yokhaani nuti tatabe tana keesati t'aafa jed'anifa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.2",
            "verseOrgIds": [
              "2TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami tokoleeni kara tokoleeni isani insobini. Guyyaani ind'ufu, haga Loli guddaani tahe Nami Hamaani ka fulla ibidati male mullatuuti. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11.36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Eze 28.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waan nami kad'atuufi ka nami guddisu ch'ufa inni indida. Inni waan ch'ufa ira ufi guddise, d'aqe Mana Waaqa keesa tae Waaqa ufiini jed'a!",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inqaabattaniiyu? Waan kana ch'ufa anini ato isani woliini jiru isaniti hime. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo woiti waan kana amma tahu d'owa, isani waan suni inuma beetani. Yo hojjaani geete Hamaani suni imullata. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hameenni nami hubachu indandeenne amma lafa jira, ammo wonti tahu malte intaatu, haga namicha waan suni d'owu kara keesaa gorsaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani Hamaani Suni mullate, Aabbo Yesoni hafuura afaani isaatiini isa ijeese, d'ufiisa isaa ka guddinnatiini lafaa isa balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.8",
            "verseOrgIds": [
              "2TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.24"
              },
              "items": [
                {
                  "text": "Mat 24.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hamaani Kaani jabeenna Sheet'anatiini d'ufe mamisa gosa heddutiifi akheekha d'ara aka heddu tolche, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.9",
            "verseOrgIds": [
              "2TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "soba hedduuni worra badu soba. Maro d'uga worra baaftu jaalachu didaniifi badani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.10",
            "verseOrgIds": [
              "2TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi Waaqi badi hamtu worrati erga, aka waan d'ara d'ugefatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.11",
            "verseOrgIds": [
              "2TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba namaama ind'ugefatiini, ka daba jaalatu ch'ufa, wollaala iti murani.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baafamafi isanii fohatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.12",
            "verseOrgIds": [
              "2TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja ch'ufa maro teesaniifi Waaqaa galata deebisu malle, isani oboleyaani Aabbooni jaalatu. Wonti akanatiifi Waaqi haguma qara isani fohate, aka baafamtani, waan Lubbuuni isani qulqulleesite isani d'uga fud'attaniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi Odu Dansa ta nu isaniti hasoomneeni isani yaame; wonti inni isani yaameefi aka isani qooda guddinna Aabbo Yeso Kristo argattani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi oboleyaani, jabaad'a, ejad'a, d'uga nu barsiisafi tatabe teenna keesaleti isani barsiimne qaabad'a.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbo Yeso Kristofi Waaqi Abba keenna, ka nu jaalate eeba ufitiifi jannooma hegerifi abdi dansa nuu kenne, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "garaa keesani jabeese isani kibina, aka waan dansa ch'alla dubbattani tolchitani.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.17",
            "verseOrgIds": [
              "2TH.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaqa nuu kad'ad'a",
          "type": "text"
        }
      ]
    }
  ],
