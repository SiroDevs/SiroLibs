              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini maqa balbala gosa Israelitiifi henna nama boojiani, ka eege lafa ufiti gale:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.8+NEH.7.9+NEH.7.10+NEH.7.11+NEH.7.12+NEH.7.13+NEH.7.14+NEH.7.15+NEH.7.16+NEH.7.17+NEH.7.18+NEH.7.19+NEH.7.20+NEH.7.21+NEH.7.22+NEH.7.23+NEH.7.24+NEH.7.25",
            "verseOrgIds": [
