                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.10+EXO.14.11+EXO.14.12"
              },
              "items": [
                {
                  "text": "14.10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atini gaargala ababoota teenna lafa Misiriti agarte boha worra galaana Diimati d'ageete. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.9",
            "verseOrgIds": [
              "NEH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Bah 7.8—12.32",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atini waan mama Faraofi hojattu isaatiifi nama lafa isaa ch'ufa durati tolchite, wonti akanatiifi atini, aka worri gumi tante dabse, beeta. Gurri atini gaafasi baafate arrale inuma jira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.10",
            "verseOrgIds": [
              "NEH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.21+EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29"
              },
              "items": [
                {
                  "text": "Bah 14.21-29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.4+EXO.15.5"
              },
              "items": [
                {
                  "text": "15.4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atini bisaani galaana gargari qoode, kara gumi teeti tolchite lafa goddu ira taakisiifte; jari gumi suni reebe d'immu bisaani lit'e, d'akhaa galaana diima keesa buu fakaate. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.11",
            "verseOrgIds": [
              "NEH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.21+EXO.13.22"
              },
              "items": [
                {
                  "text": "Bah 13.21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atini guyya baaldo duumansa fakaate worra dura deemte, ammalle halkani goola ibidatini kara worraa ifsite. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.12",
            "verseOrgIds": [
              "NEH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Bah 19.18—23.33",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gaara Sinaiti atini gubbaa gabuute, gumi tanteeti dubbate Seerafi barsiisafi aada dansaafi ta d'uga kenniteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.13",
            "verseOrgIds": [
              "NEH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini aada Sabato qulqullo worra barsiifte, hojattu tante Musani aadaafi Seera worraa kennite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.14",
            "verseOrgIds": [
              "NEH.9.14"
            ]
          }
        }
      ]
    },
