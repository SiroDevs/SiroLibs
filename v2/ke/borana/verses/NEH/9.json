                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yos 3.14-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atini ilmaani heddu aka urji gubba jirtu worraa kennite, lafa ababoota worrati kakhate harka worrati kennite, keesa qubsiifte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
              "NEH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.23"
              },
              "items": [
                {
                  "text": "Yos 11.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri lafa Kanaani dabsate, atinileeni gosa lafa suni keesa teetu harka worrati kennite. Atini gumi tante irre worri gosafi hayyoota Kanaani waan fed'uni tolchu kenniteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.24",
            "verseOrgIds": [
              "NEH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10+DEU.6.11"
              },
              "items": [
                {
                  "text": "Qab-Ser 6.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri kanke dira jajabaafi lafa dadansaafi maneeni miha dansa qabdufi haroole qara qotanifi mukeeni ejersatifi mukeeni mid'aanitifi, zabibule boojie. Waan fed'ani ch'ufa sooratani gabbatanini, waan dansa atini kenniteefi ch'ufa iraa gammadani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.25",
            "verseOrgIds": [
              "NEH.9.25"
            ]
          }
        }
      ]
