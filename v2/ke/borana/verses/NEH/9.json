                "loc": "DEU.1.21"
              },
              "items": [
                {
                  "text": "Qab-Ser 1.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri beelae jennaani qit'a gubbaa buufteefi, worri d'eebonnaani; bisaani d'akha keesaa baafteefi. Atini beena, lafa duri anini isanii kakhad'e fud'ad'a worraani jette. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.15",
            "verseOrgIds": [
              "NEH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.1+NUM.14.2+NUM.14.3+NUM.14.4"
              },
              "items": [
                {
                  "text": "Hen 14.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.26+DEU.1.27+DEU.1.28+DEU.1.29+DEU.1.30+DEU.1.31+DEU.1.32+DEU.1.33"
              },
              "items": [
                {
                  "text": "Qab-Ser 1.26-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo ababooti teenna kiyyibde, mata guddifate Seera kanke guutu didde. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.16",
            "verseOrgIds": [
              "NEH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Bah 34.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Hen 14.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri waan atini tolchiteefi ch'ufa ded'e, Seera kanke guutu dide, waan mama ka atini tolchite ch'ufa wollaale. Ammalle, kiyyibe nama gudda ka tissooma lafa Misiriti worra deebisu tolfate; ammo atini Waaqa namaa araaramu, ka eebaafi naasu qabu, ka hure indallanne. Jaalalti tante guddo, tanaafi atini worra illakisini. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.17",
            "verseOrgIds": [
              "NEH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.1+EXO.32.2+EXO.32.3+EXO.32.4"
              },
              "items": [
                {
                  "text": "Bah 32.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri akheekha korma looni mid'aafate kunini Waaqa lafa Misiri keesaa nu baase jed'e kad'ate! Akanaani guddo si arabse! ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.18",
            "verseOrgIds": [
              "NEH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.2+DEU.8.3+DEU.8.4"
              },
              "items": [
                {
                  "text": "Qab-Ser 8.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo atini maro naasuuni tante guddotifi, lafa aloole keesati worra illakime, baaldoni duumansa guyya worra biraa indeemne ammalle gooli ibida ka halkani kara worraa ifsuleeni worra duraa ingore. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.19",
            "verseOrgIds": [
              "NEH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini lubbu tante dansa nama barsiiftu worraa kennite, sagale Manna jed'ani worra nyaachifte bisaani obaafte d'eebu d'owarte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.20",
            "verseOrgIds": [
              "NEH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna afurtama, ka worri lafa aloo keesa tae, atini worra qorqorate jabeesite, woyaani worraleeni taka inch'ich'inne, miili worraleeni taka inuranne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.21",
            "verseOrgIds": [
              "NEH.9.21"
            ]
          }
        }
      ]
    },
