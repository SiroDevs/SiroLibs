              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atini lafafi gosa d'aatu worra jirtule harka worrati kennite, keesa qubsiifte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.22",
