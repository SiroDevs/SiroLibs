            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gurra woini d'agayanifi ila woini arganile AABBO Waaqati namaa kenne.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
