          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'ugaa qajeelani wollaala intolchu, ilmaani isaaleeni takaa tana eeba argatti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
