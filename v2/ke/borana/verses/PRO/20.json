            "sid": "PRO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dallansuuni hayyuu itansu nyeench'a fakaati, nami isaa dallansiisu seeruma nama ufi ijeese.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daalleeni yoosu namaani woldiddi, ammo nami waan akasi iraa fagaatu nama ch'eera foko qabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami oobru qabu, ka hojja fach'aasa oobru inqotanne, gaafa mid'aani murtani woma inargatu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
