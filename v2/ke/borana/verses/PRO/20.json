          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagaleeni atini kara dabaatini argattu yo atini nyaachu jirtu siti mioofti, ammo eege had'aa siti taati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.17",
            "verseOrgIds": [
              "PRO.20.17"
            ]
          }
        }
      ]
    },
