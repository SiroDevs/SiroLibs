          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi nama waan biimu keesa, miisanafi d'und'umani nama dabsu, injibba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
