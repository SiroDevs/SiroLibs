          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gorsa fud'ad'i woini baata; mala male, woraana fud'atte duula indeemini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.18",
            "verseOrgIds": [
              "PRO.20.18"
            ]
          }
        }
