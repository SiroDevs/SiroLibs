          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoollele woma isiini hojattuuni adaba isii hamafi dansale beekhani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
