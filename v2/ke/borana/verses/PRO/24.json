          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma kiyya, AABBO Waaqa sodaad'i, hayyule saalfad'i. Nama worra kana lamani didu, wahela tolfatte gula indeemini; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        },
        {
          "name": "verse",
