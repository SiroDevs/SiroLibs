          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dabaani ijeechaa geesani lubbu baasi, insodaatini. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato atini, wonti kunini huji tiyyaniti anini keesa imbuu jettele, Waaqi ka herega nama ch'ufa beekhu waan suni inargu? Inni qara siuma eeguu jira, waan kanke ch'ufa imbeekha, inni duuba woma atini tolchitu gula waan sii male si tolcha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "26",
