          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nyaapi kanke gufate jige gaargala keesa seenu ingammadiini. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
