          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daalleeni haguma jirtu jecha qaroo inhubattu. Isiini gaadisa kora keesaleti beete woma indubbatu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
