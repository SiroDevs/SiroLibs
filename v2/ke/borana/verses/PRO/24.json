          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo waan akasi sunii jette, qilit'amte, AABBO Waaqi hegeri herega kanke beekhe, si jibbe, nama kaani lakisa fa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
