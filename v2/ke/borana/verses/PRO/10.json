        {
          "text": "AABBO Waaqi nama d'uga gula deemu beelau d'owa ammo ch'ubbicha waan inni d'araufi ch'ufa ind'owa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
