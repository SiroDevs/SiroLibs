          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami herega qabu, yo mid'aani bilchaatani mure galcha, ammo nami muyooni herega inqamne, yo mid'aani murani rafe gurra ufi balleesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
