              "type": "text"
            }
          ]
        },
        {
          "text": "Qaabachani nama d'uga qaabatani eeba namaa taati, ammo ch'ubbicha maqaani isaa yoosu lafa iraa bada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
