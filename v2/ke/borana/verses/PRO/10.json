          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hojate harka ufitini ufi imbulchine inhiyyoomata, ammo ka harka ufitini woi hojatu woi horata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
