          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dansaani eeba argata, ammo nami hamaani dubbi afaani isa keesaa baatuni hameenna garaa ufi d'ofata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
