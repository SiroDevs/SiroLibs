          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horini atini kara hamaani argate si balleesa, ammo d'ugaani si jireesiti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
