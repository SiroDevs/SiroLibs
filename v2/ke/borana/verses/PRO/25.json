          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama ch'ubbicha hayyuu mala d'au biraa baasi, aka finni inni nama fidu ka d'ugaa tahu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
