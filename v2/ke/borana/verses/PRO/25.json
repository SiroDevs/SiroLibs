              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini mammaasa d'ibi hayyuuni Solomonini mammaakhe ka jari mana hayyu Yuda, ka Hezekia jed'ani keesa hojatu, t'aafe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.1",
            "verseOrgIds": [
              "PRO.25.1"
            ]
          }
        }
      ]
