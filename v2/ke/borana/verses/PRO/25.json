            "sid": "PRO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dandae herega hayyu imbeekhu; heregi isaa nura olfago jira, akuma waaqa olfagaate yokhaani akuma d'immu bisaani gadifagaata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
