              "PRO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gorsi nami wobeekhu nama isa d'agau gorsu qube worqitiifi yokhaani faaya worqi ch'uch'uluqa ira jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
