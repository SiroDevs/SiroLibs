          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damma mia gula nyaate ufira dabarsite indidigini, ammo haguma nyaad'i.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        }
      ]
    },
