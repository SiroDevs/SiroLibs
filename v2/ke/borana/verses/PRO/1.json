              },
              "items": [
                {
                  "text": "1 Hay 4.32",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini mammaasa Solomoni, ilma Daudi, ka hayyu Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mammaasi kunini qaroomafi gorsa dansa namaa kenna, ka hubacha guddole namaa daru. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mammaasi kunini adaba dansa namaa kenne nama d'ugaa qajeela, ka nama gargari infille, nama tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni nama woma imbeenne woi barsiise, kaimale beekhaafi qalbi dansa kennafi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mammaasi kunini nama wobeekhule beekha dare, nama wobaratele qajeelcha, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka akanaani worri dubbi mammaasa hubate, gaafi worri qarooni gaafatule qajeelche deebisu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka kaima gorsani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
