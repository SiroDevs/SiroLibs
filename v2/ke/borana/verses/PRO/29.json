          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami d'ugaa lafa mohatu nami ingammada, ammo yo ch'ubbichi lafa mohatu nami gaargale gunguma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
