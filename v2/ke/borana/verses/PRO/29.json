          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo hayyuuni d'uga gula deemu lafti inni mohatuleni injabatti, ammo yo inni beesuma ch'alla gula deeme gumbo nama iraa fud'ate, lafuma ufi balleesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
