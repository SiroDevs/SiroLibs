          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dansaani hiyyeesaa dubbate aka isa dabsani dida, ammo ch'ubbichi waan suni woma ira inqabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
