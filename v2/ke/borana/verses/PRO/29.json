            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami namuma ijeesu ch'alla barbaadu, nama d'ugaa injibba, ammo nami qajeelani nama akana kana qorqorate lubbuu baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        },
        {
