          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nama d'ibi tufatu nama dira keesa jiru ch'ufa wolti naqa, ammo nami woi beekhu nagaya barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
