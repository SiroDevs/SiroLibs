              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami kara ufi ch'ufa qajeela seha, ammo AABBO Waaqi herega nama ch'ufa imbeekha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
