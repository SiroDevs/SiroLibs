          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ch'ubbicha inhalchini, ammo hojja ch'ufa AABBO Waaqa sodaad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        },
        {
          "name": "verse",
