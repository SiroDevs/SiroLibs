          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma kiyya, ch'aqasi, qalbeefad'i, kara qajeela gula deemtu jabeesi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama farso d'uge machaufi nama sagale nyaate inquumne wahela intahini. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi sabdiifi nami machaauleeni inhiyyoomata. Yo wontumaani atini hojattu waan suni ch'alla taate, d'iotu ch'arqi naqata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
          }
        }
      ]
    },
    {
