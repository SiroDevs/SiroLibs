            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horini kara ch'ubbutini argatani imbada, ammo ato imbanne boola dua keesa si buusa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.6",
            "verseOrgIds": [
              "PRO.21.6"
            ]
          }
        }
