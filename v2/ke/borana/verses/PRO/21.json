              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami waan tolchu ch'ufa qajeeltu seha, ammo AABBO Waaqati herega nama ch'ufaa beekha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.2",
