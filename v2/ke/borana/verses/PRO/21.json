              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ch'ubbichi ufumaa saaditifi kiyyibuma ch'alla gula deema, ammo wonti kunini ch'ufti daba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.4",
