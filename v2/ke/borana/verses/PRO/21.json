          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami mala qabu waan heddu argata, ammo nami arifate wo tolchu waan nyaate d'ugule ind'aba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.5",
            "verseOrgIds": [
              "PRO.21.5"
            ]
