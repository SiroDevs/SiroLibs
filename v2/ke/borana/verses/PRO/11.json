          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Waaqa imbeenne afaanuma ufitini olla ufi balleesa, ammo nami d'ugaa qaroomuma ufitini ufi baasa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
