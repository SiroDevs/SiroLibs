              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami namaa nahu woi ufi mid'aasa, ammo nami naasu inqamne woi ufi duraa yaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.17",
