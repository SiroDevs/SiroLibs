          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja ch'ubbichi duu, d'aabuuni isaleeni isuma woliini dooti, wonti inni heregate ya muumme baate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
