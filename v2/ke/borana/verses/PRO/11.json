            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiti ch'eera foko qabdu, insaalfatanifi, ammo niitiini ch'eera inqamne waan fokoti. Nami laafaani woma inhojanne haga jiru woma inhoratu, ammo nami irreeni woi barbaadu hori horata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
