          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama woma ind'ossine, ka hamtu namaa dubbatu, woma iti himu himmalle, ammo nama quufani waan d'ossale iti himani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
