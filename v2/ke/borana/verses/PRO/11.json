          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami d'ugaa woi horatu diri inni keesa tauleeni ingammada, yo ch'ubbichi duu nami wolti bahe gammade sirbe lalaba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
