        },
        {
          "text": "AABBO Waaqi nama miisana woini biimu keesa nama dabsu injibba, ammo nama misana qit'eese woi biimu injaalata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
