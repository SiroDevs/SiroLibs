          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dansa d'ugaa isaati qajeelcha, ammo nami nami ind'ugeefanne ch'ubbu ufitini bada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
