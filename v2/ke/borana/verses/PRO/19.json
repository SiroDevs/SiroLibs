          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dallansuuni hayyuu itansu nyeench'a fakaati, ammo naasuuni isaa akuma bokaya roobuti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
