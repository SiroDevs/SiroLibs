          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo atini nama qalbi qabu taate miira guddata. Yo nama siti wollaale biraa deemteefi, ya waan dansa taate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.11",
            "verseOrgIds": [
              "PRO.19.11"
            ]
          }
        }
