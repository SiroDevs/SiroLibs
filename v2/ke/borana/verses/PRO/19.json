          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi daallichi abba ufi balleesa. Niitiini d'ibditini, hojja ch'ufa lola deemtu, akuma d'impu bokaya d'impifti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
