              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami abba ufi ira manafi horile ind'aala, ammo niiti wo beetu AABBUMA Waaqati kennafi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
