              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyyeesa ch'ubbu inqamneti daalle kiyyibdu ira gooma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
