            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.27"
              },
              "items": [
                {
                  "text": "Mar 14.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " AABBO Waaqi Guddaani waan jed'u, Goraade, kai, tissitu tiyya, ta ree naa tissitu, had'i ijeesi; duuba reeni gargari bitinoofti. Anini gumi tiyya had'a, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba lafa tana ch'ufa keesa nama sadi keesaa nama lama balleesani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini tokocha hafe kaani ibida keesa kaye qulqulleesa, akuma qarsi ibidaani qulqulleesani yokhaani dansuma worqi ibidaani ilaalani. Duuba worri na yaamate, anileeni worra jala owaad'e waan jed'uuni, Worri kunini gumi tiyya. Worrileeni waan jed'u, AABBOONI Waaqa keenna.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalemufi gosa d'ibi",
          "type": "text"
        }
      ]
    }
