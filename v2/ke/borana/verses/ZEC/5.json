            "sid": "ZEC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini ammalle olmillad'e, maro tana woraqata barisu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani waan anini arge na gaafatte, jennaani anini waan jed'eeni, Woraqata barisu arge jed'eeni. D'eerinni isaa d'und'uma diddamaati, ballinnileeni kud'ani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isiini waan naani jette, Woraqata suni irati abaarsa lafa ch'ufa keesa ergani irati t'aafani. Gama isii toko waan irati t'aafani, Hattu ch'ufa lafa keesaa balleesani; gama kaanile wonti irati t'aafani, Nama waan d'ara kakhatule lafa keesaa balleesani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani waan jed'u, Anini woraqata abaarsa ira t'aafani kana lafa keesa erga; duuba inni mana hattu ch'ufafi ka nama waan d'ara kakhatuti seene, mana suni keesa tae, balleese gargari jissa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Niiti sanduqa keesa jirtu ta daayyani argani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani gadeebite waan jette, Me, waan gabahuu jira laali! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.5",
            "verseOrgIds": [
              "ZEC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, Maani jed'e gaafad'e. Isiini waan naani jette, Sanduqa ka ch'ubbu lafa ch'ufa akheekhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanduqi sunini qadaada qaba, ka sibiila qalaitiini mid'aasani. Ato anini laalu, qadaadi old'iibame, yo ani jed'e, niiti tokoti keesa taa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani waan jette, Niitiini tunini akheekha ch'ubbuu. Eegi akasi jette, niiti taani sanduqa keesati gad'iibde qadaada iti deebifte. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini ammalle millad'e jennaani nad'eeni lama ta koola jajaba aka baboaloona qabdu, ta gara kiyya barriftu arge. Worri sanduqa kaani fuud'e barise itiini d'aabate.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini malaika gaafad'e, Worri eesaani yaa jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan naani jette, Lafa Babiloni geesani — achiti mana iti jaarani. Eegi mana suni ijaarani, sanduqa suni fulla mid'aasanifi keesa d'aabani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaari afuri ka daayyani argani",
          "type": "text"
        }
      ]
    }
  ],
