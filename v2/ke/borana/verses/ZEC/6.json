              "attrs": {
                "loc": "REV.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gaari qara fardoole dadaamati hirkisa, ka lameeso guguraatiti hirkisa, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
          }
        },
        {
