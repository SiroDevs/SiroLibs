                "loc": "REV.6.2"
              },
              "items": [
                {
                  "text": "Mul 6.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ka sadeeso bororati hirkisa, ka afreeso dadaamititi hirkisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini malaikaani, Aabbo, wonti kunini maani? jed'e gaafad'e.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
          }
        }
      ]
    },
