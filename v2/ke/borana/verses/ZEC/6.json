        },
        {
          "text": "Anini ammalle olmillad'e, maro tana gaari afuri, ka jiddu gaara sibiila daalacha lama gabahu, arge. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
