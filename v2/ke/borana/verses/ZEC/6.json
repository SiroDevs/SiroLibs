            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami lafa fagooti d'ufe ijaarsa Mana Waaqaa qarqaara. Eegi jaarani, aka AABBO Waaqi Guddaani na erge beetani. Yo isani seera AABBO Waaqa keesani aka dansaa guuttani, wonti kuni ch'ufti intaati.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka nama waan d'araati ufi agabse iraa dubbatani",
          "type": "text"
        }
      ]
    }
