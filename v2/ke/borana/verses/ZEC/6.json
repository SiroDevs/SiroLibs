              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Isiini waan naani jette, Kunini qilleensa afuri, ka ammumatana abba lafa ch'ufa iraa d'ufe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
