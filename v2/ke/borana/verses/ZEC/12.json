                  "text": "Mul 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini ilmaani Dauditifi worra Yerusalemu kaani d'ibi herega naasutiifi ka kad'achatiini guuta. Duuba namicha woraanaani ijeesani kaani laalani, akuma nama ilma tokocha bohu bohaniifi. Aka worri ilmi angafa iraa due bohu, garaa hamaatani bohaniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi booti Yerusalemu keesa aka gaafa Hadadrimoni diida Megido keesa bohani taati. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri lafa keesa jiru ch'ufti koba kobaa boha: worra Daudi iraa bahe, ka Nathani iraa bahe, ka Lawi iraa bahe, Shimei iraa bahe, ammalle worri kaani ch'ufti akasuma boha. Worri ch'ufti koba kobaa boha, nami d'iira ka worraa ch'ufti koba bohe, nad'eenileeni kobati booti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12+ZEC.12.13+ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.12",
              "ZEC.12.13",
              "ZEC.12.14"
            ]
          }
        }
