              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani na yaame waan naani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan anini jed'u, Guyyaani ufi agabsani ka jia afreesotiifi ka shaneesotiifi ka torbeesotiifi ka kud'anneeso garagale jila gammadafi qilit'ama worra Yudati taha; tanaafi d'ugaafi nagaya jaalad'a.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani waan jed'u, Guyyaani ind'ufa, ka nami dira heddu keesaa bahe Yerusalemu d'ufu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dira toko keesa jiru waan worra dira d'ibitini jed'u, Koota, woliini yaane, AABBO Waaqa kad'anne eeba iraa fed'anna. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ZEC 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama heddufi gochiti jabeenna qabdu Yerusalemuti d'ufte eeba iraa fed'atti. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ZEC 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi nama kud'ani, ka gosa gosa, nama Yahudi tokoti d'ufe waan jed'uuni, Waan nu d'ageenne, Waaqi isani woliini jira, tanaafi isani woliini yau feena.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.23",
            "verseOrgIds": [
              "ZEC.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka gosa d'aatu jirtu wollaala iti murani",
          "type": "text"
        }
      ]
    }
  ],
