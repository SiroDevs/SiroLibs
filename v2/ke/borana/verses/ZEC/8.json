      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani na yaame waan naani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.1",
            "verseOrgIds": [
              "ZEC.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini dira Yerusalemu guddo jaalad'e qarqaaru fed'e, tanaafi nyaapa isaati guddo dallane. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle anini waan jed'u, Anini dira kiyya qulqullo Yerusalemuti deebie keesa taa. Isa dira d'ugeefatani jed'aniini, gaara AABBO Waaqa Guddaa, gaara qulqullo jed'aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle jaaroleeni uwatiifi ta d'iira ta uleeni yaatu, deebite garaa dira suni keesa teeti. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle kara isaale ijoolle d'iiratiifi ta dubra ta tabatuuti guuta.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woni kunini nama hafe waan intaane fakaatti, ammo naa intaati. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.6",
            "verseOrgIds": [
              "ZEC.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Anini gumi tiyya ta boojiani lafa d'ibi geesani baase, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaborutiifi ila galchule woltiini d'ufe, Yerusalemu qubachiisa. Worri gumi tiyya tahe, anileeni Waaqa worraa, ka d'ugaafi qajeelumaani worra fidu, taha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabaad'a! Isani amma dubbuma raagooti duri, gaafa yayaba Mana kiyya kayani dubbatte, d'agayuu jirtani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya suni durati nami tokoleeni dandae nama yokhaani horile inkirrefatu, nami tokoleeni dandae fulla tokole inchochou. Wonti akanatiifi anini gaafasi nama wolti naqa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini ammatana nama hafe kana aka d'ibi tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri nagayaani mid'aani ufii fach'aafate, zabibuleeni mid'aani baafte, laftileeni mid'aani baafte, bokaya guddale argata. Anini eeba tana ch'ufa nama gosa tiyya ka hafeti kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.12",
            "verseOrgIds": [
              "ZEC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle isani, worra Yudatifi ka Israeli! Duri nyaapi woli abaare waan woliini jed'e, Akuma Yerusalemufi Yudaani gaargala argate, Waaqi isani gaargalchinna! Ammo eegi anini taka tana isani baasu, nyaapi kaani akana woli eebisa: Waaqi akuma Yudafi Israeli eebise isani eebisinna! Tanaafi jabaad'a, insodaatina!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.13",
            "verseOrgIds": [
              "ZEC.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani waan jed'u, Gaafa ababooti teesani na dallansifte, anini waan hamtu worra balleesa iti malad'e, herega kiyya suni garagalfachu dide guute. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo amma tana anini worra Yerusalemutiifi ka Yuda mala eebisufi harkaa qaba; tanaafi insodaatina! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.25"
              },
              "items": [
                {
                  "text": "Efs 4.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Woni isani tolchu maltani kana: D'uga wolti dubbad'a, fulla gaadisa qorsuma d'uga gula woi qora — d'uga ta nagayaani d'uftu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
              "ZEC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala hama woliini yakitani inqabaatiina, kakhattani d'ara indubbatiina. Anini d'ara dubbachafi waan hamtu akana ch'ufa guddo jibba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        }
      ]
    },
