      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani AABBO Waaqi tae nama qoru ya d'iaate. Gaafasi Yerusalemu saamani, waan saamani suni ila teesani durati qoodatani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi gosa ch'ufa woltiini d'ufe Yerusalemu haasisa. Dira qabani, maneeni saamani, nad'eeni buufatani. Gumi suni wod'akumati gargari kutani boojiani ta hafte woma intolchani dira keesati lakisani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi kae, gosa suni ch'ufa aka inni duri had'e had'a. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi inni Gaara Ejersa, ka Yerusalemu ilaboru, gubba eja. Duuba gaara suni ilaboruti fuud'ani, ila galchuti d'aabani, gargari tarsaasani, bale jiddu baasani, aka gaari sunini gami toko mirga deeme, gami kaani bita deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isani bale gaara kana gargari kutu keesa baqattani. Isani akuma ababooti teesani duri, gaafa hayyuuni Yuda, ka Uzia jed'ani, lafa fide, lafti chochoote baqatte, baqattani. Duuba AABBO Waaqi kiyya, malaika ch'ufa woliini, gad'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja guyyaani sunini gahe, qabbanafi yokhaani maganule deebiani inargani, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yokhaani dukanale. Hojja ch'ufa ato halkanile taate ifsaati jira. Gaafa wonti kunini taatu nami beekhu AABBO Waaqa ch'alla.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        }
      ]
    },
