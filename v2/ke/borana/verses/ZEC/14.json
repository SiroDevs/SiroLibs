          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya gaafasi agalo fardale dubbi tana irati qorani: Waan qulqulleesani AABBO Waaqaa olkayani. Okoteeni Mana Waaqaa keesa jirtu, akuma qorini ta fulla sorio Waaqaa baasani dura kayani qulqullo, qulqullo taati. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoteeni Yerusalemufi Yudea keesa jirtu ch'ufa qulqullo jed'ani olkayani, aka huji kad'acha AABBO Waaqa Guddatini hojatani. Ammalle nami sorio Waaqaa baasu qori suniini fooni sorio d'aaba. Hojja guyyaani sunini gahe, dilaaltuni tokoleeni Mana AABBO Waaqaa keesati inhaftu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.21",
            "verseOrgIds": [
              "ZEC.14.21"
            ]
          }
        }
      ]
