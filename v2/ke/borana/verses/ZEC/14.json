              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi ch'iisa jaba gosa worra Yerusalemu haatuti buusa. Nafi worraa, ato worri jirjiru shame ch'ich'ite, ilaafi arabi worraleeni akanumati fulla jiruti shama.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya gaafasi AABBO Waaqi nama ch'ufa mudamsiise, nami waan tahu wollaale nama wahela isa, ka isa d'aatu jiru, qabe balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yudaleeni woraana suni seene Yerusalemu kalcha. Ammalle waan gochiti d'aatu jirtu ch'ufti qabdu, worqi taanaani, qarsi taanaani, woya muumme inqamnele taanaani, saamani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'ukubi hamaani akasi ammalle fardofi gaangefi gaalafi harrele qabata — hori nyaapa suni ch'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
