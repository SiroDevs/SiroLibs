                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Mul 22.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hojja guyyaani sunini gahe, bisaani ch'ulkiini Yerusalemu keesaa yaani, hagi toko galaana ilaboruti yaani, hagi tokoleeni baariini ila galchuti yaani. Bisaani suni hojja roobatiifi hojja bonale ch'ufa yaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi hayyu lafa ch'ufaa tahe, nami ch'ufti aka Waaqa isa guddise maqa isaa ka AABBOTIINI isa beekha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa ch'ufa Geba ta mirga jirtu fuud'ani Renoni ta bita Yerusalemu jirtu d'aabani diideesani woliini d'aqani. Ammo Yerusalemuni lafa d'aatu jirtu taani ch'ufa keesaa olbaate, haga fullo Benjaminitifi fullo Moga, ta duri fullo d'ibi qabdu geete, ammalle haga Doofi Hananeliti baate haga fulla daad'i hayyu iti mid'aasanileti ejiti. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Mul 22.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami arti isa keesa nagayaani taa, deebiani dira suni imballeesani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
