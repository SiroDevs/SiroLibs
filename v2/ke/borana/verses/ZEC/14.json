            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.39+LEV.23.40+LEV.23.41+LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Law 23.39-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani nami gosa Yerusalemu haate ka iraa hafe, ganna ch'ufa achi yae AABBO Waaqa Gudda aka hayyu kad'ate jila Hoosa tolfata. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo gochiti tokoleeni AABBO Waaqa Gudda aka hayyu yaate kad'achu didde, lafa worraa bokayi irroobu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri Misirileeni jila Hoosa tolfachu dide, worrale d'ukubuma AABBO Waaqi gosa ch'ufa ta yau didde iti erguti qabata. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargali worra Misiritiifi gosa d'ibi ch'ufa, ta jila Hoosa tolfachu didde qabatu, kana.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
