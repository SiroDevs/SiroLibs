              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.5",
            "verseOrgIds": [
              "JER.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi gumi ufi himatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli Waaqa lakimnaani gaargala argate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli AABBO Waaqa kad'achu dide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.19",
            "verseOrgIds": [
              "JER.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.20",
            "verseOrgIds": [
              "JER.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli gaargalchu malani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Akuma hattuuni hojja qabani ch'eertu, isanileeni gumi Israeli akasuma ch'eertani — hayyootafi jaarole teesanifi qaaloleefi raagooti teesanileeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani ch'ufa inch'eersani, ka mukhaani, Aabbo jettani, D'akhaani, siti na d'ale jettani. Wonti akasi isani tolchanifi waan isani dudda nati galtani, fuula naraa deefattaniifi. Ammo hojja gaargali isaniti d'ufu, nati d'uftani, kooti, nu baasi jettani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi isani mid'aafattani meeti? Yo isani gaargala qabaatani ha isani baasuti, yo dandae! Yuda, waaqi kanke akuma dira keeti heddu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.28",
            "verseOrgIds": [
              "JER.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungumsuni te maani? Maafi nati garagalte na didda? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato anini isani gaargalchele, wonti sunini woma isanii imbaane. Isani wollaala keesani iraa deebiu diddani. Isani ya akuma nyeench'a dallane, raagoota teesani hobaaftani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.30",
            "verseOrgIds": [
              "JER.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Israeli, dubbi tiyya ch'aqasa. Anini yayu aka lafa aloo ta gamooji, yokhaani aka lafa dukanooftu soda qabdu, isaniti tahe? Isani duuba maanifi, Nu waan feenu taana deebine siti indeebinu nani jettani? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.31",
            "verseOrgIds": [
              "JER.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini d'io fuud'ani, faaya isii indeeti? Intalti fuud'a indeeti? Ammo gumiini tiyya yayu guyya heddu muumme inqamne na deete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.32",
            "verseOrgIds": [
              "JER.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani d'uguma jaala barbaadu beetani. Nad'eeni nad'eeni ch'ufa ira hamtuleeni dandeete isani iraa wo baratti! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woyaani teesanileeni d'iiga hiyyeesatiifi nama woma iyyakini qabdi, ammo d'iiga nama mana ch'abse nama saamu inqabdu. Ammo taatule, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "isani, Nu woma iyyakine; Waaqileeni deebie nuti indallanu jettani. Ammo anini, AABBO Waaqi, wollaala isaniti mura, waan isani, Nu daba intolcheni jettanifi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.35",
            "verseOrgIds": [
              "JER.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani maanifi akana finna keesani jijirtani, waaqa gosa d'ibi gula yaatani? Akuma worri Ashuruu isani sobe, worri Misirileeni isani soba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.36",
            "verseOrgIds": [
              "JER.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani ch'eertani, mata lafa buuftani, worra Misiri biraa yaatani. Anini, AABBO Waaqi, worra isani d'aabattani suni ya dide; isani worra suni woma iraa inargattani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.37",
            "verseOrgIds": [
              "JER.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Israeli Waaqa dide",
          "type": "text"
        }
      ]
    }
  ],
