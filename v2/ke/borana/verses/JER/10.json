      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Faaru Waaqani faarsani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worra Yerusalemu boojiani",
          "type": "text"
