              "items": [
                {
                  "text": "Mul 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "T'iyoleeni, Babiloni had'a jed'a. Nama t'iyaafi guubeeni woi had'u beekhu ch'ufa yaama. Dira marsa, nama baqachu fed'u, d'owa. Waan isiini tolchite isumati deebisa, woma isiini nama tolchite isiile tolcha; wonti akanatiifi isiini ana, qulqullo Israeliti kiyyibde. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi nama isi ka kaima ch'ufa kara dira keesati fit'ani, askarti isii ch'ufale guyya suni fit'ani. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
