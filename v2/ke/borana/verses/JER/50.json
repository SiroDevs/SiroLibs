              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 50:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babiloni, kiyyibi ya sira dabre, tanaafi anini, AABBO Waaqi guddaani, nyaapa siti tahe! Hojaani anini si gaargalchu ya geete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.31",
            "verseOrgIds": [
              "JER.50.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 50:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gochiti teesani kiyyibduuni gugufate jidde, nama tokole ka olfud'u d'abdi. Anini dira keesani ch'ufa ibida iti kaye, waan d'aatu jira ch'ufa balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.32",
            "verseOrgIds": [
              "JER.50.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 50:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.32",
            "verseOrgIds": [
              "JER.50.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 50:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u, Worra Israelitiifi ka Yuda ya dabsani. Nami worra qabe ch'ufti guddo worra tisse gad'iisu dide. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.33",
            "verseOrgIds": [
              "JER.50.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 50:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nami worra baasu jaba; maqaani isaa AABBO Waaqa gudda. Isumati worraa dubbate nagaya lafatini d'ufe, ammo gaargala worra Babilonitini d'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.34",
            "verseOrgIds": [
              "JER.50.34"
            ]
          }
        }
      ]
    },
