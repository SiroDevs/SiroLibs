          "items": [
            {
              "text": "\n        Isa 13.1—14.23",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.1+ISA.47.2+ISA.47.3+ISA.47.4+ISA.47.5+ISA.47.6+ISA.47.7+ISA.47.8+ISA.47.9+ISA.47.10+ISA.47.11+ISA.47.12+ISA.47.13+ISA.47.14+ISA.47.15"
              },
              "items": [
                {
                  "text": "47.1-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti dira Babilonitifi nama isa ke tau tolchani, ka AABBO Waaqi nati d'aame, kana:",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        }
