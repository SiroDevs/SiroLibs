              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.35",
            "verseOrgIds": [
              "JER.50.35"
            ]
          }
        }
