              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan AABBO Waaqi nyaapa Israeli tolchu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Anini gosa d'aatu Israeli teetu, ta lafa anini gumi tiyya ta Israeliti kenne balleesite, dubbi iraa qaba. Anini worra hamama suni lafa isaani keesaa aka mukha buqise, Yudale harka worraa jalaa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo eegi worra akasi tolche, deebie worraa nahe, gosa ch'ufa lafa isaanitiifi arda isaaniti deebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo worri garaa tokooni aada gumi tiyya barate maqa AABBO Waaqatini wo kakhate — akuma duri worri gumi tiyya aka Baalini kakhatani barsiise — duuba worri gumi tiyya keesa fulla argate wo horata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo gochiti tokoleeni ch'aqasu didde, anini gosa suni aka mukha buqise balleesa. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hid'a boofta",
          "type": "text"
        }
      ]
    }
  ],
