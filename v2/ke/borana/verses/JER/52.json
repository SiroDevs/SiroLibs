            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26+1KI.7.27+1KI.7.28+1KI.7.29+1KI.7.30+1KI.7.31+1KI.7.32+1KI.7.33+1KI.7.34+1KI.7.35+1KI.7.36+1KI.7.37+1KI.7.38+1KI.7.39+1KI.7.40+1KI.7.41+1KI.7.42+1KI.7.43+1KI.7.44+1KI.7.45+1KI.7.46+1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Hay 7.15-47",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri Babiloni utuba sibiila diimani mid'aasanifi waan gaari fakaata ka Mana Waaqa keesa jiru ch'ufafi haro gingiti sibiila diimani mid'aasanile ch'ufa ch'abse akanaani waan sibiila diimani mid'aasani suni ch'ufa lafa Babiloni geese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri daboolafi eele daara iti haranifi miha ifseeni qorqoratanifi qori d'iiga sorio iti naqanifi qori hit'aana iti aarsanifi miha Mana Waaqatini hojatani, ka sibiila diimani mid'aasani ch'ufa, guure itiini d'aabate. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri waan worqifi qarsiini mid'aasani ch'ufa guure itiini d'aabate: qori didiqofi daboola ch'ile ibidatini fuud'anifi qori d'iiga sorio iti naqanifi eele daara iti haranifi waan ifse ira d'ad'aabanifi eele hit'aanatifi qori daad'iini d'ibaayu baasanile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miha Solomonini sibiila diimani Mana Waaqati mid'aase — utuba lamaanifi waan aka gaari kaanifi haro gingiti taanifi waan aka koromi looni ta sibiila diimani mid'aasani, ta isiini ira ejitule, dandaani ulfinna isii haga imbeekhani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utubaani lamaani haguma taka: Old'eerinni isaa d'und'uma kud'ani saddeeti, ballinni mata isaa d'und'uma kud'ani lama. Utubaani sibiila mid'aasani suni lachu aka d'uyuma jira, furdinni afaani isaa haga gana harkaa. Utuba suni lachu gubbaa waan aka sure ka sibiila diimani mid'aasaniti jira, ta kamu d'eerinni isii d'und'uma shani, ammalle waan aka okhoku ka sibiila diimani mid'aasanini marsani barreesani ch'okhani. Waan kana ch'ufa sibiila diimani mid'aasani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21+JER.52.22",
            "verseOrgIds": [
              "JER.52.21",
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barru utuba suni lamaani ch'ufa irati waan aka okhoku ka d'ibba tokoti jira; nami jala eju waan suni sagaltami jaa ilaani inarga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worra Yuda Babiloni geesani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tana male Nebusaradanini, ka gudda askarti, qaallicha gudda Seraya jed'anifi Sefania ka isati aanufiufi ammalle jara gugurda Mana Waaqa keesa hojatu nama sadi qaqabe Babiloni geese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira keesa inni nama askarti ch'ufaa matatiifi nama torba ka makala hayyu, ka dira keesati hafefi namicha nama askartiti mataati aanu, ka waan askarti lafa suni ch'ufa t'aafufi, ammalle nama jaatama d'ibii, ka gurra qabu, ch'ufa woliini qabe geese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebusaradanini, ka gudda askarti, worra kana ch'ufa guure, hayyu Babiloni, ka dira Ribla jiruti geese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiti lafa Hamathiti, hayyichi worra gaargalche d'aane hobaase.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akanaani worra Yuda lafa worra keesaa boojiani, lafa d'ibii geesani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini henna worra Yuda ka Nebukadrezani boojie: ganna torbeeso ka mohacha isaa, inni nama kuma saditifi diddami sadi boojie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ganna kud'ani saddeeteeso nama d'ibba saddeettifi sodomi lama Yerusalemu keesaa boojie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle ganna diddami sadeeso keesa, nama d'ibba torbatiifi afurtami shani Nebusaradanini boojie. Nami worri boojie ch'ufti wolti nama kuma afurtifi d'ibba jaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna sodomi torbeeso, ka hayyu Yekonia boojiani guyya diddami shaneeso, ka jia kud'ani lameeso Evil-Merodakini hayyu Babiloni tahe, duuba inni Yekonia hayyu Yudati nahe, hid'aansa keesaa baase. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasiini inni Yekonia dubbi dansa iti dubbatte, hayyoota isa woliini boojiani taani ch'ufa ira isa ulfeese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi Yekoniani woya gaafa isa hid'aani taani keeyachiisani taani baafate, mana hayyu keesa hayyu woliini gololfate. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga inni jiru ch'ufa guyya ch'ufa beese waan isaa male kennanifi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
  ],
