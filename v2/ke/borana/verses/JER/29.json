                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Od-dur 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini gara qaaloleetifi raagootafi jaarole gumitifi nama Nebukadrezani Yerusalemu keesaa boojie Babiloni geese ch'ufa tatabe tana t'aafe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini eegi hayyu Yehoiakinifi haad'a isaatifi hojattu mana hayyutifi jaarole Yudatifi ta Yerusalemutifi ogeeyifi nama huji harkaa beekhu ch'ufa boojiani tatabe tana t'aafe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini tatabe tana harka Elasa, ilma Shafanitifi Gemaria ilma Hilkia. Ka, Sedekiani hayyuuni Yuda Nebukadreza hayyu Babiloniti erguti kenne. Tatabeeni suni akana jetti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi, guddaani Israeli, waan nama ch'ufa ka Nebukadrezani Yerusalemu keesaa fuud'e Babiloni geesaani jed'u: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana jaarad'a iti gala; oobru oobrad'a, waan isiini baaftu nyaad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wolfuud'a ilmaani d'ala; ilmaani teesanile wolfusisa, worrileeni ha ilmaani d'aluti indiqaatina, hora, lafa ira dabra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira anini iti isani geese suni keesati nagayafi hormaata barbaada. Worra dira suniiti jed'a, Waaqa kad'ad'a, wonti akanatiifi yo worri hore isanileeni ya hortani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini AABBO Waaqi Israeli waan isaniini jed'u, Raagootafi worri wo himu, ka isani woliini tau, isani insobini. Oobju worrale inch'aqasina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri maqa kiyyaani waan d'araa isanii faguu jira, anini worra inergine. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
