            }
          ]
        },
        {
          "text": "Hayyuuni Yuda, ka Sedekia jed'ani, Pashuri ilma Malkiyafi qaallicha Sefania ilma Maaseya nati erge, waan nani jed'e: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
