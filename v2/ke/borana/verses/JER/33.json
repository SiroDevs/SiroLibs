                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u guyyaani ind'ufa, ka anini kakhu duri worra Yerusalemutifi ka Yudati kakhad'e guutu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi anini d'aloota Daudi keesa nama d'ugaa toko fohad'e, hayyu tolcha. Inni waan d'ugaatifi ka qajeela lafa suni keesati tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Yudatifi ka Yerusalemu lubbu baasani nagayaani teesisani. Dira sunile maqa iti baasani, AABBO Waaqi D'uga teenna jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        },
