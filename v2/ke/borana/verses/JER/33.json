                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Nama d'aloota Daudi, ka hayyu Israeli tahu ind'abani, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
