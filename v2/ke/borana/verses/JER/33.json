            }
          ]
        },
        {
          "text": "AABBO Waaqi waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini yayu halkanifi guyyale wold'aqisa woliini tolfad'e, aka worri hojja ch'ufa hojuma malte gula d'ufu; wold'aqisa suni dandaani inch'absani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasuma anini hojattu tiyya Daudi wold'aqisa woliini tolfad'e, aka d'aloota isaa keesaa nama hayyu tahu ind'amne. Ammalle anini qaalole gosa Lawi wold'aqisa woliini tolfad'e, aka isiini hojja ch'ufa; naa hojatu; wold'aqisa suni lachu dandaani inch'absani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini d'aloota hojattu tiyya Dauditifi qaalole gosa Lawi daraarse lafa ira dabarsa duuba akanaani worri lafa ira dabre, akuma urji gubbatiifi maansa afaani galaanale dandaani inhenne worrale akasuma dandaani inhenne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
