      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato anini ammalle hid'aansa naabo kaani keesa jiru, ammalle AABBO Waaqi naani dubbate. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi ka lafa uume mid'aase jabeese, ka maqaani isaa AABBO Waaqa, waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yaami si, jalaa owaad'a, duuba waan mama dansa ka atini waan isii imbeenne siti hima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi Israeli, waan jed'u, maneeni Yerusalemutifi mana hayyu ka Yudale imballeesani. Yo nami bahe worra Babiloni ka biyye tuule dira kanaani marse had'ele hujiini sunini woma imbaatu. Ammo wonti isiini d'uftuni, reefuma nama anini dallansu tiyya keesa hobaase, ka dira kana keesa guute ch'alla. Anini yayu dira kana fuula iraa deefad'e, maro nami isa keesa tau waan hamtu tolcheefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4+JER.33.5",
            "verseOrgIds": [
              "JER.33.4",
              "JER.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini dira kanafi nama isa keesa tau, d'ukuba iraa d'owe fayya kenneefi nagayafi hormaatale kennafi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini worra Yudatifi ka Israeli eebise, finna duri worri keesa jiruti deebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini ch'ubbu worri duri nati ch'ubbame ch'ufa iraa qulqulleese, wollaala worri na dide keesa seene ch'ufa araaramaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diri kunini gammadafi ulfinnaafi gurraani naa d'ufa; ammalle gochiti ch'ufti sodaate mudamti, hojja waan dansa anini worra Yerusalemuti tolcheefi hormaata anini dira sunitini d'ufu d'ageetu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        }
      ]
    },
