              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.22",
            "verseOrgIds": [
              "JER.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi, guddaani Israeli, waan jed'u, Gaafa anini gumi tana lafa isiiti deebisu, isiini deebiteti lafa Yudatifi dira isii keesati waan jettu, AABBO Waaqi gaara qulqullo Yerusalemu fulla inni tau eebisinna. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami lafa Yudatifi dira isii ch'ufa keesa tae, nami oobru qotufi ka ree tissuleeni woliini taa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.24",
            "verseOrgIds": [
              "JER.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nama dad'abi qabu hafuura baase, nama beelti ijeefte sagale quubsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
              "JER.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba gaafasi nami, Anini rafe, ka dad'abi inqamne lafaa kae jed'a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi, waan jed'u, Guyyaani ind'ufa, ka anini lafa Israelitiifi ta Yudale namaafi saani guutu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle akuma duri anumani aka mukha worra buqise qaarise, garagalche, bulleese butuche, akasuma anini amma tana aka mukhaa worra oobre, aka mana jaara. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Eze 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja guyyaani sunini gahu nami deebie, Abbootini mid'aani zabibu kurao nyaate, ammo ilmaani ilkaani diilalaani injed'u. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nami ch'ufti daba isatini dua, ammalle nami zabibu kurooftu nyaatu ilkaanti diilalaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.30",
            "verseOrgIds": [
              "JER.31.30"
            ]
          }
        }
      ]
    },
