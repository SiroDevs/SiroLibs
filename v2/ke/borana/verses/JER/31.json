        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Guyyaani ind'ufa, ka anini gosa Israeli ch'ufaa Waaqa tahe, worrileeni gumi tiyya tahu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti AABBO Waaqi jed'u tana: Nama woraana jalaa bahe anini lafa gamoojiti naheefi. Gaafa gumiini Israeli guddo boqochu feete, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.2",
            "verseOrgIds": [
              "JER.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini fago worrati mullad'e waan jed'e, Worra Israeli, anini haguma duriti isani jaalad'e, tanaafi hojja ch'ufa jaalala tiyya ta muumme inqamne isani agarsiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.3",
            "verseOrgIds": [
              "JER.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini deebie ammalle isani jaare, isani ammalle dibbe teesani fud'attani gammaddani sirbitani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.4",
            "verseOrgIds": [
              "JER.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani ammalle gaareeni Samaria irati oobru zabibu oobrattani, nami oobruleeni woma isiini baaftu nyaata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.5",
            "verseOrgIds": [
              "JER.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, guyyaani ind'ufa, ka nami woi eegu gaareeni Efraimu iraa iyye waan jed'u, koota gara AABBO Waaqa keenna, Sioniti nu yaasa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.6",
            "verseOrgIds": [
              "JER.31.6"
            ]
          }
        }
      ]
    },
