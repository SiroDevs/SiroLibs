              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Guyyaani ind'ufa, ka dira Yerusalemu ch'ufa deebiani naa jaarani, haguma doofi Hananeliti iti keeyatani Fullo mogaati d'aabani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biimani isaa arti baate, ila aduu qajeelte, gaara Garebuti ejite, ammalle Goati deebite. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bale reefa iti awaalani huura iti jissani ch'ufafi oobru galaana Kidroni gubbale haga Fullo Farda, ta ilaboru ch'ufa, naa jed'ani, qulqulleesani olkayani. Dira suni deebiani ch'absani imballeesani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.40",
            "verseOrgIds": [
              "JER.31.40"
            ]
          }
        }
      ]
