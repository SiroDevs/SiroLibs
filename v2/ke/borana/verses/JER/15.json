          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Mul 13.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hojja worri eesa yaana? Siini jed'e, waan atini jettuuni, AABBO Waaqi waan jed'u,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
