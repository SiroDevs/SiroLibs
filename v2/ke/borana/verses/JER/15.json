                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani AABBO Waaqi waan nani jed'e, Ato Musafi Samuelileeni arma ejaanjani na kad'atinile, anini worra kanaa inahu. Gumi tana fuula kiyya duraa fageesi, ha yaatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
