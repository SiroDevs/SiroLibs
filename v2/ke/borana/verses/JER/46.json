              "type": "text"
            }
          ]
        },
        {
          "text": "harka nama worra fit'u fed'uti kenna — hayyu Babiloni ka Nebukadreza jed'anifi duula isaa. Ammo eege nami akuma duri kaani lafa Misiriti deebie keesa taa. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
