        },
        {
          "text": " AABBO Waaqi waan jed'u, Guyyaani ind'ufa, ka anini mana Daudi, ka jige aka hoosa jiru, deebise fulla isaa ta ch'ach'abde ch'ufa mid'ad'aase jaare aka qara inni jiruti deebisu, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
