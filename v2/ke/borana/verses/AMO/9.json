              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Isani worra Israeli naa worra lafa Kushi ira injirtani, isani worraani wolqit'e. Akuma anini lafa Misiri keesaa isani baase, anini worra gosa Filisti lafa Kaftori keesaa baase worra Siriale lafa Kiri keesaa baase. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi, gosa dabditi tana ta Israeli ilaani tissuu jira, lafale iraa balleesa, ammo ilmaani worraa ch'ufa imfit'u.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini amma seera gabaase worra Israeli aka mid'aani gingilchani gingilcha. Anini gosa ch'ufa keesa worra gingilche qulleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama kiyya ka daba tolchu, ka, Hameenni nu ind'aqabu jed'u ch'ufa goraadeeni balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka takaa tana Israeli deebisani",
          "type": "text"
        }
      ]
    },
