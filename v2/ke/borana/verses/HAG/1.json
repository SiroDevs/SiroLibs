    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi, Mana kiyya ammalle jaara jed'e",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
