        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
