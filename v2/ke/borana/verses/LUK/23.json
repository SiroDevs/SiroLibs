        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
