          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nad'eeni haga lafa Galilaya isa gula d'ufte d'at'e awaala agarte, aka reefa ch'iifsisanile ilaalte. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.55",
