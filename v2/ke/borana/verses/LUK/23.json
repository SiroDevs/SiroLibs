            "sid": "LUK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti guyya gudda geennaani haga saafa dukanoofte. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.44",
            "verseOrgIds": [
              "LUK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Bah 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Golli Mana Waaqa jiddu tarsae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.45",
            "verseOrgIds": [
              "LUK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.31.5"
              },
              "items": [
                {
                  "text": "Far 31.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesoni qonqo guddooni lalabe waan jed'e, Aabbo, lubbu tiyya harka kanketi lakisa! Akasi jed'e ch'iche. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.46",
            "verseOrgIds": [
              "LUK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guddaani askarti waan tahe arginaani Waaqa faarse waan jed'e, D'uguma namichi kunini nama d'ugaati! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.47",
            "verseOrgIds": [
              "LUK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini ch'ufti ta daawachu d'ufte waan tahe arginaani mata gingilfatte galte. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.48",
            "verseOrgIds": [
              "LUK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.2+LUK.8.3"
              },
              "items": [
                {
                  "text": "Luk 8.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jaalaani isaa ch'ufaafi nad'eeni Galilaya ta isa gula d'ufte fago ejaanjatte waan kana daawate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Awaala Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.49",
            "verseOrgIds": [
              "LUK.23.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 23:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama toko jira ka Yusufu jed'ani. Inni nama dansa, ka d'uga, ka kora worra ke jiru, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.50",
            "verseOrgIds": [
              "LUK.23.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 23:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo heregafi huji worra inquufu. Inni nama dira Arimathaya, diri suni, ka Yahudi; ammalle inni Finna Waaqa eegata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.51",
            "verseOrgIds": [
              "LUK.23.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 23:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba namichi kunini gara Pilato d'aqe, reefa Yeso kad'ate. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.52",
            "verseOrgIds": [
              "LUK.23.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 23:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani maskali ira gabuuse, woya booftatiini mamare, goda d'akha ka taka nama iti inawaaliini keesati awaale. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.53",
            "verseOrgIds": [
              "LUK.23.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 23:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani suni guyya Kurfefacha, guyyaani Sabatoleeni la d'iaate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.23.54",
            "verseOrgIds": [
              "LUK.23.54"
            ]
          }
        }
      ]
    },
