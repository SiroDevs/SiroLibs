                "loc": "MAT.2.23"
              },
              "items": [
                {
                  "text": "Mat 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Seera Aabbo gula aada ch'ufa guutannaani kaani Galilayati dachaani, haga dira worra ka Nazareti jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gurbaani suni guddate jabaate; ammalle guddo qaroo, eeba Waaqa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso gaafa ijoolle Mana Waaqa keesa",
          "type": "text"
        }
      ]
    },
