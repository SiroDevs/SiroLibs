            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Seera Musatiifi t'aafiini raagoota haga Yohana nama batisu ch'alla jabeenna qabdi; duuba achii asi Odu Dansa ta Finna Waaqa odeesani, nami ch'ufti finna suni irreeni seenu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo ira laaftu aka lafafi gubbaani dabartu fulla dubbini Seera toko baddu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
