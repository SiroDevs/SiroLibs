              "items": [
                {
                  "text": "1 Kor 7.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami niiti ufi lakise ta d'ibi fuud'u ya daba tolche; nami niiti d'iirsi lakise fuud'uleeni ya daba tolche.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
