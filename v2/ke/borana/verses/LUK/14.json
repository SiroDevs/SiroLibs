          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooddi dansa, ammo yo kura d'abe maaniini kura iti deebisani? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafafi fulla huura iti haranile himmalle; alati gatani. Nami gurra qabu ha d'agayu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.35",
            "verseOrgIds": [
