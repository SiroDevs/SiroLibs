          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi guyyaani ind'ufa, ka nyaapi kanke lafa siti ijaare si marse bahu si d'owu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
