          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'e, Atini ato sila guyya kana waan nagaya, lafa tanatiini d'ufa beete, guddo dansa! Ammo ammatana la si d'ossani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
