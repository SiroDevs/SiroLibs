              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Farisayooni gari, ta gumi keesa jirtu, waan Yesoni jette, Aabbo, jara kanke kanaani, Ch'allisa jed'i. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
