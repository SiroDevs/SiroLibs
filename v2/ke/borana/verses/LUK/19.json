            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, D'uguma waan anini isaniini jed'u, Yo sila gumiini tuni ch'allifte, d'akhayeeni tuni iniyiti.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni maro Yerusalemutiifi boha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
