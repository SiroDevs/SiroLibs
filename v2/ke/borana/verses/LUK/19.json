  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "LUK 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni Yeriko seene dira keesa dabre. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama tokoti jira ka Zakayo jed'ani; inni gudda worra damoosa guuruti, ammalle dureesa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Yeso barbaade aka inni jiru argu fed'e; ammo maro inni nama gabaabatiifi, ammalle maro gumitiifi dad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni aka Yesoni kara suni dabru d'ageennaani utaale dura dabre aka isa argu oda toko kore. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni achi geennaani gubba olmillate isa arge waan jed'eeni, Zakayo, hurrisi gadi bui, anini arra mana kanke oolu male. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hurrise gabue gammadaani mana ufiti yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami arge ch'ufti gungume waan jed'e, Inni yayu mana nama daba olseene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakayooni olejate waan Aabbooni jed'e, Ilaali, Aabbo, anini hori kiyya gama toko hiyyeeyii qooda; yo anini nama tokole hori dabaani ira fud'ad'e, maro afuri deebisaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, Arra baafami la mana kana d'ufe, waan innileeni ilma Abrahamutiifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.11"
              },
              "items": [
                {
                  "text": "Mat 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wonti akanatiifi Ilmi Nama ka bade barbaade baasu d'ufe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mammaasa hojjatu sadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 19:11"
          },
          "items": [
            {
