              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi, akuma Lubbuuni Qulqullooni jettu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
            ]
