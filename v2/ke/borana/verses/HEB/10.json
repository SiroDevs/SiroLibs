                "loc": "DEU.32.35"
              },
              "items": [
                {
                  "text": "Qab-Ser 32.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
