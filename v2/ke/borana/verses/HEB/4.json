              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba, Waaqi ya nuti kakhate, aka nu olseene isa woliini boqonnu. Tanaafi nu qorqorachu malle, aka isani tokoleeni boqota suni ind'amne. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuleeni, akuma worra, Odu Dansa d'ageenne. Worri Odu Dansa ya d'agaye, ammo woma worraa imbaane, maro d'ageennaani d'ugefachaani imfud'atiniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Far 95.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nu, worri d'ugefate, olseenne Waaqa woliini boqonna. Akuma inni jed'e,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
