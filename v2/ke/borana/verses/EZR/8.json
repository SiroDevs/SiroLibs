            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gershomu, ka balbala Finehasi Danieli, ka balbala Ithamari Hatushi, ilma Shekania, ka balbala Daudi Zekaria, ka balbala Paroshi, isaafi nama d'ibbaafi shantama ka balbala isaa (wonti worra isaani ka t'aafani olkayani injirti) Eliehoenai, ilma Zerahiya ka balbala Pahath-Moabu, isaafi nama d'ibba sadi. Ebedi, ilma Yonathani, ka balbala Adini, isaafi nama shantama. Yeshaya, ilma Athalia, ka balbala Elamu, isaafi nama torbatama Zebadia, ilma Mikaeli, ka balbala Shefatia, isaafi nama saddeetama. Obadia, ilma Yehieli ka balbala Yoabu, isaafi nama d'ibba lamafi kud'ani saddeeti. Shelomithi, ilma Yosifia, ka balbala Bani, isaafi nama d'ibbaafi jaatama. Zekaria ilma Bebai, ka balbala Bebai, isaafi nama diddami saddeeti. Yohana, ilma Hakatani, ka balbala Hazgadi, isaafi nama d'ibbaafi kud'ani. Elifeleti, Yeuelifi Shemaya, ka balbala Adonikamu, worraafi nama jaatama (worri eege biyyaa gale) Uthaifi Zakuri, ka balbala Bigwai, worraafi nama torbatama.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2+EZR.8.3+EZR.8.4+EZR.8.5+EZR.8.6+EZR.8.7+EZR.8.8+EZR.8.9+EZR.8.10+EZR.8.11+EZR.8.12+EZR.8.13+EZR.8.14",
            "verseOrgIds": [
              "EZR.8.2",
              "EZR.8.3",
              "EZR.8.4",
              "EZR.8.5",
              "EZR.8.6",
              "EZR.8.7",
              "EZR.8.8",
              "EZR.8.9",
              "EZR.8.10",
              "EZR.8.11",
