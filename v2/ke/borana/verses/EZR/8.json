              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini maqa worra balbala gosa worrati mata ka eegi boojiani Babiloni geesani Ezra woliini Yerusalemuti gale, bara Artashastani hayyu:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        }
      ]
    },
