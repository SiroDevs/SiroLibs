    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbiga Ilaahiinna ah waa inaydaan allabari ugu bixin dibi ama wan ay ku yaallaan iin ama wax xun oo kale, waayo, taasu waxay Rabbiga Ilaahiinna ah u tahay karaahiyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalooyinkiinna Rabbiga Ilaahiinna ahu uu idin siinayo haddii laga dhex helo nin ama naag sameeya wax Rabbiga Ilaahiinna ah hortiisa shar ku ah isagoo axdigiisa ka gudba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo intuu taga u adeega ilaahyo kale, oo caabuda iyaga, ha ahaadeen qorraxda, ama dayaxa, amase ciidanka samada midkood, taasoo aanan anigu ku amrin, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "haddii laydiin soo sheego oo aad maqashaan, markaas waa inaad dadka aad u haybisaan, oo bal eega, haddii ay run tahay iyo wax xaqiiqa ah in reer binu Israa'iil lagu sameeyey wax karaahiyo oo caynkaas ah, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kolkaas waa inaad irdihiinna keentaan ninkaa ama naagtaa waxan sharka ah sameeyey, oo qofkaasu nin ama naag ha ahaadee waa inaad dhagxisaan si ay u dhintaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kii la dilayo, markii laba ama saddex qof ku markhaati furaan waa in la dilo, laakiinse qof keliya markhaatigiisa waa inaan lagu dilin. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markhaatiyaashu waa inay marka hore u gacan qaadaan qofkaas, dabadeedna dadka oo dhammu waa inay u gacan qaadaan. Oo sidaas waa inaad sharka dhexdiinna uga saartaan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Garsoorka Sharciga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii dhexdiinna ka kaco xaal garsoorid ah oo idinku adag oo ku saabsan dhiig, ama gar, ama dhaawac, oo xaalalkaas irdihiinna gudahooda lagaga murmo, kolkaas waa inaad kacdaan oo tagtaan meesha Rabbiga Ilaahiinna ahu dooranayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad u tagtaan wadaaddada reer Laawi iyo xaakinka wakhtigaas joogi doono, oo waa inaad xaalkaas haybisaan oo iyana waxay idiin sheegi doonaan xukunkaas garsooriddiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad u samaysaan sida xukunka garsooriddiisu tahay, taasoo ay idiinka sheegi doonaan meesha Rabbiga Ilaahiinna ahu uu dooranayo, oo waa inaad dhawrtaan oo wada samaysaan waxa ay idin bari doonaan oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo siduu yahay sharciga ay idin bari doonaan, iyo siduu yahay xukunka ay idiin sheegi doonaan waa inaad u samaysaan. Xukunka ay idiin sheegi doonaan waa inaydaan uga leexan xagga midigta ama xagga bidixda toona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ninkii kibra oo diidaa inuu maqlo wadaadka Rabbiga Ilaahiinna ah hortiisa u taagan inuu u adeego, amase xaakinka, ninkaas waa in la dilaa, oo sharka waa inaad reer binu Israa'iil ka saartaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay dadka oo dhammu maqli doonaan, oo cabsan doonaan, oo kibir dambena ma samayn doonaan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boqorka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaad gashaan dalka Rabbiga Ilaahiinna ahu uu idin siinayo, oo intaad hantidaan aad dhex degtaan, haddaad istidhaahdaan, Waxaannu doonaynaa inaannu boqor u boqranno sida quruumaha hareerahayaga ku wareegsan oo kale, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "si kastaba ha ahaatee waa inaad boqrataan kii Rabbiga Ilaahiinna ahu doorto. Oo mid aad walaalihiinna kala soo dhex baxdaan waa inaad boqrataan. Waa inaydaan shisheeye aan walaalkiin ahayn boqor ka dhigan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse isagu waa inuusan fardo badsan, oo dadkana uusan Masar dib ugu celin si uu fardo u badsado, maxaa yeelay, Rabbigu wuxuu idinku yidhi, Hadda ka dib jidkaas waa inaydaan dib ugu noqon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naagona waa inuusan badsan si aan qalbigiisu Rabbiga uga leexan, oo lacag iyo dahabna waa inuusan aad u badsan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markuu carshiga boqortooyadiisa ku fadhiisto waa inuu naqil ah sharcigan kitaab kaga qoro waxa wadaaddada reer Laawi hortooda yaal, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo naqilkaas waa inuu haystaa, oo waxa ku qoran waa inuu cimrigiisa oo dhan akhristaa inuu barto si uu uga cabsado Rabbiga Ilaahiisa ah inuu wada xajiyo oo yeelo erayada sharcigan iyo qaynuunnadan oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "si uusan qalbigiisu kor ugaga kicin walaalihiis, oo uusan amarka uga leexan xagga midigta ama xagga bidixda toona, in isaga iyo carruurtiisuba ay boqortooyada ku cimridheeraadaan reer binu Israa'iil dhexdooda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        }
      ]
    }
  ],
