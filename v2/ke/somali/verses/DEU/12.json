    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meesha Keli Ah Ee Rabbiga Lagu Caabudo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanu waa qaynuunnada iyo xukummada ay tahay inaad dhawrtaan oo aad ku dhex yeeshaan dalkii Rabbiga Ilaaha awowayaashiin ahu uu idiin siinayo inaad hantidaan intaad dhulka ku nooshihiin oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo idinku hubaal waa inaad wada baabbi'isaan meelaha ay quruumaha aad hantiyi doontaan ilaahyadooda ugu adeegi jireen oo dhan, meelahaas oo ah kuwa buuraha dhaadheer ku kor yaal, iyo kuwa kuraha ku yaal, iyo kuwa geed kastoo dheer oo doog ah ku hoos yaal. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad meelahooda allabariga dumisaan, oo aad tiirarkoodana wada burburisaan, oo aad geedahooda Asheeraahna gubtaan, oo sanamyada xardhan oo ilaahyadoodana waa inaad jartaan, oo magacoodana waa inaad meeshaas ka baabbi'isaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan Rabbiga Ilaahiinna ah saas ku samayn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse meesha Rabbiga Ilaahiinna ahu uu qabiilooyinkiinna oo dhan ka dooranayo inuu magiciisa halkaas dhigo, taasoo ah rugtiisa, waa inaad doontaan, oo halkaas waa inaad timaadaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad halkaas keentaan qurbaannadiinna la gubo, iyo allabaryadiinna, iyo meel tobnaadyadiinna, iyo qurbaanka aad gacanta sare ugu qaaddaan, iyo waxyaalaha aad nidartaan, iyo qurbaannada aad ikhtiyaarka u bixisaan, iyo curadyada lo'diinna iyo adhigiinna. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxyaalahaas waa inaad halkaas ku cuntaan Rabbiga Ilaahiinna ah hortiisa, oo wax alla wixii aad gacanta ku qabataan oo uu Rabbiga Ilaahiinna ahu idinku barakeeyey waa inaad ku faraxdaan idinka iyo reerihiinnuba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaydaan samayn waxyaalaha aynu maanta halkan ku samaynayno oo dhan kuwaas oo ah waxa nin walba la qumman, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, idinku weli ma aydaan gaadhin nasashada iyo dhaxalka uu Rabbiga Ilaahiinna ahu idin siinayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse markaad Webi Urdun ka gudubtaan oo aad degtaan dalka Rabbiga Ilaahiinna ahu idin dhaxalsiinayo, oo uu idinka nasiyo cadaawayaashiinna idinku wareegsan oo dhan, si aad ammaan ugu degganaataan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "de markaas meesha Rabbiga Ilaahiinna ahu uu u dooranayo in magiciisu ku jiro waa inaad wada keentaan wixii aan idinku amrayo oo dhan, kuwaas oo ah qurbaannadiinna la gubo, iyo allabaryadiinna, iyo meeltobnaadyadiinna, iyo qurbaanka aad gacanta sare ugu qaaddaan, iyo wax walba oo wanaagsan oo aad Rabbiga u nidartaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbiga Ilaahiinna ah hortiisa waa inaad ku faraxdaan, idinka iyo wiilashiinna, iyo gabdhihiinna, iyo addoommadiinna lab, iyo addoommihiinna dhaddig, iyo ka reer Laawi oo ku jira irdihiinna, maxaa yeelay, isagu idinlama laha qayb iyo dhaxal toona. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Digtoonaada, oo qurbaannadiinna la gubo ha ku bixinina meel alla meeshii aad aragtaanba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse qurbaannadiinna la gubo waa inaad ku bixisaan meesha Rabbigu ka dhex dooranayo qabiilooyinkiinna middood, oo halkaas waa inaad ku wada yeeshaan waxaan idinku amrayo oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waa idiin bannaan tahay inaad wax qalataan oo aad irdihiinna gudahooda hilib ku cuntaan in alla intii naftiinnu doonayso sida ay tahay barakadii uu Rabbiga Ilaahiinna ahu idin siiyey, oo qofkii daahir ah iyo qofkii aan daahir ahaynuba way u cuni karaan, sida cawsha iyo deerada loo cuno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waa inaydaan dhiigga cunin, waxaadse dhulka ugu daadisaan sida biyo oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin idiinma bannaana inaad irdihiinna gudahooda ku cuntaan meeltobnaadka hadhuudhkiinna, ama kan khamrigiinna, ama kan saliiddiinna, ama curadyada lo'diinna iyo adhigiinna, ama wax alla wixii aad nidartaan, amase qurbaannada aad ikhtiyaarkiinna u bixisaan, amase qurbaanka aad gacanta sare ugu qaaddaan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse iyaga waa inaad ku cuntaan Rabbiga Ilaahiinna ah hortiisa taasoo ah meesha Rabbiga Ilaahiinna ahu dooranayo. Midkiin kasta iyo wiilkiisa iyo gabadhiisa, iyo addoonkiisa iyo addoontiisa, iyo ka reer Laawi oo irdihiisa ku jira, meeshaas ha ku cuneen, oo idinkoo Rabbiga hor jooga waa inaad ku faraxdaan wax alla wixii aad gacanta ku qabataanba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba digtoonaada, oo reer Laawi ha dayrinina in alla intaad dalkiinna ku nooshihiin oo dhan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markii Rabbiga Ilaahiinna ahu uu soohdintiinna u ballaadhiyo siduu idiin ballanqaaday, oo aad tidhaahdaan, Waxaannu doonaynaa inaan hilib cuno, sababtoo ah nafsaddiinna oo doonaysa inay hilib cunto, markaas way idiin bannaan tahay inaad hilib cuntaan in alla inta nafsaddiinnu doonayso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddii meesha Rabbiga Ilaahiinna ahu uu u dooranayo inuu magiciisa dhigo ay idinka fog tahay, markaas waa inaad lo'diinna iyo adhigiinna uu Rabbigu idin siiyey wax uga qalataan sida aan idinku amray, oo waa inaad irdihiinna gudahooda ku cuntaan in alla inta nafsaddiinnu doonayso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaad iyaga u cuntaan sida loo cuno cawsha iyo deerada, oo qofkii daahir ah iyo qofkii aan daahir ahaynuba isku si ha u cuneen. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waxaa keliyahood hubsataan inaydaan dhiigga cunin, waayo, dhiiggu waa nolosha, haddaba waa inaydaan cunin hilibka noloshiisu la jirto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan dhiigga cunin, waxaadse dhulka ugu daadisaan sida biyo oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan cunin, si aad u nabdoonaataan idinka iyo carruurtiinna idinka dambaysaba, markaad yeeshaan waxa ku qumman Rabbiga hortiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waxyaalihiinna quduuska ah oo aad haysataan iyo waxyaalihii aad nidartaanba waa inaad qaaddaan oo aad geeysaan meesha Rabbigu dooranayo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waa inaad qurbaannadiinna la gubo, hilibka iyo dhiiggaba ku kor bixisaan meesha allabariga oo Rabbiga Ilaahiinna ah, oo allabarigiinna dhiiggiisana waa in lagu shubo meesha allabariga oo Rabbiga Ilaahiinna ah, hilibkase waa inaad cuntaan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhawra oo dhegaysta erayadan aan idinku amrayo oo dhan, si aad idinka iyo carruurtiinna idinka dambaysaba weligiin u nabdoonaataan, markaad yeeshaan waxa wanaagsan oo ku qumman Rabbiga Ilaahiinna ah hortiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
