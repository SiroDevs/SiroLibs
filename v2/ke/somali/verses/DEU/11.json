            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "War sow iyagu kama shisheeyaan Webi Urdun xagga jidka dambe oo qorrax-u-dhaca, oo ah dalka reer Kancaanka Caraabaah deggan, oo ka soo hor jeedda Gilgaal, oo ku dhinac yaal geedaha Moreh? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
