            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bal eega, maanta waxaan idin hor dhigayaa barako iyo habaar, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "barakada waxaad helaysaan haddaad dhegaysataan amarrada Rabbiga Ilaahiinna ah oo aan maanta idinku amrayo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "habaarkuna wuxuu idinku dhacayaa haddaydnan dhegaysan amarrada Rabbiga Ilaahiinna ah, laakiin aad gees uga leexataan jidka aan maanta idinku amrayo, oo aad ilaahyo kale oo aydnan aqoon raacdaan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        }
      ]
    },
