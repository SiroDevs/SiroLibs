        },
        {
          "text": "Oo markii Rabbiga Ilaahiinna ahu idin geeyo dalka aad ugu gudbaysaan inaad hantidaan, barakada waa inaad kaga dhawaaqdaan Buur Gerisiim, habaarkana waa inaad kaga dhawaaqdaan Buur Ceebaal. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
