          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhawr maalinta sabtida inaad quduus ka dhigto sidii Rabbiga Ilaahaaga ahu kuugu amray. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lix maalmood waa inaad hawshootaa, oo aad shuqulkaaga oo dhan qabsataa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse maalinta toddobaad waa maalin sabti u ah Rabbiga Ilaahaaga ah, oo waa inaanad shuqul qaban, adiga, ama wiilkaaga, ama gabadhaada, ama addoonkaaga, ama addoontaada, ama dibigaaga, ama dameerkaaga, ama mid kasta oo xoolahaaga ah, ama qariibka irdahaaga ku jira, si addoonkaaga iyo addoontaaduba ay u nastaan sidaada oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad xusuusataa inaad addoon ku ahaan jirtay dalka Masar, oo Rabbiga Ilaahaaga ahu uu halkaas kaaga soo bixiyey gacan xoog badan iyo cudud fidsan, oo sidaas daraaddeed Rabbiga Ilaahaaga ahu wuxuu kugu amray inaad dhawrto maalinta sabtida.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
