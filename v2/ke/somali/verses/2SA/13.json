{
  "id": "2SA.13",
  "number": "13",
  "bookId": "2SA",
  "reference": "Samuu'Eel Labaad 13",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
