{
  "id": "2SA.2",
  "number": "2",
  "bookId": "2SA",
  "reference": "Samuu'Eel Labaad 2",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
