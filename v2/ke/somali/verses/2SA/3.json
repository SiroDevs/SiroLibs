          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Abneer waxaa lagu aasay Xebroon, boqorkiina codkiisii kor buu u qaaday, oo qabrigii Abneer ku dul ooyay; oo dadkii oo dhammuna way wada ooyeen. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
