        },
        {
          "text": "Haddaba magaaladu way ballaadhnayd, wayna weynayd, laakiinse dadku way ku yaraayeen, oo guryihiina ma ay dhisnayn. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.4",
