          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo bal eeg, wuxuu midho badan u dhalaa boqorradii aad korkayaga ka yeeshay dembigayaga aawadiis; oo weliba waxay ugu taliyaan jidhkayaga iyo xoolahayagaba siday doonayaan, oo annana cidhiidhi weyn baannu ku jirnaa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        }
