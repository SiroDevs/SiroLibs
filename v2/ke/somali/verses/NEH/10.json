          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dadka intiisii kale oo dhan oo ahaa wadaaddadii, iyo kuwii reer Laawi, iyo irid-dhawryadii, iyo kuwii gabayaaga ahaa, iyo reer Netiiniim, iyo kulli intii iska soocday dadyowgii dalka degganaa oo raacday sharcigii Ilaah, iyo naagahoodii, iyo wiilashoodii, iyo gabdhahoodii, iyo mid kasta oo lahaa aqoon iyo waxgarasho, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
