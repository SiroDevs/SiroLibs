          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Ruubeen oo ahaa curadkii Israa'iil farcankoodii, qolo qolo iyo reer reer, sidii ay tirada magacyadoodu ahayd markii madax madax loo tiriyey, nin kasta oo labaatan sannadood jiray iyo intii ka sii weynaydba, in alla intii dagaal u bixi kartay oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "intii iyaga laga tiriyey oo ahayd qabiilka reer Ruubeen waxay ahaayeen lix iyo afartan kun iyo shan boqol.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
