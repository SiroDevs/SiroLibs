              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse qabiilkii reer Laawi reer reer looma tirin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
