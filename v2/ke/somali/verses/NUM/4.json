          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Meraariina waa inaad qolo qolo iyo reer reer u soo tirisaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
