          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu la hadlay Muuse iyo Haaruun oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer Qohaad qolooyinkooda ha ka gooynina reer Laawi dhexdooda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse sidan ku sameeya si ay u noolaadaan oo aanay u dhiman markay u soo dhowaadaan waxyaalaha ugu wada quduusan. Haaruun iyo wiilashiisu waa inay gudaha galaan, oo ay iyaga u amraan hawshooda iyo waxqaadkooda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse iyagu waa inaanay xataa daqiiqad u gelin inay waxyaalaha quduuska ah arkaan, yaanay dhimane.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
