        "style": "s1"
      },
      "items": [
        {
          "text": "Soohdimihii Kancaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu Muuse la hadlay, oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.1",
            "verseOrgIds": [
              "NUM.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer binu Israa'iil waxaad ku amartaa oo ku tidhaahdaa, Markaad gashaan dalka Kancaan, (kaas oo ah dalka dhaxal idiinku dhici doona oo ah dalka Kancaan siday soohdimihiisu yihiin,) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "waaxdiinna koonfureed waxay ahaan doontaa cidlada Sin iyo tan iyo dhinaca Edom, oo soohdintiinna koonfureedna waxay ka bilaaban doontaa Badda Cusbada leh darafkeeda bari, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo soohdintiinnuna waxay la soo wareegi doontaa xagga koonfureed oo jiirtii Caqrabbiim, oo waxay u gudbi doontaa ilamaa Sin, oo dhammaadkeeduna wuxuu ahaan doonaa Qaadeesh Barneeca xaggeeda koonfureed, oo waxay u sii bixi doontaa xagga Hasar Addaar, oo waxay u sii dhaafi doontaa ilaa Casmoon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintu waxay la soo wareegi doontaa Casmoon ilaa tan iyo durdurka Masar, oo dhammaadkeeduna wuxuu ahaan doonaa xagga badda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdinta galbeedna waxaad yeelan doontaan badda weyn iyo soohdinteedaba. Intaasu waxay ahaan doontaa soohdintiinna galbeed. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intanuna waxay ahaan doontaa soohdintiinna woqooyi, waxaad ka tilmaansataan badda weyn ilaa tan iyo Buur Xor. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
            "verseOrgIds": [
              "NUM.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Buur Xorna waxaad ka tilmaansataan ilaa tan iyo meesha Hamaad laga galo, oo soohdinta dhammaadkeeduna wuxuu ahaan doonaa Sedaad. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.8",
            "verseOrgIds": [
              "NUM.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintu waxay u bixi doontaa xagga Sifron, oo dhammaadkeeduna wuxuu ahaan doonaa Hasar Eenaan. Taasu waxay ahaan doontaa soohdintiinna woqooyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintiinna barina waxaad ka tilmaansataan Hasar Eenaan ilamaa tan iyo Shefaam. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.10",
            "verseOrgIds": [
              "NUM.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintu waxay hoos uga dhaadhici doontaa Shefaam iyo ilamaa Riblaah oo ah Cayn xaggeeda bari, oo soohdintu waxay hoos ugu dhaadhici doontaa oo gaadhi doontaa badda Kinnered dhinaceeda bari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintu waxay hoos ugu dhaadhici doontaa Webi Urdun oo dhammaadkeeduna wuxuu ahaan doonaa Badda Cusbada leh. Intaasu waxay ahaan doontaa dalkiinna siday soohdimihiisu u wareegsan yihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Muuse amray reer binu Israa'iil, oo wuxuu ku yidhi, Waa kan dalka aad saamiga ku dhaxli doontaan oo Rabbigu amray in la siiyo sagaalka qabiil iyo qabiilka badhkiis, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, qabiilkii Ruubeen sida reerahoodu yihiin, iyo qabiilkii Gaad sida reerahoodu yihiin, iyo qabiilkii Manaseh badhkiis horay u heleen dhaxalkoodii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labadaas qabiil iyo qabiilka badhkiis waxay dhaxalkoodii u heleen Webi Urdun shishadiisa, ee Yerixoo barigeeda ah, xagga qorrax ka soo baxa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu Muuse la hadlay, oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimanka dalka dhaxal idiinku qaybin doonaa magacyadoodii waa kuwan: wadaadka Elecaasaar ah iyo Yashuuca ina Nuun. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qabiil kastana waa inaad amiir kala soo baxdaan inay dalka dhaxal u kala qaybiyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo nimankaas magacyadoodiina waa kuwan: qabiilka reer Yahuudah kala soo baxa Kaaleeb ina Yefunneh. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Simecoonna, Shemuu'eel ina Cammiihuud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Benyaamiinna, Eliidaad ina Kisloon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Daanna waxaad kala baxdaan amiir, kaas oo ah Buqii ina Yaaglii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reer Yuusufna, qabiilka reer Manaseh waxaad kala soo baxdaan amiir, kaas oo ah Xannii'eel ina Eefod. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Efrayimna waxaad kala soo baxdaan amiir, kaas oo ah Qemuu'eel ina Shiftaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Sebulunna waxaad kala baxdaan amiir, kaas oo ah Eliisaafaan ina Farnaag. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Isaakaarna waxaad kala soo baxdaan amiir, kaas oo ah Faltii'eel ina Casaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.26",
            "verseOrgIds": [
              "NUM.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka reer Aasheerna waxaad kala soo baxdaan amiir, kaas oo ah Axiihuud ina Shelomii. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.27",
            "verseOrgIds": [
              "NUM.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabiilka Naftaalina waxaad kala soo baxdaan amiir, kaas oo ah Fedaheel ina Cammiihuud. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.28",
            "verseOrgIds": [
              "NUM.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwaasu waa inta Rabbigu ku amray inay reer binu Israa'iil dhaxalka ugu qaybiyaan dalka Kancaan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.29",
            "verseOrgIds": [
              "NUM.34.29"
            ]
          }
        }
      ]
    }
  ],
