          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbigu wejigiisa ha kugu iftiimiyo, oo ha kuu roonaado.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.25",
