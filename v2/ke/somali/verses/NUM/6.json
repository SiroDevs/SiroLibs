            }
          ]
        },
        {
          "text": "Markaasaa Rabbigu Muuse la hadlay, oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haaruun iyo wiilashiisa la hadal, oo waxaad ku tidhaahdaa, Idinku waa inaad sidan reer binu Israa'iil ugu ducaysaan, oo waxaad midkood kasta ku tidhaahdaan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
            "verseOrgIds": [
              "NUM.6.23"
            ]
          }
        }
      ]
