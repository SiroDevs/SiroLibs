          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Neboo, iyo Bacal Mecoon, (kuwaasoo magacyadoodii la beddelay,) iyo Sibmaah; oo magacyo kalay u bixiyeen magaalooyinkii ay dhisteen. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
