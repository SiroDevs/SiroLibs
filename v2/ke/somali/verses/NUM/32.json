          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Yaa'iir ina Manasehna wuu tegey Gilecaad, oo magaalooyinkeedii qabsaday, oo wuxuu magacyadoodii u bixiyey Hawood Yaa'iir. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
