          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Maakiir oo ahaa Manaseh wiilkiisiina waxay tageen dalkii Gilecaad, oo way qabsadeen, oo dadkii reer Amor oo halkaas degganaa ayay hanti tireen. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Muuse wuxuu Gilecaad siiyey reer Maakiir oo ahaa wiilkii Manaseh, oo iyana halkaasay degeen. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
