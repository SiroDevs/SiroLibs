    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulaymaan Oo Dhisay Macbudkii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Sulaymaan bilaabay inuu gurigii Rabbiga Yeruusaalem ka dhiso oo ka dul dhiso Buur Moriyaah oo ahayd meeshii Rabbigu ugu muuqday aabbihiis Daa'uud, oo wuxuu wax ku diyaarshay meeshii Daa'uud doortay oo ahayd meeshii wax lagu tumi jiray oo uu Aarnaankii reer Yebuus lahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu dhismihii bilaabay sannaddii afraad oo boqortooyadiisa, bisheedii labaad, maalinteedii labaad. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba kanu waa aasaaskii Sulaymaan u dhigay dhismihii guriga Ilaah. Oo dhererku markii cabbirkii hore lagu xisaabo wuxuu ahaa lixdan dhudhun, oo ballaadhkiisuna wuxuu ahaa labaatan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo balbaladii guriga ka horraysayna dhererkeedu wuxuu le'ekaa guriga ballaadhkiisu oo labaatan dhudhun ahaa, oo sarajooggeeduna wuxuu ahaa boqol iyo labaatan dhudhun, oo wuxuu gudaha hoose kaga dahaadhay dahab saafiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gurigii weynaa wuxuu saqaf hoose uga dhigay qoryo beroosh ah oo uu dahab wanaagsan ku dahaadhay, oo wuxuuna ku xardhay geedo timireed iyo silsilado. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gurigiina wuxuu ku qurxiyey dhagaxyo qaali ah, dahabkuna wuxuu ahaa dahabkii Farwaayim. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gurigiina iyo alwaaxdii saqafka haysay, iyo fayaaradihiisii, iyo derbiyadiisii, iyo albaabbadiisiiba wuxuu ku dahaadhay dahab, oo derbiyadana Keruubiim buu ku xardhay. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu sameeyey gurigii ugu wada quduusnaa, dhererkiisuna wuxuu le'ekaa guriga ballaadhkiisa oo labaatan dhudhun ahaa, oo ballaadhkiisuna wuxuu ahaa labaatan dhudhun, oo isagana wuxuu ku dahaadhay dahab wanaagsan oo gaadhaya lix boqol oo talanti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo musmaarrada miisaankooduna wuxuu ahaa konton sheqel oo dahab ah, oo qolalkii sarena wuxuu ku dahaadhay dahab. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo guriga ugu wada quduusan gudihiisana wuxuu ku sameeyey laba keruub oo wax xardhan ah, oo iyagana dahab baa lagu dahaadhay. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keruubiimta baalashooda dhererkooduna wuxuu ahaa labaatan dhudhun; mid baalkiisu wuxuu ahaa shan dhudhun oo wuxuu gaadhi karay guriga derbigiisa, oo kan kalena wuxuu ahaa shan dhudhun sidaasoo kale oo wuxuu gaadhi karay baalka keruubka kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo keruubka kale baalkiisuna wuxuu ahaa shan dhudhun, oo wuxuu gaadhi karay guriga derbigiisa kale; oo baalka kalena sidaasoo kale wuxuu ahaa shan dhudhun oo wuxuu gaadhi karay baalka keruubka kale. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo keruubiimtaas baalashoodu way kala baxsanaayeen intii labaatan dhudhun ah; oo cagahooday ku taagnaayeen, wejiyadooduna waxay u jeedeen guriga gudihiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu ilxidhka ka dhigay buluug, iyo guduud, iyo casaan, oo maro wanaagsan laga sameeyey, oo keruubiim lagu daabacay. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba guriga hortiisana wuxuu ku sameeyey laba tiir oo mid kasta dhererkiisu yahay shan iyo soddon dhudhun, oo mid kastana taajkii saarnaa wuxuu ahaa shan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu kaloo sameeyey silsilado u eg kuwii guriga quduuska ah markaasuu saaray tiirarka dushoodii; oo wuxuu kaloo sameeyey boqol rummaan oo silsiladihii buu ku dhejiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu tiirarkii qotomiyey macbudka hortiisa, mid dhanka midigta, kii kalena dhanka bidixda, oo kii dhanka midigta ahaa magiciisii wuxuu u bixiyey Yaakiin, kii dhanka bidixda ahaana wuxuu u bixiyey Bocas.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
  ],
