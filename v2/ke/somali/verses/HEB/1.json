            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isagu waa dhalaalka ammaantiisa iyo u-ekaanta ahaantiisa, oo wax walba wuxuu ku hayaa erayga xooggiisa, oo goortuu daahirinta dadka dembiyadooda sameeyey dabadeed ayuu wuxuu fadhiistay Weynaha xagga sare midigtiisa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "isagoo aad uga wanaagsan malaa'igaha siduu u dhaxlay magac ka sii wanaagsan kooda.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
