            }
          ]
        },
        {
          "text": "Ilaah wuxuu waagii hore siyaalo badan oo kala duduwan awowayaasheen kula hadlay nebiyadii, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
