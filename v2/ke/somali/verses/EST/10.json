              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Boqor Ahashwerus wuxuu baad saaray dhulkii iyo gasiiradihii baddaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo falimihii uu xooggiisii iyo itaalkiisii ku sameeyey oo dhan, iyo warkii Mordekay weynaantiisii uu boqorku isaga u sara mariyey sow kuma wada qornayn buuggii taariikhda oo boqorradii Maaday iyo Faaris? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Yuhuudigii Mordekay ahaa wuxuu ahaa ninkii ku xigay Boqor Ahashwerus, oo xagga Yuhuuddana wuxuu ahaa nin weyn, oo walaalihiisa badanuna way aqbaleen; oo wuxuuna ahaa nin doondoonaa wanaagga dadkiisa oo nabaadiino kula hadla farcankiisa oo dhan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
