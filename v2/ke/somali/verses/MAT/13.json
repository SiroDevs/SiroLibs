          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masaal kale ayuu kula hadlay, Boqortooyada jannada waxay u eg tahay khamiir, kan naagi intay qaadday ay saddex qiyaasood oo bur ah ku dhex qooshtay ilaa ay wada khamiireen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
