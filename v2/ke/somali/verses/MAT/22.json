          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu ku yidhi, Yuu idinla yahay Masiixu? Waa ina ayo? Kolkaasay ku yidhaahdeen, Waa ina Daa'uud. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
