              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dadkii badnaa goortay taas maqleen ayay waxbariddiisii ka yaabeen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
