          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Eliihuu ina Barakeel oo ahaa reer Buus ayaa jawaabay oo wuxuu yidhi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
