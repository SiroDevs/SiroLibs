{
  "id": "GEN.22",
  "number": "22",
  "bookId": "GEN",
  "reference": "Bilowgii 22",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
