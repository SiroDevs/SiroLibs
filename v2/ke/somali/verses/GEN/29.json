            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee'ahna way uuraysatay, oo waxay dhashay wiil, magiciisiina waxay u bixisay Ruubeen, oo waxay tidhi, Sababtu waxaa weeye inuu Rabbigu dhibaatadayda arkay, oo haatan ninkaygu wuu i jeclaan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana way uuraysatay mar labaad, waxayna dhashay wiil, oo waxay tidhi, Rabbigu waa maqlay in lay nebcaaday, oo haddaba taas aawadeed ayuu ii siiyey wiilkanna; magiciisiina waxay u bixisay Simecoon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
