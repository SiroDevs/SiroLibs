              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanu waa farcankii Sheem. Sheem wuxuu jiray boqol sannadood, oo laba sannadood oo daadkii ka dambaysay wuxuu dhalay Arfaksad. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheemna markuu Arfaksad dhalay ka dib wuxuu noolaa shan boqol oo sannadood, wiilal iyo gabdhona wuu dhalay.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
