    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riyooyinkii Fircoon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markii laba sannadood oo dhammu dhammaatay ayuu Fircoon riyooday, oo wuxuu is-arkay isagoo webiga ag taagan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.1",
            "verseOrgIds": [
              "GEN.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo bal eeg, waxaa webigii ka soo baxay toddoba sac oo quruxsan oo cayillan, oo waxay daaqeen cawskii dareemada ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.2",
            "verseOrgIds": [
              "GEN.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa waxaa dabadood webigii ka soo baxay toddoba sac oo kale oo fool xun, oo weyd ahaa, oo waxay is-ag taageen sicihii kale oo webiga qarkiisa jooga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.3",
            "verseOrgIds": [
              "GEN.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa sicihii foosha xumaa oo weydda ahaa waxay cuneen toddobadii sac oo qurxoonayd oo cayillanayd. Kolkaasuu Fircoon toosay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.4",
            "verseOrgIds": [
              "GEN.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu haddana seexday oo mar labaad riyooday, oo wuxuu arkay toddoba sabuul oo buurbuuran oo wanaagsan oo ka soo baxay isku jirid. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.5",
            "verseOrgIds": [
              "GEN.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo bal eeg, waxaa haddana ka soo daba baxay toddoba sabuul oo xunxun, oo ay dabayshii bari qallajisay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.6",
            "verseOrgIds": [
              "GEN.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa sabuulladii xunxumaa waxay liqeen toddobadii sabuul oo buurbuurnayd oo iltirnayd. Markaasuu Fircoon toosay, oo wuxuu arkay inay riyo tahay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.7",
            "verseOrgIds": [
              "GEN.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo subaxdiina wuu dhibaataysnaa, kolkaasuu u cid diray oo uu u wada yeedhay saaxiriintii Masar oo dhan iyo nimankii xigmadda lahaa oo dhan; markaasaa Fircoon u sheegay riyadiisii; laakiin ma jirin mid Fircoon u fasiri karaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.8",
            "verseOrgIds": [
              "GEN.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa waxaa Fircoon la hadlay kii madaxa u ahaa kuwa khamriga siin jiray isaga, oo wuxuu ku yidhi, Maantaan xusuustay dembiyadaydii. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.9",
            "verseOrgIds": [
              "GEN.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fircoonow, adigoo u cadhaysnaa addoommadaada, waxaad igu xabbistay guriga madaxa waardiyayaasha, oo waxaannu ahayn aniga iyo kii madaxa u ahaa kuwii wax dubi jiray; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.10",
            "verseOrgIds": [
              "GEN.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo markaasaannu isku habeen riyoonnay, aniga iyo isagiiba; waxaannu ku riyoonnay midkayo kastaba sidii riyadiisii fasirkeedu ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.11",
            "verseOrgIds": [
              "GEN.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo halkaasna waxaa nala joogay nin dhallinyaro ah oo Cibraani ah, oo madaxa waardiyayaasha addoon u ahaa, markaasaannu isagii u sheegnay, oo isna wuu noo fasiray riyooyinkayagii, nin kastana sidii riyadiisu ahayd buu ugu fasiray. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.12",
            "verseOrgIds": [
              "GEN.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sidii uu noogu fasiray ayay noqotay. Aniga waxaa laygu soo celiyey meeshaydii, isagiina waa la deldelay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.13",
            "verseOrgIds": [
              "GEN.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dabadeedna Fircoon baa u cid diray oo u yeedhay Yuusuf. Markaasay dhaqso uga soo bixiyeen godxabsigii; kolkaasuu xiirtay, oo dharkiisii beddeshay, oo uu u soo galay Fircoon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.14",
            "verseOrgIds": [
              "GEN.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu Yuusuf ku yidhi, Riyaan ku riyooday, mana jiro mid fasiri karaa; oo waxaan maqlay in markii aad riyo maqashid aad fasiri kartid. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.15",
            "verseOrgIds": [
              "GEN.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuusufna Fircoon buu u jawaabay oo ku yidhi, Taasu xaggayga ma aha, laakiinse Ilaah wuxuu Fircoon siin doonaa jawaab nabadeed. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.16",
            "verseOrgIds": [
              "GEN.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon Yuusuf la hadlay, oo yidhi, Waxaan riyadaydii ku arkay anigoo webiga qarkiisa taagan; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.17",
            "verseOrgIds": [
              "GEN.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo bal eeg, waxaa webigii ka soo baxay toddoba sac oo buurbuuran oo quruxsan oo waxay daaqeen cawskii dareemada ahaa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.18",
            "verseOrgIds": [
              "GEN.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaa haddana ka soo daba baxay toddoba sac oo kale, oo taagdaran oo fool xun oo weyd ah. Weligay dhulka Masar oo dhan kuma aan arag kuwa sidooda u xun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.19",
            "verseOrgIds": [
              "GEN.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa sicihii weydda ahaa oo foosha xumaa waxay cuneen toddobadii sac oo hore. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.20",
            "verseOrgIds": [
              "GEN.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markay cuneen lagama garan karin inay cuneen, laakiinse waxay u fool xumaayeen sidii markii hore. Markaasaan toosay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.21",
            "verseOrgIds": [
              "GEN.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaan kaloo riyadaydii ku arkay toddoba sabuul oo iltiran oo wanaagsan, oo ka soo baxay isku jirid; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.22",
            "verseOrgIds": [
              "GEN.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "dabadeedna waxaa ka soo daba baxay toddoba sabuul oo engegan oo xunxun oo dabayshii bari qallajisay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.23",
            "verseOrgIds": [
              "GEN.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa sabuulladii xunxumaa waxay liqeen toddobadii sabuul oo wanaagsanayd; markaasaan u sheegay saaxiriinta, laakiinse ma uu jirin mid ii sheegi karay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.24",
            "verseOrgIds": [
              "GEN.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yuusuf wuxuu ku yidhi Fircoon, Riyadaadu waa mid, oo waxa Ilaah samaynayo ayuu kuu sheegay, Fircoonow. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.25",
            "verseOrgIds": [
              "GEN.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toddobada sac oo wanwanaagsanu waa toddoba sannadood, toddobada sabuul oo wanwanaagsanuna waa toddoba sannadood; riyadu waa mid. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.26",
            "verseOrgIds": [
              "GEN.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toddobada sac oo weyd ah oo foosha xun, oo ka soo daba baxay waa toddoba sannadood, oo haddana toddobada sabuul oo madhan, oo dabayshii bari qallajisay waxay noqon doonaan toddoba sannadood oo abaar ah. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.27",
            "verseOrgIds": [
              "GEN.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taasu waa wixii aan kugula hadlay, Fircoonow. Waxa Ilaah samaynayo ayuu ku tusay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.28",
            "verseOrgIds": [
              "GEN.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo bal eeg, waxaa dalka Masar oo dhan imanaya toddoba sannadood oo barwaaqo ah, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.29",
            "verseOrgIds": [
              "GEN.41.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo dabadoodna waxaa dhici doona toddoba sannadood oo abaar ah; oo barwaaqadii oo dhanna waa laga illoobi doonaa dalka Masar, markaasay abaartu dhulka dhammayn doontaa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.30",
            "verseOrgIds": [
              "GEN.41.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "barwaaqadana dhulka laguma ogaan doono abaartaas ka dambaysa aawadeed, waayo, waxay noqon doontaa mid aad u xun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.31",
            "verseOrgIds": [
              "GEN.41.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taas aawadeed riyadii labanlaab bay kuu noqotay, Fircoonow, maxaa yeelay, waxaas waxaa amray Ilaah, oo weliba Ilaah dhowaan buu samayn doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.32",
            "verseOrgIds": [
              "GEN.41.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Fircoonow, waxaad doontaa nin caqli iyo xigmad leh, oo u sarraysii dalka Masar oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.33",
            "verseOrgIds": [
              "GEN.41.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tan yeel oo waxaad doorataa niman dalka u sarreeya, oo waxa toddobada sannadood oo barwaaqada ah dhulka ka baxa inta shanaad ha ururiyeen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.34",
            "verseOrgIds": [
              "GEN.41.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 41:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo cuntada oo dhan sannadahan wanaagsan oo imanaya ha ururiyeen, hadhuudhkana ha kugu hoos kaydiyeen, Fircoonow, oo intay cunto ahaan magaalooyinka u dhigaan, ha ilaaliyeen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.35",
            "verseOrgIds": [
              "GEN.41.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 41:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuntaduna kayd bay dalka u noqon doontaa toddobada sannadood oo abaarta ah oo ka dhici doonta dalka Masar, si aan dalku abaarta ugu baabbi'in. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.36",
            "verseOrgIds": [
              "GEN.41.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 41:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaasuna Fircoon way la wanaagsanaayeen, isaga iyo addoommadiisiiba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.37",
            "verseOrgIds": [
              "GEN.41.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 41:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu addoommadiisii ku yidhi, Miyaynu heli karaynaa mid la mid ah kan, oo ah nin Ruuxa Ilaah ku jiro? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.38",
            "verseOrgIds": [
              "GEN.41.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 41:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu Fircoon wuxuu Yuusuf ku yidhi, Mar haddii Ilaah ku tusay waxyaalahan oo dhan, ma jiro mid sidaadoo kale caqli iyo xigmad u leh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.39",
            "verseOrgIds": [
              "GEN.41.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adigu waxaad ka sarrayn doontaa gurigayga, dadkayga oo dhanna waxaa lagu xukumi doonaa si waafaqsan hadalkaaga, oo anigu carshiga oo keliya ayaan kaaga weynaan doonaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuusuf Oo Ka Sarreeyey Masar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 41:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.40",
            "verseOrgIds": [
              "GEN.41.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 41:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu Yuusuf ku yidhi, Bal eeg, dalka Masar oo dhan ayaan kaa sarraysiiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.41",
            "verseOrgIds": [
              "GEN.41.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 41:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu Fircoon gacantiisa ka bixiyey kaatunkiisii, oo Yuusuf gacanta u geliyey, oo wuxuu u xidhay dhar aad u wanaagsan, silsilad dahab ahna qoortuu u sudhay; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.42",
            "verseOrgIds": [
              "GEN.41.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 41:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu fuushiiyey gaadhifaraskii labaad oo uu lahaa, oo waxay hortiisa kaga qayliyeen, Sujuuda; oo wuxuu ka sarraysiiyey dalka Masar oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.43",
            "verseOrgIds": [
              "GEN.41.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 41:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu Yuusuf ku yidhi, Anigu waxaan ahay Fircoon, oo adiga la'aantaa ninna gacantiisa ama cagtiisa kor uma qaadi doono dalka Masar oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.44",
            "verseOrgIds": [
              "GEN.41.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 41:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu Yuusuf magiciisii u bixiyey Saafnad Facneh, oo wuxuu u guuriyey Aasenad oo ahayd ina Footiiferac, wadaadkii Oon. Yuusufna markaasuu dalkii Masar oo dhan u baxay oo wada maray. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.45",
            "verseOrgIds": [
              "GEN.41.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 41:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuusufna soddon sannadood buu jiray markuu hor istaagay Fircoon oo ahaa boqorkii Masar. Markaasaa Yuusuf Fircoon hortiisii ka tegey, oo wuxuu wada maray dalkii Masar oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.46",
            "verseOrgIds": [
              "GEN.41.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 41:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa toddobadii sannadood oo barwaaqada ahayd waxaa dhulkii ka soo baxay wax aad u badan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.47",
            "verseOrgIds": [
              "GEN.41.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 41:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu ururiyey cuntadii toddobadii sannadood baxday oo dalka Masar oo dhan tiil, oo cuntadii wuxuu ku kaydiyey magaalooyinka. Cuntadii beerihii ku wareegsanaa magaalo kastana isku meel buu ku kaydiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.48",
            "verseOrgIds": [
              "GEN.41.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 41:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yuusuf hadhuudh aad u badan wuxuu u kaydiyey sida cammuudda badda, ilaa uu tirintii daayay, maxaa yeelay, waxay ahayd wax aan tiro lahayn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.49",
            "verseOrgIds": [
              "GEN.41.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 41:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yuusuf waxaa u dhashay laba wiil intii aan sannaddii abaarta ahayd iman, oo waxaa u dhashay Aasenad oo ahayd ina Footiiferac, wadaadkii Oon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.50",
            "verseOrgIds": [
              "GEN.41.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 41:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yuusuf wuxuu curadkii magiciisii u bixiyey Manaseh; waayo, wuxuu yidhi, Ilaah waa i illowsiiyey dhibaatadaydii oo dhan, iyo gurigii aabbahay oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.51",
            "verseOrgIds": [
              "GEN.41.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 41:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii labaadna magiciisii wuxuu u bixiyey Efrayim. Waayo, wuxuu yidhi, Ilaah waa igu badiyey dalkii aan ku dhibtooday. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.52",
            "verseOrgIds": [
              "GEN.41.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 41:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa toddobadii sannadood oo barwaaqada ahayd ay dalkii Masar ka dhammaadeen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 41:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa bilaabatay toddobadii sannadood oo abaarta ahayd, sidii Yuusuf yidhi. Dalalkii oo dhanna abaar baa ka dhacday; laakiinse dalka Masar oo dhan cuntaa jirtay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 41:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markii dalkii Masar oo dhammu wada abaarsaday ayaa dadkii Fircoon cunto ugu qayliyeen. Markaasaa Fircoon wuxuu ku yidhi Masriyiintii oo dhan, Yuusuf u taga, oo wuxuu idin yidhaahdo yeela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "GEN 41:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo abaartuna waxay ka dhacday dhulka dushiisa oo dhan. Markaasaa Yuusuf wada furay maqsinnadii oo dhan, oo wuxuu hadhuudhkii ka iibiyey Masriyiintii, abaartuna aad bay ugu xumayd dalka Masar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "GEN 41:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa dalalkii oo dhammu waxay u soo safreen Masar, oo Yuusuf bay ugu yimaadeen inay hadhuudh ka iibsadaan; maxaa yeelay, abaartu aad bay ugu xumayd dhulka oo dhan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
            "verseOrgIds": [
              "GEN.41.57"
            ]
          }
        }
      ]
    }
