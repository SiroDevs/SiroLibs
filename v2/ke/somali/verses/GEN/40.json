    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ninkii Khamriga Fircoon Siin Jiray Iyo Dubihii Kibista",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxyaalahaas ka dib, kii boqorkii Masar khamriga siin jiray iyo kii wax u dubi jiray waxay xumeeyeen sayidkoodii ahaa boqorkii Masar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fircoonna aad buu ugu cadhaysnaa labadiisii sirkaal oo ahaa kii madaxa u ahaa kuwii khamriga siin jiray, iyo kii madaxa u ahaa kuwii wax u dubi jiray. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu iyagii ku xabbisay gurigii madaxa waardiyayaasha, xagga xabsiga gudihiisa oo ahaa meeshii Yuusuf ku xidhnaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madaxii waardiyayaashuna Yuusuf amar buu u siiyey iyagii, wuuna u adeegi jiray iyagii; intii wakhti ahna xabsigay ku jireen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kii khamriga siin jiray iyo kii wax u dubi jiray boqorkii Masar, iyagoo xabsiga ku xidhnaa, ayay labadoodiiba isku habeen riyoodeen, nin kastaana riyadiisuu ku riyooday oo nin kastaa wuxuu ku riyooday sidii riyadiisii fasirkeedu ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Subaxdii baa Yuusuf u soo galay oo fiiriyey iyagii, oo wuxuu arkay iyagoo calool xun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu wax weyddiiyey saraakiishii Fircoon oo isaga lagula xabbisay guriga sayidkiisa, oo wuxuu ku yidhi, Maxaad maanta ugu eg tihiin kuwo calool xun? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay waxay ku yidhaahdeen isagii, Riyaannu ku riyoonnay, mana jiro mid fasiri karaa. Markaasaa Yuusuf wuxuu ku yidhi iyagii, Miyaan Ilaah fasirro lahayn? Haddaba waan idin baryayaaye, bal ii sheega. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa madaxii kuwii khamriga keeni jiray riyadiisii Yuusuf u sheegay, oo wuxuu yidhi, Riyadaydii waxaan ku arkay geed canab ah oo i hor yaal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geedkuna wuxuu lahaa saddex laamood. Waxayna u ekaayeen sidii iyagoo magoolaya, ubaxyadiina soo baxayaan; markaasaa rucubyadii waxay noqdeen canab bisil. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koobkii Fircoonna gacantayduu ku jiray, markaasaan canabkii guray oo koobkii Fircoon ku tuujiyey, koobkiina waxaan u dhiibay gacantii Fircoon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yuusuf ku yidhi, Fasirkeedii waa kan: saddexda laamood waa saddex maalmood. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba saddex maalmood dhexdooda ayaa Fircoon madaxaaga kor u qaadi doonaa, oo meeshaaduu kugu celin doonaa; Fircoon koobkiisiina gacantiisaad u dhiibi doontaa sidii waagii hore markaad ahaan jirtay kii khamriga siin jiray. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waan ku baryayaaye, i soo xusuuso markay kuu hagaagto, oo ii roonow, oo Fircoon ii sheeg, oo gurigan iga bixi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, waxaa layga soo xaday dhulka Cibraaniyada, oo halkanna kuma aan samayn wax ay iigu ridaan godxabsiga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madaxii kuwii wax dubi jiray markuu arkay inuu fasirkaasu wanaagsanaa ayuu wuxuu Yuusuf ku yidhi, Aniguna waxaan riyadaydii ku arkay saddex dambiil oo kibis cadcadu ku jirto oo madaxayga saaran. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dambiishii ugu wada sarreeyey waxaa ku jiray cunto cayn kasta ah oo Fircoon loo dubay; markaasay haadkii cuntadii ka cuneen dambiishii madaxayga saarnaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yuusuf u jawaabay oo ku yidhi, Fasirkeedii waa kan; saddexda dambiil waa saddex maalmood. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba saddex maalmood dhexdooda ayaa Fircoon madaxaaga kor kaaga qaadi doonaa, geed buuna kaa soo deldeli doonaa, markaasaa haadku hilibkaaga cuni doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maalintii saddexaad oo la xusuustay maalintii Fircoon dhashay ayuu addoommadiisii oo dhan diyaafad u sameeyey; markaasuu kor u qaaday madaxii kii madaxa u ahaan jiray kuwii khamriga isaga siin jiray iyo madaxii kii madaxa u ahaan jiray kuwii wax u dubi jiray oo addoommadiisa dhex joogay. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
            "verseOrgIds": [
              "GEN.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu madaxii kuwii khamriga keeni jiray mar kale shaqadiisii ku celiyey; oo koobkii buu u dhiibay gacantii Fircoon; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.21",
            "verseOrgIds": [
              "GEN.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse madaxii kuwii wax dubi jiray ayuu deldelay sidii Yuusuf ugu fasiray iyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse madaxii kuwii khamriga keeni jiray ma uu xusuusan Yuusuf, wuuse illoobay isagii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.23",
            "verseOrgIds": [
              "GEN.40.23"
            ]
          }
        }
      ]
    }
  ],
