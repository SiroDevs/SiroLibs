    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Reerkii Reekaab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanu waa eraygii Yeremyaah xagga Rabbiga uga yimid wakhtigii Yehooyaaqiim ina Yoosiyaah uu boqorka ka ahaa dalka Yahuudah, oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaad u tagtaa reer Reekaab, oo la hadal, oo guriga Rabbiga qolladihiisa middood geli, waxaanad siisaa khamri ay cabbaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaan soo kaxaystay Ya'asanyaah ina Yeremyaah oo ahaa ina Habasinyaah, iyo walaalihiis, iyo wiilashiisii oo dhan, iyo qooyskii reer Reekaab oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo gurigii Rabbigana waan keenay, oo waxaan soo geliyey qolladdii ilma Xaanaan kaasoo ahaa ina Yigdalyaah oo ahaa nin Ilaah u go'ay, taasoo ku dhinac tiil qolladdii amiirrada, oo ka sii korraysay qolladdii Macaseeyaah ina Shalluum ee iridjooge ahaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaan wiilashii reer Reekaab soo hor dhigay weelal khamri ka buuxo iyo koobab, oo waxaan ku idhi, Khamrigan cabba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse waxay yidhaahdeen, Innaba khamri cabbi mayno, waayo, awowgayo Yoonaadaab oo ahaa ina Reekaab ayaa nagu amray oo nagu yidhi, Weligiin idinka iyo wiilashiinnuba waa inaydaan khamri cabbin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo innaba guri ha dhisanina, abuurna ha daadinina, oo beercanabna ha beeranina, hana yeelanina, laakiinse cimrigiinna oo dhan waxaad degganaataan teendhooyin si aad wakhti dheer u sii joogtaan dalka aad deggan tihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo annagu waannu addeecnay codkii awowgayo Yoonaadaab ina Reekaab oo nagu amray inaannan innaba khamri cabbin cimrigayaga oo dhan, annaga, iyo naagahayaga, iyo wiilashayada, iyo gabdhahayaguba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo inaannan guryo aan ku degnona innaba dhisan, oo weliba annagu ma aannu lihin beercanab, ama beer kale, amase abuurba, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse teendhooyin baannu ku degganayn, oo waannu addeecnay, waanan wada samaynay sidii awowgayo Yoonaadaab uu nagu amray oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse markii Nebukadresar oo boqorka Baabuloon ahu uu dalka yimid ayaannu isnidhi, Ina keena aynu Yeruusaalem u guurnee, waana cabsida aannu ciidanka reer Kaldayiin, iyo ciidanka reer Suuriya ka cabsannay aawadeed, oo sidaas daraaddeed ayaannu Yeruusaalem ku deggan nahay.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa eraygii Rabbigu Yeremyaah u yimid, isagoo leh, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbiga ciidammada oo ah Ilaaha reer binu Israa'iil wuxuu leeyahay, Tag, oo dadka Yahuudah iyo kuwa Yeruusaalem degganba waxaad ku tidhaahdaa, Rabbigu wuxuu leeyahay, War, tacliin miyeydaan qaadanayn inaad erayadayda maqashaan? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaadaab ina Reekaab erayadiisii uu wiilashiisa ku amray inayan innaba khamri cabbin waa la wada oofiyey, oo ilaa maantadan la joogo iyagu khamrina ma cabbaan, waayo, waxay addeecaan amarkii awowgood, aniguse waan idinla hadlay, anigoo goor wanaagsan idinla hadlaya, laakiinse innaba ima aydaan dhegaysan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba waxaan idiin soo diray nebiyadii addoommadayda ahaa anigoo goor wanaagsan idiin soo diraya, oo idinku leh, Midkiin kastaaba haatan jidkiisa sharka ah ha ka soo noqdo, oo falimihiinnana hagaajiya, oo ilaahyo kale ha daba gelina inaad u adeegtaan aawadeed, oo markaas waxaad iska degganaan doontaan dalkii aan siiyey idinka iyo awowayaashiinba, laakiinse idinku dheg iima aydaan dhigin, oo innaba ima aydaan dhegaysan. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaadaab ina Reekaab wiilashiisii way wada oofiyeen amarkii awowgood uu iyaga ku amray, laakiinse dadkanu aniga ima ay dhegaysan, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "sidaas daraaddeed Rabbiga ah Ilaaha ciidammada oo ah Ilaaha reer binu Israa'iil wuxuu leeyahay, Bal ogaada, dadka Yahuudah iyo kuwa Yeruusaalem deggan oo dhanba waxaan ku soo dejin doonaa masiibadii aan iyaga kaga hadlay oo dhan, maxaa yeelay, waan la hadlay, laakiinse ima dhegaysan, waanan u yeedhay, laakiinse iima ay jawaabin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaas Yeremyaah wuxuu reer Reekaab ku yidhi, Rabbiga ciidammada oo ah Ilaaha reer binu Israa'iil wuxuu leeyahay, Idinku waxaad addeecdeen amarkii awowgiin Yoonaadaab, oo qaynuunnadiisii oo dhanna waad dhawrteen, oo waxaad wada samayseen wixii uu idinku amray oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "haddaba sidaas daraaddeed, Rabbiga ciidammada oo ah Ilaaha reer binu Israa'iil wuxuu leeyahay, Yoonaadaab ina Reekaab marnaba weligiis ma waayi doono nin hortayda istaaga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
