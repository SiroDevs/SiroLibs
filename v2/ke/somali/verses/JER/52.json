          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo si roon buu ula hadlay, oo wuxuu carshigiisii ka kor mariyey carshigii boqorradii isagii Baabuloon la joogay. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
