              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dharkiisii xabsiga ayuu beddelay oo hortiisuu wax ku cuni jiray had iyo jeerba cimrigiisii oo dhanba. ",
          "type": "text",
          "attrs": {
