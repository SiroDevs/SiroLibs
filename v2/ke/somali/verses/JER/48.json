{
  "id": "JER.48",
  "number": "48",
  "bookId": "JER",
  "reference": "Yeremyaah 48",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
