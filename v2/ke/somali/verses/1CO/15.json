{
  "id": "1CO.15",
  "number": "15",
  "bookId": "1CO",
  "reference": "1 Korintos 15",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
