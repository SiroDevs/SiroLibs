          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bal eega, Sayidka ah Rabbiga ciidammadu wuxuu laamaha u gooyn doonaa si aad loogaga cabsado, oo kuwa waaweynna waa la jari doonaa, oo kuwa dhaadheerna waa la ridi doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo jiqda duuddana bir buu ku jari doonaa, oo Lubnaanna waxay ku dhici doontaa mid xoog badan gacantiis.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
              "ISA.10.34"
            ]
          }
