          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xataa dhallinyaradu way itaal darnaan doonaan, oo daali doonaan, oo barbaarraduna aad bay u dhici doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.30",
            "verseOrgIds": [
              "ISA.40.30"
            ]
          }
        },
        {
