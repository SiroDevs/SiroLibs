            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
            "verseOrgIds": [
              "ISA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sannaddii Boqor Aaxaas dhintay ayaa warkan culus la yidhi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.28",
            "verseOrgIds": [
              "ISA.14.28"
            ]
          }
        }
      ]
