{
  "id": "ISA.49",
  "number": "49",
  "bookId": "ISA",
  "reference": "Ishacyaah 49",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
