          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoog waxaa leh kuwa xumaanta ku soo jiita xadhkaha aan waxba tarayn, oo dembigana ku soo jiita jaraha gaadhiga oo kale, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.18",
            "verseOrgIds": [
              "ISA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwaasoo yidhaahda, Isagu ha soo dhaqsado, oo shuqulkiisana ha soo deddejiyo, si aannu u aragno aawadeed, oo Kan Quduuska ah oo reer binu Israa'iil taladiisuna ha soo dhowaato oo ha timaado, si aannu iyada u aqoonsanno aawadeed!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.19",
            "verseOrgIds": [
              "ISA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.19",
            "verseOrgIds": [
              "ISA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoog waxaa leh kuwa sharka yidhaahda waa wanaag, wanaagna yidhaahda waa shar, oo gudcurkana iftiin ku beddela, iftiinkana gudcur ku beddela, oo qadhaadhkana macaan ku beddela, macaankana qadhaadh ku beddela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
            "verseOrgIds": [
              "ISA.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
            "verseOrgIds": [
              "ISA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoog waxaa leh kuwa isla caqliga badan ee isla miyirka badan!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoog waxaa leh kuwa u xoogga badan inay khamri cabbaan, iyo dadka u itaalka weyn inay qasaan wax lagu sakhraamo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.22",
            "verseOrgIds": [
              "ISA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwaasoo kan sharka leh xaq ka dhiga laaluush aawadiis, oo ka xaqa ahna xaqiisa ka qaada! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.23",
            "verseOrgIds": [
              "ISA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba sidaas daraaddeed sida carrabka dabku xaabka u gubo, oo uu cawskuna ololka ugu dhammaado ayaa xididkoodu u xumaan doonaa, oo ubaxooduna wuxuu u duuli doonaa sida boodh oo kale, maxaa yeelay, waxay diideen sharcigii Rabbiga ciidammada, oo waxay quudhsadeen Kan Quduuska ah oo reer binu Israa'iil eraygiisii. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.24",
            "verseOrgIds": [
              "ISA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba sidaas daraaddeed ayaa cadhadii Rabbigu dadkiisa ugu oloshay, oo wuxuu iyaga ku soo fidiyey gacantiisii, wax buuna ku dhuftay, oo buurihiina way wada gariireen, oo meydadkoodiina jidadkay dhex daadsanaayeen sida qashin oo kale, hase ahaatee cadhadiisa kama uu sii jeedin, laakiinse gacantiisu weli way sii fidsan tahay.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.25",
            "verseOrgIds": [
              "ISA.5.25"
            ]
          }
