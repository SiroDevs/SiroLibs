          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JON 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu wuxuu Yoonis u diyaariyey kalluun weyn oo isaga liqa; Yoonisna wuxuu kalluunka calooshiisii ku dhex jiray saddex habeen iyo saddex maalmood.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
    }
  ],
