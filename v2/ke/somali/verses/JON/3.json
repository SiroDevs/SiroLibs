          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaasaa Ilaah wuxuu arkay shuqulkoodii iyo inay iyagu ka noqdeen jidkoodii xumaa, kolkaasaa Ilaah wuxuu ka noqday sharkii uu sheegay inuu iyaga ku samaynayo; oo taasna ma uu samayn.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
