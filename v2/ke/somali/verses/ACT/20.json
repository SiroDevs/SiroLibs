            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qudhiinnu isjira, idahana jira, kuwaasoo Ruuxa Quduuska ahu idiinka dhigay beldaajiyayaal inaad daajisaan kiniisadda Ilaah oo uu dhiiggiisa ku iibsaday. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.28",
            "verseOrgIds": [
              "ACT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaan ogahay markaan tago dabadeed inay idin dhex geli doonaan uubatooyin xunxun iyagoo aan idaha wax ka reebaynin; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.29",
            "verseOrgIds": [
              "ACT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaa idinka dhex kici doona niman waxyaalo qalqalloocan ku hadlaya inay xertii u jiitaan xaggooda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
            "verseOrgIds": [
              "ACT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas darteed, soo jeeda, idinkoo xusuusanaya in intii saddex sannadood ah aanan ka joogsan inaan mid kasta habeen iyo maalinba waaniyo anigoo ilmaynaya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        }
      ]
    },
