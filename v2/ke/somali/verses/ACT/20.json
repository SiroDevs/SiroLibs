              "ACT.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markuu waxaas ku hadlay dabadeed ayuu jilba joogsaday oo la tukaday dhammaantood. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay kulligood aad u wada ooyeen, oo Bawlos qoorta kaga dhaceen oo dhunkadeen, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyagoo sida badan ka caloolxun hadalkuu ku hadlay oo ahaa inayan mar dambe wejigiisa arki doonin. Markaasay sii ambabbixiyeen isagii ilaa doonnidii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
          }
