        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imminka waxaan idinku ammaano gelinayaa Ilaah iyo ereyga nimcadiisa kaasoo kara inuu idin dhiso oo dhaxal idinka dhex siiyo kuwa quduus laga dhigay oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aan damcin ninna lacagtiis, ama dahabkiis, ama dharkiis. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idinka qudhiinnu waad og tihiin inay gacmahanu u adeegeen waxaannu u baahnayn aniga iyo kuwii ila joogayba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wax walba waan idin tusay si ay waajib idiinku tahay, idinkoo sidaas oo kale u hawshoonaya, inaad caawisaan kuwa itaalka yar, oo aad xusuusataan ereyadii Rabbi Ciise siduu isaga qudhiisu yidhi, In wax la helo, waxaa ka barako badan in wax la bixiyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
