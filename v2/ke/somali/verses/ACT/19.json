{
  "id": "ACT.19",
  "number": "19",
  "bookId": "ACT",
  "reference": "Falimaha Rasuullada 19",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
