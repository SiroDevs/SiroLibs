    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlos iyo Barnabas oo Ikoniyon Jooga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waxaa Ikoniyon ka dhacday inay wada galeen sunagogga Yuhuudda, oo siday u hadleen aawadeed dad badan oo Yuhuud iyo Gariigba ah ayaa rumaystay. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.1",
            "verseOrgIds": [
              "ACT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin Yuhuuddii caasiyiinta ahayd ayaa waxay dadkii aan Yuhuudda ahayn ku kiciyeen oo si xun ugu direen walaalihii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.2",
            "verseOrgIds": [
              "ACT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba wakhti dheer ayay halkaas joogeen iyagoo geesinimo ugu hadlaya Rabbiga, kaasoo markhaati u furay ereyga nimcadiisa, wuxuuna siiyey inay calaamooyin iyo yaabab gacmahooda ku sameeyaan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.3",
            "verseOrgIds": [
              "ACT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa dadkii badnaa oo magaaladu kala qaybsameen, oo qaar waxay raaceen Yuhuudda, qaarna rasuulladii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.4",
            "verseOrgIds": [
              "ACT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markii dadkii aan Yuhuudda ahayn iyo Yuhuuddaba, iyaga iyo taliyayaashoodii, ay ku yaaceen inay caayaan oo dhagxiyaan, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.5",
            "verseOrgIds": [
              "ACT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayay garteen, oo waxay u carareen magaalooyinkii la odhan jiray Luka'oniya iyo Lustara iyo Derbe iyo dhulka ku wareegsan; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.6",
            "verseOrgIds": [
              "ACT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "meeshaasna ayay injiilka ku wacdiyeen dadka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlos iyo Barnabas oo Lustara Jooga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.7",
            "verseOrgIds": [
              "ACT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lustara waxaa fadhiyey nin aan cagaha xoog ku lahayn, oo tan iyo markuu uurka hooyadii ka dhashay curyaan ahaa, kaasoo aan weligiis socon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isagu wuxuu maqlay Bawlos oo hadlaya, kaasoo indhaha aad ugu fiiriyey, gartayna inuu rumaysad uu ku bogsan karo leeyahay, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.9",
            "verseOrgIds": [
              "ACT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuxuuna cod dheer ku yidhi, Cagahaaga sare isugu taag. Markaasuu booday oo socday. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.10",
            "verseOrgIds": [
              "ACT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markii dadkii badnaa arkeen wixii Bawlos sameeyey, ayay codkoodii sare u qaadeen, iyagoo afkii Luka'oniya ku leh, Ilaahyadu waxay inoogu yimaadeen iyagoo sidii niman u eg. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.11",
            "verseOrgIds": [
              "ACT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barnabasna waxay u bixiyeen Yubiter; Bawlosna waxay u bixiyeen Merkuriyos, maxaa yeelay, wuxuu ahaa kii hadalka waday. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.12",
            "verseOrgIds": [
              "ACT.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa wadaadkii Yubiter oo macbudkiisu ku yiil magaalada horteeda, wuxuu irdaha keenay dibiyo, iyo ubaxyo isku taxan, wuxuuna doonayay inuu dadkii badnaa la sadqeeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.13",
            "verseOrgIds": [
              "ACT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin rasuulladii Barnabas iyo Bawlos markay maqleen, ayay dharkoodii jeexjeexeen, oo dadkii badnaa ku soo dhex boodeen, iyagoo ku dhawaaqaya ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo leh, Niman yahow, maxaad waxyaalahan u samaynaysaan? Annagu waxaannu nahay niman idinla dabiicad ah, oo waxaannu idiin keenaynaa war wanaagsan inaad ka soo jeesataan waxyaalahan aan micnaha lahayn oo u jeesataan Ilaaha nool, kaasoo sameeyey samada iyo dhulka iyo badda iyo waxyaalaha ku jira oo dhan, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.15",
            "verseOrgIds": [
              "ACT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaasoo qarniyada tegey quruumaha oo dhan u oggolaaday inay jidadkooda ku socdaan. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hase ahaatee isu maragfurla'aan iskama sii dayn, laakiin wanaag buu sameeyey, oo wuxuu samada idinka siiyey roob iyo xilliyo barwaaqo ah, isagoo qalbiyadiinna ka dherginaya cunto iyo farxad. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markay waxyaalahaas yidhaahdeen, ayay dadkii badnaa dhib kaga joojiyeen inay u sadqeeyaan iyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin waxaa Antiyokh iyo Ikoniyon ka yimid Yuhuud, oo markay dadkii badnaa yeelsiiyeen, ayay Bawlos dhagxiyeen, oo magaaladii ka jiideen, iyagoo u malaynaya inuu dhintay. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.19",
            "verseOrgIds": [
              "ACT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiin intii xertii hareerihiisii taagnaayeen, ayuu kacay, markaasuu magaaladii galay; maalintii dambena wuu ka baxay oo Barnabas u raacay Derbe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bawlos iyo Barnabas Waxay ku Noqdeen Antiyokh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markay magaaladaas injiilkii ku wacdiyeen oo kuwo badan xer ka dhigeen, ayay ku noqdeen Lustara iyo Ikoniyon iyo Antiyokh, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.21",
            "verseOrgIds": [
              "ACT.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyagoo nafihii xerta ku xoogaynaya, kuna waaninaya inay iimaanka ku sii wadaan, iyagoo ku leh, Waa inaynu dhibaatooyin badan ku galnaa boqortooyada Ilaah. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.22",
            "verseOrgIds": [
              "ACT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markay iyagii kiniisad walba waayeello uga dooreen oo ay soon ku tukadeen, waxay iyagii ku ammaana geliyeen Rabbiga ay rumaysteen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.23",
            "verseOrgIds": [
              "ACT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay sii dhex mareen Bisidiya oo yimaadeen Bamfuliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
              "ACT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kolkay ereyga kaga hadleen Berga ayay waxay tageen Ataliya; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.25",
            "verseOrgIds": [
              "ACT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "meeshaasna waxay uga dhoofeen Antiyokh, taasoo ahayd meeshii iyaga lagaga ammaana geliyey nimcadii Ilaah shuqulkii ay sameeyeen aawadiis. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
            "verseOrgIds": [
              "ACT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markay yimaadeen oo kiniisaddii isu ururiyeen waxay uga warrameen waxyaalihii Ilaah iyaga la sameeyey oo dhan iyo siduu albaabka iimaanka ugu furay dadkii aan Yuhuudda ahayn. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.27",
            "verseOrgIds": [
              "ACT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay wakhti aan yarayn xertii la joogeen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.28",
            "verseOrgIds": [
              "ACT.14.28"
            ]
          }
        }
      ]
    }
