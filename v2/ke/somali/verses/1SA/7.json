        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa waxaa yimid dadkii reer Qiryad Yecaariim, oo waxay qaateen sanduuqii Rabbiga, oo waxay soo geliyeen gurigii Abiinaadaab ee buurta ku yiil, oo waxay quduus ka dhigeen wiilkiisii Elecaasaar inuu hayo sanduuqii Rabbiga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samuu'eel Oo Reer Falastiin Ka Hooseysiiyey Misfaah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ilaa maalintii sanduuqu yiil Qiryad Yecaariim wakhtigu waa dheeraa, maxaa yeelay, waxay ahayd labaatan sannadood, oo reer binu Israa'iil oo dhammuna Rabbiga ayay ka daba barooran jireen. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Samuu'eel wuxuu la hadlay reer binu Israa'iil oo dhan, oo wuxuu ku yidhi, Haddaad qalbigiinna oo dhan Rabbiga ugu soo noqotaan, de haddaba dhexdiinna ka fogeeya ilaahyada qalaad iyo Cashtarod, oo qalbiyadiinna u diyaariya Rabbiga oo keligiis u adeega; oo isna wuu idinka samatabbixin doonaa gacanta reer Falastiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa reer binu Israa'iil iska fogeeyeen Bacaliim iyo Cashtarod, oo waxay u adeegeen Rabbiga keliya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Samuu'eel wuxuu yidhi, Reer binu Israa'iil oo dhan Misfaah ku soo wada ururiya, oo anna Rabbigaan idiin baryayaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasay dhammaantood Misfaah ku soo wada urureen, oo intay biyo soo dhaamiyeen ayay Rabbiga hortiisa ku shubeen, oo maalintaasna way soomeen, oo waxay halkaas ku yidhaahdeen, Annagu waxaannu ku dembaabnay Rabbiga. Oo Samuu'eelna wuxuu reer binu Israa'iil ku xukumi jiray Misfaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer Falastiinna markay maqleen in reer binu Israa'iil Misfaah ku urursan yihiin ayaa madaxdii reer Falastiin u kaceen inay ku soo duulaan reer binu Israa'iil. Oo reer binu Israa'iilna markay taas maqleen ayay aad uga cabsadeen reer Falastiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer binu Israa'iilna waxay Samuu'eel ku yidhaahdeen, Ha joojin inaad noo baridid Rabbiga Ilaaheenna ahu inuu naga badbaadiyo gacanta reer Falastiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Samuu'eel soo kaxaystay wan yar oo caanonuug ah oo wuxuu Rabbiga ugu bixiyey allabari la gubo dhammaantiis; markaasaa Samuu'eel Rabbiga u baryay reer binu Israa'iil aawadood; oo Rabbiguna wuu ka aqbalay Samuu'eel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intii Samuu'eel allabariga la gubo bixinayay ayaa reer Falastiin soo dhowaadeen inay la diriraan reer binu Israa'iil; laakiinse Rabbigu maalintaas wuxuu reer Falastiin ku soo daayay onkod weyn, wuuna baabbi'iyey, oo reer binu Israa'iil hortooday ku jabeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasay raggii reer binu Israa'iil intay Misfaah ka soo baxeen reer Falastiin eryadeen, wayna laynayeen ilaa ay Beytkaar hoosteeda yimaadeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Samuu'eel dhagax qaaday oo qotomiyey Misfaah iyo Sheen dhexdooda, oo wuxuu magiciisiina u bixiyey Ebenceser, oo yidhi, Ilaa haatan Rabbigu waa ina caawiyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed reer Falastiin waa la hoosaysiiyey, oo mar dambena sooma ay gelin xuduudkii reer binu Israa'iil; oo intii Samuu'eel noolaa oo dhan gacanta Rabbigu gees bay ka ahayd reer Falastiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalooyinkii reer Falastiin ay ka qabsadeen reer binu Israa'iil waa loo soo celiyey reer binu Israa'iil, oo waxay ahaayeen Ceqroon iyo xataa tan iyo Gad; oo xuduudkeedii reer binu Israa'iil waa kala soo baxeen gacantii reer Falastiin. Oo reer binu Israa'iil iyo reer Amorna nabad baa u dhexaysay. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Samuu'eelna wuxuu reer binu Israa'iil xukumi jiray intuu noolaa oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sannad kastaba wuxuu ku soo wareegi jiray Beytel, iyo Gilgaal, iyo Misfaah, oo meelahaas oo dhanna reer binu Israa'iil buu ku xukumi jiray. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu ku noqon jiray Raamaah, waayo, halkaasuu gurigiisu ahaa, oo halkaasna reer binu Israa'iil buu ku xukumi jiray; oo halkaasna wuxuu Rabbiga uga dhisay meel allabari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
