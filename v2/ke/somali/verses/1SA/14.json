          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markii Saa'uul qabsaday boqortooyada reer binu Israa'iil wuxuu la diriray kulli cadaawayaashiisii dhan kasta ka jiray, kuwaasoo ahaa reer Moo'aab, iyo reer Cammoon, iyo reer Edom, iyo boqorradii reer Soobaah, iyo reer Falastiin; oo meel kasta oo uu u jeestayba si xun buu ugu galay. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isagu si xoog leh ayuu wax ku sameeyey, oo wuxuu laayay reer Siiqlag oo reer binu Israa'iilna wuxuu ka samatabbixiyey gacantii kuwii dhici jiray.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qoyskii Saa'uul",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Saa'uul wiilashiisii waxay ahaayeen Yoonaataan iyo Yishwii, iyo Melkiishuuca; oo labadiisii gabdhoodna magacyadoodii waxay ahaayeen Meerab iyo Miikaal; tii curadda ahayd magaceedu wuxuu ahaa Meerab, tii yaraydna magaceeda waxaa la odhan jiray Miikaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo naagtii Saa'uul magaceeduna wuxuu ahaa Axiino'am, oo waxay ahayd ina Axiimacas; oo sirkaalkii ciidankiisana magiciisu wuxuu ahaa Abneer, wuxuuna ahaa ina Neer, kaasoo ahaa Saa'uul adeerkiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Qiishna wuxuu ahaa Saa'uul aabbihiis; oo Neer oo ahaa Abneer aabbihiis isna wuxuu ahaa ina Abii'eel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
