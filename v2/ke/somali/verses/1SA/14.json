          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intii Saa'uul noolaa oo dhan dagaal kulul oo reer Falastiin ka gees ah ayaa jiray. Oo Saa'uulna markuu arko nin xoog leh, amase nin daran wuu qaadan jiray.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
