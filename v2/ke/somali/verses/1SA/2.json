            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Xannaah tukatay oo waxay tidhi:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Elqaanaah wuxuu tegey Raamaah iyo xaggii gurigiisii. Oo wiilkiina wuxuu Rabbiga uga adeegi jiray wadaadkii Ceelii hortiisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wiilashii Sharka Lahaa Ee Ceelii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Ceelii wiilashiisii waxay ahaayeen wiilal waxmatarayaal ah, oo Rabbiga ma ay aqoon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba caadadii wadaaddadu dadka la lahaayeen waxay ahayd, in markii nin uun allabari bixiyo uu midiidinka wadaadku iman jiray, inta hilibka la karinayo, isagoo gacanta ku sita hilibqabato saddex farood leh, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu ku dhex mudi jiray daawihii, ama kidhligii, ama digsigii, ama dherigii, oo kulli wixii qabatadu ay soo qaaddoba wadaadku wuu qaadan jiray. Oo saasay reer binu Israa'iilkii Shiiloh yimid oo dhan ku sameeyeen. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba intaan baruurta la gubin ayaa midiidinkii wadaadku iman jiray, oo wuxuu ku odhan jiray ninkii alla baryayay, Hilib wadaadka loo dubo keen, waayo, isagu kaa dooni maayo hilib karsan, mid ceedhin ah mooyaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii ninku ku yidhaahdo, Marka hore baruurta hubaal waa la gubayaa, dabadeedse intii naftaadu jeceshahay qaado; markaas wuxuu ku odhan jiray, Maya, saas ma aha, laakiinse haatan i sii, haddii kalese, xoog baan ku qaadan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo raggii dhallinyarada ahaa dembigoodii aad buu ugu weynaa Rabbiga hortiisa; waayo, raggii waxay quudhsan jireen qurbaankii Rabbiga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse Samuu'eel wuxuu ka adeegi jiray Rabbiga hortiisa, isagoo wiil yar ah, ee guntan eefod dhar wanaagsan laga sameeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba hooyadiisna waxay u samayn jirtay khamiis yar, oo sannad ka sannad ayay u keeni jirtay, markay ninkeeda soo raacdo inay bixiyaan allabarigii sannadda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ceeliina waa u duceeyey Elqaanaah iyo afadiisiiba, oo wuxuu ku yidhi, Daynkii Rabbiga la siiyey aawadiis Rabbigu naagtan farcan ha kaa siiyo. Oo iyana waxay tageen xaggii gurigoodii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Rabbigu waa soo booqday Xannaah, oo way uuraysatay, oo waxay dhashay saddex wiil iyo laba gabdhood. Oo yarkii Samuu'eel ahaana wuxuu ku koray Rabbiga hortiisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ceeliina aad buu u gaboobay; oo wuxuuna maqlay wixii ay wiilashiisu reer binu Israa'iil oo dhan ku sameeyeen, iyo inay la seexdeen dumarkii ka adeegi jiray iridda teendhada shirka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu wuxuu ku yidhi iyagii, War maxaad waxyaalaha caynkaas ah u samaysaan? Waayo, waxaan dadkan oo dhan ka maqlay macaamilooyinkiinna xunxun. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maya, wiilashaydiiyow, waayo, warkaan maqlay ma wanaagsana, maxaa yeelay, idinku dadka Rabbiga waad xadgudbisaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddii nin mid kale ku dembaabo, Ilaah baa isaga xukumi doona, laakiinse nin hadduu Rabbiga ku dembaabo, bal yaa isaga u baryootami doona? Laakiinse iyagu ma ay dhegaysan codkii aabbahood, maxaa yeelay, Rabbigu wuxuu doonayay inuu dilo iyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo yarkii Samuu'eel ahaana wuu sii koray, oo Rabbiga iyo dadkuba raalli bay ka ahaayeen.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wax Sii Sheegid Ka Gees Ah Reer Ceelii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Ceelii waxaa u yimid nin Ilaah, oo wuxuu ku yidhi isagii, Sidanaa Rabbigu leeyahay, Reerkii aabbahaa miyaan isu muujiyey markay Masar joogeen oo ay ku hoos jireen addoonsigii reerkii Fircoon? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo miyaan isaga ka doortay qabiilooyinka reer binu Israa'iil oo dhan inuu wadaad ii noqdo, iyo inuu ku allabaryo meeshayda allabariga, iyo inuu uunsi shido, iyo inuu hortayda eefod ku xidho? Oo miyaan reerkii aabbahaa siiyey qurbaannadii reer binu Israa'iil oo dhan ee dab lagu sameeyo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "War maxaad u quudhsataan allabarigayga iyo qurbaankayga aan ku dhex amray rugtayda; oo maxaad wiilashaada iiga murwad badisaa, ee aad naftiinna ugu cayilisaan dadkayga reer binu Israa'iil qurbaannadooda oo dhan inta ugu wanaagsan? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidaas daraaddeed Rabbiga ah Ilaaha reer binu Israa'iil wuxuu leeyahay, Anigu waxaan idhi, Hubaal reerkaaga iyo reerka aabbahaaba hortayday ku socon doonaan weligood. Laakiinse haatan Rabbigu wuxuu leeyahay, Taasu ha iga fogaato, waayo, kuwa i murweeya waan murwayn doonaa, oo kuwa i quudhsadana waa la fududaysan doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bal eeg, waxaa iman doona wakhtigii aan gooyn lahaa gacantaada iyo gacanta reerka aabbahaaba si aan reerkaaga nin da' weyn looga helin. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaad arki doontaa dhibaatada rugtayda markii Ilaah reer binu Israa'iil maal siiyo, oo reerkaaguna nin da' weyn ma yeelan doono weligiisba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddii la helo nin kaa ah ee aanan meeshayda allabariga ka gooyn, kaasu indhahaaguu gubi doonaa oo qalbigaaguu murugayn doonaa, oo dadkii reerkaaga ka dhashaana dhallinyaronimada ayay ku dhiman doonaan dhammaantood. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tanu waxay kuu ahaan doontaa calaamo, waana waxa ku dhici doona labadaada wiil ee ah Hofnii iyo Fiinexaas, oo labadooduba isku maalin bay dhiman doonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
