    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo saamigii shanaadna wuxuu u soo baxay reer Aasheer sidii reerahoodii ahaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintooduna waxay ahayd Xelqad, iyo Xali, iyo Beten, iyo Akshaaf, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Allammeleg, iyo Camcaad, iyo Mishaal; oo wuxuu gaadhay Karmel xaggeeda galbeed, iyo ilaa Shiihoor Libnaad, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxay u leexatay xagga qorraxdu ka soo baxdo, ee ah Beytdaagoon, oo waxay gaadhay tan iyo Sebulun, iyo dooxadii Yiftax'eel xaggeeda woqooyi iyo ilaa Beytcemeq iyo Necii'eel, oo waxay u baxday xagga bidix ee ah Kabuul, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Cebroon, iyo Rexob, iyo Xammoon, iyo Qaanaah, iyo xataa Siidoonta weyn; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo soohdintii waxay u leexatay xagga Raamaah, iyo xagga magaaladii deyrka lahayd oo Turos, oo haddana soohdintu waxay u leexatay xagga Xosaah, oo dhammaadkeedu wuxuu ahaa xagga badda ee Aksiib dhinaceeda ah, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Cummaah, iyo Afeeq, iyo Rexob, oo intaasu waa laba iyo labaatan magaalo iyo tuulooyinkoodii. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
