          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalooyinkii deyrka lahaa waxay ahaayeen Siddiim, iyo Seer, iyo Xammad, iyo Raqad, iyo Kinnered, ",
          "type": "text",
          "attrs": {
