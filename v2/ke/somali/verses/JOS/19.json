          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdintoodu waxay ka bilaabatay Xelef, tan iyo geedka ku yaal Sacananniim, iyo Adaamii Neqeb, iyo Yabne'eel, iyo ilaa Laquum; oo dhammaadkeedu wuxuu ahaa xagga Webi Urdun. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
