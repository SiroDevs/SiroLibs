          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Adaamaah, iyo Raamaah, iyo Xaasoor, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.36",
            "verseOrgIds": [
              "JOS.19.36"
