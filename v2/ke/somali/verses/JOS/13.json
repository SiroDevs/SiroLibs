          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xuduudkoodu wuxuu ka koobnaa Maxanayim, iyo Baashaan oo dhan, iyo boqorkii Baashaan oo Coog ahaa boqortooyadiisii oo dhan, iyo magaalooyinkii Yaa'iir oo Baashaan ku yiil oo dhan, kuwaasoo ahaa lixdan magaalo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
