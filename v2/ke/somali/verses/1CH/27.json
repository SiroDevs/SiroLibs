          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Axiitofelna wuxuu ahaa boqorka lataliyihiisa, oo Xuushay oo ahaa reer Arkiina wuxuu ahaa boqorka saaxiibkiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
