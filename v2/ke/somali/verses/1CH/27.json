    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qaybihii Ciidanka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba waa tan reer binu Israa'iil sidii tiradoodu ay ahayd, waxayna ahaayeen madaxdii qolooyinka, iyo kuwii kun kun u taliyey, iyo kuwii boqol boqol u taliyey, iyo saraakiishoodii boqorka uga adeegi jiray wax kasta oo ku saabsan kooxihii soo geli jiray oo bixi jiray bil kasta oo ah bilaha sannadda oo dhan; koox kasta tiradeedu waxay ahayd afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kooxdii kowaad ee bixi jirtay bishii kowaad waxaa madax u ahaa Yaashaabcaam ina Sabdii'eel, oo kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isagu wuxuu ahaa reer Feres, wuxuuna ugu wada sarreeyey saraakiishii ciidanka oo bishii kowaad bixi jiray oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kooxdii bishii labaadna waxaa madax u ahaa Doday oo ahaa reer Axoo'ax, oo kooxdiisa waxaa ku jiray Miqlood oo taliye ahaa, oo kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii saddexaad ee ciidanka oo bishii saddexaad bixi jirayna wuxuu ahaa Benaayaah oo madax ahaa oo ahaa ina wadaadkii ahaa Yehooyaadaac, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kaasu waa Benaayaah oo ahaa kii ugu xoog badnaa soddonkii, oo weliba soddonka madax u ahaa, oo kooxdiisana waxaa ku jiray wiilkiisii Cammiisaabaad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii afraad ee bishii afraad bixi jirayna wuxuu ahaa Casaaheel oo ahaa Yoo'aab walaalkiis, wiilkiisii Sebadyaahna wuu ku xigay, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii shanaad ee bishii shanaad bixi jirayna wuxuu ahaa Shamhuud oo ahaa reer Yisraax, oo kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii lixaad oo bishii lixaad bixi jirayna wuxuu ahaa Ciiraa ina Ciqeesh oo ahaa reer Teqooca, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii toddobaad ee bishii toddobaad bixi jirayna wuxuu ahaa Xeles oo ahaa reer Feloonii, oo ka ahaa reer Efrayim, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii siddeedaad oo bishii siddeedaad bixi jirayna wuxuu ahaa Sibbekay oo ahaa reer Xushaad, oo ka ahaa reer Serax, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii sagaalaad ee bishii sagaalaad bixi jirayna wuxuu ahaa Abiiceser oo ahaa reer Canaatood, oo ka ahaa reer Benyaamiin, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii tobnaad ee bishii tobnaad bixi jirayna wuxuu ahaa Maharay oo ahaa reer Netofaah oo ka ahaa reer Serax, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii kow iyo tobnaad ee bishii kow iyo tobnaad bixi jirayna wuxuu ahaa Benaayaah oo ahaa reer Fircaatoon, oo ka ahaa reer Efrayim, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sirkaalkii laba iyo tobnaad ee bishii laba iyo tobnaad bixi jirayna wuxuu ahaa Xelday oo ahaa reer Netofaah, oo ka ahaa reer Cotnii'eel, oo isaga kooxdiisana waxaa ku jiray afar iyo labaatan kun oo nin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Madaxdii Qolooyinka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba waxaa qabiilooyinkii reer binu Israa'iil u talinayay kuwan: reer Ruubeen waxaa u talinayay Eliiceser ina Sikrii oo taliye ahaa, reer Simecoonna waxaa u talinayay Shefatyaah ina Macakaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Laawina waxaa u talinayay Hashabyaah ina Qemuu'eel, reer Haaruunna waxaa u talinayay Saadooq, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Yahuudahna waxaa u talinayay Eliihuu, oo Daa'uud walaalihiis ka mid ahaa, reer Isaakaarna waxaa u talinayay Coomrii ina Miikaa'eel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Sebulunna waxaa u talinayay Yishmacyaah ina Cobadyaah, reer Naftaalina waxaa u talinayay Yereemood ina Casrii'eel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Efrayimna waxaa u talinayay Hoosheeca ina Casasyaah, oo reer Manaseh badhkiisna waxaa u talinayay Yoo'eel ina Fedaayaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Manaseh badhkiisii kale oo joogay dalka Gilecaadna waxaa u talinayay Iddo ina Sekaryaah, reer Benyaamiinna waxaa u talinayay Yacasii'eel ina Abneer, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "reer Daanna waxaa u talinayay Casareel ina Yeroxaam. Oo kuwaasu waxay ahaayeen saraakiishii qabiilooyinka reer binu Israa'iil. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse Daa'uud ma uu tirinin intoodii labaatan sannadood ka yarayd, maxaa yeelay, Rabbigu wuxuu yidhi inuu reer binu Israa'iil u badinayo sida xiddigaha samada oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo'aab oo ay Seruuyaah dhashay ayaa bilaabay inuu dadka tirsho, laakiinse ma uusan dhammayn, oo tirintaas aawadeed ayaa reer binu Israa'iil cadho ugu soo degtay, oo tiradiina laguma darin xisaabtii kitaabkii taariikhda oo Boqor Daa'uud.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mas'uuliyiintii Boqorka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo boqorka khasnadihiisana waxaa u talinayay Casmaawed ina Cadii'eel, oo guryihii wax lagu kaydiyey ee beeraha ku yiil, iyo kuwii ku yiil magaalooyinka, iyo tuulooyinka, iyo qalcadahaba waxaa u talinayay Yoonaataan ina Cusiyaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwii samayn jiray shuqulka beeraha inay dhulka qodaanna waxaa u talinayay Cesrii ina Keluub. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo beeraha canabka ahna waxaa u talinayay Shimcii oo ahaa reer Raamad, oo guryihii lagu kaydiyey khamrigii laga helay beeraha canabka ahna waxaa u talinayay Sabdii oo ahaa reer Shifmii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhirtii saytuunka ah iyo dhirtii darayga ah oo dalkii dooxada ahaa ku yiilna waxaa u talinayay Bacal Xaanaan oo ahaa reer Geder, guryihii saliidda lagu kaydiyeyna waxaa u talinayay Yoo'aash. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo lo'dii Shaaroon daaqi jirtayna waxaa u talinayay Shitray oo ahaa reer Shaaroon, oo lo'dii dooxooyinka joogtayna waxaa u talinayay Shaafaad ina Adlay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo geelashana waxaa u talinayay Oobiil oo ahaa reer Ismaaciil, oo dameerahana waxaa u talinayay Yexdeyaah oo ahaa reer Meeronotii, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo adhyahana waxaa u talinayay Yaasiis oo ahaa reer Hagrii. Oo kulli intaas oo dhammu waxay ahaayeen taliyayaashii maalkii Boqor Daa'uud.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
