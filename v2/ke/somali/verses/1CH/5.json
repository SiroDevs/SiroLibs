          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qabiilkii reer Manaseh badhkoodna dalkay degeen, oo waxay ku kordheen tan iyo Baashaan, iyo ilaa Bacal Xermoon, iyo tan iyo Seniir, iyo ilaa Buur Xermoon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwii reerahooda madaxda u ahaana waxay ahaayeen Ceefer, iyo Yishcii, iyo Elii'eel, iyo Casrii'eel, iyo Yeremyaah, iyo Hoodawyaah, iyo Yaxdii'eel, oo intaasu waxay wada ahaayeen rag xoog badan oo magac leh oo reerahooda madax u ah.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        }
      ]
    },
