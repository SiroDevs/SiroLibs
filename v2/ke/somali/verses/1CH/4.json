  "reference": "Taariikhda Kowaad 4",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yahuudahna waxay ahaayeen Feres, iyo Xesroon, iyo Karmii, iyo Xuur, iyo Shoobaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Re'aayaah oo ahaa ina Shoobaalna wuxuu dhalay Yaaxad, Yaaxadna wuxuu dhalay Axuumay iyo Lahad. Kuwanu waa qolooyinkii reer Sorcaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.2",
            "verseOrgIds": [
              "1CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waxay ahaayeen wiilashii uu dhalay Ceetaam aabbihiis, oo waa Yesreceel, iyo Yishmaa, iyo Yidbaash, oo walaashood magaceedana waxaa la odhan jiray Haselelfoonii, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Fenuu'eel oo ahaa Gedoor aabbihiis, iyo Ceser oo ahaa Xuushaah aabbihiis. Kuwanu waa wiilashii Xuur, kaasoo ahaa curadkii Efraataah, oo ahaa Beytlaxam aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Ashxuur oo ahaa Teqooca aabbihiisna wuxuu qabay laba naagood, oo waxay ahaayeen Xelaah iyo Nacaraah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Nacaraah waxay isagii u dhashay Axuusaam, iyo Heefer, iyo Teemnii, iyo Haa'axashtaarii. Intaasu waxay ahaayeen Nacaraah wiilasheedii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xelaah wiilasheediina waxay ahaayeen Sered, iyo Isehaar, iyo Etnaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haqoosna wuxuu dhalay Caanuub, iyo Sobeebaah, iyo qolooyinka reer Axarxeel oo ahaa ina Haaruum. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yacbeesna wuu ka ciso badnaa walaalihiis oo dhan, oo hooyadiis ayaa isagii ku magacawday Yacbees, oo waxay tidhi, Maxaa yeelay, isaga waxaan ku dhalay tiiraanyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Yacbeesna wuxuu baryay Ilaahii reer binu Israa'iil, oo ku yidhi, Waxaan jeclaan lahaa inaad i barakaysid, oo aad soohdintayda ii ballaadhisid, iyo in gacantaadu ila jirto, oo aad sharka iga dhawrtid, si aanan u tiiraanyoon! Oo Ilaahna wuu siiyey wixii uu weyddiistay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keluub oo ahaa Shuuxah walaalkiisna wuxuu dhalay Mexiir, oo ahaa Eshtoon aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshtoonna wuxuu dhalay Beytraafaa, iyo Faasee'ax, iyo Texinnaah oo ahaa Ciirnaaxaash aabbihiis. Oo kuwanu waa nimankii Reekaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Qenasna waxay ahaayeen, Cotnii'eel, iyo Seraayaah, oo Cotnii'eelna wuxuu dhalay Xatad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mecoonotayna wuxuu dhalay Cofraah, oo Seraayaahna wuxuu dhalay Yoo'aab oo ahaa Geharashiim aabbihiis, waayo, iyagu waxay ahaayeen rag saaniciin ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaleeb ina Yefunneh wiilashiisiina waxay ahaayeen Iiruu, iyo Eelaah, iyo Nacam, ina Eelaahna wuxuu ahaa Qenas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Yehaleleelna waxay ahaayeen Siif iyo Siifaah, iyo Tiiryaa, iyo Asareel. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaha Cesraahna waxay ahaayeen Yeter, iyo Mered, iyo Ceefer, iyo Yaaloon, oo iyana waxay dhashay Maryan, iyo Shammay, iyo Yishbax oo ahaa Eshtemooca aabbihiis. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagtiisii Yahuudiyadda ahaydna waxay dhashay Yered oo ahaa Gedoor aabbihiis, iyo Xeber oo ahaa Sookoo aabbihiis, iyo Yequutii'eel oo ahaa Saanoo'ax aabbihiis. Oo kuwanuna waa wiilashii Bityaah oo ahayd ina Fircoon oo uu Mered guursaday. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Hoodiyaah naagtiisii oo ahayd Naxam walaashiis wiilasheediina waxay ahaayeen Qeciilaah kii reer Garmii aabbihiis, iyo Eshtemooca oo ahaa reer Macakaad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Shiimoonna waxay ahaayeen Cammoon, iyo Rinnaah, iyo Benxaanaan, iyo Tiiloon. Wiilashii Yishciina waxay ahaayeen Sooxeed iyo Bensooxeed. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheelaah ina Yahuudah wiilashiisiina waxay ahaayeen Ceer oo ahaa Leekaah aabbihiis, iyo Lacadaah oo ahaa Maareeshaah aabbihiis, iyo qolooyinka reerka kuwa dhar wanaagsan samayn jiray oo ka soo farcamay reer Ashbeeca, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Yooqiim, iyo dadka reer Kosebaa, iyo Yoo'aash, iyo Saaraaf oo u talin jiray Moo'aab, iyo Yaashubilexem. Oo taariikhduna waa wax aad u gaboobay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waxay ahaayeen dheryodhoobyadii, oo waxay degganaan jireen Netaa'iim iyo Gedeeraah, oo halkaas ayay la degganaan jireen boqorka si ay shuqulkiisa u sameeyaan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilashii Simecoonna waxay ahaayeen Nemuu'eel, iyo Yaamiin, iyo Yaariib, iyo Serax, iyo Shaa'uul ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo dhalay Shalluum, oo isna dhalay Mibsaam, oo isna dhalay Mishmaac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishmaac farcankiisuna wuxuu ahaa Xamuu'eel oo dhalay Sakuur, oo isna dhalay Shimcii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimciina wuxuu lahaa lix iyo toban wiil iyo lix gabdhood, laakiinse walaalihiis carruur badan ma ay lahayn, oo qoladooda oo dhammuna uma ay tarmin, sida reer Yahuudah oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyagu waxay degganaayeen Bi'ir Shebac, iyo Molaadaah, iyo Xasar Shuucaal, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.28",
            "verseOrgIds": [
              "1CH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Bilhah, iyo Cesem, iyo Toolad, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.29",
            "verseOrgIds": [
              "1CH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Betuu'eel, iyo Xormaah, iyo Siiqlag, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.30",
            "verseOrgIds": [
              "1CH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Beytmarkaabod, iyo Xasar Suusiim, iyo Beytbirii, iyo Shacarayim. Intaasu waxay ahaayeen magaalooyinkoodii ay degganaayeen tan iyo waagii Daa'uud boqortooyada haystay. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
            "verseOrgIds": [
              "1CH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo tuulooyinkoodiina waxay ahaayeen Ceetaam, iyo Cayn, iyo Rimmon, iyo Token, iyo Caashaan, oo waxay ahaayeen shan magaalo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
            "verseOrgIds": [
              "1CH.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo kulli tuulooyinkoodii ku wareegsanaa isla magaalooyinkaas ilaa tan iyo Bacal. Kuwaasu waxay ahaayeen rugahoodii ay degganaayeen, oo iyagu abtirisna way leeyihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Meshoobaab, iyo Yamleeg, iyo Yooshaah oo ahaa ina Amasyaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Yoo'eel, iyo Yeehuu oo ahaa ina Yooshibyaah ina Seraayaah, ina Casii'eel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Eliyooceenay, iyo Yacaqobaah, iyo Yeshooxaayaah, iyo Casaayaah, iyo Cadii'eel, iyo Yesiimi'eel, iyo Benaayaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo Siisaa oo ahaa ina Shifcii ina Alloon oo ahaa reer Yedacyaah oo ka ahaa reer Shimrii oo ka sii ahaa reer Shemacyaah, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "intaas magacyadooda la sheegay waxay ahaayeen amiirradii qolooyinkooda, oo reerahooduna aad bay si weyn ugu kordheen. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay tageen meesha Gedoor laga galo iyo xataa tan iyo dooxadii dhankeeda bari si ay idahooda daaq ugu doondoonaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay halkaas ka heleen daaq cosob ah oo wanaagsan, oo dhulkuna wuu ballaadhnaa, wuxuuna ahaa dal xasilloon oo nabdoon, waayo, kuwii halkaas waagii hore degganaan jiray waxay ahaayeen reer Xaam. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwan magacyadooda la qoray waxay dalka soo galeen waagii boqorkii reer Yahuudah, oo Xisqiyaah ahaa, oo waxay dumiyeen teendhooyinkoodii oo laayeen reer Mecuuniimkii halkaas laga helay, dhammaantoodna way wada baabbi'iyeen, ilaa maantadan la joogo, oo meeshoodii bay degeen, maxaa yeelay, meeshaasu waxay lahayd daaq ay idahoodu daaqaan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyaga qaarkood oo ahaa reer Simecoon oo tiradoodu ahayd shan boqol oo nin waxay tageen Buur Seciir, oo waxaa saraakiil u ahaa Felatyaah, iyo Necaryaah, iyo Refaayaah, iyo Cusii'eel oo wada ahaa wiilashii Yishcii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay soo laayeen kuwii reer Camaaleq ka hadhay oo baxsaday, oo halkaasay deggan yihiin ilaa maantadan la joogo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
