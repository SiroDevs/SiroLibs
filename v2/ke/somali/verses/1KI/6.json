              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sidaas oo kaluu albaabkii macbudkana ugu yeelay fayaarad qoryo saytuun ah, kaasoo ku yiil derbiga meeshiisa afraad; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
