          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo laba albaab oo qoryo beroosh ah; oo albaabbada midkood wuxuu lahaa laba qaybood oo laabma, kan kalena wuxuu lahaa laba qaybood oo laabma. ",
          "type": "text",
