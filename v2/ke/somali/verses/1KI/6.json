          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo barxaddii dhexena wuxuu u yeelay saddex saf oo dhagax la qoray ah iyo saf alwaax kedar ah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
