              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo gurigii Rabbiga aasaaskiisii waxaa la dhigay bishii Sif oo sannaddii afraad. ",
          "type": "text",
          "attrs": {
