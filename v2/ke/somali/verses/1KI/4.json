              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu ku hadlay saddex kun oo maahmaahood; oo gabayadiisuna waxay ahaayeen kun iyo shan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
