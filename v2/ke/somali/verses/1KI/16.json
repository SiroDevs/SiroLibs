      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaas waxaa Yeehuu ina Xanaanii u yimid Eraygii Rabbiga oo ka gees ah Bacshaa, oo leh, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciiddaan kaa sara mariyey, oo waxaan kaa dhigay amiir u taliya dadkayga Israa'iil, oo adna waxaad ku socotay jidkii Yaaraabcaam, oo dadkaygii Israa'iilna waad dembaajisay, oo waxaad ka dhigtay inay dembiyadoodii igaga xanaajiyaan, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sidaas daraaddeed bal eeg, Bacshaa iyo reerkiisa oo dhanba waan wada baabbi'inayaa, oo reerkaagana waxaan ka dhigayaa sidii reerkii Yaaraabcaam ina Nebaad oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dadka Bacshaa kii magaalada kaga dhinta waxaa cuni doona eeyaha, oo kii duurka kaga dhintana waxaa cuni doona haadka samada. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Bacshaa falimihiisii kale, iyo wixii uu sameeyey, iyo xooggiisii oo dhammu sow kuma qorna kitaabkii taariikhda boqorradii dalka Israa'iil? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Bacshaa dhintay oo la seexday awowayaashiis, oo waxaa lagu aasay Tirsaah, oo meeshiisiina waxaa boqor ka noqday wiilkiisii Eelaah. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddana waxaa Nebi Yeehuu ina Xanaanii u yimid Eraygii Rabbiga oo ka gees ah Bacshaa iyo reerkiisaba, sababtuna waxay ahayd sharkii uu Rabbiga hortiisa ku sameeyey oo dhan ee uu Rabbiga kaga xanaajiyey shuqulkii gacmihiisa, markuu la mid noqday reer Yaaraabcaam, iyo diliddii uu dilay aawadeed.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eelaah, Boqorkii Dalka Israa'iil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Aasaa oo ahaa boqorkii dalka Yahuudah sannaddiisii lix iyo labaatanaad ayaa Eelaah oo ahaa ina Bacshaa dalka Israa'iil boqor ugu noqday Tirsaah, oo wuxuu boqor ahaa laba sannadood. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo addoonkiisii Simrii oo sirkaal u ahaa gaadhifardoodkiisa badhkood ayaa isaga sirqoolay. Haddaba wuxuu joogay Tirsaah isagoo khamri ku cabbaya guriga Arsaa oo madax u ahaa reerkiisii Tirsaah ku yiil; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaa u soo galay Simrii, markaasuu wax ku dhuftay, oo dilay isagii, waxayna ahayd Aasaa oo ahaa boqorkii dalka Yahuudah sannaddiisii toddoba iyo labaatanaad, oo meeshiisiina isagaa boqor ka noqday. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isla markuu boqor noqday ee uu carshigiisii ku fadhiistay wuxuu wada laayay reerkii Bacshaa oo dhan; oo ugama uu reebin dadkii qaraabadiisa ahaa ama saaxiibbadiis toona xataa wiil yar oo keliya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Simrii saasuu u baabbi'iyey reerkii Bacshaa oo dhan, oo waxay noqotay sidii Eraygii Rabbiga ee Bacshaa ka geesta ahaa ee Nebi Yeehuu ku hadlay, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababtuna waxay ahayd dembiyadii Bacshaa iyo dembiyadii wiilkiisii Eelaah oo dhan ee ay dembaabeen ee ay dadkii Israa'iilna dembaajiyeen ee ay Rabbiga ah Ilaaha reer binu Israa'iil kaga xanaajiyeen falimahoodii aan waxtarka lahayn. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Eelaah falimihiisii kale, iyo wixii uu sameeyey oo dhammuba sow kuma qorna kitaabkii taariikhda boqorradii dalka Israa'iil?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
