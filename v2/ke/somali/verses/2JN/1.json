          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Carruurtii walaashaada la doortay way ku soo salaamayaan.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
