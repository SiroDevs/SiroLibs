            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteyosow, wixii laguu dhiibay ilaali, oo ka leexo hadalka aan micnaha lahayn oo nijaasta ah iyo muranka aqoonta beenta ah, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.20",
            "verseOrgIds": [
              "1TI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo qaar qirashadeeda aawadeed iimaanka ku gafeen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimco ha idinla jirto.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    }
