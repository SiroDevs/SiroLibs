          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wadaadku ha ku dul gubo meesha allabariga, waayo, waxaasu waa cuntadii qurbaanka Rabbiga dabka loogu sameeyo.",
          "type": "text",
          "attrs": {
