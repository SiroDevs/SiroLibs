          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wadaadku ha ku dul gubo meesha allabariga, waayo, waxaasu waa cuntadii qurbaankii dabka loogu sameeyo caraf udgoon. Xaydha oo dhan Rabbigaa iska leh. ",
          "type": "text",
          "attrs": {
