          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inuu gacanta saaraa madaxa neefka, oo teendhada shirka horteeda waa inuu ku gowracaa, oo wiilasha Haaruunna neefka dhiiggiisa waa inay ku dul rusheeyaan hareeraha meesha allabariga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
