          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo labada kelyood, iyo xaydha dushooda ku taal, oo xanjaadka u dhow, iyo xuubka beerka ku dul yaal, dhammaantood kelyaha ha la qaado. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
