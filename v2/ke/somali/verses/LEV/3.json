          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo labada kelyood, iyo xaydha ku dul taal oo xanjaadka u dhow, iyo xuubka beerka ku dul yaal, dhammaantood kelyaha ha la qaado. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
            "verseOrgIds": [
              "LEV.3.15"
            ]
          }
        },
        {
          "name": "verse",
