          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo hadduu qurbaankiisa wan yar ku bixinayo, Rabbiga hortiisa ha ku bixiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
