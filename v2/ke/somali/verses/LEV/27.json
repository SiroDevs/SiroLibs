          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee wixii gooni loo sooco, oo qof waxyaalihiisa oo dhan Rabbiga uga sooco, hadday waxaasu yihiin qof, ama neef, ama beerta hantidiisa ah, waa inaan innaba la iibin ama la furan, waayo, wax kasta oo gooni loo sooco waa wax Rabbiga ugu wada quduusan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qof alla qofkii gooni loo sooco oo dadka laga sooco oo dhan waa inaan innaba la soo furan, laakiinse hubaal waa in la dilaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
