              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan xaqdarro ka samayn garsooridda, iyo cabbiridda, iyo miisaamidda iyo beegiddaba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
