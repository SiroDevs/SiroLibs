      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qurbaanka La Gubo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
