          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intii toddoba maalmood ah waa inaad waabab ku hoyataan, oo kulli reer binu Israa'iilka waddaniga ah oo dhammu waa inay waabab ku hoydaan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "si farcankiinna dambe u ogaado inaan reer binu Israa'iil waabab ku hoyiyey markaan iyaga ka soo bixiyey dalkii Masar, waayo, aniga ayaa ah Rabbiga Ilaahiinna ah. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Muusena wuxuu reer binu Israa'iil u sheegay iidihii Rabbiga oo la amray.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
