            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "La hadal dadka reer binu Israa'iil, oo waxaad ku tidhaahdaa, Bishan toddobaad maalinteeda shan iyo tobnaad waa Iiddii Waababka oo waa in toddoba maalmood Rabbiga loo iidaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
