          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasa Rabbigu Muuse la hadlay oo wuxuu ku yidhi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habase yeeshee bishan toddobaad maalinteeda tobnaad waa maalinta kafaaraggudka. Oo waa inay idiin ahaataa shir quduus ah, oo waa inaad nafihiinna dhibtaan; oo waa inaad Rabbiga u bixisaan qurbaan dab lagu sameeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.27",
            "verseOrgIds": [
              "LEV.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isla maalintaas waa inaydaan waxba shuqul qaban cayn kasta ha ahaadee, waayo, taasu waa maalintii kafaaraggudka in kafaaraggud laydiinku sameeyo Rabbiga Ilaahiinna ah hortiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qof kasta ha ahaadee kii aan maalintaas la dhibin, dadkiisa waa in laga gooyaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qof kasta ha ahaadee kii maalintaas wax shuqul ah qabtaa cayn kastoo uu yahayba, qofkaas ayaan ka dhex baabbi'in doonaa dadkiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaydaan innaba shuqul qaban cayn kastoo uu yahayba, oo kaasu weligiinba waa idiin qaynuun tan iyo ab ka ab meel kastoo aad deggan tihiinba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dharaartaasu waxay idiin ahaan doontaa sabti nasasho weyn leh, oo waa inaad nafihiinna dhibtaan. Oo bisha maalinteeda sagaalaad waa inaad dhawrtaan sabtidiinna tan iyo fiid ilaa ka fiid.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
