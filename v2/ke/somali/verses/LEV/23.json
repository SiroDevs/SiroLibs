          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo markaad beeraha dhulkiinna goosataan waa inaydaan dhammaan wada goosan midhaha ku yaal beertiinna geesaheeda, oo weliba waa inaydaan wada urursan xaaxaabka beergoosadkiinna; waa inaad u daysaan miskiinka iyo shisheeyaha, waayo, aniga ayaa ah Rabbiga Ilaahiinna ah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
