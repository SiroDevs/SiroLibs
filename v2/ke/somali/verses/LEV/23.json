          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maalinta kowaad waa inay shir quduus ah ahaataa, oo waa inaydaan innaba shuqul adag qaban. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo intii toddoba maalmood ah waxaad Rabbiga u bixisaan qurbaan dab lagu sameeyo, oo maalinta siddeedaadna waa inay idiin ahaataa shir quduus ah, oo waa inaad Rabbiga u bixisaan qurbaan dab lagu sameeyo, oo waa inaydaan innaba shuqul adag qaban, waayo, dharaartaasu waa shir quduus ah.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
