    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Reer Binu Israa'iil Oo La Cadaadiyey",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba waa kuwan magacyadii wiilashii Israa'iil, oo Masar yimid; nin walba iyo reerkiisiiba waxay la yimaadeen Yacquub. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruubeen, Simecoon, Laawi iyo Yahuudah, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaakaar, Sebulun, iyo Benyaamiin, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.3",
            "verseOrgIds": [
              "EXO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daan iyo Naftaali, iyo Gaad iyo Aasheer. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dadkii ka soo go'ay xanjaadkii Yacquub oo dhammu waxay ahaayeen toddobaatan qof; Yuusufna Masar buu markii hore joogay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuusufna, iyo walaalihiis, iyo farcankaas oo dhanba way wada dhinteen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo reer binu Israa'iilna waa bateen, oo aad bay u kordheen, wayna tarmeen, oo aad iyo aad u xoogaysteen; dhulkiina way buuxiyeen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Masar waxaa ka kacay boqor cusub oo aan Yuusuf aqoonin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu wuxuu dadkiisii ku yidhi, Bal eega, dadkii reer binu Israa'iil waa inaga badan yihiin, wayna inaga xoog weyn yihiin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.9",
            "verseOrgIds": [
              "EXO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaalaya, aynu si caqli ah ula macaamiloonnee; waaba intaasoo ay tarmaan, oo ay markuu dagaal dhaco cadaawayaasheenna inoogu darmadaan, oo intay inala diriraan ay dalka ka baxaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba sidaas daraaddeed ayay niman madax uga dhigeen si ay culaabtooda ugu dhibaan, oo waxay Fircoon u dhiseen magaalooyin wax lagu kaydiyo oo la yidhaahdo Fitom iyo Racmeses. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse in kastoo ay aad u dhibeen, haddana aad bay u sii tarmeen, oo aad bay u faafeen. Oo reer binu Israa'iil aawadood ayay la murugaysnaayeen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo Masriyiintiina waxay reer binu Israa'iil ku qasbeen inay qaxar ku adeegaan, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxay naftoodii ku dhibeen hawl aad u adag, oo ahayd dhoobo la qaso, iyo leben, iyo hawl kasta oo beeraha laga qabto, oo hawl kastoo ay ku qasbeen inay qabtaanba way ku qaxri jireen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa boqorkii Masar wuxuu la hadlay umulisooyinkii Cibraaniyadaha ahaa, oo middood magaceeda Shifraah la odhan jiray, tan kale magaceedana Fuwah la odhan jiray, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo wuxuu ku yidhi, Markii aad umulinaysaan naagaha Cibraaniyadaha, oo aad aragtaan iyagoo gambarka umusha fadhiya, haddii uu wiil yahay, waa inaad dishaan, haddayse gabadh tahay, ha iska noolaato. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
              "EXO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse umulisooyinkii Ilaah bay ka cabsadeen, mana ay samayn wixii boqorkii Masar ku amray, ee way badbaadiyeen carruurtii labka ahayd. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.17",
            "verseOrgIds": [
              "EXO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa boqorkii Masar u yeedhay umulisooyinkii, oo wuxuu ku yidhi, Maxaad waxan u samayseen, oo aad u badbaadiseen carruurtii labka ahayd? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa umulisooyinkii waxay Fircoon ku yidhaahdeen, Maxaa yeelay, naagaha Cibraaniyaduhu la mid ma aha naagaha Masriga, oo waa ka dhaqso badan yihiin, oo intii aan umulisooyinku u iman bay umulaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Ilaah si wanaagsan buu u sameeyey umulisooyinkii, dadkiina waa tarmay, oo aad bay u xoogaysteen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.20",
            "verseOrgIds": [
              "EXO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay noqotay, in Ilaah umulisooyinkii reero u yeelay, maxaa yeelay, Ilaah bay ka cabsadeen. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Fircoon wuxuu dadkiisii ku amray, oo ku yidhi, Wiil kasta oo dhasha waa inaad webiga ku tuurtaan, laakiinse gabadh kasta waa inaad badbaadisaan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.22",
            "verseOrgIds": [
              "EXO.1.22"
            ]
          }
        }
      ]
    }
  ],
