    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Taambuuggii Allabariga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba waa inaad samaysaa taambuugga toban daah leh, oo waxaad ka samaysaa maro wanaagsan, iyo buluug, iyo guduud, iyo casaan, oo lagu daabacay keruubiim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo daah walba dhererkiisu waa inuu ahaadaa siddeed iyo labaatan dhudhun, daah walba ballaadhkiisuna waa inuu ahaadaa afar dhudhun; oo daahyada oo dhammuna waa inay isku qiyaas ahaadaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shan daah waa inay isku xidhnaadaan, oo shanta daah oo kalena waa inay isku wada xidhnaadaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo daahyada midkood waa inaad darafta uu ka laaban yahay u yeeshaa siddooyin buluug ah, oo sidaas oo kalena waa inaad ka yeeshaa daaha dibadda ugu xiga laabka labaad. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isku daah waa inaad konton siddo u yeeshaa; oo daaha ku yaal laabka labaad waa inaad daraftiisa u yeeshaa konton siddo; oo siddooyinkuna waa in midkoodba kan kale ka hor jeedaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaad konton qabsato oo dahab ah samaysaa, oo daahyadana waa inaad midba kan kale qabsatooyinka kula xidhaa, oo taambuuggana waa inuu mid dhan ahaadaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad daahyo ah dhogor riyaad samaysaa oo aad taambuugga ku deddaa; oo waa inaad iyaga ka dhigtaa koob iyo toban daah. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo daah kasta dhererkiisu waa inuu soddon dhudhun ahaadaa, daah kasta ballaadhkiisuna waa inuu afar dhudhun ahaadaa; oo koob iyo tobanka daah waa inay isku qiyaas ahaadaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad shan daah gooni ahaantooda isugu xidhaa, lix daahna gooni ahaantooda isugu xidh, oo daaha lixaad waa inaad ku labanlaabtaa teendhada fooddeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo daaha dibadda u xiga laabka daraftiisa waa inaad konton siddo u yeeshaa, oo daaha laabka labaad ugu korreeya daraftiisana waa inaad konton siddo u yeeshaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad samaysaa konton qabsato oo naxaas ah, oo waa inaad qabsatooyinkana sudhaa siddooyinka, oo teendhadana isku xidh kulligeed si ay mid dhan u noqoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo inta dusha ka lalmata oo ka hadhay daahyada teendhada, oo ah daaha badhkiisa, waa in laga lalmiyaa taambuugga dabadiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhudhunka oo dhinaca ah iyo dhudhunka oo dhinaca kale oo ah waxa ka hadha daahyada teendhada dhererkooda waa in laga lalmiyaa dhinacyada taambuugga, oo ah dhankan iyo dhankaasba, inay dedaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo teendhada waa inaad ded uga dhigtaa wanan hargahood oo la caseeyey, iyo ded ah adhidibadeed hargahood oo ka sarreeya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo looxyada taambuuggu ku taagan yahay waa inaad qori qudhac ah ka samaysaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looxiiba dhererkiisu waa inuu toban dhudhun ahaadaa, oo loox kasta ballaadhkiisu waa inuu dhudhun iyo badh ahaadaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo loox kasta waa inuu lahaadaa laba caarad, oo looxyadu waa inay dhinacyada isku hayaan, oo waa inaad sidaas u yeeshaa looxyada taambuugga oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhinaca koonfureed oo taambuugga looxyadiisa waa inaad labaatan loox ka dhigtaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad samaysaa afartan saldhig oo lacag ah oo ka hooseeya labaatanka loox; oo laba saldhigba waa inay ka hooseeyaan loox inay saldhig u ahaadaan labadiisa caarad, oo laba saldhigna waa inay ka hooseeyaan loox kale inay saldhig u ahaadaan labadiisa caarad. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taambuugga dhankiisa labaad oo woqooyi xiga waa inaad u yeeshaa labaatan loox, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo afartankoodii saldhig oo lacagta ahayd. Laba saldhigba waa inay loox ka hoosayso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meesha ugu dambaysa taambuugga oo ah dhankiisa galbeed waa inaad lix loox u yeeshaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo laba loox waa inaad u yeeshaa labada geesood oo taambuugga xaggiisa dambe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inay hoosta labanlaab ka noqdaan, oo sidaas oo kalena waa inay dhammaadaan ilaa siddada kowaad dusheeda, oo labaduba waa inay sidaas ahaadaan, oo labada gees baa iska leh. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inay ahaadaan siddeed loox, iyo saldhigyadoodii lacagta ahayd oo ah lix iyo toban saldhig, oo laba saldhigba waa inay loox ka hoosayso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad ulo gudban ka samaysa qori qudhac ah; looxyada taambuugga dhinac kaga jira shan ulood u yeel, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "looxyada dhinaca kale kaga jirana shan ulood oo kale u yeel, oo shan ulood oo kale u yeel taambuugga looxyadiisa kaga jira dhanka galbeed xaggiisa dambe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo uldhexaadda oo looxyada ku gudban waa inay gaadhaa gees ilaa gees. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo looxyada waa inaad dahab ku dahaadhaa, oo siddooyinkooda ah meelaha ulaha gudban ka gelayaan waxaad ka samaysaa dahab, oo ulahana waa inaad dahab ku dahaadhaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo taambuugga waa inaad u taagtaa sidii hannaankii aan buurta kugu tusay.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad ilxidh ka samaysaa buluug, iyo guduud, iyo casaan, iyo maro wanaagsan; hana lagu daabaco keruubiim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
