          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waa inaad iyaga u samaysaa sirwaallo maro wanaagsan ah oo gaadha dhexdooda ilaa bowdyahooda, oo ay ku qariyaan cawradooda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
