              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wiilasha Haaruunna waa inaad u samaysaa jubbado iyo dhex-xidho, iyo duubab, iyagu ha u ahaadeen ammaan iyo qurux. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaad dharkaas u lebbistaa walaalkaa Haaruun iyo wiilashiisa la joogaba; oo waa inaad iyaga subagtaa, oo daahirisaa oo quduus ka dhigtaa, inay iiga adeegaan hawsha wadaadnimada. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
