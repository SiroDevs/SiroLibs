          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddaad meel allabari dhagax iiga samayso, waa inaadan dhagax qoran ka dhisin, waayo, haddaad alaabtaada taabsiisid waad nijaasaysay. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
