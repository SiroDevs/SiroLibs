              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbahaa iyo hooyadaa maamuus, in cimrigaagu ku dheeraado dhulka Rabbiga Ilaahaaga ahu ku siiyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
