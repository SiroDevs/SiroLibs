          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaanad magaca Rabbiga Ilaahaaga ah si been ah ugu hadal qaadin, waayo, Rabbigu eedlaawe u haysan maayo kii magiciisa si been ah ugu hadal qaada.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
