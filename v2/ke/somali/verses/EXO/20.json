            "sid": "EXO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaanad samaysan sanam xardhan, ama wax u eg waxa samada sare jira, ama waxa dhulka hoose jira, ama waxa biyaha dhulka ka hooseeya ku jira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaanad iyaga u sujuudin, ama u adeegin, waayo, aniga oo ah Rabbiga Ilaahaaga ah waxaan ahay Ilaah masayr",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:5",
              "type": "text"
            },
            {
              "text": "Ilaah aan aqbalanayn in ilaah kale lala caabudo",
              "type": "text"
            }
          ]
        },
        {
          "text": " ah, oo xumaantii awowayaasha waxaan soo gaadhsiinayaa carruurtooda tan iyo farcanka saddexaad iyo kan afraad oo kuwa i neceb, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo waxaan u naxariistaa kumanyaal ah kuwa i jecel oo amarradayda xajiya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
    {
