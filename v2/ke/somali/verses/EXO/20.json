        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lix maalmood waa inaad hawshootaa, oo aad shuqulkaaga oo dhan qabsataa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "laakiinse maalinta toddobaad waa maalin sabti u ah Rabbiga Ilaahaaga ah, oo waa inaanad shuqul qaban, adiga, ama wiilkaaga, ama gabadhaada, ama addoonkaaga, ama addoontaada, ama xoolahaaga, ama qariibka irdahaaga ku jira; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "waayo, Rabbigu lix maalmood buu ku sameeyey samada, iyo dhulka, iyo badda, iyo waxa dhexdooda ku jira oo dhan, kolkaasuu nastay maalintii toddobaad, sidaas daraaddeed ayaa Rabbigu u barakeeyey maalintii sabtida ahayd oo quduus uga dhigay.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
