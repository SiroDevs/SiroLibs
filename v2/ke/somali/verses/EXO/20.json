          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama waa inaanad meeshayda allabariga sallaan ku fuulin, si aan cawradaadu uga muuqan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
