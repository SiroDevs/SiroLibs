          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaadan xaakinnada caayin, mid dadkaaga u taliyana ha habaarin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
