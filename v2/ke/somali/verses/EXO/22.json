            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waa inaadan ka raagin inaad wax ka bixiso midhahaaga badan iyo dheecaanka macsaraddaada. Oo curadyada dadkaagana waa inaad aniga i siisaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
