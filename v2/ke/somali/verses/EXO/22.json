          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo sidaas oo kalena waa inaad ka yeeshaa dibiyadaada iyo idahaaga; toddoba maalmood waa inuu hooyadiis la joogaa, maalinta siddeedaadna waa inaad ii bixisaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
