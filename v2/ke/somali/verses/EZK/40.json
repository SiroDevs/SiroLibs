            "sid": "EZK 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxay lahayd jaranjarro toddoba tallaabo ah oo loo fuulo, oo meelahooda dedanna way ku hor yiilleen, oo waxay lahayd geedo timireed oo mid dhinacan kaga yaal, midna dhinacaas kaga yaal, oo tiirarkeeda ku xardhan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
        {
