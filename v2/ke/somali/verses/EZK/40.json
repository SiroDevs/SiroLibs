          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "qolladaheeda, iyo tiirarkeeda, iyo meelaheeda dedan, oo waxay lahayd daaqado ku wareegsan, oo dhererku wuxuu ahaa konton dhudhun, oo ballaadhkuna wuxuu ahaa shan iyo labaatan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
