            "sid": "EZK 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyada iyo meelaheeda dedan oo ku wareegsanuba waxay lahaayeen daaqado, oo waxay u ekaayeen daaqadahaas kale; dhererku wuxuu ahaa konton dhudhun oo ballaadhkuna wuxuu ahaa shan iyo labaatan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
              "EZK.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
