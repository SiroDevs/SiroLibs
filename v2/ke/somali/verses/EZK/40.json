          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wuxuu igu yidhi, Qolladdan xagga koonfureed u sii jeedda waxaa iska leh wadaaddada daarta taladeeda haya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
              "EZK.40.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
