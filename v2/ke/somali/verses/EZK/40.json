          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu i geeyey xaggii koonfureed, oo bal eeg, waxaa ku tiil irid xagga koonfureed u sii jeedda, oo tiirarkeedii iyo meelaheedii dednaa wuxuu u qiyaasay sidii ay qiyaastaasu ahayd oo kale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.24",
            "verseOrgIds": [
              "EZK.40.24"
            ]
          }
        },
        {
