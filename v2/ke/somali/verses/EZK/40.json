          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meelaheeda dedanuna waxay u sii jeedeen barxadda dibadda xaggeeda, oo tiirarkana waxaa ku xardhanaa geedo timireed oo dhinacan iyo dhinacaasba kaga yaal, oo jaranjarrada loo fuulaana waxay lahayd siddeed tallaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.34",
            "verseOrgIds": [
              "EZK.40.34"
            ]
          }
        },
        {
          "name": "verse",
