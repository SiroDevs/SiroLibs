              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waa meelaha magaalada laga baxo, xagga dhanka woqooyi waa afar kun iyo shan boqol oo cawsduur. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalada irdaheedana waa in lagu magacaabaa qabiilooyinka reer binu Israa'iil magacyadooda. Saddexda irdood oo xagga woqooyi irid waa in reer Ruubeen lagu magacaabaa, iridna reer Yahuudah, iridna reer Laawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xagga dhanka barina waa afar kun iyo shan boqol oo cawsduur, oo saddexda irdood oo xagga barina irid waa in reer Yuusuf lagu magacaabaa, iridna reer Benyaamiin, iridna reer Daan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xagga dhanka koonfureedna qiyaastiisu waa afar kun iyo shan boqol oo cawsduur, oo saddexda irdood oo dhanka koonfureed irid waa in reer Simecoon lagu magacaabaa, iridna reer Isaakaar, iridna reer Sebulun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo xagga dhanka galbeedna waa afar kun iyo shan boqol oo cawsduur, oo saddex irdood leh, oo irid waa in reer Gaad lagu magacaabaa, iridna reer Aasheer, iridna reer Naftaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalada wareeggeeduna wuxuu ahaan doonaa siddeed iyo toban kun oo cawsduur, oo maalintaas intii laga bilaabona magaalada magaceedu wuxuu ahaan doonaa, Rabbigaa halkaas jooga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
