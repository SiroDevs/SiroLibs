      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddana kuwanu waa magacyadii qabiilooyinka. Xagga woqooyi tan iyo jidka Xetlon agtiisa iyo ilaa meesha Xamaad laga galo, iyo Xasar Eenaan iyo ilaa soohdinta Dimishaq xaggeeda woqooyi iyo ilaa xagga Xamaad, kuwaas oo ah dhinacyada bari iyo galbeed, waxaa jiri doonta qaybta reer Daan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Daan dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Aasheer. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Aasheer dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Naftaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Naftaali dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Manaseh. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Manaseh dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Efrayim. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Efrayim dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Ruubeen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Ruubeen dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Yahuudah.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo soohdinta reer Yahuudah dhankeeda bari iyo ilaa dhankeeda galbeedna waxaa ku xigi doonta meeshaad qurbaan ahaan u bixinaysaan oo ballaadhkeedu yahay shan iyo labaatan kun oo cawsduur, oo dhererkeeduna ula mid yahay sida qaybaha kale middood tan iyo dhankeeda bari iyo ilaa dhankeeda galbeed inta ka dhex leh, oo meesha quduuska ahuna waxay ku oolli doontaa meeshaas dhexdeeda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meesha aad Rabbiga qurbaan ahaan ugu bixinaysaan dhererkeedu waa inuu ahaadaa shan iyo labaatan kun oo cawsduur, oo ballaadhkeeduna toban kun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meeshaas ah qurbaanka quduuska ah waxaa iska lahaan doona wadaaddada. Dhankeeda woqooyi dhererkiisu waa inuu ahaadaa shan iyo labaatan kun, oo dhankeeda galbeed ballaadhkiisuna toban kun, oo dhankeeda bari ballaadhkiisuna toban kun, oo dhankeeda koonfureed dhererkiisuna shan iyo labaatan kun, oo meesha quduuska ah ee Rabbiguna waa inay dhexdeeda ku taallaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meeshaas waxaa iska lahaan doona wadaaddada quduuska laga dhigay ee reer Saadooq oo adeegiddaydii xajiyey oo aan u baadiyoobin sidii ay reer Laawi u baadiyoobeen markay reer Israa'iil baadiyoobeen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meeshaasu waxay iyaga u ahaan doontaa dal qurbaan ah oo ka mid ah dhulka qurbaan ahaan loo bixiyey, oo soohdinta reer Laawi ku xigta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo meel soohdinta wadaaddada ku xigtana waxay reer Laawi ku lahaan doonaan dhul dhererkiisu yahay shan iyo labaatan kun oo cawsduur, oo ballaadhkiisuna yahay toban kun, oo dhererka oo dhammu waa inuu ahaadaa shan iyo labaatan kun, oo ballaadhkuna waa inuu ahaadaa toban kun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo iyagu waa inayan innaba iibsan, ama ayan beddelan, ama ayan dalka midhihiisa hore innaba shisheeye u gudbin, waayo, dhulkaasu Rabbiguu quduus u yahay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo shanta kun oo ka hadhay ballaadhka ah shan iyo labaatanka kun waxay ahaan doontaa meel dadka ka dhexaysa oo ah magaalada la dego iyo agagaarkeeda, oo magaaladuna waa inay ku dhex taallaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kuwanuna waa inay qiyaasteeda ahaadaan: dhanka woqooyi waa inuu ahaadaa afar kun iyo shan boqol, dhanka koonfureedna afar kun iyo shan boqol, dhanka barina afar kun iyo shan boqol, dhanka galbeedna afar kun iyo shan boqol. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo magaalada agagaarkeeduna xagga woqooyi waa inuu ahaadaa laba boqol iyo konton, xagga koonfureedna laba boqol iyo konton, xagga barina laba boqol iyo konton, xagga galbeedna laba boqol iyo konton. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhererka ka hadhay oo ku xiga dalka qurbaanka ee quduuska ah dhankiisa bari waa inuu ahaadaa toban kun, oo dhankiisa galbeedna waa inuu ahaadaa toban kun, oo waa inuu ku xigaa dalka qurbaanka ee quduuska ah; oo waxa dhulkaas ka baxaana cunto bay u ahaan doonaan kuwa magaalada ku hawshooda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhulkaas waxaa beeri doona kuwa magaalada ku hawshooda ee qabiilooyinka reer binu Israa'iil ka soo baxa oo dhan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhulka qurbaanka ah oo dhammu waa inuu ahaadaa shan iyo labaatan kun oo dherer ah iyo shan iyo labaatan kun oo ballaadh ah. Dalka qurbaanka ee quduuska ah oo aad bixinaysaan waa inuu ahaadaa afar gees iyadoo hantida magaaladu ku taal.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo inta hadhana waxaa iska lahaan doona amiirka, dhinacan iyo dhinacaas oo dalka qurbaanka ee quduuska ah, iyo meesha ay magaaladu ku taalloba, oo ka soo hor jeedda shan iyo labaatanka kun oo dalka qurbaanka ah oo xagga soohdinta bari, iyo dhanka galbeed oo ka soo hor jeeda shan iyo labaatanka kun oo xagga soohdinta galbeed, oo ku xiga qaybaha. Oo intaas waxaa lahaan doona amiirka, oo dalka qurbaanka ee quduuska ah iyo meesha quduuska ah ee daartana waa inay ku dhex yaallaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo weliba xagga hantida reer Laawi iyo xagga hantida magaalada oo ku dhex yaal meesha amiirka oo u dhaxaysa soohdinta reer Yahuudah iyo soohdinta reer Benyaamiinba waxaa iska lahaan doona amiirka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qabiilooyinka kale oo hadhana tan iyo dhanka bari iyo ilaa dhanka galbeed reer Benyaamiin waa inay qayb ka helaan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Benyaamiin dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Simecoon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Simecoon dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Isaakaar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Isaakaar dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Sebulun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa soohdinta reer Sebulun dhankeeda bari iyo ilaa dhankeeda galbeed ku xigi doonta qaybta reer Gaad. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
