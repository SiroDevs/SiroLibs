        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu macbudkii i geeyey, oo tiirarkuu qiyaasay, oo dhinacan ballaadhku wuxuu ahaa lix dhudhun, oo dhinaca kale ballaadhkuna wuxuu ahaa lix dhudhun, oo kaasuna wuxuu ahaa taambuugga ballaadhkiisii. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo kadinka ballaadhkiisuna wuxuu ahaa toban dhudhun, oo kadinka dhinacyadiisuna waxay ahaayeen shan dhudhun oo dhinaca iyo shan dhudhun oo dhinaca kale ah, oo dhererkiisuu qiyaasay oo wuxuu ahaa afartan dhudhun oo ballaadhkiisuna wuxuu ahaa labaatan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana guduhuu galay oo wuxuu qiyaasay tiir kasta oo kadinka oo wuxuu ahaa laba dhudhun, oo kadinkuna wuxuu ahaa lix dhudhun, oo kadinka ballaadhkiisuna wuxuu ahaa toddoba dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu qiyaasay dhererkiisii oo ahaa labaatan dhudhun, iyo ballaadhkiisii oo ahaa labaatan dhudhun oo macbudka hortiisa ku yiil; oo wuxuu igu yidhi, Tanu waa meesha ugu wada quduusan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu qiyaasay daarta derbigeedii oo ahaa lix dhudhun, oo qollad kasta ballaadhkeedu wuxuu ahaa afar dhudhun oo daarta dhinac kasta kaga wareegsan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qolladahana waxay ahaayeen saddex dabaqadood oo midba mid ka sarrayso, oo dabaqad kastaaba waxay ahayd soddon qolladood, oo waxay ku yiilleen derbigii qolladaha ee daarta ku wareegsanaa, si ay u qabsadaan aawadeed, laakiinse iyagu daarta derbigeeda kuma ay oollin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qolladuhuna way sii ballaadheen inay daarta kor ugu sii wareegayeen, waayo, wareegga daarta kor buu u sii kacay isagoo daarta ku wareegsan, sidaas daraaddeed daarta ballaadhkeedu xagga saruu u sii socday, oo waxaa qowladda ugu hoosaysa iyo tan ugu sarraysa lagaga fuulay qowladda dhexe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddana waxaan arkay inay daartu ku dhisnayd meel sallax ah oo sare oo ku wareegsanayd, oo aasaaska qolladaha dhererkiisu wuxuu ahaa cawsduur kaamil ah oo ah lix dhudhun oo dhaadheer. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qolladaha derbigooda dibadda ah qaradiisuna waxay ahayd shan dhudhun, oo intii hadhayna waxay ahayd meeshii qolladaha ee daarta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qolladaha dhexdoodana waxaa ku tiil meel ballaadhkeedu labaatan dhudhun yahay oo daarta dhinac kasta kaga wareegsan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo qolladaha albaabbadooduna waxay u sii jeedeen meesha hadhay xaggeeda, albaab woqooyi buu u sii jeeday oo mid kalena koonfur buu u sii jeeday, oo meesha hadhay ballaadhkeeduna wuxuu ahaa shan dhudhun oo hareeraheeda ku wada wareegsan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhismihii meesha goonida ka horreeyey oo galbeedka ku tiil ballaadhkiisu wuxuu ahaa toddobaatan dhudhun, oo dhismaha derbigiisa ku wareegsan qaradiisuna waxay ahayd shan dhudhun, oo dhererkiisuna wuxuu ahaa sagaashan dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo daartii buu qiyaasay, oo dhererkeedii wuxuu ahaa boqol dhudhun, oo dhismihii meesha goonida ahayd iyo derbiyadiisiina dhererkoodii waxay ahaayeen boqol dhudhun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo ballaadhka daarta horteeda iyo meeshii goonida ahayd ee xagga bari u jeedday waxay ahaayeen boqol dhudhun.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo haddana wuxuu qiyaasay dhererkii dhismihii ka soo hor jeeday meeshii goonida ahayd oo xagga dambe jirtay, iyo balbalooyinkeedii dhinacan iyo dhinacaasba ka xigay, oo waxay ahaayeen boqol dhudhun, oo waxaa weheliyey macbudkii hoose iyo balbalooyinkii barxadda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo marinnadii albaabbada, iyo daaqadihii cidhiidhsanaa, iyo balbalooyinkii ku wareegsanaa saddexdooda dabaqadoodba, oo marinka albaabka ka soo hor jeedayba waxaa lagu dahaadhay alwaax ku wareegsan tan iyo dhulka iyo ilaa daaqadaha inta ka dhex leh, (oo daaqaduhuna way dednaayeen), ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo albaabka dushiisa, iyo xataa daarta gudaheeda iyo dibaddeeda, iyo derbiga ku wareegsan gudaha iyo dibaddaba, qiyaas buu ku qiyaasay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa lagu sharraxay keruubiim iyo geedo timireed, oo geed timireedba wuxuu ku dhex yiil laba keruub, oo keruub kastaaba wuxuu lahaa laba weji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo mid nin wejigiis u egu wuxuu u sii jeeday geedka timireed ee dhinacan ku yaal xaggiisa, oo mid aaran libaax wejigiis u eguna wuxuu u sii jeeday geedka timireed ee dhinaca kale ku yaal xaggiisa, oo daarta hareereheeda oo dhanna saasaa lagu wada sameeyey. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo dhulka iyo albaabka korkiisa inta ka dhex leh waxaa lagu sameeyey keruubiim iyo geedo timireed, oo derbiga macbudkana sidaas oo kale waa loo sharraxay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo macbudka tiirarkiisuba waxay ahaayeen afar gees, oo meesha quduuska ah horteeduna way u ekayd. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.21",
            "verseOrgIds": [
              "EZK.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meesha allabariga alwaax bay ahayd, oo sarajooggeedu wuxuu ahaa saddex dhudhun, dhererkeeduna laba dhudhun, oo geeseheeda, iyo dhererkeeda, iyo dhinacyadeeduba waxay wada ahaayeen alwaax. Markaasuu igu yidhi, Kanu waa miiska Rabbiga hortiisa yaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo macbudka iyo meesha quduuska ahu waxay lahaayeen laba albaab. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo labada albaab midkiiba wuxuu lahaa laba qaybood, kuwaasoo ah laba qaybood oo isku laalaaban. Albaab wuxuu lahaa laba qaybood, oo albaabka kalena wuxuu lahaa laba qaybood. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo waxaa albaabbada macbudka lagu sharraxay keruubiim iyo geedo timireed, oo u ekaa kuwii derbiyada lagu sharraxay, oo balbalada dibadda horteedana waxaa ku yiil looxaan qaro weyn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo balbalada dhinacyadeeda waxaa ku yiil daaqado cidhiidhsan iyo geedo timireed oo dhinacan iyo dhinacaasba ku yaal oo daarta qolladeheeduna saasoo kalay ahaayeen, iyo looxaantii qarada weynayd.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
              "EZK.41.26"
            ]
          }
        }
      ]
    }
  ],
