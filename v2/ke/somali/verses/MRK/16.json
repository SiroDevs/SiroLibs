{
  "id": "MRK.16",
  "number": "16",
  "bookId": "MRK",
  "reference": "Markos 16",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
