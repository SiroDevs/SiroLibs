          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goortaasuu dadkii badnaa u yeedhay iyo xertiisiiba oo wuxuu ku yidhi, Mid uun hadduu doonayo inuu iga daba yimaado, ha dayriyo doonistiisa, iskutallaabtiisana ha soo qaato oo ha i soo raaco. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
