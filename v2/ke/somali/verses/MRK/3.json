              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa waxaa yimid walaalihiis iyo hooyadiis, oo dibadday istaageen, waxayna u direen cid ugu yeedha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
