          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolkaasuu isha mariyey kuwii agtiisa fadhiyey oo ku yidhi, Waa kuwan hooyaday iyo walaalahay! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
