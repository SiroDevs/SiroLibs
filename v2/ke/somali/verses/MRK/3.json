          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dad badan baa agtiisa fadhiyey oo waxay ku yidhaahdeen, Bal eeg, hooyadaa iyo walaalahaa dibadday joogaan oo waa ku doonayaan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
