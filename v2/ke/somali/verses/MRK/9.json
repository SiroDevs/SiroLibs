            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waayo, mid walba dab baa lagu cusbayn doonaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.49",
            "verseOrgIds": [
              "MRK.9.49"
            ]
          }
        },
