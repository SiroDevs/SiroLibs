          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cusbadu waa wanaagsan tahay, laakiin cusbadu hadday dhadhan beesho, maxaad wax ku cusbaynaysaan? Cusbo isku lahaada, nabadna isu ahaada.",
          "type": "text",
