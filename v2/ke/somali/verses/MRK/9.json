              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
