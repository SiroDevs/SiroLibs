              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Annagoo la shaqaynayna Ilaah waxaannu idinka baryaynaa inaydnaan micnela'aan u qaadan nimcadii Ilaah, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
