{
  "id": "2CO.12",
  "number": "12",
  "bookId": "2CO",
  "reference": "2 Korintos 12",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
