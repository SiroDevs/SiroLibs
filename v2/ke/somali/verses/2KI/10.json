          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasaa Yeehuu dhintay oo la seexday awowayaashiis, oo waxaa lagu aasay Samaariya. Oo meeshiisiina waxaa boqor ka noqday wiilkiisii Yehoo'aaxaas. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.35",
            "verseOrgIds": [
              "2KI.10.35"
            ]
          }
        },
        {
          "name": "verse",
