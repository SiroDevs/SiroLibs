          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo wakhtigii Yeehuu dalka Israa'iil Samaariya boqorka ugu ahaa wuxuu ahaa siddeed iyo labaatan sannadood.",
          "type": "text",
