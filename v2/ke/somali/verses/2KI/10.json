          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Yeehuu falimihiisii kale iyo wixii uu sameeyey oo dhan, iyo xooggiisii oo dhammuba sow kuma qorna kitaabkii taariikhda boqorradii dalka Israa'iil? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
