      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Warqaddii Kiniisadda Tu'ateyra Loo Diray",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
