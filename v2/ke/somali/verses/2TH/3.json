      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haddaba Rabbiga nabadda qudhiisu mar walba si kasta nabad ha idiin siiyo. Rabbigu kulligiin ha idinla jiro.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anigoo Bawlos ah ayaan salaantan gacantayda ku qorayaa; waana u calaamo warqad kasta oo tayda ah. Sidaasaan u qoraa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimcada Rabbigeenna Ciise Masiix ha idinla jirto kulligiin.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.18",
            "verseOrgIds": [
              "2TH.3.18"
            ]
          }
        }
      ]
    }
  ],
