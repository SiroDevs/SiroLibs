{
  "id": "JHN.4",
  "number": "4",
  "bookId": "JHN",
  "reference": "Yooxanaa 4",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
