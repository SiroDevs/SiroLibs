{
  "id": "JHN.20",
  "number": "20",
  "bookId": "JHN",
  "reference": "Yooxanaa 20",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
