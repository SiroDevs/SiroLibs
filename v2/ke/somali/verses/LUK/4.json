          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Markaasuu sunagoggi ka soo kacay, oo wuxuu galay gurigii Simoon. Simoon soddohdiisna qandho weyn ayay qabtay, markaasay isaga u baryeen aawadeed, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "oo intuu isa soo dul taagay ayuu qandhadii canaantay, wayna daysay. Kolkiiba way kacday oo u adeegtay iyagii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
