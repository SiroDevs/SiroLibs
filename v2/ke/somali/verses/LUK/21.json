          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maalin walba ayuu macbudka wax ku bari jiray, habeen walbana dibadda ayuu u bixi jiray, oo wuxuu baryi jiray buurta la odhan jiray Buur Saytuun. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dadka oo dhammuna aroortii ayay macbudka ugu iman jireen inay dhegaystaan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
