      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciise Waa u Ooyay Yeruusaalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
