          "items": [
            {
              "text": "80",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiilkuna waa koray oo ruuxuu ka xoogoobay, wuxuuna joogay cidlada ilaa maalintii uu Israa'iil istusi lahaa.",
          "type": "text",
          "attrs": {
