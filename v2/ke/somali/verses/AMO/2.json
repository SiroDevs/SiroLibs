            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbigu wuxuu leeyahay, Saddex iyo weliba afar xadgudub oo ay dadka Yahuudah sameeyeen aawadood ayaanan ciqaabtooda uga noqonaynin, maxaa yeelay, iyagu sharcigii Rabbiga way diideen, oo qaynuunnadiisiina ma ay xajin, oo beentoodii baa iyaga qaladday, taasoo ay awowayaashoodba daba socon jireen. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse dab baan ku soo dayn doonaa dalka Yahuudah, oo wuxuu wada laasan doonaa daaraha waaweyn oo Yeruusaalem.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xukunka Israa'iil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
