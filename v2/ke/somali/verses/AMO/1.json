          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabbigu wuxuu leeyahay, Boqorkooda maxaabiis ahaan baa loo kaxaysan doonaa isaga iyo amiirradiisaba.",
          "type": "text",
          "attrs": {
