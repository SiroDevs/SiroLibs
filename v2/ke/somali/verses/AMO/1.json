          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oo isagu wuxuu yidhi, Rabbigu Buur Siyoon buu ka qaylin doonaa, oo codkiisuu Yeruusaalem kaga hadli doonaa, kolkaasay daaqsiimaha adhijirradu barooran doonaan, oo Buur Karmel dhaladeeduna way engegi doontaa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xukunka Derisyada Israa'iil",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
