          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakiinse dab baan ku soo dayn doonaa derbiga Rabbaah, oo wuxuu wada laasan doonaa daaraheeda waaweyn, oo maalinta dagaalka waa la qaylin doonaa, oo maalinta dabaysha cirwareentana duufaan baa ku dhici doona. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.14",
            "verseOrgIds": [
              "AMO.1.14"
            ]
          }
        },
        {
          "name": "verse",
