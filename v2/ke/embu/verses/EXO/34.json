              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûtikaagooce Ngai wîngî, nîûndû Ngai-Mûnene ûrîa rîîtwa rîake arî ‘Wîru’, nî Ngai ûrî wîru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikaarûthe kîrîkanîro na andû a vûrûri ûcio, nîûndû vîndî îrîa makûgooca ngai ciao na makîirutagîra magongoona nwa mamwîte mûthiî mûkagwatanîre nao na mwavota kûgwa mageriorî wa kûrîa irio irîa itegeretwe ngai ciao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anake enyu mangîkaavikia erîtu a andû acio ageni, erîtu acio makîgooca ngai ciao nîmagaatûma anake enyu matuîka tî evokeku na nîmakaagooca ngai cia erîtu acio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
