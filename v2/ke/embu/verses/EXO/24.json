                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.19+HEB.9.20"
              },
              "items": [
                {
                  "text": "Ahib 9.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.29"
              },
              "items": [
                {
                  "text": "10.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nîwocire nthakame îrîa yarî mbakûrirî na akîmîminjîria andû na akiuga atîrî, “Îno nîyo nthakame ya kîrîkanîro kîrîa Ngai-Mûnene aarîkanîre namue kîgiî maûndû mama monthe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Musa, Aroni, Nadabu, Abihu, na atongoria mîrongo mûgwanja a Isiraeli nîmaaunûkirie kîrîmarî ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nîmoonire Ngai wa Isiraeli. Varîa aakinyîte vekariî ta vaarûthîtwe na mathiga ma goro ma rangi wa vururu ta wa matu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atongoria acio a Isiraeli nîmoonire Ngai na ndaameka ûndû mûcûku. Nîmaarîre na makînyua marî vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa arî Kîrîmarî gîa Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa atîrî, “Unûkia ûke kîrîmarî varî nie na weterere vo. Nanie ngaakûnengera ivengere igîrî cia mathiga ciandîkîtwe mawatho na maathani ma gûtaara andû.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Musa na Joshua ûrîa wamûtethagîrîria nîmeevarîrie, na Musa akiunûkia",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24.13",
              "type": "text"
            },
            {
              "text": "Akiunûkia:",
              "type": "text"
            },
            {
              "text": "Mandîko ma tene ma Kîngiriki maugaga “makiunûkia”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kîrîmarî kîu kîtheru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwerire atongoria a Isiraeli atîrî, “Etererani ava nginya rîrîa tûgaacoka kûrî mue rîngî. Aroni na Huri mûrî nao. Kûngîgîa na ngarari gatagatîrî kenyu thiîni kûrî o.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Musa nîwaunûkirie kîrîmarî gîa Sinai na îtu rîgîgîkunîkîra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo riiri wa Ngai-Mûnene nîwanyûrûrûkire ûgîûka kîrîmarî kîu. Narîo îtu nîrîekarire rîkunîkîrîte kîrîma mîthenya îtandatû. Na mûthenya wa mûgwanja Ngai-Mûnene arî îtuurî rîu nîwetire Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo riiri wa Ngai-Mûnene wonagwa nî andû a Isiraeli wîkariî ta mwaki wakanîte ûrî gacûmbîrî ga kîrîma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.9"
              },
              "items": [
                {
                  "text": "Gûco 9.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nîwaunûkirie kîrîmarî na agîtonya ndaarî ya îtu, na agîkara kuo mîthenya mîrongo îna ûtukû na mûthenya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
      ]
    }
