                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Curia gîtambaa kîu mbatharî irîa irî îgemarî îgûrû, na vuva wa gîtambaa wige îthandûkû rîa kîrîkanîro rîrîa rîrî na ivengere igîrî cia mathiga. Gîtambaa gîkaagaania îgema maita maîrî: vandû varîa vatheru na vandû varîa vatheru Mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûkaaigîrîra gîkunîko îgûrû rîa îthandûkû rîa kîrîkanîro rîrî vandû varîa vatheru Mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nja ya vandû varîa vatheru Mûno, ûkaaiga metha vakuvî na rûthingo rwa mwena wa rûgûrû rwa îgema. Naguo mwena wa îveti wa îgema wige vandû va kwigîrîrwa taa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
