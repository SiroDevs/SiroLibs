          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkaavaka mbaû cia kûrûngamia îgema thaavu, na ûrûthe icûvî cia thaavu cia kûnyitîrîra mîkîgo, na ûcoke ûvake mîkîgo îo thaavu wanayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
