                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Josh 24.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nîwakuire mavîndî ma Josefu, nîûndû Josefu nîwevîtithîtie andû a Isiraeli akîmeera atîrî, “Rîrîa Ngai akaamûvonokia, mue nwanginya mûgaakua mavîndî makwa kuuma gûkû.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû a Isiraeli nîmaaumire Sukothu na makîthiî makîamba magema mao Ethamu rûtererî rwa werû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavinda ma mûthenya Ngai-Mûnene aathiîcaga mbere yao amatongoreretie arî gîtugîrî Kîam îtu. Útukû aamatongoragia arî gîtugîrî Kîam mwaki wa kûmonia ûtheri nîguo mathiîcage ûtukû na mûthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
              "EXO.13.21"
            ]
          }
