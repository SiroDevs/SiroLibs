            "number": "30",
            "style": "v",
            "sid": "EXO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Musa nîwaumire kwa mûthamaki, akîthiî na akîvoya Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene nîwekire wata ûrîa Musa aamûvoire. Nacio ngi nîciaumire kûrî mûthamaki, kûrî anene ake na kûrî andû ake. Gûtirî ngi wana îmwe yatigarire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûthamaki wa Misiri nîwaûmirie ngoro. Îvinda rîu wa narîo nîwaregire gwîtîkîria andû a Isiraeli mathiî.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.32"
            ]
          }
        }
