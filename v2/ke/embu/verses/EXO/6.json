            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Ngai-Mûnene nîwerire Musa atîrî, “Rîu nîûkwona ûrîa ngwîka mûthamaki wa Misiri. Nîûndû wa ûvoti wakwa nîakûrekereria andû akwa mathiî. Nîngûtûma amarutûrûre vûrûrirî wake na vinya.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngai nîwetire Musa",
          "type": "text"
        }
      ]
    },
