        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni na Musa nîo Ngai-Mûnene eerire atîrî, “Tongoriani andû a Isiraeli maume vûrûri wa Misiri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
