              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mvecaga îrikithathi rîaku rîa anake. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
