          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanie nîngaarakara na nîmûragithîrie mbaararî. Nao aka enyu nîmagaatuîka a ndigwa nacio ciana cienyu itigwe itarî na methe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
