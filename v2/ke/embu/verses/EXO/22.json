              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndû angîvoya nyamû kuuma kûrî mûndû ûrîa wîngî na îtivue kana îkue mwene yo atarî vo, mûndû ûcio ûramîvoete nwanginya amîrîve. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî îngîkua mwene yo arî vo, mûndû ûcio ûramîvoete ndangîrwa amîrîve. Nwatî ethîrwa nîkwa îrarî ngombore, mbeca irîa iramîkomborete nîcio igaatuîka îrîvi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawatho megiî ndini na mîtûûrîre mîaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
