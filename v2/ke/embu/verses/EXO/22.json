              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndutagîra matega maku ma ngano, ndivei, na maguta ma ndamaiyû vîndî ya cio yakinya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
