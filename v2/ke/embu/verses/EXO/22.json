          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîûndû mûngîmavîtîria nao mandîrîre, nama nîngegua kîrîro Kîamo makîndîrîra nîmatethie, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
