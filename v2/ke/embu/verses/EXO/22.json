                {
                  "text": "Gûco 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûngîoca nguo ya mûndû atî nîguo akaamîkûûra, nwanginya ûmûcokerie riûa rîtarî rîthûu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
