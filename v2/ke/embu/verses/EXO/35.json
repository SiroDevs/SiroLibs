              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwerire andû onthe a Isiraeli magomane vamwe na akîmera atîrî, “Mama nîmo maûndû marîa Ngai-Mûnene amwathîte mwîkage. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
