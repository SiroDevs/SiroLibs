            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Gûco 25.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Ngai-Mûnene nîwacokire akîra Musa atîrî, “Andîka ûvoro wîgiî ûvootani ûyû nîguo ûtuîke wa kûririkanagwa. Na wîre Joshua atî nîngûthiria Amaleki viû na ndûme mariganîre gûkû nthî.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwatumire metha ya kîgongoona na akîmîtuîra rîîtwa “Ngai-Mûnene nîke vendera yakwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nîwaugire atîrî, “Ûkîrîria na îgûrû vendera ya Ngai-Mûnene! Ke nîatûûra arûaga na Amaleki tene na tene!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
