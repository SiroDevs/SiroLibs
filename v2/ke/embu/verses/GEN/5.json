              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Methusela aakinyirie ûkûrû wa mîaka îgana rîa mîrongo înana na mûgwanja (187), nîwaciarire Lameki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.25",
            "verseOrgIds": [
              "GEN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
