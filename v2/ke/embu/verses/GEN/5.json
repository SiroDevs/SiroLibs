          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire akîgîa ciana ciîngî na agîkua arî na ûkûrû wa mîaka magana kenda ma mîrongo îtandatû na kenda (969).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
