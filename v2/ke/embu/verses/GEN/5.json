          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Adamu aakinyirie ûkûrû wa mîaka îgana rîa mîrongo îthatû (130), nîwaciarire kavîcî gekariî take viû na agîgatuîra rîîtwa Sethi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa gûciara Sethi, Adamu aatûûrire îvinda rîa mîaka magana manana (800) na akîgîa na ciana ciîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu aatûûrire îvinda rîa mîaka magana kenda ma mîrongo îthatû (930) agîcoka agîkua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
