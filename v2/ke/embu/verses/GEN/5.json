              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Sethi aarî na ûkûrû wa mîaka îgana rîmwe rîa îtano (105), nîwaciarire kavîcî getagwa Enoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sethi aatûûrire mîaka magana manana ma mûgwanja (807) arîkia gûciara Enoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sethi nîwacokire akîgîa na ciana ciîngî na agîkua arî na ûkûrû wa mîaka magana kenda ma îkûmi na îîrî (912).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
