              ]
            }
          ]
        },
        {
          "text": " Aamaûmbire mûndûmûrûme na mûndûmûka, agîcoka akîmarathima akîmeta “Andû”.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
