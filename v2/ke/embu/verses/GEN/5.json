          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Methusela aciara Lameki nîwatûûrire îvinda rîa mîaka magana mûgwanja ma mîrongo înana na îîrî (782). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.26",
            "verseOrgIds": [
              "GEN.5.26"
            ]
          }
        },
        {
