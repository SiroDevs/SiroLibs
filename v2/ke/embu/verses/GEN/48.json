              "GEN.48.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.21"
              },
              "items": [
                {
                  "text": "Ahib 11.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwoguo mûthenya ûcio Jakovu nîwamarathimire na akiuga atîrî, “Aisiraeli makarathimanaga na marîîtwa menyu makiugaga atîrî, ‘Ngai arotûma wîkara ta Efiraimu na Manase.’ ” Ûguo nîguo Jakovu aaigire Efiraimu mbere ya Manase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakovu nîwerire Josefu atîrî, “Tathikîrîria, nîrî vakuvî gûkua, nwatî Ngai akethagîrwa arî vamwe nawe na nîakaamûcokia vûrûrirî wa methe menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.21",
            "verseOrgIds": [
              "GEN.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nîngûkûva gîcunjî gîa Shekemu îthenya rîa kûva aa mûrwanyûkwe. Vûrûri ûyû nî ûrîa naacunire Aamori nîrî na rûviû rwa njûra na ûta.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.22",
            "verseOrgIds": [
              "GEN.48.22"
            ]
          }
        }
      ]
