              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka aatûûrire mîaka îgana rîmwe rîa mîrongo înana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
