          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Shela aarî na mîaka mîrongo îthatû (30), nîwagîre na mûvîcî wetagwa Eberi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.14",
            "verseOrgIds": [
              "GEN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa gûciara Eberi, Shela nîwekarire mîaka magana mana ma îthatû, (403) na kavindarî wa kau nîwagîre na ciana ciîngî cia anake na erîtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.15",
            "verseOrgIds": [
              "GEN.11.15"
            ]
          }
