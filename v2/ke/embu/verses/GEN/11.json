              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahoru nîwacokire agîkara mîaka îgana rîa îkûmi na kenda (119) na kavindarî wa kau nîwagîre na ciana ciîngî cia anake na erîtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
              "GEN.11.25"
            ]
          }
        }
