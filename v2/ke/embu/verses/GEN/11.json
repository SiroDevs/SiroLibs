        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera nîwocire mûvîcî Aburamu na mûcûkûrûwe Loti ûrîa warî mûvîcî wa Harani. Nîwocire Sarai mûka wa mûvîcî Aburamu, makiuma kûu Uri gwa Akalidei, nîguo mathiî vûrûrirî wa Kanaani. Nwatî rîrîa maakinyire vûrûrirî wa Harani, nîmaatûûrire kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera aakuîrîre vûrûrirî wa Harani arî na ûkûrû wa mîaka magana maîrî ma îtano (205).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
