              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Eberi aarî wa mîaka mîrongo îthatû na îna (34), nîwagîre na mûvîcî wetagwa Pelegi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.16",
            "verseOrgIds": [
