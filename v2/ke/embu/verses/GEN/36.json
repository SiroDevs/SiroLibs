            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaû nîke warî îthe wa tene wa mîvîrîga ya andû a Edomu. Wa kûrîa mûvîrîga watûûraga, gwetanagua na rîîtwa rîaguo. Nayo yarî: Timuna, Aliva, Jafethi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 36:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibama, Ela, Pinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
