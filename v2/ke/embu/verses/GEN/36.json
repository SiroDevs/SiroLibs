              "type": "text"
            }
          ]
        },
        {
          "text": "Ciana cia Ana ciarî: Dishoni na mwîrîtu wetagwa Oholibama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
