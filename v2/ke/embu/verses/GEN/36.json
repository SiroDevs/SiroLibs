          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Ezeri na Dishani. Wa mûndû aarî mûnene wa mûvîrîga wake vûrûrirî wa Seiru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
