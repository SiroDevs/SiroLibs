          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao avîcî a Dishoni maarî: Hemudani, Eshibani, Ithirani na Cherani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
