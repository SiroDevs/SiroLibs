              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nîo maarî avîcî a Hori: Lotani, Shobali, Zibeoni, Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
