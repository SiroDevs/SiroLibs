          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwamûcokerie atîrî, “Ethîrwa kûrî na andû mîrongo îna athingu ndikaarîcûkangia.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
