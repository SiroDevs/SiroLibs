            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nîwaûririe rîngî atîrî, “Narîo ethîrwa kûrî na andû mîrongo îna tu athingu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
