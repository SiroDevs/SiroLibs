          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Iburahimu nîwaririe rîngî akiuga atîrî, “Ngai-Mûnene njovera nîûndû wa kûmîrîria kûthiî na mbere na gûkwarîria. Nie nîrî mûndû tu na ndiagîrîrwe nî gûkwîra wanarî ûndû. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî ethîrwa kûrî na andû mîrongo îna na atano athingu, nwa ûcûkangie îtûûra rîonthe nîûndû wa andû acio engî atano matarî vo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
