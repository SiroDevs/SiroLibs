          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokirie atîrî, “Ethîrwa nîngoona andû mîrongo îtano athingu îtûûrarî rîa Sodomu, nîngaavonokia îtûûra rîonthe nîûndû wao.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
