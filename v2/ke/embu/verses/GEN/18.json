          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene nîwaugire atîrî, “Ethîrwa nwa mone andû mîrongo îthatû athingu, ndikaarîcûkangia.”",
          "type": "text",
          "attrs": {
