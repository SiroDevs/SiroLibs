              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûraika nîwacokerie Loti atîrî, “Îka guo nînetîkîra. Tînjûkangia gatûûra kau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îka narua! Wîthare ûthiî kuo; nîûndû gûtirî wa naarî ûndû nîngîka ûtakinyîte kuo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
