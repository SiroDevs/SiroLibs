              "GEN.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Aburamu nîwathaamirie îgema rîake na akîthiî gûtûûra Heburoni vakuvî na mîtî îrîa mîamûre ya Mamure. Aburamu nîwatumîre Ngai-Mûnene metha ya kîgongoona vo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
