          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigetigîre nthû cienyu. Îthagîrwani mûrî na ûmîrîru vingo cionthe. Mweka ûguo nîmûkwonia nthû cienyu atî itikaavootana, nwatî nîmûkaavootana nîûndû Ngai nîke ûtûmaga mûvootane. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
