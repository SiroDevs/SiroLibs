          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
