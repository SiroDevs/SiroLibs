    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngai-Mûnene nîweguire kîeva nîûndû wa andû ake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
