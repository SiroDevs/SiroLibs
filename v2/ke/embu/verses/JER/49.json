              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Augire atîrî, “Taroria, nîngunanga mota ma andû a vûrûri wa Elamu arîa maicî kûratha na mîguî, acio matûmîte vûrûri ûcio ûgîe na vinya mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngarekereria rûkûngi kuuma mîena îna ya nthî rûthiî vûrûrirî wa Elamu, na nyaganie andû a kuo mathiî mîena yonthe na nîmagecûra mavûrûrirî monthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngaatûma andû a Elamu metigîre nthû ciao, irîa ciendaga kûmaûraga. Nîngaûraga andû a Elamu nîrî na marakara meengî. Ngaamatûmîra athigari a mbaara mamaûrage mathire viû. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngaiga gîtî gîakwa Kîam ûthamaki kûu vûrûrirî wa Elamu na njûkangie athamaki na anene akuo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mavindarî ma mûthiia, nîngaatûma îtûûra rîa Elamu rîgacîre rîngî. Ûguo nîguo nie Ngai-Mûnene nîrauga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
