      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndûmîrîri îgiî Elamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îno nîyo ndûmîrîri îrîa yakinyîre Mûrathi Jeremia yumîte kûrî Ngai-Mûnene mwene vinya wonthe îgiî îtûûra rîa Elamu, rîrîa mûthamaki Zedekia ambîrîrie kwathana vûrûrirî wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
