        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngai-Mûnene arera andû a Hazoru atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.30",
            "verseOrgIds": [
              "JER.49.30"
            ]
          }
        }
