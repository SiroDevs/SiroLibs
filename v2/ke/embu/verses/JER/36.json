                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwaka wa kana Jehoiakimu mûvîcî wa Josia arî mûthamaki wa Juda, kiugo Kîam Ngai-Mûnene nîgîakinyîre Jeremia akîrwa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oca îvuku rîa gîkûnjo na wandîke maûndû monthe marîa nakwîrire megiî Isiraeli, Juda, na mavûrûri monthe, kuuma rîrîa nambîrîrie kwaria nawe, Josia arî mûthamaki nginya ûmûnthî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa kwîthîrwa andû a Juda nîmakwîgua maûndû monthe macûku marîa mvangîte kûmeka, nîguo wa mûndû agarûrûke atigane na mîthiîre yake mîcûku, nanie nîmarekere mevia mao na maûndû macûku marîa mekîte.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nîwacokire agîîta Baruku mûvîcî wa Neria na akîmwîra andîke îvukuurî rîa gîkûnjo maûndû monthe marîa Ngai-Mûnene aamwîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nîwacokire akîatha Baruku akîmwîra atîrî, “Nie ndirî mwîtîkîrie gûtonya nyombarî ya Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûthenya wa mbere wa kwîvinga kûrîa irio, nîûkaathiî nyombarî ya Ngai-Mûnene na ûthomere andû onthe ciugo cia Ngai-Mûnene irîa nakwathire wandîke îvukuurî rîîrî rîa gîkûnjo ngîkwîraga. Nîûkaithoma mbere ya andû onthe a Juda arîa makethîrwa maûkîte kuuma matûûrarî mao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa kwîthîrwa Ngai-Mûnene nwa egue mathaithana mao, na atî mûndû wa wonthe nwa atigane na mevia make, nîûndû Ngai-Mûnene nîakûverithia andû aya arî na marakara na mang'ûrîka meengî.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruku mûvîcî wa Neria, nîwavingirie maûndû monthe marîa mûrathi Jeremia amwathire megiî kûthoma ciugo cia Ngai-Mûnene irîa ciandîkîtwe îvukuurî rîa gîkûnjo arî nyombarî ya Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa gatano wa Jehoiakimu mûvîcî wa Josia, mûthamaki wa Juda, mwerirî wa kenda, andû onthe a Jerusalemu na andû arîa maumîte matûûrarî ma Juda nîmanîrîre mûthenya wa kwînyerekia mbere ya Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruku nîwathomere andû onthe ciugo cia Jeremia irîa ciandîkîtwe îvukuurî rîa gîkûnjo, arî nyombarî ya Ngai-Mûnene kanyombarî ka Gemaria mûvîcî wa Shafani ûrîa warî mwandîki. Kanyomba kau kaarî mwena wa îgûrû vakuvî na mwîrîga mûcerû wa nyomba ya Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atongoria nîmaathomerwe îvuku rîa gîkûnjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Mikaia mûvîcî wa Gemaria, mûvîcî wa Shafani egwire ciugo cionthe cia Ngai-Mûnene kuuma îvukuurî rîa gîkûnjo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîwathiîre nyombarî ya mûthamaki agîtonya oficirî ya mwandîki kûrîa atongoria onthe mekarîte. Andû acio maarî: Elishama mwandîki, Delaia mûvîcî wa Shemaia, Elinathani mûvîcî wa Akibori, Gemaria mûvîcî wa Shafani, Zedekia mûvîcî wa Hanania, na atongoria onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Mikaia nîwamerire ciugo cionthe irîa eguire vîndî îrîa Baruku aathomire îvuku rîa gîkûnjo mbere ya andû onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atongoria onthe nîmaatûmire Jehudi mûvîcî wa Nethania, Nethania mûvîcî wa Shelemia, Shelemia mûvîcî wa Kushi akeere Baruku atîrî, “Oca îvuku rîa Gîkûnjo rîrîa wathomere andû onthe na ûûke narîo ava.” Kwoguo Baruku mûvîcî wa Neria nîwocire îvuku rîu rîa gîkûnjo na akîthiî kûrî o. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaamwîrire atîrî, “Îkara nthî ûrîthome.” Nake Baruku nîwamathomere îvuku rîu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa meegwire ciugo cionthe, nîmaroranirie marî na guoya na makîra Baraki atîrî, “Nwanginya twîre mûthamaki maûndû mau monthe twegua.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaacokire makîûria Baruku atîrî, “Tatwîre ûrîa wavotire kwandîka ciugo ino cionthe? Nî Jeremia wakwîraga nawe ûkîandîkaga?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Baruku nîwamacokerie atîrî, “Nîke wambîraga ciugo ino cionthe nanie ngîandîkaga na karamu ka rangi îvukuurî rîîrî rîa gîkûnjo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atongoria onthe nîmerire Baruku atîrî, “Thiîni mûkethithe we na Jeremia na mûtikareke mûndû wana ûrîkû amenya varîa mûrî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûthamaki nîwavîvirie îvuku rîa gîkûnjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongoria nîmaigire îvuku rîu oficirî ya Elishama mwandîki wa mûthamaki. Nîmaacokire makîthiî kûrîa mûthamaki aarî na makîmwîra maûndû monthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwacokire agîtûma Jehudi akagîre îvuku rîu rîa gîkûnjo. Jehudi nîwarîgîrire oficirî kwa Elishama na akîrîthomera mûthamaki na atongoria onthe arîa maamûrigicîrîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îo kwarî mweri wa kenda, na mûthamaki eekarîte nyomba îrîa ekaraga vîndî ya mvevo agîota mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehudi athoma icunjî ithatû kana inya, mûthamaki nîwatembûrangaga icunjî icio na kaviû, na agîcikia mwakirî. Nîwatembûrangire îvuku rîonthe rîa gîkûnjo na akîrîvîvia rîkîthira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûnarî ûguo, mûthamaki kana ndungata ciake megua maûndû mau monthe, matiamaka kana matembûranga nguo ciao nî kîeva. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana ethîrwa Elinathani, Delaia na Gemaria nîmaathaithire mûthamaki ndakavîvie îvuku rîu rîa gîkûnjo, mûthamaki ndaamathikîrîria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwathire mûvîcî Jerahimeeli, Seraia mûvîcî wa Azirieli na Shelemia mûvîcî wa Abideli manyite Baruku mwandîki, na mûrathi Jeremia, nwatî Ngai-Mûnene nîwamathithire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia nîwandîkire îvuku rîngî rîa gîkûnjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa mûthamaki kûvîvia îvuku rîa gîkûnjo rîrîa rîarî na ciugo irîa Baruku aandîkîte akîragwa nî Jeremia, kiugo Kîam Ngai-Mûnene nîgîakinyîre Jeremia akîrwa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Oca îvuku rîngî rîa gîkûnjo na wandîke ciugo cionthe irîa wandîkîte îvukuurî rîa mbere rîrîa Jehoiakimu, mûthamaki wa Juda aravîvirie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene nîwambîrire mbîre mûthamaki atîrî, ‘We nîûravîvirie îvuku rîa gîkûnjo ûkîûragia atî: Nîndûî gîtûmîte wandîke atî mûthamaki wa Babuloni nîagaaûka na acûkangie vûrûri ûyû, na aûrage andû na nyamû irîa irî kuo?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nie Ngai-Mûnene nîrauga îgûrû rîgiî Jehoiakimu mûthamaki wa Juda atî, gûtirî mûndû wa rûciaro rwake ûgekarîra gîtî Kîam Daudi Kîam ûthamaki. Kimba gîake nîgîgaikua nja nîguo kîvîe nî riûa mûthenya na ûtukû kîvîvue nî mvevo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nîngamûverithia, njiarwa ciake na ndungata ciake nîûndû wa mevia mao. Nîngamaretera atûûri a Jerusalemu vamwe na andû a Juda maûndû monthe macûku marîa naaririe îgûrû rîao na makîrega kwîgua.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nîwacokire agîoca îvuku rîngî rîa gîkûnjo na akîrînengera Baruku ûrîa mwandîki, na akîandîka maûndû monthe marîa Jeremia aamwîraga. Nîwandîkire maûndû monthe marîa mandîkîtwe îvukuurî rîa mbere rîa gîkûnjo rîrîa Jehoiakimu mûthamaki wa Juda aavîvirie na mwaki. Ciugo ciîngî wata irîa ciarî îvukuurî rîa mbere nîciongereerwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
