                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Ezek 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vîndî îo andû matikaauga atî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
