            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîatûmîte athamaki a Media mavange kûtharîkîra vûrûri wa Babuloni nîûndû avangîte gûûcûkangia. Ûguo nîguo Ngai-Mûnene akwîrîvîrîria nîûndû wa kwanangwa kwa hekarû yake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.11",
            "verseOrgIds": [
              "JER.51.11"
            ]
          }
        }
      ]
    },
