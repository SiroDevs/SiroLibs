              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Jehoiakimu nîwacokire agîtûma Elinathani mûvîcî wa Akibori vamwe na arûme engî mathiî Misiri nîguo magîre Uria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
              "JER.26.22"
            ]
          }
        },
        {
          "name": "verse",
