            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao anene na andû onthe nîmerire athînjîri-Ngai na arathi atîrî, “Mûndû ûyû ndagîrîrwe nî gûtuîrwa kûragwa nîûndû atwarîria na rîîtwa rîa Ngai-Mûnene Ngai wetû.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa ûguo atongoria amwe a vûrûri nîmarûngamire na makîarîria andû arîa magomanîte makîmeera atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.12"
              },
              "items": [
                {
                  "text": "Mika 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mika wa Moreshethi nîwarathire vîndî îrîa Hezekia aarî mûthamaki wa Juda, na akîîra andû onthe a Juda atî, ‘Ngai-Mûnene mwene vinya wonthe augîte,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûthamaki Hezekia wa Juda na andû onthe a Juda nîmaamûragire? Kinthî tîkwa Hezekia etigîre Ngai-Mûnene na agîcaria wendi wake nake Ngai-Mûnene akîricûkwa gwîka maûndû macûku marîa augîte nîakûmeka? Nwatî tue nîkwa tûregîrîra ûndû mûcûku mûno.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwarî mûndû wîngî wetagwa Uria mûvîcî wa Shemaia kuuma Kiriathi Jearimu. Ke arathire ûvoro wîgiî îtûûra rîîrî na vûrûri ûyû akîgwetaga rîîtwa rîa Ngai-Mûnene na ciugo wata cia Jeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa mûthamaki Jehoiakimu vamwe na athigari ake na anene onthe meegwire ciugo ciake, mûthamaki nîwavangire kûmûûraga. Nwatî rîrîa Uria eeguire ûvoro ûcio, nîwetigîre na akîûra akîthiî Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
