              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîonekirî kîu, nînonire aka arîa maatigirwe mûciî kwa mûthamaki wa Juda makîvirwa kûrî anene a mûthamaki wa Babuloni. Nao maathiîte makiugaga atî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
