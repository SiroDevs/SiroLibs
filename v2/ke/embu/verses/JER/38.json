          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aka aku wana avîcî aku nîmakaavirwa gwa Akalidei, na we mwene ndûkavonoka ume njararî ciao, nwatî nîûkanyitwa nî mûthamaki wa Babuloni na îtûûra rîîrî rîvîvue na mwaki.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
