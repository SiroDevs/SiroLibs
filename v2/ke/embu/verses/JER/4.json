          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî, “Mûthenya ûcio athamaki na anene nîmakaathirwa nî vinya na athînjîri-Ngai nîmakaamaka nao arathi mavavûke.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînacokire ngiuga atîrî, “We Ngai-Mûnene, nama nîûveenetie andû a Jerusalemu viû na ûkaamera atî maûndû mao nîmakwîthîrwa marî maro, nwatî vîndî îo nîrîo marî ûgwatirî mûnene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
