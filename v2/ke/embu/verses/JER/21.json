              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Jeremia nîûgacoka wîre andû aya atî Ngai-Mûnene arauga atîrî, “Taroria, nîmbigîte mbere yaku gûtûûra mwoyo na gûkua. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe ûgatigwa îtûûrarî rîîrî nîakaaûragîrwa mbaararî nî yûra na mûrimû. Nwatî ûrîa ûkaumîra na enenganîre kûrî Akalidei arîa mamûrigicîrîtie, nîakaavonokia mwoyo wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînduîte meciriarî makwa kûthiria îtûûra rîîrî na kûrîcûkangia. Nîrîkanenganîrwa kûrî mûthamaki wa Babuloni, nake nîakaarîvîvia na mwaki.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andû a nyomba ya mûthamaki wa Juda nîmaatuîrîrwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
