                  "text": "2Maû 36.17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ûria ûvoro wetû kûrî Ngai-Mûnene, nîûndû mûthamaki Nebukadinezarû wa Babuloni nîevarîrîtie gûtûtharîkîra, nwa kwîthîrwa Ngai-Mûnene nîagûtûringîra Kîamma nîguo Nebukadinezarû atigane natue.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
