        "style": "s1"
      },
      "items": [
        {
          "text": "Gûtura mbura îvinda îraca",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
