            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene ambîrire atîrî, “Thiî, ûgûre nyûngû ya yûmba na woce atongoria amwe a andû a Isiraeli na athînjîri-Ngai arîa akûrû, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
