          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nawe nîûgacoka ûrage nyûngû andû onthe arîa mwathiîte nao makîonaga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ûmeere Ngai-Mûnene mwene vinya wonthe augîte atî: nîngaûraga andû aya na îtûûra rîîrî, wata ûrîa mûndû aûragaga nyûngû na ndîngîrûthwa îgatuîka nyûngû ng'ima rîngî. Andû nîmakaathika ciimba ciao Tofethi nîûndû gûtikethîrwa na kûndû kwîngî gwa kûmathika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo nie Ngai-Mûnene ngeka vandû ava vamwe na arîa matûûraga vo; nîngatûma îtûûra rîîrî rîkare ta Tofethi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyomba cia Jerusalemu na nyomba cia athamaki a Juda, na nyomba cionthe irîa îgûrû rîa cio kwavîvagîrua ûbani kûrî njata irîa îtûûraga îgûrû na gûkarutîrwa matega ma ndivei kûrî ngai ciîngî, nîgûkaagwatwa nî mûgiro wata Tofethi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
