              "type": "text"
            }
          ]
        },
        {
          "text": "athamaki onthe a Arabia na athamaki onthe a mîvîrîga yonthe îrîa îtûûraga werûrî; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
