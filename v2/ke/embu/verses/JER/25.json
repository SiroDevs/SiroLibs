              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "athamaki onthe a Zimuri, athamaki onthe a Elamu na athamaki onthe a Media; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
