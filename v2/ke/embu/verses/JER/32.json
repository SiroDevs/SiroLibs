                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2Atha 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.30-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmaaigire ngai cia mîvuanano hekarûrî îrîa ngoocagîrwa na makîmîgwatia mûgiro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Ala 18.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2Atha 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmatumîte metha cia kîgongoona cia Baali Kîamndarî Kîam Hinomu, nîguo marutîre ngai ya Moleku anake ao na erîtu ao marî magongoona. Tînie namaathire meke ûguo, na ûndû ûcio ndûngîatonyire meciriarî makwa, atî nwa meke ûndû ta ûcio ûrî mûgiro wa gûtûma andû a Juda mevia.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kîrîkanîro kîrî na mwîrîgîrîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo rîu, Ngai-Mûnene Ngai wa Isiraeli arauga ûvoro wîgiî îtûûra rîîrî atîrî, “Jeremia, andû aya marauga atî na njîra ya mbaara, yûra na mîrimû vûrûri ûyû nîûkaarekerua kûrî mûthamaki wa Babuloni. Nwatî nie nîrauga atî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîngaûngania andû onthe kuuma mavûrûrirî monthe kûrîa namanyaganirie nîûndû wa marakara na mang'ûrîka makwa. Nîngamacokia gûkû na ndûme matûûre kuo marî agitîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmagaatuîka andû akwa, nanie nduîke Ngai wao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngamava mworoto ûmwe nîguo mavote gûtûûra mandîaga tene na tene nîûndû wa wagîrîru wao o ene na wa njiarwa ciao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngarûtha kîrîkanîro gîa tene na tene nao atî, ndigatiga kûmeka maûndû maro na nîngatûma manîtigîre na ngoro ciao cionthe, nîguo matikandiganîrie rîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngakena ngîmeka maûndû maro, na ndûme mekindîrie vûrûrirî ûyû.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî, “Wata ûrîa ndeterete andû aya maûndû manene na macûku, nwa guo ngamaretera maûndû monthe maro marîa nîmerîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû nîmakaagûra mîgûnda vûrûrirî ûyû ûrîa mûrauga atî nî werû na gûtirî mûndû kana nyamû; na atî nîwavecanirwe njararî cia Akalidei. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû nîmakaagûra mîgûnda îo na mbeca na mekîre irore maarûarî cia mîgûnda, na ivingwe na kûgîe na aira vûrûrirî wa Benjamini, vakuvî na Jerusalemu, vakuvî na îtûûra rîa Juda, matûûrarî marîa marî vûrûrirî ûrîa ûrî irîma, na matûûrarî ma Shefela na matûûra marîa marî werûrî wa Negebu. Nîûndû nîngamacokia rîngî vûrûrirî wao. Nie Ngai-Mûnene nînie nauga ûguo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
