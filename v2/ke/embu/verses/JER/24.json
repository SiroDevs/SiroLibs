                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2Maû 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vuva wa Nebukadinezarû, mûthamaki wa Babuloni kûthamia Jekonia mûvîcî wa Jehoiakimu mûthamaki wa Juda, vamwe na atongoria a Juda, vamwe na mafundi na aturi kuuma Jerusalemu akîmavira Babuloni, Ngai-Mûnene nîwamonirie kîoneki. Kîoneki kîu Kîamrî Kîam ikavu igîrî cia ngûyû cigîtwe mbere ya hekarû ya Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîkavu kîmwe Kîamrî na ngûyû mbaro mûno ta ngûyû irîa itunîvaga irî cia mbere, nwatî gîkavu gîa kaîrî Kîamrî na ngûyû njûku mûno ûndû itangîrîka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene nîwambûrire atîrî, “Jeremia, nîndûî ûrona?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînacokirie atîrî, “Nîrona ngûyû mbaro mûno, na ngacoka ngona ngûyû njûku mûno îtangîrîka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîmbîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nie Ngai-Mûnene, Ngai wa Isiraeli nîrauga atî, ta ûrîa ngûyû ino îrî mbaro, nîguo ngona andû a Juda marî aro arîa narutire gûkû na ngîmavira îthamîriorî vûrûrirî wa Akalidei. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngamagitîra na nîmeke maûndû maro na nîngamacokia vûrûrirî ûyû. Nîngamatuma na ndikamomomora; nîngamavanda na ndikamang'aûrania. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngamava ngoro ya kûmenya atî, nie nînie Ngai-Mûnene. Nîmakaanjokerera na ngoro ciao cionthe na nîngatuîka Ngai wao nao matuîke andû akwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî ûvoro wîgiî Zedekia mûthamaki wa Juda, nie Ngai-Mûnene nîrauga atî, wata ûrîa ngûyû icio irî njûku ûndû itangîrîka, nîguo ngamwîka ke mwene, atongoria andû arîa matigarire Jerusalemu na arîa matûûraga vûrûrirî wa Misiri, wana arîa maathamîre vûrûrirî wa Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngamaretera maûndû macûku mûno ma kûmakia mavûrûri monthe ma nthî. Nîmagaatuîka kîndû gîa kûthekererwa, kûnyararûa, kwirwa na matuîke kîrumi kûrîa kuonthe ngamanyagania. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngatûma magîe na mbaara, yûra na manyitwe nî mîrimû mîcûku nginya rîrîa magacûkangua onthe mathire viû vûrûrirî ûrîa namaveere vamwe na methe mao.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
      ]
    }
  ],
