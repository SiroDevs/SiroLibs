          "items": [
            {
              "text": "\n        2Atha 23.36—24.6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2Maû 36.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kwoguo ûvoro wîgiî Jehoiakimu mûvîcî wa Josia mûthamaki wa Juda, Ngai-Mûnene arauga atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
