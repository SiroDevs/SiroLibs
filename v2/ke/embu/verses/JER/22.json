            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2Maû 36.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûvoro wîgiî Joahazu, mûvîcî wa Josia mûthamaki wa Juda ûrîa watuîkire mûthamaki vuva wa îthe Josia, na waumire gûkû akîthiî, Ngai-Mûnene arauga atîrî, “Ndagaacoka gûkû rîngî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nwatî agakuîra vûrûrirî ûrîa avirirwe atavwa na ndakoona vûrûri ûyû rîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
