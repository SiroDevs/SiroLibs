        },
        {
          "text": " Ngai-Mûnene mwene vinya wonthe Ngai wa Isiraeli arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
