          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.40",
            "verseOrgIds": [
              "JER.48.40"
            ]
          }
        }
      ]
    }
