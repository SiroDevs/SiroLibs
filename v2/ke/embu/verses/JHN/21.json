          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrutwa ûcio nîke waririe maûndû mama na akîmandîka na tue nîtwîcî atî ûvoro ûrîa aaririe nî wa ma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
