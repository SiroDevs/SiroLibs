        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ndeto nîciatambire gatagatîrî ka arûmîrîri a Jesû atî mûrutwa ûyû ndagaakua. Nwatî Jesû ndaaugîte atî mûrutwa ûyû ndagaakua, aaugîte atîrî, “Wana ngenda ekare nginya rîrîa ngaaûka rî, îo nî thîna yaku?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        }
      ]
