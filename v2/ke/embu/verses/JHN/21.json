              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwamûcokerie atîrî, “Wana ngenda ekare nginya rîrîa ngaaûka-î, îo nî thîna yaku? We ta nûmîrîra!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        }
