              },
              "items": [
                {
                  "text": "Mat 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Vuva wa ûguo Jesû nîwathiîre Kaperinaumu marî na ng'ina na arîa maaciaranîrîtue nake, wa vamwe na arutwa ake. Nao nîmeekarire kuo mîthenya mînini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwathiîre hekarûrî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
