            "sid": "JHN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo atongoria a Ayahudi nîmaacokire makîûria Jesû atîrî, “Nî Kîamma kîrîkû ûngîtûringîra gîa gûtwonia atî nîwagîrîrwe nî gwîka maûndû mama?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        }
      ]
    },
