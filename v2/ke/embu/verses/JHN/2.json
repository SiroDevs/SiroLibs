              "items": [
                {
                  "text": "15.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Jesû nîwamacokerie atîrî, “Thariani hekarû îno na nîngûcoka nîmîtume na mîthenya îthatû.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
            "verseOrgIds": [
              "JHN.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
