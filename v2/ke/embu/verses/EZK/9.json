        "style": "s1"
      },
      "items": [
        {
          "text": "Jerusalemu nîyaverithirue",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
