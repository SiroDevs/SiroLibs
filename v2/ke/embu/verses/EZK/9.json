              "items": [
                {
                  "text": "14.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na akîmwîra atîrî, “Vîtûkanîria îtûûrarî rîonthe rîa Jerusalemu na wîkîre rûûri mothiûrî ma andû onthe arîa maracaya na mararîra nîûndû wa maûndû marîa macûku marekwa îtûûrarî.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
