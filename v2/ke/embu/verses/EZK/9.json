              "EZK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riiri wa Ngai wa Isiraeli nîwaumîte îgûrû kûrî Akerubi kûrîa wekaraga na ûkathiî kîvingorî gîa hekarû. Ngai nîwacokire agîta mûndû ûrîa wekîrîte nguo mbaro na warî na kîndû gîa kwandîka ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
