            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwathani Ngai-Mûnene augîte atîrî, “We Edomu nîngaagûtua werû, na mavûrûri monthe ma nthî nîmagaakena ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wata ûrîa we wakenire rîrîa vûrûri wa Isiraeli wanangirwe. Kwoguo ûguo nîguo ngaagwîka. Kîrîma gîa Seiru nîgîgaatuîka werû, wana vûrûri wonthe wa Edomu. Nao nîmakaamenya atî, nie nînie Ngai-Mûnene.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
