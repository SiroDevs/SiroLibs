              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîvîrîga îrîa îtigarîte îkaagaîrwa icunjî ciao ta ûû: Mûvîrîga wa Benjamini ûkaagaîrwa gîcunjî Kîamo kuuma mwena wa îrathîro kûthiî mwena wa îthûîro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa kîriganîtie na mûvîrîga wa Benjamini, kuuma mwena wa îrathîro nginya mwena wa îthûîro gîkaagaîrwa mûvîrîga wa Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
