              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene Ngai nîwaugire atîrî, “Ûcio nîguo vûrûri ûrîa ûkaagaîrwa mîvîrîga ya Isiraeli ûtuîke wao wa mûvîrîga gîcunjî Kîamguo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
