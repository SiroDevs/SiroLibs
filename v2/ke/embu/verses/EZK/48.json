          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa kîriganîtie na mûvîrîga wa Isakaru, kuuma mwena wa îrathîro nginya mwena wa îthûîro gîkaagaîrwa mûvîrîga wa Zebuluni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa kîriganîtie na mûvîrîga wa Zebuluni, kuuma mwena wa îrathîro nginya mwena wa îthûîro gîkaagaîrwa mûvîrîga wa Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwena wa îveti wa gîcunjî Kîam mûvîrîga wa Gadi, mûvaka ûkauma Tamaru ûthiîte ithimarî cia Meriba-kadeshi, ûcoke ûthiî na mwena wa rûgûrû wa îthûîro ûthiîcanîtie na mûvaka wa vûrûri wa Misiri nginya îriarî rîa Mediterania.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
