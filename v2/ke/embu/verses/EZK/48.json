          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa kîriganîtie na mûvîrîga wa Simeoni, kuuma mwena wa îrathîro nginya mwena wa îthûîro gîkaagaîrwa mûvîrîga wa Isakaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
