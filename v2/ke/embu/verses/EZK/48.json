              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa mûkaamûrîra Ngai-Mûnene nî Kîam ûraca wa kilomita îkûmi na igîrî na nuthu (12.5) na wariî wa kilomita îkûmi (10). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athînjîri-Ngai makaagaîrwa gîcunjî Kîamo kuuma gîcunjîrî gîkî Kîammûrîrîtwe Ngai-Mûnene. Gîcunjî kîu kuuma mwena wa îrathîro nginya mwena wa îthûîro gîkethîrwa kîrî Kîam ûraca wa kilomita îkûmi na igîrî na nuthu (12.5) na wariî kuuma mwena wa rûgûrû nginya wa îveti kilomita ithano (5). Hekarû îkethîrwa îrî gatagatî ka gîcunjî gîkî. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîu gîgaatuîka Kîam athînjîri-Ngai arîa amûre a njiarwa cia Zadoku arîa maandungatîre marî na wîvokeku. Acio matiandiganîria rîrîa Aisiraeli na Alawi acio engî maandiganîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîmakaagaîrwa gîcunjî Kîamo Kîam mwanya na gîtuîke kîtheru mûno kuuma kûrî gîcunjî kîrîa Kîammûre. Gîcunjî kîu gîkaarigania na kîrîa gîkaagaîrwa Alawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa gîkaagaîrwa Alawi gîkethîrwa kîrî mwena wa îveti wa gîcunjî Kîam athînjîri-Ngai. Nakîo nîkîa ûraca wa kilomita îkûmi na igîrî na nuthu (12.5) na wariî wa kilomita ithano (5). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîcunjî kîrîa Kîammûrîre Ngai-Mûnene nîkîo Kîamro mûno vûrûrirî. Gîtikendua kana gîkûrananue kana kîgaîrwe mûndû wana ûrîkû, nîûndû nî kîtheru na nîkîa Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
