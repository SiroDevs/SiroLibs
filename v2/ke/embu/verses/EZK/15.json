        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya Mûthavibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
