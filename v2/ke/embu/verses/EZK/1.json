              "attrs": {
                "loc": "REV.19.6"
              },
              "items": [
                {
                  "text": "19.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînegwire mûgambo wa mathagu ma cio magûrûkîte; mûgambo wamo warî ta wa mûrurumo wa manjî meengî, mûgambo ta wa athigari a mbaara eengî, mûgambo ta wa Ngai. Na rîrîa ciarûngama nîciakûnjaga mathagu mau. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîgwacokire gûgîûka mûgambo kuuma îgûrû rîa mûtambarûko wa matu ûrîa ûrî îgûrû rîa ciongo cia cio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        }
