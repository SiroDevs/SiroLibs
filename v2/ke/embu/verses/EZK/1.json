              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkengu ûcio warî na marangi ta ma mûkûngambura. Ûguo nîguo mûvano wa ûkengu wa riiri wa Ngai-Mûnene wekariî.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
