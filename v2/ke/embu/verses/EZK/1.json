          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Ezek 10.9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wa ndoretie ciûmbe icio inya nînonire nthugû vau nthî, wa kîûmbe kîrî na nthugû yakîo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthugû icio nîciavanene; na ciavenavenagia ta îthiga rîa goro rîa rangi wa erûû. Ûrîa nthugû icio ciathondeketwe ciavanaga ta nthugû îrî ndaarî ya nthugû îngî. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthugû icio ciathiîcaga irûngîrîrîtie na mîena yonthe îna na itakûgarûrûka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Ezek 10.9-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nthugû icio ciarî cia kûmakania na ndaca na ciecûrîte metho mîena yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa ciûmbe icio irî mwoyo ikûthiî, nthugû nacio ciathiîcaga irî mwena wacio. Rîrîa ciûmbe icio irî mwoyo ciarûga na îgûrû kuuma nthî, wana cio nthugû nîciarûgaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrîa kuonthe ciûmbe icio irî mwoyo ciendaga kûthiî nîciathiîcaga nacio nthugû ikairûmîrîra, nîûndû nthugû ciathagwa nî ciûmbe icio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa ciûmbe icio ciathiî, nthugû nîciathiîcaga; rîrîa ciarûngama nacio nthugû ikarûngama. Rîrîa ciarûga na îgûrû kuuma nthî nacio nthugû ikarûga na îgûrû vamwe nacio, nîûndû nthugû ciathagwa nî ciûmbe icio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
