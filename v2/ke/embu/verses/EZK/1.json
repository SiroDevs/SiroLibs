              "items": [
                {
                  "text": "Kûguû 19.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûthenya wa gatano mweri wa kana mwaka wa mîrongo îthatû, nie mûthînjîri-Ngai Ezekieli mûvîcî wa Buzi, twatûûraga vamwe na Ayahudi arîa maarî îthamîriorî kûu Babuloni rûtererî rwa rûnjî rwa Kebari. Nîrî kûu nînonire îtu rîavingûka na ngîona kîoneki Kîam Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
