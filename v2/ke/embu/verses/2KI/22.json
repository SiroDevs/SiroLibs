              "2KI.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Jer 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Josia aarî na ûkûrû wa mîaka înana (8) rîrîa aatuîkire mûthamaki wa Juda, na nîwathanire arî Jerusalemu îvinda rîa mîaka mîrongo îthatû na ûmwe (31). Ng'ina eetagwa Jedida, mwarî wa Adaia wa kuuma îtûûrarî rîa Bozikathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.1",
            "verseOrgIds": [
              "2KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia nîwekire maûndû monthe marîa maakenagia Ngai-Mûnene: nîwarûmîrîre mîthiîre ya îthe Daudi, na nîwavingagia mawatho monthe ma Ngai akindîrîtie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îvuku rîa watho nîrîonekire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa îkûmi na înana (18) Josia arî mûthamaki, nîwatûmire mwandîki Shafani, mûvîcî wa Azalia, Azalia mûvîcî wa Meshulamu hekarûrî na akîmwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thiî kûrî Hilikia, mûthînjîri-Ngai mûnene ûmwîre atare mbeca irîa arangîri a hekarû maûnganîtie kuuma kûrî andû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûmwîre anenganîre mbeca icio kûrî andû arîa marûngamîrîrîte wîra wa gûcokereria hekarû nîguo nao marîve andû arîa mararuta wîra ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeca icio nî cia kûgûra mbaû, mathiga ma gûtuma hekarû kûrîa kûtharûku, na kûrîva andû arîa marutaga wîra wa mbaû, atumi na andû arîa maumagia mathiga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.15"
              },
              "items": [
                {
                  "text": "2Atha 12.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû arîa marûngamîrîrîte wîra wa gûcokereria hekarû nî evokeku, kwoguo gûtirî vata wa kûmaûria ûrîa matûmîrîte mbeca.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikia, mûthînjîri-Ngai mûnene nîwerire Shafani ûrîa warî mwandîki atîrî, “Nîmonire îvuku rîa watho hekarûrî ya Ngai-Mûnene.” Hilikia nîwacokire akînengera Shafani îvuku rîu, nake akîrîthoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani nîwacokire rîngî kûrî mûthamaki na akîmwîra atîrî, “Ndungata ciaku nîciocire mbeca irîa ciocanirue kîvingorî Kîam hekarû na mainenganîra kûrî andû arîa marûngamagîrîra wîra wa gûtuma hekarû kûrîa kûtharûku.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire akîra mûthamaki atîrî, “Mûthînjîri-Ngai Hilikia nîwanengerire îvuku.” Nake Shafani nîwathomere mûthamaki îvuku rîu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûthamaki eegwire ûrîa îvuku rîa watho rîaugaga, nîwatembûrangire nguo ciake, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akîatha mûthînjîri-Ngai Hilikia, Ahikamu mûvîcî ma Shafani, Akibori mûvîcî wa Mikaia, Shafani mwandîki, na Asaia ndungata ya mûthamaki akîmeera atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thiîni mûkaûrie Ngai-Mûnene vandûrî vakwa, na vandûrî va andû onthe a Juda ûvoro wîgiî mandîko ma îvuku rîîrî rîronekire, nîûndû Ngai-Mûnene nîmûrakaru mûno nîtue nîûndû methe metû matiavingia maûndû monthe marîa matwîgiî kûringana na ûrîa îvuku rîîrî riugîte.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûthînjîri-Ngai Hilikia, Ahikamu, Akibori, Shafani, na Asaia nîmaathiîre kûrî mûndûmûka ûmwe mûrathi wetagwa Hulida, mûka wa Shalumu, mûvîcî wa Tikiva. Tikiva aarî mûvîcî wa Harihasi. Harihasi nîke wamenyagîrîra nguo cia hekarû. Vîndî îo Hulida aatûûraga Jerusalemu, îtûûrarî rîa kaîrî. Nao nîmaaranîrie nake, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.14",
            "verseOrgIds": [
              "2KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nîwamerire macoke kûrî mûthamaki na mamwîre ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene augîte atîrî, “Nîngûretithîria kûndû gûkû na andû arîa matûûraga kuo maûndû macûku, wata ûrîa îvuku riugîte rîrîa mûthamaki wa Juda athoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmandiganîrîtie na nîmarutîrîte ngai ciîngî magongoona na kwoguo nîmandakarîtie nî maûndû monthe marîa mekîte. Nîûndû wa ûguo, nîndakarîtue nî Jerusalemu na marakara makwa matingîthira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.17",
            "verseOrgIds": [
              "2KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî thiîni kûrî mûthamaki wa Juda ûrîa ûramûtûmire mûgatuîrie ûvoro kûrî Ngai-Mûnene mûmwîre Ngai-Mûnene Ngai wa Isiraeli augîte atî; kûringana na ndûmîrîri îrîa eguîte, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûthamaki wa Juda nîareririre na enyivia mbere ya Ngai-Mûnene, na atembûranga nguo ciake. Rîrîa aregwire ûrîa mbugîte nîngwîka kûndû gûkû vamwe na andû arîa matûûraga kuo, na atî vûrûri ûyû nîûtûûra ûrî mûrume na ûrî îganjo. Nie Ngai-Mûnene nîmbîguîte îvoya rîaku, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.19",
            "verseOrgIds": [
              "2KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwoguo ndikaaverithia Jerusalemu wî mwoyo. Nîngaamba gweterera ûkue na thayû.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.20",
            "verseOrgIds": [
              "2KI.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû acio nîmaacokerie mûthamaki Josia ndûmîrîri îo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.20",
            "verseOrgIds": [
              "2KI.22.20"
            ]
          }
        }
      ]
    }
  ],
