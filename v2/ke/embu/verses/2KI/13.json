          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli mûthamaki wa Sîria nîwavinyagîrîria andû a Isiraeli vîndî îrîa yonthe Jehoahazi aarî mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Ngai-Mûnene nîwamatugire na akîmeguîra ntha. Ndaamatiganîria macûkangue, nwatî nîwamatethirie nîûndû wa kîrîkanîro kîrîa aarûthîte na Iburahimu, Isaka na Jakovu. Ngai-Mûnene ndaanatiganîria andû ake nginya ûmûnthî.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
