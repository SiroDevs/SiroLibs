              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Hazaeli, mûthamaki wa Sîria aakwire, mûvîcî Benihadadi nîwatuîkire mûthamaki vuva wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
