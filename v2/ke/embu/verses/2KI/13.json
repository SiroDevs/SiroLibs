    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikundi cia athigari a mbaara cia andû a Moabu nîmaatharîkagîra vûrûri wa Isiraeli wa mwaka wa mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îmwe andû marî mathikorî nîmoonire gîkundi Kîam athigari gîûkîte kûmatharîkîra. Andû acio nîmaaikirie kimba Kîam mûndû ûcio mbîrîrarî îrîa Elisha aathikîtwe magîcoka makîûra. Vîndî wa îo kimba kîu Kîamvutia mavîndî ma Elisha, mûndû ûcio nîwariûkire na akîrûngama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbaara ya andû a Isiraeli na andû a Sîria",
          "type": "text"
        }
      ]
    },
