          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "arî na ûkûrû wa mîaka mîrongo îîrî na îtano (25). Nîwathanire arî Jerusalemu îvinda rîa mîaka îkûmi na îtandatû (16). Ng'ina eetagwa Jerusha, mwarî wa Zadoku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
