                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ûguo nîguo kîîranîro Kîamvingire kîrîa Ngai-Mûnene eerîre Jehu rîrîa aamwîrire atîrî, “Njiarwa ciaku nîigekarîra gîtî Kîam ûthamaki Kîam Isiraeli nginya rûciaro rwa kana.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
