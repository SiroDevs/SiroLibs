          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jothamu nîwekire maûndû marîa maakenagia Ngai-Mûnene wata marîa monthe meekagwa nî îthe Uzia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî kûndû kûrîa kwagoocagîrwa mîvuanano gûtiacûkangua; na andû nîmaathiîre na mbere kûruta magongoona na kûvîvîria ûbani kuo. Jothamu nîwatumire kîvingo Kîam mwena wa rûgûrû Kîam hekarû.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        }
