            }
          ]
        },
        {
          "text": "Mwakarî wa kaîrî Peka, mûvîcî wa Remalia arî mûthamaki wa Isiraeli, Jothamu mûvîcî wa Uzia nîwatuîkire mûthamaki wa Juda ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
