          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwevîrie Ngai-Mûnene na njîra ya gwîka maûndû macûku ta marîa meekagwa nî mûthamaki Jeroboamu mûvîcî wa Nefati ûrîa watûmire andû a Isiraeli mevie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
