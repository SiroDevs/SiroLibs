            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa mîrongo îthatû na înana, Azaria arî mûthamaki wa Juda, Zakaria mûvîcî wa Jeroboamu nîwatuîkire mûthamaki wa Isiraeli, na nîwathanire arî Samaria îvinda rîa mîeri îtandatû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakaria nîwekire maûndû marîa mataakenagia Ngai-Mûnene ta marîa meekîtwe nî methe make. Nîwekire mevia ta marîa meekîtwe nî Jeroboamu, mûvîcî wa Nefati, ûrîa watûmire andû a Isiraeli mevie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu, mûvîcî wa Jabeshi nîweciririe ûrîa akûraga mûthamaki Zakaria na nîwamûragîre kûu Ibileamu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15.10",
              "type": "text"
            },
            {
              "text": "Ibileamu:",
              "type": "text"
            },
            {
              "text": "Kîhibirania kiugaga ‘andû makîonaga.’",
              "type": "text"
            }
          ]
        },
        {
          "text": " na agîtuîka mûthamaki vuva wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        }
      ]
    },
