              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.17",
            "verseOrgIds": [
              "2KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûndû ûmwe nîwatûîre mbarathi na akîthiî gûtûnga Jehu na akîmûria atîrî, “Mûthamaki nîarenda kûmenya kana ûkîte na thayû.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehu nîwamûcokerie atîrî, “Ûcio tî wîra waku. Coka vuva wakwa na ûnûmîrîre!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrangîri wa îtûûra nîwaugire atîrî, “Mûnjaama nîwakinya kûrî o, nwatî ndaracoka.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joramu nîwatûmire mûnjaama wa kaîrî athiî kûrî Jehu na gîkundi Kîam andû ake na akîmûria atîrî, “Mûthamaki arenda kûmenya kana ûkîte na thayû.” Nake Jehu nîwamûcokerie atîrî, “Ûcio tî wîra waku. Coka vuva wakwa na ûnûmîrîre.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrangîri wa îtûûra nîwaugire rîngî atîrî, “Mûnjaama nîwakinya kûrî o, nwatî ndaracoka. Nake mûtongoria wa gîkundi agîtwarithîtie na îvenya ta ûrîa Jehu, mûvîcî wa Nimushi atwarithagia.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joramu, mûthamaki wa Isiraeli nîwaugire atîrî, “Mvarîrîriai gîkaari gîakwa.” Nakîo nîkîavarîrîrue. Joramu na Ahazia, mûthamaki wa Juda nîmaatwîre wa mûndû gîkaarirî gîake na makîthiî gûtûnga Jehu. Nîmaacemanirie nake mûgûndarî ûrîa warî wa Nabothi, Mûjezireeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Joramu oonire Jehu, nîwamûririe atîrî, “Ûkîte na thayû?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehu nîwamûcokerie atîrî “Kûngîthîrwa kwî na thayû atîa rîrîa ûragûri na ûvoi wa ngai cia mîvuanano irîa ciaretirwe nî nyûkwe, Jezebeli ciîngîvîte ûguo?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joramu nîwacokire akîgarûra gîkaari gîake, akîûra na akîra Ahazia atîrî, “Kûu nî kûgarûra thirikari!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu nîwagucirie ûta na vinya wake wonthe na akîratha Joramu na mûguî gatagatîrî ga ituro ciake na ûkîmunda ngoro na Jehu nîwagwîre agîkua arî kûu gîkaarirî gîake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.24",
            "verseOrgIds": [
              "2KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu nîwerire Bidikari mûrangîri wake atîrî, “Oca kimba gîake ûthiî ûgikie mûgûndarî wa Nabothi, Mûjezireeli. Ririkana rîrîa we nanie twathiîte vamwe tûtwîte mbarathi tûrî vuva wa îthe Ahabu, Ngai-Mûnene nîwaugire îgûrû rîgiî Ahabu atî, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.25",
            "verseOrgIds": [
              "2KI.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.19"
              },
              "items": [
                {
                  "text": "1Atha 21.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ‘Nama îgoro nînîronire kimba Kîam Nabothi wana ciimba cia anake ake. Ngaakûûragîra mûgûndarî wa ûyû nîguo nîîrîvîrîrie.’ Kwoguo Jehu nîwerire mûrangîri wake atîrî ‘Oca kimba gîake ûthiî ûgikie mûgûndarî wa Nabothi, wata ûrîa Ngai-Mûnene aaugire.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazia, mûthamaki wa Juda nîwaûragirwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Ahazia, mûthamaki wa Juda oonire ûguo, nîwaûrire erekerete mwena wa Bethi Hagani. Jehu nîwamûrûmîrîrie na akîra andû ake mamûûrage. Nao nîmaamûrathire arî gîkaarirî gîake Kîam mbaara athiîte Guri arî vakuvî na îtûûra rîa Ibuleamu. Nwatî nîwaûrîre Megido, îtûûra rînene na agîkuîra kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndungata ciake nîciakuuire mwîrî wake ûrî gîkaarirî Kîam mbaara ûkîvirwa Jerusalemu. Nîciaûthikire mbîrîrarî irîa ciathikagwa athamaki îtûûrarî rînene rîa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia nîwatuîkire mûthamaki wa Juda mwakarî wa îkûmi na ûmwe Joramu mûvîcî wa Ahabu arî mûthamaki wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûragwa kwa Jezebeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jehu aakinyire Jezireeli, Jezebeli nîwegwire ûvoro ûcio. Nîwegemirie metho make, akîrûtha njuîrî ciake waro, akîthiî ndiricarî na akîrorereria na kûu vûrûrirî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.30",
            "verseOrgIds": [
              "2KI.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jehu aatonyire kîvingorî, Jezebeli nîwaûririe atîrî, “Zimuri, we ûraûragire mwathi waku ûkîte na thayû?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu nîwarorererie ndiricarî na akîûria atîrî, “Nîûrîkû ûrî mwena wakwa? Nîûrîkû?” Ngaramba ithatû cia mûthamaki nîciamûrorererie ndiricarî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.32",
            "verseOrgIds": [
              "2KI.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehu nîwamerire atîrî, “Mûvarûkieni nthî!” Kwoguo ndungata icio nîciavarûkirie Jezebeli nthî; nayo nthakame îmwe ya Jezebeli nîyaminjûkîre rûthingo, nayo îo îngî îkîminjûkîra mbarathi. Jehu nîwakinyangire mwîrî wa Jezebeli na mbarathi ciake na gîkaari gîake Kîam mbarathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.33",
            "verseOrgIds": [
              "2KI.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwatonyire nyomba ya ûthamaki akîrîa na akînyua. Nîwacokire akiuga atîrî, “Ocani mûndûmûka ûyû mûrume na mûmûthike, nîûndû nî mwarî wa mûthamaki.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.34",
            "verseOrgIds": [
              "2KI.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî arûme arîa maathiîre kûmûthika matiethîra mwîrî wake wonthe tiga îvîndî rîake rîa kîongo, mavîndî ma magûrû na ma njara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.35",
            "verseOrgIds": [
              "2KI.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
