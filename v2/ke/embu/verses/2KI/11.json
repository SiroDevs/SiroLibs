          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joashi aatuîkire mûthamaki wa Juda arî na ûkûrû wa mîaka mûgwanja (7).",
          "type": "text",
