                "loc": "GEN.32.28"
              },
              "items": [
                {
                  "text": "Kîam 32.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû acio matwîre mekaga wa ûrîa meekaga tene nginya ûmûnthî. Matigoocaga Ngai-Mûnene kana mavingia mawatho, irîra kana watho na maathani marîa aaveere njiarwa cia Jakovu, ûrîa eetire Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "Ntha 20.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9"
              },
              "items": [
                {
                  "text": "Gûco 5.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîwarûthîte kîrîkanîro nao na akamatha atîrî, “Mûtikagooce ngai ciîngî; mûtikenamîrîrie mothiû menyu mbere yacio kana mûitungatîra kana mûirutîre magongoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Gûco 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî mûngoocage nie Ngai-Mûnene, ûrîa wamûrutire vûrûri wa Misiri na vinya mwîngî na wendo mûnene; nie nînie mûkaagoocaga na mûndutagîre magongoona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaavingagia vîndî cionthe mawatho, irîra na maathani marîa naamwandîkîre. Mûtikagooce ngai ciîngî, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mûtikariganîrwe nî kîrîkanîro kîrîa naarûthire namue. Mûtikagooce ngai ciîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûkangoocaga nie, Ngai-Mûnene Ngai wenyu, na nîngaamûvonokia kuuma kûrî nthû cienyu cionthe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûnarî ûguo, andû acio matiegua ûrîa Ngai-Mûnene aameerire, na nîmaathiîre na mbere gwîka maûndû wa marîa meekaga tene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        }
      ]
    },
