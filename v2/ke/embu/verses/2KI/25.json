              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mwerirî wa mûgwanja (7), Ishumaeli mûvîcî wa Nethania wa kuuma nyombarî ya mûthamaki nîwathiîre Mizipa na athigari îkûmi na akîtharîkîra Gedalia na akîmûraga vamwe na Ayahudi na Akalidei arîa maarî nake kûu Mizipa. Nethania aarî mûvîcî wa Elishama. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.5+JER.43.6+JER.43.7"
              },
              "items": [
                {
                  "text": "Jer 43.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû onthe a Isiraeli, arîa anini na arîa anene, vamwe na anene a athigari nîmaacokire makiuma kûu na makîthiî Misiri, nîûndû nîmeetigagîra Akalidei.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakini nîwarekererue kuuma Njera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
