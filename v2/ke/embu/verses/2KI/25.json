              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa mûgwanja mweri wa gatano, mwakarî wa îkûmi na kenda Nebukadinezarû arî mûthamaki wa Babuloni, Nebuzaradani, ndungata ya mûthamaki ûrîa warî mûnene wa athigari a mbaara a mûthamaki nîwathiîre Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1Atha 9.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîwavîvirie hekarû, nyomba ya mûthamaki na nyomba cionthe cia Jerusalemu. Nyomba cionthe nene îtûûrarî nîciavîvirue. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athigari onthe a Babuloni arîa maarî vamwe na Nebuzaradani mûnene wa athigari nîmoomomorire nthingo irîa ciathiûrûrûkîrîtie Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani nîwacokire akînyita andû onthe arîa maatigîtwe îtûûrarî vamwe na andû arîa maathiîte na makerekereria kûrî mûthamaki wa Babuloni na akîmavira îthamîriorî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî nîwatigire andû amwe arîa maarî athîni mûno kûu Juda nîguo mamenyagîrîre mîthabivû na marutage wîra mîgûndarî.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
