              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî ûrîa Evilimerodaki aatuîkire mûthamaki wa Babuloni, nîwaeguîrîre Jehoiakini mûthamaki wa Juda ntha na akîmûrekereria kuuma njera. Mûthenya wa mîrongo îîrî na mûgwanja (27) wa mweri wa îkûmi na îîrî mwaka wa mîrongo îthatû na mûgwanja kuuma Jehoiakini avirwa îthamîriorî nîrîo aarekereerue kuuma njera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evilimerodaki nîwarîrie Jehoiakini waro na akîmûnenevia gûkîra athamaki arîa engî maarî nake îthamîriorî kûu Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Jehoiakini nîwarutire nguo ciake cia njera na kuuma vîndî îo nîwatûûrire arîcanagîra na mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakini nîwavecagwa wa mûthenya kîrîa aavataraga nî mûthamaki ûtûûrorî wake wonthe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
      ]
