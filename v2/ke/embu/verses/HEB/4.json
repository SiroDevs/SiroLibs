                "loc": "DEU.31.7"
              },
              "items": [
                {
                  "text": "Gûco 31.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.4"
              },
              "items": [
                {
                  "text": "Josh 22.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kethîrwa Joshua nîwavere andû kîvurûko kîrîa meerîrîtwe, Ngai ndangîacokire kwaria vuvarî ûvoro wîgiî mûthenya wîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na njîra wata îno, nîgûtigarîtie mûthenya wa kûvurûka wa andû a Ngai, wata ûrîa Ngai aavurûkire mûthenya wa mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.2"
              },
              "items": [
                {
                  "text": "Kîam 2.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndû wa wonthe ûvotete gûtonya kîvurûkorî kîrîa Ngai eeranîre, nîakaavurûka kuuma wîrarî wake wata ûrîa Ngai aavurûkire kuuma kûrî wîra wake. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîtûgerie mûno tûtonye kîvurûkorî kîu, nîguo gûtikethîrwe kûrî mûndû wanarî ûmwe gatagatîrî getû ûkaaremwa nî gûtonya kîvurûkorî nîûndû wa ûremi ta ûcio wao.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
