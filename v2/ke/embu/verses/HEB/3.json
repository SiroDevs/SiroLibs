            }
          ]
        },
        {
          "text": " Kwoguo wata ûrîa Roho Mûtheru augîte atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
