            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai mwene thayû aromûva indo cionthe mbaro irîa mûvatarîte nîguo mwîkage wendi wake. Na njîra ya Jesû Kristû arotwîka ûndû ûrîa ûmûkenagia. Nake Kristû arokumagua tene na tene. Ameni!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
      ]
    },
