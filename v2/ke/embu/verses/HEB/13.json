              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariû na aarî a îthe wetû, nîngûmûria mûthikîrîrie ndûmîrîri îno ya kûmwîkîra vinya. Maarûa îno namwandîkîra tî ndaca mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
              "HEB.13.22"
            ]
          }
        },
        {
          "name": "verse",
