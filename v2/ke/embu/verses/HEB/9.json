              },
              "items": [
                {
                  "text": "Ntha 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vuva wa gîtambaa gîa kaîrî kûu îgemarî ndaarî kwarî na îgema rîrîa rîetagwa “Vandû varîa vatheru Mûno.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
