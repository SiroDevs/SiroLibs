                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maûndû mau mavangîtwe ta ûû: Athînjîri-Ngai mathiîcaga îgemarî rîa nja wa mûthenya kûruta wîra wao wa ûtungati. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15+LEV.16.16"
              },
              "items": [
                {
                  "text": "Ala 16.15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.9"
              },
              "items": [
                {
                  "text": "Nda 19.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.17+NUM.19.18+NUM.19.19"
              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî Mûthînjîri-Ngai ûrîa mûnene nîke tu ûthiîcaga îgemarî rîa ndaarî, na ekaga ûguo riita rîmwe wa mwaka. Ke ocaga nthakame akathiî nayo îgemarî na akamîrutîra Ngai nî ûndû wake ke mwene na nîûndû wa mevia marîa andû mekîte matakûmenya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na njîra îno, Roho Mûtheru nîonanagia atî rîrîa rîonthe îgema rîa nja rîrî vo, njîra ya kûthiî vandû varîa vatheru Mûno tî mvingûre. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîkî nî kîonereria Kîam îvinda rîîrî tûrî. Maûndû mama monthe monanagia atî iveo na magongoona ma nyamû marîa tûrutagîra Ngai matingîvota gûtûma thamiri ya mûndû ûrîa ûragooca Ngai îtuîke nginyanîru. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû iveo na mambura mau monanagia ûvoro wa kûrîa, kûnyua, na mambura mwanya mwanya ma kwîtheria. Mawatho mau monthe megiî ûvoro wa mwîrî, na mathiraga vinya rîrîa Ngai akathondeka ûndû mûcerû.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
