              "MRK.4.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.15"
              },
              "items": [
                {
                  "text": "Mat 5.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.33"
              },
              "items": [
                {
                  "text": "Luka 11.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû nîwathiîre na mbere na kûmeera atîrî, “Kûrî mûndû wakagia taa akînamîkunîkîra na ndeve, kana akînamiga rungu rwa gîtanda? Na kinthî ndigagîrîrwa vandû îgûrû? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.26"
              },
              "items": [
                {
                  "text": "Mat 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.2"
              },
              "items": [
                {
                  "text": "Luka 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûtirî kîndû kîthithe gîtakoonanua, kana ûndû wîkagîrwa ndumarî ûtakoonanua ûtherirî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûrîa wîna matû ma kwîgua, nîegue!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
