                "loc": "LUK.6.38"
              },
              "items": [
                {
                  "text": "Luka 6.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Jesû nîwacokire akîmeera atîrî, “Menyererani maûndû marîa mûregua, nîûndû kîthimi kîrîa mûthimanagîra nakîo nwakîo Ngai akaamûthimîra nakîo na amwongerere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.29"
              },
              "items": [
                {
                  "text": "25.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.26"
              },
              "items": [
                {
                  "text": "Luka 19.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake mûndû ûrîa wîna kîndû nîakoongererwa, nwatî ûrîa ûtarî nîagaacunwa wana kîrîa kînini arî nakîo.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
            "verseOrgIds": [
              "MRK.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya gûkûra kwa mbeû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
            "verseOrgIds": [
              "MRK.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwathiîre na mbere na kûmeera atîrî, “Ûthamaki wa Ngai wîkariî ta mûndû ûrîa ûvandaga mbeû mûgûndarî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandaga, agacoka akamama gwatuka, na agaûkîra gwakîa. Na kavinda wa kau mbeû nîimeraga na igakûra atakûmenya ûrîa irakûra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthetu nîguo ûtûmaga mîmera îkûre na îciare; yambaga kûruta mîûgî, îgacoka îkaruta mathangû, na vuvarî îkagûrûkia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Joe 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mîmera yarîkia gûkûra, mûrîmi nîamîkethaga.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
            "verseOrgIds": [
              "MRK.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya mvîndî ya mûtî wa karatarî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.29",
            "verseOrgIds": [
              "MRK.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwacokire akîmaûria atîrî, “Tûngîringithania ûthamaki wa Ngai na ndûî? Nî ngerekano îrîkû tûngîvecana tûgîûtarîrîria? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûthamaki wa Ngai wîkariî ta mvîndî ya mûtî wa karatarî, îrîa îthagîrwa îrî yo nini mûno gûkû nthî. Mûrîmi amîocaga na akamîvanda mûgûndarî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kavinda kanini kathira mûmera ûcio nîûkûraga, ûkaneneva, na ûkaruta mvûa nene, na ûkaneneva gûkîra îrîa îngî yonthe îrî mûgûndarî ûcio. Nacio iconi nîciûkaga na igatuma ciomba rungu rwa mvûa ciaguo.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.32",
            "verseOrgIds": [
              "MRK.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.32",
            "verseOrgIds": [
              "MRK.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwavunjîrie kîrîndî na ngerekano ciîngî nyîngî ta ino kûringana na ûrîa mangîavotire kwîgua. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndangîarîrie kîrîndî na njîra îngî tiga ya ngerekano. Nwatî rîrîa ethagîrwa arî vakuvî na arutwa ake onga, nîwamataaragîria maûndû monthe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwavorerie îria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîvwaî Kîam mûthenya wa ûcio, Jesû nîwerire arutwa ake atîrî, “Nîtûringeni mûringo ûrîa wîngî wa îria.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîmaatiganîrie kîrîndî makîthiî magîtwa gatarû karîa Jesû eekarîrîte na makîringa îria marî vamwe. Navo varî na tûtarû twîngî tûrîa maaringanîrie natuo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naruo rûkûngi rûnene nîrwavurutanire nginya ndivû cia manjî ikîambîrîria gûtonyia manjî gatarûrî nako gagîtigaria vanini gwecûra. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vîndî wa îo Jesû aamamîte gatarûrî vuva etirîte kîongo na kamuuto. Nao arutwa ake nîmaamûramûkirie na makîmwîra atîrî, “Uui! Mwarimû! Ndûramaka na nîkwa tûraûrîra îriarî?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû aramûka, nîwakanirie rûkûngi na vinya, na akîra îria atîrî, “Vorera!” Naruo rûkûngi nîrwatigire kûvurutana, narîo îria rîkîvoorera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwacokire akîûria arutwa ake atîrî, “Nîndûî kîramûmakia? Kaî mûtarî na wîtîkio?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmeetigîrire mûno na makîambîrîria kûrania atîrî, “Nîkwa arî ûrîkû ûyû ûrathîkîrwa nî rûkûngi, wana îria?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.41",
            "verseOrgIds": [
              "MRK.4.41"
            ]
          }
        }
      ]
    }
