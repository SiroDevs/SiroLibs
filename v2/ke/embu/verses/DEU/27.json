              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Josh 8.33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mwaringa rûnjî rwa Jorodani andû a mîvîrîga ya Simeoni, Levi, Juda, Isakaru, Josefu, na Benjamini nîo makaarûngama kîrîmarî Kîam Gerizimu nîguo maûrie Ngai arathime andû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû a mîvîrîga ya Reubeni, Gadi, Asheri, Zebuluni, Dani na Nafutali nîo makaarûngama kîrîmarî Kîam Ebali nîguo megue ûrîa Ngai akaaverithia andû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû onthe a mûvîrîga wa Lawi nîmakeera andû onthe a Isiraeli na mûgambo mûnene atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
