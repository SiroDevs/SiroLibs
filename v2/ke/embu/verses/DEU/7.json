                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tito 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue mûrî rûrîrî rûtheru rwa Ngai-Mûnene, Ngai wenyu. Ngai-Mûnene, Ngai wenyu aamûthuurire gatagatîrî ka andû onthe a nthî mûtuîke andû ake kîûmbe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngai-Mûnene ndaamwendire na akîmûthuura nîûndû wa ûrîa mwarî eengî gûkîra andû a mavûrûri marîa mengî, nama mwarî anini mûno gûkîra mavûrûri marîa mengî ma nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî aamûthuurire nîûndû wa kûmwenda na kûvingia mwîvîtwa wake kûrî methe menyu. Kîu nîkîo gîatûmire amûvonokie na vinya wake mûnene na akîmûkûûra kuuma ûkomborî wa mûthamaki wa Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5+EXO.20.6"
              },
              "items": [
                {
                  "text": "Ntha 20.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6+EXO.34.7"
              },
              "items": [
                {
                  "text": "34.6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Nda 14.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9+DEU.5.10"
              },
              "items": [
                {
                  "text": "Gûco 5.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Menyani nama atî Ngai-Mûnene, Ngai wenyu nîke Ngai, na nî mwîvokeku. Ke nîavingagia kîrîkanîro gîake na arî wendo ûtathiraga, kûrî njiarwa ngiri cia andû arîa mamwendete na mavingagia maathani make. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî nîakaaverithia arîa mamûmenete na amacûkangie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo menyagîrîrani mûvingagie na kinyi maathani, mawatho na matuîro ma ciira marîa ngûmwatha ûmûnthî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irathimo irîa ciumanaga na wathîki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
