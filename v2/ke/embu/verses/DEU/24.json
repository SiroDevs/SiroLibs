        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa mûndûmûrûme avikania wa rîo, ndagîrîrwe nî kûthiî mbaararî kana kûruta wîra wa wonthe wa mwîngî. Agîrîrwe nî gwîkara mûciî îvinda rîa mwaka ûmwe agîkenagia mûka ûcio avikîtie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
