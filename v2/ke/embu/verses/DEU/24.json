                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Nda 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ririkanani ûrîa Ngai-Mûnene Ngai wenyu eekire Miriamu rîrîa mwarî rûgendorî mumîte Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
