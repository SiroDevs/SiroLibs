            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Rîrîa wakovithia mûndû ûrîa wîngî kîndû wa kîonthe, ndûkathiî gwake mûciî kûgîra kîndû gîa kûrûngamîrîra kîrîa ûmûkovithîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etagîrîra vau nja na mûndû ûcio ûkovithîtie kîndû agaakûretere kîrîa mwarîkanîre. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûndû ûcio nî mûthîni ndûkamûrarîrie kîrîa mûrîkanîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûcokagîrie kîndû kîu kîvwaî wa kîu nîguo akîmama agagûcokeria ngatho, nake Ngai-Mûnene, Ngai waku agakenagua nîwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
