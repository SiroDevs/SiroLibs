          "items": [
            {
              "text": "\n        Ala 13.1—14.54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Rîrîa mûndû arwara mûrimû mûcûku wa ngothi, nîathiî kûrî mûthînjîri-Ngai Mûlawi na amenyerere eke maûndû monthe marîa mûthînjîri-Ngai akaamwîra wata ûrîa namaathire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
