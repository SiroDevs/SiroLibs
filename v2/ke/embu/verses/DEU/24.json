          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mwaketha thavibu, mûtigacokere irîa ciatigara. Icio nî cia ageni, ciana cia ndigwa na aka a ndigwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
