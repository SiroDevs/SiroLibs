                  "text": "Ala 19.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ndûkaverithie mûndû mûthîni na ngîa ûrîa wandîkîte, arî wa andû enyu Aisiraeli kana arî mûgeni kuuma îtûûrarî rîmwe rîa vûrûri wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marîvageni wa mûthenya wîra ûrîa matinda makîruta mbere ya gûtuka, nîûndû methagîrwa mevokete mbeca icio. Ûngîrega kûmarîva, nwa marîrîre Ngai-Mûnene, naguo ûndû ûcio ûgatuîka wîvia kûrî mue.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
