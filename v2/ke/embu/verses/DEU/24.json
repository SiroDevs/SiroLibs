              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririkanani atî mwarî ngombo vûrûrirî wa Misiri na Ngai-Mûnene Ngai wenyu akîmûkûûra kuo. Kîu nîkîo gîtûmîte nîmwatha mwîke maûndû mama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        }
