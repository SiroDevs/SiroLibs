                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "11.1-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2Maû 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûthamaki ndagîrîrwe nî kwîthîrwa na aka eengî, nîûndû nwa matûme atiganîria Ngai-Mûnene, na ndagîrîrwe nî gwîtongia mûno na sîlûva na thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa agaatuîka mûthamaki, nwanginya akaagîa na îvuku rîa watho wa Ngai rîandîkîtwe kuuma îvukuurî rîa mbere rîa watho rîrîa rîkaraga na athînjîri-Ngai Alawi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akeethagîrwa na îvuku rîîrî vîndî cionthe na arîthomage ûtûûrorî wake wonthe, nîguo amenyage gwîtigîra Ngai-Mûnene Ngai wake, na kwathîkîra na kinyi maathani monthe na irîra irîa ciandîkîtwe wathorî ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
