          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1Sam 8.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mwarîkia kwîgwatîra vûrûri ûrîa Ngai-Mûnene Ngai wenyu akûmûva na mûtûûre kuo, na mwîcirie kûgîa na mûthamaki ta mavûrûri marîa mamûthiûrûrûkîrîtie; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûndû ûcio mûgaatua mûthamaki nwanginya akeethîrwa nîke Ngai-Mûnene Ngai wenyu akaathuura, na nwanginya akeethîrwa arî ûmwe wa andû enyu. Mûtigatue mûgeni mûthamaki wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.28"
              },
              "items": [
                {
                  "text": "1Atha 10.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.16"
              },
              "items": [
                {
                  "text": "2Maû 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.28"
              },
              "items": [
                {
                  "text": "9.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûthamaki ûcio ndakethîrwe na mbarathi nyîngî, na ndagatûme andû Misiri kûgûra mbarathi nîûndû Ngai-Mûnene aaugire atî andû ake matigaacoka Misiri rîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.14+1KI.10.15+1KI.10.16+1KI.10.17+1KI.10.18+1KI.10.19+1KI.10.20+1KI.10.21+1KI.10.22"
              },
              "items": [
