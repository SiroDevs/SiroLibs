    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwaka wa mûgwanja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwakarî wa mûgwanja mûkaarekagîra andû arîa onthe marî na mathiirî menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvango ûcio wa kûrekanîra mathiirî ûkethagîrwa wîkariî û: Mûndû wa wonthe ûkovithîtie mûndû ûrîa wîngî kîndû nwanginya akaamûrekera thirî ûcio, ndagîrîrwe nî gwîtia thirî ûcio. Ngai-Mûnene nîwathanîte thirî ûcio ûrekanîrwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa ûrandûre mûgeni kîrîa ûngîthîrwa ûmûkovithîtie, nwatî ndwagîrîrwe nî kûrandûra andû enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gûtirî mûndû wanarî ûmwe gatagatîrî ka andû enyu ûkethagîrwa arî mûthîni. Ngai-Mûnene nîakaamûrathima mûrî vûrûrirî ûrîa Ngai-Mûnene Ngai wenyu akûmûva mwîgwatîre ûrî îgai rîenyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethîrwa nîmûkûmwathîkîra na mûrûmîrîre na kinyi maûndû marîa ngûmwatha ûmûnthî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene Ngai wenyu nîakaamûrathima wata ûrîa aamwîrîre, na mûgaakombithagia mavûrûri meengî indo cienyu, nwatî mûtigaakova kîndû kuuma kûrî vûrûri wanarî ûmwe. Mûkaathaga mavûrûri meengî, na gûtirî vûrûri ûkaamwatha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
