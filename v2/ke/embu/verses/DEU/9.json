                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Wana nwa mwarakaririe Ngai-Mûnene rîrîa mwarî Tabera, Masa, na Kiburothi Hatava. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
