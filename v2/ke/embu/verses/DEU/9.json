              "items": [
                {
                  "text": "Ahib 3.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na rîrîa Ngai-Mûnene aamûtûmire kuuma Kadeshi-barinea na akîmwîra mûthiî mûkegwatîre vûrûri ûrîa aamûveere, nîmwacokire mûkîregana na maathani ma Ngai-Mûnene Ngai wenyu na mûtiamwîtîkia kana mûmwathîkîra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
