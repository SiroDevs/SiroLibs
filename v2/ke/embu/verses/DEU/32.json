                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Gûco 3.23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûthenya wa ûcio Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Unûkia kîrîmarî Kîam Abarimu vûrûrirî wa Moabu ûrîa ûng'ethanîrîte na îtûûra rîa Jeriko ûkarorie vûrûri wa Kanaani, ûrîa ngûva andû a Isiraeli ûtuîke wao. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûgaacoka ûkuîre kûu kîrîmarî ta Aroni mûrwanyûkwe ûrîa wakuîrîre kîrîmarî Kîam Hori; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîûndû wa muoîrî mûtiarî evokeku kûrî nie mûrî mbere ya andû a Isiraeli rîrîa mwarî manjîrî ma Meriba vakuvî na îtûûra rîa Kadeshi werûrî wa Sini. Mue mûtionania ûtheru wakwa mûrî mbere ya andû a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûkoona vûrûri ûcio wî varaca, nwatî ndûgaatonya vûrûrirî ûcio ngaava andû a Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
