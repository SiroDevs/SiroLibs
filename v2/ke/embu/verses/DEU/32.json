            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa marî na Joshua mûvîcî wa Nuni nîmaainire rwîmbo rûrû ruonthe andû onthe a Isiraeli makîgucaga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mataaro ma mûthiia ma Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 32:44"
          },
          "items": [
