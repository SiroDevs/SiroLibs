              "type": "text"
            }
          ]
        },
        {
          "text": "“Nînaacokire ngîatha Joshua ngîmwîra atîrî, ‘We nîwona maûndû monthe marîa Ngai-Mûnene, Ngai waku eka kûrî athamaki acio aîrî: Sihoni na Ogu, na ûguo nîguo ageeka athamaki acio engî onthe a mavûrûri monthe marîa mûkaavîtûkîrîra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigetigîre athamaki acio, nîûndû Ngai-Mûnene, Ngai wenyu nîakaamûrûîrîra.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngai-Mûnene nîwaregire Musa atonye Kanaani",
          "type": "text"
        }
      ]
    },
