          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwoguo nîtwekarire Kîamndarî kîrîa kîerekanîrîte na îtûûra rîa Bethi-peori.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
