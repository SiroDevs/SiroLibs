              "items": [
                {
                  "text": "Ala 19.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ndûkavande mîmera îngî mûgûndarî ûrîa ûvandîte mîthavibu, nîûndû weka guo, ndûrî mwîtîkîrie gûtûmîra maciaro ma mîmera îo îngî wana ma mîthavibu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
