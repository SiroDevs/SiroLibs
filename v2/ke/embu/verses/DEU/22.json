              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûndû ûcio nîakaaraîria îthe wa mwîrîtu ûcio sîlûva mîrongo îtano, nîûndû aanyitire mwîrîtu ûcio na akîmenyana nake kîîmwîrî na vinya. Mwîrîtu ûcio nîagaatuîka mûka wa mûndû ûcio ûtûrorî wake wonthe.",
          "type": "text",
