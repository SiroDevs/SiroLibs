          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî ethîrwa îthitanga rîu nî rîa ma na gûtirî na ûndû wa kwonania atî ke aarî nthingi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "atongoria a îtûûra nîmagooca mûndûmûka ûcio na mamûvire mûromorî wa nyomba ya îthe na mamûragîre vo na mathiga, nîûndû nîaconorithîtie andû a Isiraeli na njîra ya kwîvecana amenywe kîîmwîrî mbere ya avikue. Ûguo nîguo mûkaathiria wîvia ûcio gatagatîrî kenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
