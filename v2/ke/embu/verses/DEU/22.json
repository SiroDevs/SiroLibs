              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndûmûrûme angîkaanyitwa akîmenyana kîîmwîrî na mûka wa mûndû wîngî, wa oîrî nîmakaaûragwa. Ûguo nîguo mûkaathiria wîvia ûcio gatagatîrî kenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
