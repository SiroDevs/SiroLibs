              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.10+LEV.17.11+LEV.17.12+LEV.17.13+LEV.17.14"
              },
              "items": [
                {
                  "text": "17.10-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.26"
              },
              "items": [
                {
                  "text": "19.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "Gûco 15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî mûtikarîe nthakame. Mîtûrûrageni nthî ta manjî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikarîe gîcunjî gîa îkûmi Kîam ngano, ndivei, maguta, marikithathi ma ndîthia yenyu ya ng'ombe kana ng'ondu, indo irîa mwîranîrîte, matega ma kwîyendera, kana matega mengî ma mûthemba wa wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mue, ciana cienyu, vamwe na ndungata cienyu cia arûme na cia aka, na Alawi arîa matûûraga matûûrarî menyu, mûkaarîcagîra matega mbere ya Ngai-Mûnene Ngai wenyu mûrî varîa Ngai-Mûnene Ngai wenyu akaathuura va kûgoocagîrwa na nî mûgaakenaga mûgîka maûndû monthe mûrî mbere ya Ngai-Mûnene Ngai wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîrîrani mûtigatiganagîrie Alawi mavinda monthe marîa mûgûtûûra vûrûrirî wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa Ngai-Mûnene Ngai wenyu akaanenevia vûrûri wenyu wata ûrîa aamwîrîîre na mwîrirîrie kûrîa nyama, nwa mûrîîre wa varîa vonthe mûngîenda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa vandû varîa Ngai-Mûnene Ngai wenyu akaathuura va kûgoocagîrwa nî varaca na kûrîa mûrî, nwa mûrage nyamû kuuma ndîthiarî yenyu ya ng'ombe kana ng'ondu irîa Ngai-Mûnene amûveete, na mûrîe nyama ciacio mûrî matûûrarî menyu wa rîrîa mûngîenda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe nwa arîe nyama arî mûtheru kana atarî mûtheru, wata ûrîa arîcaga nyama cia nthiia kana cia ngûrûngû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
