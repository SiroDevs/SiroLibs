            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.29"
              },
              "items": [
                {
                  "text": "Ala 19.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Gûtirî Mûisiraeli, mûndûmûrûme kana mûndûmûka ûgatuîka îraa rîa ndini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikanavire nyombarî ya Ngai kîrîa kîonekete kuumana na wîra wa ûmaraa, ûrî wa aka kana ûrî wa arûme, kîrî gîa kûrîva kîrîa wîranîrîte na mwîvîtwa. Ngai-Mûnene Ngai wenyu nîathûrîte ciîko icio wa cioîrî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        }
      ]
    },
