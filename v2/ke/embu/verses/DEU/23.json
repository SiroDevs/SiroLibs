                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Rîrîa werîra Ngai-Mûnene, Ngai waku ûndû na mwîvîtwa, ndûkarege kûûvingia; nîûndû Ngai-Mûnene, Ngai waku nîakenda ûvingie ûndû ûcio, na nî wîvia kûrega kûûvingia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
