                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Akol 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na njîra wata îo, wa namue athuuri îkaranagiani na aka enyu mûkîroragia wagîrîru wao nîûndû matirî vinya ta arûme. Monagieni gîtîîo nîûndû wa nao nîmakaagaîrwa kîveo Kîam mwoyo nî Ngai wa vamwe namue. Îkagani ûguo nîguo vatikagîe na kîndû kîngîvîngîca mavoya menyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûthînua nîûndû wa gwîka ûrîa kwagîrîrîte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthiiarî nîramwîra atî, nwanginya muonthe mûnyitanagîre meciriarî menyu na mûcaanagîre. Endanagani ta ciana cia ng'ina ûmwe na mwîgucanagîre ntha na mwînyivanagîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekwa naaî tigagani kwîrîvîrîria na naaî. Mwarumwa tigagani kwîrîvîrîria na irumi. Vandû va ûguo rathimanagani, nîûndû kîrathimo nîkîo Ngai aamwîrîîre rîrîa aamwîtire. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.12+PSA.34.13+PSA.34.14+PSA.34.15+PSA.34.16"
              },
              "items": [
                {
                  "text": "Tha 34.12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mandîko Matheru maugîte atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nû ûngîmwîka naaî ethîrwa mûrî na kîîo gîa gwîka maûndû maro? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.10"
              },
              "items": [
                {
                  "text": "Mat 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12+ISA.8.13"
              },
              "items": [
                {
                  "text": "Isa 8.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî wana mûngîthînîka nîûndû wa gwîka ûrîa kwagîrîrîte, mûrî arathime. Mûtigetigîre mûndû kana mûtangîke. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî ngororî cienyu vecagani Kristû gîtîîo kîrîa kîmwagîrîrîte ta Mwathani. Vîndî cionthe îthagîrwani mwîvarîrîtie gûcokeria mûndû wa wonthe ûrîa ûngîmûria mûmûtaarîrie ûvoro wîgiî mwîrîgîrîro ûrîa mûrî naguo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî îkagani ûguo mûrî na ûvoreri na gîtîîo. Îthagîrwani mûrî na thamiri ntheru, nîguo andû arîa maragia ûndû mûcûku ûmwîgiî nîûndû nîmûrûmagîrîra Kristû, maconokage. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû nî kava kûthînîka nîûndû wa gwîka waro ethîrwa ûcio nîguo wendi wa Ngai, gûkîra kûthînîka nîûndû wa gwîka naaî. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû aakwire nîûndû wa mevia ma andû onthe rita rîmwe. Aarî mûthingu na nîwakwire îthenya rîa evia, nîguo atûvire kûrî Ngai. Nîwaûragirwe kîîmwîrî, nwatî kîîroho nîwagîre na mwoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na arî na mwoyo ûcio wake wa kîîroho, nîwathiîre kûvunjîria maaroho marîa moovetwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kîam 6.1—7.24",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maaroho mau nî ma andû arîa maaregire kwathîkîra Ngai vîndî îrîa eetererete akirîrîrîtie Nuhu atume thavina. Nî andû anana tu arîa maarî thavinarî maavonokirue na njîra ya manjî. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na manjî mau maringithanagua na ûvatithio ûrîa rîu ûmûvonokagia. Ûvatithio tî wa kûthambia mûndû gîko Kîam mwîrî, nwatî nî kîîranîro kûrî Ngai kiumîte thamirirî mbaro. Ûvatithio ûcio ûmûvonokagia na njîra ya kûriûka gwa Jesû Kristû, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ûrîa waunûkirie îgûrû na rîu ekaraga mwena wa ûrîo wa Ngai. Kûu Jesû nîwathaga araika onthe, wa vamwe na maroho marîa mathanaga na marî vinya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
