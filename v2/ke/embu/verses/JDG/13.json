          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Manoa nîwerire mûraika wa Ngai-Mûnene atîrî, “Twîre rîîtwa rîaku nîguo tûgaagûtîîa rîrîa ciugo ciaku ikaavinga.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
