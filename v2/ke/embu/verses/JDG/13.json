            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.30"
              },
              "items": [
                {
                  "text": "Kîam 32.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nake mûraika wa Ngai-Mûnene nîwaûririe Manoa atîrî, “Ûrenda kûmenya rîîtwa rîakwa nîkî? Rîîtwa rîakwa nî rîa kûgegania.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
