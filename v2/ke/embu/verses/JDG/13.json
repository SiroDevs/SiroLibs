              "JDG.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa nîwacokire akîra mûka atîrî, “Na ma nîtûgûkua nîûndû nîtwonete Ngai.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûka nîwamûcokerie atîrî, “Kethîrwa Ngai-Mûnene nîwendete gûtûûraga, ndangîretîkîrire matega metû na ndangîtwonetie maûndû mama monthe kana atwîra maûndû ta mama.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
