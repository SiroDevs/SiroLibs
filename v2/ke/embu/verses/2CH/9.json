        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû mau mengî marîa mûthamaki Solomoni eekire kuuma Kîammbîrîria nginya mûthiia nîmandîke rûganorî rwa mûrathi Nathani, Ûrathirî wa Ahija wa kuuma Shilo, na cionekirî cia mwoni Ido ûvororî wîgiî Jeroboamu mûvîcî wa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni nîwathanire Isiraeli kuonthe arî Jerusalemu îvinda rîa mîaka mîrongo îna (40). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire agîkua na akîthikwa îtûûrarî rîa îthe, Daudi. Nake mûvîcî Rehoboamu agîtuîka mûthamaki vuva wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
