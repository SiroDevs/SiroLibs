        "style": "s1"
      },
      "items": [
        {
          "text": "Mûndûmûka ûrîa warî mûthamaki wa Sheba nîwathiîre gwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
