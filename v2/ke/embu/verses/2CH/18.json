          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Mikaia aakinyire, mûthamaki nîwamûririe atîrî, “Mikaia, nîtwagîrîrwe nî kûthiî kûtharîkîra îtûûra rîa Ramothi-gileadi kana tûtiagîrîrwe?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
