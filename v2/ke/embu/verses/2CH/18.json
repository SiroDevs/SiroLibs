          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaia nîwarîkîrie na kuga atîrî, “Ngai-Mûnene nîke wîkîrîte roho wa maveeni tûnyuarî twa arathi acio aku. Nwatî Ngai-Mûnene nîwarîtie maûndû macûku makwîgiî!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
