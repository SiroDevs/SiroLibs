          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaia nîwamûcokerie atîrî, “Mûthenya ûrîa ûkaathiî na ûtonye kanyomba ka ndaarî kwîthitha nîrîo ûkaamenya.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
