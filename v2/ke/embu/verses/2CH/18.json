            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrathi Zedekia mûvîcî wa Kenaana nîwacokire akîthiî kûrî Mikaia na akîmûringa rûvî na akîmûria atîrî, “Nî kuuma rî roho wa Ngai-Mûnene aaumire kûrî nie na agîûka kwaria nawe?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        }
