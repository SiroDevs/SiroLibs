          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu, mûthamaki wa Isiraeli nîwathire mûnene wake ûmwe akîmwîra atîrî, “Nyita Mikaia na mûmûcokie kûrî Amoni, mûnene wa îtûûra na kûrî Joashi, mûvîcî wa mûthamaki, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mûmeere mamwikie njeera na avecagwe kamûgate kanini na manjî nginya rîrîa ngaacoka na thayû.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        }
      ]
    },
