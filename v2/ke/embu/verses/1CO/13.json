            "sid": "1CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nwa mbarie nthiomi irîa ciaragua nî andû na irîa ciaragua nî araika. Nwatî ethîrwa ndirî na wendani, mîario yakwa îkariî ta ithaani irîa iringithanagua ikagamba kana ta ngengere îkîgamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
