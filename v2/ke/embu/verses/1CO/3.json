              "1CO.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "1Akor 6.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2Akor 6.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue nîmwicî atî mûrî hekarû ya Ngai na Roho wa Ngai atûûraga ndaarî yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûndû wa wonthe angîcûkangia hekarû ya Ngai, Ngai nîakaamûcûkangia. Hekarû ya Ngai nî ntheru na mue ene nîmue hekarû yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wana ûrîkû ndakeveenie. Ethîrwa nîkûrî na mûndû wana ûmwe gatagatîrî kenyu wîciragia atî ke nî mûûgî arî gûkû nthî îno, nîwagîrîrwe nîgwîtua kîrimû nîguo atuîke mûûgî na ma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
            "verseOrgIds": [
              "1CO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.13"
              },
              "items": [
                {
                  "text": "Ayu 5.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû kîrîa andû a gûkû nthî metaga ûûgî, Ngai agîtaga ûrimû. Kwandîkîtwe mandîkorî matheru atîrî, “Ngai atûmagîra wara wa andû arîa aûgî ûrî ta mûtego wa kûmatega.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.11"
              },
              "items": [
                {
                  "text": "Tha 94.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wana gîcunjîrî kîngî Kîam mandîko matheru nîkwandîkîtwe atîrî, “Mwathani nîaicî atî meciria ma andû arîa aûgî nî ma mana.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûtigetîîe nîûndû wa andû. Maûndû monthe nî menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paûlo, Apolo, na Petero wana nthî îno, mwoyo, gîkuû, maûndû marîa marî kuo rîu na marîa magaaûka, mau monthe nî menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mue mûrî a Kristû, na Kristû nî wa Ngai.",
          "type": "text",
