              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wîra wakwa tî wa gûtuîra arîa marî nja ya kanitha. Nwatî mue mwagîrîrwe nî gûtucagîra andû arîa marî ndaarî ya kanitha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.5"
              },
              "items": [
                {
                  "text": "Gûco 13.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû mandîko matheru maugîte atîrî, “Îngatani andû arîa mekaga naaî maume gatagatîrî kenyu.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.13",
            "verseOrgIds": [
              "1CO.5.13"
            ]
