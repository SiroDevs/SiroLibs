          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrauga maûndû mama nîguo mûgunîke na tîkwa nîrageria kûmûrigîrîria. Nwatî nîrenda mûtûûre na njîra îrîa yagîrîrîte na mwîvecane wîrarî wa Mwathani viû na mûtakûrûmbûyania na maûndû marîa mengî.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        }
