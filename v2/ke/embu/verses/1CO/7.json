          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûvoro wîgiî arîa matavikanîtie, nie ndirî na rîathani kuuma kûrî Mwathani, nwatî nî woni wakwa nîravecana nîûndû nînduîkîte mûndû mwîvokeku nîûndû wa ntha cia Mwathani.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.25",
            "verseOrgIds": [
              "1CO.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
