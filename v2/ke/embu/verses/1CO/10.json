                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Tue nîtwîtîkîrîtue gwîka maûndû monthe,” ûguo nîguo o maugaga. Nwatî tî maûndû monthe maro. “Tue nîtwîtîkîrîtue gwîka maûndû monthe,” nwatî tî maûndû monthe matethagia andû arîa metîkîtie kûgîa na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe gatagatîrî kenyu ndagîrîrwe nî kwîthagîrwa agîcaria ûrîa angîîguna ke mwene, nwatî agîrîrwe nî kwîthîrwa agîcaria ûrîa angîguna andû arîa engî.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
    },
