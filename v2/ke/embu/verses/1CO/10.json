                  "text": "Ala 7.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ta îcirieni ûvoro wîgiî andû a Isiraeli; na kinthî arîa marîcanagîra kîrîa kîrutîtwe kîgongoona matirîcanagîra metharî ya kûrutîra Ngai kîgongoona? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
            "verseOrgIds": [
              "1CO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nîrenda kuga atîa vi? Anga irio irîa irutîrîtwe mîvuanano nî cia vata? Anga mîvuanano nî ya vata? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.19",
            "verseOrgIds": [
              "1CO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.17"
              },
              "items": [
                {
                  "text": "Gûco 32.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naarî! Ûrîa nîrenda kuga nî atî andû arîa matetîkîtie marutaga magongoona mao kûrî ndaimono, nwatî tî kûrî Ngai. Na ndirenda mûtuîke a ngwatanîro na ndaimono. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.20",
            "verseOrgIds": [
              "1CO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mue mûtingîvota kûnyuîra gîkomberî Kîam Mwathani na mûcoke mûnyuîre gîkomberî Kîam ndaimono; mûtingîvota kûrîîra metharî ya Mwathani na mûcoke mûrîîre metharî ya ndaimono. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.21",
            "verseOrgIds": [
              "1CO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Gûco 32.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwa tûrenda kûrakaria Mwathani kana nîkwa tûreciria atî tûrî na vinya kûmûkîra?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
