              "1CO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mue nîmwîtîkîrîtue kûrîcaga nyama wa yonthe îrîa îthagîrwa îkîendua thokorî na mûtikaûrie kîûria wanarî kîmwe kiumanîte na thamiri cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû nîkwandîkîtwe mandîkorî matheru atîrî, “Nthî na indo cionthe irîa irî kuo nî cia Mwathani.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
        }
      ]
    },
