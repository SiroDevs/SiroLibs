              "1CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûndû wa wonthe ûreciria atî ke nîarûngamîte ekindîrîtie nîamenyerere ndakagwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magerio marîa mûgeragua namo nwamo andû arîa engî mageragua namo. Ngai nîmwîvokeku na ndangîtîkîra ûgerue makîria ya vinya ûrîa ûrî naguo. Nwatî vîndî îrîa ûragerua ke agaakûvecaga vinya nîguo ûvotage kûmîrîria na kûûrîra magerio.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo arata akwa arîa nie mendete tiganani na ûvoro wîgiî kûvoya mîvuanano. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nîraria takwa nîrarîria andû agima. Kwoguo îîtuîreni mue ene ûrîa nîrenda kuga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
