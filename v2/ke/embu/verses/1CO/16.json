                  "text": "Ciîko 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nîmvangîte kûvîtûkîrîra Makedonia, na kwoguo nîngaaûka kûrî mue narîkia kûvîtûkîrîra kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa kûvoteke ngeekarania namue gwa kavinda, wana kana mbîkaranie namue îvinda rîonthe rîa mvevo. Namue nîmûkaandethereria nîguo ngaavota kûthiî na mbere na rûgendo rwakwa rwa kûrîa kuonthe ngaathiî. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikwenda kûmwona rîu mvîtûkîte, nîûndû nîrevoka gûgeekarania namue kavinda karaca, ethîrwa Mwathani nîagaatwîtîkîria.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
