              "items": [
                {
                  "text": "Ciîko 19.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmbîkara gûkû Efeso nginya mûthenya wa Pentekosto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû gûkû kûrî na kanya ga kûruta wîra mûnene na mwaro wana ethîrwa kûrî na andû eengî mararegana nanie.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
