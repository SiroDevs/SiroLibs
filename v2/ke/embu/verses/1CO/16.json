              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.16"
              },
              "items": [
                {
                  "text": "1Akor 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mue ariû na aarî a îthe wetû, nîmwicî ûvoro wîgiî Stefana na andû a mûciî wake. Nîmwicî atî nîo maarî a mbere gwîtîkia îtûûrarî rîa Akaia na atî nîmevecanîte matungatîre andû a Ngai. Nie nîramûthaitha ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwathîkagîre andû ta acio na mûndû wîngî wa wonthe ûrîa ûrutaga wîra na agatungata vamwe nao.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        }
      ]
