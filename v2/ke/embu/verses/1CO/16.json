                "loc": "ROM.15.25+ROM.15.26"
              },
              "items": [
                {
                  "text": "Aro 15.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîu nîngwandîka ûvoro wîgiî mbeca irîa irutagwa nîûndû wa andû a Ngai arîa marî Judea. Mue îkagani wata ûrîa nerire makanitha ma Galatia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mûthenya wa Jumaviri, wa mûndû nwa nginya aigage mbeca kûringana na ûrîa athûkûmîte. Wa mûndû nîwagîrîrwe nî kwiga mûthithû nîguo gûtikethîrwe kûrî na vata wa kûngania mbeca rîrîa ngaaûka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narîkia gûka nîngaatûma arîa onthe mûkaathuura nîguo mavire iveo cienyu Jerusalemu. Nîngaamatûma marî na maarûa cia kûmamenyithania. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa nîngoona kûrî na wagîrîru wa nanie nthiî, nîtûkaathiîcania vamwe nao.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mîvango ya Paûlo",
          "type": "text"
        }
      ]
    },
    {
