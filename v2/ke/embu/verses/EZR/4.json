          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Aritakiserikise nîwandîkire macokio atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
