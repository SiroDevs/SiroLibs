        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa maarûa îno kuuma kûrî mûthamaki yathomerwe Rehumu, Shimushai ûrîa mwandîki, na arata ao, nîmaathiîre Jerusalemu na îvenya na magîtûmagîra vinya nîmeerire Ayahudi matige gûtuma îtûûra rîa Jerusalemu rîngî.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        }
      ]
    },
    {
