            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa Ahasuerusi aambîrîrie kwathana arî mûthamaki, nthû nîciandîkire maarûa ikîthitanga andû a Juda na a Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
