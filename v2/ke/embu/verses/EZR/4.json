            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû arîa matûûraga vûrûrirî ûcio nîmaageririe gûtûma andû a Juda mathirwa nî vinya na metigîre gûtuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaacokire makîrîva anene a thirikari ya Perisia mbeca nîguo macûkangie mîvango yao. Meekarire magîkaga ûguo îvinda rîonthe rîrîa Cairasi eethîrwe arî mûthamaki wa Perisia nginya îvinda rîa wathani wa Dario.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûregana na gûtumwa rîngî gwa îtûûra rîa Jerusalemu",
          "type": "text"
        }
      ]
    },
