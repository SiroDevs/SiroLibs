            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atongoria a mbarî cia mîvîrîga ya Juda na Benjamini, athînjîri-Ngai na Alawi na andû onthe arîa Ngai aaveere wendi wa kûmûtumîra hekarû nîmeevarîrie kûthiî Jerusalemu kûmûtumîra hekarû rîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû onthe arîa maariganîtie nao nîmaamavere ûtethio wa indo cia sîlûva na thaavu, na indo ciîngî nyîngî, na nyamû irîa irîthagua na indo cia goro, vamwe na indo cia matega cia hekarû.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
