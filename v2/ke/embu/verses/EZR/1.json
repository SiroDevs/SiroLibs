          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ciarî: Mbakûri cia thaavu cia matega 30, mbakûri ciîngî cia matega cia sîlûva 1,000, mbakûri ciîngî 29, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tûvakûri tûnini twa thaavu 30, tûvakûri tûnini twa sîlûva 410, na indo cia mîthemba îngî 1,000.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
