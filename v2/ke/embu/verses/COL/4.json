          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîragîrîriani kûvoya mwîîguîte na mûgîcokagîria Ngai ngatho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa rîonthe mûkûvoya, tûvoyagîreni wa natue, nîguo Ngai atûvecage kanya karo ga kûvunjia ndûmîrîri îgiî nthitho ya Kristû. Kîu nîkîo gîtûmîte njovwe njeera. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvoyagîrani nîguo nîmîanagîrîre na njîra îgûtaûkîra andû waro wata ûrîa mbagîrîrwe nî gwîka.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        }
      ]
    },
