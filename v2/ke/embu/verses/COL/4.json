          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "File 10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmaûka marî na mûrû wa îthe wetû Onesimo, ûrîa twendete na twîvokete na umîte kûu kwenyu. Nîmakûmwîra maûndû monthe marîa marekîka gûkû.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
