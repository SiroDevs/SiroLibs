                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tukiko nîke ûkaamûva ûvoro wonthe ûmbîgiî. Ke nî mûrû wa îthe wetû ûrîa twendete mûno. Ke nî mûtungatîri mwîvokeku na nîtûrutithanagia wîra wa Mwathani nake. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîu nîkîo gîatûma nîmûtûme kûrî mue, nîguo amwîre maûndû marîa tûrona na amûûmîrîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
