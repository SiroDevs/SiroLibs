                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îrani Arikipo atîrî, “Geria wa ûrîa ûngîvota nîguo ûrîkie wîra ûrîa waveerwe ûtungatarî wa Mwathani.”",
          "type": "text",
          "attrs": {
