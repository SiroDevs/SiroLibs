                  "text": "File 23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Epafara ûrîa umîte kûu kwenyu nîwamûkethia. Ke nî ndungata ya Jesû Kristû na nîamûvoyagîra mûno vîndî cionthe, atî mwîkarage mûrî agima na mûtarî na nganja wîtîkiorî wenyu na mûkîathîkagîra wendi wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nwa nduîke mûira wake, atî ke nîmûrutu wîra mûmû nîûndû wenyu na nîûndû wa andû arîa marî Laodikia na Hierapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        },
        {
