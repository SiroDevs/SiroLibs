            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Joshua ûrîa wîtagwa Jusito nîwamûkethia. Aya athatû nîo Ayahudi arîa metîkîtie Kristû, na nîo tûrutithanagia wîra nao nîûndû wa Ûthamaki wa Ngai na nîmandethetie mûno.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
