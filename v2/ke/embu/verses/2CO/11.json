              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa nwa nginya nîtîîe, nîngîtîîa nîûndû wa maûndû marîa monanagia ûrîa nie ndarî na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai na nîke Îthe wa Mwathani Jesû, nîaicî atî nie ndiraveenania. Rîîtwa rîake rîrokumagua tene na tene! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.23+ACT.9.24+ACT.9.25"
              },
              "items": [
                {
                  "text": "Ciîko 9.23-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa naarî Damesiki, mûndû ûrîa wathanaga vandûrî va mûthamaki Areta nîwaigire athigari ivingorî cia îtûûra nîguo manyite. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî andû amwe nîmaanyûrûrûkirie nyume nja nîrî gîkavurî. Andû acio maamvîtûkîrîrie vandû vaarî na mwanya rûthingorî nîguo mvote kûûra ndikanyitwe nîke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
              "2CO.11.33"
            ]
          }
        }
      ]
