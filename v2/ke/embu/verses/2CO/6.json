            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûkîrutithania wîra wetû vamwe na Ngai, nîtûramûthaitha mûtikamûkîre wega wa Ngai mana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
