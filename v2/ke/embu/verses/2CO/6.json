                "loc": "ISA.49.8"
              },
              "items": [
                {
                  "text": "Isa 49.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngai augîte atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
