              "items": [
                {
                  "text": "1Akor 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "6.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hekarû ya Ngai îrî na ngwatanîro îrîkû na ngai cia mîvuanano? Tue tûrî hekarû ya Ngai ûrîa ûtûûraga mwoyo! Wa ta ûrîa Ngai ke mwene augîte atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
