              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kûrî Paûlo mûtûmwa wa Jesû Kristû nî ûndû wa kwenda kwa Ngai, ndûmîtwe ngavunjie ûvoro mwaro wa tene na tene ûrîa ûvecanagwa nî Jesû Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
