          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îîmenyagîrîreni kuuma kûrî ke nîûndû nîwareganire na ndûmîrîri yetû na vinya mûno.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
