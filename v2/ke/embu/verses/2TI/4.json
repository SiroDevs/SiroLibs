            }
          ]
        },
        {
          "text": " Luka nîke tu tûrî nake. Oca Maariko mûke nake nîûndû nîmwagîrîru wa kûndungatagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
