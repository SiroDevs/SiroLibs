              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa naavirirwe cirarî vîndî ya mbere ngeyarîrîrie, gûtirî mûndû warî mbarî yakwa, onthe nîmaandiganîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Mwathani aarî vamwe nanie na nîwamûvere vinya wa kûvecana ûvoro mwaro kûrî andû onthe a ndûrîrî, kwoguo nînarutirwe magegorî ma simba. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.17",
            "verseOrgIds": [
              "2TI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Mwathani nîakûndethûra maûndûrî monthe macûku na amvire Ûthamakirî wa îgûrû amenyererete. Mwathani arokumua tene na tene! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        }
      ]
    },
