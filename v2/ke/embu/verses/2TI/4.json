                  "text": "1Tim 1.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alekisanda mûturi wa cuuma nîwambîkire maûndû meengî macûku. Mwathani nî akaamûrîva kûringana na ciîko ciake. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
