        },
        {
          "text": "na acoke amenyithue wîvia ûcio, nî akaaruta mvarika îtarî na wonje îrî îtega rîa kûtheria wîvia ûcio ekîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
