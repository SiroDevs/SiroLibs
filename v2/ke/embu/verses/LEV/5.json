        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
