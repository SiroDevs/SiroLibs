          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûndû wa wonthe nîevîtîte atî nîagwîka ûndû mwaro kana ûndû mûcûku ta ûrîa andû mekaga matambîte gwîciiria, rîrîa akaamenya ûndû ûcio akeethîrwa arî na mavîtia.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
