              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûndû wa wonthe nwa avutie kîndû wa kîonthe kîrî mûgiro, ta kimba Kîam nyamû ya kîthaka kana ya kûrîthua kana kîgunyû atakûmenya, akeethîrwa arî na mûgiro na arî na mavîtia.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
