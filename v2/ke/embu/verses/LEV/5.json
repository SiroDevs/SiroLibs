              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndû wa wonthe angîvia atakûmenya na njîra ya kûrega kûruta indo nyamûre irîa irutagîrwa Ngai-Mûnene, nî akaarutîra Ngai-Mûnene mwatî ûtarî na wonje kuuma ndîthiarî yake. Naguo wîthîrwe ûrî na thogora ûrîa ûgaatua wa sîlûva kûringana na kîthimi kîrîa gîtîkîrîku Kîam vandû varîa vatheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanginya akaarîva kîrîa ataarîvîte na nwanginya ongerere tûcunjî mîrongo îîrî îgûrû rîa îgana. Nîakaavirîra mûthînjîri-Ngai, nake mûthînjîri-Ngai arute nyamû îo îrî îgongoona rîa kûtheria wîvia wa mûndû ûcio, na mûndû ûcio nîakooverwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ethîrwa mûndû wa wonthe nwa evie atakwenda na njîra ya kuna rîmwe rîa maathani ma Ngai-Mûnene, mûndû ûcio arî na mavîtia na nwanginya akaaverithua. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanginya akaavirîra mûthînjîri-Ngai ndûrûme îtarî na wonje kuuma ndîthiarî yake îrî îtega rîa kûthiria wîvia. Naguo thogora wayo wîthîrwe ûrî mwîgana wa kîthimi kîrîa gîtîkîrîku. Mûthînjîri-Ngai nîakaaruta îgongoona rîa kûthiria wîvia ûrîa mûndû ûcio ekîte atakûmenya, na mûndû ûcio nîakooverwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu nîrîo îtega rîa kûthiria wîvia ûrîa mûndû ûcio evîrîtie Ngai-Mûnene naguo.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
