            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûndû nwa anyite kîndû wa kîonthe kîrî mûgiro kiumanîte na mûndû atakûmenya, wana ethîrwa kîrî ndûî, akeethîrwa arî na mavîtia vîndî îrîa akaamenya ûrîa ekîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
