              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûndû arî mûvîtiu na njîra ya gwîka ûmwe wa mau, nwanginya akaaumbûra wîvia ûrîa ekîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîakaarutîra Ngai-Mûnene îtega rîa kûtheria wîvia ûrîa ekîte, narîo îtega rîu rîkeethîrwa rîrî rîa mwatî kana nthenge. Nake mûthînjîri-Ngai nîakaaruta îgongoona nîûndû wa kûtheria wîvia wa mûndû ûcio na nîakooverwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî ethîrwa mûndû ndangîona ng'ondu kana mbûri, nîakaarutîra Ngai-Mûnene ndutuura igîrî kana macîa maîrî, îmwe îrî îtega rîa kûtheria wîvia, nayo îo îngî îrî îtega rîa kûvîvua. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîakaavirîra mûthînjîri-Ngai iconi icio, nake mûthînjîri-Ngai ambe arute gîconi Kîam mbere nîûndû wa kûtheria wîvia. Nîagaagîtinia ngingo atagûtigithania kîongo na mwîrî ûcio wîngî ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aminjaminje nthakame îmwe yakîo mîenarî ya metha ya kîgongoona. Nayo nthakame îo îngî îtûrûrwe nî mûthînjîri-Ngai vau nthî ya metha ya kîgongoona. Rîu nîrîo îtega rîa kûtheria wîvia ûtarî wa kwîyendera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîagaacoka arute gîconi kîu kîngî rîrî îtega rîa kûvîvua kûringana na ûrîa watho ugîte. Ûguo nîguo mûthînjîri-Ngai akaaruta îtega rîa kûtheria wîvia wa mûndû ûcio na nîakooverwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûndû ndarî na ndutuura igîrî kana macîa maîrî, nîakaaruta kilo îmwe ya mûtu rîrî îtega rîa kûtheria wîvia wake. Ndakaavira vamwe na maguta kana ûbani nîûndû nî îtega rîa kûtheria wîvia nwatî, tî îtega rîa irio cia mûgûnda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîakaavirîra mûthînjîri-Ngai mûtu ûcio nake mûthînjîri-Ngai nîagaatava mûtu ûcio ngundi îmwe kîrî kîririkania atî mûtu wonthe nîûrutîrîtwe Ngai-Mûnene na aûvîvîrie îgûrû rîa metha ya kîgongoona. Rîu nîrîo îtega rîa kûtheria wîvia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo mûthînjîri-Ngai akaaruta îgongoona rîa kûtheria wîvia wa mûndû ûcio na mûndû ûcio nî akoverwa. Mûtu ûcio wîngî nî wa mûthînjîri-Ngai, wata ûrîa gwîkagwa na matega ma irio cia mûgûnda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matega ma kûthiria wîvia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
