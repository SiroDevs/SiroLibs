          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî mûndû ûngîgûrwa rîngî ararî mûnenganîre kûrî Ngai-Mûnene agatuîka wake viû. Mûndû ûcio nwanginya akaaûragwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
