              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mue andû onthe a Isiraeli mûgaatûûra tûnyombarî îvinda rîa mîthenya mûgwanja, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîguo njiarwa cienyu imenye atî Nie Ngai-Mûnene nînie naatûmire andû a Isiraeli matûûre tûnyombarî rîrîa naamarutire vûrûri wa Misiri. Nie nînie Ngai-Mûnene, Ngai wenyu.",
          "type": "text",
