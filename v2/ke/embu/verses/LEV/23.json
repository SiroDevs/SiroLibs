              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûgaakûngûagîra kîrugo gîkî îvinda rîa mîthenya mûgwanja, mwerirî wa mûgwanja wa mwaka. Watho ûyû nîûtûûra ûrûmagîrîrwa nî njiarwa cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
