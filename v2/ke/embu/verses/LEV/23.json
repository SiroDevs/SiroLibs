                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kîrugo gîa tûnyomba gîkambagîrîria mûthenya wa îkûmi na îtano wa mweri wa mûgwanja na gîkathiî na mbere îvinda rîa mîthenya mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa mbere wa mîthenya îo mûgwanja, nîrîo mûkaagomanaga vamwe nîguo mûngooce na mûtikarutage wîra ûrîa mûrutaga wa mûthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaarutaga matega ma kûvîvua wa mûthenya îvinda rîa mîthenya mûgwanja. Mûthenya wa kanana mûcoke mûgomane rîngî vamwe nîguo mûgooce na mûndutîre matega ma kûvîvua. Mûthenya ûcio mûtikarutage wîra ûrîa mûrutaga wa mûthenya.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ino nî irugo cia Ngai-Mûnene irîa mûkaarûmagîrîra na njîra ya kûgomana vamwe nîguo mûmûgooce na mûmûrutîre matega ma irio, matega ma kûvîvua, magongoona, na matega ma ndivei, wa mûthenya wa mûthenya ta ûrîa Ngai-Mûnene augîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino nî irugo ciîngî kwongerera kîrîa Kîam thavatû, namo mama nî matega mengî kwongerera iveo irîa mûrutagîra Ngai-Mûnene, matega marîa mûrutaga nîûndû wa kûvingia mîvîtwa, na matega marîa mûrutaga na njîra ya kwîyendera.)",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaambîrîria gûkûngûîra kîrugo gîkî mûthenya wa îkûmi na îtano mweri wa mûgwanja mwarîkia gûketha irio. Mûgaakûngûîra kîrugo gîkî îvinda rîa mîthenya mûgwanja, nwatî mûthenya wa mbere na wa kanana nî mîthenya ya kûvurûka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa mbere, nîmûgooca matunda marîa maro mûno kuuma mîtîrî yenyu ya matunda, mvûa cia mîtî ya mîkîndû, mvûa cia mîtî îrîa îrî mathangû meengî, na cia tûmîtî tûrîa tûrî maûa tûmeraga tûrûnjîrî na mûgaakumia Ngai-Mûnene, Ngai wenyu îvinda rîa mîthenya mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
