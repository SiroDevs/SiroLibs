                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Gûco 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûrî na mîthenya îtandatû îrîa mûkaarutaga wîra, nwatî mûthenya wa mûgwanja, mûthenya wa thavatû, nî mûthenya wa kûvurûka. Mûtiagîrîrwe nî kûruta wîra mûthenya ûcio, nwatî mûgomanage vamwe nîûndû wa kûgooca. Thavatû nî yakwa, na mûkaamîmenyagîrîra mûrî wa kûrîa mûkethagîrwa mûrî. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûngûagîrani irugo ino irûmîrîrîte cia Ngai-Mûnene vîndî yacio yakinya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kîrugo kîa pasaka na mîgate îtarî mîkîre ndawa ya kwimbia",
          "type": "text"
        }
      ]
    },
