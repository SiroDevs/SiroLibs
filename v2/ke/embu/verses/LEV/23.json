            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Gûco 16.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûthenya wa îkûmi na îtano nîguo mûthenya wa pasaka ya Ngai-Mûnene. Mûtiagîrîrwe nî kûrîa mîgate îrî na ndawa ya kwimbia îvinda rîa mîthenya mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa mbere wa gûkûngûîra pasaka, nîmûkaagomana vamwe nîûndû wa kûgooca na mûtikarutage wîra ûrîa mûrutaga wa mûthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaandutagîra matega ma kûvîvua îvinda rîa mîthenya mûgwanja. Mûthenya wa mûgwanja nîguo mûkaagomanaga vamwe nîûndû wa kûgooca, nwatî mûtikarutage wîra mûthenya ûcio.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
    {
