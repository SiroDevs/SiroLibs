              },
              "items": [
                {
                  "text": "Gûco 16.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Pasaka ya Ngai-Mûnene yambagîrîria gûkûngûîrwa kîvwaî Kîam mûthenya wa îkûmi na îna mweri wa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
