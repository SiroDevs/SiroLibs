                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.26",
            "verseOrgIds": [
              "LEV.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûthenya wa îkûmi mwerirî wa mûgwanja wa mwaka wa mwaka nîrîo mambura ma kûtheria mevia ma andû a Isiraeli makaarûthagwa. Mûkenyerekagia mûthenya ûcio, na mûkagomana vamwe mûgooce na mûndutîre Nie, Ngai-Mûnene îtega rîa kûvîvua. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.27",
            "verseOrgIds": [
              "LEV.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikarute wîra mûthenya ûcio, nîûndû nî mûthenya wa mambura ma kûtheria mevia menyu Ngai-Mûnene, Ngai wenyu akîonaga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.28",
            "verseOrgIds": [
              "LEV.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe ûtakeenyerekia mûthenya ûcio nîakaamûranua na andû a Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.29",
            "verseOrgIds": [
              "LEV.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûndû wa wonthe ûkaaruta wîra mûthenya ûcio, Nie, Ngai-Mûnene nîngaatûma akue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.30",
            "verseOrgIds": [
              "LEV.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî wîra mwîtîkîrie kûrutwa mûthenya ûcio. Watho ûyû nîûtûûra ûrûmagîrîrwa tene na tene nî njiarwa cienyu cionthe kûrîa kuonthe mûtûûraga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.31",
            "verseOrgIds": [
              "LEV.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaamenyerera thavatû na mwînyerekagie kuuma kîvwaî Kîam mûthenya wa kenda nginya kîvwaî Kîam mûthenya wa îkûmi wa mweri wa mweri.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
      ]
    },
