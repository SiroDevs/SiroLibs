                  "text": "Ala 23.26-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Nda 29.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mawatho mama marûmîrîrîte nîmatûûra marûmagîrîrwa nî mue: Mûthenya wa îkûmi mwerirî wa mûgwanja andû a Isiraeli vamwe na ageni arîa matûûranagia nao nwanginya menyerekagie na matikarutage wîra wanarî ûrîkû. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio nîguo wa mambura ma kûtheria mevia mao monthe, nîguo methîrwe marî atheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûcio nî mûthenya mwamûre, ûrîa andû magîrîrwe nî kwînyerekia na matikarute wîra wanarî ûrîkû. Mawatho mama nî matûûra marûmagîrîrwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai Mûnene ûrîa wamûrîtwe nîguo atuîke Mûthînjîri-Ngai Mûnene vuva wa îthe, nîke ûkaarûtha mambura ma kûtheria mevia ekîrîte nguo cia ûthînjîri-Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîakaarûtha mambura ma kûtheria vandû varîa vatheru Mûno, îgema rîa Ngai-Mûnene, metha ya kîgongoona, athînjîri-Ngai, na andû onthe a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawatho mama nîmatûûra marûmagîrîrwa. Mambura mama nwanginya marûthagwe riita rîmwe wa mwaka nî mûthînjîri-Ngai nîûndû wa kûtheria mevia monthe ma andû a Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
