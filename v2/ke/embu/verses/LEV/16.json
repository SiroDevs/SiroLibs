              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Musa nîwekire wata ûrîa Ngai-Mûnene aathanîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
