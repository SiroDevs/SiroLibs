            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.12"
              },
              "items": [
                {
                  "text": "Ahib 9.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Vuva wa ûguo, nîakaaûraga mbûri ya îtega rîa kûtheria mevia ma andû, avire nthakame yayo vandû varîa vatheru Mûno na amîminjaminje îgûrû rîa gîkunîko wana vau mbere ya îthandûkû rîa kîrîkanîro, wata ûrîa eekire na nthakame ya ndegwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo Aroni akaarûtha mambura ma kûtheria vandû varîa vatheru Mûno kuumana na gîko Kîam andû a Isiraeli vamwe na mevia mao monthe. Nwanginya ekage îgema rîa Ngai-Mûnene ûguo, nîûndû rîtûûraga gatagatîrî ka andû arîa matarî atheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma vîndî îrîa Aroni agaatonya vandû varîa vatheru Mûno kûrûtha mambura ma kûtheria nginya rîrîa akaauma, gûtirî mûndû wagîrîrwe nî kwîthîrwa arî îgemarî rîa Ngai-Mûnene vîndî îo. Athiria kûrûtha mambura make ke mwene, ma andû a mûciî wake na ma andû onthe a Isiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nwanginya akaauma na athiî metharî ya kîgongoona ya matega ma kûvîvua na amîtherie. Nwanginya agooca nthakame îmwe ya mbûri na amîvake mîenarî yonthe ya metha ya kîgongoona îrîa yumîrîte ta mvîa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanginya akaaminjaminja nthakame îmwe îgûrû rîa metha ya kîgongoona maita mûgwanja na Kîamra gîake. Ûguo nîguo Aroni akaatheria metha ya kîgongoona kuumana na mevia ma andû a Isiraeli na amîamûre.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbûri îrîa îthengutagia mevia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa Aroni akaathiria kûrûtha mambura ma kûtheria vandû varîa vatheru Mûno, îgema rîa Ngai-Mûnene na metha ya kîgongoona, nîakaavirîra Ngai-Mûnene mbûri îrî mwoyo îrîa îthuurîtwe îrî ya Azazeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni nîakambararia njara ciake cioîrî îgûrû rîa kîongo Kîam mbûri na agwete maûndû monthe macûku ma andû a Isiraeli, mevia mao monthe, na ûremi wao, na amatonyie mbûrirî îo. Mbûri îo nîgaacoka îrekererue îthiî na kûu werûrî nî mûndû ûrîa ûvetwe wîra ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbûri îo nîkaathiî na mevia monthe ma andû a Isiraeli na kûu werûrî kûndû gûtatûûraga andû.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
