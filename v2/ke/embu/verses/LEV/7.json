        },
        {
          "text": " Kûrîa kuonthe mûtûûraga, mûtiagîrîrwe nî kûnyua nthakame wa yonthe îrî ya gîconi kana ya nyamû. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe ûkaauna watho ûyû wanake nîakaamûranua na andû ake.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
