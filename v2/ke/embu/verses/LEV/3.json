            }
          ]
        },
        {
          "text": "Ethîrwa mûndû nîaruta mbûri, nîakaamîvira mbere ya Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
          "name": "verse",
