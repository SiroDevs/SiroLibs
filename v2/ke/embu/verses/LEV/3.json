          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nî akaavîvîria indo icio cionthe îgûrû rîa metha ya kîgongoona irî irio irutîrîtwe Ngai-Mûnene irî îtega rîa kûvîvua rîrî na mûtararûko wa kûmûkenia. Mathunya monthe ma nyamû irîa itegagîrwa Ngai-Mûnene nî ma Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
