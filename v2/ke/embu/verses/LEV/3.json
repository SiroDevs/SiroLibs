          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbigo cioîrî na mathunya marîa mairigicîrîtie, na gacunjî karîa karo mûno ga îtema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
