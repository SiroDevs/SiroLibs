          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûmwe wa athînjîri-Ngai nî akaavîvîria indo icio cionthe îgûrû rîa metha ya kîgongoona irî îtega rîa kûvîvua kûrî Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
