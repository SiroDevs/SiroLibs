          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî akaaigîrîra njara yake kîongorî Kîamyo na amîûragîre mbere ya îgema rîa Ngai-Mûnene. Athînjîri-Ngai nî makaaminjaminja nthakame ya yo mîenarî yonthe ya metha ya kîgongoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
