              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbigo cioîrî na mathunya marîa mairigicîrîtie, na gacunjî karîa karo mûno ga îtema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
            "verseOrgIds": [
              "LEV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
