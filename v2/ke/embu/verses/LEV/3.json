          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû ûcio nîakaarutîra Ngai-Mûnene mathunya monthe marîa marigicîrîtie mara rîrî îtega rîa kûvîvua. Nîagooca vamwe na ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "verse",
