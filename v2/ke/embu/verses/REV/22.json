            }
          ]
        },
        {
          "text": " Nake Jesû arauga atîrî, “Tathikîrîriani, nîmbûka warîu! Nie nîmbûka na iveo ciakwa nîguo mve wa mûndû kûringana na ûrîa ekîte. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
