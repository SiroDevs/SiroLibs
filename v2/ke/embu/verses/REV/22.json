                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.12"
              },
              "items": [
                {
                  "text": "Ezek 47.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rwanyûrûrûkîte rûthiîrîrîte gatagatî ka varavara ya îtûûra rîu rînene. Mîena yoîrî ya rûnjî rûu nîkwamerete mûtî wa matunda ma mwoyo. Mûtî ûcio nîûciaraga matunda maita îkûmi na maîrî wa mwaka, na riita rîmwe wa mweri. Namo mathangû ma mûtî ûcio nîmatumagîrwa nî andû a ndûrîrî cionthe kûvonia mîrimû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Zak 14.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kîndû kîonthe kîrume nî Ngai gîtikeethîrwa îtûûrarî rîu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîtî Kîam Ngai Kîam ûthamaki na Kîam Gatûrûme nîgîkethîrwa îtûûrarî rîu, na ndungata ciake nîikaamûgooca. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmakoona ûthiû wa Ngai, na rîîtwa rîake nî rîkaandîkwa mothiûrî mao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.18"
              },
              "items": [
                {
                  "text": "Dan 7.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûtigacoka kûgîa na ûtukû, na matikethîrwa makîvatara taa kana ûtheri wa riûa, nîûndû Mwathani Ngai nîke ûkethagîrwa arî ûtheri wao. Na nîmakaathana marî athamaki tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûka kwa Jesû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
