              },
              "items": [
                {
                  "text": "Zak 14.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûraika nîwacokire akîmonia rûnjî rwa manjî ma mwoyo. Rûnjî rûu rwaumîte gîtîrî Kîam ûthamaki Kîam Ngai na Kîam Gatûrûme, namo manjî ma ruo maarî matheru na makengaga ta îra. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
