              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû ûrîa ûkwîgua ûndû ûyû nîauge atîrî, “Ûka!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
              "REV.22.17"
            ]
          }
        }
