                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "11.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo nyamû nîyavotithirue kwaria ciugo cia gwîtîîa na cia kûruma Ngai. Nîyacokire îkîvewa ûvoti wa kwathana vandû va mîeri mîrongo îna na îîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.5",
            "verseOrgIds": [
              "REV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû îo nîyambîrîrie kûruma Ngai, rîîtwa rîake, kûrîa atûûraga na arîa onthe matûûraga îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.6",
            "verseOrgIds": [
              "REV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîyaverwe rûtha îrûe na andû a Ngai na îmavoote. Na nîyaverwe wathani wa kwatha mbarî cionthe, mavûrûri, nthiomi na iruka cionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.7",
            "verseOrgIds": [
              "REV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Tha 69.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû onthe arîa matûûraga nthî nîmakaagooca nyamû îo. Nwatî andû arîa marîîtwa mao maandîkirwe îvukuurî rîa mwoyo mbere ya nthî yûmbwa matikaamîgooca. Îvuku rîu nî rîa Gatûrûme karîa kaaûragirwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndû wa wonthe ûrî na matû ma kwîgua, nîathikîrîrie! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Jer 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.11"
              },
              "items": [
                {
                  "text": "43.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndû wa wonthe ûrîa ûtuîrîtwe kwovwa njeera, nwa nginya ovwe. Mûndû wa wonthe ûtuîrîrîtwe kûûragwa na rûviû, nwa nginya aûragwe na rûviû. Ûguo nîkuga andû a Ngai magîrîrwe nî kûmîrîria na kûgîa na wîtîkio.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînacokire ngîona nyamû îngî yaumire nthî. Nyamû îo yarî na mvîa igîrî ta kagondu na yaragia ta njûnamatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.11",
            "verseOrgIds": [
              "REV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû îo nîyavûthagîra wathani wonthe ûrîa waumaga kûrî nyamû îo ya mbere. Yekaga ûguo methorî ma nyamû îo ya mbere. Nîyatûmaga nthî na arîa matûûraga kuo magooce nyamû îo ya mbere, îrîa kîronda Kîamyo Kîamrî kîvonu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.12",
            "verseOrgIds": [
              "REV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû îo ya kaîrî nîyaringire ciama nene. Nîyatûmire mwaki ûnyûrûrûka kuuma îgûrû gûka nthî andû onthe maroretie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
            "verseOrgIds": [
              "REV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo nîyavenirie andû onthe na njîra ya ciama irîa yaringire îrî mbere ya nyamû îrîa ya mbere. Nyamû îo ya kaîrî nîyathanire andû matume mûviano wa nyamû îrîa ya mbere îrî njîra ya kûmîva gîtîîo. Nyamû îo nî yagurarîtue na rûviû, nwatî yarî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.14",
            "verseOrgIds": [
              "REV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû ya kaîrî nîyetîkîrîtue îveverere mûviano wa nyamû ya mbere mîvevû ya gûtûma ûgîe mwoyo. Yekire ûguo nîguo mûvuanano ûcio warie, na mûndû wa wonthe ûtakaaûgooca aûragwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû îo ya kaîrî nîyatûmire andû onthe anini na anene, itonga na athîni, ngombo na arîa matarî ngombo, mekîrwe rûûri njararî ya ûrîo kana ûthiû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo gûtirî mûndû ûngîagûrire kana endia kîndû atarî na rûûri rûu. Rûûri rûu, rwarî rîîtwa rîa nyamû ya mbere kana namba îrîa yarûngamagîrîra rîîtwa rîayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        }
      ]
    },
