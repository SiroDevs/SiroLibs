                {
                  "text": "Ntha 9.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwoguo mûraika wa mbere nîwathiîre na agîtûrûra kîrîa Kîamrî mbakûrirî yake kûu nthî. Nao andû arîa maarî na rûûri rwa nyamû na arîa magoocete mûviano wayo, nîmaagîre na ironda njûku na ciarî na ûrûrû mîîrîrî yao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûraika wa kaîrî nîwetûrûrire kîrîa Kîamrî mbakûrirî yake îriarî. Manjî magîkara ta nthakame ya mûndû mûkuû. Nacio ciûmbe cionthe irîa ciarî mwoyo kûu îriarî nîciakwire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
