              "items": [
                {
                  "text": "Kûguû 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tathikîrîriani! Nie nîmbûka ta mwîi! Kûrathimwa nî mûndû ûrîa wîkaraga atarî toro, na avarîrîtie nguo ciake, nîguo ndakathiîcage arî njaga na aconoke nî andû!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        }
