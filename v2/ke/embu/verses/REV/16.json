            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngîcoka ngîgua mûgambo mûnene kuuma hekarûrî ûkîra araika acio mûgwanja atîrî, “Thiîni nthî na mwîtûrûre mbakûri cia marakara ma Ngai!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
