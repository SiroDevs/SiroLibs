                "loc": "EXO.10.21"
              },
              "items": [
                {
                  "text": "Ntha 10.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nake mûraika wa gatano nîwetûrûrire kîrîa Kîamrî mbakûrirî yake îgûrû rîa gîtî Kîam ûnene Kîam nyamû îo. Nakuo kûrîa kuonthe nyamû îo yathanaga nîkwagîre nduma, na andû makîîrûma nîmî ciao nîûndû wa ûrûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaarumire Ngai wa îgûrû nîûndû wa ûrûrû ûrîa warî irondarî. Nwatî nîmaaregire kwîrira nîûndû wa maûndû marîa macûku meekîte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
