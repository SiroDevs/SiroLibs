              "REV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûraika wa kana nîwetûrûrire kîrîa Kîamrî mbakûrirî yake riûarî. Narîo riûa nîrîaverwe rûtha rîvîvie andû na ûrugarî warîo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaavîvirue nî ûrugarî wa riûa na makîruma Ngai ûrîa ûrî na wathani îgûrû rîa mavera mama. Nwatî nîmaaregire kwîrira na gûkumia ûnene wake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
