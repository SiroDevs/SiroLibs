              "items": [
                {
                  "text": "Kûguû 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na nîwatûtuire rûrîrî rwa athînjîri-Ngai a gûtungatîra Ngai ûrîa Îthe wake. Riiri na vinya irogîa kûrî Jesû Kristû tene na tene! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
