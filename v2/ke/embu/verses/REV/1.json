            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîa na wega na thayû kuuma kûrî Ngai, ûrîa ûrî kuo, warî kuo, na ûrîa ûgaûka, na kuuma kûrî maroho mûgwanja marîa marî mbere ya gîtî gîake Kîam ûthamaki, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
