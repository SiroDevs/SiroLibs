              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nînie ûrîa ûrî mwoyo! Nie nînaakuîte, nwatî rîu nîrî mwoyo tene na tene. Nie nîrî na ûvoti îgûrû rîa gîkuû na vûrûri wa arîa akuû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
              "REV.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo andîka maûndû marîa ûkwona, maûndû marîa marî kuo rîu na maûndû marîa mageekîka vuvarî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
