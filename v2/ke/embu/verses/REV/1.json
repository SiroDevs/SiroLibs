                {
                  "text": "Tha 89.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wana kuuma kûrî Jesû Kristû, Mûira ûrîa mwîvokeku, ûrîa wa mbere kûriûka na nwake Mwathi wa athamaki a nthî.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
