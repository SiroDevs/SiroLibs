              "items": [
                {
                  "text": "Kûguû 22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwathani Ngai, Mwene vinya wonthe, ûrîa warî kuo, ûrî kuo, na ûrîa ûgaûka arauga atîrî, “Nie nînie wa mbere na wa mûthiia.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
