                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nie Johana nîrandîkîra makanitha marîa mûgwanja marî vûrûrirî wa Îsia:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
