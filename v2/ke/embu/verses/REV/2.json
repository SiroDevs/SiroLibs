              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arîa makaavootana nîngaametîkîria marîe matunda ma mûtî wa mwoyo ûrîa ûrî mûgûndarî wa Ngai.",
          "type": "text",
