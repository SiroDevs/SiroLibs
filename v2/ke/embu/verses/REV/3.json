              "type": "text"
            }
          ]
        },
        {
          "text": "“Andîka kûrî mûraika wa kanitha ûrîa ûrî Saridi atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.1",
            "verseOrgIds": [
              "REV.3.1"
            ]
          }
        }
