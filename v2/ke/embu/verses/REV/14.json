              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ûrîa wekarîrîte îtu nîwaikirie kaviû ga gûketha nthî. Namo maketha ma nthî nîmaakethirwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
