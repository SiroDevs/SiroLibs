          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava varenda ûmîrîru wa andû a Ngai arîa mavingagia maathani make na mevokete Jesû.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        }
