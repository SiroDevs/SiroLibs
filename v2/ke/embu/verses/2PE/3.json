                  "text": "Tha 90.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nwatî arata akwa ende, mûtikariganîrwe nî ûndû ûyû ûmwe! Varî Mwathani mûthenya ûmwe nî ta mîaka ngiri îmwe, na mîaka ngiri îmwe nî ta mûthenya ûmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwathani ndavingagia ciîranîro ciake arî na ûtururu ta ûrîa andû amwe meciragia. Vandû va ûguo nîamûkiragîrîria nîûndû gûtirî mûndû wana ûmwe endaga akaaûra, nwatî endaga andû onthe merire mevia mao.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.9",
            "verseOrgIds": [
              "2PE.3.9"
            ]
          }
        }
      ]
    },
