        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mue arata akwa ende nîmûrîkîtie kûmenya ûguo. Kwoguo îîmenyagîrîreni mûtikaume wîtîkiorî ûcio wenyu ûrîa mwîkindîrîtie nîûndû wa kûvîtithua nî andû arîa mareganaga na watho. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.17",
            "verseOrgIds": [
              "2PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî thiîni na mbere gûkûra mûrî na wega na ûûgî wa Mwathani na Mûvonokia wetû Jesû Kristû. Ke arokumua rîu nginya tene na tene! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.18",
            "verseOrgIds": [
              "2PE.3.18"
            ]
          }
        }
      ]
    }
