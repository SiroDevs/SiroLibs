            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.28+LUK.9.29+LUK.9.30+LUK.9.31+LUK.9.32+LUK.9.33+LUK.9.34+LUK.9.35"
              },
              "items": [
                {
                  "text": "Luka 9.28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Twarî vo rîrîa aaveerwe gîtîîo na riiri nî Ngai Vava rîrîa mûgambo waumire kûrî ûrîa ûrî Riiri Mûnene ûkiuga atîrî, “Ûyû nîke Mûriû wakwa ûrîa mendete mûno, nîrî mûkenie mûno nîke.” ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîtwegwire mûgambo ûcio kuuma îgûrû nîûndû twarî nake kîrîmarî kîrîa kîtheru.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tûrî na ûma makîrîa wa ndûmîrîri îrîa yanîrîrwe nî arathi. Nîmwagîrîrwe nî kûthikîrîria ndûmîrîri îo, nîûndû yo îkariî ta taa yakanîte vandû ndumarî nginya gûkîe, na ûtheri wa njata ya kîraûko ûgakengaga ngororî cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgûrû rîa maûndû monthe, ririkanagani atî gûtirî mûndû ûngîvota gûtaûra ûrathi ûrîa ûrî Mandîkorî Matheru na ûvoti wake mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû gûtirî ûrathi wanaumana na wendi wa mûndû, nwatî andû managîrîra ndûmîrîri kuuma kûrî Ngai matongoretue nî Roho Mûtheru.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
