            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî mûndû nwa aremwe nî kûvingia atakwenda mawatho monthe marîa naveere Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana vuvarî andû onthe maremwe nî kûvingia mawatho marîa naveecanire na njîra ya Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa andû onthe maaregire kûvingia mawatho mau matakûmenya, makaarutaga ndegwa îmwe îrî îtega rîa kûvîvua nîguo mûtararûko warîo ûkenie Ngai-Mûnene. Makaarutanagîria na îtega rîa irio cia mûgûnda, na îtega rîa indo cia kûnyuwa, na marute nthenge îmwe rîrî îtega rîa kûtheria mevia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaarûtha mambura ma kûtheria andû onthe a Isiraeli, na nîmakooverwa nîûndû meevirie matakûmenya, na nîarutu îtega rîa kûvîvua na îtega rîa kûtheria mevia kûrî Ngai-Mûnene nîûndû wa mevia mao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû onthe a Isiraeli wana ageni arîa matûûranagia nao nîmakooverwa mevia, nîûndû onthe meekire mevia mau matakwenda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        }
      ]
    },
