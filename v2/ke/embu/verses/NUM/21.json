          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo andû a Isiraeli nîmaatûûrire vûrûrirî wa Amori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Musa agîtûma andû makathigane îtûûra rîa Jazeri. Andû a Isiraeli nîmaarînyitire wa vamwe na icagi irîa ciariganîtie na îtûûra rîu, na makîngata Amori arîa maatûûraga kuo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        }
