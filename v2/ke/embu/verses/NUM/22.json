            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîraûko Kîam mûthenya ûcio wîngî Balaki nîwocire Balaamu na akîmûvira nginya Bamothibaali. Marî kûu Balaamu nîwonaga andû amwe a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
