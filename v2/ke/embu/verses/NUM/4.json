          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawîra mau nîmo makaarutagwa nî andû a mûvîrîga wa Merari îgemarî rîa Ngai-Mûnene. Nao magaatongoragua nî Ithamaru mûvîcî wa mûthînjîri-Ngai Aroni.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
      ]
