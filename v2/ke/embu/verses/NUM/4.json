          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa na Aroni atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndûgetîkîrie andû a mbarî ya Kohathu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "makinya vakuvî na indo irîa nyamûre, nîguo matigaakue. Nîguo ûndû ûcio ndûgekîke, Aroni na ciana ciake nîmakaagaîra wa mûndû wîra na eere mûndû kîrîa agûkuua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî andû a mûvîrîga wa Kohathu mangîgaatonya îgemarî rîa gûcemanîrua na mone mûthînjîri-Ngai akîvarîrîria indo irîa nyamûre nîmagaakua.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawîra ma Alawi a mûvîrîga wa Gerishoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
