            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a mbarî ya Gerishoni nîmagaatungata na makuue, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbathia ya mûromo wa îthandûkû rîa kîrîkanîro, îgema rîa Ngai-Mûnene vamwe na gîtambaa kîrîa kîrîkunîkagîra na rûûo rwa mbûri rûrîa rûkunîkaga îgûrû rîa kîo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
