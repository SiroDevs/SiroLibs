              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngai-Mûnene nîwerire Musa atare Alawi a mbarî ya Merari, kûringana na mîciî yao na nyomba ciao; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
