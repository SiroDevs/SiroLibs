          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tara Alawi a mbarî ya Gerishoni wa andû kûringana na nyomba yao na mûciî wao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûthuure arûme arîa marî na ûkûrû wa gatagatî ka mîaka mîrongo îthatû na mîaka mîrongo îtano, arîa mangîruta wîra îgemarî rîa Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
