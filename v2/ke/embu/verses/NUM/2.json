          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Andû a Dani nîo makaathiî marî a mûthiia.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.31",
            "verseOrgIds": [
              "NUM.2.31"
            ]
