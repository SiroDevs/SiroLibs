          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî wata ûrîa Ngai-Mûnene aathîte Musa, Alawi matiataranîrua na andû a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
