          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû onthe a Isiraeli arîa maandîkirwe wa andû kûringana na mûvîrîga wao, gîkundi wa gîkundi maarî ngiri magana matandatû ma ithano na magana matano ma mîrongo îtano (605,550). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.32",
            "verseOrgIds": [
              "NUM.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
