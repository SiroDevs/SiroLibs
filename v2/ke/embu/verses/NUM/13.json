          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaleki matûûraga Negebu. Nao Ahiti, Ajebusi, na Amori matûûraga vûrûri ûrîa ûrî irîma. Nao Akanaani matûûraga vakuvî na îria rîa Mediterania na ndeererî cia rûnjî rwa Jorodani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
