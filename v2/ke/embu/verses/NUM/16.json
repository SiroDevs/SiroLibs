        "style": "s1"
      },
      "items": [
        {
          "text": "Kora, Dathani, Abiramu nîmaareganire na Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
