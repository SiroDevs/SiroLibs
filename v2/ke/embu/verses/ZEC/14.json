                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Kûguû 22.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vîndî îo yakinya, manjî maro nîmakaanyûrûrûka maumîte Jerusalemu. Nuthu îmwe ya manjî mau îkaanyûrûrûkaga îthiîte îriarî rîa mwena wa îrathîro, nayo nuthu îo îngî îkaanyûrûrûkaga îthiîte îriarî rîa mwena wa îthûîro. Manjî mau makaanyûrûrûkaga vîndî cionthe, vîndî ya riûa na vîndî ya mvevo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene akethîrwa arî mûthamaki wa nthî yonthe, na nîke ûkethîrwa arî Ngai-Mûnene wenga na rîîtwa rîake rîkethîrwa rîrî rîo rîîtwa rîonga.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
