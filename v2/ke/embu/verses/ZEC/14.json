        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kavinda kau gakinya gûtikethîrwa kûrî na mvevo kana mbaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûkethagîrwa vîndî cionthe kûrî na ûtheri ta wa mûthenya (vîndî îo nî Ngai-Mûnene wenga wicî). Gûtikethîrwa na ûtukû kana mûthenya, nîûndû wana ûtukû gûkethagîrwa na ûtheri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        }
      ]
    },
    {
