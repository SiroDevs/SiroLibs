            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îo Ngai-Mûnene nîagaatûma andû magwatwe nî guoya mûnene mûno. Wa mûndû nîakaanyita mûndû ûrîa wîngî njara na marûe o ene. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda wana yo nîîkarûa na Jerusalemu. Na ûtonga mwîngî wa ndûrîrî cionthe irîa ithiûrûrûkîrîtie Jerusalemu wa thaavu, sîlûva, na nguo nîûkaaûnganua.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        }
      ]
    },
