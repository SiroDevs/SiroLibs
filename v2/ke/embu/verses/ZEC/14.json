          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrimû mûcûku ta ûrîa wagwatire andû nîûkaagwata mbarathi, nyûmbû, ngamîîra, mvunda na nyamû ciao cionthe irîa ikethîrwa irî kûrîa nthû ciao ciambîte magema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
