          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
