            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwacokire akîvikia Ahinoamu ûrîa waumîte Jezireeli. Nao oîrî nîmaatuîkire aka ake. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
