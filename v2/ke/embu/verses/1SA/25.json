          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.14+2SA.3.15+2SA.3.16"
              },
              "items": [
                {
                  "text": "2Sam 3.14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vîndî wa îo, Saûlo nîwavecanîte mwarî Mikali ûrîa warî mûka wa Daudi, kûrî Paliti mûvîcî wa Laishi ûrîa waumîte îtûûrarî rîa Galimu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
