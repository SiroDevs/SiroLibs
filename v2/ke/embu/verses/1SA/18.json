          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîwakîrîrîrie gwîtigîra Daudi na agîtûûra arî nthû yake ûtûûrorî wake wonthe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
