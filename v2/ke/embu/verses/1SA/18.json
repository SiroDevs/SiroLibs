              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Saûlo aamenyire waro atî Ngai-Mûnene aarî vamwe na Daudi na atî andû onthe a Isiraeli nîmaamwendete, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
