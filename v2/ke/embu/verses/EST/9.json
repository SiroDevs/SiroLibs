          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mekarage marî evokeku na makûngûagîre kîrugo Kîam Purimu mavinda marîa magîrîrîte, wata ûrîa mamûkîrîte mawatho megiî kwînyerekia na ma macakaya, o wana njiarwa ciao. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
