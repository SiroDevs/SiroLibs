          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawatho ma Purimu maavecanirwe nî Moridekai na makîandîkwa îvukuurî rîa gîkûnjo.",
          "type": "text",
