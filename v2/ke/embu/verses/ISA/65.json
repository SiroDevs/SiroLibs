                  "text": "Aro 10.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ngai-Mûnene arauga atîrî, “Nethagîrwa nîîvarîrîtie gûcokia mavoya ma andû akwa, nwatî matiamvoya. Nethagîrwa nîîvarîrîtie kwonwa nî arîa mataanjaragia, nwatî wana matiageria kûnjaria. Nie nerire rûrîrî rûrîa rûtamvoyaga atî: ‘Nîrî ava! Nîrî ava.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.1",
            "verseOrgIds": [
              "ISA.65.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.21"
              },
              "items": [
                {
                  "text": "Aro 10.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Natambûrûkagîria andû acio aremi njara ciakwa mûthenya mûgima, acio mathiîcaga na njîra itarî nûngîrîru, na marûmagîrîra mîvango yao o ene. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.2",
            "verseOrgIds": [
              "ISA.65.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû aya mekaraga makîndakaragia vîndî cionthe. Marutagîra mîvuanano yao magongoona tûmîtitûrî tûrîa twamûre, na makavîvagîria ûbani îgûrû rîa metha cia magongoona irîa itumîtwe na matuvarî. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.3",
            "verseOrgIds": [
              "ISA.65.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mekaraga mbîîrîrarî na makararaga methithîte. Marîcaga nyama cia ngûrwe na makanyunyaga mûthûri wa nyama irîa irî mûgiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.4",
            "verseOrgIds": [
              "ISA.65.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meraga andû arîa engî atîrî, ‘Mûtigatûkuvîvîrie; tue tûrî atheru kûmûkîra, mûtigatûvutie!’ Andû ta acio ndingîmakirîrîria, marakara makwa kûrî o mekariî ta mwaki ûrîa ûtavoraga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.5",
            "verseOrgIds": [
              "ISA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.5",
            "verseOrgIds": [
              "ISA.65.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nînduîte kûmaverithia na ngandîka, na ndingîkirîrîria rîngî, nwatî nduîte kûmaverithia ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.6",
            "verseOrgIds": [
              "ISA.65.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîûndû wa mevia mao na nîmaverithîrie mevia ma methe mao. Nîûndû nîmaavîvagîria ûbani îgûrû rîa irîma, na makanumaga marî îgûrû rîa tûrîma. Kwoguo nîmaverithia viû nîûndû wa maûndû marîa meekire tene.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.7",
            "verseOrgIds": [
              "ISA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.7",
            "verseOrgIds": [
              "ISA.65.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî, “Andû moona thavibu inyitanîte vamwe irî mbaro meranaga atî: ‘Tûtikaithûkie, nîûndû nwa ciume ndivei.’ Ûguo nîguo ngeeka nîûndû wa ndungata ciakwa, na ndikaamathiria onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.8",
            "verseOrgIds": [
              "ISA.65.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngaatûma kûgîe na njiarwa kuuma kûrî Jakovu, na ndûme Juda kuume andû arîa makaagaa vûrûri wakwa ûrîa ûrî irîma. Andû arîa nthuurîte nîo makaaûgaa, nao arîa mandungatagîra nîo magaatûûra kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
              "ISA.65.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.24+JOS.7.25+JOS.7.26"
              },
              "items": [
                {
                  "text": "Josh 7.24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ciandarî cia Sharoni igaatuîka cia kûrîthagua ng'ondu, nacio Ciandarî cia Akori ituîke kûndû gwa kûnogokagwa nî ng'ombe cia andû akwa arîa maanjaragia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî mue arîa mwandiganîrie nie Ngai-Mûnene, arîa mwariganîrwe nî Zayuni, kîrîma kîrîa gîakwa Kîammûre, mue arîa mûgoocaga ngai irîa ciîtagwa Gadi na Meni, ngai cia mûnyaka na mûtino; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.11",
            "verseOrgIds": [
              "ISA.65.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûthiiarî ngaatûma mûragwe na rûviû. Ngaamûragithia muonthe, nîûndû rîrîa netanire mûtiambîtîka, rîrîa naririe mûtianthikîrîria. Nwatî mwekire maûndû macûku na mûkîthuura maûndû marîa mataangenagia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.12",
            "verseOrgIds": [
              "ISA.65.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo, nie Mwathani Ngai-Mûnene nauga atî: Ndungata ciakwa ikethagîrwa na gîa kûrîa, nwatî mue mûkethagîrwa mûrî na yûra; ndungata ciakwa ikethagîrwa irî na gîa kûnyua, nwatî mue mûkethagîrwa mûrî na nyonda; ndungata ciakwa igeekaraga irî na gîkeno, nwatî mue mûgeekaraga mûrî na gîconoko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.13",
            "verseOrgIds": [
              "ISA.65.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 65:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndungata ciakwa ikaainaga irî na gîkeno ngororî, nwatî mue mûkaarîraga mûrî na ruuo ngororî, mûkiugagîrîria nîûndû wa ruuo rwa ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.14",
            "verseOrgIds": [
              "ISA.65.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 65:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû akwa arîa nthuurîte magaatûmagîra rîîtwa rîenyu rîrîa makwenda mûnyitwe nî kîrumi. Makaaugaga atî: ‘Nie Mwathani Ngai-Mûnene nîngûmûraga.’ Nwatî nîngaava ndungata ciakwa rîîtwa rîcerû. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.15",
            "verseOrgIds": [
              "ISA.65.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 65:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo, mûndû wa wonthe vûrûrirî wenyu ûrîa ûkenda kûrathimwa, akaathiîcaga kûrathimwa nî Ngai ûrîa wa ma. Nake mûndû wa wonthe ûkevîtaga, akevîtaga akîgwetaga rîîtwa rîa Ngai ûrîa wa ma; nîûndû mathîna marîa makûrû nîmakaariganîra na ndikamaririkana rîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.16",
            "verseOrgIds": [
              "ISA.65.16"
            ]
          }
        }
      ]
    },
