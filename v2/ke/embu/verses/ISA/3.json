          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene augîte atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio Mwathani nîagaacuna aka a Jerusalemu indo irîa megemagia nacio: njang'iri, indo cia kûgemia ciongo, mîkathî, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
              "ISA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mindo cia matû, macango na itambaa cia ngingo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "itambaa cia ciongo, mîcivi, mvang'iri, mîcivi, tûthandûkû twa mînyamû manungi waro, na ithitû; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbete, icûvî cia maniûrûrî; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nguo irîa mbaro mûno, nguo cia ndaarî, nguo cia gwîkîra îgûrû rîa irîa ciîngî, mîvuko yao ya njara; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nguo ciao cia kwîyonania nacio, nguo irîa mbaro, iremba na itambaa cia gwîkunîka ûthiû.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.23",
            "verseOrgIds": [
              "ISA.3.23"
            ]
          }
        }
      ]
