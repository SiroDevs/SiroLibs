            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.15",
            "verseOrgIds": [
              "ISA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
