          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îno nîyo ndûmîrîri ya Ngai îgiî nyamû cia Negebu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
