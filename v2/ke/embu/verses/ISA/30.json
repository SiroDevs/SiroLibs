          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo, Ûrîa Mûtheru wa Isiraeli arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.12",
            "verseOrgIds": [
              "ISA.30.12"
            ]
          }
        }
      ]
    },
    {
