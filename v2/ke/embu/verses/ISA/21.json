            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.1",
              "type": "text"
            },
            {
              "text": "Babuloni:",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe maugaga, ‘werû ûrîa ûrî rûtere rwa îria.’",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
