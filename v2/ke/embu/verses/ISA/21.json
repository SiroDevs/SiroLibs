              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îno nîyo ndûmîrîri îgiî ûrathi wa Babuloni: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        },
        {
