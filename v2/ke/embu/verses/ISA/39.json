        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Hezekia nîwerire Isaia atîrî, “Mîgambo ya Ngai-Mûnene îo wauga nî mîaro.” Mûthamaki aaugire ûguo nîûndû eeciragia atî, nîgûkethîrwa na thayû na ûgitîri vîndî ya ûtûûro wake wonthe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
