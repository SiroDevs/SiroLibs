              "items": [
                {
                  "text": "2Maû 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anake amwe aku, arîa ûciarîte we mwene nîmakaathiîwa nao na matuwe ngaramba nîguo matungatage mûciî kwa mûthamaki wa Babuloni.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
