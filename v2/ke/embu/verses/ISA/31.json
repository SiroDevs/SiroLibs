          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mue andû a Isiraeli, garûrûkîrani ûcio mwaregire na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
