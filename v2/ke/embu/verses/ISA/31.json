              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo Ngai-Mûnene mwene vinya wonthe akaanyûrûrûka kûrûa arî kîrîmarî gîa Zayuni na nîrî karîmarî ga kîo.",
          "type": "text",
          "attrs": {
