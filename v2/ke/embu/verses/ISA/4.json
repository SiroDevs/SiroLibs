                "loc": "EXO.13.21"
              },
              "items": [
                {
                  "text": "Ntha 13.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîagaacoka atûme kûgîe na matu mûthenya îgûrû rîa Kîrîma gîa Zayuni na kûrî andû arîa magomanîte vo, na ndogo vamwe na kîmûrî Kîam mwaki ûtukû. Îgûrû rîa ûguo, riiri wa Ngai nîûgaakunîka na ûgitîre îtûûra rîonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riiri wake nîûgaatuîka kîruru Kîam gûkunîkîra îtûûra mûthenya nîûndû wa ûrugarî wa riûa na kûndû gwa kwîthitha rûkûngi rûnene na mbura.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
