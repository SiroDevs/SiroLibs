          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vîndî îo, Mwathani nîagaakombora kawembe kuuma mûringo wa rûnjî rwa Farati: kawembe kau nî mûthamaki wa Asîria! Nîakenja njuîrî cia ciongo cienyu, njuîrî cia mîîrî yenyu wana nderu cienyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
