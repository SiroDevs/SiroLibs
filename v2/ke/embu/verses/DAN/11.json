            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vîndî îrîa yagîrîrîte yakinya, nî akaathithûkîra Misiri rîngî, nwatî ndakaavootana ta ûrîa aavootanire rita rîa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.29",
            "verseOrgIds": [
              "DAN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû kuuma Kitimu nîmakaamûtharîkîra. Nîakegua guoya na ecûrîtwe nî marakara, nî akaageria gûcûkangia ndini ya andû a Ngai. Nîagaacoka athikagîrîrie mataaro ma andû arîa mareganîte na ndini îo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.30",
            "verseOrgIds": [
              "DAN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.27"
              },
              "items": [
                {
                  "text": "Dan 9.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
                  "text": "12.11",
