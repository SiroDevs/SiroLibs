          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Mûthamaki Nebukadinezarû nîwarûgire na îgûrû amakîte mûno na akîûria atongoria atîrî, “Na kinthî tûtiikirie arûme athatû mwakirî marî ove?” Nao nîmaacokerie Mûthamaki atîrî, “Nîma nîguo mwathi wetû.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
