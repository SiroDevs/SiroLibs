          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwathiîre na mbere na akiuga atîrî, “Nwatî nîrona arûme ana magîceera mwakirî matarî ove na matakûvîa nî mwaki. Mûndû wa kana ekariî ta mûraika.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.25",
              "type": "text"
            },
            {
              "text": "mûraika:",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe maugaga ‘Mûriû wa Ngai.’",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebukadinezarû nîwarekirie arûme acio athatû",
          "type": "text"
        }
      ]
    },
    {
