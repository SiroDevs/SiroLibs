        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.21",
            "verseOrgIds": [
              "ACT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mue Aisiraeli aya, tathikîrîriani ciugo ino! Jesû wa Nazarethi aarî mûndû warî wa mwanya. Wathani wake wa ûngai nîwonanirue waro kûrî mue na njîra ya morirû na ciama irîa Ngai aaringire na njîra yake. Mue ene nîmwîcî ûguo nîûndû ûndû ûcio nîwekîkire gûkû gatagatîrî kenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.22",
            "verseOrgIds": [
              "ACT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
