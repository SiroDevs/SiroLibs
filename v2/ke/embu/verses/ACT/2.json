              },
              "items": [
                {
                  "text": "Luka 24.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî Ngai nîwariûkirie Jesû na akîmwovora ûrûrûrî wa gîkuû, nîûndû gûtingîavotekire atûûre ovetwe nîkîo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Tha 16.8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû Daudi nîwaririe ûvoro ûmwîgiî akiuga atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
