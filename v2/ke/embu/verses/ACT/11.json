              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao arutwa nîmaatwire marute mbeca kûringana na ûvoti wa mûndû wa mûndû nîguo matethie etîkia arîa maatûûraga Judea. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
