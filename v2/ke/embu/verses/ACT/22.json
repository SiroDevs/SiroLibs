    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mue ariû a îthe wetû na aa vava, rîu tanthikîrîriani ngîîtetera nîrî ava mbere yenyu!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
            "verseOrgIds": [
              "ACT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Ayahudi meegwire akîmaarîria na Kîhibirania, nîmaakirire wana makîria ya mbere, na Paûlo akîmeera atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
