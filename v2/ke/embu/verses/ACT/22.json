          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûnene ûcio wa mbûtû ya athigari nîwathiîre kûrî Paûlo na akîmûria atîrî, “Tambîra atîrî, we rî wî Mûûroma?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        }
      ]
    },
    {
