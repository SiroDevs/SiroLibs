              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûnene ûcio wa mbûtû ya athigari nîwaugire atîrî, “Nie nînarîvire mbeca nyîngî mûno nîguo nduîke Mûûroma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
