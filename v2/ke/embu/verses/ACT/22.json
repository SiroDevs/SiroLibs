              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vîndî wa îo andû arîa maarî matuîrie ûvoro wa Paûlo, nîmaathengutire makiuma varîa ke aarî. Nake mûnene ûcio wa mbûtû ya athigari nîwatemûkire mûno vîndî îrîa aamenyire atî Paûlo aarî Mûûroma na atî ke nîwamwovithîtie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paûlo nîwavirirwe kîamarî",
          "type": "text"
        }
      ]
    },
