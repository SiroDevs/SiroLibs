          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Paûlo nîwamûcokerie atîrî, “Ii.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
