        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa andû meegwire Paûlo akîaria ûvoro wîgiî kûriûka, amwe gatagatîrî kao nîmaamûnyûrûririe, nwatî arîa engî makîmwîra atîrî, “Tue nîtûrenda gûkeegua ûkîaria ûvoro wîgiî ûndû ûcio rîngî.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Paûlo nîwaumire mûcemaniorî ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî andû amwe nîmaatuîkire etîkia na makîmûnyita mbaru. Gatagatîrî kao kwarî Dionisio ûrîa warî ûmwe wa athuuri a Kîamma Kîam Areopago na mûka wetagwa Damari wa vamwe na andû engî.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
