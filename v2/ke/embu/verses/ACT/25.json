          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Angiripa nîwerire Fesito atîrî, “Nie mwene nwa mende kûthikîrîria mûndû ûyû.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Fesito nîwamwîrire atîrî, “We nîûkaamwîgua rûyû.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
