          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu nîwendirie mûgûnda wake na mbeca irîa oonire akîivira na akîinenganîra kûrî atûmwa.",
          "type": "text",
