          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma vîndî îo Jesû nîwambîrîrie kwîra arutwa ake atîrî, “Nwa nginya nthiî Jerusalemu na nyamarue nî athuuri, anene a athînjîri-Ngai na arimû a Watho. Nîmakaambûraga, nwatî mûthenya wa kathatû nîngaariûkua.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
      ]
    },
    {
