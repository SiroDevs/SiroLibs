              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwacokirie atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
