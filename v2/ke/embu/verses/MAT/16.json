            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwavûgûkire akîroria Petero na akîmwîra atîrî, “Uma vakuvî na nie, Caitani! We wî mûvînga kûrî nie, nîûndû meciria maku matiumîte kûrî Ngai maumîte kûrî andû.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        }
      ]
