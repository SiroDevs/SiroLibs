              },
              "items": [
                {
                  "text": "Joh 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû mûndû ûrîa wendaga kûvonokia mwoyo wake nîakaaûrwa nîguo. Nwatî mûndû ûrîa ûragwa nî mwoyo wake nîûndû wakwa nîakaawona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî umithio ûrîkû wa mûndû kûgîa na ûtonga wa nthî yonthe nwatî acoke aûrwe nî mwoyo wake? Gûtirî kîndû wana kîmwe mûndû angîkûûranania mwoyo wake nakîo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
