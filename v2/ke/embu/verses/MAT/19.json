              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mwanake ûcio eegwire ûguo, nîwathiîre arî na kîeva kîngî mûno nîûndû aarî mûndû mûtongu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
