              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luka 13.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû akîrîkîrîria nîwaugire atîrî. “Andû arîa marî vuva nîmagaatuîka a mbere nao arîa marî mbere rîu, nîmagaatuîka a vuva.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwaririe riita rîa kathatû ûvoro wîgiî gûkua gwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.16",
            "verseOrgIds": [
              "MAT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jesû aathiîte Jerusalemu, nîwocire arutwa ake; na marî oonga nîwamerire atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tathikîrîriani! Tûthiîte Jerusalemu kûrîa Mûrû wa Mûndû akaanenganîrwa kûrî anene a athînjîri-Ngai na arimû a Watho. Nao nîmakaamûtuîra kûûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmagaacoka mamûvecane kûrî andû a ndûrîrî nîguo mamûnyûrûrie, mamûrive na ivoko na macoke mamwambe mûtharavarî îgûrû. Nwatî mûthenya wa kathatû nîakaariûkua.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îvoya rîa ng'ina wa avîcî a Zebedii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûka wa Zebedii nîwathiîre kûrî Jesû marî vamwe na avîcî ake aîrî. Nîwaturirie maru mbere ya Jesû na akîmûria amwîkîre ûndû.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamûûririe atîrî, “Nî atîa ûkwenda?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûndûmûka ûcio nîwacokirie atîrî, “Athana atî avîcî aya akwa mageekara ûmwe mwena waku wa ûrîo na ûcio wîngî mwena waku wa ûmotho rîrîa ûgaatuîka mûthamaki.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwerire avîcî acio a Zebedii atîrî, “Mue mûtiramenya kîrîa mûravoya. Nîmûkûvota kûnyuîra gîkomberî Kîam mînyamaaro kîrîa nie ngerie kûnyuîra?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaamûcokerie atîrî, “Ii nîtûkûvota.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamerire atîrî, “Nama mue nîmûkûnyuîra gîkomberî gîakwa, nwatî nie ndirî na ûvoti wa gûtua nû ûgeekarîra gîtî mwena wakwa wa ûrîo kana wa ûmotho. Itî icio nî cia arîa Vava avarîrîtie.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa arutwa acio engî îkûmi meeguire ûvoro ûcio, nîmaarakarire mûno nî arutwa acio aîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.25+LUK.22.26"
              },
              "items": [
                {
                  "text": "Luka 22.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî Jesû nîwametire onthe vamwe na akîmeera atîrî, “Mue nîmwicî atî athani a andû a ndûrîrî nîmamavinyagîria. Nao atongoria nîmendaga wathani wao ûmenywe nî andû arîa engî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.11"
              },
              "items": [
                {
                  "text": "Mat 23.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mar 9.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.26"
              },
              "items": [
                {
                  "text": "Luka 22.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûguo tîguo kwagîrîrwe nîkwîthîrwa gwîkariî gatagatîrî kenyu. Mûndû ûrîa ûkwenda gûtuîka mûnene gatagatîrî kenyu, nwanginya atuîke ndungata ya arîa engî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mûndû wa wonthe ûngîenda gûtuîka wa mbere gatagatîrî kenyu, nwa nginya atuîke ngombo yenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû wana nginya Mûrû wa Mûndû ndaaûka gûtungatîrwa nwatî aûkire gûtungata na kûvecana mwoyo ûtuîke îrîvi rîa gûkûûra andû eengî maume meviarî.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwavonirie atumumu aîrî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa Jesû na arutwa ake maaumaga Jeriko, kîrîndî kîîngî nîkîamaumire vuva. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atumumu aîrî arîa meekarîte mûkîra wa njîra nîmeguire atî nî Jesû ûravîtûka. Kwoguo nîmaanîrîre atîrî, “Mûrû wa Daudi twîguîre ntha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakîo kîrîndî nîkîamakanirie na gîkîmeera makire. Nwatî o nîmaugîrîrie mûno atîrî, “Mwathani, Mûrû wa Daudi, Twîguîre ntha!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwarûngamire; akîmeeta na akîmaûria atîrî, “Mûrenda nîmwîkîre atîa?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaamûcokerie atîrî, “Mwathani tue tûrenda tûcoke kwona.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamegwîrîre ntha na akîvutia metho mao, na wa rîmwe atumumu acio nîmaavotire kwona na makîmûrûmîrîra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
