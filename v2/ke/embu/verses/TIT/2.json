                  "text": "1Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ke nîwevecanire nîûndû wetû nîguo atûkûûre kuuma kûrî waganu wa mîthemba yonthe na atûtue andû atheru ake ke mwene, na andû meriragîria gwîka maûndû maro.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
