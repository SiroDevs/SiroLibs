        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.21",
            "verseOrgIds": [
              "HOS.2.21"
            ]
          }
        }
      ]
