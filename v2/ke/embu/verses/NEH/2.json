              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.19"
              },
              "items": [
                {
                  "text": "2Maû 36.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14"
              },
              "items": [
                {
                  "text": "Jer 52.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na ngîra mûthamaki atîrî, “Mûthamaki ûrotûûra tene na tene! Nîrî na kîeva nîûndû îtûûra rîrîa rînene kûrîa methe metû ma tene maathikirwe nîrîomomoku nacio ivingo nî njûkangie nî mwaki.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.3",
            "verseOrgIds": [
              "NEH.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.3",
            "verseOrgIds": [
              "NEH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki nîwambûririe atîrî, “Nîwenda atîa?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînavoire Ngai wa îgûrû, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngîra mûthamaki atîrî, “Ethîrwa mwathi wakwa wî mûkenie nînie na nwa wîguîre ndungata yaku ntha, tiga nthiî vûrûrirî wa Juda nîguo nthiî îtûûrarî rîrîa rînene kûrîa methe metû ma tene mathikîtwe, nîguo ngatume îtûûra rîu rîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.5",
            "verseOrgIds": [
              "NEH.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.5",
            "verseOrgIds": [
              "NEH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki, na mûka wake ekarîte vakuvî nake, nîwambûririe nîrenda kûthiî vandû va kavinda kegana atîa na ngaacoka rî. Kwoguo mûthamaki nîwetîkîre nthiî nanie nînavecanire kavinda karîa ngaacoka.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.6",
            "verseOrgIds": [
              "NEH.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.6",
            "verseOrgIds": [
              "NEH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîra mûthamaki anengere maarûa nîguo îvirîrwe mûnene wa vûrûri ûrîa ûrî mwena wa îthûîro wa Rûnjî rwa Farati. Maarûa icio nî cia kûmera metîkîre mvîtûkîre kûu ngîthiî Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.7",
            "verseOrgIds": [
              "NEH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na anengere maarûa îngî mvirîre Asafu mûmenyereri wa mûtitû wa vûrûri nîguo akaamva mbaû cia gûtuma ivingo cia vandû varîa vagitîre mûno varîa hekarû yarî na cia rûthingo rwa îtûûra rînene. Na acoke anengere mbaû nîûndû wa nyomba îrîa ngeekara. Nake Ngai aarî vamwe nanie kwoguo mûthamaki nîwanengere kîrîa kîonthe netirie.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwatûmire anene a athigari na athigari arîa mathiîcaga matûîte mbarathi nîguo tûthiîcanie nao. Nînathiîre na ngîkinya vûrûri ûrîa ûrî mwena wa îthûîro wa Rûnjî rwa Farati. Nakinya kûu nînaanengere anene a vûrûri ûcio maarûa kuuma kûrî mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîrîa Sanibalati ûrîa warî wa kuuma Horoni, na Tobia mûnene wa vûrûri wa Aamoni megwire atî kûrî na mûndû ûkîte kûruta wîra nîûndû wa wagîrîru wa andû a Isiraeli nîmaarakarire mûno.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînathiîre Jerusalemu na nînekarire kuo mîthenya îthatû. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî mûndû wanarî ûmwe nerire ûrîa Ngai aambîrîte mbîke nîûndû wa Jerusalemu. Ûtukû gatagatî nînaûkîrire na ngiuma nja na ngîthiî ngîta arûme anini arîa twethagîrwa tûrî vamwe nao. Nyamû îrîa twathiîre nayo nwa mvunda îrîa naathiîte mbîkarîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtukû ûcio nîtwaumire îtûûrarî rîu rînene tûvîtûkîrîrîte mwena wa îthûîro kîvingorî kîrîa Kîamrî Kîamndarî. Nîtwathiîrîre kîthimarî Kîam Njûnamatu nginya kîvingorî kîrîa gîatecagwa gîko. Na wa nthiîte nînaroragia nthingo cia Jerusalemu irîa ciamomokangîte na ivingo irîa ciacûkangîtue nî mwaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîthiî Kîvingorî gîa Kîthima Kîam manjî na ngîthiî Kariarî ka Mûthamaki. Nwatî kûu kuonthe gûtiarî vandû vangîvîtûkîrîrwa nî mvunda îrîa nekarîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînathiîrîre Kîamndarî ûtukû ngîroragia ûrîa rûthingo rwekariî. Nînaacokire na njîra wa îrîa naathiîrîrîte na ngîcoka îtûûrarî mvîtûkîrîrîte Kîvingorî gîa Kîandarî.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî mûnene wana ûmwe wa îtûûra wamenyire kûrîa naarî kana ûrîa nekaga. Wana ndierîte Ayahudi etû, athînjîri-Ngai, atongoria, anene kana andû arîa onthe maarî marute wîra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî nînaamerire atîrî, “Taroriani thîna ûrîa tûrî naguo nîûndû Jerusalemu nînyomomoku na ivingo ciakuo nî njûkangie nî mwaki! Tigani tûtume rîngî rûthingo rwa Jerusalemu nîguo tûtige kûnyararûa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.17",
            "verseOrgIds": [
              "NEH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîmeera ûrîa Ngai ethîrîtwe akîndethia na ûrîa mûthamaki aambîrîte. Nao nîmaaugire atîrî, “Tigani twambîrîrie gûtuma rîngî.” Nao nîmeevarîrie kwambîrîria kûruta wîra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.18",
            "verseOrgIds": [
              "NEH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîrîa Sanibalati Mûhoroni, Tobia Mûamoni, na Mûarabu wetagwa Geshemu megwire ûrîa twavangaga gwîka, nîmaatûthekerere na magîtûnyarara makiugaga atîrî, “Mûreciria mûreka atîa? Nîkwa mûrenda kûregana na mûthamaki?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.19",
            "verseOrgIds": [
              "NEH.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
