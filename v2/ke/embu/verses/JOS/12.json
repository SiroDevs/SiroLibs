          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taanaki, Megido, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îtûûra rîa Kedeshi, Jokineamu rîrîa rîrî Karimeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
        },
        {
          "name": "verse",
