          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dori (rûtere rwa îria), Goimu (rîrîa rîrî Galili) ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
        {
