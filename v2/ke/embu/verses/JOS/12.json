          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimironi, Meroni, Akishafu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.20",
            "verseOrgIds": [
              "JOS.12.20"
            ]
