              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Finehasi ûrîa warî mûthînjîri-Ngai na atongoria îkûmi arîa maarî nake na anene a mîvîrîga îrîa yarî mwena wa îthûîro megwire ûrîa andû a mûvîrîga wa Reubeni, Gadi na Manase ya mwena wa îrathîro maaugire nîmaakenire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Finehasi mûvîcî wa Eliazaru mûthînjîri-Ngai nîwamerire atîrî, “Rîu nîtwamenya atî Ngai-Mûnene arî natue. Mûtinaregana nake, kwoguo nîmwavonokia andû a Isiraeli kuuma kûrî îverithia rîake.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi na atongoria arîa maarî nake nîmaatigire andû a mûvîrîga wa Reubeni na Gadi vûrûrirî wa Gileadi. Nîmaacokire Kanaani kûrî andû a Isiraeli na makîmeera ûrîa maûndû monthe meekîkîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a Isiraeli nîmaakenire na magîkumia Ngai nîûndû wa ûguo gwekîkire. Nao matianacoka kwaria ûvoro wîgiî kûrûa na andû a mûvîrîga ya Reubeni na Gadi na gûcûkangia vûrûri ûrîa maatûûraga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a mûvîrîga wa Reubeni na a mûvîrîga wa Gadi nîmaaugire atîrî, “Metha îno ya kîgongoona nî ûira kûrî tue tuonthe atî Ngai-Mûnene nî Ngai.” Nao nîmaamîtuîrîre rîîtwa “Ûira.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
      ]
