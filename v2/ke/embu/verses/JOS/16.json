      },
      "items": [
        {
          "text": "Vûrûri ûrîa wagaîrwe Efiraimu na Manase a mwena wa îthûîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
