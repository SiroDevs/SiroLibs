      },
      "items": [
        {
          "text": "Solomoni nîwaregire kwathîkîra Ngai-Mûnene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
