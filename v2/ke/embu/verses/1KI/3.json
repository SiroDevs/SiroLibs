          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ina wa kaana kau kaarî mwoyo nîwecûrirwe nî ntha cia kavîcî gake, na akîra mûthamaki atîrî, “Mwathi wakwa, nakûthaitha ndûkaûrage kaana kau! Kanenganîre kûrî mûndûmûka ûcio!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
