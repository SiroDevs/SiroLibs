          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîwaugire atîrî, “Tiniani kaana kau karî mwoyo icunjî igîrî, nuthu îmwe înengerwe mûndûmûka ûmwe nayo îo îngî înengerwe ûcio wîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
