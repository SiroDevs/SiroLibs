          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwatumire nja ya kanyomba ka ndaarî na mathiga maumie maiganîrîrîtwe mîvari îthatû na mûvari ûmwe wa mbaû ndiku cia mîtarakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
