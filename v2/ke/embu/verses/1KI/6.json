          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa îna mweri wa kaîrî (Zivu) nîrîo mûcingi wa hekarû îo watumirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa îkûmi na ûmwe mwerirî wa kanana (buli) vîndî ya wathani wa Solomoni nîrîo hekarû yarîkirie gûtumwa wata ûrîa mûvuanîre wayo wonthe wekariî. Solomoni aamîtumire na îvinda rîa mîaka mûgwanja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
