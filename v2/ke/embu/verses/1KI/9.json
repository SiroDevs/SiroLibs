              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Hiramu nîwatûmire ndungata ciake irîa ciarî na ûûgî wa kûthiîra îriarî nîguo ikarutage wîra vamwe na ndungata cia Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
