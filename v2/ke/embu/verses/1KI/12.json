            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33+LEV.23.34"
              },
              "items": [
                {
                  "text": "Ala 23.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jeroboamu nîwatuire andû makûngûagîre kîrugo mûthenya wa îkûmi na îtano mwerirî wa kanana, ta kîrugo kîrîa kîethagîrwa Juda. Metharî ya kîgongoona kûu Betheli nîwarutîre tûcaû twa thaavu tûrîa aarûthîte magongoona, na akiga athînjîri-Ngai kûu Betheli matungatage marî kûndû kûrîa gûtûgîru gwa kûgoocera kûrîa aatumîte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo mûthenya wa îkûmi na îtano mwerirî wa kanana, ûrîa aatuîte ke mwene, nîwathiîre Betheli kûrîa aatumîte metha ya kîgongoona na akîvîvîria ûbani kuo, agîcoka agîtua Aisiraeli makûngûagîre mûthenya ûcio.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
