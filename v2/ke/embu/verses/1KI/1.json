          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani nîwacokerie Adonija atîrî, “Ûma nî atî, mwathi wakwa mûthamaki Daudi nîatuîte Solomoni mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
