          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Solomoni nîwaugire atîrî, “Ethîrwa nîakwonania arî mûndû mwathîki, gûtirî rûcuîrî wanarî rûmwe rwa kîongo gîake rûkaavutua. Nwatî ethîrwa tî mwathîki nîagaakua.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Solomoni nîwatûmanîre Adonija aume metharî ya kîgongoona. Adonija nîwathiîre kûrî mûthamaki na akîînamîrîria ûthiû mbere ya mûthamaki. Nake mûthamaki Solomoni nîwamwîrire atîrî, “Înûka gwaku mûciî.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
