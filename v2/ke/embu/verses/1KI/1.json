          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Solomoni nîke mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
