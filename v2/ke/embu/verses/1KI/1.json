            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Daudi nîatûmire Zadoku, Nathani, Benaia na andû arîa mamûgitagîra mamumagarie. Nîmaamwîkarîrie îgûrû rîa nyûmbû ya mûthamaki, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
