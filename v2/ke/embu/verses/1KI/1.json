          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Bathisheba nîwenamîrîrie ûthiû wake na gîtîîo mbere ya mûthamaki na akiuga atîrî, “Mwathi wakwa mûthamaki Daudi, ûrotûûra tene na tene!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
