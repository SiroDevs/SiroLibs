              "type": "text"
            }
          ]
        },
        {
          "text": "Elija nîwamwîrire atîrî, “Îî coka; nie ndirakûgiria.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
