              "type": "text"
            },
            {
              "text": "ndirakûgiria:",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe maugaga, ‘thiî nwatî ûcoke nîûndû ûguo nagwîka nî ûndû wa vata.’",
              "type": "text"
            }
          ]
        }
