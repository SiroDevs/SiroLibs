          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Elija aarîkirie kwîra Ahabu ûguo, Ahabu nîwatembûrangire nguo ciake, agîkîra nguo cia macakaya na akînyerekia. Nîwamamaga ekîrîte nguo cia macakaya na akathiîcaga kûndû na kûndû arî na kîeva.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire mûrathi Elija, Mûtishibi atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nîwonete ûrîa Ahabu enyivîtie mbere yakwa? Nîûndû nîekîte ûguo, ndikaamûretere ûndû mûcûku ûtûûrorî wake; nwatî ngaarete ûndû mûcûku nyombarî yake vîndî ya ûtûûro wa mûvîcî.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    }
