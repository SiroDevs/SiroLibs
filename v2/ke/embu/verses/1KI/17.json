                "loc": "JAS.5.17"
              },
              "items": [
                {
                  "text": "Jak 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûrathi Elija wa kuuma Tishibe ya Gileadi nîwerire mûthamaki Ahabu atîrî, “Rîîtwarî rîa Ngai-Mûnene, Ngai wa Isiraeli ûrîa ûtûûraga mwoyo, ûrîa ndungataga, gûtikethîrwa kûrî na îme kana mbura îvinda rîa mîaka îno îrûmîrîrîte nginya rîrîa ngaauga.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîra Elija atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uma gûkû ûthiî mwena wa îrathîro na wîthithe vakuvî na karûnjî ga Kerithi, mwena wa îrathîro wa Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.3",
            "verseOrgIds": [
              "1KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkaanyunyaga manjî kuuma karûnjîrî kau, na nîmbathîte ikûngûrû ikûretagîre irio vo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Elija nîwekire wata ûrîa Ngai-Mûnene aamwathire. Nîwathiîre na agîkara vakuvî na karûnjî ga Kerithi karîa getîkaga rûnjîrî rwa Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwaviragîrwa mîgate na nyama nî ikûngûrû kîraûko na kîvwaî, na akanyunyaga manjî kuuma karûnjîrî kau. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa kavinda kanini karûnjî kau nîkaavwîre nîûndû gûtiarî na mbura vûrûrirî ûcio.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elija na mûndûmûka wa ndigwa marî Zarefathu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîra Elija atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.25+LUK.4.26"
              },
              "items": [
                {
                  "text": "Luka 4.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ûkîra na ûthiî îtûûrarî rîa Zarefathu, vakuvî na Sidoni na wîkare kuo. Nîmbathîte mûndûmûka wa ndigwa ûtûûraga kuo, namwîra akûvecage irio.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
              "1KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Elija nîwathiîre Zarefathu, na rîrîa aakinyire kîvingorî gîa îtûûra, nîwonire mûndûmûka wa ndigwa agîocania ngû. Nîwetire mûndûmûka ûcio wa ndigwa akîmwîra atîrî, “Nakûthaitha ûngundie manjî.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûndûmûka wa ndigwa aathiîcaga kûgîra manjî, Elija nîwamwîtire na akîmwîra atîrî, “Nakûthaitha ûndetere kanuku ka mûgate wana ko.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake nîwacokirie atîrî, “Nie nevîta na Ngai-Mûnene, Ngai waku ûrîa ûtûûraga mwoyo, atî ndirî na mûgate. Nwa kamûtu kanini tu nîrî nako karî mbakûrirî na tûguta tûnini tûrî mûcuvarî, na rîu nîkwa nîrocania ngû nîguo nthiî ngaruge kamûtu kau tûrîe tûrî na mûvîcîwa tûcoke tûkue nîûndû tûtirî na irio ciîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Elija nîwamwîrire atîrî, “Ndûkamake, thiî na wîke wa ûguo wauga. Nwatî amba ûndugîre kamûgate kanini na ûndetere, ûcoke ûruge kau kengî mûrîe na mûvîcîguo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû Ngai-Mûnene, Ngai wa Isiraeli augîte atî, ‘Mûtu ndûkaathira mbakûrirî kana maguta mathira mûcuvarî nginya mûthenya ûrîa ngaaurithia mbura.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûka ûcio wa ndigwa nîwathiîre na agîka wata ûguo eerîtwe nî Elija. Elija, mûndûmûka ûcio wa ndigwa na nyomba yake nîmaagîre na irio cia kwîgana mîthenya mîîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wata ûrîa Ngai-Mûnene eeranîrîte kûvîtûkîrîra kûrî Elija, mûtu ndwathira mbakûrirî kana maguta mathira mûcuvarî.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuvarî mûvîcî wa mûndûmûka ûcio wa ndigwa nîwarwarire. Mûrimû nîwanenevire mûno nginya mûthiiarî mûvîcî agîkua. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.17",
            "verseOrgIds": [
              "1KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûka ûcio wa ndigwa nîwerire Elija atîrî, “Mûndû wa Ngai, wambîkire ûguo nîkî? Nîkwa waûkire kûririkania Ngai mevia makwa nîguo mûvîcîwa akue?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Elija nîwerire mûndûmûka ûcio wa ndigwa atîrî, “Rete mûvîcîguo.” Elija nîwacokire agîoca kavîcî kau kuuma njararî cia mûndûmûka ûcio na akîthiî nako ngorovarî, agîtonya nyombarî irîa eekaraga na agîkaigîrîra ûrîrîrî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
              "1KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire akîvoya Ngai-Mûnene augîrîrîtie akiuga atîrî, “Ngai-Mûnene, Ngai wakwa, mûndûmûka ûyû wa ndigwa, ûrîa nîrekara gwake akîmenyagîrîra wamûretere mathîna na njîra ya gûtûma mûvîcî akue nîkî?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.34+2KI.4.35"
              },
              "items": [
                {
                  "text": "2Atha 4.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Elija nîwacokire agîîtambarûkia îgûrû rîa kavîcî kau maita mathatû na akîvoya Ngai-Mûnene atîrî, “Ûûi Ngai-Mûnene, Ngai wakwa, nakûthaitha ûriûkie kaana gaka!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
