                  "text": "Zak 8.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwoguo tiganani na ûvoro wa maveeni! Wa mûndû nwanginya erage mûndû ûrîa wîngî ûvoro wa ma, nîûndû tuonthe vamwe tûrî ciîga cia mwîrî wa Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.4.4"
              },
              "items": [
                {
                  "text": "Tha 4.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûngîrakara, mûtigetîkîre marakara menyu matûma mwîvie na mûtigekare mûrakarîte mûthenya wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikave Ngoma kanya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe wîaga nîatigane na wîi na ambîrîrie kûruta wîra nîguo ethûkûmagîre na njîra îno mbagîrîru kîrîa avatarîte ûtûûrorî na avotage gûtethia athîni. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tigagani kwaragia mîario îno mîcûku, nwatî aragiani mîario îrîa mîaro îrî na umithio kûrî andû na ya kûmatethia na kîrîa mavatarîte. Nao andû arîa makegucaga mûkîaria magekagwa waro nî mîario îo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mûtikegwithie Roho Mûtheru wa Ngai kîeva. Roho nî rûûri rwa Ngai rwa kwonania atî mûrî ake. Ngai aamûveere Roho nîguo onanie na ma atî nîakaamûtethûra rîrîa mûthenya wa mûthiia ûgaakinya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thiriani marûrû, marakara na mang'ûrîka. Mûtikanatetie wana kana mûrume andû arîa engî. Mûtikanamene mûndû wana ûrîkû. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.13"
              },
              "items": [
                {
                  "text": "Akol 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vandû va ûguo, tuganagani, îgucanagîrani ntha na mwovanagîre wata ûrîa Ngai aamwoveere na njîra ya Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
            "verseOrgIds": [
              "EPH.4.32"
            ]
          }
        }
      ]
