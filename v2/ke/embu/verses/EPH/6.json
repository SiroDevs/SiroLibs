                  "text": "Akol 4.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tukiko, mûrû wa îthe wetû ûrîa twendete mûno na mûtungatîri mwîvokeku wîrarî wa Mwathani, nîke ûkaamwîra maûndû monthe nîguo mûmenye ûrîa mbîkariî na ûrîa nîreka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîu nîkîo kîratûma nîmûtûme kûrî mue nîguo amwîre ûrîa tuonthe twîkariî na amûûmîrîrie.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        }
