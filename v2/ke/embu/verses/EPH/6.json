              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mue aciari tigagani gwîka ciana cienyu maûndû marîa mangîtûma irakare. Vandû va ûguo, imenyagîrîreni na mûitaarage ciîkage wata ûrîa mûndû ûrîa wîtîkîtie Mwathani agîrîrwe nî gwîka.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngombo na athani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
