        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voyagani Ngai amûtethagie vîndî îrîa mûreka maûndû mama monthe. Voyagani vîndî cionthe mûtongoretue nî Roho. Nîûndû wa gîtûmi kîu, îkaragani mwîvarîrîtie na mûtikanakue ngoro. Voyagîrani andû onthe a Ngai vîndî cionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvoyagîrani wa nanie atî rîrîa navingûra kanyua gakwa, Ngai amvecage ciugo nîguo mbaragie nthitho ya ûvoro mwaro ndarî na guoya. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrî mwarîrîria wa ûvoro mwaro, na nîreka ûguo rîu nîrî gûkû njeera. Mvoyagîrani nîguo mvunjagie ûvoro mwaro ndarî na guoya wata ûrîa mbagîrîrwe nî kwaria.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
