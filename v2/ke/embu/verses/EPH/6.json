              "type": "text"
            }
          ]
        },
        {
          "text": " Mue ciana, athîkagîrani aciari enyu nîûndû nîmwîtîkîtie Mwathani. Ûguo nîguo mwagîrîrwe nî gwîka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.12"
              },
              "items": [
                {
                  "text": "Ntha 20.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Gûco 5.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tîîa aguo na nyûkwe.” Rîîrî nîrîo rîathani rîa mbere rîrîa rîthagîrwa rîrî na kîîranîro, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“nîguo maûndû monthe maku mathiî waro na ûtûûre îvinda îraca gûkû nthî.”",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        }
      ]
    },
    {
