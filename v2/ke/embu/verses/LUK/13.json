            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.11+MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue nîmûkoona Iburahimu, Isaka, Jakovu na arathi onthe marî Ûthamakirî wa Ngai, namue mwikîtue na nja. Na kaî vîndî îo mûkoona ûguo nîmûkaarîra na mûrîe magego-î! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû nîmagaakinya maumîte mwena wa îrathîro wana wa îthûîro, na maumîte mwena wa rûgûrû na wa îveti, na macoke mekare metharî na marîcanîre kîrugorî Kîam ûthamaki wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
