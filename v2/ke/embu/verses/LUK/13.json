            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jerusalemu, Jerusalemu! Atî wa rîrîa rîonthe Ngai agûtûmîra arathi nîkwa ûmaûragaga! Nî maita megana nanenda gûcokanîrîria andû aku vamwe wata ûrîa ngûkû îcokanagîrîria tûciiû rungu rwa mathagu mayo, nwatî ndûmbîtîkagîria! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
