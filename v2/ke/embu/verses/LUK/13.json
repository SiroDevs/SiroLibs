          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.30"
              },
              "items": [
                {
                  "text": "Mat 19.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "20.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mar 10.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû amwe arîa marî vuva rîu nîmagaatuîka a mbere nao amwe arîa marî mbere rîu matuîke a vuva.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
