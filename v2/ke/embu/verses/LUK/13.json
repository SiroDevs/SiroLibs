              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî wa îo, Afarisai amwe nîmaathiîre varîa Jesû aarî na makîmwîra atîrî, “Nî kava ume gûkû nîûndû Herode nîarenda gûkûûragithia.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamacokerie atîrî, “Tathiîni mwîre mbwe îo atî ûmûnthî wana rûyû nîmbîthîrwa nîrî gûkû ngîrutûrûraga ngoma kuuma kûrî andû na ngîmavonagia mîrimû yao. Narîo aûke nîngarîkia wîra wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî ûmûnthî, rûyû na aûke nwa nginya mbîthîrwe nîrî rûgendorî rwakwa. Nîûndû tî kwagîrîru mûrathi aûragwe arî kûndû kwîngî tiga îtûûrarî rîa Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
