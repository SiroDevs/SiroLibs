              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûtumumu ûcio nîwamûcokerie atîrî, “Mwathani nie nîrenda gûcoka kwona.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
