        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû arîa maarî mbere ya Jesû nîmaakaanirie mûtumumu ûcio na makîmwîra akire. Nwatî mûtumumu ûcio nîwaugîrîrie mûno akiugaga atîrî, “Mûrû wa Daudi! Mbîguîra ntha!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
      ]
    },
