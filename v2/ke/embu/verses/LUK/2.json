              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Luka 1.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa mûthenya wa kanana wakinyire, mwana ûcio nîwaruire na agîtuîrîrwa rîîtwa Jesû. Rîîtwa rîîrî nî rîrîa mûraika aaugîte atuîrîrwe wa na mbere ya ng'ina amûgîe îvu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwavirirwe hekarûrî",
          "type": "text"
        }
      ]
    },
    {
