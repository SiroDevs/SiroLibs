              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
            "verseOrgIds": [
              "LUK.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa kûu hekarûrî kwarî na mûndûmûka mûkûrû wa ndigwa na aarî mûrathi. Nake eetagwa Ana, mwarî wa Fanueli na aarî wa mûvîrîga wa Asheri. Ana ndarî na mûthuuri nîûndû kuuma aavika, eekaranirie na mûthuuri wake kavinda ka mîaka mûgwanja tu. Vîndî îo aarî na ûkûrû wa mîaka mîrongo înana na îna.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.36",
              "type": "text"
            },
            {
              "text": "Vîndî îo aarî na ûkûrû wa mîaka mîrongo înana na îna:",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe maugaga ‘Vîndî îo Ana aarî mûndûmûka wa ndigwa na aarî na mîaka mîrongo înana na îna.’",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana nîwathiîcaga hekarûrî mûthenya wana ûtukû na akathaithaga Ngai mûno na njîra ya kûmûvoya na kwînyerekia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
              "LUK.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na îthaarî wa rîu, Ana nîwakinyire na agîcokeria Ngai ngatho. Ana nîwaririe ûvoro wîgiî mwana ûcio kûrî andû arîa maatûûrîte metererete Ngai akûre Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josefu na Mariamu nîmaacokire îtûûrarî rîa Nazarethi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
