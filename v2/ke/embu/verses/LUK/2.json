              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naguo mûthenya nîwakinyire wa Josefu na Mariamu matherue vuva wa gûciara, wata ûrîa Watho wa Musa ugîte. Kwoguo nîmaavirire Jesû Jerusalemu nîguo makamûvecane kûrî Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
