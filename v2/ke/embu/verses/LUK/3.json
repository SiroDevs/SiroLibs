              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wata ûrîa mûrathi Isaia aarathire akiuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
