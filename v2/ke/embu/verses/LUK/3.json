                "loc": "MAT.23.33"
              },
              "items": [
                {
                  "text": "23.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû eengî nîmaathiîre kûrî Johana nîguo amavatithie. Nake nîwameraga atîrî, “Mue ciana ino cia njoka! Nû ûmwîrîte atî nwa mûvote kûûrîra marakara ma Ngai marîa mageere gûka? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.33"
              },
              "items": [
                {
                  "text": "Joh 8.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îkani ciîko irîa ikwonania atî nîmwîrirîte mevia menyu. Mûtikambîrîrie kwîîra na ngoro cienyu atî, Iburahimu nîke îthe wenyu wa tene. Nie nîramwîra atî Ngai nwa oce mathiga mama na athondekere Iburahimu ciana kuuma kûrî mo! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.19"
              },
              "items": [
                {
                  "text": "Mat 7.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wana rîu îthanwa nîrige gîtinarî Kîam mûtî. Kwoguo mûtî wa wonthe ûtaciaraga maciaro maro, nîûgûtemwa na wikue mwakirî.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû nîmaamûririe atîrî, “Kwoguo nîtwîka atîa vi?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Johana nîwamacokerie atîrî, “Mûndû wonthe ûrî na cati igîrî nwa nginya ave ûrîa ûtarî, na mûndû wa wonthe ûrî na irio nwa nginya agaîre ûrîa ûtarî.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
