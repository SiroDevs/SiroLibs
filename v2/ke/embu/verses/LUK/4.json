              },
              "items": [
                {
                  "text": "Joh 4.44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na ma nîramwîra atîrî, ‘Mûrathi ndetîkîrîkaga kwao.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.24",
            "verseOrgIds": [
