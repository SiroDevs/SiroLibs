            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nwatî Jesû nîwacokerie ngoma atîrî, “Mandîko wa mau nwamo maugîte atîrî, ‘Ndûkagerie Mwathani Ngai waku.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
