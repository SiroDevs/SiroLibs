          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake nîwamacokerie atîrî, “Vandû varîa kimba kîrî nîvo nderi itûnganaga.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
