          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao arutwa nîmaaûririe Jesû atîrî, “Mwathani, maûndû mama magaatuîkîkîra kû?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
