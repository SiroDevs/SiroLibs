              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.21",
            "verseOrgIds": [
              "LUK.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwacokire akîra arutwa ake atîrî, “Kûrî vingo îgaakinya mwîrirîrie kwona mûthenya ûmwe wa mîthenya ya Mûrû wa Mûndû nwatî mûtikawona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî na andû amwe makaamwîra atîrî, ‘Taroriani vaarîa!’ kana ‘Taroriani ava!’ Nwatî mûtikaamarûmîrîre. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû wata ûrîa rûveni rûvenagia na rûkamûrîka matu kuuma mwena ûmwe nginya mwena ûrîa wîngî, ûguo nwaguo Mûrû wa Mûndû ageekara mûthenya ûcio wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
              "LUK.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî nwa nginya ambe athînîke mûno na aregwe nî andû a rûciaro rûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.25",
            "verseOrgIds": [
              "LUK.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5+GEN.6.6+GEN.6.7+GEN.6.8"
              },
              "items": [
                {
                  "text": "Kîam 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wata ûrîa gwekariî vîndî ya Nuhu, nwaguo gûgeekara mûthenya wa Mûrû wa Mûndû. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.6+GEN.7.7+GEN.7.8+GEN.7.9+GEN.7.10+GEN.7.11+GEN.7.12+GEN.7.13+GEN.7.14+GEN.7.15+GEN.7.16+GEN.7.17+GEN.7.18+GEN.7.19+GEN.7.20+GEN.7.21+GEN.7.22+GEN.7.23+GEN.7.24"
              },
              "items": [
                {
                  "text": "Kîam 7.6-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Andû nîmaarîcaga na makanyua, makavikania na makavikua, nginya mûthenya ûrîa Nuhu aatonyire thavinarî na mbura ya kîvovoto îkiura na îkîmaûraga onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
              "LUK.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kîam 18.20—19.25",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûthenya ûcio ûgeekara wata ûrîa gwekariî vîndî ya Loti. Vîndî îo andû maatûûraga marîcaga na manyunyaga, magûraga na mendagia indo, na mavandaga na matumaga nyomba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûthenya ûrîa Loti aaumire Sodomu, Ngai nîwaurithirie mwaki na ûviriti, na ûkîûraga andû acio onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nwaguo gûgeekara mûthenya ûrîa Mûrû wa Mûndû akoonanua.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        }
      ]
