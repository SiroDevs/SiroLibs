              "attrs": {
                "loc": "MRK.13.15+MRK.13.16"
              },
              "items": [
                {
                  "text": "Mar 13.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mûthenya ûcio mûndû ûrîa ûkeethîrwa arî nyomba îgûrû ndakaume athiîte kûruta indo ciake. Wana mûndû ûrîa ûkeethîrwa arî mûgûndarî ndagacoke na mûciî. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.26"
              },
              "items": [
                {
                  "text": "Kîam 19.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Taririkanani mûka wa Loti! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
        },
