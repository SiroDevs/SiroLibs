                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Vîndî îmwe Daudi nîwaûririe atîrî, “Kûrî na mûndû wanarî ûmwe ûtigarîte wa kuuma mûciî wa Saûlo? Ethîrwa kûrî nake, nie nwa mende gwîka mûndû ûcio maûndû maro nîûndû wa Jonathani.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuo nîkwarî na ndungata ya mûciî wa Saûlo yetagwa Ziba. Ziba nîwerirwe athiî kûrî Daudi. Nake mûthamaki nîwamûûririe atîrî, “We nîwe wîtagwa Ziba?” Nake nîwacokirie atîrî, “Îî nînie mwathi wakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.4"
              },
              "items": [
                {
                  "text": "2Sam 4.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûthamaki nîwamûûririe atîrî, “Nîkwa gûtarî wanarî mûndû ûmwe ûtigarîte wa mûciî wa Saûlo, ûrîa nîngîkîra maûndû ma ntha na ma wathîki; wata ûrîa naarîkanîre na Ngai nîngeka?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziba nîwacokirie atîrî, “Kûrî na mûûriû ûmwe wa Jonathani ûtigarîte, nwatî nîmwonju magûrû.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwaûririe atîrî, “Arî kû?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ziba nîwacokirie atîrî, “Arî mûciî kwa Makiru mûvîcî wa Amieli kûu Lodebari.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûthamaki Daudi nîwatûmanire na akiuga mûndû ûcio aretwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Mefiboshethu mûvîcî wa Jonathani ûrîa warî ûmawe wa Saûlo aakinyire kûrî Daudi, nîwenamîrîre mbere ya Daudi na gîtîîo. Nake Daudi nîwamwîtire atîrî, “Mefiboshethu,” Nake nîwamûcokerie atîrî, “Îî nîrî ava nie ndungata yaku.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwamwîrire atîrî, “Tiga gwîtigîra nîngûgwîka maûndû ma ntha nîûndû wa aguo Jonathani; na nîngûgûcokeria kîthaka kîonthe kîrîa Kîamrî Kîam ûmaguo Saûlo, na tûkaarîcanagîra nawe vingo cionthe.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshethu nîwenamîrîre mbere yake rîngî na akiuga atîrî, “Mwathi wakwa, nie mbîkariî ta ngui îno nguû! Nîndûî gîgûtûma ûtuîke mwaro ûguo kûrî nie?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki nîwetire Ziba, ndungata îo ya Saûlo na akîmîra atîrî, “Nînava Mefiboshethu mûvîcî wa Jonathani mwathi waku indo cionthe irîa ciarî cia Saûlo na cia mûciî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî we, anake aku na ndungata ciaku mûkaarîmagîra mîgûnda ya Saûlo, na mûkaretaga maciaro mayo, nîguo mûvîcî wa mwathi waku onage gîa kûrîa. Nwatî nie tûkarîcanagîra na Mefiboshethu vingo cionthe.” (Ziba aarî na anake îkûmi na atano na ndungata mîrongo îîrî).",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ziba nîwacokirie atîrî, “Nie nîngwîka ûrîa wonthe mwathi wakwa wathana.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Mefiboshethu nîwatûûrire arîcanagîra irio na mûthamaki ta ûmwe wa anake a mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshethu aarî na mwanake wetagwa Mika. Nao andû onthe a mûciî wa Ziba nîmaatuîkire ndungata cia Mefiboshethu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Mefiboshethu ûrîa wonjete magûrû wa moîrî nîwatûûrire Jerusalemu arîcanagîra na mûthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
