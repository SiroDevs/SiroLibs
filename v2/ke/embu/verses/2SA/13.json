              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.3"
              },
              "items": [
                {
                  "text": "2Sam 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abusalomu nîwatorokire na akîthiî kûrî Talimai mûvîcî wa Amihudi. Amihudi aarî mûthamaki wa Geshuri. Nake Daudi nîwacakaîre mûvîcî gwa kavinda karaca. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu nîwathiîre na agîkara Geshuri îvinda rîa mîaka îthatû",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîrîa Daudi aathirirwe nî kîeva gîa gîkuû Kîam Amunoni, nîwerirîrie kwona mûvîcî Abusalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
