                  "text": "2Sam 9.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jonathani mûvîcî wa Saûlo aarî na mûvîcî wetagwa Mefiboshethu. Mefiboshethu aarî na ûkûrû wa mîaka îtano rîrîa Saûlo na Jonathani maaûragirwe. Rîrîa ûvoro wîgiî kûûragwa kwao wakinyire kuuma îtûûra rîa Jezireeli, mûndûmûka ûrîa wareraga Mefiboshethu nîwamwocire na akîûra nake. Nwatî nîûndû wa ûrîa aavinyûrîte, nîwamûgwîthirie na agîtuîka kîonje.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Rekabu na Baana nîmaathiîre mûciî kwa Ishiboshethu na magîkinya kuo ta thaa thita cia mûthenya na makîmwîthîra anogokete. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.5",
            "verseOrgIds": [
              "2SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûndûmûka ûrîa wekaragia mûrango nîwanyitirwe nî toro wa akîgûrûkagia ngano na akîmama. Kwoguo Rekabu na Baana nîmaacemire na magîtonya ndaarî. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.6",
            "verseOrgIds": [
              "2SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa maatonyire nîmaathiîre nyomba îrîa Ishiboshethu amamaga na makîmwîthîrîria arî toro. Nîmaamûragire na makîmûtinia kîongo na makîthiî nakîo ûtukû mûgima mavîtûkîrîrîte Kîamndarî Kîam Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.7",
            "verseOrgIds": [
              "2SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaavirire kîongo kîu Kîam Ishiboshethu kûrî mûthamaki Daudi kûu Heburoni na makîmwîra atîrî, “Gîkî nîkîo kîongo Kîam Ishiboshethu mûvîcî wa nthû yaku îrîa îtagwa Saûlo, îrîa yendaga gûkûûraga. Ûmûnthî Ngai-Mûnene nîagwîtîkîrîtie we mwathi wetû wîrîvîrie kûrî Saûlo na njiarwa ciake.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Daudi nîwamacokerie atîrî, “Nie nevîta na Ngai-Mûnene ûrîa ûtûûraga mwoyo, ûrîa ûmvonoketie kuuma mogwatirî monthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.9",
            "verseOrgIds": [
              "2SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.1+2SA.1.2+2SA.1.3+2SA.1.4+2SA.1.5+2SA.1.6+2SA.1.7+2SA.1.8+2SA.1.9+2SA.1.10+2SA.1.11+2SA.1.12+2SA.1.13+2SA.1.14+2SA.1.15+2SA.1.16"
              },
              "items": [
                {
                  "text": "2Sam 1.1-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûnjaama ûrîa wandetere ûvoro wîgiî gîkuû gîa Saûlo rîrîa naarî Zikilagi eeciragia andeterete ndûmîrîri mbaro. Nînaamûnyitire na ngîmûûragithia. Kîu nîkîo kîveo kîrîa namûveere nîûndû wa ndûmîrîri îo mbaro yake! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.10",
            "verseOrgIds": [
              "2SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaî andû aganu, arîa maûragîte mûndû mûthingu amamîte nyomba gwake nî makethîrwa marî na thîna-î! Rîu nînîîrîvîrîria namue nîûndû wa kûmûûraga. Nînîmûraga muonthe mûthire!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.11",
            "verseOrgIds": [
              "2SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwarutire watho, na athigari ake nîmaaûragire Rekabu na Baana na magîtinia njara ciao vamwe na magûrû na makîmacuria vandû vakuvî na karia kûu Heburoni. Nwatî nîmoocire kîongo Kîam Ishiboshethu na magîkîthika mbîrîrarî ya Abineri kûu Heburoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.12",
            "verseOrgIds": [
              "2SA.4.12"
            ]
          }
        }
      ]
    }
  ],
