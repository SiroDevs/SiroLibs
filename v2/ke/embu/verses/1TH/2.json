                  "text": "Ciîko 17.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariû na aarî a îthe wetû, mathîna marîa mwonire nwa ta marîa moonirwe nî etîkia a Jesû Kristû a makanitha ma Ngai ma Judea. Mwanyaririrwe nî andû enyu wata ûrîa maanyaririrwe nî Ayahudi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
