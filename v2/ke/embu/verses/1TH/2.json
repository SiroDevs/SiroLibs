            }
          ]
        },
        {
          "text": " arîa maaûragire Mwathani Jesû na arathi na magîtûnyarira. Matiakenia Ngai na nîmaareganaga na andû onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nîmaageragia gûtûgiria tûtikavunjîrie andû a ndûrîrî ndûmîrîri îrîa îngîtûma mavonoke. Na njîra îno nîmarîkîtie gûkinya mûthiia wa mevia marîa matwîre mekaga. Namo marakara ma Ngai nîmakinyîte kûrî o.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paûlo nîwerirîrie kûmacerera rîngî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
