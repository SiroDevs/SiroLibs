          ]
        },
        {
          "text": "Avîcî a Jerohamu maarî: Shamusherai, Sheharia, Athalia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
            "verseOrgIds": [
              "1CH.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaareshia, Elija na Zikiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nîo maarî atongoria a mbarî ciao kûringana na njiarwa ciao arîa maatûûraga Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiarwa cia Benjamini irîa ciatûûraga Gibeoni na Jerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
            "verseOrgIds": [
              "1CH.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeieli",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.29",
              "type": "text"
            },
            {
              "text": "Jeieli:",
              "type": "text"
            },
            {
              "text": "Kîhibirania gîtirî rîîtwa rîîrî.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nîke watumire îtûûra rîa Gibeoni na agîtûûra kuo. Mûka eetagwa Maaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîcî wa îrikithathi eetagwa Abudoni akîthingatwa nî Zuri, Kishi, Baali, Nadabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedori, Ahio, Zekeri ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.31",
            "verseOrgIds": [
              "1CH.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mikilothi ûrîa warî îthe wa Shimea. Andû aya maatûûraga Jerusalemu vakuvî na andû acio engî ao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andû a nyomba ya mûthamaki Saûlo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri aarî îthe wa Kishi, Kishu aarî îthe wa Saûlo. Saûlo aarî îthe wa Jonathani, Malikishua, Abinadabu na Eshibaali.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.33",
              "type": "text"
            },
            {
              "text": "Eshibaali:",
              "type": "text"
            },
            {
              "text": "Nîke wîtagwa Ishiboshethu îvukuurî rîa 2 Samueli 2.8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani aarî îthe wa Meribaali, nake Meribaali aarî îthe wa Mika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avîcî a Mika maarî: Pithoni, Meleki, Tarea, na Ahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi aarî îthe wa Jehoada. Jehoada aarî na avîcî athatû: Alemethi, Azimavethi, na Zimuri. Zimuri aarî îthe wa Moza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza aarî îthe wa Binea, Binea aarî îthe wa Rafa. Rafa aarî îthe wa Eleasa na Eleasa aarî îthe wa Azeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeli aarî na avîcî atandatû. Namo marîîtwa maarî: Azirikamu, Bokeru, Ishumaeli, Shearia, Obadia na Hanani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esheki aarî mûrwang'ina wa Azeli. Nake aarî na avîcî athatû, nao maarî: Ulamu arî ke îrikithathi, Jeushi arî wa kaîrî na Elifeleti wa kathatû.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
    },
