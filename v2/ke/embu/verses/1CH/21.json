              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîatha mûraika acokie rûviû rwake njûrarî, nake nîwathîkire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
