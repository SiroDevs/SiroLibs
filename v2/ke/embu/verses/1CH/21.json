          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîûndû îgema rîa Ngai-Mûnene, rîrîa rîatumirwe nî Musa arî werûrî wa Gibeoni na metha ya kîgongoona îrîa yavîvagîrua matega yarî Gibeoni kavinda kau. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
