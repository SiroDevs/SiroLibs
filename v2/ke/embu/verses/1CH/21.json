              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi oonire atî Ngai-Mûnene nîwacokirie mavoya marîa aavoire arî vau îtîrirî rîa Orinani ûcio Mûjebusi, nîwarutire îgongoona arî vau, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
