          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrwang'ina na Mika eetagwa Isihia. Isihia aarî na mûvîcî wetagwa Zekaria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
