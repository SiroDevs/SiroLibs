          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo andû maandîkirwe kûringana na wîra ûrîa maagaîrîtwe wa gûtungata hekarûrî ya Ngai-Mûnene. Maarûmagîrîra mawatho marîa maatigîrîtwe nî Aroni îthe wao wa tene, wata ûrîa Ngai-Mûnene, Ngai wa Isiraeli aamwathîte.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûtaratara wa Alawi",
          "type": "text"
        }
      ]
    },
    {
