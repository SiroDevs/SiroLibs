          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heburoni aarî îthe wa Jeria, Amaria, Jehazieli, na Jekameamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
