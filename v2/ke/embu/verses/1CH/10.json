                  "text": "28.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Saûlo aakwire nîûndû ndaarî mwîvokeku kûrî Ngai-Mûnene. Nîwaregire kwathîkîra watho wa Ngai-Mûnene, na nîwathiîcaga kûria ûtaaro kûrî ago, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "vandû va kûria ûtaaro kûrî Ngai-Mûnene. Kwoguo Ngai-Mûnene nîwaûragire Saûlo na akînengera Daudi mûvîcî wa Jesse ûthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
