                  "text": "Gûco 10.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwoguo Alawi tîmacoka gûkuua rîngî îgema rîa Ngai-Mûnene kana kîndû wa kîonthe gîa gûtûmîrwa vîndî ya kûgooca.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
