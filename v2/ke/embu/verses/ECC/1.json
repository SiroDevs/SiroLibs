              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino nî ciugo cia mûvunjia, mûvîcî wa Daudi. Daudi aarî mûthamaki wa Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
