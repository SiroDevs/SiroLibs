              },
              "items": [
                {
                  "text": "Hos 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wata ûrîa kwandîkîtwe nî mûrathi Hosea:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paûlo nîwavoere andû a Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
