      },
      "items": [
        {
          "text": "Ndûgatuîre mûndû ûrîa wîngî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 14:1"
          },
          "items": [
