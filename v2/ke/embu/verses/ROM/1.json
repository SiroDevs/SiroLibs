              "ROM.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.38"
              },
              "items": [
                {
                  "text": "Mar 8.38",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nie ndiconokaga nî Ûvoro Mwaro nîûndû nîguo vinya wa Ngai wa kûvonokia arîa onthe metîkîtie mbere Ayahudi na vuva andû a Ndûrîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Hab 2.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû Ûvoro Mwaro ûguûragia ûrîa Ngai atûmaga andû matuîke athingu; na njîra ya gwîtîkia kuuma Kîammbîrîria nginya mûthiia. Wata ûrîa kwandîkîtwe mandîkorî matheru atîrî, “Mûndû ûrîa mûthingu nîagaatûûra mwoyo nîûndû wa gwîtîkia.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wîvia wa andû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marakara ma Ngai nîmonekete kuuma îgûrû, nîûndû wa andû arîa matarî na ûngai na arîa mekaga maûndû macûku. Njîra ciao irîa njûku nîigiragia ûma ûmenyekane. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai amaverithagia nîûndû maûndû marîa mangîmenyeka megiî Ngai nîmonanie waro kûrî o nî Ngai ke mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma rîrîa Ngai aaûmbire nthî, maûndû make marîa matoonekaga nîmamenyekete waro. Maûndû mau nî vinya wake ûrîa ûtûûraga tene na tene na ûngai wake. Andû nîmataûkagîrwa nîmo waro maroria indo irîa Ngai aaûmbire na kwoguo gûtirî na mûndû ûngîgîa na kîîgwatio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.17+EPH.4.18"
              },
              "items": [
                {
                  "text": "Aef 4.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O nîmecî Ngai, nwatî matimûvecaga gîtîîo kîrîa kîmwagîrîrîte, kana magacokia Ngatho kûrî ke. Vandû va ûguo, meciria mao maatuîkire ma mana na ngoro ciao ciîcûrîtwe nî nduma. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maugaga nî aûgî nwatî nî irimû. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
