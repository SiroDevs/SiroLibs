              },
              "items": [
                {
                  "text": "Kîam 17.4-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17+GEN.22.18"
              },
              "items": [
                {
                  "text": "22.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.29"
              },
              "items": [
                {
                  "text": "Agal 3.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Ngai eerîre Iburahimu na njiarwa ciake atî nthî yonthe îkeethîrwa îrî yake, ekire ûguo nîûndû Iburahimu nîwetîkirie na agîtuwa mûthingu nî Ngai, nwatî tî nîûndû nîwathîkagîra Watho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Agal 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû ethîrwa kîrîa Ngai eranîrîte gîkaavecagwa arîa mathîkagîra watho, wîtîkio ndûrî vata na kîîranîro Kîam Ngai nî Kîam mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watho ûretaga marakara ma Ngai, nwatî kûrîa gûtarî watho gûtirî ûvoro wa kûregana na Watho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
