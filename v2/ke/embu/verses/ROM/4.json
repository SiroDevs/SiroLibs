            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        },
