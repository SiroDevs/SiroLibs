        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariû na aarî a îthe wetû, wendi wa ngoro yakwa yonthe na mavoya makwa kûrî Ngai nî atî, andû etû mavonoke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nîrî mûira wao atî methagîrwa marî na kîîo kînene mûno wîrarî wa Ngai, nwatî matiîthagîrwa marî na ûmenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû wa kûrega kûmenya ûthingu ûrîa uumaga kûrî Ngai, o nîmageretie kwîrûthîra ûndû wao o ene. Kwoguo nîmaaregire kûrûmîrîra njîra îrîa Ngai atûcaga mûndû mûthingu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû Kristû nîwathiririe watho nîguo mûndû wa wonthe ûmwîtîkîtie etîkîrîke nî Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûvonokio nî wa andû onthe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
