              },
              "items": [
                {
                  "text": "Luka 20.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûndû ûcio nwa guo ûtûmaga mûrute gooti nîûndû athani methagîrwa magîtungatîra Ngai vîndî îrîa mararuta wîra ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.6",
            "verseOrgIds": [
              "ROM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marîvageni onthe kîrîa mwagîrîrwe nî kûmarîva. Rutagani gooti rîrîa rîonthe mwagîrîrwe nî kûruta. Îtigagîreni arîa magîrîrwe nî gwîtigîrwa, na mûtîîe arîa magîrîrwe nî gûtîîwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.7",
            "verseOrgIds": [
              "ROM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maûndû marîa mûndû agîrîrwe nî gwîka ûrîa wîngî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 13:7"
          },
          "items": [
