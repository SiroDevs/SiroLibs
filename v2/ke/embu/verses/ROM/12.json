            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mat 5.44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.28"
              },
              "items": [
                {
                  "text": "Luka 6.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rathimagani andû arîa mamwîkaga naaî, marathimageni na mûtikamarume. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenagani na arîa marakena na mûrîrage na arîa mararîra. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.7"
              },
              "items": [
                {
                  "text": "Nthi 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tûûrani mwîgucanîte mûndû na mûndû ûrîa wîngî. Mûtigetîîe, nwatî tumagani ûrata na andû arîa monekaga matarî îgweta. Tigagani kwîyona ta mûrî aûgî.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû angîgwîka naaî, ndûkamwîke naaî. Nwatî geragia gwîka andû onthe maûndû marîa maro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geragiani mûno wa ûrîa mûngîvota gûtûûrania na andû onthe mûrî na thayû. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.18",
            "verseOrgIds": [
              "ROM.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.35"
              },
              "items": [
                {
                  "text": "Gûco 32.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Arata akwa, mûtikerîvîrie, nwatî tigani Ngai amûrîvagîrîrie na marakara make. Nîûndû mandîkorî matheru kwandîkîtwe atîrî, “‘Kwîrîvîrîria nî gwakwa, nînie ngeerîvîrîria,’ ûguo nîguo Mwathani augîte.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.21+PRO.25.22"
              },
              "items": [
                {
                  "text": "Nthi 25.21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Vandû va ûguo, mandîko matheru maugîte mwagîrîrwe nî gwîka atîrî, “Ethîrwa mûndû ûrîa mûrî na ûthû nake nî mûvûtu mûve gîa kûrîa. Ethîrwa nî mûnyondu mûve kîndû gîa kûnyua, nîûndû weka ûguo nîtakwa wamwigîrîra makara marî na mwaki kîongorî gîake.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndûgetîkîre kûvootwa nî ûndû mûcûku, nwatî vootaga ûndû ûrîa mûcûku na njîra ya gwîka waro.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.21",
            "verseOrgIds": [
              "ROM.12.21"
            ]
          }
        }
      ]
    }
  ],
