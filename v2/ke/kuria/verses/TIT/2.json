          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igia amang'ana gano; utirimiki na ötaki kögötöra gonsui. Ömöntö örë wonsui atagaacha kögösera.",
          "type": "text",
          "attrs": {
