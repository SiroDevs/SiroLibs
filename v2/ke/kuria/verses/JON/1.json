                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agatöma insui ënene ëmere Yona, na akabha könda yi insui ëyö guchinsikö isatö ubhutikö na ömöbhasö.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
