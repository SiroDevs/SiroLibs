              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhabhuuria iga, “Bhoono, hano umuene ömögöndö göë ëmësabhibhu araache niyekë araakore abharimi bhaara?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakamuhunchukiria iga, “Naraite abhantö abhabhëëbhë bhaara bhonsui, hakurua ahaane ömögöndö göyö göë ëmësabhibhu köbharimi bhandë abhaiya, bhano bharaayi bharamöha ësöro yaae yi irigesa gönkaaga ëëra ëragërë.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
    },
