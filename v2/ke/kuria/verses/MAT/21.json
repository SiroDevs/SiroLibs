              "MAT.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö ndabhateebhia iga, öbhögambi bhuë Ënooköë mböraaruusibhui harë bhainyu bhöhaanöe köbhantö bhano bharaame ichiihagöe ichinchiiya chaae. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
