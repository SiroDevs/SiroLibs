              "items": [
                {
                  "text": "Mat 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muirihe mötagaacha gökora amakora gainyu amaiya mbere ya abhantö korri iga bhabhamaahe. Gëtarë igo, Isaweinyu wa kuriöbha tarabhahe igituho hai.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö hano watuurria ömötaka wanga kuiraganka keehaara abhaitereerri bhaagökora guchisinagogi na guchinchëra, korri iga bhagööngöe na abhantö. Ndabhateebhia öbhöheene iga, bhasookia köhaabhöa igituho keebho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono uwe hano watuurria ömötaka, ökora nkiri igo kura öno ambarëka yaao anga kömanya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua këbha ikibhisërë, na Isaweinyu öno akömaaha gukibhisërë, naraköhe igituho.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.4",
            "verseOrgIds": [
              "MAT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriigiö igörö ya amasabhi",
          "type": "text"
        }
      ]
    },
    {
