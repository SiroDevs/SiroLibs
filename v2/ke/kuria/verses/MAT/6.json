      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmongo ya kuriöbha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
