                "loc": "JAS.5.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mötakaibhëëkëra ëmongo gökëbhara hano, hano ichimöngö na ubhuineeru bhigösaria, na hano abhaibhi bhagötëmöra na kuibha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Sir 29:11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono mötaibhëëkëra ëmongo igörö kuriöbha, hano gëntö gëtagösaribhua na ichimöngö gösë ubhuineeru, na abhaibhi tëbhagötëmöra göse kuibha hai; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira hano ëmongo yaao ërë, nëho ömooyo gooo görë.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëtara yö ömöbhërë",
          "type": "text"
        }
      ]
    },
