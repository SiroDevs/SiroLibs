                  "text": "Ruk 22:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono harë bhainyu tëkëraabhe igo hai. Hano ndanyoore umui weinyu aratuna köbha ömönene, kuhika abhe ömökoramërëmo wa abhandë; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na hano ndanyoore umui weinyu aratuna köbha öwambere kuhika abhe ömökoramërëmo weinyu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
