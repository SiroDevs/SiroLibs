              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhëëga bhandë bhaara ikumi bhaiguurë amang'ana gayö, mbaarërrëëyë abhaana bhabhërë bhaara bha Sebhetayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
