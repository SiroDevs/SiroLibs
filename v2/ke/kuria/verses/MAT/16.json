              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yesö agateebhia abhëëga bhaae iga, bhatagaacha göteebhia möntö örë wonsui iga nëwe Masihi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö arasumaachëra imiriiro na uruku rooe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
