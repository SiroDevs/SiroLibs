                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira örë wonsui agutuna gutuuria öbhöhoru bhooe, nköbhötabhuta arë; na örë wonsui aratabhutë öbhöhoru bhooe gikugira yaane naribhunyoora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
