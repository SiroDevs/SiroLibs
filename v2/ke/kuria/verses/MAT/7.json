                  "text": "Sab 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nëho nëndëbhateebhia kiono iga: ‘Tënaabhamanyërë bhainyu kimui hai; Tarua harë uni, bhainyu bhano mögökora amanyanku.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.23",
            "verseOrgIds": [
              "MAT.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhahagaachi bhabhërë bhi inyumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
