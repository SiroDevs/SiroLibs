          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.13"
              },
              "items": [
                {
                  "text": "22:13",
