              "items": [
                {
                  "text": "Ruk 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira örë wonsui ana ëgëntö narengeribhua, na köbha na ibhiaru bhökong'u bhinö bhihetërë; sibhoono öno ataana gëntö, ninyoora në ëgëke këëra anakio, nariruusibhua. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
