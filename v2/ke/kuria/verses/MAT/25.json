                "loc": "LUK.13.28"
              },
              "items": [
                {
                  "text": "Ruk 13:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö ömökoramërëmo öno ataana bhuëra mörekere kuya këbhara haara kugisuntë; na hayö nëho harëbha ugukuura na ögökarraatia amainö.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
