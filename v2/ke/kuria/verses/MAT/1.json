              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gano gonsui ngaabhaayë korri iga ëng'ana ëëra Ömönene aagambërë köhetera kömönaabhi ëhëkëërane:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yusubhu aabhökërë kurua guchitëro naakorre keehaara ömömaraika wö Ömönene wanyoorrë amoteebhiri, akaimukia mökaae akamuhira ka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.24",
            "verseOrgIds": [
              "MAT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
