    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mötaiseemia kugira yu uguucha kö Ömönene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, titugutuna iga töbhandëkëre amang'ana igörö yi ichinkaaga na ichingaki hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.43"
              },
              "items": [
                {
                  "text": "Mat 24:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Ruk 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.10"
              },
              "items": [
                {
                  "text": "2 Bhe 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gikugira bhainyu abhiene mmömanyërë bhuuya kimui iga urusikö rö Ömönene nduriicha ke hano umuibhi aguucha ubhutikö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëno abhantö bhariya bharagamba iga, “Ntööna ömörembe na amang'ana mbuuya garë,” hayo nëho ögösaribhua körëbhaguëra kehaara ömögaikörö akögootöa na ibhisa, na abhantö tëbharëtöra köng'osa hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhainyu bhantö bhaitö, tëmörëngë kugisuntë hai, köhayö urusikö röyö tërörabhaachëre kehaara umuibhi aguucha hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu bhonsui na abhantö bhö öbhörabhu mörë, abhantö bhö ömöbhasö. Tëtörëngë abhu ubhutikö gösë abhi igisuntë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö tötakaraara ichitëro kia abhandë; niiga töbhe maiso na töbhe na ëkërengere. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaara ukunyoora bhararaara nu ubhutikö bhaköraara; na bhaara ukunyoora bharareehöa nu ubhutikö bhaköreehöa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Isa 59:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Eb 6:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhaara törëngë abhantö bhö ömöbhasö niiga töbhe na ëkërengere; tusuare ubhukumia na öbhöhanchi ki ingubha ya guikëngëra, na iriteng'ero riu ubhuituuria rëbhe kë ëngosiira yi ikiöma. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Ënooköë taatohööyë iga öbhörrö bhooe bhötösëkërre hai, gëtatiga niiga tunyoore ubhuituuria köhetera kö Ömönene weitö Yesö Kirisitö, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "öno aakuurë gikugira yeitö korri iga tömenye hamui nawe, nögaacha kunyoora tööho gösë tookua. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mutirimikani abhiene kubhiene na möhanchane abhiene kubhiene, ke hayö bheene mögökora bhoono.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirriö na amakeeriö ga gösookerria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngösabha törë abhantö bhaitö, iga mösööke bhaara bhaagökora ëmërëmo harë bhainyu, na götakia bhaara bhakötangata kuriina riö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möbhasööke bhökong'u na möbhahanche kugira yë ëmërëmo gëno bhaagökora. Möbhe na ömörembe abhiene kubhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö törabhageya iga mötaki abharosu, mutirimiki abhoobha, mutuurri bhano bhataana nguru na mugumirri köbha na abhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiraarërre mötakahakana amabhëëbhë kömabhëëbhë, si mömaahe iga ruiso ronsui ëng'ana yeinyu nögökorrana amaiya abhiene kubhiene hamui na köbhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mögooke ruiso ronsui, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.16",
            "verseOrgIds": [
              "1TH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "muyi mörasabha ruiso ronsui, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.17",
            "verseOrgIds": [
              "1TH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "möbhe na umukumo kömang'ana gonsui. Gayö ngo Ënooköë agutuna harë bhainyu gökögootana koinyu na Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge kuriirria Nkoro Nhoreeru; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.19",
            "verseOrgIds": [
              "1TH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "monge gösera öbhönaabhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.20",
            "verseOrgIds": [
              "1TH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muisunche amang'ana gonsui; mögoote gano garëngë amaiya ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.21",
            "verseOrgIds": [
              "1TH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "monge amabhëëbhë gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë wö ömörembe we umuene abhasaabhuure abhahëkëërani kimui, ariihe ichinkoro, imioyo, na ëmëbhërë kurua guisaria rërë rionsui gönkaaga yu uguucha kö Ömönene weitö Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "We öno aköbhabhërëkëra nö ömöheene, narakore igo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, mötösabhëre. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1TH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökeerani abhakumia bhonsui möranaamuunana köbhöhanchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.26",
            "verseOrgIds": [
              "1TH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1TH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhateebhia kögötöra kö Ömönene mösomere abhakumia bhonsui inyarubha ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.27",
            "verseOrgIds": [
              "1TH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1TH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita yö Ömönene weitö Yesö Kirisitö ëbhe na bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.28",
            "verseOrgIds": [
              "1TH.5.28"
            ]
          }
        }
      ]
    }
  ],
