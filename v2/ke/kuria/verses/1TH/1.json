                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyarubha kurua harë Bhauro, Siira na Timoteo – kuya gökanisa ya abhantö bha Tesaronike, bhano bharëngë abhantö bhë Ënooköë Taata na Ömönene Yesö Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita na ömörembe bhibhe harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irimenya na ubhukumia bhua Abhatesaronike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruiso ronsui nköha törë Ënooköë umukumo gikugira yeinyu bhonsui na kömasabhi gaitö nköbhahëëtöka törë ruiso ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nköhëëtöka törë mbere yë Ënooköë Taata weitö keebhörë mökoorokia ubhukumia bhoinyu kömakora na keebhörë mökoorokia öbhöhanchi bhoinyu kögökora ëmërëmo kugituunyo, na keebhörë iriteng'ero reinyu rëgömërë kö Ömönene Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, bhano moohanchöa na Ënooköë ntömanyërë iga nëwe aabhahööyë. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira igichiratë geitö tëkeebhahëkërëëyë kömang'ana agiene hai, gëtatiga guchinguru na Nkoro Nhoreeru, na gököherekia ökönene iga amang'ana gayö na amaheene. Mmömanyërë möna toomenyërë gatai yeinyu gikugira yeinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.5+ACT.17.6+ACT.17.7+ACT.17.8+ACT.17.9"
              },
              "items": [
                {
                  "text": "Ama 17:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhainyu mmuëgërë kurua harë bhaitö na kurua kö Ömönene; ninyoora mmoiriirrë bhökong'u mmogootërë ëng'ana ëyö kömögooko göno gukurua harë Nkoro Nhoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö moobha igituubhaniö ikiiya köbhakumia bhonsui bhano bharëngë Maketonia na Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tiiga iga ëng'ana yö Ömönene kurua harë bhainyu, yaarandërë ëkahika Maketonia na Akaya bheene hai; gëtatiga ubhukumia bhoinyu kö Ënooköë bhoomanyëkana këra hasë. Köhayö tëtugutuna kögamba ng'ana yëndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö ngusumaacha bharë keebhörë mootuirigaini nkaaga toochërë weinyu, na keebhörë moihönchörëëyë Ënooköë mögatigana na ibhihooru, kögökorra Ënooköë öno aho na öno arëngë ömöheene ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gököganya ömoona waae öno aariukiri kurua köbhaku ache kurua kuriöbha – Yesö öno agututuuria kurua köbhörrö bhöno bhuguucha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.10",
            "verseOrgIds": [
              "1TH.1.10"
            ]
          }
        }
      ]
    }
  ],
