      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ngaitegeerra na göteebhia ömooyo iga, “Taacha bhoono igo ösohe götantago, wigoki umuene.” Sibhoono nöngööyë iga ninyoora ngayö gonsui mbuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkagamba igörö yö ögöseka, “Nu ubhuchuuru” na igörö yë ëmëgooko, “Mbuëra kë gënagio?” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukuhunibhua na ömooyo gö öbhöng'aini, naatunërëtunërë keebhörë nkagookia ömöbhërë goone kömaroa na haara ndakora gonsui agöbhökangi korri nyoore gano garëngë amaiya bhökong'u gano abhantö bhagakora nkaaga bhakëmenyërë irimenya reebho rëno rërëngë iriëng'ë hansë ya kuriöbha köno nsikö chonsui cha amabhaho gaabho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
