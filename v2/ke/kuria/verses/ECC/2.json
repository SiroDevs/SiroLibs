                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.22+2CH.9.23+2CH.9.24+2CH.9.25+2CH.9.26+2CH.9.27"
              },
              "items": [
                {
                  "text": "2 Ich 9:22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakoorrë ëmërëmo ëmihiku: Naahagachërë ichinyumba na körema ëmëgöndö geene gë ëmësabhibhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakoorrë irisikö rë ëtegerio na körëma irisamba ria amakö hagarëhagarë. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatuka amatibhöngö ga amanchë korri irisamba rëëra riyi rërahömëërröa amanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.23"
              },
              "items": [
                {
                  "text": "1 Gam 4:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naagöörrë abhagöre abhasaacha na abhakari köbhooru na abhagöre bhandë mbano bhaibhörëëyöë ka waane. Naarëngë na öbhoomë öbhooru, amahicho gi iching'ombe na amang'ondi amaaru gökëra örë wonsui aantangatërë köbha Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.10"
              },
              "items": [
                {
                  "text": "1 Gam 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.14+1KI.10.15+1KI.10.16+1KI.10.17+1KI.10.18+1KI.10.19+1KI.10.20+1KI.10.21+1KI.10.22"
              },
              "items": [
                {
                  "text": "14-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakömërë amatiini gi ichimbiria na ësahaabhu gukurua guchimongo cha abhagambi na gukurua kubhibhure hagarëhagarë bhino naarë kögambëra. Naarëngë na abhasiringia abhasaacha na abhagaikörö na abhaikarani abhaaru, ëyö niyö ëtantagö yö ömösaacha. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.25"
              },
              "items": [
                {
                  "text": "1 Ich 29:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, naabhaayë ömönene, umukumahe gökëra örë wonsui aantangatërë Yerusaremu; na ruiso ronsui öbhöng'aini bhoone tëbhosiirrë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kërë gionsui keerë götegeria amaiso gaane naarë kögëkora. Tënairëbhëërëëyë gökora ëmëgooko. Naigokiri gökëëra gionsui naanyoorrë nkoorre, na ëyö niyo yaabhaayë igituho ki ibhigeri bhiane. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ngaitegeerra gano gonsui naanyoorrë nkoorrë kömabhoko gaane, keebhörë naaruusiri ibhigeri kögakora. Nëho nöngööyë iga gonsui mbuchua; nkeehano ököhanga ömökama, tëbhuëra bhörë bhonsui bhööho hansë yi iriöbha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono nkaringa guitegeerra igörö yö öbhöng'aini, öbhuchuuru nö öbhökangi. Kana nkë ömögambi ömöhëa agaakora? Tëgëntö këndë këho gëtatiga këëra bheene wanyoora gieisa gökorua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nööngööyë iga, öbhöng'aini nu ubhu ubhuëra gökëra öbhökangi, kehaara bheene öbhörabhu bhörëngë ubhuuya gökëra igisunte. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno ana öbhöng'aini naana amaiso, nkömaaha arë harë akögëëra, na hara ömökangi nkugisunte akögenda. Sibhoono ninyoora niigo naamanyërë iga ömöntö ömöng'aini nö ömökangi bhonsui ënsokeerrio yaabho në ëëra bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono mbe ngaiteebhia iga, “këëra bheene këraabheere ömökangi nkio bheene kerambere. Kana mbe igankë naabha nö öbhöng'aini öbhönene igo?” Ngaiteebhia umuene iga, gano gonsui mbuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira taaho öno aköhëëtöka ömöntö ömöng'aini gösë ömökangi, bhonsui guchinsikö chino chiguucha mbariëbhoa. Niyekë ömöng'aini agukua kehaara ömökangi agukua! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönchëra ëyö naaregërë irimenya, kugira gonsui gano gagökorekana hansë yi iriöbha ngandiirriiyi. Gonsui mbuchua na mbitubhunaini na ököhanga ömökama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaregërë ëmërëmo geene gionsui gëno naanyoorrë naakora hansë yi iriöbha gikugira iga kuhika ntëgëre ömögambi wöndë öno aguucha nyuma yaane gonsui gano wanyoorrë naakora. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui amanyërë hanga öyö araache nö ömöntö ömöng'aini araabhe gösë ömökangi? Na haara nëwe araimërërërre ëmërëmo gëno gionsui nairriirre gökora gukuiruusia köbhöng'aini bhonsui bhoono naarëngë nabho hansë yi iriöbha. Ninyoora ngayö gonsui mbuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naitegeerreeyë igörö ya gayö gonsui naanyoorrë naakora hansë yi iriöbha naakuurë ömooyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira harë kaaru ömöntö öno airiirre köbhöng'aini, ubhuigibhua na ubhunguri asooki atëgëre öwöndë aragookëra ëmërëmo gëno ataruusiiyi ibhigeri. Ninyoora nëëyö nayo guiki mbuchua na në ëmbëëbhë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuëra kë ömöntö akunyoora kurua kömërëmo gee gionsui gëno aakoorrë kumiriiro hansë yi iriöbha? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Ayb 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.1"
              },
              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira irimenya reee në ëmërëmo gee, bhionsui mbichööyë isina, ëkërengere këno ninyoora nu ubhutikö taaköraara hai! Gayö gonsui mbuchua.",
