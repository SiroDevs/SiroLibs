              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö yahagaachëröë bhöhëa na Sarumu ömoona o Harohesi öno aarëngë ömötangati wi iritënë rëndë riö ömöndaara go Yerusaremu. Mbatuurraini öbhögahaachi bhöyö na abhasubhaati bhaae.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihita re Ibhatë ndehagaachëröë bhöhëa na Hanuni hamui na abhamenyi bhu umugi go Sanoa, bhagatööra amahita, ibhisaku, ichibhata hamui ni imisiiri geebhio. Mbaahagaachërë urugito röno rorambiriiyi ichimiita amagana anai na mërongo ënai (440) kuhika Ihita re Matokoore.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihita re Matokoore, ndehagaachëröë bhöhea na Marikia ömoona o Rekabhu öno aarëngë ömötangati kömöndaara go Bheti-hakeremu. Akarëtööra ahasë hario, agatööra imisiiri ni ichibhata chario.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihita re Nyörrö ndehagaachëröë bhöhëa na Sarumu ömoona o Korihose omotangati wö ömöndaara go Misibha. Akarikundikiria, akarëtööra ahasë hario, agatööra amahinda na imisiiri geerio. Guitibhongö re Sera, naahagaachërë urugito röno roorëëngë hang'i ni irigori riö öbhögambi kuhika köbhösëkërro bhökurua kumugi gö Ömögambi Tauti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö kuhika guchimbëëhëra cha Tauti, guitibhöngö na ichinyumba chi iricheesi, yaahagaachëröë bhöhëa na Nehemia ömoona o Sabhuki öno aarëngë ömötangati wi iritënë riö ömöndaara go Bheti-suri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abharawi Bhano Bhahagaachërë Öbhögöe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua köbhayö, Abharawi mbaagenderreeyi köhagaacha bhöhëa ichintahana hagarëhagarë chö öbhögöe. Ëntahana ëno yarobheeyë ëyö yahagaachëröë bhöhëa na Rehumu ömoona o Bhani, na Hasibhia öno aarëngë ömötangati wi iritënë riö ömöndaara go Keira, naahagaachërë iring'ënga rëno rerëëngë gontahana yaae ëno aarë götangata ëra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichintahana chino chatamërë, nchahagaachëröë na abhantö bhi ichika chaabho. Ëntahana ëno yarobheeyë ëyö yahagaachëröë bhöhëa na Bhabhai ömoona o Henatati öno aarëngë ömötangati wi iritënë rio ömöndaara go Keira. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö në ëno wanyoorrë ëtaachërraini na iritara ri ibhiögë kurukunano rö öbhögöe, nayo yaahagaachëröë bhöhëa na Eseri ömoona o Yosua ömötangati o Misibha. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yaroobheeyë ëyö gukurua gönsonkuno kuhika kögësaku ke Erasibhu, umunchaama ömönene, yaahagaachëröë bhöhëa na Bharuku ömoona o Sabhai. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö yaarëëngë gukurua kögësaku ki inyumba yu umunchaama ömönene, Eriasibhu, köhëkëra masëërra gaayo, yaahagaachëröë bhöhëa na Meremoti, ömoona o Uria, möchökörö o Hakosi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhanchaama Bhano Bhahagaachërë Öbhögöe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö yahagaachëröë bhöhëa na abhanchaama bhano wanyoorrë bhaamenyërë guitendeera. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenchamini na Hasubhu, mbaahagaachërë bhöhëa ëntahana ëno wanyoorrë ëtachërraini na inyumba yaae. Asaria, ömoona o Maaseya, ömoona öwa Anania, nabho mbaahagaachërë bhöhëa ëntahana ëno wanyoorrë ëtörraini na inyumba yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua kunyumba ya Asaria kuhika kubhukunano bhö öbhögöe haahagachëröë bhöhëa na Bhinui ömoona o Henatati. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobhëëyë ëyö gukurua gönsonkuno yö öbhögöe na ömoonaara gui inyumba nköraano yö öbhögambi kuhika köhasë hu ubhuriihi, yahagaachëröë bhöhea na Bharari, ömoona o Usai. Bhetaia, ömoona o Bharosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuguturrania na abhakoramërëmo bhë ëhekaru bhano wanyoorrë bhaamenyërë Obheri, mbaahagaachërë bhöhëa ëntahana ëno wanyoorrë ëtaachërraini na Ihita re Manchë, rögörö yö ömöönaara ömötambë.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhahagaachi Bhandë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yarobheeyë ëyö gukurua kömönaara ömötambë kuhika kurugito ro Obheri, yahagaachëröë bhöhëa na abhamenyi bhu umugi go Tekoa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ya Ihita re Bharaasi, yahagaachëröë bhöhëa na abhanchaama bhonsui, këra munchaama naahagachërë ëntahana ëno wanyoorrë ëtaachërraini na inyumba yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satoki ömoona o Imeri naahagaachërë bhöhëa ëntahana ëno wanyoorrë ëtaachërraini ni inyumba yaae. Ëntahana ëno yaroobhëëyë ëyö yahagaachëröë bhöhea na Semaya ömoona o Sekania öno aarëngë umurindi wi Irihita re Rögörö. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yaroobheeyë ëyö në ëno yaarëngë iya kabhërë harë bho, yaahagaachëröë bhöhëa na Hanania ömoona o Seremia bharatuurrania na Hanuni ömoona wa gasansabha o Sarabhu. Mesuramu ömoona o Bherekia, naahagaachërë bhöhëa ëntahana ëno wanyoorrë ëtachërraini ni igisuumwa keee. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ëno yaarobheeyë ëyö, nëno yaarë kurua kunyumba ya abhakoramërëmo bhië ëhekaru na iya abhasuruusia, ëno wanyoorrë ëtaachërraini na Ihita re Bhariihi, ëno yaarëngë hang'i na igisuumua kei igörö göntahana ya mbarëka ya söchë ya rögörö, yaahagaachëröë bhöhëa na Marikiya, öno arë gutura ibhintö bhië ësahaabhu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        }
      ]
    },
