                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.13+DEU.16.14+DEU.16.15"
              },
              "items": [
                {
                  "text": "Ëhë 16:13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayö nëho bhöngöyë keebhörë kendëkërë kugëtabhö ki imigiro iga, ÖMÖNENE naateebhiri Mösa iga, abhantö bhayi bharairania köbhitume gönkaaga yë ësögökörö yu umueri go muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhakaruundia kumigi geebho gionsui na Yerusaremu bharagamba iga, “Genda köbhikerege mörente amatö gë ëmëseituini, ëmëseituini geebhui, ëmëhatasi, amakëndö na ëmëtë gëndë hagarëhagarë korri tökorre ibhitume, keebhörë Amandëko gaköbhööra.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhakaya körenta amatö na këra möntö agakora igitume isikö na kunyumba igörö, isikö yi inyumba yë Ënooköë, kögetöraarë hang'i na Ihita re Manchë na Ihita re Ebharaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaara bhonsui wanyoorrë bhaarua köng'aanyi bhagakora ibhitume bhakamenya mo. Röno ndo robhaayë öro mbere gökömenya köbhitume gukurua gönkaaga ya Yosua ömoona o Nuni. Abhantö mbabhaayë na ëmëgooko bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra rusikö Esira naarëngë köbhasomera ëgëtabhö ki imigiro gë Ënooköë. Mbaakorrë ësögökörö ëyö guchinsikö muhungatë. Kebhörë wanyoorrë bhaaragiirribhua, urusikö ro kanaanai bhagakora umuiraniö ömönene go gösokerria ësögökörö ëyö keebhörë këëragërë.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
