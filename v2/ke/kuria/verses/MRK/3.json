                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "sibhoono örë wonsui aguchuaria Nkoro Nhoreeru tareebheröa hai, kugira aakora iriraga re kuya ëyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
