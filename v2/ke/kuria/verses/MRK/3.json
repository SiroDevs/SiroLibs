          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Öbhöheene ndabhateebhia iga, abhantö mbareebheröa amaraga gaabho gonsui hamui na ubhuchuaria bhoobho, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
