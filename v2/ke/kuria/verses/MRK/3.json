          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö naagambërë amang'ana gayö kugira nkanyoora bhagambërë iga, “Naana ikihui.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
