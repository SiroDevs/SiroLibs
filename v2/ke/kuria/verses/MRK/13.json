              "items": [
                {
                  "text": "Yoe 2:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ichinyunyuunyi nchirëgöa kurua kuriöbha, na ichinguru cha igörö kuriöbha nchirisingisibhua. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
              "MRK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 13:26"
          },
          "items": [
