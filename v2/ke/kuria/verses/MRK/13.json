          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.17+MAT.10.18+MAT.10.19+MAT.10.20"
              },
              "items": [
                {
                  "text": "Mat 10:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.11"
              },
              "items": [
                {
                  "text": "Ruk 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Sibhoono bhainyu muiraarërre, kugira mbarëbhahira kubhiina. Möretemoa guchisinagogi; gikugira yaane mmurimëërra mbere ya abhagabhana na abhagambi, korri iga möbhahërëkiri igörö yaane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono umuhiko götaraabha, kuhika igichiiratë kirundibhue guchihamatë chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano bharë bhagoota na köbhahira guchibharasa, mötagaacha köganiagania igörö ya kërë mörëgamba; hano ënkaaga ëëra irihika, muche kögamba ërë yonsui mörëteebhibhua kugira bhainyu tëndinyoora möragamba hai, gëtatiga në Nkoro Nhoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.11",
            "verseOrgIds": [
              "MRK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö narëkobhoosania mura omoobho aitue, na ise narëkobhoosania ömoona waae, na abhaana mbarimökëra abhaibhuri bhaabho na köbhaita. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.22"
              },
              "items": [
                {
                  "text": "Mat 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bhonsui mbarëbharega gikugira yi iriina reene. Sibhoono öno arigumirria kuhika möherio nëwe aarituuribhua.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.13",
            "verseOrgIds": [
              "MRK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikiriirriö kiö öbhösaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
