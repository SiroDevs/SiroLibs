                {
                  "text": "12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "1 Mak 1:54; 6:7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano mörëmaaha ikiriirriö kö öbhösaria kimëërëëyë ahasë hano hatagiitungërë (ömösomi asësöre ëng'ana ëno!) Ngökaaga ëyö, öno ndinyoora arëngë Yutea aache köng'osera guchinguku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.31"
              },
              "items": [
                {
                  "text": "Ruk 17:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na öno ndinyoora arëngë kömösonso gui inyumba atagaacha gösëkëra kuya kuimukia gëntö nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno ndinyoora arëngë möngöndö atagaacha kuya ka kuimukia isumaati yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëhöbhe köbhagaikörö bhano ndinyoora bhanda na bhano ndinyoora bharagonkia guchinsikö chiyö! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motasabha korri amang'ana gayö gatagaacha köbha gönkaaga ya mabheho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Tan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.14"
              },
              "items": [
                {
                  "text": "Öbhö 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira ichinsikö chiyö nchirëbha ichinyaanyi ëno ëtaakabhaayë ho gukurua ëkëbhara geekorröë na Ënooköë kuhika reero, na tëërëbha ho röndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano nkanyoorrë Ömönene ataasuuhiri ichinsikö chiyö, tëmöntö akaahonërë hai. Sibhoono gikugira ya abhaahöroa bhaae, achisuuhia.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        }
      ]
    },
