                }
              ]
            }
          ]
        },
        {
          "text": "“Sibhoono guchinsikö chiyö, nyuma yi isina ëyö, iriöbha ndirisunta, na umueeri tëgörërabha hai, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
