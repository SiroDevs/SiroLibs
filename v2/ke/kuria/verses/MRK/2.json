              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhateebhia iga, “Ësabhatö yaakörröe gikugira yömöntö; si tömöntö gikugira yë Ësabhatö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Ömoona wö Ömöntö nëwe arëngë Ömönene wë Ësabhatö.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.28",
