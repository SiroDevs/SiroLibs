{
  "id": "GAL.1",
  "number": "1",
  "bookId": "GAL",
  "reference": "Abhagaratia 1",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "GAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyarubha kurua harë Bhauro ömötömöa, öno ëmbërëkëra yaae ëtaaruurë köbhantö gösë iga yaaheteeyë kömöntö, gëtatiga nharë Yesö Kiristö yaaruurë na kö Ënooköë Taata öno aamuriuukiri kurua köbhaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni hamui na abhakumia bhano töönabho hano törandëkëra ichikanisa chonsui chino chirëngë Garatia: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Ënooköë Taata weitö na Ömönene Yesö Kiristö abhahe ësaramita na ömörembe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristö naairuusiri umuene gikugira ya amaraga gaitö korri iga atutuuri kurua gökëbhara ikinyanku këno ke bhoono gököreng'aana na bhööra Ënooköë Taata weitö agutuna. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhuhiku bhöbhe kö Ënooköë kuya ëyö na ëyö Amina.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igichiratë kimui",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkörögööra ndë iga ënkaaga në ënke igo ëno yaahetërë, mootangërë gutiga öno aabhabhërëkëëyë gö ësaramita ya Kiristö möragoota igichiratë ëkëhagarë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheene tëmang'ana amaiya gandë gaaho hai, si abhantö mbaaho bhano bhagutuna köbhachinchikania bharasaacha köhönchöra Igichiratë ge Kiristö. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ninyoora mbaitö gösë ömömaraika kurua kuriöbha akaabhateebherria igichiratë këndë këno gëtarë këëra tobhateebherreeyi, kuhika ömöntö öyö aihiimue. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toisa köbhateebhia, na bhoono guiki ndarëngëra; ömöntö örë wonsui öno arabhateebherri igichiratë gë ëteemo yëndë hagarë na gaara toobharundiiyi, kuhika aihiimue! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono hayö na abhantö ngutuna iga bhanyitabhirri gösë në Ënooköë? Gösë na abhantö ngutuna ntegeri? Hano ndanyoore na abhantö ngötegeria, tënkabhaayë ömökoramërëmo wa Kiristö.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keebhörë Bhauro abhaayë Ömötömöa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö nënkahanchërë mömanyërë iga Igichiratë këëra naabhateebherreeyi, tiiga na amang'ana ga abhantö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tënaaganyoorrë kurua kömöntö hai, gösë iga naigiibhui na ömöntö hai, gëtatiga ngököhetera gököhönyöröa kurua harë Yesö Kiristö. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Ama 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira moisa kuigua möna naamenyërë karai hayö nkaaga naarëngë gutiini yi Ikiyahuti, möna nairiirri ëkanisa yë Ënooköë ntaana maabhë na ngatuna iga isike kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Ama 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naakërrë abhamura bhi iriköra reene abhaaru kömang'ana gi Ikiyahuti, na amang'ana ga bhaguuka bhaitö nnaagagootërë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6"
              },
              "items": [
                {
                  "text": "Ama 9:3-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.6+ACT.22.7+ACT.22.8+ACT.22.9+ACT.22.10"
              },
              "items": [
                {
                  "text": "22:6-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.13+ACT.26.14+ACT.26.15+ACT.26.16+ACT.26.17+ACT.26.18"
              },
              "items": [
                {
                  "text": "26:13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono Ënooköë gö ësaramita yaae naanyahööyë nkiinya ntaraibhöröa, akambërëkëra iga mökorre ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano aakengërë ikiina iga ahönyöre ömoona waae harëuni, korri iga nteebherri Igichiratë igörö yaae köbhantö, tënaabhuurri möntö örë wonsui iga anteebhi möna ngaakora hai, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na guiki tënaagëëyë Yerusaremu kömaaha bhaara bhaabhaayë abhatömöa uni ntaraabha hai, gëtatiga na Arabhia naagëëyë, sooki nkaringa Tamesike. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.26+ACT.9.27+ACT.9.28+ACT.9.29+ACT.9.30"
              },
              "items": [
                {
                  "text": "Ama 9:26-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyuma yë ëmeeka ëtatö nëho bhoono naagëëyë Yerusaremu kömaahana na Bhetero, nkabhëëra ho ichisikö ikumi na isaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënaarööchë mötömöa wöndë örë wonsui hai, gëtatiga Yakobho mura omoobho Ömönene bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano nköbhandëkëra Ënooköë namanyërë iga ta agö öbhörongo hai! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haakurua nkaya göntahana ya Samu na Kirikia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö tëwanyoorrë ndaamanyöa na kömaahoa na abhantö bhi ichikanisa cha Kiristö chino chirëngë Bhuyahuti hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëtatiga nu ukuigua bheene bhaarë kuigua iga, “Ömöntö ööra aaya aratuiriiria, reero ngöteebherria arë ubhukumia bhööra bheene aarë gösaacha gusikia.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbaagöngërë Ënooköë gikugira yaane.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.24",
            "verseOrgIds": [
              "GAL.1.24"
            ]
          }
        }
      ]
    }
  ],
