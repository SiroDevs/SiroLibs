              "GAL.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.11.30"
              },
              "items": [
                {
                  "text": "Ama 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyuma yë ëmeeka ikumi na ënai nnaagëëyë Yerusaremu guiki tööna Bharinabha, na nnaaimukiri Tito tökaya nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaagëëyë gikugira yö ököhönyörröa köno naahaayöë, na nkagamba bhörabhu (sibhoono mbarëka gukibhisërë mbere ya abhatangati) iga Igichiratë këno ngöteebherria köbhantö. Nnaakorrë igo korri iga ëmërëmo geene gëno wanyoorrë naakora gösë gëno ngökora bhoono gëtagaacha köheta bhuchua. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ninyoora Ntito, murikia waane öno toörëngë hamui, taahamirriibhui iga asaaroe hai, ninyoora aarëngë Umugiriki. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono mbaarëngë ho abhakumia bhö öbhörongo, bhano bhaasohërë guikomo reitö gukibhune iga bhanyoore ëng'ana igörö yö öbhötachöre bhoitö bhörë töönabho harë Kiristö Yesö. Mbaarë gutuna iga bhatökore abhagöre. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö tëtoitabhërraini nabho ninyoora ngönkaaga nke hai korri iga möbhe na öbhöheene bhui Igichiratë ruiso ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Ëhë 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono abhantö bhano bhakömaahëkana iga na abhatangati hano ndanyoore maheene niigo bhaarëngë gösë tiigo, harëuni tëgëntö hai, kugira Ënooköë tagökenga kiina gökömaahërra amang'ana ga këbhara hai abhantö bhano tëbhaarëngë na itegeerro re kunyengeria hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuibhaga rëyö mboongööyë iga Ënooköë wanyoorrë antömërë göteebherria Igichiratë köbhantö kehaara bheene wanyoorrë Bhetero aatömöa göteebherria kö Abhayahuti, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ööra bheene aahaayë Bhetero ögötöra gököbha ömötömöa kö Abhayahuti nëwe bheene aang'aayë ögötöra gököbha ömötömöa kö Abhahamatë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yakobho, Bhetero na Yohana bhano bhaarëngë imitimö bhaarööchë ësaramita ëno naahaayöë, bhagatöha ököbhoko tööna Bharinabha gökoorokia öbhögootainë. Bhaitö tökaya kö Abhahamatë nabho bhakaya kö Abhayahuti. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatötëgëra ëng'ana imui; iga töhëëtöke bhano bharëngë abhataka, na ëyö niyo naarëngë gutuunya gökora ruiso ronsui.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro arang'oonera Bhetero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano Bhetero aachërë Antiokia, naamuruusiri amasörö kugira wanyoorrë asaria. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeembërë nkaaga abhantö bhandë bhano wanyoorrë bhaatömëröë na Yakobho wanyoorrë bhataraacha, Bhetero wanyoorrë ngösanga arë na Abhahamatë. Sibhoono hano bhaahikërë, Bhetero naahaatëëyë gösanga nabho kugira nobhoherë bhaara bhasaarröë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhandë nabho mbaaitabhërrainë na Bhetero ku ubhuiteerri bhöno bhönga bhöyö, Bharinabha nu umui waabho aarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naarööchë iga ënchëra yaabho tiyaarëngë ëndöngë gököreng'aana na Igichiratë, naateebhiri Bhetero mbere ya abhantö bhonsui iga, “Uwe nu Umuyahuti örë si nömenyërë kiö Ömöhamatë, tömenyërë kiu Umuyahuti hai, bhoono niyekë ögökora örahaamirria Abhahamatë iga bhamenye kia Abhayahuti?”",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhayahuti na Abhahamatë ngutuuribhua bharë kubhukumia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhöheene bhaitö gukuibhöroa na Abhayahuti törë, tiiga “Na Abhahamatë abhanyamaraga hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Sab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.20"
              },
              "items": [
                {
                  "text": "Rum 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.22"
              },
              "items": [
                {
                  "text": "Rum 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono ntömanyërë iga tëmöntö akaabharröa öbhöröngë gököreng'aana na imigiro hai gëtatiga nkugukumia Yesö Kirisitö. Na bhaitö bhonsui, Yesö Kirisitö tookumia tökamanya köbharröa öbhöröngë, tuukuiguëra imigiro hai. Kugira tëmöntö arëbharröa öbhöröngë gukuiguëra imigiro hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono bhaitö hano ndanyoore kögökora ömökëa iga töbhe abharöngë gönchëra ya Kirisitö, töramaahëkana iga na abhanyamaraga törë, hayö nko kögamba iga, Kirisitö nguitabhërrania arë na iriraga? Tigo röndë hai! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore nköhagaacha ndë kërë naisa götëmöra, köhayö nköherekia ndë iga nömösaria ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö yi imigiro, naisa gukua – imigiro geenyita – korri iga mmenye gikugira yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni na Kirisitö tobhamböa kömösarabha, köhayö tuuni mmenyërë guiki hai gëtatiga Kirisitö amenyërë mönsë yaane. Irimenya rëno mmenyërë bhoono, nku ubhukumia mmenyërë bhö Ömoona wë Ënooköë öno aanhanchërë na kuiruusia gikugira yaane. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingutuna götööra mbarëka ësaramita yë Ënooköë hai. Sibhoono hano ndanyoore ömöntö nguitabhirribhua arë mbere yë Ënooköë köhetera kumigiro, hayö nkoorokia kërë iga Kirisitö mbuchua aakuurë!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
