      },
      "items": [
        {
          "text": "Bhasiti ömökari wö ömögambi arateeyëra ömögambi Ahasuero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
