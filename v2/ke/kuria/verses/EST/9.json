        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhayahuti bharasikia abhabhisa bhaabho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö ro ikumi na gatatö ru umueri go ikumi na kabhërë, nko ökögamba iga umueri go Atari, hano rohikërë, urusikö röno ëngamba yö öbhögambi yaarë iga ëhëkëëranibhoe, röno abhabhisa bha Abhayahuti bhaarë guiteng'era köbhatööra hansë yaabho. Si kuibhaga rëyö, Abhayahuti bhakabhakëra. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harë këra umugi kömëndaara giö Ömögambi Ahasuero, Abhayahuti mbaiseemiri bhuuya guitania ömöntö örë wonsui öno agasaachërë köbhanyahaara. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora abhatangati bhonsui bhë ëmëndaara, abhagabhana, abhanene na abhahobhisa bhö ömögambi guiki mbaaturiiyi Abhayahuti, kugira bhonsui mboobhohërë Motekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono Motekai naarëngë ömöntö wi icheewa ënene kunyumba nköraano, na amang'ana gaae gakaraanda kömëndaara gionsui iga ögötöra kooe nkoorë kuiyengeria.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhayahuti mbaasoherreeyë abhabhisa bhaabho ni ichinchonge, bhakabhasincha, bhakabhasikia na köbhakora këbhörë bhaahanchërë.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumugi go Susa haara, Abhayahuti mbaaitërë abhantö amagana ataano (500). ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaaitërë Bharisandata, Taribhoni, Asibhata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhorata, Ataria, Aritata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharimasita, Arisai, Aritai na Waisata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhaana ikumi bha Hamani ömoona o Hametata, umubhisa wa Abhayahuti. Ninyoora niigo tëbhabharoonërë hai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö bheene ömögambi naateebhiibhui öbhooru bho bhano bhaitëröë kumugi ömönene go Susa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömögambi aateebhiri Esita, ömökari wö ömögambi iga: “Kumugi ömönene ugueene Abhayahuti bhaitërë abhantö amagana ataano (500), hamui na abhaana ikumi bha Hamani. Nguitegeerra örë iga niyekë bhakorrë kömëndaara haara! Nkë ugutuna bhoono? Kugira nöraakorröe. Nteebhia, nkë ëkëndë ugutuna na uwe nörahaabhöe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita akagamba iga, “Hano öramaahe iga mbuuya, uwe ömögambi, icho uche witabhirri Abhayahuti bhano bharëngë Susa bhakore keebhörë iriragirriö re reero reerë. Guiki, uruusi ëngamba iga abhaana ikumi bha Hamani bhasuungue kömëtë ge guitëra.” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akaruusia ëngamba iga gayö gakoroe, na irirundiö rëkaruusibhua kumugi go Susa. Abhaana ikumi bha Hamani bhakang'entöa mbere yö ömöng'anyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhano bhaarë Susa bhakairania kurusikö ro ikumi na kanai ru umueri go Atari na bhakang'enta abhantö amagana atatö (300) kumugi go Susa; si tëbharoonërë gëntö hai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhano bhaarëngë kömëndaara nabho guiki mbaiseemiri kuriiha irimenya reebho. Bhagatuuribhua kurua köbhabhisa bhaabho; mbaitërë abhantö bhano bhakaabha ibhiköë mërongo muhungatë na bhataano (70,005), si tëbhaaroonërë gëntö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö ndoorëngë öro ikumi na gatatö ru umueri go Atari. Urusikö ro ikumi na kanai röno roroobheeyë, mbaamunyërë, bhakarökora köbha urusikö röë ëndaagëra na ësögökörö. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Abhayahuti bhano bhaarë kumugi ömönene go Susa mbaairaini hamui guiki kurusikö ro ikumi na kanai, si tëbhaamuunyërë hai. Mbaamunyërë kurusikö ro ikumi na gataano kömëgooko na imiiguano. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Abhayahuti bha ichimberi, bhano bhamenyërë kumugi ëmëke, mbagotereeyë urusikö ro ikumi na kanai ru umueri go Atari kiu urusikö röë ëmëgooko, ësögökörö, ukumuunya na urusikö röno abhantö bhaköhaanërana ibhituho.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësögökörö ya Bhurimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motekai naandëkërë amarichokero gano, na agatöma ichinyarubha kö Abhayahuti bhano bhaarëngë kömëndaara gionsui giö Ömögambi Ahasuero, bhonsui bhano bhaarëngë hang'i na harai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatunërë iga këra mooka wa bhagootë urusikö ro ikumi na kanai na öro ikumi na gataano ru umueri go Atari. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti mbaakërrë abhabhisa bhaabho guchinsikö chiyö, na kumueri göyö amaachiichi gaabho ngaahönchöyöë köbha ëmëgooko, na inyanko yaabho ëkabha ësögökörö. Mbaaragainui kuya bharahëëtöka ichinsikö chiyö kögökora ëndaagëra na ësögökörö, gököhanerana ibhituho bhi bhiakörëa na köha abhahabhë ibhintö.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhayahuti mbaaitabhërraini gökora keebhörë bhaatangërë na kehaara Motekai aabhandëkëëyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani ömoona o Hametata, öwa Agagi na umubhisa wa Abhayahuti wöanyoorrë aarëa inikö ya gusikia Abhayahuti, guiki wanyoorrë akora Ibhuri, ësësöro yaayo niiga ëgëkoobhöe, korri aahöre urusikö ro kuminyongora na gusikia Abhayahuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano Esita aagërëëyë ömögambi, ömögambi nawe naaruusiri ëngamba kö Amandëko iga inikö ëmbëëbhë ëëra wanyoorrë Hamani aakora guisiira Abhayahuti imunyoore we umuene; na abhaana bhaae bhaitoe kugusuungua kömötë go guitëra. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, ichinsikö chiyö nchaabhërëkëëyöë iga Bhurimu, gukurua köng'ana iga bhuri, ësësöro yaayo niiga ëgëkoobhöe. Gikugira yi inyarubha ya Motekai na amang'ana gano bhaarööchë abhiene na gaara gaabhanyörrë, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti mbaarökorrë köbha umugiro ömönene harë bho, köbhaibhöröa bhaabho na kömöntö örë wonsui öno akagootaini nabho, iga gönkaaga inuhe këra mooka bhatasinyërë, ichinsikö ibhërë chiyö chigootöe gököreng'ana na amarigirriö ga Motekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki mbaaitabhërraini iga Abhayahuti bhonsui kömaköra gonsui këra möndaara na umugi kuhika bhahiite ichinsikö cha Bhurimu na guchikorra ësögökörö ruiso ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Esita, ömökari wö ömögambi umuisëkë wa Abhihairi, akandëka inyarubha kögötöra kooe gonsui, hamui na Motekai Umuyahuti köherekia gaara Motekai aandëkërë ëkëmbere hayö kuguitung'ana na Bhurimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyarubhai ëyö yaandëkëëyöë Abhayahuti bhonsui, na ichikobhi chaayo chikahirua kömëndaara gionsui irigana rimui na mërongo ëbhërë na muhungatë (127) giö öbhöbhaahi bho Ahasuero. Inyarubhai ëyö yaatönëëyë Abhayahuti ömörembe na ëgaareeya, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na köbhasimisiria iga bho na abhaibhöroa bhaabho bhagoote ichisögökörö cha Bhurimu gönkaaga yachio inuhe, kehaara bhaarë köhëëtöka imigiro gë guisasa ënkaaga ya kong'uunya. Amaragirriö gano ngaaruusiibhui kö Abhayahuti na Motekai, Umuyahuti, hamui na Esita ömökari wö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëngamba ya Esita ëkaherekia amang'ana gayö ga Bhurimu; ëkandëköa kögëtabhö.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
      ]
    }
