              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore abhantö ikumi bhatamërë kunyumba imui, mbarakue bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano ömöntö waabho umukuurei ööra araache kurichokia ikihundugu këbhara iga agësambe, abhuuri örë wonsui öno ndanyoore arëngë mbarëka, “Gösë möntö wöndë mööna we möno?” Nawe naramuhunchukiri iga, “Tiga! Taaho hai!” Nawe naramöteebhi iga, “Kira iga kiri! Tötagaatara ninyoora ni iriina riö ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
