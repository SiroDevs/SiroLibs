        },
        {
          "text": "Bhainyu bharë Bhaisiraeri, mötaigua ëng'ana ëno ÖMÖNENE agambërë igörö yeinyu, bhainyu ëhamatë ingima ëno aaruusiri gönsë ya Misiri:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmërëmo giö ömönaabhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ugusikibhua go Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
