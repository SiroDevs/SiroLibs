                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Ëhë 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yos 8:33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano möraise köröbhöka ömooro go Yorotani, ibhiaro bhino mbiraimëërre igörö yi inguku ya Gerisimu na guitabhiria abhantö: Simioni, Rawi, Yuta, Isakari, Yusubhu na Bhenchamini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ibhiaro bhino mbiraimëërre igörö yi inguku ya Ebhari ënkaaga ëno imiihiimo gikurusibhua Rubheni, Gati, Aseri, Sabhuroni, Tani na Nabhutari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharawi nabho mbararundiri abhantö bhonsui bha Isiraeri köngamba ënene:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
