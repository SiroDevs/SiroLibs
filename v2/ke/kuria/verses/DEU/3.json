              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Yos 1:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gönkaaga ëyö nkabharagirria ndagamba iga, ‘ÖMÖNENE, Ënooköë weinyu abhahaayë ënsë yië ëntahana ya rögörö rö ömooro go Yorotani ëbhe iyeinyu. Bhoono mbe, manörra abhaitani bhainyu na möbhatöme bharöbhöke ömooro go Yorotani mbere yi ibhiaro bhia Abhaisiraeri, bhabhatuurri bhaigari ënsë yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhakainyu, abhaana bhainyu ni ichitugo cheinyu, nëmanyërë iga moona ichitugo ichincharu, nchiratigare kumigi gëëra naabhahaaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuurria Abhaisiraeri bhainyu kuhika röno ÖMÖNENE arëbhaha ahasë haabho nabho bhatënde kehaara na bhainyu mootënda, nkö ökögamba iga nabho bhaigari ënsë ëno ÖMÖNENE, Ënooköë weinyu aköbhaha ihumbu ëëra ya Yorotani. Gösookia hayö, nëho möraringe gönsë yeinyu ëno mbahaaye ëbhe iyeinyu!’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua nkabhöörra Yösua iga, ‘Örööchë umuene na amaiso gaao keebhörë amang'ana gonsui gano ÖMÖNENE, Ënooköë waao aakoreeyë abhagambi bhabhërë bhano Sihoni na Ogu; bhöyö bheene mbo arakorrë abhagambi bhi ichinsë chonsui chino mörahete. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge köbhoobhoha kugira ÖMÖNENE, Ënooköë weinyu nëwe arabhaitanërë.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mösa ararekibhua gösoha Kanaani",
          "type": "text"
        }
      ]
    },
