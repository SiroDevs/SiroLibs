        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ndanyoore ibhiina ibhikong'u bhibhaayë ho, bhino abhakengi bhainyu bhataatöre gökenga; ibhiina bhianga: Ökoohokania öwöndë na öwöndë igörö yi ibhintö, gösë ibhia kunyahaaröa, gösë ibhiina bhino bhigutuna ökoohokania kuguita ömöntö göseemi na uguita ömöntö köno götare ögöë ëseemi. Hano keebha igo muya ahasë hamui ahagösengera hano ÖMÖNENE, Ënooköë weinyu ahöra, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hayö muhire ikiina këyö kö abhanchaama bha Abharawi, na kömohokania öno arëngë körörengo gönkaaga ëyö, mutige bhakenge ikiina këyö. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua mökore keebhörë bhakengere ikiina këyö kurua köhasë haara Ömönene ndanyoore aahööyë; muimaherre gökora gonsui gaara bhagambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëragëre gökora keebhörë bharabharongoche gököreng'aana na öbhökeengi bhoobho bhui ikiina harë bhainyu. Mötagaacha konga köhëkëërania öbhökeengi bhui ibhiina bhöno möteebhiibhue. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ömöntö örë wonsui öno atagösööka umunchaama gösë ömohökania öno aatöörröe kögökorra ÖMÖNENE, Ënooköë weinyu, ömöntö öyö niiga aitöe. Igö nëho mörasooki ubhunyaku kurua harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui araigue igo naroobhohe, na tëmöntö örë wonsui arasaache gökora igo guiki hai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirrio igörö yö omögambi",
          "type": "text"
        }
      ]
    },
