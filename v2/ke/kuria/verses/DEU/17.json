              },
              "items": [
                {
                  "text": "Ibr 10:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninyoora niigo, naraitoe hano ndanyoore öbhöherekia bhua abhantö bhabhërë gösë bhatatö bhööho. Atagaitoa hano ndanyoore nö öbhöherekia bhö ömöntö umui bhööho bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Ko 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaherekia bhaara mbo bharatangate kömötema na amagëna nëho abhantö bhandë bhararoobhere. Niigo, mörasooki ubhunyanku harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
