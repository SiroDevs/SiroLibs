            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.19"
              },
              "items": [
                {
                  "text": "Ama 13:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ÖMÖNENE, Ënooköë weinyu, ërëbhahiki gönsë ëyö mukuya kömenya, narërugia ichihamatë ichincharu kurua gönsë ëyö. Hano mörësoha narërugia ichihamatë muhungatë ichiinene chino chiina ichinguru köbhakëra: Abhahiti, Abhagirigasi, Abhaamori, Abhakanaani, Abhabherisi, Abhahibhi na Abhayebhusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ÖMÖNENE, Ënooköë weinyu arëbhaheebherria ichihamatë chino muchikere na guchisikia kimui, mötagaacha gökora imuuma ërë yonsui gösë köbha na amaabhë nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagatetana nabho, gösë gutiga abhaisëkë bhainyu bhatetöe nabho, gösë abhamura bhainyu göteta ho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano mörakore igo mbarahotoki abhaana bhainyu bhange gösöörana ÖMÖNENE, bhabhakore bhasengere ichinooköë chindë, nö öbhörrö bhö ÖMÖNENE mbörabhaimökëre, na igo narabhasiki hare rimui. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.3"
              },
              "items": [
                {
                  "text": "Ëhë 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö mötëmöre amakëngë gaabho, mönyeregani imitimö geebho gia amagëna, mökengekenge ibhihooru bhë ënooköë waabho Asera na gösamba ibhihooru bhiabho bhia köbhaachöa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
