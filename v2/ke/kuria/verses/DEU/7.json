          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15+DEU.11.16+DEU.11.17"
              },
              "items": [
                {
                  "text": "Ëhë 11:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano möraigue amaragirrio gano na kögasööka köbhöheene, hayö ÖMÖNENE, Ënooköë weinyu naragenderri köhekëërania imuuma yaaë na öbhöhanchi öbhögöme harë bhainyu bhöno aaragaini bhaguuka bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narabhahanchë na köbhaitabhiria, na bhainyu möraiyengeri na köbha nu uruibhöro örooru; naraitabhiri ëmëgöndö geinyu, körri munyoore ibhiaköre, itibhaai, na amaguta; narabhaitabhiri gököbhaha iching'ombe na amang'ondi amaaru gönsë ënö aragaini bhaguuka bhainyu iga naarabhahe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möraitabhiribhue gökëra abhantö bhandë bhonsui gökëbhara. Harë bhainyu tëmökari gösë mösaacha aragömbahe, gösë ichitugo cheinyu köbha ichintëbhahai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE narabhaheniri amarooyi gonsui amabhëëbhë na tëmarooyi garë gonsui amabhëëbhë ke gaara ganyoorrë Abhamisiri garabhanyoore hai, kugira naragahumbi kuya kööbhabhisa bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musiki ëhamatë ërë yonsui ëno ÖMÖNENE, Ënooköë weinyu arabhahebherri, mötagaacha kögëmaahera amaabhë, gösë gösengera ichinooköë chaabho, kugira ëng'ana ëyö niyo ëraabhe ömotego harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
