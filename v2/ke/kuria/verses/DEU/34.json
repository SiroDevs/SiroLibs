          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Ëgt 33:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Sir 45:1-5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi ke Mösa takabhaayë Isiraeri guiki hai, öno ÖMÖNENE aasumaachërë nawe bhitachërraini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëmörooti wöndë aho hai, öno aakörrë ibhimanyiirriö ni ibhirögööro ibhinene ke bhiira ÖMÖNENE aatömërë Mösa agakora harë Bharao ömögambi o Misiri, abhakoramërëmo bhaae na ënsë yaae yonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taaho ömönaabhi wöndë hai, öno aakorrë amang'ana amarito na agakoobhohia ke gaara Mösa aakörrë mbere ya Abhaisiraeri bhonsui.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
