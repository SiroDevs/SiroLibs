                {
                  "text": "Ëbh 28:26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Möbharë imikubhio muhungatë gukurua gönkaaga ëno mötangërë kögësa ibhiaköre, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na hakurua mökore ësögökörö yi irigesa kögösööka ÖMÖNENE, Ënooköë weinyu, gukuruusia ësataaka ya kimuguuni, gököreng'aana keebhörë ÖMÖNENE, Ënooköë weinyu aköbhaitabhiria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mörachënge mbere yö ÖMÖNENE, Ënooköë weinyu, bhainyu hamui na abhaana bhainyu bhë ëgësaacha na ëgëkari, ömökoramërëmo wë ëgësaacha na ömökoramërëmo wë ëgëkari weinyu, Ömörawi, abhahamatë, ichitankaana hamui na abhasino bhano bhamenyërë na bhainyu. Mörakore gayö köhasë hamui ha gösengera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möhëëtöke iga moorëngë abhagöre gönsë ya Misiri, igo mömaaherre gösööka imigiro gëno.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
