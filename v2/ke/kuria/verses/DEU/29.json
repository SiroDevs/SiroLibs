              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30"
              },
              "items": [
                {
                  "text": "Ëbh 21:21-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Ëbh 21:31-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na hano moohikërë ahasë hano, ömögambi Sihoni wa Hesiboni na ömögambi Ogu wa Bhasani mbaachërë gutuitania; sibhoono tökabhahicha, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Ëbh 32:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tökaimukia ënsë yaabho, tögatuenania ëhamatë ya Rubheni, Gati na iritënë rë ëhamatë ya Manase köbha ömöndö goobho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö muimaahërre kögoota amang'ana gonsui gë imuuma ëno korri mmösaaraare kömëkërë geinyu gionsui.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Reero muimërëëyë mbere yö ÖMÖNENE, Ënooköë weinyu, bhainyu bhonsui abhatangati bhi ibhiaro, abhagaaka na abhanene bhainyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhaana bhainyu na bhakainyu, abhahamatë bhano bhamenyërë harë bhainyu bhano bhaköbhateenyera ichinkui na köbhatahëra amanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mörëngë hano reero korri mökore imuuma ëno ÖMÖNENE, Ënooköë waao agökora reero, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga reero abhaherekiri köbha abhantö bhaae, nawe köbha Ënooköë weinyu, ke bhööra aaragaini na bhainyu na bhaguuka bhainyu: Ibhurahimu, Isaaka na Yakobho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tëngökora imuuma ëno nu ugutuenerria köno na bhainyu abhiene hai, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga guiki nkuibhaga re bhaara bhatarëngë hamui na bhaitö reero röno mbere yö ÖMÖNENE, Ënooköë weitö.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mömanyërë bhörë toomenyërë gönsë ya Misiri na keebhörë tögendërre köhetera guchihamatë chindë. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moorööchë ibhihooru bhiabho bhia kuriirria, ichinooköë chë ëmëtë na amagëna, cha amatiini gi ichimbiria na ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.15"
              },
              "items": [
                {
                  "text": "Ibr 12:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muimaahërre bhökong'u korri atagaacha köbha ho mösaacha, mögaikörö, möntö wë ëka yeinyu gösë ikiaro kërë gionsui öno aimërëëyë hano reero röno ahotoke kurua kö ÖMÖNENE, Ënooköë weitö, na kuya kumuensera ichinooköë chi ibhiaro bhindë. Ëng'ana ëno nëraabhë kiu umuri göno göramere na kooma amakö amarörö gano gaana öbhösöngö. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui asookiri kuigua amang'ana gë imuuma ëno möragëröë, hakurua aing'aine kömooyo gooe na kögamba iga naratame bhöhoru, ninyoora ndageenda köbhöhotoku bhoone umunyene, ëyö nërabhasiki bhonsui, abhabhëëbhë na abhaiya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE taraabhëre ömöntö öyö hai, nö öbhörro bhö ÖMÖNENE ni irihari reee mbiraimökëre ömöntö öyö; imiihiimo gëno gionsui gendëkëröë kögëtabhö këno ngëramögoote, ÖMÖNENE nawe narahute kimui iriina riö ömöntö öyö kurua gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE naramugirani ni ibhiaro bhionsui bhia Abhaisiraeri anyooroe në ëtabhaarabhaaria köreng'aana na imiihiimo gionsui gë imuuma gëno gendëkëröë kögëtabhö këno ki imigiro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömaköra gainyu gano gaaguucha, abhaana bhainyu në ëhamatë kurua kubhiaro bhia harai mbarëmaaha keebhörë ÖMÖNENE arenteeyë ënsë ëno ëtabhaarabhaaria ni inyanko; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Ögt 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ichööyë öbhösöngö bhui ikibhiriti na ömöönyö, ësaambëröë na köbha inchua, tiyaimibhua ntetere na tëëkömëra kërë gionsui hai. Hanga kurua yatuubhana gë ënkaaga ëëra ÖMÖNENE aasikiri Sotoma na Gomora, Atima na Sebhoimu, köbhörrö na ubhusinanku bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ichihamatë chonsui nchiragambe iga, ‘Kugira kë ÖMÖNENE akoreeyë igo ënsë ëno? Öbhörrö öbhönene bhöno igo ëkëmanyiirrio keebho nkë?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na irihunchukio ndëraruusibhue iga, ‘Ngikugira mbaatigire imuuma yö ÖMÖNENE, Ënooköë wa bhaguuka bhaabho ëno aakorrë nabho hano aabharuusiri gönsë ya Misiri, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhakaya kumuensera na gösengera ichinooköë chindë, chino bhataamanyërë gukurua karai, ninyoora nö ÖMÖNENE tëwanyoorrë achibhahaayë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö öbhörrö bhö ÖMÖNENE bhökaimöka igörö yë ënsë ëno, na akagërentera imiihiimo gionsui gëno gendëkëröë kögëtabhö këno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE nawe akabhasonsomora kurua gönsë yaabho köbhörrö na ubhusinanku, akabhatabhuta guchihamatë bhindë ke bhöyö reero kërëng'ëngëëyë.’”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amang'ana giikibhisëre na agö ÖMÖNENE, Ënooköë weitö, sibhoono gara ahönyöra na agaitö na uruibhöro roitö kuya ëyö, korri tökore amang'ana gonsui gi imigiro gëno.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.29"
            ]
          }
        }
      ]
    }
