            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tegeerra bharë Bhaisiraeri! ÖMÖNENE, Ënooköë weinyu, nö ÖMÖNENE umui. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
