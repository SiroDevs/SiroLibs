            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Monga gösaacha ÖMÖNENE, Ënooköë weinyu kehaara momösaachërë mörëngë Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herekia iga mösöökërë amarago gö ÖMÖNENE, Ënooköë weinyu, amaiguerrano ni imigiro gëno abhasimisiiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökore gano gagötegeria ÖMÖNENE, körri möbhe në ëmësaaraaro. Hayö ho möratöre kuigaria ënsë inchiiya ëëra ëno ÖMÖNENE aragaini köha bhaaguuka bhainyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na möraarugi abhabhisa bhainyu, kehaara ÖMÖNENE abharagaini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
