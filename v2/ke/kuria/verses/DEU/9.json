              "items": [
                {
                  "text": "Ibr 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hano ÖMÖNENE aabhatömërë kurua Gatesi-bharënea aragamba iga, ‘Taya muigari ënsë ëno mbahaayë,’ mootëëyëyë ÖMÖNENE, Ënooköë weinyu, tëmookumiri gösë gösööka gaara aabhateebhiri hai. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu na abhateeyu mörë kö ÖMÖNENE gukurua urusikö röno naabhamanyërë.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
