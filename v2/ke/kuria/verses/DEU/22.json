          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömösaacha aranyoore umuisëkë öno agambëröa öbhököë, araare nawe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mörabharichoki bhonsui bhabhërë këbhara yi irihita riu umugi na köbhatema na amagëna kuhika bhakue. Umuisëkë öyö kuhika aitöe gikugira takuurrë ikuuratë iga atuuribhue ninyoora nkumugi gu ubhusuruusia aarëngë; nö ömösaacha kuhika aitöe gikugira asarri ömögambëröa bhököë wö ömörobheri waae. Nigo mörasooki ubhunyanku harë bhainyu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
