          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ömöntö öno aragootoe ikiruugi na ömökari wö ömöntö, bhonsui bhabhërë, ömösaacha na ömökari, kuhika bhaitoe. Nigö mörasooki ubhunyanku bhöyö harë bhainyu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
