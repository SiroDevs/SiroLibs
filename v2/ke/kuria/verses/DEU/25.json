            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Möhëëtöke bhörë Abhaamareki bhaabhakorre hano moorëngë körögendo kurua Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
