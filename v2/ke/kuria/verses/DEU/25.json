        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mökorre ibhirengo na ibhitimo bhiu ubhurito bhöno bhöragërë, korri mötörë kömenya ichinsikö ichincharu gönsë ëyö ÖMÖNENE, Ënooköë weinyu aköbhaha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui bhano bhaagökora amang'ana ke gayö, bhonsui bhano bhaagökora köbhörongo ni ikiriirriö kö ÖMÖNENE, Ënooköë weinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
