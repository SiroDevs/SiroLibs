            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ndanyoore abhantö bhabhërë bhana irigamba, na bhayi köbhakengabhiina, umui amaahëkane iga taana isaria, nö wöndë akeengeroe ikiina köbha ömösaria, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano ndanyoore ööra akengeeyoë ikiina iga ni ichisahi aratemöe, ömökengi wi ikiina naramöteebhi araare hansë na götemöa ichisahi gököreng'aana ni irisaria reee. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Ko 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömösaria aratöra nagatemöa ichisahi mërongo ënai, sibhoono chaange köheta. Hano möraheti ëkërengere këyö nëndanyoore muchuniri mura ömoinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
