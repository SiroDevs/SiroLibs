                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Monge köbha na ibhirengo bhia körengera ichiteemo ibhërë: Ikimui ikirito na ëkëndë ëkëhöhö. Monge gökoorra ibhitiimo bhiö öbhörongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki monge köbha na ibhirengo bhi ichiteemo ibhërë bhia körengera, ëkënene në ëgëke.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        }
      ]
    },
    {
