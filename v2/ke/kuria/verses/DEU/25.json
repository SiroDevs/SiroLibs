              "items": [
                {
                  "text": "1 Tim 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Wange köbhohera ëntang'ana ëgëtange kumunyua hano ëköhööra ibhiakörea.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
