    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubhuitungua bho mura omöbho ömöntö harë möka mura omöbho ono akua",
          "type": "text"
        }
      ]
    },
    {
