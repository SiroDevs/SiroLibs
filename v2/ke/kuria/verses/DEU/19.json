              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Monge kuruusia ho ibhimanyiirriö bhë ëmëbhaga gia abharobheri bhainyu, gëno gëëtöörröë karai hayö gönsë ëno ÖMÖNENE, Ënooköë weinyu aköbhaha kuigaria.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
