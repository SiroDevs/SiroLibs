        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.29"
              },
              "items": [
                {
                  "text": "Ëgt 34:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore öbhökori bhu uruku röno roondëkëröë na kunyamöa guchimbaarao cha amagëna, bhoochërë ku ubhuhiku, nabho bhögakora Abhaisiraeri bhakanga götöra götaacherrana na Mösa, gikugira yö öbhöbharruku bhu ubhusiö bhooe nabho mböno bhoorë gusira; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyekë bhoono, öbhökori bhö Nkoro, bho tëbhöraabhe na ubhuhiku öbhönene bhökong'u? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore ubhuhiku mboorëngë köbhökori bhööra bhui imiihiimo; niyekë mbe öbhökori bhööra bhökörenta öbhöheena tëbhöraabhe na ubhuhiku öbhönene bhökong'u? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Töratöra kögamba igo gikugira ubhuhiku bhööra bhoobharrukiri karai bhooheta, bhoono ubhuhiku öbhönene bhökong'u bhobhaayë kuibhaga re bhööra bhoohetërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano ndanyoore ëgëntö këëra keerëngë ho gönkaaga nke igo nkeerë na ubhuhiku bhookio, kuhika këëra këraabhe ho kuya ëyö këbhe na ubhuhiku öbhönene bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ntööna iriteng'ero rëno rënga rëyö, ntööna ubhutirimiku öbhönene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.12",
            "verseOrgIds": [
              "2CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.33"
              },
              "items": [
                {
                  "text": "Ëgt 34:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhaitö titutuubhainë na Mösa, öno aagubhërë ubhusiö bhooe na ëhanga korri Abhaisiraeri bhange kömaaha umuhiko gö öbhöbharruku bhööra keebhörë bhoorë gusira hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheene ëmëtöe geebho ngeeribhëröë; ninyoora nguchinsikö chino ëmëtöe geebho ngikigubhëröë na ëhanga ëëra bheene, hano wanyoora bharasoma ibhitabhö bhi Imuuma Ënkoro. Ëhanga ëyö nkuruusibhua ërë ho hano bheene ömöntö agootana na Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora ndeero, hano wanyoora bharasoma imigiro ge Mösa amaitegeerro nyoora ngagubhëröë na ëhanga ëëra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
              "2CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.34"
              },
              "items": [
                {
                  "text": "Ëgt 34:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono ëratöra kuruusibhua ho, hano ömöntö aihönchöra kuya kö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono niiga Ömönene në Nkoro; na hano Nkoro wö Ömönene arëngë, nëho öbhötachöre bhörëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.17",
            "verseOrgIds": [
              "2CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö bhonsui, bhano amasio gaitö gatagubhëröë, nkoorokia törë ubhuhiku bhö Ömönene ke bhano tukuimaaha gukiimaahëro; nköhönchöröa törë tutuubhane na ituubho yaae ku ubhuhiku bhöno bhukuiyengeria, bhöno bhukurua kö Ömönene, öno arëngë Nkoro.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.18",
            "verseOrgIds": [
              "2CO.3.18"
            ]
          }
        }
      ]
    }
  ],
