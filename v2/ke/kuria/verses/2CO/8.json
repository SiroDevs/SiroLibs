            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.26"
              },
              "items": [
                {
                  "text": "Rum 15:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, ntöhanchërë na bhainyu mömanye ësaramita yë Ënooköë ëno aha ichikanisa cha Maketonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.1",
            "verseOrgIds": [
              "2CO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bho mbaasaacheröë bhökong'u kunyaanyi gëno bhaaheteeyë; sibhoono ömögooko goobho ngööre ömönene bhökong'u nabho bhakabha abhagesa bhökong'u gukuruusia ibhintö bhiabho, ninyoora bhaarëngë abhataka bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.2",
            "verseOrgIds": [
              "2CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhaherekiria iga bho mbaaruusiri ibhiaru möna ögötöra koobho koorë, bhakaruusia ninyoora ngökëra ögötöra koobho, ësataaka ya kimuguuni abhiene, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.3",
            "verseOrgIds": [
              "2CO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabho mbaatögeyërë bhökong'u iga bhahaabhöe iribhaga re köbha hamui köbhökori bhöno bho gutuurria abhantö bhë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.4",
            "verseOrgIds": [
              "2CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëyö yaabhaayë ëng'ana ënene gökëra iriteng'ero reitö! Iya mbere mbaaihaanërë kö Ömönene, na hakurua mbaihaanërë ninyoora harë bhaitö gököreng'aana na keebhörë Ënooköë agutuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.5",
            "verseOrgIds": [
              "2CO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ntoogëyërë Tito, öno aatangërë ömörëmo göyö, gökögenderria nago na iga agötabhuki ömörëmo göyö göbhögesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.6",
            "verseOrgIds": [
              "2CO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmörëngë abhaamë kömang'ana gonsui; ku ubhukumia, gusumaacho, ku ubhunguri, kögooriö yeinyu ku ugutuurria na köbhöhanchi bhoinyu harë bhaitö. Köhayö ngutuna törë guiki iga möbhe abhagesa bhökong'u köbhökori bhöno.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.7",
            "verseOrgIds": [
              "2CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënköbhaha ëngamba yërë yonsui hai, sibhoono ngutuna ndë mbooroki möna abhandë bhaana ëgooriö ya gutuurria, na kömanya öbhöhanchi bhoinyu abhiene hang'ana bhörë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.8",
            "verseOrgIds": [
              "2CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmömanyërë ësaramita yö Ömönene weitö Yesö Kirisitö; keebhörë aarëngë ömoomë, si gikugira yeinyu naabhaayë ömötaka, korri iga abhakore möbhe abhaamë gönchëra yö öbhötaka bhooe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.9",
            "verseOrgIds": [
              "2CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keebhörë nkömaaha köng'ana ëno niiga, mbuuya harë bhainyu mösookirri bhoono gaara mootangërë ömooka göno goosirrë; kugira mmorëngë abhambere, tiiga nkögökora bheene hai, sibhoono ninyoora ngököbha na ëgooriö ya gökora igo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.10",
            "verseOrgIds": [
              "2CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe mösookirri ömörëmo göyö, këbhööra moorëngë na ëgooriö ënene ya gutuurria, na keebhörë moorë göseemia, mökore ömökëa keebho bheene gökërengere ke bhino mönabhio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore öna ömooyo go köhaana, Ënooköë naraitabhiri ikiruusio gököreng'aana na këëra önakio, tiiga nkëëra ötaanakio hai.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö tiiga nkuruusia ndë abhandë ëmësairë hakurua mbatuëke bhainyu hai; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.13",
            "verseOrgIds": [
              "2CO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono köhaara mönabhio köbhooru gönkaaga ëno, mbuuya iga mutuurri bhaara bharëngë abhahabhë; korri iga hano möraabhe abhahabhë nabho unyoore bhaana bhio köbhooru nabho mbarëbhatuurria, na gönchëra ëyö bhonsui mmörareng'aane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.18"
              },
              "items": [
                {
                  "text": "Ëgt 16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Keebhörë ërendëko rëkögamba, “Ömöntö öno aiirri ibhiaru mbiamuisainë, na öno aiirri ibhike, taasöhëëyöë hai.”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tito na bharikia bhaae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ënooköë ahaabhöe umukuimo göököha Tito ëgooriö imui na bhaitö iya köbhatuurria! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.16",
            "verseOrgIds": [
              "2CO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiiga iga naaitabhirriiyi irisabhi reitö bheene hai, gëtatiga iga naana ëgooriö ya köbhatuurria na köbhöhanchi bhooe umuene naakengërë ikiina guucha harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.17",
            "verseOrgIds": [
              "2CO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamui nawe töratöma mura ömoitö umui öno asöökeröe na ichikanisa chonsui kugira yë ëmërëmo geee gukurundia Igichiratë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.18",
            "verseOrgIds": [
              "2CO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tiiga ngayö bheene hai, naahoöyöë na götööröa na ichikanisa iga abhe örögendo rumui na bhaitö nkaaga tukuhira öbhökori bhö öbhogësa gikugira yu ubhuhiku bhö Ömönene, na korri tooroki iga ngutuna törë gutuurria.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.19",
            "verseOrgIds": [
              "2CO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngutuna törë tuimoche amasoro gano garatöre kurichokera igörö yu ubhuimirirri bhoitö gukiruusio këyö kiö öbhögesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.20",
            "verseOrgIds": [
              "2CO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.4"
              },
              "items": [
                {
                  "text": "Ibh 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikibhune geitö nö ögökora gano garëngë amaiya, tiiga në mbere yö Ömönene bheene hai, sibhoono ninyoora nkömaiso ga abhantö.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.21",
            "verseOrgIds": [
              "2CO.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö töratöma mura ömoitö hamui nabho, öno ruiso ronsui tösaacha na köngöra iga naana ëgooriö ku ugutuurria kömang'ana amaaru. Na bhoono naana amaiteng'ero amanene harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.22",
            "verseOrgIds": [
              "2CO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
