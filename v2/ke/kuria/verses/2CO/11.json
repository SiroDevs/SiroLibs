          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gutiga amang'ana ga këbhara, ngaaho gano ga gunsioria ruiso ronsui, ngo öbhömaahirri bhui ichikanisa chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
