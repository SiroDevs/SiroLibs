        },
        {
          "text": "kömërëmo ëmëkong'u na köbhökong'u; gukuhura harë kaaru; kömöramböko na umuihömo; kuguisasa harë kaaru; kömbeho na köbha këng'aabhi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
