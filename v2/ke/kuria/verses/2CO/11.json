        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro na abhatömöa bhö öbhörongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkahanchërë iga mungumirri, ninyoora nköbhökangi bhoone öbhöke igo. Maheene mötangumirria! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.1",
            "verseOrgIds": [
              "2CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nköbhamaahëra ndë irihari rë Ënooköë; kugira bhainyu mönga umisëkë igitindë öno naagambëra öbhököë kömösaacha umui bheene, nëwe Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.2",
            "verseOrgIds": [
              "2CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1+GEN.3.2+GEN.3.3+GEN.3.4+GEN.3.5"
              },
              "items": [
                {
                  "text": "Ögt 3:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nnëëna öbhoobha iga amaitegeerro gainyu ngarachinchikanibhue korri iga mutige öbhösengeri bhoinyu öbhö öbhöheene na öbhörabhu harë Kirisitö, kehaara bheene inchoka yaang'ainërë Hawa köbhöng'aini bhö öbhörongo bhooyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.3",
            "verseOrgIds": [
              "2CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nkuitabhirria mörë bhöngöbhöngö hano möntö örë wonsui acha harë bhainyu na kurundia igörö ya Yesö ömöhagarë na ööra bhaitö toorundiri, gösë ënkoro yëndë ëhagarë na Nkoro ööra moonyoorrë, gösë Igichiiratë ëkehagarë na këëra moonyoorrë!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.4",
            "verseOrgIds": [
              "2CO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.4",
            "verseOrgIds": [
              "2CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëngökanya iga nëndëngë ömöke köbhayö mökömaaha iga mbarëngë abhatömöa abhanene hai! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.5",
            "verseOrgIds": [
              "2CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkanyoora tëmanyërë gusumaacha bhuuya hai, sibhoono nnëëna ubhunguri; ëng'ana ëyö ntöbhoorokirriiyi bhuuya na guchinchëra chonsui na kömang'ana gonsui.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënaabhasabhëre mbiria hano naarundiri Igichiratë kë Ënooköë harë bhainyu hai; nnaisuuseeniri umuene korri iga mbakore abhu ubhuëra. Gösë rëyö ndio reebhaayë iriraga reene? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.7",
            "verseOrgIds": [
              "2CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaaruusiri ichikanisa chindë ibhintö bhiabho köhaara naitabhirriiyi gutuurribhua nabho, korri iga nkore ëmërëmo gatai yeinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.8",
            "verseOrgIds": [
              "2CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15+PHP.4.16+PHP.4.17+PHP.4.18"
              },
              "items": [
                {
                  "text": "Bhi 4:15-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ënkaaga ëno naarëngë hamui na bhainyu na nëëna irituno tënaarë köbhairiiria köbhasabha mbiria hai, gikugira abhantö bhaitö bhano bhaacherë gukurua Maketonia mbaandenteeyë kërë gionsui naarë gutuna. Nnaairarërrëëyë bhökong'u iga ntakaabha ömösairë gönchëra ërë yonsui harë bhainyu, na nigo ndagenderreeyi gökora. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.9",
            "verseOrgIds": [
              "2CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaragana iga, köbhöheene bho Kirisitö bhöno bhörëngë harë uni, iga tëgëntö këëho këno këgaatöra körëbhërra ukuigönga koone köno kong'ana ëyö harë honsui kömöndaara go Akaya hai.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkugira kë nkögamba igo? Ngikugira iga tëmbahanchërë hai? Ënooköë namanyërë iga nëmbahanchërë!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndagenderri gökora garë ngökora bhoono, korri iga ntakaaha abhandë bhaara iribhaga re kuiraha iga nabho ngökora bhare ëmërëmo gönchëra ëëra bheene tögökora. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.12",
            "verseOrgIds": [
              "2CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö na abhatömöa bhö öbhörongo na abhakoramërëmo abharongo, bhano bhaguikora köbha kia abhatömöa bha Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.13",
            "verseOrgIds": [
              "2CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tëkërögööro hai, kugira ninyoora Setani umuene nguikora arë iga nö ömömaraika wö öbhörabhu! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.14",
            "verseOrgIds": [
              "2CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö tëng'ana ya kuruguuria hai, hano ndanyoore abhakoramërëmo bhaae bhayö mbaikora köbha kia abhakoramërëmo gikugira yö öbhöröngë. Kömöheriö goobho mbarinyoora këëra këbhaisainë gököreng'aana na amakora gaabho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imiiriiro ge Bhauro kiö ömötömöa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndarëngëra, ömöntö atagaacha gökanya iga në ëtöhö ndë, sibhoono hano möraitegeerre igo, niiga munyimuki gë ëtöhö, korri iga nani nyoore ëge kuirahëra hake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kërë nkögamba bhoono tiiga nkërë Ömönene agutuna iga ngambe hai; köng'ana ëno ya kuiraha ngusumaacha ndë gë ëtöhö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.17",
            "verseOrgIds": [
              "2CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono keebhörë bhaaho abhaaru bhano bhakuiraha göteemo ya abhantö bhë ëkëbhara, nani wonsui nëndairahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.18",
            "verseOrgIds": [
              "2CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu abhiene na abhang'aini mörë, nkio gikugira möragumirria ichitöhö! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.19",
            "verseOrgIds": [
              "2CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkugumirria mörë ninyoora nö ömöntö öno aköbhakora abhagöre, gösë öno akubharuusia ibhintö, gösë öno aköbhakora amatöng'a, gösë öno akuimaaha, gösë öno aköbhabhagatia na ichiihi ku ubhusiö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.20",
            "verseOrgIds": [
              "2CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkömaaha ndë ichinsoni kuguitabhirria iga ntööre abharosu kögökora amang'ana gayö!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore ömöntö örë wonsui aho öno agaatöra kuiraha igörö yë ëgëntö kërë gionsui – ngusumaacha ndë gë ëtöhö – nani wonsui nëndatöre. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.21",
            "verseOrgIds": [
              "2CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë bho na Abhaibhurania? Nkeebho nani ndë. Gösë bho na Abhaisiraeri? Nkeebho nani ndë, Gösë bho nu uruibhöro ro Ibhurahimuu? Nkebho nani ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.22",
            "verseOrgIds": [
              "2CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.23"
              },
              "items": [
                {
                  "text": "Ama 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gösë bho na abhakoramërëmo bha Kirisitö? Nkögamba ndë amang'ana gayö kiö ömöntö umuchuuru – sibhoono nëndëngë ömökoramërëmo umuuya köbhakëra! Naakora ëmërëmo bhökong'u köbhakëra, naahirua gökëbhohe harë kaaru, naatemöa bhökong'u na naahëkëëra uruku harë kaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.23",
            "verseOrgIds": [
              "2CO.11.23"
            ]
          }
        },
        {
