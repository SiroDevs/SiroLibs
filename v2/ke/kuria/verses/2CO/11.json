                  "text": "Ama 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "körögendo harë kaaru; ichitabhaarabhaaria chi imioro; ichitabhaarabhaaria cha abhasakuri; ichitabhaarabhaaria kö ëhamatë yaane; ichitabhaarabhaaria guchihamatë chindë; ichitabhaarabhaaria chu umugi; ichitabhaarabhaaria cha guiköngö; ichitabhaarabhaaria cha kunyancha; ichitabhaarabhaaria köbhantö bhaitö abharongo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
