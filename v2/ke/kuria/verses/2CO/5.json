              "2CO.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Öbh 9:15\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ntömanyërë iga iritunteera rëno tömenyërë-ömöbhërë goitö göë ëkëbhara këno-hano rërasaribhöë, ntöranyoore öbhömenyo kö Ënooköë, umugi göno götahagaacheröë na möntö, göno kuriöbha götarëgota röndë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhoono ngökema törë, töraigomba bhökong'u iga töhaabhöe umugi goitö göno guguucha kurua kuriöbha; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira hano töragusuare tëtöraanyooröe këng'aabhi hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga tökëmenyërë guitunteera rëno rë ëkëbhara, ngökema törë kunyaanyi ëno tukuigua; tiiga niiga ngutuna törë iga tuinuure ömöbhërë goitö göno töönago hai, gëtatiga niiga tusuare gööra go kuriöbha, korri iga ömöbhërë göno gugukua göhönchöröe na öbhöhoru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë umuene nëwe aatösemiiyi ököhönchöröa köyö, na agatöha Nkoro eebhë ëkëgooterro.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ruiso ronsui ntuichööyë ubhutirimiku. Ntömanyërë iga nkaaga tökërëngë kuimenya reitö rëno riö ömöbhërë, nharai törë kurua kö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ökömenya goitö, nkubhukumia, na tiiga iga ngö kömaaha na amaiso hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuichööyë ubhutirimiku na ntökaahanchërë iga tutigane na umugi goitö göno gö ömöbhërë na tuyi ka töbhe hamui na Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ëng'ana ënene gökëra kërë gionsui, harë honsui törë, ngutuna törë iga tömötegeri, ninyoora törëngë hano gösë haara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.10"
              },
              "items": [
                {
                  "text": "Rum 14:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira bhaitö bhonsui kuhika tuimëërre mbere ya Kirisitö, kögökengeröa ikiina nawe. Këra möntö narinyoora kërë kimuisainë gököreng'aana na amakora gano aakorrë nkaaga aarëngë gökëbhara këno, gabhe maiya gösë mabhëëbhë.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhösaani na Ënooköë köhetera harë Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhaara mbe tömanyërë ubhuëra bho koobhoha Ömönene, ngösaache törë kuruta abhantö bhandë. Sibhoono bhaitö ntömanyëkainë kö Ënooköë, na nguiteng'era ndë iga ntömanyëkainë guiki ichintariki cheinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titugutuna guiki tösaache kuigönga bhaitö abhiene harë bhainyu hai; gëtatiga ngösaacha törë köbhaha ikibhune ikiiya ke guikumia gikugira yeitö, korri iga mötöre köbhahunchukiria bhaara bhakuihechera ökamaahëkana gökëbhara ökö ömöntö na tiiga në ëteemo yaae hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndanyoore toochuura, ëyö ngikugira yë Ënooköë, si hano ndanyoore tëbhachuuru törë hai, ëyö ngikugira yeinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö nköbhaahoa törë na öbhöhanchi bho Kirisitö, bhoono tööngöra iga ömöntö umui naakuurë kugira ya bhonsui, nko kögamba iga bhonsui bhaakua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakuurë kugira ya bhonsui, korri iga bhaara bhamenyërë bhange kömenya kugira yaabho abhiene, sibhoono bhamenye gikugira yaae bheene öno aakuurë na kuriukibhhua.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö kurua bhoono tëtökömaaha ömöntö örë wonsui keebhörë ökömaaha kömöntö wë ëkëbhara körë hai, ninyoora ngönkaaga yëndë ntoorööchë Kirisitö igo, bhoono tëtökömömaaha igo hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö örë wonsui agootanibhua na Kirisitö, nköbha arë ëgëteemöa ëkëhëa; amang'ana ga karai ngusira garë, tamaaha, gonsui nköbha garë amahëa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonsui gayö ngökoröa garë na Ënooköë, öno gikugira ya Kirisitö, agötöhönchöra kurua köbha abhabhisa bhaae na köbha bhasaani bhaae, na guiki agatöha ömörëmo go gökora abhandë köbha bhasaani bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.18",
            "verseOrgIds": [
              "2CO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö niiga Ënooköë naarëngë harë Kirisitö arakora abhantö bhonsui bhabhe abhasaani bhaae, taabhëëkërë siire ya amaraga gaabho hai, aatöha ëng'ana ëno ëkögamba möna arabhakore bho bhabhe bhasaani bhaae.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ntörëngë hano gikugira ya Kirisitö, na Ënooköë umuene nköbhageya arë kohëtëra harë bhaitö. Nköbhasabha törë, kuibhaga re Kirisitö, iga Ënooköë abhahönchöre kurua köbha abhabhisa bhaae möbhe bhasaani bhaae! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.20",
            "verseOrgIds": [
              "2CO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirisitö taarë na iriraga hai, sibhoono gikugira yeitö Ënooköë naamökörrë abhe iriraga, korri iga gökögootana hamui nawe tötöre gösanga öbhöröngë bhuë Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.21",
            "verseOrgIds": [
              "2CO.5.21"
            ]
          }
        }
      ]
    }
  ],
