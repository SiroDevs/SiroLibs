        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Bharao aahaatëëyë Abhaisiraeri kuya bhoobho, Ënooköë taabhahetiiyi gönsë ya Misiri hai, ninyoora niyo yaarëngë ënchëra ya hang'i. Ënooköë, naagambërë iga, “Hano abhantö bhano bharëmanya iga iriihi në mbere yaabho rërë, mbaribhëëröka na kuringa Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhaga reeho, Ënooköë nainaarri Abhaisiraeri köhetera gönchëra yi iriköngö, kögëëra Nyancha Mberretu. Abhaisiraeri mbaatanööyë kurua gönsë ya Misiri bhaiseemiri kuiihi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        }
      ]
    },
