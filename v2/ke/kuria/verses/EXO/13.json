            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ÖMÖNENE arëbhasohia gönsë ya Abhakanaani, kehaara atuenerreeyi harë bhainyu na harë bhaguuka bhainyu, iga na rëbhaha ëbhe iyainyu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.19"
              },
              "items": [
                {
                  "text": "Ëgt 34:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.23"
              },
              "items": [
                {
                  "text": "Ruk 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kuhika muuche götööra kö ÖMÖNENE këra ömötangi weinyu wë ëgësaacha. Na këra ëgëtangi ëgësaacha gi ichitugo cheinyu nkëraabhe ikiö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ëgëtangi ëgësaacha gë ëtëkërë nörakëbhohori na ëkëmaano ki iring'ondi, gëtarë igo, nöragiite kugukibhuna ibhigoti. Na këra mötangi wë ëgësaacha wö ömöntö nöramöbhohori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömoona waao arikubhuuria guchinsikö chino chiguucha iga, ësësöro yë ëng'ana ëno nkë, uche kömöteebhia iga, ‘Guchinguru chö ököbhoko ko ÖMÖNENE naaturuusiri gönsë ya Misiri harë toorëngë abhagöre. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Bharao aakong'iri ömötöe götöhaatëra turichoke; ÖMÖNENE naitërë këra gëtangi gönsë ya Misiri, ömötangi wö ömöntö na ëgëtangi gi itugo. Köhayö uni nkuruusiria ndë ÖMÖNENE ikimuenso këra gëtangi ësaacha gi ichitugo chaane, sibhoono këra mötangi waane nëndamöbhohori. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëno nëraabhe ëkëmanyiirriö kömabhoko na kömasi gainyu, iga ÖMÖNENE naaturuusiri gönsë ya Misiri na ököbhoko kooe gui ichinguru.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umutimö gui irisaaro na ögö ömörro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
