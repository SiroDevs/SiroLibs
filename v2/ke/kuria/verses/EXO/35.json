          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agateebhia Abhaisiraeri iga, “Mötamaaha! ÖMÖNENE ahööyë Bhesareri ömoona wa Ohuri kurua gukiaro ke Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuichuuyi ënkoro yaae, amöhaayë ubhunguri, öbhöng'aini, ubhusisuri na ubhuhundi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri iga ahëmböre imichooro na gökora ëmërëmo ge gökörönga amatiini gë ësahaabhu, amatiini gi ichimbiria na iriche; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhaache amagëna ga gökorra öbhömarataati na ichimbaara gikugira yë ëmërëmo gëndë gionsui giu ubhuhundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ÖMÖNENE amötangatërë we na Ohiriabhu ömoona wa Ahisamaki kurua gukiaro ge Tani iga bhaigi abhandë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaayë ubhunguri bho gökora këra mërëmo giu ubhuhundi gëno gëgökoröa na abhachoori gösë bhano bhaguchaaria ichirangë chu ubhurru na chi iriini na ichimberretu na ëhanga inyëke inchiiya ëno ërökëröë na abhakori hagarëhagarë bhaara bhaagökora ëmërëmo giu ubhuhundi.",
          "type": "text",
