              "EXO.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.18"
              },
              "items": [
                {
                  "text": "Ama 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ömögambi ömöhëa akabhaaha Misiri, öno aatamanyërë Yusubhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe agateebhia abhantö bhaae iga, “Mötamaaha möna Abhaisiraeri bharëngë abhaaru na mbaana ichinguru götökëra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.9",
            "verseOrgIds": [
              "EXO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.19"
              },
              "items": [
                {
                  "text": "Ama 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.19"
              },
              "items": [
                {
                  "text": "Ama 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mötaimöka tutune ëseemi ya köbhatuena, iriihi rëtagaacha kurichokera bhagootane na abhabhisa bhaitö gutuitania na köng'osa kurua gönsë ëno.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhamisiri bhagatööra abhaimiriirri bha köbhairiiria na köbhahamirria gökora ëmërëmo imirito; bhakahagaachëra Bharao imigi ge köbhëëka ëmongo: Bhitomu na Ramesesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono keebhörë bhaarë kuiriiribhua, nkeebho bhaarë kuiyengeria na gonchaara gönsë, igo Abhamisiri bhakoobhoha Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamisiri bhakabha abhabhëëbhë bhökong'u, bhagakoria Abhaisiraeri ëmërëmo imirito bhökong'u, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhagakora amabhaho gaabho gakabha amakong'u gö köbhakoria ëmërëmo ge gökora isuakara na götema amatabhuari, hamui na ëmërëmo gë ëmëgöndö. Abhaisiraeri mbaarë gokoribhua ëmërëmo gëyö gionsui köbhörëërëëma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi wa Misiri agateebhia Sibhura na Bhua, abhagaikörö bhano bhaarë gutuurria abhakari bha Abhaebhurania kuibhöra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ënkaaga ëno mugutuurria abhagaikörö bha Abhaebhurania kuibhöra, hano wanyoora ömoona öno aibhööyöë nö öwë ëgësaacha, mumuita. Si hano wanyoora nö öwë ëgëkari monga kumuita.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
              "EXO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono gikugira abhatuurria bhaara mbaarë koobhoha Ënooköë, tëbhaakorrë keebhörë bhaateebhibhui na ömögambi Bharao hai, gëtatiga mbaahoniri abhaana bhë ëgëaacha bha Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.17",
            "verseOrgIds": [
              "EXO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ömögambi Bharao akabhërëkëra abhatuurria bhaara akabhabhuuria iga, “Igankë mögökora igo? Ndaigua timuuguita Abhaana bhë ëgësaacha?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho bhakahunchukiria Bharao iga, “Ngikugira abhagaikörö bha Abhaebhurania tëbhanga abhagaikörö bha Abhamisiri hai; bho nabhakarë, nkuibhöra bharë umuibhuria atarabhagëëra.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Ënooköë agatuurria abhatuurria bhaara, na Abhaisiraeri bhakagenderria kuiyengeria na köbha na ichinguru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.20",
            "verseOrgIds": [
              "EXO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na gikugira abhatuurria bhaara mbaarë koobhoha Ënooköë, Ënooköë naabhatuuriyi bhakabha na uruibhöro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
