    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mana na ichinkoore",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatanöra kurua Erimu, umuiraniö gonsui gua Abhaisiraeri gökahika guiköngö re Sini, rëno rërëngë gataigatai ya Erimu na Sinai; kurusikö ro ikumi na gataano ru umueri go kabhërë kurua bhaatanööyë kurua gönsë ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Umuiraniö gonsui gua Abhaisiraeri gökaröröötëra Mösa na Haruni guiköngö haara, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbuuya hano ÖMÖNENE agatuitëëyë gönsë ya Misiri haara wanyoorrë tömenyërë, töraikara hang'i na ichinyöngö chi ichinyama na körëa ëmëgaate turaigöta. Kugira hano mötörentërë guiköngö rëno iga muite umuiraniö göno gonsui na ömöramböko.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ÖMÖNENE aateebhiri Mösa iga, “Nëndabhateeri ëmëgaate kurua kuriöbha. Këra rusikö abhantö bharichoka këbhara bhairia ibhiakörea bhiu urusikö röyö, korri mbasaache ndore nyoora mbagoota amarago gaane gösë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono kurusikö ro gasansabha bhairia ibhiakörea bhiyo harë kabhërë ruiso ronsui.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Mösa na Haruni bhagateebhia Abhaisiraeri bhonsui iga, “Mögoroobha mmöramanye iga ÖMÖNENE nëwe aabharuusiri gönsë ya Misiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na icho inkio, mmörachë mömaahe ubhuhiku bhö ÖMÖNENE, kugira aiguurë ököröörööta koinyu. Kana gösë bhaitö ning'ui mötörörööte? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa akabhateebhia iga, “Mögoroobha ÖMÖNENE narabhahe ichinyama möre, na icho nkio narachë abhahe ëmëgaate möre muigöte, kugira we aiguurë möna mökömörörööta. Bhaitö ning'ui möratörörööta? Monge götörörööta bhaitö, si mötarörööta ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Mösa agateebhia Haruni iga, “Tateebhia umuiraniö gonsui gua Abhaisiraeri bhairani mbere yö ÖMÖNENE, kugira aiguurë bhörë mökörörööta.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Haruni aarë gusumaacha na umuiraniö gua Abhaisiraeri, bhonsui bhagatachëërra guiköngö, bhagatökëra bharamaaha ubhuhiku bhö ÖMÖNENE kömasaaro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.11",
            "verseOrgIds": [
              "EXO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni niguurë bhörë Abhaisiraeri bhakörörööta. Köhayö, bhateebhia iga, ‘Mögoroobha mbaraare ichinyama, na icho nkio mbaraache bhare ëmëgaate. Hayö nëho möramanye iga uni nu uni ÖMÖNENE, Ënooköë weinyu.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, ömögoroobha ichinkoore ichincharu chigaacha chikagubha irisanchö ria Abhaisiraeri. Na inkio yaho, ëntoori ëkagöa ëganchaara kuinaara irisanchö reebho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ëntoori yaakamökërë ëgëntö këno kënga ömögaate umunyerre na ömöhöhö këgatama guiköngö haara. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.3"
              },
              "items": [
                {
                  "text": "1 Ko 10:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano Abhaisiraeri bhaakërööchë, bhakabhuurania iga, “Kana këno ngëntö kë?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akabhateebhia iga, “Göno nö ömögaate göno ÖMÖNENE abhahaayë iga möre. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aruusiri ëngamba iga: Këra möntö airi ibhiakörea ëkërengere këno araatöre körëa; narachoore ëkërengere gë ëkëhe kimui kömöntö umui guitume reee.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagakora ke hayö, si ëkabha iga, abhamui bhakairia köbhooru na abhandë bhike igo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.15"
              },
              "items": [
                {
                  "text": "2 Ko 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono hano bhaabhitiimërë gökëhe, mbaanyoorrë iga, öno wanyoorrë airri ibhiaru taatigiri hai, na öno wanyoorrë airri bhike tibhiamusuuhërë hai, këra möntö nairri bhino aatöörrë körëa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agateebhia abhantö iga, “Möntö örë wonsui atagaacha gutigia ibhiakörea bhiyö kuhika inkio.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhakanga kuiguëra Mösa, abhamui bhagatigia ibhiakörea ibhimui kuhika inkio. Sibhoono hano bhookëëyë nkanyoora bhigundërë bhibhaayë na ichinyende. Mösa akarërëërra abhantö bhokong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo këra möntö naarë kuiria ëkërengere këno aarë gutuna. Hano ömöbhasö goorörrë, ibhiakörea bhindë bhiira bhitamërë bhiayaaya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro gasansabha, Abhaisiraeri mbairri ibhiakörea bhiyö harë kabhërë, ibhihe bhibhërë kömöntö umui. Köhayö, abhagaaka bhonsui bhu umuiraniö gua Abhaisiraeri bhakagëëra Mösa bhakamöteebhia ëng'ana ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11"
              },
              "items": [
                {
                  "text": "Ëgt 20:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mösa akabhateebhia iga, ÖMÖNENE aragamba iga, “Icho nu urusikö urunuhe ro kumuunya, ësabhato ënhoreeru kö ÖMÖNENE; karanga kërë mögakaranga na chimukia këno mögachimukia, na kërë gionsui këratame këbhëëköe kuhika icho.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, bhagakora igo, na gutigia ibhiakörea bhindë kuhika inkio kehaara Mösa aagambërë. Inkio yaho bhakanyoora iga tibhisarëkërë gösë köbha na ichinyende hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akabhateebhia iga, “Möre ibhiakörea bhiyö kugira reero në ësabhato kö ÖMÖNENE; tëmöranyoore bhiakörëa bhindë këbhara hayö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö isansabha mmöraayi mörairia ibhiakörea bhiyö, sibhoono kurusikö ro muhungatë, röno rörënge ësabhato tibhiraayi bhirabha ho hai.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro muhungatë abhantö abhamui bhakarichoka kuya kuiria ibhiakörea, si tëbhaabhinyoorrë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE akabhuuria Mösa iga, “Kuhika rööhai mörange kögoota amarago na imigiro geene? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaha, Uni ÖMÖNENE naabhaha ësabhato, köhayo, kurusikö ro gasansabha nköbhaha ndë ibhiakörea bhi ichinsikö ibhërë, kö hayö möntö örë wonsui anga kurichoka urusikö röyö ro muhungatë.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhakamuunya urusikö röyö ro muhungatë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhakabhërëkëra ibhiakörea bhiyö iga ëmana. Nabhio bhinga ömögaate umunyeerre göno götöörröë öbhöökë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa akabhateebhia iga, “Ëno niyo ëngamba yö ÖMÖNENE: ‘Muimuki ëmana ëkëhe kimui möbhëëke korri muuche kuya mörorookia uruibhöro roinyu, korri bbhatöre kömaaha ibhiakörea bhino naabharagiiyi guiköngö nkaaga naabharuusiri gönsë ya Misiri.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Ibr 9:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mösa agateebhia Haruni iga, “Imukia ikiguchi ötööre mo ëmana ëkëhe kimui ugihire mbere yö ÖMÖNENE, ëbhe ho gikugira yu uruibhöro roinyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Haruni agatööra ëmana ahasë ahahoreeru mbere yi Irisandëko ri Imuuma korri ëbhëköe kehaara ÖMÖNENE aasimisiiyi Mösa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.12"
              },
              "items": [
                {
                  "text": "Yos 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaarëëyë ëmana kömeeka mërongo ënai, kuhika hano bhaahikërë gönsë ëno wanyoorrë ëbhaitungërë kömenya, ënsë ëno yaarëngë kömöbhaga go Kanaani harë bhaamenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëmana ëkërengere ki ibhihe bhinai, yaarëngë iring'ënga re ikumi ri ikibhiimo këno gëköbhërëkëröa iga ebha.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
          }
        }
      ]
    }
