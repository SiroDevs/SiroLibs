        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakorrë ëhanga yu ubhuchë bhöë ërange yu ubhuuru, yi iriini na ëmberretu na ehanga inyeke inchiiya ëno ërökëröë. Ëhanga Ëyö yaachoorröë ibhiteemöa bhino bhiina amabhabha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora imitimö ënai gë ëngongachuma, akagëhaka ësahaabhu. Bhöyö bheene akagëkorra ibhiikarro bhinai bhia amatiini gi ichimbiria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene agakora ichihanga inyai chu ubhuche bhöë ërange yu ubhurru, yi iriini na ëmberretu na ehanga inyeke inchiiya ëno ërökëröë na kumigua bhuuya, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "na imitiiro geerio ëtaano na ibhigachiriö naabhihakërë ësahaabhu na amaikarro gaagio ataano, na agi iriche gaarëngë.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
