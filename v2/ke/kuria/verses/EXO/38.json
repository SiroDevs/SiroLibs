              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriche rionsui rëno Abhaisiraeri bhaaruusiiyi ÖMÖNENE ndeebhaaye ichikiiro ibhiköë bhibhërë, irigana rimui, mërongo ëbhërë na inyai (2,124). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
