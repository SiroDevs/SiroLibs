          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichikiiro ikumi na muhungatë, na ichigiramu mërongo muhungatë na isaano, chino chaatigaayë, chigakora ibhigachiriö bhi imitimö, köhaka ibhikundukiriö bhi imitimö na gökora ibhinyëëro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
