                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mat 17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano wanyoorrë bhaahikia ëmeeka mërongo ëbhërë na gumui na kögenderria mbaabharröë, na këra umui waabho akaruusia ichimbiria ichigiramu isaano; na abhasaacha bhonsui bhano bhaabharöë mbaabhaayë ibhigata bhisansabha, ibhiköë bhitatö, amagana ataano na mërongo ëtaano (603,550). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichikiiro ibhiköë bhitato (3,000), cha amatiini gi ichimbiria nchaakorrë ibhiikarro irigana rimui (100) bhiira bha ahasë ahahöreeru na ëhanga ëëra, nko kögamba iga ichikiiro mërongo ëtatö, nchaarë gökora igiikarro kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
