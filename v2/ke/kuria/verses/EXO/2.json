              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa agaitabhirria kömenya o Reueri, nawe akamöha umuisëkë waae öno aarë köbhërëkëroa iga Sibhora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
