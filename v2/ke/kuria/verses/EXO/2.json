        },
        {
          "text": "Isawaabho akabhabhuuria iga, “Ömöntö öyö nëhai arëngë? Kugira kë mumutigërë? Taya mömöbhërëkëre ache körëa ibhiakörea.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        }
      ]
