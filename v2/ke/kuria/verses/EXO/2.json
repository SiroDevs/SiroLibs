              "items": [
                {
                  "text": "Ama 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömoona ööra aakiinërë akahika, ömögaikörö ööra akamörenta kumusabhaati o Bharao, akabha ömoona waae, nawe akamöröka iga Mösa, akagamba iga, “Kugira nkömanchë naamuruusiri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mösa arang'osera Mitiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
