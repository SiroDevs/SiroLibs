              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua ökore ëgësahaani gë ësahaabhu inyëke, sooki uginyame kehaara akunyama umuhuri, ‘Ömöhoreeru kö ÖMÖNENE.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhohe ëgësahaani këyö mbere yi iyaati na umuchibhi göë ërange yu ubhurru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni Asuare ëgësahaani këyö kubhusiö, korri aimukiri ko amasaria gano ndanyoore Abhaisiraeri bhakorrë nkaaga bhakunduusiria ësataaka yi ibhimuenso ibhihoreeru, nani nëndaitabhirri ibhimuenso bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökorre Haruni ëkabhuuti na iyaati bhino bhinyirruë köhanga inyëke na umuchibhi göno gunyirruë bhuuya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ötömëre abhaana bha Haruni ëkabhuuti, umuchibhi na ëngosiira korri bhamaahëkane köbha na ubhuhiku na ikuuge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuari mura omoinyu Haruni na abhaana bhaae ichingëbho chiyö, hakurua öbhahake amaguta na köbhatörra amabhoko korri iga öbhaahöre bhankorre ëmërëmo kia abhanchaama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na guiki öbhatömëre ichisuraare chië ëhanga inyëke chino chirakundikiri umukurukuru kuhika kubhinama gu kubhisa ëkëng'aabhi keebho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhaana bhaae bhasuara ichisuraare chiyö këra nkaaga bhagösoha guitunteera re gusikanëra, gösë nkaaga bhagusugatërra irikëngë re kumuensera, gökora ëmërëmo giu ubhunchaama ahasë ahahoreeru. Gönchëra ëyö mbarakundikiri ëkëng'aabhi keebho na konga guitua. Na göyö ngörabhe umugiro harë Haruni na uruibhöro rooe kuya ëyö.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    }
