                }
              ]
            }
          ]
        },
        {
          "text": "Örë wonsui araatune iga atuuri öbhöhoru bhooe, öyö narabhötabhutë si örë wonsui arabhötabhutë öyö narabhutuuri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubhutikö bhöyö, ndabhateebhia iga, nindinyoora abhantö bhabhërë bharaayë bhörrë bhumui; umui aimukibhöe, na öwöndë atame. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagaikörö bhabhërë ndinyoora bharasëa hamui; umui aimukibhöe na öwöndë atame. [ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhabhërë ndinyoora mögöndö bharë; umui aimukibhöe na öwöndë atame.”] ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
