          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ëhöbhë yeinyu bhano mukugisigisibhöa; kugira niigo bheene bhaaguuka bhaabho bhaagisigisiri abhanaabhi bha karai bho öbhörongo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
