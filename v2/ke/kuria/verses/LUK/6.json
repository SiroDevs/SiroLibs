      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ököhancha abhabhisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 6:26"
          },
          "items": [
