            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Yesö akabhateebhia ëkerengio këno iga, “Umuhukuru taakarahuuna umuhukuru wöndë hai; hano ndanyoore namötangata mbaraagoe bhonsui kubhuina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.39",
            "verseOrgIds": [
              "LUK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
