          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.14"
              },
              "items": [
                {
                  "text": "1 Bhe 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abhakehaiya mbainyu bhano abhantö bhararege, na köbhagira, na köbhachoria, na götabhuta iriina reinyu kiu ubhunyanku, gikugira yö Ömoona wö Ömöntö!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
