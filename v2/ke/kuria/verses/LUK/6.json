          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kugira tëmötë muuya gööho göno gökooma ichihagöe ichimbëëbhë, gösë ömötë ömöbhëëbhë göno gökooma ichihagöe ichinchiiya; kugira këra mötë nkömanyëkana görë guchihagöe chago; kugira, tëbhaagutua ichitiini kurua kömahaöa, na kurua kumichongoma tëbhagutua ichisabhibhu hai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.43",
            "verseOrgIds": [
              "LUK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
