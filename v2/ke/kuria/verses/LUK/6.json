            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
            "verseOrgIds": [
              "LUK.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sibhoono ndabhateebhia bhainyu bhano mukuigua, möhanche abhabhisa bhainyu, mökorre bhano bhabharegërë amaiya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.27",
            "verseOrgIds": [
              "LUK.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "muitabhiri bhano bhaköbhaihiima, mösabhëre bhano bhaköbhahonera. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.28",
            "verseOrgIds": [
              "LUK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno agötema örösa rumui, ömöhonchörra öro kabhërë, na öno akuruusia isumaati yaao, wanga kömörekia ninyoora në ëngancho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.29",
            "verseOrgIds": [
              "LUK.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taha örë wonsui akögösabha, na öno agukuruusia ibhintö bhiao, wanga gutuna iga akuringiri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.30",
            "verseOrgIds": [
              "LUK.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Tob 4:15",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.12"
              },
              "items": [
                {
                  "text": "Mat 7:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kebhöre bhainyu mugutuna mökorröe na abhantö, möbhakorra bhöyö bheene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.31",
            "verseOrgIds": [
              "LUK.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kugira hano mörahanche bhano bhabhahanchërë, mbögesa kë mökoorokia? Kugira ninyoora na abhanyamaraga nköhancha bharë bhano bhabhahanchërë. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.32",
            "verseOrgIds": [
              "LUK.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano bhainyu mörakorre amaiya bhaara bhaköbhakorra amaiya, mbögesa kë mökoorokia? Ninyoora na abhanyamaraga niigo bheene bhaagökora. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.33",
            "verseOrgIds": [
              "LUK.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore nköhaana örë isiirë köbhaara uguiteng'era iga nabho mbaraköhakane, kana mbuëra ke öranyoore? Kugira ninyoora na abhanyamaraga bhonsui nköhaana bharë ichisiirë köbhanyamaraga bhandë, korri nabho bharingiribhue ëkërengere këëra bheene! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.34",
            "verseOrgIds": [
              "LUK.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Sir 4:10,11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono möhanche abhabhisa bhainyu, mökore amaiya, na köhaana mötaguiteng'era köhakanöa, na igituho keinyu nkëraabhe ëkënene; na bhainyu mmöraabhe abhaana bhë Ënooköë Umukumahe öno arëngë igörö, kugira we nu umuuya köbhano bhataana mukumo na abhanyanku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.35",
            "verseOrgIds": [
              "LUK.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möbhe na amaabhë, kehaara Isaweinyu arëngë wa amaabhë.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökengera abhandë ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
