                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mat 12:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöntö umuuya nkuruusia arë amaiya kurua kömongo yö ömooyo gooe umuuya; ömöntö ömöbhëëbhë nkuruusia arë ibhintö ibhibhëëbhë kurua kömongo yaae ëmbëëbhë. Kugira këno gikurua kumunyua gömöntö nkio nkunyoora gichööyë kömooyo gooe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhahagaachi bhabhërë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.45",
            "verseOrgIds": [
              "LUK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na kugira kë mökömberekëra iga, ‘Mönene, Mönene,’ sibhoono tëmögökora gaara nkögamba hai? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.46",
            "verseOrgIds": [
              "LUK.6.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra möntö öno aguucha harë uni, na kuigua amang'ana gaane na kögakora, nëndabhooroki ituubho yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.47",
            "verseOrgIds": [
              "LUK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituubho yaae nömöntö öno aahagachërë inyumba, na gutuka kuya hansë bhökong'u, na köhagaacha öbhörösa körötare; na hano ëhöörö yaachërë, ömooro gögatema inyumba guchinguru, gökanga kugisingisia; kugira nëhagaachëröë bhuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.48",
            "verseOrgIds": [
              "LUK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ööra aaiguurë si akanga gökora, ituubho yaae nömöntö öno aahagaachërë inyumba yaae kuirobha ëtaana bhörösa, ömooro gökagëtema guchinguru, ho hayö igo ëkahongoka; na ugusika kuinyumba ëëra gökabha ökönene.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.49",
            "verseOrgIds": [
              "LUK.6.49"
            ]
          }
        }
      ]
    }
