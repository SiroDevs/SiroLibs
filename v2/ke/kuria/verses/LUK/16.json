          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhabharisayo bhaaiguurë igo, mbaamöserrë, kugira nabhahanchi bhi ichimbiria bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhabhöörra iga, “Bhainyu möhanchërë kuiyorokania mbere ya abhantö iga nabhaheene mörë, sibhoono Ënooköë nabhamanyërë kumioyo geinyu; kugira ëgëntö këno ge kömaahöa na abhantö iga nkëëna ubhuëra, kö Ënooköë, tëgëntö hai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
