        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Tob 4:9-11\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akaroobherria köbhateebhia iga, “Nani ndabhateebhia iga, mötaikorra amasaani köbhantö bhë ëkëbhara këno, korri hano bhirëbhasërra bhaache köbhairigania köbhömenyo bho kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui arëngë ömöheene kubhintö ibhike bhökong'u, naraabhe ömöheene ninyoora nkubhiaaru, öno atarëngë ömöheene kömang'ana amake ninyoora nkömang'ana amanene taraabhe möheene hai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.10",
            "verseOrgIds": [
              "LUK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mötarë bhaheene kubhintö bhië ëkëbhara këno, öbhoomë bhö öbhöheene bho ning'ui araabhahe? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.11",
            "verseOrgIds": [
              "LUK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë hano ndanyoore mötarë abhaheene kubhintö bhia abhantö bhandë, ning'ui araabhahe bhino bhiraabhe ibhieinyu?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.12",
            "verseOrgIds": [
              "LUK.16.12"
            ]
          }
        }
      ]
    },
