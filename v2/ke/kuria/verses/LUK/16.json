      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ömöntö wöndë, aarëngë ho ömoomë, öno aagasuarrë ichingëbho chë ëhanga inyëke yë ërangë yi iriini, öno aakarëëyë ibhiakörëa ibhiiya ruisö ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuihita reee nkanyoora aho ömöntö ömötaka öno arë köbhërëkëröa iga Rasaro, öno aarëngë na ibhisëësë ömöbhërë gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno aakaigombërë körëa ibhiakörëa bhino bhiakagööyë hansë kurua kömeesa yö ömoomë ööra. Gökëra gayö ichisëësë nchaarë kömömeenameena ibhisëësë.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ömötaka ööra agakua, akahirua na abhamaraika hang'i na Ibhurahimu; ömoomë ööra nawe agakua agatökëröa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga aarëngë Bhuku harë arëkunyoorra inyaanyi ënene bhökong'u, akagorrökia amaiso gaae, akamaaha Ibhurahimu aharai, na Rasaro ambarëka yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki akabhërëkëra iga, ‘Taata Ibhurahimu! Taamaahëra amaabhë, öteebhi Rasaro achabhi ëkeera kömanchë antoonyiri körörëmë ankindi, kugira nkunyahaarëka ndë kömörro möno!’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
            "verseOrgIds": [
              "LUK.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
            "verseOrgIds": [
              "LUK.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sibhoono Ibhurahimu akamöbhöörra iga, ‘Tahëëtöka moona waane, ënkaaga ëno waarëngë gökëbhara waahaayöë ibhintö bhionsui ibhiiya, ënkaaga ëyö Rasaro nawe na amabhë aakanyoorrë. Sibhoono igo nkömëgooko arë hano, na uwe nkunyaanyi örë. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gökëra gonsui, gatai yaao na bhaitö, irirööma ndëgatai hayö iritambë rëno rëtohökaini, korri iga möntö atagaacha kurua ihumbu ëyö guucha ihumbu ëno, gösë kurua ihumbu ëno guucha ihumbu ëyö hai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömoomë ööra akabhöörra Ibhurahimu iga, ‘Mbuuya mbe taata, ngaakögeya, ötöme Rasaro kuya o taata, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "harë bhamura bha ömoitö bhataano; korri abhaköge, nabho bhatagaacha guucha ahasë hano hi inyaanyi.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibhurahimu akamöbhöörra iga, ‘Bhamura bha ömoinyu mbaana imigiro ge Mösa na amandëko ga abhanaabhi; tiga bhagaiguëre.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawë akamöbhöörra iga, ‘Aa-a, Taata Ibhurahimu! Sibhoono hano bhakanyoora öno ariökërë kurua köbhaku, nëho bhagaatiga amaraga gaabho.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu akamöbhöörra iga, ‘Hano ndanyoore bhatakuiguëra imigiro ge Mösa na igia abhanaabhi, tëbharakumi ninyoora möntö ariöke kurua köbhaku hai.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.31",
            "verseOrgIds": [
              "LUK.16.31"
            ]
          }
        }
      ]
    }
