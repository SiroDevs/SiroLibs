              "items": [
                {
                  "text": "Ruk 21:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö naarë kuigia ruisö ronsui köhekaru mööra. Abhatangati bha abhanchaama abhanene na abhaigia bhi imigiro, hamui na abhatangati bha abhantö mbaatunërë kumuita, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono tëbhaamanyërë keebhörë bhagaakorrë, kugira abhantö bhonsui wanyoorrë nkömötegeerra bharë, tëbhaarë gutuna iga bhahëtëëröe ninyoora në ëng'ana imui hai.",
          "type": "text",
