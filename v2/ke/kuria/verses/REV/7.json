              "items": [
                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Isa 25:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kugira Ëkëmaano ki Iring'ondi këno kërëngë gataigatai ya igitumbë kiu ubhukumahe, nëwe araabhe umuirigania waabho nawe narabharongooche kuya guchinsëröka cha amanchë gö ögbhöhoru. Ënooköë nawe naarieya amaisori gonsui kurua kömaiso gaabho.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
              "REV.7.17"
            ]
          }
        }
