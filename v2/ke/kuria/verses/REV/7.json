                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.5"
              },
              "items": [
                {
                  "text": "Sek 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano gayö gaasirrë, nkamaaha abhamaraika bhanai bhaimëërëëyë ichintahana inyai chi ëkëbhara, bhagotereeyë ëmëkama ënai gë ëkëbhara, korri iga ömökama götakahusa ninyoora hake: Gökëbhara, gösë kunyancha gösë kömëtë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha ömömaraika wöndë arachönga kurua rögörö ana ömöbhaaso göë Ënooköë öno aho. Akagamba köngamba ënene arateebhia abhamaraika bhanai bhaara bhaahaayöë ögötöra gösaria ëkëbhara na inyancha iga, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ese 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mootagaasaria ëkëbhara gösë inyancha gösë ëmëtë, kuhika hano törësookia götööra öröbhaaso köbhakoramërëmo bhë Ënooköë weitö kömahanya ga amasiö gaabhö.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkaigua ëkërengere ke bhaara bhabhaasëröë abhantö ibhiköë irigana rimui na mërongo ënai na bhinai (144,000) kurua këra ikiaro ke Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiaro ke Yuta ibhiköë ikumi na bhibhërë (12,000); ikiaro ke Rubheni ibhiköë ikumi na bhibhërë (12,000); ikiaro ke Gati ibhiköë ikumi na bhibhërë (12,000); ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiaro ke Aseri ibhiköë ikumi na bhibhërë (12,000); ikiaro ke Nabhutari ibhiköë ikumi na bhibhërë (12,000); ikiaro ke Manase ibhiköë ikumi na bhibhërë (12,000); ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiaro ge Simioni ibhiköë ikumi na bhibhërë (12,000); ikiaro ke Rawi ibhiköë ikumi na bhibhërë (12,000); ikiaro ge Isakari ibhiköë ikumi na bhibhërë (12,000); ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiaro ge Sabhuroni ibhiköë ikumi na bhibhërë (12,000) ikiaro; ke Yusubhu ibhiköë ikumi na bhibhërë (12,000) na ikiaro ke Bhenchamini ibhiköë ikumi na bhibhërë (12,000).",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Örömama röa abhantö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gayö gasirrë, nkamaaha örömama röa abhantö röno möntö atakaabhara: Abhantö bha këra hamatë, ikiaro, ëgësaku, na ëkëgambo. Nabho nkanyoora mbaimëërëëyë mbere yi igitumbë kiu ubhukumahe na mbere yë Ëkëmaano ki Iring'ondi, bhasuarrë ichinganchö ichindabhu, bhagotereeyë amatö gë ëmëtende kömabhoko gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakarangiria köngamba ënene bharagamba iga, “Ubhuituuria bhoitö harë Ënooköë weitö bhukurua, Ënooköë öno aikaayë kugitumbë kiu ubhukumahe, na gukurua go Ëkëmaano ki Iring'ondi!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamaraika bhonsui bhakaimëërra bhakainaara igitumbë kiu ubhukumahe, na abhagaaka bhaara hamui na ibhiteemoa ibhihoru bhinai. Bhakahigama mbere yi igitumbë kiu ubhukumahe, bhagasengera Ënooköë, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bharagamba iga, “Amina! Amaitabhirio, ubhuhiku, öbhöng'aini, umukumo na ësööko, ögötöra na ichinguru bhibhe kö Ënooköë weitö kuya ëyö na ëyö! Amina!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umui wa abhagaaka bhaara akambuuria iga, “Bhano bhasuarrë ichinganchö ichindabhu mbaabho ng'ui? Na nëhai bharuurë?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Tan 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.21"
              },
              "items": [
                {
                  "text": "Mat 24:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mk 13:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nani nkamuhunchukiria iga, “Ömösööke, uwe nömanyërë.” Aganteebhia iga, “Bhano mbaara bhaahonëre kumiiriiro ëmënene gëëra. Mbaahurrë ichinganchö chaabho kömaanyinga gë Ëkëmaano ki Iring'ondi chikarabha iga chai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkio bharëngë mbere yi igitumbë kiu ubhukumahe kë Ënooköë bharakora ëmërëmo ubhutikö na ömöbhasö köhekaru yaae; na örë aikaayë kugitumbë kiu ubhukumahe narabhaikëngere gököbha ho kooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëbharëramboka röndë gösë köbha na muihöma hai; ömöbhaso gösë örööha örörrö köbhasamba guiki hai, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
        {
