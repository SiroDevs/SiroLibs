              "items": [
                {
                  "text": "Yer 51:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua guiki umui wa abhamaraika muhungatë bhaara bhaarë na ichibhakuri muhungatë agaacha, aganteebhia iga, “Taacha, nani nëndakooroki iribhörööta rëno ömöraaya ömönene ööra aahaayöë, umugi gööra goohagaachëröë këgörö ya amanchë amaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhagambi bhë ëkëbhara bhaakora öbhöraaya nawe, na abhamenyi bhë ëkëbhara bhaareehöa na itibhaai yö öbhöraaya bhooe.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        }
      ]
    },
    {
