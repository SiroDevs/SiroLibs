              },
              "items": [
                {
                  "text": "Öbhö 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Nkoro akanyimukia akaahira guiköngö. Nkamaaha ho ömögaikörö aikarëëyë itiinyi ëmberretu. Itiinyi ëyö wanyoorrë yaandëkëröë amariina amaaru ga guchuaria Ënooköë; nayo yaarë na ëmëtöe muhungatë na ichintëra ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömögaikörö öyö wanyoorrë nasuarrë ëngëbho yë ërangë yë ërangë yi iriini na ëmberretu; na nkanyoora naitörëëyë ësahaabhu, amagëna gi iriguri, na iruuru. Gökobhoko kooe wanyoorrë naagotereeyë ëgëkombe gë ësahaabhu këno gichööyë ibhiriirriö na amang'ana amanyanku gö öbhöraaya bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora naandëkëröë kuihanya riu ubhusiö bhooe iriina rë ëgësabhucho: “Bhabheri Ömönene, nyaköwaabho abharaaya na amang'ana gonsui ga kuriirria ëkëbhara.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamaaha ömögaikörö öyö areehëröë na amaanyinga ga abhantö bhë Ënooköë na aga bhaara bhaitëröë gikugira ya köherekia igörö ya Yesö.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano naamörööchë, naarögöörrë bhökong'u, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömömaraika öyö aganteebhia iga, “Igankë ökörögööra? Nëndagöteebhi ësësöro ëno ibhisërë kömögaikörö öno na itiinyi ëyö arinërë ëno ëna ëmëtöe muhungatë na ichintëra ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Tan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Öbhö 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Sab 69:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Itiinyi ëyö örööchë në ëhoru yaarëngë karai hayö, sibhoono yaakuwa. Ninyoora niigo, mböngö ërarichoke kurua kubhuina bho Bhuku, gëtatiga nëraasikibhöë. Bhano bhamenyërë gökëbhara mbararögööre; ee-e abhantö bhonsui bhano amariina gaabho gataakandëkëröë kögëtabhö kiö öbhöhoru, gukurua kögötanga göë ëkëbhara, mbararögööre kömaaha itiinyi ëyö yaarëngë ëhoru karai hakurua ëgakua na guiki irichokeeyë!",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano nu ubhunguri na öbhöng'aini hagutuna! Ëmëtöe muhungatë gëyö ni ibhikerege bhino ömögaikörö öyö aikaayë igörö yaabhio. Guiki ëmëtöe gëyö na abhagambi muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhagambi muhungatë bhayö, bhataano bhaasika, umui nkögambëra akërë, na öwöndë taraacha hai; hano araache narabhe ho gönkaaga nke igo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itiinyi ëyö yaarë ëhoru karai hayö, sibhoono guiki tëëho hai, nö ömögambi wa kanaanai, nayo guiki ni imui ya muhungatë chiyö, na nkuya ërë gösaribhöa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
