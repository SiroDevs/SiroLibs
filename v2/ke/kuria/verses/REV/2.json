        {
          "text": "“Öno ana amatui aigue garë Nkoro agöteebhia ichikanisa!",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
