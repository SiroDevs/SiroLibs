          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sibhoono abhamui bhainyu bhano bharëngë Tiatira, bhanga kögoota amaigiö amanyanku gano; mönga kuëga këëra abhandë bhaköbhërëkëra iga ‘Ibhibhisërë ibhinene bhia Setani.’ Ndabhateebhia iga tëndatöörë mösaire görë gonsui harë bhainyu hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooterra bhökong'u kërë önakio kuhika röno ndiicha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        }
      ]
    },
