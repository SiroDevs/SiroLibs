          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gano na amang'ana kurua kö öno ana inchonge inyögë mbaga ibhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë harë ömenyërë, nharë igitumbë kiu ubhukumahe bho Setani kërë; sibhoono nökëgotereeyë iriina reene; tëwaatigërë ubhukumia bhooo harë uni ninyoora ngönkaaga ëëra Antibha, ömöherekia waane ömöheene, aitëëyöë ahasë haara Setani amenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
