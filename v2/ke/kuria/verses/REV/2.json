            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3"
              },
              "items": [
                {
                  "text": "Ëbh 25:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono nëëna amang'ana makë igörö yaao: Abhamui bhainyu nkögoota bharë amaigiö ga Bharaamu, öno aaigiri Bharaki gökobhia Abhaisiraeri kuya kuiraga, gököbhakorokombia körëa ibhiakörea bhinö bhimuenseeyöë ibhihooru na gökora öbhöraaya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene abhandë mbarëngë harë bhainyu bhano bhakögoota amaigiö ga Abhanikorai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
