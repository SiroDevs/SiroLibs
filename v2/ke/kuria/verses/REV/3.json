          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Öno arakëre nëndamösakiri guikara hamui nani kugitumbë keene kiu ubhukumahe, keehaara uni umuene naakërrë ngaikara hamui na Taata kugitumbë keee kiu ubhukumahe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
