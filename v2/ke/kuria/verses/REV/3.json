        },
        {
          "text": "Örë arakëre narasuaribhui ichingëbho ichindabhu iga chai. Nani tiindihuta iriina reee kurua kögëtabhö kiö öbhöhoru hai; na nëëndëtara iriina reee mbere ya Taata na mbere ya abhamaraika bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno ana amatui, aigue amang'ana garë Nkoro agöteebhia ichikanisa!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
