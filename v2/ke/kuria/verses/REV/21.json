                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umugi göyö Tëgoorë gutuna iriöbha gösë umueri kögörabhiria gikugira ubhukumahe bhöë Ënooköë mbo öbhörabhu bhoogo, na ëkëmörë keego në Ëkëmaano ki Iring'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
