              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tënaarööchë ëhekaru kumugi göyö hai, Ömönene Ënooköë Umukumahe nëwe aarëngë ëhekaru yaago hamui na Ëkëmaano ki Iring'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
              "REV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
