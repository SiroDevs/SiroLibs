                "loc": "ISA.60.3"
              },
              "items": [
                {
                  "text": "Isa 60:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köbhörabhu bhoogo, ichihamatë chonsui nchiragende na abhagambi bhë ëkëbhara mbararente ubhukumahe bhoobho mönsë yaago. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.11"
              },
              "items": [
                {
                  "text": "Isa 60:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amahita gaago tëgaraasiikue ömöbhasö röndë hai, gikugira tibhutikö bhörëbha möyö röndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikuuge na ësööko yi ichihamatë nërërentöa mo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
