              "attrs": {
                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Sek 14:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika akaanyorokia ömooro göa amanchë gö öbhöhoru amarabhu iga chai gano ganga ikioho, garagera kurua kugitumbë kiu ubhukumahe kë Ënooköë na ëgë Ëkëmaano ki Iring'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Ögt 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ngoorë kögera gököhetera gataigatai, yi irirongatë irinene riu umugi. Mbarëka yö ömooro göyö ngoorëngë ho ömötë gö öbhöhoru, göno gökooma ichihagöe chi ichiteemo ikumi na ibhërë. Nago nkooma görë ichihagöe këra mueri, amatö gaago ni iriogo re kuhuenia ichihamatë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Sek 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.17"
              },
              "items": [
                {
                  "text": "Ögt 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëgëntö kërë gionsui këno keihiimua kërëbha kumugi göyö hai.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitumbë kiu ubhukumahe bhöë Ënooköë na ëgë Ëkëmaano ki Iring'ondi nkërëbha kumugi göyö na abhakoramërëmo bhaae mbarëmösengera. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarëmaaha ubhusiö bhooe na iriina reee ndërendëköa kömasiö gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.18"
              },
              "items": [
                {
                  "text": "Tan 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tibhutikö bhörëbha ho hai, na guiki tëbharituna öbhörabhu bhöë ëtara gösë bhui iriöbha hai, gikugira Ömönene Ënooköë narëbhamörëkëra, nabho mbarëgambëra kuya ëyö na ëyö.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uguucha ko Yesö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika aganteebhia iga, “Amang'ana gano na amaheene, na aga gukumibhua. Ömönene Ënooköë öno aköha abhanaabhi Nkoro naatömërë ömömaraika waae korri iga ooroki abhakoramërëmo bhaae amang'ana gano ga hang'i kurichokera.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tamaaha! Mböngö igo ndaache. Öwakehaiya nöno akögoota amang'ana gano gö öbhönaabhi garëngë kögëtabhö këno.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni Yohana nu uni naarööchë na kuigua amang'ana gano. Hano naisërë kögaigua na kömaaha, naairekeeyë hansë mbere ya amagörö gö ömömaraika ööra aanyorokiri amang'ana gayö, ngatuna iga mmösengere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono we aganteebhia iga, “Ötagaakora igo! Uni nö ömökoramërëmo ndë ke uwe na abhantö bhaitö abhanaabhi na bhano bhakögoota amaragirriö gano garëngë kögëtabhö këno. Uwe tasengera Ënooköë!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarëngëra gönteebhia guiki iga, “Ötagaacha gökora amang'ana gano gö öbhönaabhi gano garëngë kögëtabhö këno köbha agi ikibhisërë, gikugira ënkaaga hang'i ërë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.10"
              },
              "items": [
                {
                  "text": "Tan 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëno ëho bhoono niiga, öno akunyaanyuura agenderri kunyaanyuura, öno arëngë umunyanku agenderri köbha umunyanku. Öno arëngë ömöröngë agenderri gökora amaröngë na öno arëngë Ömöhoreeru agenderri köbha Ömöhoreeru.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        }
      ]
    },
