                  "text": "2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uni nu uni ‘Aribha’ na ‘Omega,’ öwa mbere na öwa gösookerria, ögötanga na masërra.”",
          "type": "text",
          "attrs": {
