              "REV.14.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Tan 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, nkamaaha irisaaro irirabhu, na guisaaro köyö nkanyoora ömöntö aikaayë ko öno anga ömoona wö ömöntö, aimiri ëköndö yë ësahaabhu kömötöe, naagoterreeyë ërënga inyögë gököbhoko kooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoe 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua Ömömaraika wöndë akarua köhekaru, agateebhia ööra wanyoorrë aikaayë guisaaro köngamba ënene iga, “Taimukia ërënga yaao ögese, kugira ënkaaga ya irigesa rë ëkëbhara ihikërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ööra wanyoorrë aikaayë guisaaro akarekera ërënga yaae gökëbhara irigesa rëkagesoa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika wöndë guiki akarua köhekaru kuriöbha aana ërënga inyögë.",
          "type": "text",
