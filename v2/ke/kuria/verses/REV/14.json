            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ese 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Öbhö 7:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guiki nkamaaha Ëkëmaano ki Iring'ondi kimëërëyë kunguku ya Sayuni hamui na abhantö ibhiköë irigana rimui na mërongo ënai na bhinai (144,000) bhano bhaana iriina reekio hamui na iriina re Isawaabho rendëkëröë kömahanya ga amasiö gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkaigua ëngamba kurua kuriöbha ëno yanga iya amanchë amaaru, na yanga ëkëbhagatiö ëkënene. Ëngamba ëno naiguurë yanga iya abharentia yaarë, bhano bhagötema ibhinande. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaarë gusiringia irisingio iriihëa mbere yi igitumbë kiu ubhukumahe na mbere yi ibhiteemoa ibhihoru bhinai bhiira hamui na abhagaaka bhaara. Tëmöntö aatörrë kuëga irisingio rëyö hai, gëtatiga abhantö ibhiköë irigana rimui, na mërongo ënai na bhanai (144,000) bhaara wanyoorrë bhaabhohoribhua kurua gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö mbaara bhaatakorrë öbhöraaya na abhagaikörö, nabho ni ibhitindë. Bho mbaarë gösoorana Ëkëmaano ki Iring'ondi harë honsui gikuya. Bhabhohoribhua kurua köbhantö bhandë na bhaabha kia amakö ga mbere kö Ënookë na gö Ëkëmaano ki Iring'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Seb 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëbhaabhaayë bharongo röndë hai; tëbhaana isoro rërë rionsui hai.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhamaraika bhatatö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha ömömaraika wöndë araibhurruka igörö köyö ana igichiiratë ge kuya ëyö, iga arundi köbhantö bhano bhamenyërë gökëbhara, gökëra hamatë, këra ikiaro, na këra këgambo kia abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagamba köngamba ënene iga, “Tasööka Ënooköë na kömögönga, kugira ënkaaga yaae ya gökenga ikiina ihikërë. Mötasengera öno aateemërë kuriöbha na ëkëbhara, ichinyancha hamui na ichinsëröka cha amanchë.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
