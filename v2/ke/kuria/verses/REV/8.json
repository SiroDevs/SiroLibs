              "attrs": {
                "loc": "REV.16.18"
              },
              "items": [
                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika ööra akaimukia ëgëkarangëro këëra agaichuria mo ömörro gööra gui irikëngë agakërekera gökëbhara; bhikarichokera ënköbha, ibhimenio na ikirigiti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
