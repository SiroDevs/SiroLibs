              "REV.20.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Tan 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha igitumbë kiu ubhukumahe ëkërabhu ëkënene na ömöntö aikaayë ko. Ëkëbhara na igörö kuriöbha bhikanyeregana mbere ya amaiso gaae, tibhiamaahëkaini guiki röndë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki nkamaaha abhaku abhanene na abhake, bhaimëërëëyë mbere yi igitumbë kiu ubhukumahe, na ibhitabhö bhikahönyöröa. Guiki ëgëtabhö këndë gëkahönyöröa, këno kërëngë ikiö öbhöhoru. Abhaku bhagakengeröa ikiina gököreng'aana na amakora gaabho, keebhörë wanyoorrë gandëkëröë kubhitabhö bhiyö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyancha ëkarichokia abhaku bhano wanyoorrë bhaamo, Uruku na Bhuku bhikarichokia abhaku bhano bhaarëngë mo. Bhonsui bhagakengeröa ikiina, këra umui köreng'aana na amakora gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Uruku na Bhuku bhigatabhutua kunyancha yö ömörro. Inyancha ëyö yö ömörro ndo uruku ro kabhëre. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ömöntö örë wonsui öno iriina reee rëtandëkëröë kögëtabhö këëra kiö öbhöhoru, naatabhutëröë kunyancha ëyö yö ömörro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
    }
