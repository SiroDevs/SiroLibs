            "number": "1",
            "style": "v",
            "sid": "REV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha ömömaraika araika kurua kuriöbha ana örösöngöro ro bhui na umunyorro ömönene gököbhoko kooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.1",
            "verseOrgIds": [
              "REV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Ögt 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akagoota irichoka rëëra, inchoka ëëra ya karai, ndio Irisambo na Setani – akarëbhoha ëmeeka ëgëköë kimui (1,000), ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
            "verseOrgIds": [
              "REV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akarërekera kuya bhui, akahasiika, agatema öröbhaaso këgörö yario, korri iga rëtagaacha köng'aina ichihamatë guiki, kuhika ëmeeka ëgëköë kimui (1,000) gisire. Na hano ëmeeka gëyö gëraasire ndëraigörröe hake igo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
      ]
    },
