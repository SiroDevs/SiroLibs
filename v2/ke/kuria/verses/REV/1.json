              "items": [
                {
                  "text": "Sab 89:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na kurua harë Yesö Kirisitö öno arëngë ömöherekia ömöheene, öwa mbere kuriukibhua kurua köbhaku na öno arëngë ömögambi wa abhagambi bhë ëkëbhara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
