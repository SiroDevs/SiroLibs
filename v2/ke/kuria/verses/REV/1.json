              "items": [
                {
                  "text": "Tan 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na gataigatai yi ibhitagacha bhiira bhi ichitara, nkamaaha ho ëgëntö këno kenga ömoona wö ömontö, nawe nkanyoora nasuarrë ënganchö ëntambë, na umuchibhi göë ësahaabhu gumuinaarrë igikubha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
