                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Öbhö 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aatökora köbha öbhögambi bhöa na abhanchaama, tökorre Ënooköë isawaabho ëmërëmo, ubhuhiku na ichinguru bhibhe harë Yesö Kirisitö kuya ëyö na ëyö! Amina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
