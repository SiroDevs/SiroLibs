              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "We natöhanchërë, na kömaanyinga gaae aatötachöra kurua gökëbhohe kia amaraga gaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
