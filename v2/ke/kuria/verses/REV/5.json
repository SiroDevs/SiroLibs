                "loc": "ISA.29.11"
              },
              "items": [
                {
                  "text": "Isa 29:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha ëgëtabhö gököbhoko ko bhörëo ko öyö aikaayë kugitumbë kiu ubhukumahe, nakio wanyoorrë nkendëkëröë mönsë na këbhara na gusiiköa na ëmëbhaaso muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkamaaha ömömaraika öno ana ichinguru ararundia köngamba ënene aragamba iga: “Ning'ui aisaini gösaria ëmëbhaaso gëyö na kuigöra ëgëtabhö këyö?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono tëmöntö örë wonsui aatöökërë kuriöbha gösë gökëbhara gösë ninyoora mönsë Bhui öno aatörrë kuigöra gösë kömaaha mönsë yakio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ngakuura bhökong'u kugira tëmöntö atökërë öno aisaini kuigöra ëgëtabhö këyö gösë kömaaha mönsë yakio hai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
