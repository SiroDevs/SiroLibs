              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua umui wa abhagaaka bhaara aganteebhia iga, “Tiga wange gukuura! Tamaaha! Indui kurua gukiaro ke Yuta, uruibhörö ro Tauti, aakërrë, we narasari ëmëbhaaso muhungatë gëyö hamui na kuigöra ëgëtabhö këyö.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
