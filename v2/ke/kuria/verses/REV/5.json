              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagamba köngamba ënene iga:",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
