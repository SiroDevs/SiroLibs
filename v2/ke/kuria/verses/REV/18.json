            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.16"
              },
              "items": [
                {
                  "text": "Ese 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhagambi bhë ëkëbhara bhano bhaakorre nawe öbhöraaya na kömenya nawe irimenya rë ëtantago mbarangunye na gukuura hano bharëmaaha iriooki riu umugi göyö gököhëa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbariimëërra harai gikugira ya koobhoha imiiriiro geego na kögamba iga, “Ëhöbhë, Ëhöbhë görë mugi mönene, Bhabheri umugi umunuhe na gui ichinguru! Gönkaaga imui igo bheene iribhörööta reeo rikunyoorrë.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
