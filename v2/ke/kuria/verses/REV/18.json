              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gayö gaasirrë, nkamaaha ömömaraika wöndë araika kurua kuriöbha. Nawe naarë na ögötöra ökönene bhökong'u na ëkëbhara gëkarabha kugira yö ököbharrukia kooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
