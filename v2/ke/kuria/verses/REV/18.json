                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua guiki nkaigua ëngamba yëndë kurua kuriöbha ëragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
