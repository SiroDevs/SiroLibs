              "items": [
                {
                  "text": "Ëgt 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ömömaraika wa gataano akahöma ëbhakuri yaae kugitumbë kiu ubhukumahe gi itiinyi ëëra na öbhögambi bhooe bhökabha kugisuntë, abhantö bhagatakuna ichindeme chaabho gikugira yö öbhörrö. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhakaihiima Ënooköë wa kuriöbha gikugira yö öbhörrö bhöyö na ibhisëësë bhiaabho bhino bhaarë nabhio. Ninyoora niigö, tëbhaatigërë amakora gaabho amabhëëbhë hai.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
    {
