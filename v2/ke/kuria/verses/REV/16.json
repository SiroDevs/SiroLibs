                "loc": "PSA.78.44"
              },
              "items": [
                {
                  "text": "Sab 78:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömömaraika wa gatatö nawe akahöma ëbhakuri yaae kumiörö na kubhichebhichebhi bhionsui bhia amanchë, nabhio bhikabha amaanyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaigua ömömaraika öno ana ögötöra igörö ya amanchë aragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
