            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömömaraika wa kabhërë akahöma ëbhakuri yaae kunyancha, na inyancha ëkabha amaanyinga kiö ögö ömöntö öno akuurë; këra gëntö kunyancha, këno këëna öbhöhoru, këgakua.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
