              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkaigua ëngamba ënene kurua köhekaru erabhateebhia abhamaraika bhaara muhungatë iga, “Mötaya möhöme ichibhakuri chiyö muhungatë chu ubhusinanku bhöë Ënooköë gökëbhara.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
