              "items": [
                {
                  "text": "Isa 51:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umugi ömönene gööra gögaatëka amang'ënga atatö na imigi gi ichihamatë gëgasaamböa na kögërësëra. Bhabheri, umugi ömönene, ngoohëëtökëröë na Ënooköë. Naaguniisiri ëgëkombe gi itibhaai yu ubhusinanku bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.19",
            "verseOrgIds": [
              "REV.16.19"
            ]
          }
