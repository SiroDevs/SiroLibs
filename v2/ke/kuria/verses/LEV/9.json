            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Ëbh 6:22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Haruni aasookiri kuruusia ichisataaka chonsui: Ikimuenso ki iriraga, ibhimuenso bhia gösambërëërröa, ikimuenso kiö ömörembe, naimukirriiyi amabhoko na köbhaitaibhiria, hakurua agasëkëra hansë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa na Haruni bhakaya guitunteera re gusikanëra; na hano bhaarichokërë mbaitabhiiyi abhantö na ubhuhiku bhö ÖMÖNENE bhökamaahëkana köbhantö bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
