            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.1+LEV.3.2+LEV.3.3+LEV.3.4+LEV.3.5+LEV.3.6+LEV.3.7+LEV.3.8+LEV.3.9+LEV.3.10+LEV.3.11"
              },
              "items": [
                {
                  "text": "Abhar 3:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Haruni agasincha ëgaini na iguruki, köbha ikimuenso kiö ömörembe kugira ya abhantö. Abhaana bhaae bhakamörentera amaanyinga, nawe akamösëra irikëngë kuriinaaria. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na öbhönöre bhuë ëntang'ana na ubhui iguruki, ömökëra, na igitinya këno gikundikiiyi ibhianda, ibhimiumiu na ëkeenakeini, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhakabhitööra kömëtëma na akabhisambërëërra guikëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Haruni akarenta mbere yö ÖMÖNENE igituho gë ësataaka ya götentia yë ëmëtëma na ibhinama bhia bhöreo, ke bhööra Mösa aasimisiiyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
