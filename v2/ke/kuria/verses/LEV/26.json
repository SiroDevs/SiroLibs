                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hayö nëëndëhëëtöka imuuma yaane na Yakobho, nëëndëhëëtöka imuuma yaane na Isaka, nëëndëhëëtöka imuuma yaane na Ibhurahimu, na nëëndëhëëtöka ënsë.",
          "type": "text",
