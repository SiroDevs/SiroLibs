    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Enkaaga ëno bharinyoora bharëngë isikö yë ënsë yaabho, ënsë ëyö nëërëgookera ichisabhaato chaayo ërëngë inchua. Ënkaaga ëyö nabho mbarëtöbhöra ubhunyanku bhoobho bho konga kuiguëra amaragirriö gaane, na ömooyo goobho kögarëga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkanyoora niigo ënkaaga ëno ndinyoora bhaarëngë gönsë ya abhabhisa bhaabho, tëndëbharëga hai, gösë köbhasikia na köbhaseereekia na gösaria imuuma yaane nabho hai. Kugira uni nö ÖMÖNENE, Ënooköë waabho ndë; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga gukugira yaabho nëëndëhëëtöka imuuma yaane na bhaaguuka bhaabho, bhano naarentërë kurua gönsë ya Misiri mbere ya amaiso gi ichihamatë korri nëbhe Ënooköë waabho. Uni nö ÖMÖNENE ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
