        "style": "s1"
      },
      "items": [
        {
          "text": "Ësataaka yi ibhiakörea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömöntö örë wonsui arenta ësataaka yi ibhiakörea kö ÖMÖNENE kuhika ëbhe öbhöse öbhögetiahöma mo amaguta na atööra kobhöbhaani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "arenta köbhanchaama bhu uruibhöro ro Haruni. Gösataaka ëyö yi ibhiakörea, umunchaama akumbata kurua mo ënsaanyi yö öbhöse öbhögeta, amaguta na öbhöbhaani bhonsui na köbhisambërëërra guikëngë koorokia iga bhionsui mbiruusibhöë kö ÖMÖNENE. Ëyö në ësataaka yi ikimuenso kiö ömörro ëno isiisui yaayo ëgötegeria ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iring'enga rë ësataaka yi ibhiakörea rëno ritigaayë rëbha ëre Haruni na abhaana bhaae; rëyö ni iring'ënga irihoreeru bhökong'u kugira ni irimui ri ikimuenso ke gösambërëërröa kö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ömöntö arenta ësataaka yi ibhiakörea ëno ësambërë kuhika ëbhe ëmëgaate gëno gëtatöörröë ëmëmera gëtatiga amaguta bheene, gösë ëmëgaate ëmëhöhö gëno gëhakëröë amaguta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoora ësataaka yi ibhiakörea niyö ömögaate ömösambë kuhika ëbhe öbhöse öbhögeta bhöno bhötaana mëmera, bhuichogaini amaguta gi ichiseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëmëgaate gëyö gëbhötöröabhötöroa na guitereerroa amaguta. Ëyö na ësataaka yi ibhiakörea. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano nyoora ësataaka yaao na ësataaka yi ibhiakörea ya kuihëkëra kögëkarangëro kuhika ëbhe ëyö öbhöse öbhögeta na amaguta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örenta ësataaka yi ibhiakörea ëno ëkoreeyöë ibhintö bhiyö kö ÖMÖNENE; na hano ëkörentöa kumunchaama nawe agihire guikëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gösataaka yi ibhiakörea ëyö, umunchaama aimukia mo ikimuenso kë ëhëëtöko na kögësambörëërra guikëngë, koorokia iga bhionsui mbiruusibhöë kö ÖMÖNENE. Ëyö në ësataaka yi ikimuenso kiö ömörro ëno isiisui yaayo ëgötegeria ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iring'enga rë ësataaka yi ibhiakörea ëno itigaayë ëbha iya Haruni na abhaana bhaae; rëyö ni iring'ënga irihoreeru bhökong'u kugira ni irimui ri ikimuenso ke gösambërëërröa kö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ësataaka yi ibhiakörea ërë yonsui örarente kö ÖMÖNENE tëratööröë ëmëmera; igo muriihe mötagaacha götööra ëmëmera kömëgaate gösë öbhöke hano wanyoora na ësataaka yö ÖMÖNENE ëno egösambërëërröa kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëyö në ësataaka yi ikimuenso kiö ömörro ëno isiisui yaayo ëgötegeria ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyi örarönga ömönyö gösataaka yi ibhiakörëa bhionsui; ötagaacha gutiga götööra ömönyö gui imuuma na Ënooköë waao gösataaka yi ibhiakörea.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano waruusia ësataaka yi ibhiakörea bhiö öbhötongore kö Ënooköë bhöbha mböno bhöseemiibhöë kögösamboa gösë gösëëbhöa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ögëtöörre amaguta na öbhöbhaani; ëyö në ësataaka yi ibhiakörea. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösataaka ëyö, umunchaama asambërëërra ikimuenso kë ëhëëtöko ki ibhiakörea bhino bhihöörröë na amaguta na öbhöbhaani bhonsui, koorokia iga bhionsui mbiruusibhui kö ÖMÖNENE. Këyö ni ikimuenso ke gösambërëërröa kömörro këno isiisui yaakio ëgötegeria ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    }
