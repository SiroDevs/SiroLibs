              "attrs": {
                "loc": "DEU.15.12+DEU.15.13+DEU.15.14+DEU.15.15+DEU.15.16+DEU.15.17+DEU.15.18"
              },
              "items": [
                {
                  "text": "Ëhë 15:12-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Hano nyoora Umuisiraeri weinyu abhaayë ömötaka aiguurri harë uwe ötagaacha kömökora kiö ömögöre. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëtatiga amenya na uwe kiö ömökoramërëmo waao kuhika ömooka göë ëhëëtöko yö öbhötachöre bhöë ënsë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo we na abhaana bhaae arua waao na kuringa waabho kuirëma re bhaaguuka waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Abhaisiraeri na abhakoramërëmo bhaane bhano naaruusiri Misiri, igo, bhatagaacha kuguribhöa kia abhagöre. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötagaacha kömökorra ëkëbhoorooro, gëtatiga ösööke Ënooköë weinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö ya abhagöre bhë ëgësaacha na ëgëkari, nökabhagöra kurua guchihamatë chino muturraini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë nökabhagöra kurua kubhaitongo bhano bhamenyërë na bhainyu na imigi geebho hayö gërë, na naabhaibhörro bha hayö. Bhayö mbaraabhe ibhintö bhiao. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagöre bhayö nökaaha abhaana bhaao ömöndö. Bhayö mbo ögakora abhagöre bhaao, si igörö yu Umuisiraeri mura omoinyu ötagaacha kömöbhooroora.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
