          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga gutuna ëgëtööra ko gukurua harë we, gëtatiga mösööka Ënooköë weinyu; korri mura omoinyu amenye harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
