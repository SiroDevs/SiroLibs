              },
              "items": [
                {
                  "text": "Ëgt 22:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19"
              },
              "items": [
                {
                  "text": "Ëhë 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
