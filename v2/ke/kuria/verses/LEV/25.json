              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wanga kömöha isiire iga akuringiri në ëgëtööra ko, gösë kömöha ibhiakörea iga unyoore ubhuëra. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni nu uni ÖMÖNENE, Ënooköë waao öno naabharuusiri Misiri iga korri mbahe ënsë ya Kanaani na nëbhe Ënooköë weinyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
