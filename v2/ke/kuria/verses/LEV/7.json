          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëyö ngio imigiro gi ibhimuenso bhia gösambërëërröa, gë ësataaka yi ibhiakörea, gë ikimuenso ki iriraga, ikimuenso ki irisaria, ge köhaköa amaguta, na ibhimuenso bhiö ömörembe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëno ÖMÖNENE aaruusiiyi Mösa ëngamba kunguku ya Sinai hano aasimisiiyi abhantö bha Isiraeri iga bhamörentere ichisataaka chaabho, bhaarëngë guiköngö re Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
