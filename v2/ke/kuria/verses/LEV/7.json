{
  "id": "LEV.7",
  "number": "7",
  "bookId": "LEV",
  "reference": "Abharawi 7",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "LEV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësataaka yë ëhakano yi irisoro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Göno ngo umugiro göë ikimuenso ki irisaria. Në ësataaka ënhoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasë haara bhagösënchëra ibhimuenso bhia gösambërëërröa nho bheene bharaayi bharasënchëra ikimuenso ki irisaria, na amaanyinga gaayo gaminchöa kuinaara irikëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhönöre bhooyo bhonsui bhömuensoroa guikëngë; ömökëra, igitinya këno gikundikiiyi ibhianda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibhimiumiu bhionsui nö öbhönöre bhoobhio na ëkeenakeini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunchaama abhisambërëërra guikëngë gë ësataaka ëno ikuruusiribhöa OMONËNË kömörro. Këyö ni ikimuenso ki irisaria. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhaana bha abhanchaama bhë ëgësaacha mbakaagërea; kinyeeroa ahasë ahahoreeru; kugira në ëkëhoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugiro gui ikimuenso ki irisaria na gui ikimuenso ki iriraga ngumui: Umunchaama öno agökora ësensööro ëyö nëwe akuhira ësöro yë ësataaka ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irisaaköa ri itugo yi ikimuenso ke gösambërëërröa ni riu umunchaama öno amuensere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësataaka yi ibhiakörea ërë yönsui ësambëröë kögësörro gösë ëkarangëröë kögëkarangëro ni yu umunchaama öno agiruusiri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na këra ësataaka yi ibhiakörea ëno ichoganiibhöe amaguta gösë inyömö igo, ëyö ni ya abhaana bha Haruni, bhatuënane bhareng'aane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësataaka yi ibhimuenso bhiö ömörembe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gëno ngiö imigiro gë ikimuenso kiö ömörembe këno ömöntö akaruusiria ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoora në ësataaka yu umukumo, kuhika aruusi nu umukumo amandasi gano gaichoganibhöë na amaguta na gataana mëmera, ëmëgaate ëmëhöhö gëno gëhakërë amaguta na gëtaana mëmera, na amandasi gano gakoreeyë öbhöse öbhögeta bhöno bhuichoganibhöë na amaguta bhuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamui na ikimuenso kiö ömörembe keee na ësataaka yu umukumo, arentana ko amandasi gano gaana ëmëmera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua kubhintö bhiyö, aruusiria ÖMÖNENE ërendaasi rimui harë këra sataaka, na ibhindë bhiyö bhibha bhiu umunchaama öno amincha amaanyinga gi ikimuenso kiö ömörembe guikëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama yi ikimuenso kiö ömörembe ëyö iruusibhöë ësataaka yu umukumo kuhika ërëëbhöë isire röyö bheene; ëtagaacha gutigibhöa ninyoora në ëgëtari këraare kuhika inkio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano wanyoora ësataaka yaae yi ikimuenso kiö ömörembe na ësataaka yë ëndagano, gösë ësataaka ya kimuguuni, kuhika ërëëbhöë röyö bheene iruusiibhöë, na ëno ëtamërë ërëëbhöa icho yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, inyama yë ësataaka yi ikimuenso ëno yaatama kuhika urusikö ro gatatö ësambërëërröa kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano inyama yë ikimuenso kiö ömörembe yaraara ërëëbhöë kurusikö ro gatatö, ömöntö wë ësataaka ëyö taguitabhirribhöa hai, gösë ësataaka ëyö guitabhirribhua kubhuëra bhooe; ëyö nyoora ësarëkërë, na öno akögërea nguitungöa arë nu ubhunyanku bhooe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inyama ëno ëgoteeyöë ibhikui ëtakarëëbhöa; ëyö ërasambërrëërröa kömörro. Bhano bhonsui bharëngë abharabhu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbakaarea inyama yi ikimuenso kiö ömörembe kiö ÖMÖNENE. Si öno ana ibhikui hano area inyama ëyö agiröa na abhantö bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö aturubhaini ëgëntö ki ibhikui, nënkanyoora ni ibhikui bhiö ömöntö gösë itiinyi gösë kërë gionsui ki ibhikui këno kërëngë ikiriirriö, hakurua arë inyama yë ikimuenso kiö ömörembe ëno ÖMÖNENE akuruusibhua, ömöntö öyö kuhika agiröa na abhantö bhaae.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhia abhantö bha Isiraeri iga, Mötakaaya mörarea öbhönöre bhöë ëng'ombe, iring'ondi gösë imburi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhönöre bhui itugo ëno ikuurë inyene, gösë bho ëno itëröë ni ing'iti, mbögakora kërë gionsui si tëbhookörea hai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öre wonsui öno araare öbhönöre bhui itugo ëno iruusiibhui ësataaka yö ÖMÖNENE kömörro öyö agiröa na abhantö bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
