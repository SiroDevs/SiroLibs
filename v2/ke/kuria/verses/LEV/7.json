                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igörö ya gayö, harë honsui mömenyërë mötagaacha körea amaanyinga garë gonsui, gabhe ga kinyunyi gösë itiinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öre wonsui area amaanyinga garë gonsui agiröa na abhantö bhaae.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
