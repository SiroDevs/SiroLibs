              "LEV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano Haruni asookia gösönsööra ahasë ahahoreeru, iritunteera re gusikanëra na irikëngë, arenta ëgorohe ëhoru ëëra ya Asaseri, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Tob 8:3",
              "type": "text"
            }
          ]
        },
        {
          "text": "agëtöörra amabhoko kömötöe, na götöbhöra ubhunyanku bhonsui bhoa abhantö bha Isiraeri, amasaria gaabho gonsui na amaraga gaabho gonsui na kögatööra kömötöe göë ëgorohe ëyö, na agëhatëra ihiröa guiköngö na ömöntö öno nkunyoora aseemiibhui gökora igo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni ahatëra ëgorohe ëyö ëgenda guiköngö ahasë hano abhantö bhatarë, imukiri ubhunyanku bhoobho bhonsui.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
