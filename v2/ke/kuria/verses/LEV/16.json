        },
        {
          "text": "“Hakurua Haruni aringa asoha guitunteera re gusikanëra na kuruusia ichingëbho chiira chë ëhanga inyëke chino nkunyoora asohiri araya ahasë ahahoreeru na guchitiga mo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi aisabha köhasë ahahoreeru möyö na gösohia ichingëbho chaae. Aya kuruusia ikimuenso keee ke gösambërëërröa na ikimuenso ke gösambërëërröa abhantö. Igo aisönsööra na gösönsööra abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitinya ki ikimuenso ki iriraga agësambereërra guikëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö ööra ahirrë ëgorohe harë Asaseri hano aringa, ahura ichingëbho chaae na guisaabha nëho agösoha guisanchö. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Ibr 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëgaini na imburi bhiira bhiruusiibhöë ikimuenso ki iriraga bhino amaanyinga gaabhio gahirröë gösönsööra ahasë ahahoreeru, bhihiröa këbhara yi irisanchö na gösambërëërroa ho. Irisaaköa, ichinyama na ubhuhu bhoobhio bhionsui mbisambërëërroa ho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno abhisambërëërra, ahura ichingëbho chaae na guisaabha nëho aringa guisanchö.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
