              "attrs": {
                "loc": "MRK.9.2+MRK.9.3+MRK.9.4+MRK.9.5+MRK.9.6+MRK.9.7"
              },
              "items": [
                {
                  "text": "Mk 9:2-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.28+LUK.9.29+LUK.9.30+LUK.9.31+LUK.9.32+LUK.9.33+LUK.9.34+LUK.9.35"
              },
              "items": [
                {
                  "text": "Ruk 9:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira Yesö naanyoorrë ëgöngö na ubhuhiku kurua harë Ënooköë Taata hano ëngamba yaamöchëëyë kurua harë ööra arëngë Ubuhiku Ömönene ëragamba iga, “Öyö nö ömoona Waane, Ömöhanchöa waane öno ngötegeribhua nawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö ntoiguurë ëmbërëkëra ëyö kurua kuriöbha hano toörëngë hamui nawe kunguku ënhoreeru ëëra.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhaitö guiki ntööna ëng'ana ëëra yö öbhönaabhi ëno ërëngë ëheene kimui. Na bhainyu mörakore bhuuya hano möraigue kimui, kugira nërëngë gë ëtara ëno gëkömörëka kugisuntë kuhika urusikö ruhike na inyunyuunyi yi inkio ërabhe kumioyo geinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanga mömanye ëng'ana ëno guiki iga öbhönaabhi tëbhörëngë kö Amandëko bhöno bhököhönyöröa keebhörë ömöntö nyabhörebhe ahanchërë umuene hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira öbhönaabhi bhöyö tëbhoorenteröë ahasë harë honsui haara keebhörë ömoona wö ömöntö agutuna hai, gëtatiga abhantö mbaagambërë gaara gaaruurë harë Ënooköë na götangatöa na Nkoro Nhoreeru.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
