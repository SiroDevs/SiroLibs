            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni Simioni Bhetero ömökoramërëmo na ömötömöa wa Yesö Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhandëkëra bhonsui bhaara moonyoora ubhukumia bhööra bhööna ubhuëra kiu ubhukumia bhoitö, gököhetera kö öbhöröngë bho Ënooköë Taata na Umutuuria weitö Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita na ömörembe bhiiyengeri harë bhainyu gökömanya Ënooköë na Yesö Ömönene weitö.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmbërëkëra yë Ënooköë na öbhoohuri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ögötöra köë Ënooköë gootöha ibhintö bhionsui bhino bhigutunua gikugira yirimenya na ubhusuuki bhöë Ënooköë, nabhio ntoobhinyoora gönchëra yö ökömanya ööra aatöbhërëkëëyë tunnyoore ubhuhiku na ubhuuya bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki gököhetera kubhintö bhiyö aatöha ichindagano ichinene bhökong'u, na ichu ubhuëra, korri iga gököhetera harë chio mötöre gösanga öbhönooköë bhooe, ëbhatuuri möng'ose kurua kubhunyanku bhöno bhörëngë gökëbhara gikugira yu ubhuigombi bhoomo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira yë ëng'ana ëyö bheene möhangarre bhökong'u muengeri ubhuuya kubhukumia bhoinyu, na kubhuuya bhöyö muengeri öbhöng'aini, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "köbhöng'aini bhöyö muengeri köbha na ëkërengere na gökerëëngërë këyö muengeri ubhugumirria, kubhugumirria muengeri ubhusuuki bhöë Ënooköë, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.6",
            "verseOrgIds": [
              "2PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kubhusuuki bhöë Ënooköë muengeri ököhanchana na gököhanchana köyö muengeri öbhöhanchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano ndanyoore amang'ana gayö möönago, na ngaichööyë kimui harë bhainyu ngarabhakore monge köbha abharosu gösë abhantö bhano bhataana amakora, gökömanya Ömönene weitö Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.8",
            "verseOrgIds": [
              "2PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömanye iga ömöntö örë wonsui öno ataana gayö nu umuhukuru, tagaatöra kömaaha ibhintö bhino bhirëngë harai hai; ëëbha, guiki keebhörë aasaabhuurruë na koobhëröa amaraga gaae gaara gaahetërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.9",
            "verseOrgIds": [
              "2PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö bhantö bhaitö möhangarre kimui mökore ökoobhërëröa na ökoohöröa koinyu köbhe ököheene kugira hano mörakore igo tëmöituuratuura mögöe hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.10",
            "verseOrgIds": [
              "2PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönchëra ëyö mmörahaabhöe umueya ömögarë go gösoha köbhögambi bho kuya ëyö öbhö Ömönene na Umutuuria weitö Yesö Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni nëndagenderri köbhahitukia amang'ana gayö ninyoora mmögamanyërë na guiki moherekibhua köbhöheene bhöno möönabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkömaaha ndë iga mbuuya nkore igo nkërëngë ömöhoru, gö köbhatakia gönchëra ya köbhahitukia. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë iga uruku roone nhang'i rörë keebhörë Ömönene weitö Yesö Kirisitö aisa kunyorokia. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nëndahangarre mmaahe iga nkaaga chonsui nkuhiita mörë amang'ana gano hano ndaise gukua.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhöherekia bhu ubhuhiku bho Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira bhaitö tëtoosoorainë amagano gano gandëkëröë köbhöng'aini hai, hano toobhateebherreeyi igörö yi ichinguru chö Ömönene weitö Yesö Kirisitö na ukuringa kooe, ëtarë iga wanyoorrë toisa kömaaha na amaiso gaitö ubhuhiku bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
