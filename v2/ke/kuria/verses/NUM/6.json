              "NUM.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23"
              },
              "items": [
                {
                  "text": "Ama 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Göno ngo umugiro gö Ömönasiri hano wanyoora asookiri ënkaaga yaae ya guisaabhuura: Arentöe kuihita ri iritunteera re gusikanëra, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuruusiria ÖMÖNENE ibhituho bhiae: Ikiguruki kiö ömooka gumui këno gëtaana këbheera këbhe gikugira yi ikimuenso ke gösambërëërröa; na aruusi ichöörö yö ömooka gumui ëno ëtaana këbheera, ëbhe ikimuenso ki iriraga; na iguruki imui ëbhe ikimuenso kiö ömörembe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua aruusi ëmëgaate gëno gëtatöörëëyöë ëmëmera gichööyë ëkëgabhö; amandasi gö öbhöse öbhögeta na amaguta na ëmëgaate iminyerre na amaguta hamui na ësataaka yi ibhiakörëa na ësataaka yi ikinyuëbhöa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umunchaama aruusiri ÖMÖNENE ibhintö bhionsui bhiyö hamui na ikimuenso ki iriraga, na ikimuenso ke gösambërëërröa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aruusiri ÖMÖNENE iring'ondi rëbhe ikimuenso kiö ömörembe, ariruusi hamui na ëkëgabhö kë ëmëgaate gëno gëtatöörröë ëmëmera, guiki umunchaama aruusi hamui na ësataaka yi ibhiakörëa bhiakio na ësataaka yi ikinyuëbhöa geekio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuihita ri iritunteera re gusikanëra hayö, Ömönasiri öyö naragingire ituukia yaae na agëtööre kömörro göno görëngë hansë yi ikimuenso kiö ömörembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hakurua umunchaama aimuki irirëko ri iring'ondi iguruki rëëra, nario nyoore rësamukiibhui hamui na ërendaasi rimui rëno rëtöörröë ëmëmera gukurua gökëgabhö hamui na ëmëgaate iminyerre gëno gëtatööröë ëmëmera na ahe umuiruusia öra kömabhoko gaae hano asookiri kugingira ituukia yaae ëno aarëngë nayo gönkaaga ya gösaabhuurua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua umunchaama abhitenti bhionsui gë ësataaka ya götentia mbere yö ÖMÖNENE, bhionsui bhiyö ni iring'ënga irihoreeru kumunchaama, hamui na ömötëma göno gusingisiibhui, na ëkënama këno kiruusiibhui köbha ësataaka. Hano gayö gagusira umuiruusia öra aratöra bhoono kunyua itibhaai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Göyö ngo umugiro göno guitungërë umuiruusia öno aihimirriiyi. Ësataaka yaae kö ÖMÖNENE ëreng'aane na ukuiruusia kooe, ninyoora aratöra kuruusia ëkëndë kërë gionsui këno aratöre kuruusia; akore köreng'aana na ukuiruusia könö wanyoorrë airusiri, keebhörë umugiro gu guisaabhuura kooe görëngë.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uguitabhiria köa abhanchaama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
