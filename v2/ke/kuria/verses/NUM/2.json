        },
        {
          "text": "“Hakurua abhantö bhi ikiaro ke Nabhutari mbo bharasohe, ömötangati waabho naraabhe, Ahira ömoona wa Enani; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
