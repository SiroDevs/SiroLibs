          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Göntahana ya mööchë bhaara bhaarëngë hansë yë ëndembeera ya Tani mbo bharaabhe ho. Ömötangati waabho naraabhe Ahieseri ömoona wa Amisatai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "irikomo reee gököreng'aana na ëbharo ndëraabhe na abhantö ibhiköë mërongo ësansabha na bhibhërë na amagana muhungatë (62,700). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua bhaara bharöösëre irikomo rëyö na abhantö bhi ikiaro ke Aseri, ömötangati waabho naraabhe, Bhagieri ömoona wa Okorani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irikomo reee gököreng'aana na ëbharo ndëraabhe na abhantö ibhiköë mërongo ënai na kimui na amagana ataano (41,500).",
          "type": "text",
