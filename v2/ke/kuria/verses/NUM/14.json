                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.9"
              },
              "items": [
                {
                  "text": "7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "‘Uni ÖMÖNENE tënkongoha körëërra hai, nöwöbhöhanchi öbhögöme ndë, na nkoobhera ndë amasaria na öbhötanini. Sibhoono këbhe kë tënkaamocha körenta iritemo köbhaana na abhachökörö köhëkëëra iriköra re gatatö na ëre kanai kömaraga ga abhaibhuri bhaabho.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakögeya wabhëre abhantö bhano amaraga gaabho, ëkërengere kiö öbhöhanchi öbhögöme bhooo, ke bhööra wabhabhëëyë gukurua bhaaruurë Misiri köhëkëra bhoono.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akahunchukia iga, “Mbabhëëyë ke bhöyö ösabhëre. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Ibr 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono köbhöheene, uni öno, ndatuenerria, na kebhörë ëkëbhara gionsui këraichuribhöe ubhuhiku bhö ÖMÖNENE, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "taaho ninyoora nu umui wa abhantö bhano öno aarööchë ubhukumahe bhoone na ibhirögööro bhiane bhino naakorrë Misiri na guiköngö, hakurua agenderri gönsaacha ërei ikumi rëno gökonga kunyigöëëra ëngamba yaane; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "arasohe gönsë ëëra naragaini köha bhaguuka bhaabho; bhöyö bheene ninyoora mbaara bhagönsera tëbhakamaaha ënsë ëëra hai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
