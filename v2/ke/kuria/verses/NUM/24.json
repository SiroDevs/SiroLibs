          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaamu agateebhia Bharaki iga, “Gösë, nëtaateebhiri abhatömöa bhaara waatömërë harë uni iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaki nakang'a inyumba yaae yonsui ichööyë amatiini gi ichimbiria na ësahaabhu, tënkamanya kohökëra kurua bhööra ÖMÖNENE abhöörrë, ngambe agaane umuene gabhe maiya gösë mabhëëbhë, këno bheene ÖMÖNENE aranteebhi nkio bheene ndagambe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhönaabhi bho gösookerria bho Bharaamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
