              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono Bharaamu aköngöra iga, ÖMÖNENE ngutuna arë iga Abhaisiraeri bhaitabhiribhui, köhayö taagëëyë köragöröa hai, akaya aramaahërra guiköngö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamaahëërra igörö akamaaha Abhaisiraeri keebhörë bhahagaachërë këra ikiaro ahaakio. Hakurua Ënkoro yë Ënooköë ëkamööchëra, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe akaruusia ëngamba ëno öbhönaabhi iga:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
