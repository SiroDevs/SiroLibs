          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua akaruusia öbhönaabhi bhöno iga:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
