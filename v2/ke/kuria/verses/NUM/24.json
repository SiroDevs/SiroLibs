          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaamu agateebhia Bharaki iga, “Bhoono ndaya köbhantö bhaane, nchö mbe ngöteebhi gano abhantö bhano bharëkorra abhantö bhao guchinsikö cha mbere.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
