              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbaarëngë abhantö ibhiköë bhibhërë amagana asansabha na mërongo ëtatö (2,630). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.40",
