          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhë ëgësaku ke Gerisoni gököreng'aana na ichika chaabho, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.38",
            "verseOrgIds": [
