          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakandëka abhantö bhonsui bhano bhaana ëmeeka gatai ya mërongo ëtatö na mërongo ëtaano, örë wonsui aisaini gösoha kömërëmo gi iritunteera re gusikanëra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.35",
            "verseOrgIds": [
              "NUM.4.35"
            ]
          }
        },
