                  "text": "Mk 6:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "öno arabhatangate na köbharagirria kömërëmo geebho gionsui, korri bhatagaacha köbha kia amang'ondi gano gataana mmuriisia.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
