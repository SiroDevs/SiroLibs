            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa nawe agasabha ÖMÖNENE iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ÖMÖNENE, Ënooköë öno örëngë ënsëmöka yö öbhöhoru bhonsui, ndakögeya wahöre ömöntö wa kuimërëërra ëhamatë ëno, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
