            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Mösa iga: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.11",
            "verseOrgIds": [
              "NUM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Ëgt 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Maahaa mbe, naahööyë Abharawi kurua kö Abhaisiraeri bhonsui, bhaikare iribhaga ria abhatangi bhë ëgësaacha harë këra ruibhöro ro Isiraeri. Abharawi na abhantö bhaane, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12",
            "verseOrgIds": [
              "NUM.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhatangi bhonsui naabhaane; kurua kurusikö rööra naitirë abhatangi bhonsui bha Abhamisiri, naiyahörëëyë abhatangi bhonsui bha Isiraeri bhakabha abhaane; abhatangi bha abhantö na abhichitinyi mböyö bhöyö bheene; bhionsui bhiyö ni ibhiane. Uni nu uni ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.13",
            "verseOrgIds": [
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
