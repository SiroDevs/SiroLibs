    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Örögendo ro kurua Misiri kuhika Moabhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chino ncho ichimberi cha Abhaisiraeri bhaatöörrë irisanchö nkaaga bhaarë kurua Misiri bharëngë amakomo gi ibhiaro bhiabho bharatangatöa na Mösa na Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösa nandëkërë iriina re këra hasë hano bhaatöörrë irisanchö, gukurua öröbheri kuhika öröbheri röndë, köngamba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagatanöra kurua Ramesesi urusikö ro ikumi na gataano ru umueri go mbere, urusikö rumui hano ëbhasaka ya mbere yaisërë köheta. Abhaisiraeri mbaatanööyë köbhökarë öbhönene mbere ya Abhamisiri bhonsui, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.3",
            "verseOrgIds": [
              "NUM.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ënkaaga ëyö bharatökëra abhatangi bhaabho bhano wanyoorrë ÖMÖNENE aitërë; gikugira ÖMÖNENE wanyoorrë abhöröötërë ninyoora ni ichinooköë chaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhaisiraeri bhagatanöra kurua Ramesesi bhagatööra irisanchö reebho Sukoti haara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.5",
            "verseOrgIds": [
              "NUM.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Sukoti bhakaya bhahika Etamu, göno goorëngë kö ëbhaga yi iriköngö. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.6",
            "verseOrgIds": [
              "NUM.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Etamu bhakaihönchöra bhakaringa Bhi-hahiroti, rögörö ya Bhaari-sebhoni bhagatöörra irisanchö reebho hang'i na Migitori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.7",
            "verseOrgIds": [
              "NUM.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatanöra kurua Bhi-hahiroti, bhakaheta Nyancha Mberretu na gösoha guiköngö; bhakagenda örögendo rui ichinsikö isatö guiköngö re Etamu, bhagatöörra irisanchö reebho Mara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.8",
            "verseOrgIds": [
              "NUM.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Mara bhakaya bhakahika Erimu, hayö nëho bhaanyoorrë ichinyörrö cha amanchë ikumi na ibhërë na ëmëtende mërongo muhungatë, hayö nëho bhatöörë irisanchö reebho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagenda gukurua Erimu bhagatöörra irisanchö reebho hang'i na Nyancha Mberretu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.10",
            "verseOrgIds": [
              "NUM.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Nyancha Mberretu bhakaya bhagatööra irisanchö reebho guiköngö re Sini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.11",
            "verseOrgIds": [
              "NUM.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua guiköngö re Sini bhakaya bhakahika Tobhuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12",
            "verseOrgIds": [
              "NUM.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakarua Tobhuka bhagatööra irisanchö reebho Arusi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.13",
            "verseOrgIds": [
              "NUM.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Arusi bhakaya bhakahika Rebhitimu, ahasë hano hataarë na manchë ga kunyua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.14",
            "verseOrgIds": [
              "NUM.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatanöra kurua Rebhitimu, bhakaya bhagatööra irisanchö reebho guiköngö re Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.15",
            "verseOrgIds": [
              "NUM.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua guiköngö re Sinai bhakaya bhagatööra irisancho reebho Kibhuroti-hataabha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.16",
            "verseOrgIds": [
              "NUM.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatanöra kurua Kibhuroti-hataabha bhakahika Haseroti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.17",
            "verseOrgIds": [
              "NUM.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Haseroti bhakaya bhagatööra irisanchö reebho Ritima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.18",
            "verseOrgIds": [
              "NUM.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Ritima bhakaya bhagatööra Rimon-bheresi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.19",
            "verseOrgIds": [
              "NUM.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Rimon-bheresi bhakaya bhagatööra Ribhuna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.20",
            "verseOrgIds": [
              "NUM.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Ribhuna bhakaya bhakahika Risa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.21",
            "verseOrgIds": [
              "NUM.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaaruurë Risa bhakaya bhagatööra irisanchö reebho Keherata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.22",
            "verseOrgIds": [
              "NUM.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Keherata bhakaya bhagatööra irisanchö reebho kunguku ya Sebheri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.23",
            "verseOrgIds": [
              "NUM.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Sebheri bhakaya bhagatööra irisanchö reebho Harata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.24",
            "verseOrgIds": [
              "NUM.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Harata bhakaya bhagatööra irisanchö reebho Makeroti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.25",
            "verseOrgIds": [
              "NUM.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Makeroti bhakaya bhagatööra irisanchö reebho Tahati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.26",
            "verseOrgIds": [
              "NUM.33.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Tahati bhagatööra irisanchö reebho Tera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.27",
            "verseOrgIds": [
              "NUM.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Tera bhakaya bhagatööra irisanchö reebho Mitika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.28",
            "verseOrgIds": [
              "NUM.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Mitika bhakaya bhagatööra irisanchö reebho Hasimona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.29",
            "verseOrgIds": [
              "NUM.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Hesimona bhakaya bhagatööra irisanchö reebho Moseroti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.30",
            "verseOrgIds": [
              "NUM.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Moseroti bhakaya bhagatööra irisanchö reebho Bhene-yakani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.31",
            "verseOrgIds": [
              "NUM.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatanöra kurua Bhene-yakani bhagatööra irisanchö reebho Hori-hagitigati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.32",
            "verseOrgIds": [
              "NUM.33.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaaruure Hori-hagitigati bhagatööra irisanchö reebho Yoti-bhata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.33",
            "verseOrgIds": [
              "NUM.33.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 33:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua Yoti-bhata bhagatööra irisanchö reebho Abhurona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.34",
            "verseOrgIds": [
              "NUM.33.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 33:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaaruurë Abhurona bhagatööra irisanchö reebho Esioni-gebheri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.35",
            "verseOrgIds": [
              "NUM.33.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 33:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakarua Esioni-gebheri bhagatööra irisanchö reebho guiköngö re Sini (iga Katesi), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
              "NUM.33.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 33:37"
          },
          "items": [
            {
