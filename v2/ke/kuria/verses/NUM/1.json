              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abharawi tëbhaabharëëyöë hamui na ibhiaro bhindë bhia Abhaisiraeri hai; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikugira Ënooköë naateebhiri Mösa iga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano ököbhara Abhaisiraeri bhano bhaisaini kuya kuiihi, uriihe köbharrania ikiaro ke Rawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.49",
            "verseOrgIds": [
              "NUM.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si waahöre Abharawi bhabhe abhairigania bhi iritume riö öbhöherekia bhoone na ibhintö bhionsui bhiira bhiimo. Mbaraayi bharaimukia iritume na ibhiamo bhionsui, bhakore ëmërëmo mo na bhahagaache amasanchö gaabho kuinaara iritume. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.50",
            "verseOrgIds": [
              "NUM.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoora mörang'anyia iritume, Abharawi kuhika bharëtachöre bhariimukia na kuriimia guiki kömamenyo amahëa gano ndanyoore möseemiri kömenya. Öwöndë örë wonsui arahike hang'i iritume rëyö naraitue. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhandë bhano mbaraimi amasanchö gaabho, kömakomo, këra möntö na waae. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abharawi bhatööre amasanchö gaabho kuinara iritume na körëmaahëërra, iga korri öwöndë örë wonsui atagaacha kuhika hang'i iritume riö öbhöherekia na gönkorra öbhörrö bho götema Abhaisiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhaisiraeri bhagakora gara gonsui wanyoorrë Mösa aragirriibhui na ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
              "NUM.1.54"
            ]
          }
        }
