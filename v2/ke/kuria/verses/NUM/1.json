        },
        {
          "text": "Kurusikö ro mbere ru umueri go kabhërë ögö ömooka go kabhërë hano Abhaisiraeri wanyoorrë bhaatanöra kurua Misiri, ÖMÖNENE agasumaacha na Mösa Guitunteera re gusikanëra bhaarëngë guiköngö re Sinai, na kögamba iga: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe na Haruni, bhara Abhaisiraeri bhonsui, kubhisaku na ichika chaabho, möbhare ömöntö umuiumui abhasaacha bhonsui, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhë ëmeeka mërongo ëbhërë na kögendeerria, bhonsui bhano bharatöre gösoha kuiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ömösaacha umui wa këra ikiaro naraabhe hamui na bhainyu, këra umui öno arëngë ömötangati wë ëgësaku gi ikiaro keee. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amariina ga bhano bharagutuurri köbharo ëyö:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
