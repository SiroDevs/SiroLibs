                  "text": "17:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Örë wonsui ahanchërë öbhöhoru bhooe narabhötabhute; na örë wonsui arëgerë öbhohoru bhooe gökëbhara këno, öyö naarënyoora öbhöhoru bho kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.25",
            "verseOrgIds": [
              "JHN.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui agutuna gönkorra kuhika ansoorane, korri iga harë ndë, ömökoramërëmo waane abhë ho. Na Taata narasööke öno agönkorra.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.26",
            "verseOrgIds": [
              "JHN.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö arasumaachëra uruku rooe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.26",
            "verseOrgIds": [
              "JHN.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhoono ömooyo goone guritohërë – na niyekë ndagambe? Niiga mbööre iga, ‘Taata, tantuuria kurua kögano gatakambeera?’ Sibhoono gayö ngo naachëëyë, iga niiriire gönkaaga ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.27",
            "verseOrgIds": [
              "JHN.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taata, toorokia ubhuhiku bhui iriina reeo!” Hakurua ëngamba ëkarua kuriöbha ëragamba iga, “Noorokia ubhuhiku bhoorio karai na guiki nëndagenderri koorokia.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.28",
            "verseOrgIds": [
              "JHN.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.28",
            "verseOrgIds": [
              "JHN.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhuiko bhua abhantö bhano wanyoorrë bhuimërëëyë ho mboiguurë ëngamba ëyö bhökagamba iga, “Nëkëbhagatiö keerë!” Abhandë bhakagamba iga, “Nömömaraika asumaachërë nawe!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.29",
            "verseOrgIds": [
              "JHN.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Yesö akabhateebhia iga, “Tigukugira koone ëngamba ëyö ëgambërë hai, gëtatiga ngukugira koinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.30",
            "verseOrgIds": [
              "JHN.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënö niyö ënkaaga yë ëkëbhara gökengeröa ikiina; bhoono ömögambi wë ëkëbhara këno naratabhutoe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.31",
            "verseOrgIds": [
              "JHN.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndaimukirribhöe igörö gökëbhara këno, nendarente abhantö bhonsui harë uni.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.32",
            "verseOrgIds": [
              "JHN.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Hano aagambërë igo hayö naasumaachëëyë uruku rooe bhörë aarë kuya kunyoora.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.33",
            "verseOrgIds": [
              "JHN.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Sab 110:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.7"
              },
              "items": [
                {
                  "text": "Isa 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.25"
              },
              "items": [
                {
                  "text": "Ese 37:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "Tan 7:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ubhuiko bhööra bhökamuhunchukiria iga, “Imigiro gaitö ngötöteebhia gërë iga Masihi naraabhe ho kuya ëyö. Niyekë guiki ökorrë öragamba iga Ömoona wö ömöntö kuhika aimukiirribhöe igörö? Kana ömoona öno wö ömöntö ning'ui?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhahunchukiria iga, “Öbhörabhu mbökërëngë harë bhainyu. Mötataara nkaaga hakëërë harabhu, igisuntë gëtarabhakörra; kugira öno arëngë kugisuntë takömanya harë akuya hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.35",
            "verseOrgIds": [
              "JHN.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëno mökëëna öbhörabhu, mötabhukumia, korri iga möbhe abhantö bhö öbhörabhu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.36",
            "verseOrgIds": [
              "JHN.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ökonga gukumia koa abhantö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aagambërë gayö naarichokërë kurua harë bho akabhaibhisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.36",
            "verseOrgIds": [
              "JHN.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora waanyoorrë aakora ibhimanyiirriö ibhiaru kömaiso gaabho, tëbhaabhaayë na ubhukumia harë we röndë hai, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.37",
            "verseOrgIds": [
              "JHN.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Isa 53:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "korri iga gano ömönaabhi Isaya wanyoorrë aagamba gahekëëranë iga,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö tëbhaatörrë gukumia hai. Kugira Isaya naagambërë guiki iga,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.39",
            "verseOrgIds": [
              "JHN.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.41",
            "verseOrgIds": [
              "JHN.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo, abhatangati bha Abhayahuti abhaaru mbaabhaayë na ubhukumia harë we, sibhoono gikugira ya Abhabharisayo tëbhaarë kögamba amang'ana gayö harabhu hai, korri iga bhatagaacha kurugibhöa kurua gusinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.42",
            "verseOrgIds": [
              "JHN.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira mbaahanchërë kögöngöa na abhantö gökëra ökögöngöa kö Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana ya Yesö niyo inyene ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akagamba bhökong'u iga, “Örë wonsui ana ubhukumia harë uni, öyö nkunyoora arë nabhaayë na ubhukumia ninyoora nkumuntumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno andööchë nyoora naarööchë umuntumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.45",
            "verseOrgIds": [
              "JHN.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni naacha gökëbhara këno köbha öbhörabhu, korri iga örë wonsui araabhe na ubhukumia harë uni atagaatama kugisuntë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.46",
            "verseOrgIds": [
              "JHN.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na örë wonsui akuigua amang'ana gaane na kögakumia, tëndamokengere ikiina hai. Kugira tënaachërë gökengera ëkëbhara ikiina hai, gëtatiga naachërë iga ntuuri ëkëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.47",
            "verseOrgIds": [
              "JHN.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na örë wonsui akuunyanga, aranga kögoota amang'ana gaane, naaho öno arëmökengera ikiina. Ëng'ana ëno ngambërë niyö ërëmökengera ikiina kurusikö rööra ru umuhiko! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.48",
            "verseOrgIds": [
              "JHN.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tingusumaacha kögötöra koone umuene hai, gëtatiga Taata öno aantömërë nëwe agönteebhia këno këragërë iga nsumaache na kögamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.49",
            "verseOrgIds": [
              "JHN.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nëmanyërë iga amarago gaae nkörenta garë öbhöhoru bho kuya ëyö. Gayö nkögamba ngarë Taata aanteebhia iga ngambe.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.50",
