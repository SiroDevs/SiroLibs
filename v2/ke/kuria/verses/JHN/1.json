                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.1"
              },
              "items": [
                {
                  "text": "Ruk 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënooköë naatömërë ömöntö öwöndë, önö aarë köbhërëkëröa iga Yohana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.6",
            "verseOrgIds": [
              "JHN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öyö naachërë köherekia igörö yo öbhörabhu bhööra, korri iga abhantö bhonsui bhakumi gököhetera harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.7",
            "verseOrgIds": [
              "JHN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëwe umuene aarëngë öbhörabhu bhööra hai, gëtatiga naachërë köherekia igörö yabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.8",
            "verseOrgIds": [
              "JHN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö mbo bhöörëngë öbhörabhu bhö öbhöheene bhöno bhökörabhiria abhantö bhonsui gökëbhara.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.9",
            "verseOrgIds": [
              "JHN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'ana naarëngë gökëbhara, na ëkëbhara ngekorröë köhetera harë we, sibhoono ëkëbhara tëkeemömanyërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.10",
            "verseOrgIds": [
              "JHN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naachërë gönsë yaae, sibhoono abhantö bhaae bhakanga kumuirigania. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.11",
            "verseOrgIds": [
              "JHN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhamui bhaabho mbaamuirigaini na kumukumia; bhayö naabhahaayë ögötöra go köbha abhaana bhë Ënooköë; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.12",
            "verseOrgIds": [
              "JHN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tëbhaabhaayë abhaana bhë Ënooköë guikuibhöröa kömaanyinga gösë kö öbhöhanchi bhö ömöbhërë, gëtatiga köbhöhanchi bhuë Ënooköë umuene.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.13",
            "verseOrgIds": [
              "JHN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ëng'ana akabha ömöntö, akamënya na bhaitö; aichööyë ësaramita na öbhöheene, tökamaaha ubhuhiku bhooe, ubhuhiku bhö Ömoona ömömoomui wë Ënooköë Taata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.14",
            "verseOrgIds": [
              "JHN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana naaherekiri igörö yaae köngamba ënene iga, “Öno mbe nëwe naagambërë iga, ‘Ngucha arë nyuma yaane si nömöntö öno ntareng'aini nawe, kugira naabhaayë ho ntaraibhöröa.’” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.15",
            "verseOrgIds": [
              "JHN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua gösaramita yaae inchaaru, aatöha ësaramita igörö ya ësaramita. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.16",
            "verseOrgIds": [
              "JHN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Ënooköë naahanërë imigiro gököhetera harë Mösa, sibhoono ësaramita na öbhöheene mbiachërë gököhetera harë Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.17",
            "verseOrgIds": [
              "JHN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëmöntö aho öno akarööchë Ënooköë; gëtatiga nö Ömoona waae ömömoomui, öno arëngë Ënooköë guiki naana öbhögotaini na Taata, nëwe aagirrë Ënooköë akaya nkuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögöteebherria ko Yohana Möbhatiisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.18",
            "verseOrgIds": [
              "JHN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëno niyö ëherekiö ëno Yohana aaruusiri nkaaga abhatangati bha Abhayahuti bha Yerusaremu bhaatömërë abhanchaama na Abharawi kuya kumubhuuria iga: “Nuwe ng'ui kana?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.19",
            "verseOrgIds": [
              "JHN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akabhateebhia bhurabhu iga, “Tuuni Masihi hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.20",
            "verseOrgIds": [
              "JHN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.5"
              },
              "items": [
                {
                  "text": "Mari 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.15"
              },
              "items": [
                {
                  "text": "Ëhë 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Sir 48:10,11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho bhakamubhuuria iga, “Bhoono, nuwe ng'ui? Gösë nuwe Eria?” Yohana akabhahunchukiria iga, “Aa-a, tuuni Eria hai.” Guiki bhakamubhuuria iga, “Gösë nuwe örë ömönaabhi?” Yohana akabhahunchukiria iga, “Aa-a tuuni we hai!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.21",
            "verseOrgIds": [
              "JHN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakamubhuuria iga, “Bhoono nuwe ng'ui kana mbe? Niyekë ökögamba igörö yaao umuene? Töteebhia, korri töherrë bhaara bhatötömërë irihunchukiö.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.22",
            "verseOrgIds": [
              "JHN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Isa 40:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yohana akabhahunchukiria iga, “Nu uni ömöntö ööra ömönaabhi Isaya aagambërë igörö yaae iga:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.23",
            "verseOrgIds": [
              "JHN.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö mbano wanyoorrë bhaatömëröë na Abhabharisayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.24",
            "verseOrgIds": [
              "JHN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhakabhuuria Yohana iga, “Hano ndanyoore ötarë Masihi, gösë Eria, gösë örë ömönaabhi, igankë ököbhatiisa?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.25",
            "verseOrgIds": [
              "JHN.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana akabhahunchukiria iga, “Uni nköbhatiisa ndë kömanchë; si öno, aimëërëëyë harë bhainyu, öno mötamanyërë; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.26",
            "verseOrgIds": [
              "JHN.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "öyö nëwe öno aguucha nyuma yaane, öno ntaisaini götachöra ninyoora ni ichingai chi ibhiraatö bhiae.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.27",
            "verseOrgIds": [
              "JHN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gayö ngakorekaini Bhetania ihumbu yö ömooro go Yorotaani, harë Yohana aarë köbhatëësëra.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëkëmaano ki iring'ondi kië Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.28",
            "verseOrgIds": [
              "JHN.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio yaho, Yohana akamaaha Yesö araacha harë we, akagamba iga, “Tamaaha ëkëmaano ki iring'ondi kië Ënooköë, öno akuruusia ho iriraga rë ëkëbhara! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.29",
            "verseOrgIds": [
              "JHN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno nëwe naarë kögamba igörö yaae iga: ‘Ömöntö araacha nyuma yaane, ömönene öno ntareng'aini nawe, kugira ho aarëngë ntaraibhöröa!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.30",
            "verseOrgIds": [
              "JHN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni umuene tënaamömanyërë hai, sibhoono naachërë köbhatiisa kömanchë korri mmömanyekani köbhantö bha Isiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.31",
            "verseOrgIds": [
              "JHN.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana akaruusia ëherekiö iga: “Naarööchë Nkoro aarasëkëra ki inguuti kurua kuriöbha na guikara harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.32",
            "verseOrgIds": [
              "JHN.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni tënaamömanyërë hai, sibhoono öno aantömërë iga mbatiise kömanchë nëwe aanteebhiri iga: ‘Ömöntö öno öraache ömaahe Nkoro arasëkëra kurua kuriöbha na guikara harë we, öyö nëwe aköbhatiisa gönkoro Nhoreeru.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.33",
            "verseOrgIds": [
              "JHN.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mmörööchë na herekiri iga nëwe Ömoona wë Ënooköë.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhëëga bha mbere bha Yesö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.34",
            "verseOrgIds": [
              "JHN.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio yaho guiki, nkayoora Yohana aimëërëëyë ahasë haara bheene hamui na abhëëga bhaae bhabhërë, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamaaha Yesö araheta, akagamba iga, “Mötamaaha! Öno nëwe ëkëmaano ki iring'ondi kë Ënooköë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhëëga bhabhërë bhaara bhakaigua amang'ana gaara Yohana aagambërë, bhagasoorana Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano, Yesö aihönchööyë akömaaha bharamösoorana, naabhabhuurri iga, “Nkë mugutuna?” Nabho bhakamubhuuria iga, “Rabhi (nko kögamba iga Muigia) nëhai ömenyërë?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akabhateebhia iga, “Mötaacha mömaahe.” Bhakaya bhakamaaha harë wanyoorrë amenyërë, kugira nkanyoora chihikërë ichinkaaga ikumi chiö ömögoroobha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anderea mura omoobho Simoni Bhetero, naarëngë umui wa bhabhërë bhaara bhaiguurë Yohana aragamba igörö ya Yesö, bhakamösoorana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni mura omoobho Anderea nëwe ömöntö wa mbere öno Anderea aasikaini, akamöteebhia iga, “Tunyoorrë Masihi.” (Nko ökögamba iga Kirisitö.) ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua akamuhira harë Yesö. Hano Yesö aamörööchë akagamba iga, “Nuwe Simoni ömoona o Yohana. Gukurua reero nörabhërëkëröë iga Kebha” (ësësöro yaario niiga, “Bhetero gösë Örötarë”).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö arabhërëkëra Bhiribho na Natanaeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio yaho Yesö akaya Gariraya, akanyoora ho Bhiribho na kömöteebhia iga, “Tansoorana!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waabho Bhiribho yaarëngë Bhetisaita kumugi goobho Anderea na Bhetero. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhiribho nawe agasikana Natanaeri, akamöteebhia iga, “Tunyoorrë, ömöntö ööra aandëkëröë na Mösa kögëtabhö ki imigiro, na öno abhanaabhi bhandëkërë amang'ana igörö yaae, nko kögamba iga Yesö ömoona o Yusubhu kurua Nasareti.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanaeri nawe akamöteebhia iga, “Kura Nasareti ngëntö kë ikiiya gëkaarua ho?” Bhiribho akamöteebhia iga, “Otaacha ömaahe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aarööchë Natanaeri araacha harë we, naagambërë iga, “Tamaaha Umuisiraeri ëkënainë, öno ataana bhuiteerri iga!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanaeri akamubhuuria iga, “Niyekë ökorrë ömmanyërë?” Yesö akamöteebhia iga, “Nënkörööchë örëngë hansë yö ömökö Bhiribho ataraköbhërëkëra.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanaeri Akamöteebhia iga, “Muigia, maheene uwe nö Ömoona wë Ënooköë örë; guiki nö Ömögambi wa Abhaisiraeri örë!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.49",
            "verseOrgIds": [
              "JHN.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akamöteebhia iga, “Nguitabhirria örë gikugira ngöteebhiri iga nënkörööchë hansë yö ömökö? Nöramaahe amang'ana amanene gökëra gayö!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
