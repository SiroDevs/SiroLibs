{
  "id": "JHN.16",
  "number": "16",
  "bookId": "JHN",
  "reference": "Yohana 16",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nëmbateebhiri amang'ana gayö, korri iga mötagaacha gutiita na ubhukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarëbharugia kurua guchisinagogi chaabho, na ënkaaga nguucha ërë ëno örë wonsui aköbhaita arëkanya iga në Ënooköë agökorra ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarëbhakorra gayö kugira tëbhaakamanyërë Taata gösë ninyoora nu uni hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nköbhateebhia ndë amang'ana gano, iga hano ënkaaga yaago irihika bharagakora, muuchë köhëëtöka iga naagabhateebhiri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmërëmo ge Nkoro Nhoreeru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tënaakabhateebhiri amang'ana gano hai, kugira hamui wanyoora nkërëngë na bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nkuya ndë kö öno aantömërë, si tëndaigua möntö örë wonsui harë bhainyu arambuuria iga, ‘Nëhai kana ukuya?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ya amang'ana gayö naabhateebhiri, imioyo geinyu geeritoha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono öbhöheene ndabhateebhia iga, nkihueneeyë iga niyi gikugira yeinyu, na hano ndaanyoore ntagëëyë, Umutuurria taraache harë bhainyu hai. Hano naho ndaayi, nëndamötöme achë harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano araache, narasuute abhantö bhë ëkëbhara këno keebhörë bhaamocha kuiraga, öbhöröngë na öbhökengi bhui ikiina bhuë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaamocha iriraga, kugira tëbhaana ubhukumia harë uni hai; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhaamocha öbhöröngë, kugira nkuya ndë o Taata tëmörëëmaaha röndë hai; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bhaamocha öbhökengi bhui ikiina, kugira ömögambi wë ëkëbhara këno aisa gökengeröa ikiina karai.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nëëna agandë amaaru agaköbhateebhia, sibhoono ngaaruha bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Öbh 9:11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Nkoro wö öbhöheene araache, narabhatangate köbhöheene bhonsui. Kugira tarasumaache kögötöra kooe umuene hai, sibhoono narabhateebhi garë akuigua na gano gakuya guucha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naraang'ë ubhuhiku, kugira naraayi araimukia gano nkunyoora nëënago agabhateebhia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhino bhionsui Taata anabhio nibhiane; ëyö niyö ikugira ndagamba iga Nkoro naraimuki amang'ana gaane guucha köbhateebhia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uguitumata na ëmëgooko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gönkaaga nke igo tëmörammaahe hai, hakurua guiki gönkaaga nke igo mmörammaahe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhëëga bhaae abhamui bhakabhuurania iga, “Hayö kana niyekë akögamba? Aratöteebhia iga, ‘Gönkaaga nkë igo, tëmörammaahe hai, hakurua guiki gönkaaga nke igo mmörammaahe.’ Na guiki arabhööra iga, ‘Niigo kërë kugira ndaya o Taata.’” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakabhööra iga, “Ësësöro ya ‘nkaaga nke’ ëno akögamba, tëtömanyërë këno akögamba hai!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö naamanyërë iga mbaatunërë iga bhamubhuuri, köhayö akabhateebhia iga, “Möna ngambërë niiga, ‘Gönkaaga nke igo tëmörammaahe hai, hakurua guiki gönkaaga nkë igo mörammaahe.’ Ëyö tiyo mukubhuurania? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene ndabhateebhia iga, mörakuurë amaisori, sibhoono ëkëbhara kio nkërachëngë; na bhainyu möraitumate, sibhoono uguitumata koinyu nköraihönchöre köbhe ëmëgooko. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoora ömögaikörö arariisia nguitumata arë, kugira nyoora ënkaaga yaae ya kuibhöra ihikërë; sibhoono hano ömoona aisa kuibhöröa, nyaköwaabho nkuëbha arë öbhörrö bhööra bhonsui, agooka kugira nyoora ömoona aibhöyöë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo bheene kërë harë bhainyu; bhoono muitumatërë, sibhoono nëndaache köbhamaaha guiki na imioyo geinyu gëgooke, ëmëgooko gëno möntö atakabharuusia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano urusikö rööra ruriicha, timurimbuuria ng'ana hai. Öbhöheene ndabhateebhia iga, Taata naraabhahe kërë gionsui möraasabhe kuriina reene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua karai gukuhika bhoono, tëmogasabhërë gëntö röndë kuriina reene hai; tasabha möranyoore, korri ëmëgooko geinyu gëhëkëërane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökëra ëkëbhara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naasumaacha na bhainyu amang'ana gano kubhirengio. Sibhoono ënkaaga ëraacha ëno ntarisumaacha na bhainyu kubhirengio röndë, gëtatiga nindësumaacha bhörabhu amang'ana ga Taata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano urusikö rööra rurihika, muriya mörasabha kuriina reene; hayö tiiga nkögamba ndë iga nindiya ndasabha kuibhaga reinyu hai, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira Taata umuene nabhahanchërë. Nabhahanchërë kugira mmöhanchërë na mookumia iga nkö Ënooköë naaruurë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harë Taata naaruurë ngaacha gökëbhara, na bhoono guiki nköng'aanya andë kurua gökëbhara ndaya harë Taata.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhëëga bhaae bhakamöteebhia iga, “Mboono mbe wagamba bhörabhu, ötaakörengia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono töömanyërë iga kana nömanyërë amang'ana gonsui; taaho öno agaakubhuuria ng'ana bhoono hai. Ëyö niyo ikugira törakumia iga nkö Ënooköë waarua.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö akabhahunchukiria iga “Bhoono mukumiri? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëraacha, nayo yaahikërë, ëno bhonsui muranyeregane, këra umui weinyu ayi waae, ntamë umuene. Sibhoono tëndaatame umuene hai, kugira Taata hamui arë nani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmbateebhiri amang'ana gayö korri iga möbhe na ömörembe harë uni. Gökëbhara mörairiire, sibhoono mötërëmëke: Kugira nkërrë ëkëbhara!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
      ]
    }
