              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatuna guiki kögoota Yesö, sibhoono akaibhandurrukia kurua harë bho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.28"
              },
              "items": [
                {
                  "text": "Yoh 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesö akaringa kuya ihumbu yö ömooro go Yorotani haara Yohana akabhatëësëyë, akabheera ho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö abhaaru mbaagëëye harë we, bharagamba iga, “Yohana taakorrë këmanyiirriö hai, sibhoono gonsui gano aagambërë kömöntö öno namaheene.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö abhaaru bhayö mbaabhaayë na ubhukumia harë we.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
