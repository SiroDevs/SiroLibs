            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.15"
              },
              "items": [
                {
                  "text": "22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano gayö gaabhaayë, Yesö naamanyërë iga bhoono amang'ana gonsui gasirrë; gököhëkëërania ërendeko, akagamba iga. “Niihömërë.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora igitubha keeho, këno wanyoorrë gichööyë isiki, igo, bhagatobheka mo isibhongo, bhakamotoorra kubhinenebhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yesö aaisërë kömera isiki ëëra, akagamba iga, “Gasirrë!” Akahiinya ömötöe gooe akabhötöka mooyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesö aratebhëtöa guchimbaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhatangati bha Abhayahuti bhakabhuuria Bhiratö iga abhaitabhiirri bhabhunebhune amagörö ga abhantö bhayö bhaabhambëröë, sooki bhabharuusi kömësarabha. Mbaakorrë igo kugira röyö ni Ichumaa rorëngë, na nkanyoora Ësabhatö ëraya gösoha, nabho tëbhaarë gutuna iga ëmëbhërë gëyö gëtame kömësarabha kuhika urusikö ruë Ësabhatö, kugira urusikö röyö ruë Ësabhatö nö örönene rorëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö abhasirikare bhakaya bhakabhunabhuna amagörö gömöntö wa mbere na öwa kabhërë, bhano wanyoorrë bhambëröë hamui na Yesö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano bhaahikërë harë Yesö, bhaakunyoora iga aisërë köbhötöka mooyo karai, köhayö tëbhaabhunëbhunërë amagörö gaae hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono umui wa abhasirikare bhaara naatëbhëtërë Yesö iritimö guchimbaru amaanyinga gakarua na amanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Örë aarööchë gano gaabhaayë, naahërëkiri na ököhërëkia kooe nö ököbhöheene. Na nëwe amanyërë iga nö öbhoheene akögamba, korri iga na bhainyu mukumi). ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.46"
              },
              "items": [
                {
                  "text": "Ëgt 12:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Ëbh 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.20"
              },
              "items": [
                {
                  "text": "Sab 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gayö ngaakorröë igo korri ërendëko rëkëëranibhöë iga: “Tiiguha reee ninyoora ndimui rërëbhunua hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10"
              },
              "items": [
                {
                  "text": "Sek 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Öbhö 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ërendëko rëndë rëëho rëno rëkögamba iga, “Mbarëmömaaha öno bhaatëbhëtërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögötökëröa ko Yesö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua hayö, Yusubhu, öno aarë kurua kumugi go Arimataya, akabhuuria Bhiratö nyoora akamuitabhirria aimuki ömöbhërë go Yesö. (Yusubhu öyö naarëngë umuëga wa Yesö, si ngukibhisërë, kugira naarë koobhoha abhatangati bha Abhayahuti). Bhiratö akamuitabhirria kuimukia ömöbhërë gööra, igo, Yusubhu akaya akagumukia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.1"
              },
              "items": [
                {
                  "text": "Yoh 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikotemo, ööra wanyoorrë aagëëra Yesö ubhutikö, nëwe aagëëyë ana umuichogainë gua amaguta ga manemane na öbhöbhaani bhino bhikaabha ichikiiro mërongo ëtatö, mbaagenainë na Yusubhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö bhaabhabhërë mbaaimukiri ömöbhërë go Yesö, bhakagöbhoheerra ichihanga ichinyëke cha köbhoheerra umukuurë, hamui na amaguta gayö gu umuichogainë, keebhörë yaarëngë ësëëra ya Abhayahuti göseemia köbhëëka ömöbhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haara bheene Yesö aabhambëëyöë irisamba ndeerë ho, nkanyoora indua ëho ëhea ëno wanyoorrë ëtarabhëëköa möntö. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira wanyoorrë urusikö rötamërë rumui Ësabhatö ya Abhayahuti ihike, na indua ëëra yaarëngë hang'i, igo, bhakabhëëka ömöbhërë go Yesö kundua ëyö.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
