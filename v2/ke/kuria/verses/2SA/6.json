{
  "id": "2SA.6",
  "number": "6",
  "bookId": "2SA",
  "reference": "2 Samueri 6",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
