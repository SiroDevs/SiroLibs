                  "text": "19:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uni Bhauro, ömötömöa wa Kirisitö Yesö köbhöhanchi bhöë Ënooköë, ndabandëkëra bhainyu abhantö bhë Ënooköë bhano mörëngë Ebheso, bhano mörëngë abhaheene kubhukumia harë Kirisitö Yesö.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        }
      ]
    },
    {
