                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kor 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.7"
              },
              "items": [
                {
                  "text": "1 Bhe 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na bhainyu abhasaacha, möhanche bhakainyu kehaara Kirisitö aahanchërë Ëkanisa, akairuusia umuene köbha ësataaka gikugira yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakorre igo korri iga köng'ana yaae agëtöörë kö Ënooköë, hano aasookiri kugisaabhia kömanchë, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri iga ainyoorrë ëkanisa ëno ërëngë ënhoreeru na ëndabhu kimui, ëkanisa ëno ëtaana imooa, isoro gösë kërë gionsui gë ëteemo ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö nkëragërë iga abhasaacha bhahanche bhakaabho kië ëmëbhërë geebho abhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Tëmöntö örë wonsui aho öno aregërë ömöbhërë gooe hai; gëtatiga nkögöragiria arë na kugusuaria. Nke hayö Kirisitö nawe akuriiha ëkanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bhaitö ntörëngë ibhiimo bhiö ömöbhërë gooe). ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Ögt 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Gikugira ëyo, ömösaacha naratige isawaabho na nyaköwaabho, agöötane na mökaae, na abhabhërë bhayö mbaraabhe ömöbhërë gumui.” ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene mbööho bhöno bhuibhisërë kömang'ana gayö, nani nkomaaha ndë iga Nkirisitö gaitungërë na ëkanisa yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
              "EPH.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EPH 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono guiki ngabhaitungërë ninyoora mbainyu: Këra mösaacha kuhika ahanche mkaae kehaara aihaanchërë umuene, ömökari nawe kuhika asööke mösaacha waae.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.33",
            "verseOrgIds": [
              "EPH.5.33"
            ]
          }
        }
      ]
