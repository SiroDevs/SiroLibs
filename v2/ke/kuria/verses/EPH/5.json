              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kehaara Ëkanisa ëgösööka Kirisitö, bhöyö bheene, abhakari bhasööke bhasaacha bhoobho kögonsui.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
