            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kor 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Bhe 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhakari bhasööke bhasaacha bhaabho kehaara bhagösööka Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ömösaacha naana ögötöra igörö ya mökaae, kehaara Kirisitö ana ögötöra igörö yë Ëkanisa; na Kirisitö umuene nköbhohoria arë ëkanisa, ömöbhërë gooe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
