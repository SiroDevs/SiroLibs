              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhasabhëra bhainyu bhamura bha moitö ömörembe, öbhöhanchi, na ubhukumia kurua harë Taata Ënooköë na kurua kö Ömönene Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabhasabhëra ësaramita yë Ënooköë bhonsui bhano bhahanchërë Ömönene waitö Yesö Kirisitö köbhöhanchi bhono bhötaana möherio.",
          "type": "text",
