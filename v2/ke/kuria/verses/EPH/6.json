              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Isa 59:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Imukia ubhuituuria bhöbhe ëngosiira yi ikiöma, na ëng'ana yë Ënookë ëbhe inchonge ëno mököhaabhöa na Nkoro Nhoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mösaasaame ruiso ronsui nagösabha ubhutuurria bhöë Ënooköë. Mösaasaame ruiso ronsui guchinguru cha Nkoro. Mötakarosa kuhura gikugira ya abhantö bhonsui bhië Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönsabhëre ninyoora nu uni, korri nkaaga ngusamaacha Ënooköë ang'a ëng'ana ya kögamba, korri nsësörre abhantö ikibhisërë ki igichiratë köbhöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni naabha ömöbharosi gikugira ya igichiratë këyo ninyoora bhoono igo ndëngë gökëbhohe. Mönsabhëre, korri nëbhe na öbhökarë bho gikirundia bhörë këragërë.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
    },
