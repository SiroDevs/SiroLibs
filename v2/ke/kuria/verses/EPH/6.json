          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayö ngo gagirrë mmötömërë harë bhainyu korri abhateebhi keebhörë bhaitö bhonsui tökögenderria hano na köbhatirimikia.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
