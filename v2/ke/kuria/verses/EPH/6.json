                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö muiseemi. Öbhöheene bhöbhe kiu umuchibhi kumikurukuru geinyu, öbhöröngë bhöbhe kia akagubha ki igikubha, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Isa 52:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na ëgoorio ya kurundia igichiratë kiö ömörembe ëbhe ki ibhiraatö kömagörö gainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na gökëra gayo gonsui, ubhukumia bhögenderri köbha ki ingubha kömabhoko gainyu, korri bhöbhatuurri kurimia imigui giö ömörro gui Irisambo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
