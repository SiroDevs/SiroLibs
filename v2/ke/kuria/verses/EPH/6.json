              "attrs": {
                "loc": "COL.3.25"
              },
              "items": [
                {
                  "text": "Kor 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na bhainyu abhanene, mökorre abhagöre bhainyu ke bhöyö bheene, monge köbhoobhohirria. Muhiite iga bhainyu hamui na abhagöre bhainyu mööna Ömönene umui kuriöbha, öno ataana bhöhanchirri.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhiögë bhionsui bhië Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
