            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhamura omoobho na abhë ëka yaae bhagaacha kumuimukia; bhakamötökëra gataigatai yu umugi go Sora na umugi go Esitaori kundua ya Manoa, isawaabho. Samusoni naabhaayë ömohökania wa Isiraeri kömeeka mërongo ëbhërë.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
