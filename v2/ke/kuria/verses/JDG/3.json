              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaarë köganya, Ehuti naang'osërë akahetera kuibhihooru bhia amagëna, akaya Seira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aahikërë ho naahuutërë ëkërëmbëëta gönsë yi ibhikerege bhia Ebhuraimu, Abhaisiraeri nabho bhakang'araara hamui nawe kurua kubhikerege haara nawe akabhatangata. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
            "verseOrgIds": [
              "JDG.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhateebhia iga, “Mönsoorane, kugira ÖMÖNENE atöörrë abhabhisa bhainyu Abhamoabhu kömabhoko gainyu.” Bhakamösoorana kuhika kuiröbhöko re Yorotani na körëmeria kurua kömabhoko ga Abhamoabhu, bhakarëbhëërra möntö örë wonsui ange köröbhöka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö, bhagaita Abhamoabhu bhakaahika ibhiköë ikumi (10,000); abhantö bhonsui bhano bhaana ëmëbhërë imiiya na ichinguru, na taaho ninyoora nu umui öno aahonërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö Abhaisiraeri bhakahicha Abhamoabhu. Ënsë ëkabha na ömörembe gökërengere kë ëmeeka mërongo ënaanai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
      ]
    },
