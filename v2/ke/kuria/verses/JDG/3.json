    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichihamatë chiratama gönsë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, chino nchio ichihamatë chino ÖMÖNENE aatigërë gösaacha Abhaisiraeri bhano wanyoorrë bhataraitana iriihi gönsë ya Kanaani ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(naakorrë igo korri ahe abhantö bhi irikora rëyö ubhunguri bho guitana kugira tëwaanyoorrë bhaamaaha iriihi). ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanene bhataano bha Abhabhirisiti, Abhakanaani bhonsui, Abhasitoni na Abhahibhi bhano bhaang'anyëëyë kunguku ya Rebhanoni kurua kunguku ya Bhaari-herimoni kuhika köhëkëëra Hamati. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMONENE naatunërë iga atömërë bhayö korri asaache Abhaisiraeri, amaahe nyoora mbarasööke imigiro geee gëno aagambëëyë bhaaguuka bhaabho köhetera harë Mösa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhaisiraeri mbaamenyërë hamui na Abhakanaani, Abhahiti, Abhaamori, Abhabherisi, Abhahibhi na Abhayebhusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagateta abhaisëkë bhaabho na köhaana abhaisëkë bhaabho abhiene köbhamura bhi ichihamatë chiyö na gösengera ichinooköë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otinieri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaakorrë ubhunyanku mbere yö ÖMÖNENE; bhakiëbha ÖMÖNENE, Ënooköë waabho, bhagasengera ibhihooru bhia Amabhaari na Amaasera.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, öbhörrö bhö ÖMÖNENE bhökariina guisiira Isiraeri, nawe akabhatööra kömabhoko ga Kusani-risataimu ömögambi wa Mesobhotamia, nabho bhakamökoorra ëmërëmo gönkaaga yë ëmeeka ënaanai. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagaköörra ÖMÖNENE, nawe akabhaheerra ömöntö wa köbhabhohoria iga, Otinieri ömoona o Kenasi, mura omoobho Karebhu ömöke. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, Ënkoro yö ÖMÖNENE ëgaachëra Otinieri, nawe akabha ömohökania wa Abhaisiraeri. Otinieri naagëëyë kuiihi ÖMÖNENE nawe agatööra Kusani-risataimu ömögambi o Mesobhotamia kömabhoko gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ënsë ëkabha na ömörembe ëkërengere kë ëmeeka mërongo ënai. Haakurua Otinieri ömoona o Kenasi, agakua.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehuti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Abhaisiraeri bhagakora ubhunyanku mbere yö ÖMÖNENE. ÖMÖNENE akaha ömögambi Egironi wa Moabhu ichinguru aitani Abhaisiraeri, gikugira mbaakorrë ubhunyanku mbere yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egironi agaköma Abhaamori na Abhaamareki, akaya guitana na Abhaisiraeri, akabhahicha. Akameria umugi göë ëmëtende iga, Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagakoorra Egironi ömögambi wa Moabhu ëmërëmo, gönkaaga yë ëmeeka ikumi na ënaanai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano Abhaisiraeri bhaakörëëyë ÖMÖNENE, we naabhahereeyë ömöntö wa köbhabhohoria, iga, Ehuti ömoona o Gera, öno aarë këmosi, öwë ikiraro ke Bhenchamini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaamötömërë ahire ibhituho bhiabho harë Egironi ömögambi wa Moabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehuti agaikorra inchonge ëno ëna öbhöögë ichintahana ibhërë; öbhötambë bhooyo ichisentimita mërongo ëtaano. Akagiibhoha köbhökende bhooe ëntahana ya bhörëo mönsë yi ichingëbho chaae. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua akaheerra Egironi ömögambi wa Moabhu ibhituho bhiira. Egironi naarëngë ömöntö umunuru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Ehuti aasookiri kuruusia ibhituho, agateebhia abhantö bhaara bhaimukiri ibhituho, bhatanörë. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano we aahikërë kubhihooru bhia amagëna gano gasiitëröë hang'i na Girigari, naarëngëëyë Egironi akagamba iga, “Nëëna ëng'ana yi ikibhisërë harë uwe, wei ömögambi.” Ömögambi akagambëra abhakoramërëmo bhaae bhakire iga kiri, nabho bhakarichoka këbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehuti nawe akamusugatëërra haara waanyoorrë aikaayë kugisuumua keee këno këëna ëmbeho kömörengo, akamöteebhia iga, “Nëëna ëng'ana yaao kurua harë Ënooköë.” Ömögambi akaimöka kurua kugitumbe keee na kuimëërra. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehuti akamiuria inchonge yaae na ököbhoko ko bhömosi kurua göntere ya bhörëo, akamötëbhëta nayo könda yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inchonge ëgasoha mönsë hamui na ibhitë bhiayo, amaguta gagakundikiria inchonge ëyö kugira Ehuti taagësomooyë guiki; nkanyoora irichokeeyë nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Ehuti akarichoka këbhara kömörengo hano aasiikërë ibhisaku bhigisuumua këyö na örösöngöro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Ehuti aatanööyë abhakoramërëmo bhö ömögambi bhakaringa. Hano bhaarööchë ibhisaku bhionsui bhigisuumua bhisiikëröë, mbaakanyërë iga nagëëyë guituurria kuihomböe nyumba möyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakaganya kuhika bhagatanga köbha na ichinseme. Hano bhaarööchë iga taakuigöra, bhakaimukia örösöngöro bhakaigöra ëgësaku. Bhakamaaha ömögambi waabho hansë, aakuurë.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
