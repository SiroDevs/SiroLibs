        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaakorrë ubhunyanku mbere yö ÖMÖNENE; nawe akabhatööra kömabhoko ga Abhamitiani kömeeka muhungatë. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamitiani mbaabhandirriiyi bhökong'u Abhaisiraeri, kuhika bhagaitökëra amaina na amasana guchinguku köbha amagöe gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra nkaaga hano Abhaisiraeri bhaakabhusuuyë imbusiro kömëgöndö, Abhamitiani, Abhaamareki na abhantö bhandë bha rögörö haara mbaachërë köbhaitania. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichihamatë chiyö nchaatöörrë irisanchö gönsë, chikabhaitania na gösaria ibhiakörea bhionsui gönsë kuhika kömöbhaga go Gasa, bhanga götëgëra Abhaisiraeri kërë gionsui, rëbhe ring'ondi, ëng'ombe göse ëtëkërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhabhisa bhano bhaanarrë guucha köbhooru gi chingigë, hamui na iching'ombe na ichingamëëra chaabho na gökora öbhömenyo bhoobho gönsë ya Isiraeri, mbaasarri ënsë ya Isiraeri kugira mbaarëngë abhaaru bhökong'u bhano bhataköbharöa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaanyankibhui bhökong'u na Abhamitiani kuhika bhagaköörra ÖMÖNENE abhatuurri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhaisiraeri bhaakörëëyë ÖMÖNENE abharuusiri ho isina ëno bhaanyoorrë kurua kö Abhamitiani, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE naabhahereeyë ömönaabhi, nawe akabhateebhia iga, “ÖMÖNENE, Ënooköë wa Isiraeri aragamba iga: ‘Nnaabharuusiri gönsë ya Misiri hano moorëngë abhagöre, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabhabhohoria kurua kömabhoko ga Abhamisiri bhonsui bhano bhaabhabhadiriiyi. Nkarugia abhantö mbere yeinyu na köbhaha bhainyu ënsë yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkabhahiitukia iga uni nu uni ÖMÖNENE, Ënooköë weinyu; na iga monge gösööka ichinooköë cha Abhaamori, bhano muimukiri ënsë yaabho, si tëmotegerreeyë ëngamba yaane hai.’”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wö ÖMÖNENE akaya, agaikara hansë yu ömoaroni go Yoasi, Ömobhieseri, Öbhura haara. Gitioni ömoona o Yoasi, naarë köhööra ëngano mönsë yë ëkëmëtëro gi ichisabhibhu korri Abhamitiani bhatakamömaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wö ÖMÖNENE agatöra, akamöteebhia iga, “ÖMÖNENE nhamui arëngë na uwe, uwe örë mökarë.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitioni akamöteebhia iga, “Wei Ömönene waane, hano ndanyoore ÖMÖNENE hamui arë na bhaitö, ndeigua amang'ana gano gonsui gaatunyoorrë? Hai garë amakora gaae agibhirögööro gano bhaaguuka bhaitö bhaatöteebherriiyi, bharagamba iga: ‘ÖMÖNENE nëwe aaturuusiri gönsë ya Misiri.’ Sibhoono ÖMÖNENE atötabhutërë na götötööra kömabhoko ga Abhamitiani!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akamuihönchörra, akamöteebhia iga, “Taya kögötöra köno önako, öbhohori Isiraeri kurua kö Abhamitiani. Nu uni nkögötöma.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitioni akamuhunchukiria iga, “Monene niyeke ndaakore mbohori Isiraeri? Ëgësaku keene nkio ëkërosu bhökong'u gukiaro ke Manase, na uni umuene nömöke ndë bhökong'u gööka yeito!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akamöteebhia iga, “Nëndaabhe hamui na uwe; na uwe nörasiki Abhamitiani nkanya nkee kio hano bhakabhaayë ömöntö umui.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitioni akamöteebhia iga, “Köhayö, hano ndanyoore nyoorrë ubhutuurria harë uwe, tanyorokia ëkëmanyiirriö korri mmanye iga maheene nu uwe usumaachërë nani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndagösabha ötakaarua hano kuhika hano ndaringe na gökörentera igituho keene na kögëtööra mbere yaao.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akamuhunchukiria iga, “Nëndaikare hano kuhika hano öraringe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gitioni akaya ka waae, agaseemia ëkëmaano ki imburi na ëmëgaate gëno gëtatöörröë ëmëmëra kurua guitebhe riö öbhöse; agatööra inyama mönsë yë ëkëgabhö na umusuri mönsë yi ikinyöngö, hakurua akamöherra hansë hö ömoaroni akamöha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wë Ënooköë akamöteebhia iga, “Taimukia inyama na ëmëgaate gëno gëtatöörröë ubhutunduru ubhitööre igörö yörötare röno. Hakurua öhöme umusuri kegörö yëmëgaate na inyama.” Nawe agakora igo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömömaraika wö ÖMÖNENE akarambëka inyimbo yaae, agaturubhania inyama na ëmëgaate gönsonga yinyimbo. Gökëmachano, ömörro gökarua körötare, gögasambërëërra inyama na ëmëgaate. Hakurua ömömaraika wö ÖMÖNENE akarua mbere yaae.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Gitioni ööngööyë iga öyö nö ömömaraika wö ÖMÖNENE aarëngë; akagamba iga, “Ëhöbhë yaane, wei ÖMÖNENE Ënooköë, kugira ndööchë ömömaraika waao gëtoonooni.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
