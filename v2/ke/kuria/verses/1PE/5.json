              "items": [
                {
                  "text": "18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö muitööre hansë yö ököbhoko köë Ënooköë köno kööna ichinguru ichinene korri iga abhaimukiirri hano ënkaaga ëraahike. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Sir 2:1-18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möraatöre imiiriiro geinyu gionsui harë we, gikugira we nköbhairigania arë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiraarërre na kuhura kugira umuchungiri weinyu, umubhisa irisambö ki indui, nköng'oona arë arainaaranaara na gutuna ömöntö iga amömere. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
              "1PE.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömonge bhökong'u, muimëërre bhöröngë kubhukumia bhoinyu na kömanya iga imiiriiro gëyö möönagio ngërëngë köbhakumia bhandë gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ënooköë wë ësaramita yonsui öno aköbhabhërëkëra gösoha kubhuhiku bhooe bho kuya ëyö harë Kirisitö Yesö, hano möraise kuiriiribhua kuibhaga ike igo, we umuene narabhatögëke, abhatirimiki na köbhaha ichinguru korri iga mögöme. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ögötöra nö ökooe kuya ëyë na ëyö. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakeeriö ga gösookerria",
          "type": "text"
        }
