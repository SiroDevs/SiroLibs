            }
          ]
        },
        {
          "text": "Abhakumia abhaahöroa bhë Ënooköë Bhabheri hano bhabhakeerri hamui na ömoona waane Mariko. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökeerani gui ikeeriö riö öbhöhanchi gökönaamuunana. Ömörembe göbhe harë bhainyu bhonsui bhano mörëngë mönsë ya Kirisitö. Amina.",
          "type": "text",
          "attrs": {
