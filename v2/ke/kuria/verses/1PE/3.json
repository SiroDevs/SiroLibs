                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kor 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ke igo bheene abhakari, muiguëre bhasaacha bhainyu, korri iga ndanyoore bhaaho bhano bhatagukumia Ëng'ana yë Ënooköë bhategeribhue na kurutua na örögendo ro bhakaabho ninyoora tëbharateebherribhua Ëng'anaa hai, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano bharamaahe örögendo roinyu uruuya na uru ubhusuuki. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tim 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ubhuikuuni bhoinyu bhötagaacha köbha bhööra bhökömaahëkana këbhara igo këbhööra bho köröka ituukia, götööra ibhichëngëchë bhië ësahaabhu gösë ugusuara chingëbho chi iriguri. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono niiga bhöbhe ubhuikuuni bhö ömooyo bhöno bhötakömaahëkana gösë gösarëka, bhöyo mbööra bhörëngë ubhusuuki na ubhutindu bhö ömooyo, mbo bhörëngë ubhuëra bhökong'u mbere yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheene nigo abhagaikörö abhahoreeru bha karai, bhaara bhaaiteng'eeyë Ënooköë bhaaiköönërë abhiene gönchëra ya kuiguëra bhasaacha bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Ögt 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nigo Sara aaiguërëëyë Ibhurahimu, akamöbhërëkëra iga ömönene waae. Mörëngë abhaana bhaae bhigiisëkë hano ndanyoore mörakora gaara garëngë amaiya, mötakoobhoha gëntö kërë gionsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Eb 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kor 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nigo bheene na bhainyu abhasaacha, muikare na bhakainyu köbhöng'aini; taha ömökari ësööko, we na ëgëntö këno gëtaana ichinguru, na guiki möbhabhare iga na abhari bhö ömöndö gööra göë ësaramita na öbhöhoru bhöë Ënooköë hamui na bhainyu. Mökore igo korri iga amasabhi gainyu gange körëbhërröa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukuiriira gikugira yö ögökora amaiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ya gösookerria në ëno iga, möbhe na iriitegeerro rimui, abhantö bhano mökoobhërana na bhano mmöhanchainë; kia abhakumia, möbhe abhantö bhë ësaramita na abhasuseenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge köhakana igisiomba gösë kuringirania amang'ana amabhëëbhë, sibhoono möbhe bhaara bhaguitabhiria abhantö, kugira gayö ngo moobhërëkërëëyöë iga munyoore ëmësaaraaro. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.12+PSA.34.13+PSA.34.14+PSA.34.15+PSA.34.16"
              },
              "items": [
                {
                  "text": "Sab 34:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira ngandëkëröë iga,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui kana arabhanyahaare hano ndanyoore mörëngë abhantö bhö ömökëa gökora amaiya? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.10"
              },
              "items": [
                {
                  "text": "Mat 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12"
              },
              "items": [
                {
                  "text": "Isa 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono na abhakehaiya mörë hano ndanyoore mörairiiribhua gikugira yö öbhöheene bhöë Ënooköë. Mötagaacha kuiriiribhua, gösë koobhoha ökoobhohirria koobho; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga kumioyo geinyu möbhe na ësööko harë Kirisitö iga nëwe Yesö Ömönene. Muikare möiseemiri ichinsikö chonsui gukuhunchukiria ömöntö örë wonsui öno aköbhabhuuria igörö yi iriiteng'ero rëno rërëngë mönsë yeinyu. Sibhoono mökore igo kubhunyoohu na kubhusuuki. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möbhe na ichintariki ichinchiiya ninyoora ngötököa mörë, bhaara bhagötöka örögendo roinyu uruuya harë Kirisitö bhasuukirribhue. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira mbuuya ömöntö anyoore imiiriiro kögökora amaiya, hano ndanyoore nigo Ënooköë agutuna, gökëra kuiriiribhua kögökora amabhëëbhë. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö nawe naairiiriibhui harë rimui gikugira ya amaraga gaitö, ömöröngë gikugira ya bhaara bhatarë abharöngë, korri iga atuhiki hang'i na Ënooköë. Ömöbhërë gooe ngookuurë sibhoono naabhaayë ömöhoru gönkoro, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "gönchëra ëyö naagëërëëyë imioyo gëno wanyoorrë gërëngë gökëbhohe, akagirundiria ëng'ana yaae, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ögt 6:1—7:24",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhantö bhano mbere tëbhaarëngë abhasuuki hai, gönkaaga ëno Ënooköë aabhagumirriiyi guchinsikö chiira Nuhu aarë köhagaacha öbhooto bhööra; möno abhantö bhakë igo bhaasohërë, abhantö bhanaanai bheene bhano bhaatuuriibhui kömanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësësöro ya amang'ana gayö në ëbhaatiiso, ëno ëköbhatuuria bhainyu nsikö chino (tiiga iga nu ëkuruusia ubhunyanku bhö ömöbhërë hai, gëtatiga në ëndagano ëno ikurua göntariki inchiiya mbere yë Ënooköë) gönchëra yu ukuriöka ko Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "We aisa kuya kuriöbha, nawe naikaayë bhörëo bhöë Ënooköë, abhamaraika bhonsui, ögötöra na ichinguru hansë yaae bhirë.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
