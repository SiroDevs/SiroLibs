    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irimënya irihëa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhaara Kirisitö aairiiriibhui kömöbhërë gooe, ngisaini iga na bhainyu bhonsui muikong'eerri gököbha na iriitegeerro rëëra bheene aarëngë nario, kugira örë wonsui öno airiiriibhui kömöbhërë gooe ahaatërana na amaraga. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua bhoono muriihe kögenderria köbha kubhuigombi bhua abhaana bha abhantö, gëtatiga mökore garë Ënooköë Taata agutuna gönkaaga yeinyu ëno yatamërë gökömenya gökëbhara hano. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ënkaaga yeinyu ëno yaaheta yaisërë gökora gaara ichihamatë chigökora, ubhunyanku bhö öbhöraaya, ubhuigombi, ubhunyui, ichindaagëra hagarëhagarë, ibhikomo bhiu ubhunyui bhua amaroa, na ögösengera ibhihooru köno götagötönëröa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana ganga gayö abhahamatë bhayö nkörögööra bharë hano bhamaaha iga tëmökögakora hamui nabho hai, na köhayö bhabhatöka. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho mbarëgamba gaara gonsui bhaakorrë mbere ya ööra aisa guiseemia köbhakengera ikiina abhahoru na abhaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëyö niyo yaagirrë igichiratë gëkarundibhua ninyoora nköbhaku, korri iga nunyoora bhaisa gökengeröa ikiina nkaaga bhaarëngë abhahoru, kehaara abhantö bhandë bhagökengeröa ikiina; sibhoono bhabhe na öbhöhoru bho kibhumuika kehaara Ënooköë arëngë.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaimiriirri abhaiya bhi ibhituho bhië Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono umuhiko göa amang'ana gonsui hang'i görë, köhayö möbhe maiso, guiki möbhe na ëkërengere, korri iga mötöre gösabha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Ibh 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Tob 12:9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kögonsui gayö, möbhe na ömökëa gököhanchana, kugira öbhöhanchi ngukundikiria bhörë amaraga amaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möbhe na öbhögesa bhainyu abhiene kubhiene mötaana ukuirumungia. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra möntö asaache gökorra igituho gökërengere këno Ënooköë aamöha gutuurria abhandë; möbhe kia abhaimiriirri abhaiya bhë ësaramita yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno agusumaacha, asumaache kiö ömöntö öno ahaayöë isumaacho ëyö na Ënooköë, öno agökorra abhandë ëmërëmo akore guchinguru chonsui chiira aköhaabhöa na Ënooköë, korri iga Ënooköë agöngöe kömang'ana gonsui gököhetera harë Yesö Kirisitö. Ubhuhiku na ögötöra nö öbhooe kuya ëyë na ëyö. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukuiriira ku umukirisitö.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhahanchöa, mötakarögööra amasaacho amarito gano gaaguucha harë bhainyu köbhasaacha iga na ëgëntö ëkëgeni gëköbha harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono mögooke iga ngösanga mörë kumiiriiro ge Kirisitö, korri iga muuche kögooka bhökong'u hano ubhuhiku bhooe bhörëhönyöröa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhakehaiya mörë hano ndanyoore möratököa gikugira yi iriina re Kirisitö, ësësöro yë ëng'ana ëyö niiga Nkoro wu ëgöngo ubhuhiku, nko kögamba iga Nkoro wë Ënooköë, narëngë hamui na bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui gatai yeinyu atagaacha kuiriiriibhua iga nu umuiti wa abhantö, gösë iga nu umuibhi, gösë öno agökora amang'ana amabhëëbhë, gösë ömorongori öno agösoherra amang'ana ga abhandë. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore ömöntö nkuiriiribhua arë iga nu umukirisitö, atagaacha köbha na ichinsoni, gëtatiga agönge Ënooköë iga naana iriina rëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga yö ögökenga ikiina yaahikërë, nayo nëratangëre kunyumba ya abhantö bhë Ënooköë; na hano ndanyoore nëtangëra harë bhaitö abhantö bhë Ënooköë, niyekë ëraabhe köbhaara bhatakuiguëra igichiratë kë Ënooköë? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.11.31"
              },
              "items": [
                {
                  "text": "Ibh 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Keebhörë ërendëko rëkögamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    }
  ],
