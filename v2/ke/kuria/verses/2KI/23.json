              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Yehoyakimu naahaayë Bharao Neko amatiini gi ichimbiria na ësahaabhu, sibhoono naarusiri ënsë iriguuti korri ahëkëërania amatuno ga Bharao agaköhaabhöa amatiini gi ichimbiria. Akahakania abhantö amatiini gi ichimbiria na ësahaabhu. Këra umui naaruusiri ëkërengere këno ömögambi aarengërë, nawe akaha Bharao Neko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
