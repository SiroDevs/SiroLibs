                "loc": "JER.40.7+JER.40.8+JER.40.9"
              },
              "items": [
                {
                  "text": "Yer 40:7-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhugatinesa ömögambi wa Bhabheri naahöyë Getaria ömoona wa Ahikamu, mööchökörö o Sebhani, köbha ömögabhana wa abhantö bhonsui bha Yuta bhano bhataahirröë Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhakabhuruti bhonsui bha amacheesi hamui na abhantö bhaabho hano bhaaiguurë iga ömögambi wa Bhabheri aahööyë Getaria köbha ömögabhana, mbaagërëëyë Getaria Misibha haara. Abhantö bhayö mbaabho Isumaeri ömoona o Netania, Yohanani ömoona o Karea, Seraya ömoona o Tanihumeti Ömönetobhati, na Yesania ömoona o Ömömaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Getaria nawe naatuenerreyi mbere yaabho na abhantö bhaabho, akagamba iga, “Monge koobhoha gikugira abhaimiriirri bha Abhagaritayo. Mötamenya gönsë mökorre ömögambi wa Bhabheri ëmërëmo na amang'ana gonsui ngarabhabheere bhuuya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.1+JER.41.2+JER.41.3"
              },
              "items": [
                {
                  "text": "Yer 41:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kumueri go muhungatë, Isumaeri ömoona o Netania, mööchökörö o Erisama öno aarëngë öwë ëka yö öbhögambi naahikërë harë Getaria aana abhantö ikumi agasoherra Getaria, akamuita. Bhöyö bheene naaitërë Abhayahuti na Abhagaritayo bhano bhaarë nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.5+JER.43.6+JER.43.7"
              },
              "items": [
                {
                  "text": "Yer 43:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua, Abhaisiraeri bhonsui, abhake na abhanene hamui na abhakabhuruti bha amacheesi, bhagatanora, bhakaya Misiri, kugira mboobhohërë Abhagaritayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakini arahaatëröa kurua gökëbhohe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëtatö na ëbhërë, Ebhiri-merotaki ömögambi wa Bhabheri, hano aatangërë kögambër, ömooka göyö bheene naabhëëyë Yehoyakini ömögambi wa Yuta, akamöhaatëra kurua gökëbhohe. Röyö ndorëngë Urusikö ro mërongo ëbhërë na muhungatë ru umueri go ikumi na kabhërë, kömooka go mërongo ëtatö na muhungatë gukurua Yehoyakini aaimukiibhui kuya köng'aanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasumaachërë nawe bhuuya na kömöha iribhaga rië ësööko gökëra abhagambi bhandë bhano bhaarëngë nawe Bhabheri haara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Yehoyakini naahönchöyë ichingëbho chaae chë ëkëbhohe. Na ruiso ronsui kömabhaho gaae naarë körëa ibhiakörea nsikö chonsui kömeesa yö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naahayöë amatuno gaae na ömögambi ruiso ronsui, kuimenya reee rionsui.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
      ]
    }
