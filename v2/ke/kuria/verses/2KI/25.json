              },
              "items": [
                {
                  "text": "Ese 24:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kurusikö ro ikumi ru umueri go ikumi gö ömooka go kenda go öbhögambi bho Setekia, Nebhugatinesa ömögambi wa Bhabheri naahikërë na iricheesi reee, agasoheerra umugi go Yerusaremu, akagönaaria na köhagaacha öbhögöe kuguinaara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugi ngogenderreyi könaaribhua kuhika kömooka go ikumi na gumui gö öbhögambi bhö Ömögambi Setekia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro kenda ru umueri go kanai inchara ëndörö bhökong'u yaabhaayë kumugi kuhika abhamenyi bhaago bhakanga köbha na bhiakörëa bhirë bhionsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Ese 33:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö, iring'ënga riö öbhögöe bhu umugi rëgatëmöröa, abhasirikare bhonsui nabho bhakang'osa gönkaaga yu ubhutikö bhakahetera guisamba riö ömögambi kuihita gataigatai yi ichingito ibhërë, bhakaya ëntahana ya Arabha, ninyoora Abhabhabheri wanyoorrë bhaanaarri umugi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono iricheesi ria Abhagaritayo nderondiri ömögambi na kömömeria kuihancha re Yeriko, na abhasirikare bhaae bhonsui mbaamutigërë, bhakanyeregana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhagaritayo bhakagoota ömögambi, bhakamuhira kömögambi wa Bhabheri Ribhura haara, nawe akamökengera ikiina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.13"
              },
              "items": [
                {
                  "text": "Ese 12:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua bhagaita abhaana bhaae ataachërëëyë umuene, Hakurua bhakamötöndrra amaiso. Gosookerria koho bhakamöbhoha na ichibëngo, bhakamuhira Bhabheri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögösaribhua köë ëhekaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro muhungatë ru umueri go gataano gö omooka go ikumi na kenda gö öbhögambi bhö ömögambi Nebhugatinesa wa Bhabheri, Nebhusaratani ömokabhuruti wa abhariihi, ömökoramërëmo wö ömögambi, naasohërë Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Gam 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naasambërë inyumba yö ÖMÖNENE, inyumba nköraano na ichinyumba chonsui cha Yerusaremu; këra nyumba nene naagësambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abahasirikare bhonsui bha Abhagaritayo bhano bhaarengë hamui na ömökabhuruti na abhariihi bhö ömögambi mbaatëmööyë ichingito chino cheinaarrë umugi go Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhusaratani ömökabhuruti wa abhariihi bhö ömögambi, naahirrë köng'aanyi abhantö bhano wanyoorrë bhatigaayë kumugi na bhaara bhonsui wanyoorrë bhaihaanërë kömögambi wa Bhabheri hamui na abhantö bhandë bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono naatigërë abhamui bha abhantö bhano bhaarëngë abhataka bhökong'u gönsë. Naabhatigërë bhariihe ëmësabhibu na körëma ëmëgöndö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Gam 7:15-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.15+2CH.3.16+2CH.3.17"
              },
              "items": [
                {
                  "text": "2 Ich 3:15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Gam 7:23-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5"
              },
              "items": [
                {
                  "text": "2 Ich 4:2-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhagaritayo mbaabhunërë imitimö gi iriche ibhitënëtënë gëno gerëngë kunyumba yö ÖMÖNENE, hamui na ibhiikarro bhiagio, ibhiriga ënene yi iriche ëno yaarëngë kunyumba yö ÖMÖNENE, bhakaimukia iriche reeyo kuya Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.45"
              },
              "items": [
                {
                  "text": "1 Gam 7:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.16"
              },
              "items": [
                {
                  "text": "2 Ich 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bhöyö bheene bhakaimukia ibhinyöngö, amachiiko, amagasi, na ëmëgango gëno geerëngë gösambëra öbhöbhaani na ibhintö bhindë bhionsui bhi iriche bhino bhiarë gokorroa ëmërëmo gë ëhekaru, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakaimukia ibhihösero na ichibhakuri. Ömökabhuruti wa abhariihi bhö ömögambi naahirrë aharai këra gëntö gë ësahaabhu na këra gëntö kia amatiini gi ichimbiria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriche rionsui rëno Suremani aakoreeyë imitimö ëbhërë gëëra, ibhiriga ënene ëëra na ibhiikarro bhiayo gikugira yi inyumba yö ÖMÖNENE nderëngë iririto ëkërengere këno ëtaatimëröë. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra mutimö ngoorëngë na öbhötambë bhui ichimiita inyaanyai (8), na këgörö yaagio ngeerë na ömötoe gui iriche, öbhötambë bho këra mötoe mboorëngë imita imui në ërobho (1.25). Këra mötoe ngoinaaribhui öbhömaritaati bhöë ëmëkomamanga, gionsui gi iriche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhantö bha Yuta bharahirua Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Nebhusaratani ömökabhuruti wa abhariihi bhö ömögambi naamerri Seraya umunchaama ömönene, Sebhania umunchaama wa kabhërë hamui na abhariihi abhanene bhi ibhisaku bhatatö; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naaimukiri inture umui kumugi haara öno aarëngë körongocha abahasirikare kuiihi, hamui na abhantö bhataano abhanuhe abhö ömögambi bhano aanyoorrë ho. Bhöyö bheene, naaimukiri ömöng'orong'omi wö ömökönaare ömönene wi iricheesi öno arë köbhëëka ichihëtöko chiricheesi hamui na abhantö mërongo ësansabha abhanuhe bhano aanyoorrë kumugi go Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhusaratani ömökabhuruti wa abhariihi naaimukiri abhantö bhayö, akabhahira kömögambi wa Bhabheri Ribhura haara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
