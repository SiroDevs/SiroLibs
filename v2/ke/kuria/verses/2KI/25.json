            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Nebhugatinesa wa Bhabheri naatemërë abhantö bhayö akabhaita Ribhura haara gönsë ya Hamati. Kohayö abhantö bha Yuta mbaahirröë köng'aanyi këbhara yënsë yaabho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
