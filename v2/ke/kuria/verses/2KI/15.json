          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ya Yotamu, ÖMÖNENE naatangërë götöma ömögambi Resini wa Samu na ömögambi Bheka wa Isiraeri korri iga bhaitani Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
