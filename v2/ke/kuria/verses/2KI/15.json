              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mërongo ëbhërë gö öbhögambi bho Yotamu ömoona wa Usibha ömögambi wa Yuta, Hosea ömoona o Era naarëëyë inikö guisiira Bheka ömoona o Remaria, akamuita, hakurua akagambëra kuibhaga reee. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
