      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa akagamba iga, “Taigua ëng'ana yö ÖMÖNENE: ÖMÖNENE aragamba iga, ‘Icho ënkaaga ke ëno, ichikiiro isatö chö öbhöse ubhunyëke nchirache chiguribhöë ësekeeri imui yi ichimbiria, na ichikiro isansabha chë ësayiri nchirache chiguribhöë ësekeeri imui kuihita re Samaria.’” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.1",
            "verseOrgIds": [
              "2KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökabhuruti ömöheene wö ömögambi agateebhia Erisa ömöntö wë Ënooköë iga, “Hano nkanyoorrë ÖMÖNENE umuene agaakorrë amatirisa kuriöbha, gösë ëng'ana ëyö ëkahëkëraini!” Erisa akamuhunchukiria iga, “Nöramaahe na amaiso gaao umuene, sibhoono uwe törabhire hai.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iricheesi re Samu rëratanöra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaarëngë ho abhantö bhanai bhano bhaana amagenge bhano bhaarëngë këbhara ya amahita gu umugi go Samaria bhano bhaatebhaini abhiene kubhiene iga, “Ndaigua ntuikaayë hano töraitöa ni inchara? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.3",
            "verseOrgIds": [
              "2KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibhueera bho gösoha kumugi bhooho hai, kugira ntoraakue. Köhayö tötaya guisanchö ria Abhaasami; handë bhagaatuita gösë bhatöhoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, hano bhomwaramwaarrë, bhagatanöra kuya guisanchö ria Abhaasami, sibhoono hano bhaahikërë, tëmöntö aarëngë ho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Ömönene naakorrë iricheesi ria Abhaasami rëkaigua ëngamba ënene yanga iyi richeesi irinene rëno rërëngë na amatoka ni ichibharaasi. Abhaasami bhagakanya iga ömögambi wa Isiraeri nagörrë abhagambi bha Abhahiti na abhagambi bha Abhamisiri na iricheesi guucha köbhaitania. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.6",
            "verseOrgIds": [
              "2KI.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, ubhutikö bhöyö Abhaasami bhakang'osa bhonsui korri iga bhatuuri amabhaho gaabho bhagatiga amatunteera gaabho, ichibharaasi na ichitëkërë chaabho, ninyoora nirisanchö reebho kebhörë rerëngë.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhagenge bhanai bhaara bhaahikërë mbarëka yirisanchö, mbaasohërë guitunteera rimui, bhakarea na kunyua bhiira bhaanyoorrë mo, bhakaimukia amatiini gi ichimbiria, ësahaabhu na ichingëbho, bhakaya kubhibhisa. Bhagasoha guitunteera rëndë na gökora bhöyö bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhagateebhania iga, “Ëno tögökora tinchiiya hai! Ëno në ëng'ana inchiiya tönayo reero, na hano töraaganye bhuche bhöke, iribhörööta ndëratunyore. Tötaya bhöngöbhöngö töteebhi abhantö bhi inyumba yö ömögambi!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.9",
            "verseOrgIds": [
              "2KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, bhakarua guisanchö ria Abhaasami na köbhërëkëra abhariihi bha amahita na köbhateebhia iga: “Ntogëëyë guisanchö ria Abhaasami tongerë kömaaha gösë kuigua möntö örë wonsui ho. Ichibharaasi na ichitëkërë nchikëbhohërë, na amatunteera ngarëngë kebhöra bheene gaatigëröë.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.10",
            "verseOrgIds": [
              "2KI.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.10",
            "verseOrgIds": [
              "2KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhariihi bha amahita bhakarundia amang'ana gayö gakahika kömögambi ka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.11",
            "verseOrgIds": [
              "2KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora kerëngë igisuntë, ömögambi naabhökërë na göteebhia abhakoramërëmo bhaae iga, “Uni nëmanyërë ëseemi ya Abhaasami! Mbamanyërë iga ntööna inchara kumugi, bhoono bhatigërë irisanchö reebho bhagëëyë kuigunya korri iga hano tukuya kurigia ibhiakörea, bhatögoote bhonsui töbhahoru na kömeria umugi.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.12",
            "verseOrgIds": [
              "2KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.12",
            "verseOrgIds": [
              "2KI.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umui wa abhakoramërëmo bhaae akagamba iga, “Abhantö abhaaru bhaasika ke bhano bhaakua, hano ökahaancha ötöme abhantö bhake igo ni ichibharaasi isaano, kurua köbhaara bhaatama korri bhayi kömaaha kërë këbhaayë.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.13",
            "verseOrgIds": [
              "2KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakaahöra abhantö na köbhaha amagari abhërë. Ömögambi akabhatöma kuya körondia Abhaasami, aragamba iga, “Mötaya mömaahe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.14",
            "verseOrgIds": [
              "2KI.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhakaya kuhika Yorotani na gönchëra bhakaya bharamaaha ichingëbho na ibhintö bhindë bhino Abhaasami bhaatigërë nkaaga bhaarë köng'osa. Abhatömöa bhayö bhakaringa na göteebhia ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Samaria bhakarichoka na kömeria irisanchö ria Abhaasami. Kehaara ÖMÖNENE aagambërë iga: Ichikiiro isaano chö öbhöse bhöë ëngano gösë ichikiiro ikumi chië esayiri nchaguribhui gökëng'ënga kimui girichimbiria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi nawe wanyoorrë atööra ömökabhuruti umuriihi waae kuriiha irihita riu umugi. Ömökabhuruti öyö naatachëröë na abhantö kuihita haara bheene na gukua, kehaara bheene Erisa ömöntö wë Ënooköë aarëëyë ënaabhi ënkaaga ëno ömögambi aagëëyë kömömaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.17",
            "verseOrgIds": [
              "2KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora Erisa ömöntö wë Ënooköë aateebhia ömögambi iga, “Icho gönkaaga ke ëno, ichikiro ibhërë chö öbhöse ubhunyëke bhöë ësayiri mböraache bhuguribhöë ëkëng'ënga kimui gi ichimbiria kuihita re Samaria,” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.18",
            "verseOrgIds": [
              "2KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkanyoora ömökabhuruti aakora ichinkaani harë Erisa ömöntö wë Ënooköë, aragamba iga, “Hano nkaanyoorrë ÖMÖNENE umuene agaakorrë amatirisa kuriöbha, gösë, ëng'ana ëyö ëkahëkëraini?” Erisa nawe wanyoorrë amuhunchukiiyi iga, “Nöramaahe garakorekana, sibhoono ibhiakörea ibhiene törabhire hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.19",
            "verseOrgIds": [
              "2KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mböyö kebhaayë, mökabhuruti ööra naatintachëröë na abhantö na gukuera kuihita riu umugi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.20",
            "verseOrgIds": [
              "2KI.7.20"
            ]
          }
        }
      ]
    }
