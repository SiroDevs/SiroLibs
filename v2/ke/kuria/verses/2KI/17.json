          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi wa Asuru akaimukia abhantö kurua Bhabheri, Kuta, Abha, Hamati na Sebharibhaimu na köbhatööra kumigi ge Samaria ahasë ha abhantö bha Isiraeri bhano bhaahirröë köng'aanyi. Bhakaigaria imigi gëyö na kömenya mo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ëkabha iga hano bhaatangërë kömenya möyö, tëbhaasengeeyë ÖMÖNENE, köhayö ÖMÖNENE agatöma ichindui gatai yaabho, nacho chigaita abhamui bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhantö bhagateebhia ömögambi wa Asuru iga, “Ichihamatë chino waimukiri na guchitööra kumigi ge Samaria tichaamanyërë imigiro gë ënooköë wë ënsë ëyö, köhayö Ënooköë öyö aatöma ichindui chino chiköbhaita.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömögambi wa Asuru aagambërë iga, “Taringia umunchaama umui gatai ya bhaara torentërë köng'anya; muringia ayi amenye ho, korri aigi abhantö imigiro gë Ënooköë wë ënsë ëyö.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö umui wa abhanchaama bhano bhaameribhui kurua Samaria naagëëyë akamenya Bheteri, na kuigia abhantö möna ÖMÖNENE agösengeröa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono këra ëhamatë yaikoreeyë ichinooköë chaabho na guchitööra köbhösa bhöno ëhamatë ya Abhasamaria wanyoorrë bhaakora, këra ëhamatë yaakorrë igo kumugi gëno wanyoorrë bhaamenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Bhabheri mbaakorrë ibhihooru bhia Sukoti-bhenoti, abhantö bha Kuti bhagakora ibhihooru bhia Nerigari, abhantö bha Hamati bhagakora ibhihooru bhia Asima; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Abhaabhi bhagakora ibhiooru bhia Nibhasi na Taritaki; na Abhasebharibhi bhagasambërëërra abhaana bhaabho kömorro harë Aturamereki na Anamereki, ichinooköë cha Sebharibhaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene abhantö bhayö mbaasengeeyë ÖMÖNENE. Mbaahööyë gukurua harëbho abhantö bha këra teemo na köbhakora abhanchaama bhagökora ëmërëmo köbhösa na kuruusia ësataaka ho kuibhaga reebho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, mbaasengeeyë ÖMÖNENE, sibhoono ënkaaga ëyö bheene bharasengera guiki ichinooköë chaabho chino bhaimukiri kurua guchihamatë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
