    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Hosea wa Isiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go ikumi na kabhërë gö öbhögambi bho ömögambi Ahasia wa Yuta, Hosea ömoona wa Era naatangërë kögambëra Isiraeri, akagambëra Samaria haara kömeeka kenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakorrë iriraga mbere yö ÖMÖNENE ninyoora të kehaara abhagambi bha Isiraeri bhano bhaamötangatërë bhakorrë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Sarimanesa wa Asuru naamösoherreeyë; Hosea nawe akabha ömökoramërëmo waae na kömöhakana iriguuti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ënkaaga yëndë Hosea naatömërë abhantö kömögambi wa Misiri arasabha ubhutuurria; nëho ahatëyë köhakana iriguuti kömögambi Sarimanesa wa Asuru kehaara wanyoorrë anara gökora këra ömökari wa. Hano Sarimanesa aarööchë igo naabhohërë Hosea na iminyoorro na kömötööra gökëbhohe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ökögöa go Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi wa Asuru agasoherra ënsë ingima na köhëkëëra umugi go Samaria na kögönaaria kömeeka ëtatö. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go kenda gö öbhögambi bho Hosea, ömögambi wa Asuru naamerri umugi go Samaria, akaimukia abhantö bha Isiraeri na köbhahira köng'aanyi kuhika Asuru, abhamui bhaabho akabhatööra kumugi go Hara, abhandë hang'i na ömooro go Habhori, ömooro go Gosani na abhandë kumigi ge Metia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayö gonsui ngaakorekaini gikugira abhantö bha Isiraeri mbaateyëyë ÖMÖNENE, Ënooköë waabho, öno aabharuusiri kömabhoko ga Bharao ömögambi wa Misiri, guiki mbaasengeeyë ichinooköë chindë, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kögoota ichinchëra chi ichihamatë chino ÖMÖNENE aarugiri mbere ya Abhaisiraeri, na gökora amakora ga Abhagambi bha Isiraeri gano bhaasohiri gönsë. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhantö bha Isiraeri mbaakorrë gukibhisërë amang'ana gano gataarë amaiya mbere yo ÖMÖNENE, Ënooköë waabho. Mbaahagaachërë ahasë ha igörö kumigi geebho gionsui, kurua kömönaara gua abhariihi bhië ëmëgöndö kuhika kumugi göno gugitërë bhökong'u; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Gam 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Këgörö ya këra gëkerege na hansë ya këra mötë göno gööna amatö amabhësë, mbaahagaachërë imitimö gia amagëna na ibhihooru bhia Asera ënooköë ënkari, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gösamba öbhöbhaani kömakëngë gonsui ga ichinooköë chö öbhörongo, kögösorana ichisëëra chi ichihamatë chino ÖMÖNENE aarugiri. Mbaririiyi ÖMÖNENE kömakora gaabho amanyanku, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbaakoreeyë ibhihooru ëmërëmo bhino ÖMÖNENE wanyoorrë aabhakaania aragamba iga, “Mötagaacha gökora igo.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE naatömërë këra ömönaabhi na këra munchëëna gököga Isiraeri na Yuta aragamba iga, “Mötatiga ichinchëra cheinyu ichimbëëbhë mösööke amarago gaane na amaragiirriö gaane gököreng'aana na imigiro gëno naahaayë bhaaguuka bhainyu, na gëno naabhahaayë gököhetera köbhakoramërëmo bhaane abhanaabhi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bho tëbhaasöökërë; mbaabhaayë abhakong'u ke bhaaguuka bhaabho bhano bhataakumiri ÖMÖNENE, Ënooköë waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaangërë gösööka amaragirriö gaae; tëbhaagootërë imuuma ëno aakoorrë na bhaaguuka bhaabho; hamui na kuigiimiria ëkögo yaae, mbaasengeeyë ibhihooru bhino bhitaana bhuëra kuhika ninyoora mbo abhiene bhaanga köbha na bhuëra guiki; mbaagootërë ichisëëra chi ichihamatë chino chaabhainaarrë: Mbaaserrë amarago gö ÖMÖNENE; na tëbhaatödörëëyöë nago hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Gam 12:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaasarri amarago gonsui gö ÖMÖNENE, Ënooköë waabho, bhagakora ibhihooru bhi ichinooköë chi ibhimoori bhibhërë bhia gösasibhua; bhöyö bheene bhagakora ibhihooru bhia Asera ënooköë ënkari, bhagasengera ibhintö bhionsui bhia kuriöbha na bhagakoorra Bhaari ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10"
              },
              "items": [
                {
                  "text": "Ëhë 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaamuensërë abhaana bhaabho bhë ëgësaacha na abhë ëgëkari gu ichinooköë chö öbhörongo; bhakaya öbhögabhö na gökora öbhörogi. Mbaatönërë kimui gökora amanyanku mbere yö ÖMÖNENE, bhakamuriirria bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö ÖMÖNENE akarërëërra bhökong'u abhantö bha Isiraeri na köbharugia kimui mbere yaae; taatigërë möntö gëtatiga ikiaro ke Yuta bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ninyoora na abhantö bha Yuta tëbhaasöökërë amarago gö ÖMÖNENE, Ënooköë waabho; sibhoono mbaagootërë ichisëëra chino chaarentëröë na abhantö bha Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ÖMÖNENE naangërë Abhaisiraeri bhonsui, akabhanyankia na köbhatööra kömabhoko ga abhabhisa abharërëëma, kuhika hano aabhatabhutërë kurua mbere yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ÖMÖNENE aasookiri koohora abhantö bha Isiraeri kurua gööka ya Tauti, mbaatöörrë Yerobhoamu ömoona o Nebhati köbha ömögambi. Yerobhoamu nawe naakorrë abhantö bha Isiraeri gutiga ÖMÖNENE na gökora iriraga irinene bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaakorrë amaraga gano Yerobhoamu aakoorrë; tëbhagahatëyë, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhika ÖMÖNENE akabharugia kurua mbere yaae, kehaara wanyoorrë aagamba gököhetera köbhakoramërëmo bhaae bhonsui abhanaabhi. Köhayö abhantö bha Isiraeri mbaaimukibhui na kuhirua köng'aanyi kurua gönsë yaabho abhiene kuhika Asuru hano bhamenyërë kuhika bhoono.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaasami bharamenya Isiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
