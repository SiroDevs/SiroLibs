            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninyoora mboono ngökora bharë kehaara bhaagakorre karai. Tëbhagösengera ÖMÖNENE, gösë gösoorana imigiro, amaragirriö gösë amarago gano ÖMÖNENE aateebhiri abhaana bha Yakobho; öno aahaayë iriina Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
