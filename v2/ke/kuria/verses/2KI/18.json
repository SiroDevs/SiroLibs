            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Eriakimu ömoona o Hirikia, Sebhuna na Yoa bhagateebhia ömökönaare öyö iga, “Hano ökahancha, tasumaacha na abhakoramërëmo bhaao gökëgambo gië Ëkëasuri, kugira ntökëmanyërë; wange gusumaacha na bhaitö gökëgambo gi Ikiebhurania; kugira abhantö bhano bharëngë kurugito ngötegeerra bharë.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömökönaare ööra akabhateebhia iga, “Gösë, ömönene waane nantömërë köhaana amaang'ana gano kömönene weinyu na harë bhainyu bheene? Natantömërë guiki ninyoora nköbhantö bhano bhaikaayë kurugito bhano bhaakengeröa ikiina hamui na bhainyu körëa amabhi gaabho abhiene na kunyua isinyooro yaabho abhiene?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömönene öyö wi ichinture akaimëërra, agachëërra köngamba na kögamba gökëgambo kia Abhaebhurania iga, “Mötategeerra amang'ana gö ömögambi ömönene, ömögambi wa Asuru! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi aragamba iga: ‘Mötagaitabhirria Hesekia abhang'aine kugira taraatöre köbhatuuria kurua kömabhoko gö ömögambi hai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötagaitabhirria abhakorokombi korri iga muiteng'ere ÖMÖNENE aragamba iga, ‘ÖMÖNENE naratutuuri, na umugi göno tëgöratööröe kömabhoko gö ömögambi wa Asuru hai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge götegeerra Hesekia, kugira ömögambi wa Asuru nkögamba arë iga, ‘Möbhe na ömörembe nani, na mötaihaana harë uni. Nëho këra umui weinyu araarë ichisabhibhu chö ömösabhibhu gooe umuene, na amakö gö ömökö gooe umuene, na kunyua amanchë gigisima keee umuene, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhika hano ndiicha na köbhahira aharai gönsë yanga iyeinyu ëno, ënsë ëno ëna ibhiakörea na itibhaai, ënsë ëno ëna ëmëgaate na ëmëgöndö gë ëmësabhibhu; ënsë ëno ëna ëmësetuuni na öbhöökë, korri iga mömenya, mötagaacha gukua.’ Mötagategeerra Hesekia hano aköbhang'ainirria aragamba iga, ‘ÖMÖNENE naratutuuri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë, aaho örë wonsui gatai yi ichinooköë chi ichihamatë öno aatuurri ënsë yaae kurua kömabhoko gö ömögambi wa Asuru? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë, nëhai chirë ichinooköë cha Hamati na Aribhati. Nëhai chirë ichinooköë cha Sebharibhaimu, Hena na Ibha? Gösë chatuuria Samaria kurua kömabhoko gaane? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui gatai yi ichinooköë chi ichinsë chino öno aatuurri ichinsë chaabho kurua kömabhoko gaane kuhika ÖMÖNENE gutuuria umugi go Yerusaremu?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhantö bhonsui mbaakirrë iga kiri, na tëbhaahunchukiri ng'ana, kehaara bhakörömërrëyöë na ömögambi Hesekia, aragamba iga, “Monge kumuhunchukiria.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Eriakimu ömoona o Hirikia, Sebhuna ömöng'orong'omi na Yoa ömoona wa Asabhu, ömöndiki, bhakagëëra Hesekia na hano ichingëbho chaabho chitandökërë, bhakamöteebhia amang'ana gö ömökönare ömönene ööra.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
