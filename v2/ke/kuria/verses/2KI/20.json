                {
                  "text": "2 Gam 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Ich 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tamaaha, ichinsikö chiraacha chino ibhintö bhionsui bhino bhirëngë nyumba yaao na bhionsui bhino bhaisaweinyu bhaakömërë kuhika ënkaaga ëno bhirihiröa kuhika Bhabheri. Tëgëntö kërë gionsui kërëtama; niigo akögamba ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
        {
