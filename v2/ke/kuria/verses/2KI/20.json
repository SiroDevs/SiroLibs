                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guiki abhamui bha abhaana bhaao bhë ëgësaacha mbarihiröa köng'aanyi, nabho mbarëbha ichinture kunyumba nköraano yö ömögambi wa Bhabheri.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
          }
        }
