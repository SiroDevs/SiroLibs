        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Isaya aateebhiri Hesekia iga, “Taigua ëng'ana yö ÖMÖNENE: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
