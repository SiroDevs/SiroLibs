              "2KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
