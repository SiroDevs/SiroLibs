        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakora gandë gonsui ga Yerobhoamu, amahi gano aaitaini köbhökarë, na kebhörë aabhohooyi Tamesike na Hamati na kögëkora köbha ege Isiraeri, gonsui ngandëkëröë kögëtabhö kia Amang'ana gi Ichinkaaga cha Abhagambi bha Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobhoamu naakuurë agatökëröa guchindua cha abhagambi, na ömoona waae Sekaria akagambëra kuibhaga reee.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
              "2KI.14.29"
            ]
          }
        }
      ]
