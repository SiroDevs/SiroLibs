          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go ikumi na gataano gö öbhögambi bho Amasia ömoona o Yoasi ömögambi wa Yuta, Yerobhoamu ömoona o Yehoasi ömögambi wa Isiraeri naatangërë kögambëra Samaria haara, akagambëra kömeeka mërongo ënai na gumui. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na naakorrë ubhunyanku mbere yö ÖMÖNENE; Tahatëëyë iriraga rë rionsui re Yerobhoamu ömoona o Nebhati, rëno rehotooye abhantö bha Isiraeri bhagakora iririga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.1.1"
              },
              "items": [
                {
                  "text": "Yon 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naabhohooyi ënsë yonsui ëno yaarëngë iya Isiraeri, kurua Bhösohero bho Hamati kuhika kunyancha ya Arabha. Köreng'ana na ëng'ana yö ÖMÖNENE, Ënooköë wa Isiraeri, köhetera kömökoramërëmo waae Yona ömoona wa Amitai, ömönaabhi, kurua Gati-hebheri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ÖMÖNENE naarööchë isina ënene ëno Abhaisiraeri bhaanyoorrë kugira taarëngë ho möntö örë wonsui wa köbhatuurria hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ÖMÖNENE tëwanyoorrë agambërë iga narasiki Isiraeri kimui hansë ya kuriöbha, igo naabhatuurri köhetera kömögambi Yerobhoamu ömoona o Yehoasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
