            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.40.6+PSA.40.7+PSA.40.8"
              },
              "items": [
                {
                  "text": "Sab 40:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkio keegirrë nkaaga Kirisitö aarë guucha gökëbhara, agateebhia Ënooköë iga:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkoro Nhoreeru nawe ngötöha arë öbhöherekia bhooe. Kögötanga nkögamba arë iga:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö hano amaraga garuusibhua ho, tiituno re kuruusia ikimuenso ge kuruusia iriraga rëëköbha ho guiki hai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tötahika hang'i Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe bhantö bhaitö, kömaanyinga ga Yesö nköhaabhoa törë öbhötachöre kimui kögösoha ahasë ahahoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "We atuigörra ënchëra ëhëa, köhetera köhanga ëëra, nko kögamba iga, ömöbhërë gooe umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe ntööna umunchaama ömönene igörö yi inyumba yë Ënooköë, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.30"
              },
              "items": [
                {
                  "text": "Abhar 8:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.25"
              },
              "items": [
                {
                  "text": "Ese 36:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "köhayö tuhikë hang'i Ënooköë na ömooyo gö öbhöheene na ubhukumia öbhöhëkëëranu na imioyo gëno geesaabhuurua kurua göntariki ëmbëëbhë, hamui na ëmëbhërë gëno geisaabhibhua kömanchë amariku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga tögooterre bhökong'u iriteng'ero rëno tuguitabhirria, kugira ntööna öbhöheene iga Ënooköë ööra aakoorrë ëndagano nö ömöheene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga tuitungiriirri gutuurrania götöörana igituunyo gëköhanchana na gökora amaiya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tötagatiga ësëëra ëëra ya gusikana hamui, kehaara abhandë bhaagökora. Kuibhaga rëyö tutirimikani abhiene kubhiene, kebhörë mökömaaha iga Urusikö rööra rö Ömönene röbhaayë hang'i.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano töragenderri gökora iriraga gököhanchana hano töisa kömanya öbhöheene, ikimuenso këndë tëkëëho guiki këno këraruusibhöë gikugira ya kuruusia ho iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.11"
              },
              "items": [
                {
                  "text": "Isa 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëno ëho, nö ököganya köbhoobha ögökengeroa ikiina na ömörro ömörrö, göno gurisikia bhonsui bhaara bhagökërana na Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Ëhë 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöntö örë wonsui öno atakögoota imigiro ge Mösa, naraitöe atamaahëyöë maabhë hano öbhöhereki bhöa abhantö bhabhërë gösë bhatatö bhöraabhe ho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.8"
              },
              "items": [
                {
                  "text": "Ëgt 24:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kana gösë ömöntö ööra akuimaarria Ömoona wë Ënooköë, na gösera amaanyinga gi Imuuma gano gamösaabhuurrë, ömöntö öno agötöka Nkoro wë Ënooköë, ni ibhörööta inene re teemo kë aisaini iga anyoore? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.35"
              },
              "items": [
                {
                  "text": "Ëhë 32:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.36"
              },
              "items": [
                {
                  "text": "Ëhë 32:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira ntömanyërë ööra aagambërë iga, “Igisiomba në ëkeene, uni nëndahakane;” guiki naagambërë iga, “Ömönene naarëkengera ikiina abhantö bhaae.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ökögöa kömabhoko gë Ënooköë öno aho në ëng'ana ya koobhohia bhökong'u!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hëëtöka amang'ana gano gaarichokëëyë guchinsikö cha götanga. Nkaaga morabhiribhöë na öbhörabhu bhöë Ënooköë. Ninyoora moonyoorröë na imiiriiro ëmeeru, bhainyu mogumirriiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga chindë moorë götököa na gusuukirribhua kömöng'aanyi; nkaaga chindë moogotaini na bhaara bharë kuiriiribhua bhöyö bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moosangërë imiiriirö gia abhabhohe, na hano moosakööyöë ibhintö bhienyu bhionsui, moogumirriiyi kömëgooko, kugira mömanyërë iga mööna ibhintö ibhiiya bhökong'u na ibhia kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mötagatiga öbhökarë bhoinyu, gikugira mböraabhahe igituho ëkënene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëragërë iga möbhe na ubhugumirria, korri iga möhëkëërani amatuno gë Ënooköë na kunyoora këëra aaragaini. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
