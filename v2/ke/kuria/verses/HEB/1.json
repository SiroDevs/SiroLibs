          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Ömoona nu umukumahe gökëra abhamaraika, kehaara iriina rëëra rëno aahaayöë na Ënooköë rërëngë irikumahe gökëra amariina gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
