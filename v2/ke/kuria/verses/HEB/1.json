        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana yë Ënooköë köhetera kö Ömoona waae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
