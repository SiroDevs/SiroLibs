                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira nööhai gatai ya abhamaraika öno Ënooköë aagateebhiri iga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
