            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Öbh 3:13\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëragërë iga öbhöteti bhösöököë na abhantö bhonsui, kuhika abhasaacha na abhakari bhabhe abhaheene abhiene kubhiene bhörrë. Ënooköë naarëkengera ikiina abhahurunkani na abharaaya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        }
      ]
    },
