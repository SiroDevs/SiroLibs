                "loc": "JOS.1.5"
              },
              "items": [
                {
                  "text": "Yos 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Monge köbha abhantö bhano bhahanchërë ichimbiria, möhëënyëke na ibhintö bhiira mönabhio. Ënooköë umuene aragamba iga, “Tënkagutiga iga hai; gösë kögötabhuta” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.5",
            "verseOrgIds": [
              "HEB.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.6"
              },
              "items": [
                {
                  "text": "Sab 118:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkiö gikugira tökarëha kögamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möhëëtöke abhatangati bhainyu, bhano bhaarundiri ëng'ana yë Ënooköë harë bhainyu. Muisunche örögendo roobho, muëge ubhukumia bhoobho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.7",
            "verseOrgIds": [
              "HEB.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesö Kirisitö nööra bheene icho, reero na kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.8",
            "verseOrgIds": [
              "HEB.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge götöbhatubhibhua na amaigiö amahagarë gëëkëgeni. Ësaramita yë Ënooköë niyo ëgökong'eerria imioyo geitö na ti imigiro igörö ya ibhiakörea; imigiro gëyö tëgeetuuriiyi möntö örë wonsui öno aagëgootërë hai.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö ntööna irikëngë rëno bhaara bhaagökora ëmërëmo guitunteera ria Abhayahuti bhataana söro kubhiakörëa bhiario. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.10",
            "verseOrgIds": [
              "HEB.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.27"
              },
              "items": [
                {
                  "text": "Abhar 16:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Umunchaama umuhikërë wa Abhayahuti nkörenta amaanyinga gi ichitugo ahasë ahahoreeru na kuruusia ikimuenso kugira ya amaraga; sibhoono ichinyama chi ichitugo chiyö ngösambërëërröa chirë isikö yi irisanchö. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkiö keegirrë Yesö nawe kugutuna iga asaabhuure abhantö kurua kömaanyinga gaae umuene, naiririibhui na agakua isikö yi irihita. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö tömögëëre isikö yi irisanchö tuimuki ichinsoni chaae. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira gökëbhara hano tëtööna umugi göno gögömërë hai; sibhoono nkurigia törë umugi gööra guguucha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
              "HEB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö gököhetera harë Yesö, turuusiri Ënooköë ikimuenso kë ëgöngo ruiso ronsui, nko kögamba iga, ëgöngo ëno ikurua kuminyua gëno gëgötara iriina reee. Egöngö ëno ikuruusibhua na bhano bhaguitabhirria iriina reee. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monge kuëbha gökora amaiya na gutuurrania, kugira bhiyö mbio ibhimuenso bhino bhigötegeria Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        }
      ]
    },
    {
