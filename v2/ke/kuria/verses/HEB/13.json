                "loc": "GEN.18.1+GEN.18.2+GEN.18.3+GEN.18.4+GEN.18.5+GEN.18.6+GEN.18.7+GEN.18.8"
              },
              "items": [
                {
                  "text": "Ögt 18:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3"
              },
              "items": [
                {
                  "text": "19:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Tob 5:4,5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötakiëbha kuirigania abhageni, kugira kögökora igo, abhantö abhamui bhaairigania abhamaraika bhatamanyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.2",
            "verseOrgIds": [
              "HEB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möhëëtöke bhaara bharëngë gökëbhohe ke bhano möbhohëröë hamui nabho. Möhëëtöke bhaara bhakuiriira ke bhano mukuiriira hamui nabho.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        }
      ]
    },
