        {
          "text": "Amamaaho ga Obhatia keebhörë ÖMÖNENE Ënooköë agambërë kö ëhamatë ya Ëtomu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ÖMÖNENE narabhöröötë Ëtomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikibhune ke Ëtomu köbhöröötöa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë narakengere ichihamatë ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaisiraeri mbarakëre",
          "type": "text"
        }
      ]
    }
