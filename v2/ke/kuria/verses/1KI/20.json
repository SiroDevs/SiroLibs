              "1KI.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhö ömögambi Bheni-hatati wa Samu bhakamöteebhia iga: “Ichinookoë cha Isiraeri ni ichinooköë chi ichinguku; nkio keegirrë tökahichua. Sibhoono, handë ntörabhahiche hano töraitane nabho guitendeera. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.23",
            "verseOrgIds": [
              "1KI.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ruusia ho abhagambi mërongo ëtatö na bhabhërë bhaara na götööra abhakönaare. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.24",
            "verseOrgIds": [
              "1KI.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öseemi iricheesi ke rëëra bheene reitëröë, ichibharaasi na amagaari ga kurutua kë gaara bheene waarusiibhui. Hakurua, tuitanërë nabho guitendeera na ngökanya törë iga ntörabhakëre.” Ömögambi Bheni-hatati akaigua na kögoota amaragirriö gaabho na gökora bho bheene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga yi ikinyigita, ömögambi Bheni-hatati agaköma abhantö bhaae, akaya kumugi go Abheki guitania abhantö bha Isiraëri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.26",
            "verseOrgIds": [
              "1KI.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Isiraeri nabho bhagakömöa na köhaabhöa ibhiögë, bhakaya götembekerrania na Abhasamu. Abhantö bha Isiraeri bhagatööra irisanchö, bhakamaahëkana kia amahicho gi ichimburi abhërë amake igo, sibhoono Abhasamu mbanchaarrë umugi umugima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömöntö wë Ënooköë ahikërë ömögambi wa Isiraeri hang'i akamöteebhia iga, “ÖMÖNENE aragamba iga: ‘Gikugira ëno Abhasamu bhagambërë iga uni ÖMÖNENE në ënooköë wi iritendeera ndë, na të ënooköë wi irihancha irinene rëyö, nëndaköhe ögökëra guisiira iricheesi irinene rënö. Na uwe nöröngöre iga uni nu uni ÖMÖNENE.’”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri na Abhasamu Mbaakëngërraini guchinsikö isansabha, na kurusikö ro muhungatë, iriihi rëgatanga. Kurusikö röyö bheene, abhantö bha Isiraeri bhagaita abhasirikare ibhiköë irigana rimui (100,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.29",
            "verseOrgIds": [
              "1KI.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano bhaatigaayë, mbaang'oseeyë kumugi go Abheki. Na urugito ru umugi rökabhaguëra na guita abhantö ibhiköë mërongo ëbhërë na muhungatë (27,000) bhano bhaatamërë. Bheni-hatati naag'osërë na kuigunya kugisuumua ke mönsë yu umugi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhaae Bhakamögëëra bhakamöteebhia iga, “Nkuigua törë iga abhagambi bha Isiraeri na abhantö bha amaabhë. Bhoono, tatuitabhirria, tuibhohe amagoneera kumikurukuru na ichinsiri kömagoti, tögëëre ömögambi wa Isiraeri. Haandë akahonia amabhaho gaao.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.31",
            "verseOrgIds": [
              "1KI.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhakaibhoha amagoneera kumikurukuru na guitörra ichinsiri kömagoti gaabho, bhakagëëra ömögambi wa Isiraeri, bhakamoteebhia iga, “Ömökoramërëmo waao, Bheni-hatati, arakögeya aragamba iga ‘Hano ökahaancha ööhoni wange kunyita.’ Ahabhu akabhabhuuria iga, ‘Kana kura ho akërë? We, mura omoito.’”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhaara bha Bheni-hatati mbaarë guikembereerria ëkëmanyiirriö kërë gionsui iki iriyeega iriiya, hano Ahabhu agambërë igo, bhakarengerrania kögamba iga “Ee-e, Bheni-hatati mmura omoinyu!” Ahabhu akabhateebhia iga, “Taya mömörente harë uni.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, hano Bheni-hatati aachërë harë Ahabhu, Ahabhu naatunërë iga aikare hamui nawe kuigaari reee ëre kurutua. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Bheni-hatati agateebhia Ahabhu iga, “Nendakuringiri imigi gëëra gionsui taata aruusiri isaweinyu. Ötaange ëmëtëra Tamasike haara, kehaara taata aakoorrë Samaria haara.” Ahabhu akahunchukia iga, “Nëndagutige kömaitabhërraniö gayö.” Hayö bheene, agakora amaitabhërraniö nawe na kumutiga muchencho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömönaabhi araihiima Ahabhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köngamba yö ÖMÖNENE, umui wa abhaana abhëga bha abhanaabhi, agateebhia murikia waae iga, “tantema, hano ökahancha.” Sibhoono we akanga kömötema. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.24"
              },
              "items": [
                {
                  "text": "1 Gam 13:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe akamöteebhia iga, “Gikugira wangërë kuiguera ëngamba yö ÖMÖNENE, niigo töratigane nawe igo, indui iguiite.” Mmaheene, niigo bhatigaini igo, agasikana indui ëkamuita. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, ömönaabhi ööra agasikana ömöntö wööndë, akamöteebhia iga, “Ndakögeya iga önteme.” Ömöntö ööra akamötema na kumunyahaara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, ömönaabhi agatanöra, akaya agaikara mbarëka yë ënchëra araganya ömögambi wa Isiraeri, agubhërë ëgëtambara kubhusiö korri iga angë kömanyëkana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoorrë ömögambi araheta, ömönaabhi ööra akamököörra aragamba iga; “Ömönene, Uni ömökoramërëmo waao naarë köröhari ro mbere kuiihi; umusirikare umui akandentera umunyambu umui aganteebhia iga, ‘Uriihe ömöntö önö; hano akang'osa, na amabhaho gaao umuene ökamöhakana, gösë ibhing'enga bhia amatiini gi ichimbiria ibhiköë bhitatö’ (3,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nkaaga ömökoramërëmo waao naarë köhëgëëga, ömöntö öyö akang'osa.” Ömögambi wa Isiraeri akamöteebhia iga, “Nke hayö këraabhe harë uwe, wikengeyë ikiina umuene.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo ömönaabhi akaruusia ëgëtambara kubhusiö bhooe, ömögambi akamöngöra iga, nu umui wa abhanaabhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ömönaabhi ööra agateebhia ömögambi iga, “ÖMÖNENE aragamba iga: ‘Köhano öhatëëyë ömöntö öno naaruusiri ëngamba iga aitöe agötërrökërë, igo, amabhaho gaae ngarahakanöe na amabhaho gaao, na abhantö bhaae köbhantö bhaao.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ömögambi wa Isiraeri akariinga kuya waae Samaria, aichööyë öbhörrö na amaachiichi amarito.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.43",
            "verseOrgIds": [
              "1KI.20.43"
            ]
          }
        }
      ]
    }
