              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani naakorrë ichimeri ichinchaaru Esioni-gebheri haara, hang'i na Eroti ëno yaarë kunguguni ya Nyancha Mberretu, gönsë ya Etomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
