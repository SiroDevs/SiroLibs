          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Hiramu nawe agatöma abhaimiriirri bhaae na abhagendia bhi ichimeeri hamui na abhakoramërëmo bha Suremani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
