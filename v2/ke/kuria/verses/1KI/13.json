    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömönaabhi araihiima ësengero Bheteri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë nkaanyoora Yerobhoamu aimërëëyë mbarëka ya irikëngë korri iga asambe öbhöbhaani. Igo, ömöntö wë Ënooköë kurua Yuta akahika Bheteri na ëng'ana yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.1",
            "verseOrgIds": [
              "1KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15"
              },
              "items": [
                {
                  "text": "2 Gam 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömöntö öyö akaihiima irikëngë rëëra aragamba iga: “Wei rërë irikëngë! ÖMÖNENE aragamba iga: ‘Naribhöröa ömoona gööka ya Tauti öno arëbhërëkëroa iga Yosia. Öyö narimukia Abhanchaama bhano bhaagökora ëmërëmo ge gösamba öbhöbhani këgörö yaao, na kuruusiria ikimuenso igörö yaao, Ee-e amaguha ga abhantö ngarësambërërröa këgörö yaao!’” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.2",
            "verseOrgIds": [
              "1KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öyö akaruusia ëkëmanyiirrio Urusikö röyö bheene, aragamba iga: “Kenö nkio ëkëmanyiirrio këno ÖMÖNENE agambere iga, ‘Tamaaha irikëngë rëno ndërataagane, na iriibhu rëno rëko ndëranyere hansë.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögambi Yerobhoamu aiguurë amang'ana gaayo gö ömöntö wë Ënooköë guisiira irikëngë rëëra rërëngë Bheteri, naarambööyë ököbhöko akagamba iga, “Tagoota ömöntö öyö!” Hayö bheene igo, ököbhoko kööra aamömemeeyë, gökaihöma, akanga götöra gukuringa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.4",
            "verseOrgIds": [
              "1KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irikëngë rëëra rëgatagana, na iriibhu reko rëkanyera hansë, gi ëkëmanyirriö këëra bheene ömöntö wë Ënooköë wanyoorrë agambërë ëng'ana yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.5",
            "verseOrgIds": [
              "1KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ömögambi Yerobhoamu agateebhia ömöntö wë Ënooköë ööra iga, “Hano ökahaancha, ögëëyë ÖMÖNENE, Ënooköë waao önsabhëre ököbhoko koone kuhuene.” Ömöntö wë Ënooköë nawe agasabha ÖMÖNENE, na ököbhoko kömögambi, gökahuëna gökaringa kehaara korengë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ömögambi Yerobhoamu ateebhiri ömöntö wë Ënooköë iga, “Tasoha ka waane tööre ibhiakörea, nani nköhe igituho.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömöntö wë Ënooköë ööra akahunchukiria ömögambi iga, “Ninyoora öng'e iritënë ri bhintö bhiao, tënkaaya hamui nawe hai. Tënkaarëa gëntö gösë kunyua manchë ahasë hano hai ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.8",
            "verseOrgIds": [
              "1KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ÖMÖNENE nanteebhiri iga, ntakaarëa bhiakörëa gösë kunyua manchë, gösë körëngëra ënchëra ëëra naachëëyë hano.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.9",
            "verseOrgIds": [
              "1KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo ömöntö ööra akarëngëra ënchëra yëndë, akanga körëngëra ënchëra ëëra aachëëyë Bheteri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömönaabhi ömöntömökörö wa Bheteri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö, nkanyoora aaho ömönaabhi ömöntömökörö ëntahana ya Bheteri. Abhaana bhaae bhakamögëëra na kömöteebhia amang'ana gonsui gano ömöntö wë Ënooköë ööra aakoorrë kurusikö röyö Bheteri haara; bhakamöteebhia guiki na amang'ana gaara ömöntö ööra wanyoorrë ateebhiri ömögambi Yerobhoamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.11",
            "verseOrgIds": [
              "1KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isawaabho akabhuuria iga, “Nënchëra kë agërëëyë?” Nabho bhakamoorokia ënchëra ëno ömöntö wë Ënooköë ööra kurua Yuta aagërëëyë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.12",
            "verseOrgIds": [
              "1KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe agateebhia abhaana bhaae iga, “Taanyarria ëtëkërë ëyo,” Bhakamorria ëtëkërë nawe akagirina. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.13",
            "verseOrgIds": [
              "1KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarondia ömöntö wë Ënooköë ööra, akamunyoora aikaayë hansë yö ömoaroni. Igo, akamubhuuria iga, “Gösë, nuuwe ömöntö wë Ënooköë ööra kurua Yuta?” Nawe akamuhunchukiria iga, “Ee-e! Nu uni!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntömökörö ööra akamoteebhia iga, “Tasoha ka waane öre ibhiakörea.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono, akamöteebhia iga, “Tendaringë nawe kuya waao, gösë gosoha waao. Na tënkarëa bhiakörëa gösë kunyua manchë ahase hano hai, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ÖMÖNENE naanteebhiri iga, ntagaacha körëa ibhiakörea gösë kunyua manchë ahase hano, gösë körëngëra ënchëra ëëra naachëëye.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntömökörö ööra wa Bheteri akamöteebhia iga, “Uni nö ömönaabhi ndë ke uwe, na ÖMÖNENE naasumaachërë nani köhetera kömömaraika aragamba iga, ‘Tamuriingia ka waao, are ibhiakörea na kunyua amanchë.’” Sibhoono, ömönaabhi ömöntömökörö ööra, naarë kömöng'ainirria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ömöntö wë Ënooköë ööra akaringa hamui nawe, na körëa ibhiakörea na kunyua amanchë kömönaabhi ömöntömökörö oora.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga waanyorrë bharëngë kömeesa, ëng'ana yö ÖMÖNENE ëgaachëra ömönaabhi ömöntömökörö ööra, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe agateebhia köngamba ënene ömöntö wë Ënooköë ööra kurua Yuta iga, “ÖMÖNENE aragamba iga: ‘Uwe wangërë kuiguëra ëng'ana yö ÖMÖNENE na konga kögoota amarago gano ÖMÖNENE, Ënooköë waao aaköhaayë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhaga rëyö uringërë na körëa ibhiakörea na kunyua amanchë ahase hano watebhibhui iga tagaacha körëa bhiakörëa gösë kunyua manche. Igo mbe, ikihundugu keeo tëkëratökëröë guchindua cha bhaaguka weinyu hai.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaasookiri köraagëra, ömönaabhi ömöntömökörö ööra agaseemiria ëtëkërë ömöntö öyö wë Ënooköë, nawë agatanöra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoorrë arariinga kuya waae, indui ëkamusikana gönchëra, ëkamuita; na götabhutua ikihundugu keee mbarëka yë ënchëra; hakurua ëtëkërë yaae ni indui ëëra, chikaimërra mbarëka yaakio. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bhano bharë köhëta gönchëra bharööchë ikihundugu gönchëra na indui imërëëyë hang'i nakio, bhakaya kumugi göno wanyoorrë ömönaabhi ööra amenyërë, bhagateebhia abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi ööra waanyoorrë amuirigaini ka waae, hano aiguurë amang'ana gayö, akagamba iga, “Öyö nö ömöntö wë Ënooköë ööra bheene aangërë kuigua ëngamba yö ÖMÖNENE! ÖMÖNENE aatömërë indui, imuitaini na kumuiita, kehaara wanyoorrë aamöteebhia.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, agateebhia abhaana bhaae iga, “Nyaarria ëtëkërë.” Bhakaya bhakamorria ëtëkërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntömökörö ööra akaya akanyööra ikihundugu kiö ömöntö wë Ënooköë gönchëra, na indui na ëtëkërë ëëra chirëngë mbarëka yë ënchëra, sibhoono indui ëëra tiyamörëëyë gösë guita ëtëkërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ömönaabhi ömöntömökörö ööra, akaimukia ikihundugu këëra kiö ömöntö wë Ënooköë agakirinia götëkërë yaae akaya kömötökëra waae Bheteri, na guikara öbhoohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamötökëra kundua yaae, nawe na abhaana bhaae bhagaikara öbhoohu bharagamba iga, “Wei, Mura ömoito” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaasookiri kömötökëra, ömönaabhi ömöntömökörö agateebhia abhaana bhaae iga, “Hano nani ndikua, muuche göntökëra kundua ëno bheene ömöntö wë Ënooköë atökëyöë; na götööra amaguha gaane mbarëka ya amaguha gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amang'ana gonsui gano ÖMÖNENE aaruusiri ëngamba guisiira irikëngë re Bheteri, na ahasë honsui ha kumuensera kubhikerege bhia Samaria, kuhika gahëkeranë.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriraga re gusikia re Yerobhoamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobhoamu taahaatëëyë ubhunyanku bhooe hai; naagenderreeyi koohöra abhantö igo köbha abhanchaama, korri bhakore ëmërëmo köhasë ha kumuensera hano aahagaachërë amakëngë. Ömöntö örë wonsui önö aarë kuiruusia, naarë kömötööra köbha umunchaama köhasë ha kumuensera kubhikerege hayö. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëyö ëkabha iriraga rëno rëgirrë ëka ya Yerobhoamu ëgasikibhua kurua gökëbhara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    }
