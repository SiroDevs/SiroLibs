              "1KI.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi Yerobhoamu akahagaacha bhöhëa umugi go Sekemu kunguku ya Ebhuraimu; akamënya ho. Hakurua guiiki akaya akahagaacha umugi go Bhenueri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Yerobhoamu ataangërë guitegeerra iga: “Bhoono öbhögambi mböraringë gööka yo Tauti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bhano bha Isiraeri bharaayi bharaya kuruusia ibhimuenso kunyumba yö ÖMÖNENE ëno ërëngë Yerusaremu. Imiooyö geebho ngëraihönchörre ömönene waabho Rehobhoamu ömögambi wa yuta, nabho mbaranyitë.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
