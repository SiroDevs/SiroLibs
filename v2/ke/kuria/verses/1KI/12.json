                {
                  "text": "Ëgt 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono hano ömögambi aasookiri gusuumaacha na abhandë, agakora ibhihooru bhibhërë ibhi ibhimoori bhië ësahaabhu, hakurua agateebhia abhantö bhaara iga, “Bhainyu bharë abhantö bha Isiraeri, chino nchio ichinooköë chainyu chino chaabharuusiri Misiri! Tikibhune këho harë bhainyu kuya Yerusaremu kumuensera ho hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatööra ëkëhooru ikimui gë ëkëmoori gë ësahaabhu kumugi gö Bheteri na ëkëndë kumugi gö Tani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'ana ëyo ëkabha iriraga, kugira abhantö mbaanyörööyë kuya kumuensera ibhihooru bhiyo Bheteri na Tani haara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene, Yerobhoamu akahagaacha ahasë ha kumuensera kubhikerege, akaahööra abhanchaama, bhano bhataarëngë abhikiaro kia Abharawi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.33"
              },
              "items": [
                {
                  "text": "Abhar 23:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yerobhoamu akaruusia ëngamba gökora urusikö ro ikumi na gataano ru umueri go kanaanai köbha urusikö röë ësögökörö ke ëëra yaagakorekaini Yuta. Akamuensera guikëngë rëno wanyoorrë aahagaacha Bheteri mbere yi ibhihooru bhiira bhi ibhimoori aakoorrë, agatööra abhanchaama bhaara waanyoorrë aahöra iga bhaimërëërre këra hasë ha kuruusiria ibhimuenso kubhikerege haara waanyoorrë ahagaacha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö röyö ro ikumi na gataano kumueri go kanaanai, nawe umuene naaiseemiri akaya Bheteri kumuensa. Mböyö akong'iriiyi ësögökörö ëyö Köbhaisiraeri, nawe umuene akariina kuya guikëngë gösamba öbhöbhaani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
