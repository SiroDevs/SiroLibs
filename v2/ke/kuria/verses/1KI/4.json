              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë nahaayë Suremani, öbhöng'aini öbhönene na ubhunguri öbhönene; öbhusisuri bhooe mboorëngë kiö ömösense gui inguguni yi nyancha, tëbhoorë na kërengere hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
