          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöng'aini bho Suremani mbokërrë ubhua abhantö bha Rögörö na Abhamisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
