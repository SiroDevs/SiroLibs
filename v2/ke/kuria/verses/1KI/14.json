            }
          ]
        },
        {
          "text": "Kömooka go gataano gö öbhögambi bhö Ömögambi Rehobhoamu, Sisaki ömögambi wa Misiri, naitaini umugi go Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
