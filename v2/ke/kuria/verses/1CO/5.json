              "items": [
                {
                  "text": "Ëhë 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kögayö gonsui nkë gëntöndörëëyë gökengera abhakëbhara ikiina? Nëtarë iga mbaara bharëngë mönsë gökanisa mögökengera ikiina? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
            "verseOrgIds": [
              "1CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë ngökengera arë ikiina bhaara bhatarëngë abhakanisa. Kebhörë ërendëko rëkögamba iga, “Bhainyu mötarugia ömöntö umunyanku kurua guikomo reinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.13",
            "verseOrgIds": [
              "1CO.5.13"
            ]
          }
        }
      ]
    }
