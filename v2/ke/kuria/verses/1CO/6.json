        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uguchöngërana gatai ya abhakumia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoora umukumia ana ikiina na öwöndë, kugira kë akuya guchöngëra kö abhakengabhiina bhano bhatarë abharöngë, iribhaga rëno agaatigërë abhantö bhë Ënooköë bhakenge ikiina abhiene? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.1",
            "verseOrgIds": [
              "1CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë mötamanyërë iga abhantö bhë Ënooköë mbarëkengera ëkëbhara ikiina? Na hano ndanyoore bhainyu mmörëkengera ëkëbhara ikiina, niyekë mötaisaini gökenga ikiina ninyoora nkömang'ana amake? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.2",
            "verseOrgIds": [
              "1CO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë mmötamanyërë iga mbaitö törëkengera abhamaraika ikiina? Nkërengere kë mbe kömang'ana gano gaitungërë irimenya rënö! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.3",
            "verseOrgIds": [
              "1CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mööna amang'ana amake gano ganga gayö, igankë mökögahira köbhantö bhano bhatagösöököa na ëkanisa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.4",
            "verseOrgIds": [
              "1CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkögamba ndë igo korri mbasuukirri. Ngëkaabha öbhöheene iga taaho ömöng'aini ninyoora nu umui öno agatöra koohökania irigamba rëyö gatai ya abhakumia bha moobho? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.5",
            "verseOrgIds": [
              "1CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhaga rëyö umukumia aya guchöngëra öwöndë köbhano bhatarë abhakumia!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.6",
            "verseOrgIds": [
              "1CO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.6",
            "verseOrgIds": [
              "1CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene niiga gikugira ëno muguchöngërana abhiene kubhiene, nkoorokia ërë iga mökërröë. Gösë tëkaabhaayë bhuuya bhökong'u gökorröa bhöbhëëbhë? Gösë tëkaabhaayë bhuuya bhökong'u harë bhainyu kunuurua ibhintö bhienyu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.7",
            "verseOrgIds": [
              "1CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhainyu abhiene moimöka gökorrana bhöbhëëbhë na kunuurana ibhintö, kura ninyoora nköbhantö bhainyu bhano bharëngë abhakumia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.8",
            "verseOrgIds": [
              "1CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë mmötamanyërë iga abhabhëëbhë tëbharinyoora öbhögambi bhöë Ënooköë hai? Monge kuing'aina; gösë abharaaya gösë bhano bhagösengera ibhihooru, gösë abhahurunkani, gösë abhasaacha bhano bhaagökora öbhöraaya na abhasaacha bhandë, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.9",
            "verseOrgIds": [
              "1CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "gösë abhaibhi, gösë abhooyoku, gösë abharebhi, gösë bhano bhagötöka abhandë, gösë abhasakuri taaho öno arësoha köbhögambi bhöë Ënooköë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.10",
            "verseOrgIds": [
              "1CO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamui bhainyu nigo moorëngë, sibhoono moogibhua kurua kuiraga; moosaabhuurua mookoröa abharöngë kuriina riö Ömönene Yesö Kirisitö na Nkoro wë Ënooköë weitö.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.11",
            "verseOrgIds": [
              "1CO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruusia ëmëbhërë geinyu kugira yu ubhuhiku bhöë Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.11",
            "verseOrgIds": [
              "1CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.12",
            "verseOrgIds": [
              "1CO.6.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.23"
              },
              "items": [
                {
                  "text": "1 Ko 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibhintö bhionsui nguitabhirribhua bhirë harë uni,” sibhoono tiiga mbionsui bhiina ubhuëra hai. “Ibhintö bhionsui nguitabhirribhua bhirë harë uni,” sibhoono tëngaakoroa ömögöre na gëntö kërë gionsui hai.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.12",
            "verseOrgIds": [
              "1CO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.12",
            "verseOrgIds": [
              "1CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibhiakörëa ngikugira yë ënda na ënda ngikugira yi ibhiakörea,” sibhoono Ënooköë naribhisikia bhionsui bhibhërë. Ömöbhërë tëgookorröë gikugira yö öbhöraaya hai, sibhoono gikugira yö Ömönene; na Ömönene nkuirigania arë ömöbhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.13",
            "verseOrgIds": [
              "1CO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë naariuukiri Ömönene kurua kuruku, na guiki narituriuukia köhetera guchinguru chaae. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.14",
            "verseOrgIds": [
              "1CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëmömanyërë iga ëmëbhërë geinyu ni ibhiimo bhiö ömöbhërë go Kirisitö hai? Bhoono guiki niimuki ikiimo kiö ömöbhërë go Kirisitö na ngëkore këbhe ikiimo kiö ömöbhërë gu umuhurunkani? Tëkëraabhe igo röndë hai! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.15",
            "verseOrgIds": [
              "1CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Ögt 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gösë mmötamanyërë iga ömöntö öno agotaini na ömöbhërë gu umuhurunkani këmöbhëre, nkunyoora arë nabhaayë ömöbhërë gumui nawe? Ërendëko nkögamba rërë harabhu iga, “Abhabhërë bhayö mbaraabhe ömöbhërë gumui.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.16",
            "verseOrgIds": [
              "1CO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono öno agotaini umuene harë Ömönene öyö këbhönkoro nköbha arë umui hamui nawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.17",
            "verseOrgIds": [
              "1CO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.17",
            "verseOrgIds": [
              "1CO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möng'ose öbhöraaya. Iriraga rërë rionsui rëno ömöntö agökora nkëbhara yö ömöbhërë; sibhoono ömöntö öno agökora öbhöraaya nkunyoora arë nö ömöbhërë gooe agökorra iriraga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.18",
            "verseOrgIds": [
              "1CO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.16"
              },
              "items": [
                {
                  "text": "1 Ko 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Ko 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tëmömanyërë iga ëmëbhërë geinyu ngio ëhekaru ya Nkoro Nhoreeru öno amenyërë mönsë yeinyu, nawe nëwe moohaayöë na Ënooköë, na guiki iga tëmörëngë bhainyu bhiene hai? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.19",
            "verseOrgIds": [
              "1CO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira mmoogörröë kuiguri, köhayö niiga möhe Ënooköë ubhuhiku kömëbhërë geinyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.20",
            "verseOrgIds": [
              "1CO.6.20"
            ]
          }
        }
      ]
    }
  ],
