              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öno agökanya iga mbuuya aimëërëëyë aimaahërre bhökong'u atakaagöa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.12",
            "verseOrgIds": [
              "1CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yut 8:25-27; Sir 15:11-20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irisaacho rërë rionsui rëno rebhanyoora në ëre ruiso ronsui köbhantö. Öbhöheene niiga, Ënooköë nö ömöheene, taakabhatiga mösaachöe köhëtëëra hano mötaatöre kugumirria; sibhoono nkaaga irisaacho rërabhaachëre, naraabhahe ichinguru cha kugumirria irisaacho rëyö hamui na köbhoorokia ënchëra ya kurichokera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.13",
            "verseOrgIds": [
              "1CO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
