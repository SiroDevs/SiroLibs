            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibhintö bhionsui nguitabhirribhua bhirë,” sibhoono tiiga iga bhionsui mbiina ubhuëra hai. “Ibhintö bhionsui nguitabhirribhua bhire,” sibhoono tiiga mbionsui bhiköhagaacha ömöntö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö ange kuya araitönëra ëgëntö kiu ubhuëra harë we umuene, sibhoono atune këno këëna ubhuëra köwöndë.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        }
      ]
