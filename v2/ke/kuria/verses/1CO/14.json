{
  "id": "1CO.14",
  "number": "14",
  "bookId": "1CO",
  "reference": "1 Abhakorinto 14",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1CO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhihaano bhindë kurua harë Nkoro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutune köbha nö öbhöhanchi, guiki möbhe na ömökëa go kunyoora ibhintö bhia Nkoro, na ëkënene bhökong'u në ëkëhaano ge körëa ënaabhi: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.1",
            "verseOrgIds": [
              "1CO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira öno agusumaacha kubhigambo tukunyoora iga na abhantö agusumaacha nabho hai, nkunyoora arë në Ënooköë agusumaacha nawe, gikugira tëmöntö akömöngöra hai; ngusumaacha arë ibhibhisërë bhë Ënooköë bhino bhiahönyöröa guchinguru cha Nkoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.2",
            "verseOrgIds": [
              "1CO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono öno akörëa ënaabhi, na abhantö nkunyoora arasumaacha nabho gököbhatuurirria, arabhahonia na arabhatirimikia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.3",
            "verseOrgIds": [
              "1CO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öno agusumaacha ibhigambo nu umuene nkunyoora araihagaacha, sibhoono öno akörëa ënaabhi në ëkanisa yonsui akunyoora arahagaacha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.4",
            "verseOrgIds": [
              "1CO.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nënkahanchërë iga bhainyu bhonsui musumaache kubhigambo; sibhoono gökëra ëyö bhökong'u nënkahanchërë möre ënaabhi. Kugira ömöntö öno akörëa ënaabhi nu uwu ubhuëra öbhönene gökëra öno agusumaacha kubhigambo gëtatiga nyoore aho öno agakonora gano akögamba, korri iga ëkanisa yonsui ëhagaachöe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.5",
            "verseOrgIds": [
              "1CO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö bhantö bhaitö, hano ndaache harë bhainyu ndasumaacha kubhigambo nkë kiu ubhuëra ndanyoore ndaköra? Gëtatiga hano ndanyoore mbarenteeyë amamaaho, gösë ubhunguri nyabhörebhe, gösë öbhönaabhi gösë iriigiö nyabhörebhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.6",
            "verseOrgIds": [
              "1CO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo kërë ninyoora nkubhintö bhino bhitaana öbhöhoru, bhino bhikuruusia ëmëbhari, kugituubhaniö ëkërongöë gösë ëkënande. Hano ndanyoore bhitaahönchööyë ëmëbhari, niyekë möröngöre iga mmöbhari kë gögötemöa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.7",
            "verseOrgIds": [
              "1CO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë hano ndanyoore ömögambia wi irirongöë atarëgambiri kebhörë rëkögambibhua gönkaaga yi iriihi, ning'ui araamanye iga iriihi rihikërë amanöre? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.8",
            "verseOrgIds": [
              "1CO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo bheene na bhainyu, hano ndanyoore mötaayi möragamba kuminyua amang'ana göngöke kërë mökögamba niyekë këraakore kiöngöke? Amang'ana gaao ngarasërre kömökama! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.9",
            "verseOrgIds": [
              "1CO.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhigambo ni ibhiaaru bhiiho gökëbhara, si tëkëëho këno gëtaaana ësësöro hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.10",
            "verseOrgIds": [
              "1CO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore ntamanyërë ëkëgambo këno kigusumaachöa, ömöntö öno akugisumaacha naraabhe ömögeni harë uni na uni nëndaabhe ömögeni harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.11",
            "verseOrgIds": [
              "1CO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo bheene na bhainyu kugira mmööna ëgooriö iga munyoore ibhihaano bhia Nkoro, kuhika mösaache bhökong'u iga möbhe nabhio korri bhituurri köhagaacha ëkanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.12",
            "verseOrgIds": [
              "1CO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öno agusumaacha kubhigambo, niiga asabhe korri iga anyoore ëkëhaano ke gökonora kërë këgambëröe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.13",
            "verseOrgIds": [
              "1CO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira hano nasabhucha gökëgambo në ënkoro yaane nkunyoora ërasabha, si amaitegeerro gaane tukunyoora gaana mörëmö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.14",
            "verseOrgIds": [
              "1CO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono mbe niyekë ndakore? Ho hayö nëndasaasaame na ënkoro yaane, guiki nëndasaasaame na amaitegeerro gaane; nëndasiringi na ënkoro yaane na guiki nëndasiringi na amaitegeerro gaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.15",
            "verseOrgIds": [
              "1CO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore öraruusia umukumo kö Ënooköë gönkoro, niyekë ömöntö wöndë araakore agambe iga, “Amina” kömasabhi gaao gu umukumo? Taana nchëra araakore amanye nkë ökögamba hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.16",
            "verseOrgIds": [
              "1CO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasabbhi gaao gö umukumo ngakaabha maiya sibhoono niyekë garaakore gatuurri ömöntö wöndë?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.17",
            "verseOrgIds": [
              "1CO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkuruusia ndë umukumo kö Ënooköë iga ngusumaacha ndë kubhigambo bhökong'u gökëra örë wonsui harë bhainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.18",
            "verseOrgIds": [
              "1CO.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono gökanisa ngisaini iga ngambe amang'ana ataano gano gaköngöröa, korri iga niigi abhandë, gökëra hano ndagambe amang'ana ibhiköë ikumi kubhigambo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.19",
            "verseOrgIds": [
              "1CO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö monge köbha kia abhaana kömaitegeerro gainyu. Igörö ya amanyanku möbhe kia abhaana abhang'eerre sibhoono kömaitegeerro gainyu möbhe abhantö bhakörö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.20",
            "verseOrgIds": [
              "1CO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.11"
              },
              "items": [
                {
                  "text": "Isa 28:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kumigiro yaandëkëröë iga, “Ömönene aragamba iga, ‘Gönchëra ya abhantö bhano bhagusumaacha kubhigambo nëndasumaache na abhantö bhaane. Nëndasumaache gököhetera kuminyua gia abhahamatë, sibhoono ninyoora nigo abhantö bhaane tëbharinyigua hai.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.21",
            "verseOrgIds": [
              "1CO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe ëkëhaano ke gusumaacha ibhigambo në ëkëmanyiirriö tikugira ya bhaara bhaakumia hai, gëtatiga nkö bhaara bhatarakumia. Na ëkëhaano ge kuruusia öbhönaabhi në ëkëmanyiirriö tikugira ya bhaara bhatarakumia hai gëtatiga ngikugira ya abhakumia.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.22",
            "verseOrgIds": [
              "1CO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano mbe wanyoora ëkanisa yonsui iraini hamui, sooki bhonsui bhatange gusumaacha kubhigambo – na hano abhantö bhandë igo gösë bhano bhatarë abhakumia bharasohe, tëbharagambe iga bhonsui nabhachuuru mörë?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.23",
            "verseOrgIds": [
              "1CO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano bhonsui bharaare ënaabhi, na ömöntö umui, öno atarakumia gösë ömöntö wöndë igo, araasohe, kögonsui gano araigue ngaramökore amaahe iriraga reee. Narakengeroe ikiina kögano gonsui araigue, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.24",
            "verseOrgIds": [
              "1CO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "amang'ana gi ikibhisërë gö ömooyo gooe ngaratööröe harabhu, na ateme ibhiru, asengere Ënooköë, aratöbhöra iga, “Öbhöheene Ënooköë naarëngë gatai yeinyu!”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhörengerria gökanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.25",
            "verseOrgIds": [
              "1CO.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, niiga iga, hano moosikana hamui gösengera, nyoora öwöndë ana irisingio, na öwöndë amaigiö, öwöndë amamaaho, na öwöndë ana ëng'ana kubhigambo na öwöndë öbhökonori bhui ibhigambo. Amang'ana gonsui niiga gakorekane gököhagaacha ëkanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.26",
            "verseOrgIds": [
              "1CO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore ömöntö arasumaacha kubhigambo, mbuuya bhasumaache bhabhëre gösë bhatatö si bhatakahëtëëra, na guiki bhakore igo ku umuiumui bharakomerana, hakurua ömöntö wöndë akonore gano bhayö bhagambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.27",
            "verseOrgIds": [
              "1CO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore ömöntö wa gökonora amang'ana gayö taaho hai, ömöntö öyö agusumaacha kubhigambo niiga akire kimui gökanisa, sibhoono aisumaachëre we umuene na Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.28",
            "verseOrgIds": [
              "1CO.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanaabhi bhabhëre gösë bhatatö bhano bhahaayöë öbhönaabhi bhasumaache, sibhoono abhandë, bhaisunche amang'ana gaabho gayö bhakögamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.29",
            "verseOrgIds": [
              "1CO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano öwöndë öno ndanyoore aikaayë kumuiranio aranyoore ëng'ana kurua kö Ënooköë, ööra aarë gusumaacha mbere niiga akire amöhe umueya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.30",
            "verseOrgIds": [
              "1CO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bhonsui mmökaarëa ënaabhi ku umuiumui, korri bhonsui bhiëge na bhonsui bhatirimikibhue. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.31",
            "verseOrgIds": [
              "1CO.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichinkoro cha abhanaabhi kuhika chibhe hansë yö ögötöra köa abhanaabhi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Ënooköë të Ënooköë wa köhamana hai, në Ënooköë wö ömörembe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebhörë ëragërë guchikanisa chonsui cha abhantö abhahoreeru, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhagaikörö niiga bhakire guchikanisa. Tëbhaana umueya go gusumaacha hai; kebhörë umugiro göa Abhayahuti gökögamba, bho niiga bhaiguëre.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore bharatuna kuëga ëng'ana ërë yonsui, niiga bhabhuuri bhasaacha bhaabho ka; kugira në ëng'ana yi ichinsoni ömögaikörö kögamba gökanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë ngökanya mörë iga ëng'ana yë Ënooköë harë bhainyu yaaruurë na guiki iga mbainyu bheene yaachëëyë? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Örë wonsui agökanya iga nö ömönaabhi arëngë gösë iga nö ömöntö wa këbhönkoro, kuhika amanye iga gano nköbhandëkëra në ëngamba yö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore atagötegeerra gano, na bhainyu bhonsui mumuiraamiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö mbe, bhantö bhaitö, möbhe na ëgooriö ya körëa ënaabhi, sibhoono mötagaacha gökaania möntö gusumaacha kubhigambo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö amang'ana gonsui niiga gakoroe gönchëra inchiiya yu ubhusuuki na öbhörengerria.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
      ]
    }
  ],
