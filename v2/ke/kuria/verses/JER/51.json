  "reference": "Yeremia 51",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "JER 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhökengi bhui ikiina bhöndë igörö ya Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisiringiö rë ëgöngo kö Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëkërësa kiö ÖMÖNENE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iribhörööta re Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 51:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.23",
            "verseOrgIds": [
              "JER.51.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nëndabhörööte Bhabheri na abhamenyi bhonsui bha Garitayo möramaaha kömaiso gainyu abhiene, gikugira yu ubhunyanku bhonsui bhönö bhaakorrë harë Sayuni. Uni ÖMÖNENE ngambërë.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ÖMÖNENE naratuurri Isiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëhöbhë ya bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana yë Ënooköë kö Abhasiraeri bhano bharëngë Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögusikibhua köndë ko Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëng'ana ya Yeremia ërahirua Bhabheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JER 51:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JER 51:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go kanai ögö öbhögambi bhhoe, Setekia naagëëyë Bhabheri hamui na ömötangati wa abhasirikare bhaae önö aarë köbhërëkërua iga Seraya ömoona o Neria na ömööchökörö wa Masëya. Gököreng'aana na umueya göyö uni Yeremia nnaahaayë Seraya ëng'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.59",
            "verseOrgIds": [
              "JER.51.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JER 51:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyoora naandëkërë kögëtabhö amabhëëbhë gonsui gano wanyoorrë naarundia igörö ya Bhabheri na guiki amang'ana gandë igörö ya Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.60",
            "verseOrgIds": [
              "JER.51.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JER 51:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaateebhiri Seraya iga, “Hano öraahikë Bhabheri kuhika öbhasomere bhonsui ëng'ana ëno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.61",
            "verseOrgIds": [
              "JER.51.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JER 51:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ösooki na amang'ana ganö iga, ‘Wei ÖMÖNENE, uwe ögambërë iga nörasari ahasë hano kuhika hange kömenyöa na gëteemöa kërë gionsui, ömoona wö ömöntö gösë itiinyi, na iga ënsë ëno nëraabhe iriköngö kuya ëyö.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.62",
            "verseOrgIds": [
              "JER.51.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JER 51:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Öbhö 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano örasooki gösoma ëgëtabhö këno, ökëbhoherre irigëna, hakurua ugichibhigiri gataigatai yö ömooro go Yubhurati, öragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Bhöyö mbo umugi go Bhabheri göraichibhigiri, na tëgökariöka guiki, gikugira ya amabhëëbhë gano ÖMÖNENE akögörentera.’” Amang'ana ga Yeremia gakahëkëra hano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    }
  ],
