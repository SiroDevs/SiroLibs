              "JER.35.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Gam 23:36—24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Ich 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëno yaachëëyë Yeremia ënkaaga yö öbhöbhaahi bho Yehoyakimu ömoona o Yosia, ömögambi o Yuta iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Genda kunyumba ya Abharekabhi, usumaache nabho. Hakurua, öbharente kugisuumua kimui kinyumba yaane uni ÖMÖNENE, öbhahe itibhaai bhanyue.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, nkaimukia Yasania ömoona o Yeremia, ömoona o Habhasinia, na bhaamura omoobho hamui na abhaana bhaae bhonsui na ëgësaku gionsui kia Abharekabhi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkabharenta kunyumba yö ÖMÖNENE, kugisuumua kia abhaana bha Hanani ömoona o Igitaria, ömöntö wë Ënooköë. Igisuumua këyö nkeerëngë hang'i na ömörengo gua abhanene, igörö, yö mörengo go Maaseya ömoona o Sarumu, umuriihi wö mörengo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkarenta ibhikombe na amabhakuri gano gaichööyë itibhaai mbere ya Abharekabhi bhayö, nkabhateebhia iga, “Mötanyua itibhaai.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bho bhakahunchukia iga, “Bhaitö tituukunyua itibhaai, kugira Yonatabhu ömoona o Rekabhi, ömögaaka weitö, naaturuusiyi ëngamba iga, ‘Mötakaanyua itibhaai; mötakaanyua bhainyu abhiene göse abhaana bhainyu kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötakahagaacha inyumba, mötakaarëma mëgöndö, na mötakaabha na mögöndö go mësabhibhu. Sibhoono mmöraamenye kömagutu nsikö chonsui cha amabhaho gainyu, korri mötöre kömenya nsikö ncheru gönsë ëno mömenyërë kia abhageni.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsikö chonsui bhaitö tosööka ëngamba ëyö yö ömögaaka weitö Yonatabhu ömoona o Rekabhi, igörö yë ëng'ana ëno aatögambëëyë. Bhaitö abhiene tituukunyua itibhaai; gösë abhakari bhaitö, abhaana bhaitö bhë gësaacha göse abhë ëkëgaikörö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö titukuihagaachëra ichinyumba cha kömenya hai. Tëtööna mëgöndö ge mësabhiibhu gösë mëgöndö ge kuimia ntentere hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö tomenya kömagutu na gösööka amang'ana gonsui gano Yonatabhu, ömögaaka weitö aatögambëëyë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano Nebhugatinesa, ömögambi o Bhabheri aahikërë guitania ënsë ëno, ntokengërë ikiina guucha Yerusaremu korri tuibhechi iricheesi ria Abhagaritayo na iria Abhaasuru. Köhayö bhoono ntömenyërë kumugi Yerusaremu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ëng'ana yö ÖMÖNENE ëgaachëra Yeremia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni ÖMÖNENE wa amacheesi, Ënooköë wa Isiraeri, ndagamba iga, Taya öteebhi abhantö bha Yuta na abhamenyi bha Yerusaremu iga, Gosë bhainyu mögaatöra kögoota amaigiö na kuigua amang'ana gaane? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëngamba ëëra Yonatabhu ömoona o Rekabhi, ahaayë abhaana bhaae, iga bhatakaanyua itibhaai ihutëröë; nabho tëbhaakunyua itibhaai kuhika reero, kugira bhaasööka ëngamba ya ömögaaka waabho. Sibhoono uni nnaasumaachërë na bhainyu harë kaaru na bhainyu tëmontegerreeyë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabhahereeyë harë kaaru abhakoramërëmo bhaane bhonsui iga abhanaabhi bhabhateebhi këra umui weinyu atigane na örögendo rooe urunyanku, akörönge amakora gaae atige gösoorana na gökorra ichinooköë chindë. Na iga hano möraakore igo mmöraamenye gönsë ëno naabhahaayë bhainyu na bhaguuka bhainyu. Sibhoono bhainyu tëmontegekiiyi gutui gösë göntegeerra hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Yonatabhu ömoona o Rekabhi, bhagootërë ëngamba ëno bhaahaayöë na ömögaaka wabho; sibhoono bhainyu tëmonsökërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, uni ÖMÖNENE Ënooköë wa amacheesi, Ënooköë wa Isiraeri, ndagamba iga, Ndarentera abhantö bha Yuta na abhamenyi bhonsui bha Yerusaremu amanyanku gonsui gano naagamba köbhaisiira gikugira uni nnaasumaachërë nabho, sibhoono tëbhaanyiguërëëyë; nnaabhabhërëkëëyë, sibhoono tëbhaanyitabhëëyë hai.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Yeremia naateebhiri Abharekabhi iga, ÖMÖNENE wa amacheesi Ënooköë wa Isiraeri aragamba iga, “Bhainyu Abharekabhi mosööka ëngamba yö ömögaaka weinyu, mökagoota amaragirriö gaae gonsui na gökora keebhörë aabhagambëëyë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö uni ÖMÖNENE wa amacheesi Ënooköë wa Isiraeri, ndagamba iga Yonatabhu ömoona o Rekabhi tarëbhöre ninyoora ndimui umuibhörröa wa gönkorra ëmërëmo nsikö chonsui.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
