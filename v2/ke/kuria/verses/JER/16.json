        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irigonche riö ÖMÖNENE kuimenya re Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe töraatete gösë köbha na abhaana köhasë hano hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira uni ÖMÖNENE ndagamba igörö ya abhaana bhë gësaacha na abhë ëkëgaikörö bhano bharaibhörröe ahasë hano, na igörö ya abhaibhuri bhaabho iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbarakue kömarooyi amabhëëbhë, na taaho öno arëbhaköörra gösë köbhatökëra hai. Ibhihundugu bhiabho mbiranyeregane këgörö yi irirobha kia amabhi. Mbarasike gunchonge na gunchara; na ibhihundugu bhiabho mbiraabhe ibhiakörëa bhi ibhinyunyi bhia kuriöbha na ichitiinyi ichinchuuru cha ibhara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kugira uni ÖMÖNENE ndagamba iga, Uriihe ötagaacha gösoha kunyumba ëno ikuërëëyöë gösë köbhang'uuyëra na köbhaköörra. Kugira naaruusia ho ömörembe, öbhöhanchi öbhögöme bhoone na amaabhë gaane kurua köbhantö bhano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui, abhanene na abhake, mbaraakue gönsë ëno; nabho tëbharatökëröe na taaho öno arabhang'uunyëre. Taaho öno araikebhekebhe gösë kugingira öröhara ro gukuëröa hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taaho öno arëhonia ömöntö öno akuërëëyöë gösë gösanga ibhiakörëa bhia kumutirimikia, gösë ësataaka yi ikinyuëbhöa gikugira ya gukuëröa na isawaabho gösë nyaköaabho.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ötagaacha gösoha kunyumba ëno ëgökora ësögökörö. Ötagaacha guikara na köraagëra hamui nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer 7:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.10"
              },
              "items": [
                {
                  "text": "25:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.23"
              },
              "items": [
                {
                  "text": "Öbhö 18:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira uni ÖMÖNENE wa amacheesi, Ënooköë wa Isiraeri ndagamba iga, Nëndabhutukirri kimui ichingamba chëmëgooko na ichibhiririato, hamui na ichingamba chö ömöteti na ömöreekari. Gonsui gano nëndagakore gëtonooni mökëërëngë bhahoru möramaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na uwe hano örëteebhia abhantö bhayö amang'ana gano gonsui, bho mbarakubhuuria iga, igankë ÖMÖNENE agambërë ubhunyanku öbhönene bhöno gutuisiira? ‘Ni isaria kë tokora? Ni iriraga kë tokorra ÖMÖNENE, Ënooköë weitö?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na uwe nörabhahunchukiri iga, uni ÖMÖNENE ndagamba iga, Bhaaguuka bhainyu mbaantigërë, bhagasoorana ichinooköë chindë, bhagachikorra ëmërëmo na guchisengera. Mbaantigërë, na bhakanga kuiguëra ninyoora ni imigiro geene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu mokora bhöbhëëbhë bhökong'u gökëra bhaguuka bhainyu, kugira këra umui weinyu aakong'ia ömötöe na köbha na irituno iribhëëbhë, na tëmonyiguërëëyë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, nëndabharugi kurua gönsë ëno kuya gönsë ëno bhainyu abhiene gösë bhaguuka bhainyu bhataamanyërë. Harë mörëkorra ichinooköë chindë ëmërëmo ubhutikö na ömöbhasö, na tëndëbhatuurria hai.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukuringa kurua köng'aanyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö ichinsikö chiraacha, ndagamba uni ÖMÖNENE chino abhantö bhatarituenerria guiki bharagamba iga, ‘Keebhörë ÖMÖNENE amenyërë, öno aruusiri abhantö bha Isiraeri gönsë ya Misiri,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga mbaarituenerria iga, ‘Keebhörë ÖMÖNENE amenyërë öno aruusiri Abhaisiraeri gönsë ya Mööchë na göchinsë chonsui chino aabharugiri kuya!’ Kugira, nëndëbharingia gönsë yaabho ëno naahaayë bhaguuka bhaabho.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iribhörööta rëno riguucha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, “Tamaaha, nëndabhërëkëre abhahömaani abhaaru bhaache kögoota abhantö bhano. Hakurua mbërëkëre abhaguimi abhaaru bhano bharabhaguëma këra nguku, këra gëkerege na kömasana ga amarëngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira, uni nkömaaha ndë amakora gaabho gonsui. Tëëho ëno iibhisërë harë uni hai. Amasaria gaabho gonsui mbörabhu garë mbere yaane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.17",
            "verseOrgIds": [
              "JER.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndahakane igisiomba harë kabhërë gikugira ya amaraga na amasaria gaabho kugira bhatööra ënsë yaane ibhikui kubhihundugu bhi ichinooköë chaabho cha kuriirria, na guichuria öbhöregi bhoobho.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisabhi re Yeremia kö ÖMÖNENE kubhutirimiku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö,” ÖMÖNENE aragamba iga, gönkaaga ëno nëndabhaigi bhamanye bhörabhu ichinguru chaane na ögötöra koone, nabho mbaramanye iga iriina reene nö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    }
  ],
