              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana ëno ÖMÖNENE aateebhiri ömönaabhi Yeremia ënkaaga ëno Nebhugatinesa ömögambi o Bhabheri aachërë guitania Misiri iga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
