            {
              "text": "Ese 29:1—32:32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igörö ya Misiri na iricheesi re Bharao Neko, ömögambi o Misiri, rëno reerëngë Karikemisi haara hang'i na ömooro go Yubhurati, rëno Nebhugatinesa ömögambi o Bhabheri aitaini kömooka go kanai gö öbhögambi Yehoyakimu ömoona o Yosia, ömögambi o Yuta:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
