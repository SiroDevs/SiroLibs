{
  "id": "JER.42",
  "number": "42",
  "bookId": "JER",
  "reference": "Yeremia 42",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
