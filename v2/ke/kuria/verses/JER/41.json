            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.25"
              },
              "items": [
                {
                  "text": "2 Gam 25:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumueri go muhungatë Isumaeri ömoona o Netania, ömööchökörö o Erisama, öwë ëka yö öbhögambi, umui wa abhatangati abhanene bhö ömögambi, naahikërë Misibha harë Getaria atögëkaini na abhantö ikumi. Nkaaga bhaarë köraagëra Misibha hayö, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isumaeri ömoona o Netania hamui na abhantö ikumi bhaara, bhakaimöka na inchonge guitania Getaria ömoona o Ahikamu, ömööchökörö o Sabhani, bhakamuita. Getaria nëwe waanyoorrë aahöröa na, ömögambi o Bhabheri köbha ömögabhana wë ënsë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, Isumaeri agaita Abhayahuti bhonsui bhano bhaarëngë hamui na Getaria göntahana ya Misibha na abhaanacheesi Abhagaritayo bhano bhaarëngë ahasë hayö.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö rumui hano bhaaisërë guita Getaria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "möntö örë wonsui ataraamanya amang'ana gayö, abhantö mërongo ënanai gukurua Sekemu, Siro na Samaria mbaahikërë. Wanyoorrë bhagingiiyë ichinka chaabho na bhasohiri amatati gano gaatandöka na ëmëbhërë geebho getaröataröa. Mbaarentërë ibhiruusiö bhi bhiakörëa na öbhöbhaani bhiruusibhue köhekaru harë ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isumaeri ömoona o Netania, naarichokërë këbhara yu mugi guturuung'ana abhantö bhayö na hano arakuura. Hano aasikaini nabho, akabhateebhia iga, “Tasoha o Getaria ömoona o Ahikamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaasohërë kumugi, Isumaeri ömoona o Netania hamui na abhantö ikumi bhaara bhaarëngë hamui nawe, mbaitërë abhantö bhayö na götabhuta ibhihundugu bhiabho kugisima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono mbaarëngë ho abhantö ikumi guikomo rëyö bhano bhaateebhiri Isumaeri iga, “Törakögeya wange gutuita kugira ntööna ëmongo incharu yë ëngano, ësayiri, amaguta na öbhöökë bhino tubhisërë kömëgöndö.” Köhayö akabhatiga bhahoru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igisima këno Isumaeri aarekeeyë ibhihundugu bhia abhantö bhaara aaitërë në ëkënene këëra, këno Ömögambi Asa waanyoorrë aatuka korri aibhise guisiira Baasa, ömögambi wa Abhaisiraeri. Isumaeri ömoona o Netania, naichuuyi igisima këyö ibhihundugu bhia abhantö bhaara aitërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, Isumaeri akabhaimukia ubhunyambu abhasubhaati bhö ömögambi na abhantö bhonsui bhano bhaatamërë Misibha, abhantö bhano Nebhusaratani, ömökabhuteni wa abhariihi waanyoorrë ahaayë Getaria ömoona o Ahikamu. Isumaeri ömoona o Netania, naaimukiri bhayö abhanyambu, agatanöra akaya kö Abhaamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Yohanani ömoona o Karea, hamui na abhatangati bhonsui bha amacheesi, hano bhaiguurë igörö yu ubhunyanku bhöno Isumaeri ömoona o Netania, waanyoorrë akorrrë, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaakömërë abhantö bhaabho bhonsui, bhakaya guitana na Isumaeri. Mbaamuyoorrë kuirambö irinene rëno rërëngë Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano bhaimukiibhui ubhunyambu na Isumaeri hano bhaarööchë Yohanani ömoona o Karea, hamui na abhatangati bhonsui bha amacheesi, mbaagookërë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, abhantö bhayö bhonsui bhano wanyoorrë Isumaeri aimukiri ubhunyambu kurua Misibha, mbaihönchööyë, bhakaringa nyuma, bhakagëëra Yohanani ömoona o Karea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Isumaeri ömoona o Netania, hamui na abhantö bhanaanai mbaatërrökërë kurua harë Yohanani, bhakang'osera kö Abhaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yohanani ömoona o Karea hamui na abhatangati bhonsui bha amacheesi bhano bhaarëngë hamui nawe, mbaimukiri abhantö bhonsui bhano bhaatamërë, bhano Isumaeri ömoona o Netania waanyoorrë aimukiri abhanyambu kurua Misibha hano aasookiri guita Getaria ömoona o Ahikamu, iga, Abhasirikare, abhagaikörö, abhaana na ichinture. Yohanani naabharingiri bhonsui kurua Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, bhakaya bhoobho, bhagaikara Geruti Kimahamu, hang'i na Bheterehemu, bhatönërë gösoha gönsë ya Misiri, gikugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaarëngë koobhoha Abhagaritayo kurua ënkaaga ëno Isumaeri ömoona o Netania, aitërë Getaria ömoona o Ahikamu öno ömögambi o Bhabheri wanyoorrë aahöra köbha ömöbhaahi wë ënsë.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
