              },
              "items": [
                {
                  "text": "1 Ich 17:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira uni ÖMÖNENE ndagamba iga, Tauti taarëbhöra ömöntö öno arëbhaaha Isiraeri hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
