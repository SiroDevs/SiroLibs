        {
          "text": "Ëng'ana yö ÖMÖNENE ëgaachëra Yeremia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ke bhööra mötaagatöra köhönchöra imuuma yaane ëno naatöörrë igörö yu ubhutikö na ömöbhasö iga bhiange köbha ke bhööra naaseemiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhöyö bheene mbo mötagaatöra köhöchöra imuuma yaane ëno naakorrë na ömökoramërëmo waane Tauti. Nnaakorrë imuuma na Tauti iga naraabhe na umuri wö ömöndö wö öbhögambi bhooe kuya ëyö; bhöyö bheene abhanchaama bhi ikiaro ke Rawi bhano bharankrre ëmërëmo kuya ëyö mbarëbha ho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kehaara ichinyunyuunyi kuriöbha na ömösense kunyancha bhitagaatöra köbharöa, nkeeho ndengeri uruibhöro rö ömökoramërëmo waane hamui na abhanchaama bhu uruibhöro ro Rawi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
