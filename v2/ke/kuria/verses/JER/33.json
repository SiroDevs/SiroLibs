          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, “Kumugi göno mökögamba iga goobha umuchua götaana abhantö gösë itiinyi, igo, kumigi ge Yuta na kömarongatë ga Yerusaremu gano garëngë amachua, gataana abhantö gösë itiinyi, möyö amaseko na ichingamba chë ëmëgooko nchiriigubhua guiki, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
