                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Tan 9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Uni ÖMÖNENE ndagamba iga, Hano ëmeeka mërongo muhungatë gërëheta Bhabheri hayö, nëndëbhaachëra na köhëkëërania ëndagano yaane ya köbharingia ahasë hano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira, uni ÖMÖNENE nëmanyërë amang'ana gano naabhaseemiria. Nabhasemiria amaiya na tëmabhëëbhë, korri möbhe na iriiteng'ero ri ichinsikö chino chiguucha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho mörëmbërëkëra na gönsaasaama, nani nëndëbhategeerra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Ëhë 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Öbh 6:12,13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmurintuna na kunnyoora. Hano murintuna kömooyo gonsui ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mmurinyoora. Nani nëndëbharingiria igisiö keinyu na köbhaköma kurua guchihamatë chonsui na ahasë honsui hano naabharugiri kuya. Nëndëbharingia ahasë hano naabharuusiri, nkabhahira köng'aanyi. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhainyu ngukumia mörë abhanaabhi bhano mökögamba iga ÖMÖNENE abharentera Bhabheri hayö. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötaigua bhörë nkögamba uni ÖMÖNENE igörö yö ömögambi öno aikarëëyë igitumbë kiu ubhuhika ge Tauti, na igörö ya abhantö bhonsui bhano bhamenyërë kumugi göno, na bhamura omoinyu bhano bhaatagëëyë hamui na bhainyu köng'aanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni ÖMÖNENE wa amacheesi ndagamba iga, tamaaha mbarenterriiyi inchonge, inchara na amarooyi amabhëëbhë; nëndabhakore bhabhe kia amakö amabhëëbhë bhökong'u, gano gatakörëëbhöa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndabharondi na inchonge, inchara na amarooyi amabhëëbhë. Nëndabhakore bhabhe ëgëntö ge kuriirria kömagambi gonsui gë ëkëbhara, mböyö, ëgëntö ki imiihiimo, ëseko, ësero na ëgëntö ke gutuumibhua amaiso guchihamatë chonsui chino naabharugiri kuya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndakore igo gikugira tëmoiguurë amang'ana gaane gano naabhateebhiri këra nkaaga köhetara kö abhakoramërëmo bhaane, abhanaabhi, na bhainyu mökanga götegeerra. Uni ÖMÖNENE ngambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu bhonsui bhano naaruusiri kurua Yerusaremu, nkabhahira köng'aanyi Bhabheri, mötategeerra ëng'ana yaane uni ÖMÖNENE.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE wa amacheesi, Ënooköë wa Isiraeri aragamba iga igörö ya Ahabhu ömoona o Koraya, na igörö ya Setekia ömoona o Maseya, bhano bhaaköbhanyeera ënaabhi ëndongo kuriina reee: “Nendabhatööre kömabhoko ga Nebhugatinesa, ömögambi o Bhabheri, nawe narabhaite möramaaha na amaiso gainyu abhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira yë ëng'ana ëyö ërëbhanyoora, abhantö bhonsui bhano bhaang'anyiriibhui Bhabheri kurua Yerusaremu mbarëtömëra ëngamba ëyö ya kuihiima iga, ÖMÖNENE agökore ge Setekia na Ahabhu, bhano ömögambi o Bhabheri aasambërë kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibhune niiga mbaakorrë amang'ana gi ichinsoni Isiraeri. Mbaahurunkaini na abhakari bha abhanyaröbheri bhaabho, na kögamba amang'ana gö öbhörongo kuriina reene, ëng'ana ëno uni ntaabhateebhiri iga bhagëkore. Uni nëmanyërë gayö; nagaherekia. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inyarubha ya Semaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
