                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Ich 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëno ni inyarubha ëno ömönaabhi Yeremia aatömërë kurua Yerusaremu kuya köbhagaaka, abhanchaama, abhanaabhi na abhantö bhano Nebhugatinesa wanyoorrë aimukia kurua Yerusaremu akabhahira köng'aanyi Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia naandëkërë inyarubha ëyö nkaaga Ömögambi Yekonia na ömögaikörö ömögambi, ichinture, abhanene bha Yuta na Yerusaremu, abhahundi na abhaturi götanöra kurua Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyarubhai ëno yaahirruë na Erasa ömoona wa Sabhani, na Gemaria ömoona o Hirikia, bhano Setekia, ömögambi o Yuta, aatömërë harë Nebhugatinesa ömögambi o Bhabheri. Yeremia nandëkërë iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ÖMÖNENE wa amacheesi, Ënooköë wa Isiraeri, aragamba iga igörö ya abhanyambu bhonsui bhano aatigërë bhaimukibhui kurua Yerusaremu kuya Bhabheri: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Mötahagaacha ichinyumba mömenye. Mötarëma ëmëgöndö, mubhusure na körëa ibhiakörëa bhiagio. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötateta abhakari, muibhöre abhaana; mötatetia abhamura na abhaisëkë bhainyu nabho bhaibhöre. Mötaiyengeria, na monge gusuuha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mötakora amagenderriö gu umugi göno nabhang'anyia kuya. Mötansaasaama gikugira yu umugi göno, kugira kömësaraaro geego bhainyu mmörasaraare. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni ÖMÖNENE wa amacheesi, Ënooköë wa Isiraeri ndagamba iga, monge guitabhirria köng'ainua na abhanaabhi bhainyu na abharaguri bhano bharëngë gatai yeinyu, na monge götegeerra ibhirooto bhino bhaköroota. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nköbhanyeera bharë ënaabhi yö öbhörongo kuriina reene. Uni tënaabhatömërë hai. Uni ÖMÖNENE ngambërë.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
