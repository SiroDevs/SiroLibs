              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kehaara bheene naarenteeyë abhantö bhano ëhöbhë, nkeeho ndëbharentera amaiya gano naabharagaini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amarëma ngarëgöröa gönsë ëno ökögamba iga, yaabha inchua ëtaana abhantö gösë ichitiinyi, na iga yahaanöa kö Abhagaritayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö mbarëgöra amarëma guchimbiria, bhatööre ibhiara guchinyarubha cha kögameria, bhachitööre ëmëbhaaso, na götööra abhaherekia gönsë ya Bhenchamini, ichintahana chino chiharrë Yerusaremu kumigi ge Yuta, kumigi gë ënsë yi ichinguku, na kumigi ge Sebhari, na kumigi gi iriköngö re Negebhu. Kugira nëndëbharingiria ëgaareeya guiki. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
  ],
