                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Ich 36:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Hano ökahancha, ötösabhëra kö ÖMÖNENE kugira Nebhugatinesa, ömögambi o Bhabheri, aratanga iriihi gutuisiira. Nkaanyoora ÖMÖNENE agatökorra ëkërögööro kehaara agökora këra nkaaga na kuhumbirria Nebhugatinesa atutige na kuya harë akuya.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia akabhateebhia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taya möteebhi Setekia iga, niiga ÖMÖNENE, Ënooköë wa Isiraeri akögamba: “Setekia! Nëndaköhönchörre uwe umuene ibhiögë bhino uguitaniria ömögambi o Bhabheri na Abhagaritayo bhano bhabhanaarri këbhara yu urugito ru umugi. Nëndaaköme ibhiögë bhionsui gataigatai yu umugi göno. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni umuene nëndaguitani gököbhoko koone köno körambööyë na uguichinguru, köbhörrö öbhönene na ëmërëërro ëmënene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndaite abhamenyi bhu umugi göno: Abhaana bha abhantö na ichitiinyi. Mbarakue kömarooyi amabhëëbhë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni ÖMÖNENE ndagamba iga, hakurua uwe Setekia ömögambi o Yuta, abhakoramërëmo bhaao na abhantö bhu umugi göno bhano mörahonibhui na amarooyi amabhëëbhë gayö hamui na iriihi na inchara, nëndabhatööre gököbhöko ko Nebhugatinesa ömögambi o Bhabheri na köbhabhisa bhainyu bhano bhaköbhaguëma. Nebhugatinesa narabhaite gunchonge na tarabhamaahëre maabhë gösë köbhatiga gösë köbhaabhëra. ÖMÖNENE ngambërë.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na uwe Yeremia nörateebhi abhantö bhano iga uni ÖMÖNENE ndagamba iga, Mötategeerra! Uni ndabhaha umueya go koohöra irikuuri riö öbhöhoru gösë irikuuri riu uruku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öno araatame kumugi göno naraitue gunchonge gösë na inchara gösë namarooyi amabhëëbhë. Sibhoono ömöntö öno ararichoke këbhara yu umugi na kuihaana kö Bhakaritayo bhano bhanaarri umugi, narahone; Igo narahoni amabhaho gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkengërë ikiina ge körentera umugi göno amabhëëbhë na tamaaiya hai, ndagamba uni ÖMÖNENE. Nëndagötööre kömabhoko gö ömögambi o Bhabheri, nawe naragösambërëërre na ömörro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökengeröa ikiina kuinyumba ënköraano ya Yuta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nörateebhi ëka yö ömögambi o Yuta iga, Mötaigua ëng'ana yö ÖMONENE, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu ëka ya Tauti! Uni ÖMÖNENE ndagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    }
  ],
