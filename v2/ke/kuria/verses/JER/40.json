      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Getaria ömögabhana o Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
