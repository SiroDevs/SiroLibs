            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.22+2KI.25.23+2KI.25.24"
              },
              "items": [
                {
                  "text": "2 Gam 25:22-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhatangati bhonsui bha amacheesi kurua chunuuchi hamui na abhantö bhaabho, bhaiguurë iga, ömögambi o Bhabheri aahööyë Getaria ömoona o Ahikamu, köbha ömögabhana wë ënsë, na iga amöhaayë abhasaacha, abhagaikörö na abhaana, nko kögamba iga abhantö abhatobhu kimui gönsë bhano bhataimukiibhui kuya köng'aanyi Bhabheri, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbaagërëëyë Getaria Misibha hayö. Abhantö bhayö mbaabhö Isumaeri ömoona o Netania, Yohanani na Yonatani abhaana bha Karea, Seraya ömoona o Tanumeti, abhaana bha Ebhai kurua Netobha, na Yesania ömoona o Magati; bhonsui bhakahinania na abhantö bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Getaria naatuenerreeyi mbere yaabho na mbere ya amacheesi gaabho aragamba iga, “Monge koobhoha gökorra Abhagaritayo ëmërëmo. Mötamenya gönsë mökorre ömögambi o Bhabheri ëmërëmo, na amang'ana gonsui ngarabhagëëre bhuuya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni nëndamenye Misibha mbaikëngëre bhainyu kö Bhagaritayo bhano bharahike weitö; sibhoono bhainyu mötairia na köbhëëka itibhaai, amakö gë ëmaaö na amaguta, mömenye kumigi gëno mukuigaria.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, Abhayahuti bhano bhaarëngë gönsë ya Moabhu na kö Abhaamoni na gönsë ya Etomu na ichinsë chindë, hano bhaaiguurë iga ömögambi o Bhabheri waanyoorrë aitabhirriyi abhantö bhandë bha Yuta götama Yuta na iga wanyoorrë atöörrë Getaria ömoona o Ahikamu, ömööchökörö o Sabhani, köbha ömögabhana waabho, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhayahuti bhonsui mbaaringërë kurua ahasë honsui harë wanyoorrë bhaanyeregana na kuya gönsë ya Yuta harë Getaria Misibha hayö. Mbaairri itibhaai na amakö gë ëmaaö köbhooru bhökong'u.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Getaria araitua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Yohanani ömoona o Karea hamui na abhatangati bhonsui bha amacheesi kurua chunuuchi, mbaahikërë harë Getaria Misibha hayö, bhakamöteebhia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gösë öraamanya iga Bhaari ömögambi wa Abhaamoni, aatömërë Isumaeri ömoona o Netania iga, aguite?” Sibhoono Getaria ömoona o Ahikamu, takumiri amang'ana gaabho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, Yohanani ömoona o Karea, agasumaacha na Getaria gukibhisërë Misibha hayö, akamöteebhia iga, “Tiga niyi guita Isumaeri ömoona o Netania, na tëmöntö örë wonsui aramanye. Igankë we aguite, na abhantö bhonsui bha Yuta bhano bhairania hano bhanyeregane na Abhayahuti bhano bhaatama bhasike?” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Getaria ömoona o Ahikamu, agateebhia Yohanani ömoona o Karea iga, “Ötagaakora ëng'ana ëyö! Amang'ana gano ökögamba igörö ya Isumaeri tagöbhöheene hai.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
  ],
