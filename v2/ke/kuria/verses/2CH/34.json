                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Yer 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia naarë na ëmeeka ënaanai hano ataangërë öbhögambi, akagambëra ëmeeka mërongo ëtatö na gumui gukurua Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora amaiya mbere yö ÖMÖNENE, naagotërë ichisëëra cha Tauti guuka waabho, na kögoota amarago gö ÖMÖNENE kimuikimui.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia arasaria ësengero ya abhabhagaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go kanai go öbhögambi bhooe, ömögambi Yosia, akërëngë ömöhentani, naatangërë gösengera Ënooköë wa Tauti isawaabho. Hakurua hano aahikiri ëmeeka ikumi na ëbhërë naatangërë kuruusia ho ahasë ha gösengera ichinooköë chindë kumigi ge Yuta na Yerusaremu kögösaria ahase hë ësengero aha ichinooköë chindë, ibhihooru bhia Asera, na ibhihooru bhindë bhia köbhaacha na gutura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2 Gam 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Ich 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bhaae mbaatëmööyë irikëngë re amabhaari mbere yaae na agakengakenga irikëngë re köhöchëra öbhöbhaani gano gaatöörröë igörö ya amakëngë gayö; guiki naaminyongo ibhihooru bhia Asera na ibhindë ibhiaköbhachoa na guturua; agachikora köbha urutu, urutu röyö akaröhöma igörö yi ichindua cha bhaara karai bhaagachiruusiiyi ibhiruusio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Gam 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gökëra ya gayö naasambërërrëëyë amaguha ga abhanchaama bhi ichinooköë chiyö guikëngë neecho, bhöyö agasabhuura Yuta na Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora bhöyö bheene kumigi ge Manase, Ebhuraimu, Simeoni na kuhika Nabhutari na komang'anyoa gano gaarëngë mbarëka yi imigi gëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatëmööyë amakëngë na kunyeregania Amaasera na ibhihooru bhia köbhaachöa bhikabha urutu. Bhöyö bheene agakengakenga amakëngë ga köhöchëra öbhöbhaani gönsë yonsui ya Isiraeri. Sooki akaringa Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëgetabhö ki imigiro këratööka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go ikumi na kanaanai gö öbhögambi bhooe, gönkaaga ëno wanyoorrë asookia gösabhuura inyumba na ënsë, naatömërë abhantö bhatatö: Sabhani wa Asaria, Maseya ömögabhana wu umugi na Yoa ömoona o Yoahasi ömoondiki, korri bhayi götaabha inyumba yö ÖMÖNENE, Ënooköë waae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagëëra Hirikia, umunchaama ömonene, bhakamoha amatiini gi ichimbiria chino wanyoorrë chareentöa kunyumba yë Ënooköë chino chëiribhui na Abharawi abhariihi bhë ëgësaku, gukurua Manase, Ebhuraimu na gukurua ichintahana chonsui cha Isiraeri, ënsë yonsui ya Yuta na Bhenchamini, na guiki gukurua köbhamenyi bha Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchaahanëröë köbhahuundi bhaara bhaimërëëyë öbhötaabhi bhui inyumba yö ÖMÖNENE; na abhahundi bhano bhaakorrë kunyumba yö ÖMÖNENE mbachiruusiri korri götaabha na gökora inyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaahaayë abhahoori bhi ichimbaara na abhahagaachi gikugira ya kögöra amagëna gano gaköröngëroë, ichimbaara cha kögootaniria na imitimö ge götaabhëra amahagaacho gano abhagambi bha Yuta bhaatigërë gagatagana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhaara mbaakorrë ëmërëmo gëyö köbhöheene, bhaarëngë hansë yö öbhötangati bhua Abharawi, Yahati na Obhatia, hansë ya abhaana bha Merari na Sekaria Mesuramu, hansë yu uruibhöro ro Kohati. Abharawi bhonsui, bhano bharëngë na öbhöng'aini öbhönene köbhötemi bhui ibhirentirio bhë ëmëbhari, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaimërërrëëyë abhaimukia bhi imirigo na götangata bhonsui bhano bhaakorrë ëmërëmo hagarëhagarë. Abhamui bha Abharawi nabhaigia bhi imigiro mbhaarëngë, abhahobhisa na kurichokia abhariihi bha amahita.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga wanyoore bharairiira na ubhuruusia bhui amatiini gi ichimbiria chino charentëröe kunyumba yö ÖMÖNENE, umunchaama Hirikia naanyoorrë ëgëtabhö ki imigiro giö ÖMÖNENE gëno, geruusibhui köhetera hare Mösa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki Hirikia agateebhia Sabhani ömöng'orong'omi iga, “Nyoorrë ëgëtabhö ki imigiro kunyumba yö ÖMÖNENE.” Hakurua Hirikia akaha Sabhani ëgëtabho këëra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabhani nawe akaheerra ömögambi na kömöha amang'ana, aragamba iga “Gonsui gano Abhakoramërëmo bhaao bhaahaayöë nkögakora bharë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharuusiri amatiini gi ichimbiria chino chaatööka kunyumba yö ÖMÖNENE. Sooki bhachihaanërë köbhaimiriirri na abhahundi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömöng'orong'omi Sabhani agateebhia ömögambi iga, “Umunchaama Hirikia ang'aayë ëgëtabhö.” Sabhani akagësoma mbere yö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögambi aiguure amang'ana gi imigiro naatandööyë ichingëbho chaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho agaambëëyë Hirikia, Ahikaamu ömoona o Sabhani, Abhutoni ömoona o Mika, Sabhani ömöng'orong'omi na Asaya, ömökoramërëmo wö ömögambi aragamba iga, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Taya mutune öbhöragiirria kurua kö ÖMÖNENE kuibhaga reene na abhantö bhano bhaatama Isiraeri na Yuta, igörö ya amang'ana gano gaandëkëröë kögëtabhö këëra kenyorekaini. Gikugira ubhusinanku bho ÖMÖNENE bhötösëkërrëyë, kugira bhaguuka bhaitö tëbhagootërë ëng'ana yö ÖMÖNENE gösë gökora gano gaandëkëröë mo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Hirikia hamui na abhandë bhaara ömögambi aatömërë bhakagëëra ömönaabhi Huruta ömökari wa Sarumu, ömoona o Tohati, ömoona o Hasira, umubhiiki wi ichingëbho chino chaagakorrë ëmërëmo köhekaru (wanyoore namënyërë Yerusaremu gukibhure ge kabhërë); nabho bhagasumacha nawe igörö ya mang'ana gano garichokeeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono akabhateebhia iga, “Bhöno mbo ÖMÖNENE akögamba, Ënooköë wa Isiraeri: Möteebhi öyö abhatömërë harë uni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, ‘Tamaaha nëndarente ubhunyanku igörö ya Yerusaremu na igörö ya abhamenyi bhaago, imiihiimo gionsui gëno geendëkëröë igörö yö ömögambi wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira bhantiga uni na köhöchëra ichinooköë chindë öbhöbhaani korri bhaandiirri bhökong'u kömërëmo gionsui gia amabhoko gaabho, bhoono ubhusinanku bhoone mbörasëkëërre ahase hano na tëbhörarrebheeröe hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono igörö yö ömögambi wa Yuta öno aabhatömërë kurigia öbhöragiirria bhö ÖMÖNENE mömöteebhi iga, Bhöno mbo ÖMÖNENE, Ënooköë wa Isiraeri akögamba igörö ya amang'ana gano wiiguurë: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira wihönchööyë na gususeena mbere yaane, kuhika ötandööyë ichingëbho na gukuura wiiguure amang'ana gaane guisiira ahase hano, na guisiira abhamenyi bhaaho, na guisuseenia mbere yaane, nani guiki nkuiguure. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhörööta rëno ndarentere Yerusaremu, tënkarërënta ökë möhoru hai. Öbhögambi bhooo mbörabhe öbhö ömörembe.’” Bhoono abhahira mang'ana bhakarentera ömögambi Yosia amang'ana gano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia ararea imuuma gösööka Ënooköë.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi Yosia akabhërëkëra na kuiiria abhatangati bhonsui bha Yuta na Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi nawe akaya kunyumba yö ÖMÖNENE hamui na abhasaacha bhonsui bha Yuta na abhamenyi bha Yerusaremu, bhaatangataini na Abhanchaama, Abharawi na abhantö bhandë bhonsui abhanene na abhake. Akabhasomera amang'ana gë ëgëtabhö ki imuuma këno kenyoorröë kunyumba yö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki ömögambi akaimëërra ahasë haae agakora ëndagano mbere yö ÖMÖNENE gösorana ÖMÖNENE, na kögoota amarago, imigiro na amaragiirrio kömooyo gooe gonsui na gönkoro yaae yonsui, gökora amang'ana gonsui gë ëndagano gano gaandëkëröë kögëtabhö këyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki naakorrë bhonsui bhano bhaarëngë Yerusaremu na Bhenchamini kögoota ëndagano. Abhamenyi bha Yerusaremu nabho mbaamenyërë gökögoota ëndagano yë Ënooköë. Ënooköë wa bhaguuka bhaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yosia akaruusia ho ibhihooru bhionsui bhi ibhiriirrio bhino bhiarëngë göntahana yonsui ya abhantö bha Isiraeri, na gusimisiria abhantö bhonsui gökoorra ëmërëmo ÖMÖNENE, Ënooköë waabho. Kömabhaho gaae gonsui tëbhaatigerë ÖMÖNENE, Ënooköë wa bhaguuka bhaabho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
