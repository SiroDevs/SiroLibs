            },
            {
              "text": "Ëbh 28:16—29:39",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Ëhë 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naaruusiri ibhimuenso bhiyö köreng'ana na imigiro ge Mösa ruiso ronsui öröhoreeru, nko kögamba iga: Ësögökörö yë ëmëgaate gëno gëtatöörröë ëmëmera, ichisögökörö chö ögötaachöa kui imieri, na ichisögökörö isatö cha këra ömooka, ësögökörö yë ëmëgaate gëno gëtatörëröë iriogo rië ëmëmera, ësögökörö yi irigesa na ësögökörö ya ibhitume. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gökögoota amaragirrio ga Tauti isawaabho, naaseemiri ichinhuro cha ruiso ronsui cha Abhanchaama na Abharawi bhano bhaaturiiyi kögönga na gökora ëmërëmo geebho. Bhöyö bheene naaseemiri abhariihi bha amahita kömakomo gano atöörrë kuriiha këra ihita; kugira mböyö Tauti, ömöntö wë Ënooköë aagambërë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho tëbhaatigërë amaragiirrio gö ömögambi gano ateebhiri abhanchaama na Abharawi ëng'ana ërë yonsui na igörö yë ëmongo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono ëmërëmo gionsui gëno Suremani aakoorrë gukurua ataangërë öbhörösa bhui inyumba yö ÖMÖNENE gëkahekëërana. Mböyö mbe inyumba yö ÖMÖNENE yaasirre. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Suremani akaya Esioni-gebheri na Eroti imigi gëno gerëëngë kömöndaara gui inyancha, gönsë ya Ëtomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu akamöheerra ichimeeri chino chaarëngë hansë ya abhatangati bhaae, hamui na abhagendia bhi ichimeeri abhaköraano. Bhayö, hamui na abhahobhisa bha Suremani bhakaya kuhika Obhiri, bhakaimukia kurua ho ësahaabhu, bhakarentera Ömögambi Suremani ëkërengere gi ichikiiro ibhiköë ikumi na bhitaano (15,000).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
