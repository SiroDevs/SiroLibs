              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe aasuusenërë mbere yö ÖMÖNENE, kehaara Manase aakoorrë, naagenderreeyi gökora amasaria bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
