          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhakoramërëmo bhaae bhakamörëa inikö bhaakamuitëra kunyumba nköraano yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
