          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ubhuhiku bhöë ÖMÖNENE mboichooyë kunyumba yö ÖMÖNENE, abhanchaama tëbhaatörrë gösoha mo hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
