                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhonsui hano bhaaröchë ömörro göraika kurua kuriöbha na ubhuhiku bhö ÖMÖNENE bhuichuuyi ëhekaru mbaahigamërë amasiö gaabho gakahika hansë, bhagasengera na kögönga ÖMÖNENE bharagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi Suremani na abhantö bhonsui bhakaruusiria ÖMÖNENE ikimuenso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Suremani nawe akaruusiria Ömönene ikimuenso ichintang'ana ibhiköë mërongo ëbhërë na bhibhërë (22,000), na amang'ondi ëkërara kimui na ibhiköë mërongo ëbhërë (120,000). Bhöyö mbo Suremani na abhantö bhonsui bhatöörre inyumba yë Ënooköë harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhanchaama mbaimërëëyë ahasë ahanuhe hano bhatebhibhui kuimëërra, Abharawi nabho mbaimërëëyë bhana ibhirentirio bhë ëmëbhari bhiö ÖMÖNENE, bhino Ömögambi Tauti aakoorrë gikugira ya kuruusia ëgöngo kö ÖMÖNENE. Mbaasiriingiri iga, “Kugira öbhöhanchi öbhögöme bhooe nö öbho kuya ëyö,” Keebhörë Tauti wanyoore abharagirriiyi. Abhanchaama mbaagambiri ibhirëmbëëta na hano Abhaisiraeri bhonsui bhaimërëëyë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ömögambi Suremani agatööra kö Ömönene ëkëgööra këno kerëngë mbere ya inyumba yö ÖMÖNENE, kugira hayö nëho aruusiiyi ikimuenso ke gösambërëërröa na amaguta gi ikimuenso kiö ömörembe, gikugira irikëngë rëëra ri iriche rëno Suremani aahagaachërë tëreisërë kumukia ikimuenso ke gösambërëërröa na ësataaka yi ibhiakörëa na ibhitinya hai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani nawe gönkaaga yi ichinsikö muhungatë naakorrë ësögökörö hamui na umuiranio ömönene gua abhantö bhonsui bha Isiraeri bhano bharuure köbhösohero bho Hamati kuhika kömooro go Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö ro kanaanai mbairaini gökora ësengero inuhe, hano ënkaaga yi ichinsikö muhungatë chino bhaasabhuurre irikëngë, na ichinsikö chindë muhungatë chë ësögökörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röno rorobhëëyë röno rorëngë urusikö rö mërongo ëbhërë na isatö ru umueri go muhungatë, Suremani agateebhia abhantö bhonsui iga bhayi ka mörembe, bharachënga na kögooka guchinkoro chaabho gikugira ya ubhuuya bhö ÖMÖNENE bhöno akoreeyë Tauti na Suremani gikugira ya abhantö bhaae Isiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë araachëra Suremani guiki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ömögambi Suremani naasookiri köhagaacha inyumba yö ÖMÖNENE na inyumba nköraano yö öbhögambi na naahëkeraini gaara gonsui aarë gutuna gökoorra inyumba yö ÖMÖNENE na kunyumba nköraano yö öbhögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki, ÖMÖNENE akamööchëra ubhutikö, akamöteebhia iga, “Niguure irisabhi reo na naahööyë ahasë hano köbha inyumba yaane yi ikimuenso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndasiike kuriöbha imbura yange götöa gösë mbarentere ichingige chire ibhiakörëa bhiabho gösë bhanyooroe na amarooyi amabhëëbhë ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano ndanyoore abhantö bhaane bhayö mbhasuseena, bhasasaame, bhaantune na gutiga amakuuri gaabho amabhëëbhë, igo uni nëndabhaiguë kurua igörö kuriöbha, nëndabhëre amaraga gaabho na köha ënsë yaabho ëmësaraaro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono nëndariihe ëhekaru ëno na kuigua amasabhi gano garaakorekane hano, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira nsabhuurre inyumba ëno korri abhantö bhansengere iriina reene hano kuya ëyö. Nëndagiriihe na kögëhaancha ruiso ronsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano na uwe örankorre ëmërëmo köbhöheene kehaara Tauti isaweinyu aakoorrë, ökore gonsui gano ngöteebhiri na kögoota amaragiirrio gaane na imigiro geene, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Gam 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "bhoono, uni nëndakunguuruki igitumbë keeo kiö öbhögambi kehaara naakorrë ëndagano na Tauti isaweinyu ndagamba iga, ‘Törabhöre ömöntö wa götangatëra Isiraeri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano möratige gönsoraana mötëëyëre amaragiirrio gaane na imigiro gëno naabhahaayë, na kuya gökoorra ichinooköë chiindi na guchisengera, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikugira ëyö uni nëndaabhate kurua gönsë ëno naabhaha. Bhöyö bheene na inyumba ëno naitööra kugira yi iriina reene nëndagitige, na kögëkora köbha ëkërengio na göseroa na ichihamatë chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na igörö yi inyumba ëno naaya nkuma, këra örë wonsui aköheta hang'i nayo naaribhamböka na kubhuuria iga, ‘Igankë ÖMÖNENE akorrë igo gönsë ëno na kunyumba ëno?’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
