    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhamisiri bharasoheerra Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano öbhögambi bho Rehobhoamu bhogömërë na köbha na ichinguru, we hamui na abhantö bhaae bhonsui mbaatigërë imigiro giö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go gataano go öbhögambi bhö Ömögambi Rehobhoamu, gikugira tëbhaiguërëëyë ÖMÖNENE, Sisaki, ömögambi o Misiri naitaini Yerusaremu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana amagari ëgëköë kimui na amagana abhërë (1,200), abhagendia-bharaasi ibhiköë mërongo ësansabha (60,000), na abhasirikare bhano bhataköbharoa, bhano bhaaruurë Misiri hamui nawe: Abharibhia, Abhasukii na Abhakusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagoota imigi ge Yuta gëno gigitërë bhökong'u kuhika Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömönaabhi Semaya akagëëra ömögambi Rehobhoamu na abhatangati bhandë bha Yuta, bhano bhairaini Yerusaremu harë bhang'oseeyë korri bhaibhechi Sisaki, akamöteebhia iga, “ÖMÖNENE aragamba iga, ‘Bhainyu moontiga, köhayö bhoono, nani naabhatiga, na köbhahaatiirria kömabhoko ga Sisaki.’”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho abhatangati bha Isiraeri na ömögambi bhagasuseena na kögamba iga, “ÖMÖNENE mbuuya akorre.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ÖMÖNENE aarööchë iga bhaasuseenërë, nëho ëng'ana yö ÖMÖNENE ëgaachëra Semaya guiki, ëragamba iga, “Bhaasuseenërë, tëndabhasiki hai, gëtatiga mböngö igo ndaabhatuuri. Tëndahatiirri umugi gö Yerusaremu ubhusinanku bhoone kögösaria gököbhoko go Sisaki, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "sibhoono mbaramökoorrë ëmërëmo korri bhöngöre ëkëhökanio ke gönkoorra uni ëmërëmo na gökoorra abhagambi bhë ëkëbhara.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        }
      ]
    },
