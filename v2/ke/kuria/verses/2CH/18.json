        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ömögambi wa Isiraeri akaya hamui na Yehosabhati ömögambi wa Yuta guitania umugi go Ramoti-gireati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Isiraeri agateebhia Yehosabhati iga, “Uni nëndaasuare ichingëbho chino chitare ichö öbhögambi kuya kuiihi, si uwe usuare ënganchö yaao yö öbhögambi.” Bhöyö ömögambi wa Isiraeri akaya kuiihi atasuarrë isumaati yö öbhögambi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi wa Samu nkanyoora aruusiri ëngamba köbhakabhuruti bhaae bhano bhaaimërrëëyë amagari gaae ga kurutua iga, “Monge guitana na möntö örë wonsui ömönene gösë ömöke, gëtatiga bheene ömögambi wa Isiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhakabhuruti bhaara hano bhaarööchë Yehosabhati, bhakagamba iga, “Ömögambi wa Isiraeri ngögöno.” Köhayö, bhakamöraabhiria kumuitania; sibhoono Yehosabhati agakora igituri, na ÖMÖNENE akamutuuria. Ënooköë akaruusia ho bhaara wanyoorrë bhamuhikërë hang'i kumuitania. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhakabhuruti bhaamanyërë iga taarëngë ömögambi wa Isiraeri, mbaatigërë kumuitania bhakaringa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono umusirikare umui wa Samu akaruta öbhöta bhooe kögötobhekania, umugui gökarasa ömögambi wa Isiraeri köbhoosa bhui iritati reee ri ikiöma. Hayö igo Ahabhu agateebhia ömögendia wi irigari reee iga, “Nyahaarröë! Tahönchöra iritoka unduusi köröhari.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriihi nario kurusikö röyö, ndegeenderreeyë köbha iririto na hano ömögambi wa Isiraeri aitögëkërë umuene kuigari asiorri Abhasamu kuhika ömögoroobha. Hakurua gönkaaga yö ögösëkëra kui iriöbha, agakua.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
