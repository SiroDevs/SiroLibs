          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaarëngë ho Abhabhirisiti na Abhaarabhu nyabhörebhe bhano wanyoorrë bhamenyërë hang'i na Abhakusi. Bhano, ÖMÖNENE asinankiri korri bhaitane na Yehoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono bhagaitania ënsë ya Yuta, bhakaroona ibhintö bhionsui bhino bhiarë kunyumba yö ömögambi na kuimukia ubhunyambu abhaana bhaae bhonsui na bhakaae, gëtatiga Ahasia bheene, ömoona waae ömöke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gayö gonsui gaahetërë, ÖMÖNENE akarentera ömögambi öbhörooyi bhöë ënda bhöno bhötakuhueena. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagenderria köroora na öbhörooyi bhökaya bhoraiyengeria këra sikö, na köhëkera masëërra gö ömooka go kabhërë, agakua köbhörrö öbhönene. Abhantö tëbhahuutërë ömörro guikara öbhööhu bhooe kehaara bhaakoreeyë bhaguuka waabho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        }
      ]
    },
