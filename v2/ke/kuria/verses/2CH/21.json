              "2CH.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.40"
              },
              "items": [
                {
                  "text": "Ögt 27:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëëra ya Yehoramu, abhantö bha Etomu mbaatëëyëyë öbhögambi bho Yuta, bhakaiyahöörra ömögambi waabho abhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Yehoramu hamui na abhakönaare bhaae na amagari gaae gonsui naagëyë agaitania Abhaetomu bhano wanyoorrë bhamönaarri we hamui na abhakönaare bhaae na amatoka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö Etömu ëgatëëyëra öbhögambi bho Yuta kuhika reero. Gönkaaga ëyö bheene, guiki abhamenyi bha Ribhuna nabho bhagatëëyëra öbhögambi bhooe gikugira Yehoramu nkanyoora atigirë ÖMÖNENE, Ënooköë wa bhaguuka bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano, agakora ahasë ha gösengera ichinooköë chindë guchinguku cha Yuta na körenteerria abhamenyi bha Yerusaremu köbhöra ubhusuuki na abhantö bha Yuta köhotoka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi Eria naahereeyë ömögambi Yehoramu inyarubha ëno yaandëkëröë iga, “ÖMÖNENE, Ënooköë o Tauti guuka weinyu, arakuihiima gikugira tëwagoota ësëëra ya Yehosabhati isaweinyu, gösë iya Asa ömögambi wa Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iribhaga reeho wagoota ësëëra yö ömögambi wa Isiraeri na götangata abhantö bha Yuta na Yerusaremu köbhöra ubhusuuki ke Ahabhu, na abhagambi bhë ëka yaae bhano bhamörobheeyë keebhörë bhatangatërë abhantö bha Isiraeri köbhöra ubhusuuki. Guiki wëita bhamura omoinyu, abhaana bhanda imui bhano bhaarëngë abhaiya gökëra uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira ya ëyö, ÖMÖNENE narabhörööte bhörrö abhantö bhaao, abhaana bhaao, bhakaao na gösaria ibhintö bhiao bhionsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe umuene nöraroore öbhörooyi öbhöbhëëbhë bhöë ënda bhöno bhöraiyengeri këra sikö, kuhika amara gaao gabhochoke këbhara.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
