            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu naatangërë kögambëra ana ëmeeka mërongo ëtatö na ëbhërë; akagambëra Yerusaremu gönkaaga yë ëmeeka ënanai. Hano aakuurë, tëmöntö ahö öno amuiguërëëyë bhörrö hai. Naatökëyöë kumugi go Tauti, si tiguchindua cha abhagambi hai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
