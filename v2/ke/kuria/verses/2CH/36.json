                {
                  "text": "Ese 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Setekia naatëyëëyë ömögambi Nebhugatinesa öno amökorrë aituëneerri kuriina rë Ënooköë iga taarëmötëëyëra hai. Naarëngë ömöbhë bhökong'u na öno aana ubhuikumburi akaanga kuihönchöörra ÖMÖNENE, Ënooköë wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora na abhanchaama, abhatangati bha Yuta, hamui na abhantö mbaabhörrë öbhöheene kimui bhakëëga amakora gonsui ga kuriirria ga abhantö bhi ichihamatë chindë; bhakagotera ibhikui inyumba yö ÖMÖNENE ëno we umuene wanyoorrë asabhuura Yerusaremu haara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE, Ënooköë wa bhaguuka bhaabho haarë kaaru naagatömërë harë bho abhahira mang'ana bhaae kugira naarë na amaabhë kö abhantö bhaae na öbhömenyo bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bho mbagendereeyi guchoria abhatömöa bhë Ënooköë, bhagasëra amang'ana gaae na gösekeerra abhanaabhi bhaae kuhika ubhusinanku bhö ÖMÖNENE bhökaihemba guisiira abhantö bhaae kuhika ënchëra ërë yonsui ya köng'osa ëkabhöra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.1+JER.21.2+JER.21.3+JER.21.4+JER.21.5+JER.21.6+JER.21.7+JER.21.8+JER.21.9+JER.21.10"
              },
              "items": [
                {
                  "text": "Yer 21:1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Köhayö, ÖMÖNENE naamörenteeyë ömögambi wa Abhagaritayo öno aasikiri abhahentani bhaabho na inchonge ninyoora mmönsë ya ahasë ahahoreeru; na tamaahëëyë maabhë möntö örë wonsui wë ëgësaacha gösë öwëkëgaikörö, ömöntömökörö gösë umusunsuguru. Bhonsui ÖMÖNENE naabhatöörrë kömabhoko gaae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaimukia ibhintö bhionsui bhi inyumba yë Ënooköë ibhinene na ibhike na ëmongo yi inyumba yö ÖMÖNENE na iyö ömögambi na abhatuurria bhaae. Naabhihiirrë bhionsui kuhika Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Gam 9:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agasamba inyumba yë Ënooköë, agatëmöra urugito ro Yerusaremu, agasamba ichinyumba chonsui chö öbhögambi na gösaria ibhintö bhionsui bhi iriguri irinene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano abhantö bhaatërrökërë kuihi naabhahirre köng'aanyi Bhaabheri. Bhakabha abhagöre bhaae hamui na abhuruibhöro rooe kuhika ögötanga köbhögambi bhua Achemi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, ëng'ana yo ÖMÖNENE ëno Yeremia aagambërë ëkahëkërana: “Ënsë nëratame bhuchua ëtaremëröë kömeeka mërongo muhungatë köreng'ana na ënkaaga ya kumuunya ëno ëtaakorroë.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëngamba ya Koresi kö Abhayahuti kuringa waabho.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kömooka go mbere gö öbhögambi bho Koresi, ömögambi wa Achemi, korri iga ëng'ana yo ÖMÖNENE ëno yaagaambëröe gokohëtëra kömönaabhi Yeremia ëhëkerane, ÖMÖNENE naasansamukiri ënkoro ya Koresi, ömögambi wa Achemi, arundi ëngamba iga köbhögambi bhooe bhonsui na kögëtööra Kömandëko: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Bhöno mbo ömögambi Koresi wa Achemi akögamba: ÖMÖNENE, Ënooköë wa kuriöbha, ang'aayë amagambi gonsui gë ëkëbhara, na antömërë möhagaachëre inyumba Yerusaremu, gönsë ya Yuta. Bhoono, këra möntö harë bhainyu bhonsui bhano mörëngë abhantö bhö ÖMÖNENE, tiiga ayi na Ënooköë waae na abhë hamui nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
    }
