          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora amanyanku mbere yö ÖMÖNENE, Ënooköë waae, na tasusenërë mbere yö ömönaabhi Yeremia öno agambërë amang'ana gano gaarurë kö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
