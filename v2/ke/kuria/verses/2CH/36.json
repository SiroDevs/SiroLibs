        {
          "text": "Setekia naarëngë na ëmeeka mërongo ëbhërë na gumui hano aatangërë kögambëra, akagambëra kömeeka ikumi na gumui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
