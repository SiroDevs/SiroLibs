              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Yuta mbaimukiri Yehoahasi, ömoona wa Yosia, bhakamötööra köbha ömögambi kuibhaga re isawaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahasi naarëngë na ëmeeka mërongo ëbhërë na ëtatö hano ataangërë kögambëra; akagambëra gönkaaga yi imieri ëtatö kurua Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ömögambi wa Misiri akamuruusia Yerusaremu na akahakania ënsë iriguuti ichikiro ibhiköë bhitatö na amagana anai (3,400) cha amatiini gi ichimbiria na ichikiiro mërongo ëtatö na inyai cha ësahaabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11"
              },
              "items": [
                {
                  "text": "Yer 22:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ömögambi wa Misiri, agatööra Eriyakimu, mura omobho Yehoahasi köbha ömögambi wa Yuta na Yerusaremu, akahönchöra iriina reee köbha Yehoyakimu, sibhoono Neko akaimukia Yehoahasi mura omoobho kuya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
