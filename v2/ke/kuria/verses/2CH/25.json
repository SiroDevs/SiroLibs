    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ömögambi Amasia wa Yuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasia naarëngë na ëmeeka mërongo ëbhërë na ëtaano hano aatangërë öbhögambi, akagambëra gukurua Yerusaremu kömeeka mërongo ëbhërë na ëtaano. Nyaköwaabho niiga Yehoatani aakabhërëkëëyöë öwa Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agakora gano gaarëngë amaiya mbere yö ÖMÖNENE ninyoora ataagakorrë kömooyo ömöröngë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömögambi Amasia aaköngörökërë köbhögambi naitërë abhakoramërëmo bhano bhaaitërë ömögambi isawaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Ëhë 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono taitërë abhaana bhaabho, keebhörë keendëkëröë kumigiro gëno gërëngë kögëtabhö ke Mösa, hano ÖMÖNENE akögamba iga, “Abhaibhuri tëbharaitöe gikugira ya abhaana bhaabho, gösë na abhaana guitöa gikugira ya abhaibhuri bhaabho; gëtatiga këra möntö naaraitöë gikugira ya amaraga gaae umuene.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriihi guisiira Etomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Amasia agaköma abhasaacha bhi ibhiaro bhia Yuta na Bhenchamini, akabhatööra kömakomo hagarëhagarë köreng'ana ni ibhisaku bhiabho, akabhatööra hansë ya abhakönaare bha ibhiköë na abha amagana. Hano aitaahërë bhaara bhana ëmëëka mërongo ëbhërë na kögenderria naanyoorrë iga bhonsui igo mbaarëngë ibhirara bhitatö (300,000). Bhonsui na abhantö abhaahöroa bhabhaayë, gukuya kuiihi, abhakarë bha guitanëra amatimö na ichingubha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua akagöra abhasirikare bhandë abhakarë ëkërara kimui (100,000) gukurua Isiraeri, guchikiiro ibhiköë bhitatö (3,000) bhia amatiini gi ichimbiria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömöntö wë Ënooköë akaya akamöteebhia iga, “Wei ömögambi ötakaaya kuiihi hamui na abhasirikare bhano bha Isiraeri, kugira ÖMÖNENE tarëngë hamui na abhantö bha Isiraeri hai. Tarëngë hamui na Abhaebhuraimu bhano bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndanyoore, niigo, ninyoora öbhë ömökarë kuiihi, Ënooköë naragökore ökëröe na abhabhisa, gikugira Ënooköë naana ichinguru cha köha ömoona wö ömöntö ögökëra gösë kömökora akëroe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasia akabhuuria ömöntö wë Ënooköë ööra iga, “Yekë töraakore guchimbiria chino nhaayë abhasirikare bha Isiraeri?” Ömöntö wë Ënooköë nawe akamuhunchukiria iga, “ÖMÖNENE aratöra gukuringiria gökëra chiyö.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö Amasia akahatëra abhaanacheesi bhano bhaaruurë Ebhuraimu bharinge waabho. Bhoono bhakaringa waabho na hano bharërërrëëyë bhökong'u abhantö bha Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasia naitirimikiri agatangata iricheesi reee kuhika Ibhatë rë Mönyö. Agaitana ho na guiita abhantö bha Seiri ibhiköë ikumi (10,000). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakagoota abhantö ibhiköë ikumi (10,000), bhakabhariinia kömarëngo na köbharëkera kuya hansë guchintare, bhakabhöröngöka bhakabha ibhitari. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö bheene abhasirikare Abhaisiraeri bhaara Amasia aatigërë bharinge waabho akabhakaania kögenana nawe kuiihi, mbaagëëyë na guitania imigi ge Yuta, kurua Samaria kuhika Bheti-horoni, bhagaita abhantö ibhiköë bhitatö (3,000) na köroona ibhintö ibhiaru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Amasia akërrë Abhaetomu na kuringa, naarentërë ichinooköë cha Abhaetomu na guchikora köbha ichinooköë chaae, agachihigamëra na guchihuchiria öbhöbhaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayö ngaririiyi bhökong'u ÖMÖNENE, agatöma ömönaabhi harë Amasia. Ömönaabhi öyö akabhuuria Amasia iga, “Igankë uguiteng'era ichinooköë cha abhantö bhandë chino chitaatörrë ninyoora nu ugutuuria abhantö bhaacho kurua kömabhoko gaao?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono nkaaga atarasookia kögamba, Amasia naamubhutukirriiyi akamöteebhia iga, “Takira! Ndöhai togökorrë köbha ömöragirria wö ömögambi? Ngutuna örë wiitöe?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönaabhi agakira, sibhoono akagamba iga, “Nëmanyërë iga Ënooköë ngutuna arë kugusikia gikugira ökorrë gano gonsui, sooki öranga götöndörröa na öbhöragiirria bhoone.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriihi guisiira Isiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Amasia ömögambi wa Yuta aitegereeyë, agatöma ëng'ana harë Yehoasi, ömoona o Yehoahasi, ömoona o Yehu ömögambi wa Isiraeri, akamöteebhia, “Taachö tuenchani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Yoasi ömögambi wa Isiraeri akamöheerra amang'ana aragamba iga, “Urusikö röndë ëkëhörë ke Rebhanoni këgateebhia umueresi gooho bheene iga, ‘Tatetia umuisëkë waao kumumura waane.’ Sibhoono itinyi imui ya ibhara ëkaheta ho na götachatacha ëkëhörë këyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, uwe Amasia öragamba iga, ‘Niitërë Abhaetomu,’ na ömooyo göragökora örairaha. Bhoono ötaikara waao; igankë uguitönëra inyanko ëno ëragusiki uwe umuene hamui na abhantö bhaao bha Yuta?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Amasia taantöndrrëëyöë gikugira ni irituno rë Ënooköë rerëëngë korri iga abhatööre kömabhoko ga abhabhisa bhaabho gikugira naaiteng'eeyë ichinooköë cha Etomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, ömögambi Yehoasi, naagëëyë götemberrëkania na Amasia, ömögambi wa Yuta, kuiihi Bheti-semesi haara, gönsë ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Yuta mbaakëëröë na abhantö bha Isiraeri, na këra möntö akaringa ka waae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yehoasi ömögambi wa Isiraeri akagoota Amasia ömögambi wa Yuta, ömoona wa Yoasi, ömoona wa Ahasia, Bheti-semesi haara, akamuhira kuhika Yerusaremu. Hayö naatëmööyë urugitö ru umugi göyö, götangëra Ihita re Ebhuraimu kuhika Ihita re Mbarëka, öbhöharai bhui ichimiita hang'i amagana abhërë (200) igo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naimukiri ësahaabhu na amatiini gi ichimbiria na ninyoora ni ibhintö bhionsui bhino bhiarëngë kunyumba yë Ënooköë kubhuriihi bho Öbheti-ëtomu; guiki naimukiri ëmongo yë inyumba nköraano yö öbhögambi na abhanyambu sooki akaringa Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasia ömögambi wa Yuta naamenyërë ëmeeka ikumi na ëtaano gukurua ënkaaga ëno ömögambi Yehoasi ömoona o Yehoahasi ömögambi wa Isiraeri aakuurë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaköra gandë gonsui ga Amasia kurua nsëmöka kuhika masëërra ngandëkëröë Kögëtabhö kia Amang'ana ga Abhagambi bha Yuta na Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iniko ya guita Amasia yaarëëyöë Yerusaremu gukurua aatigërë ÖMÖNENE, köhayö naang'oseeyë Rakisi. Sibhoono abhabhisa mbaatömërë abhantö Rakisi bhakamuëtëra ho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikihundugu keee nkeereentëröë kiimukibhui köbharaasi, na götökëroa guchindua cha abhagambi kumugi go Tauti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
