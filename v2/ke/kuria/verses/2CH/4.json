                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömögambi Suremani akahagaacha irikëngë ri iriche rëno reerëngë na öbhötambë ichimiita kenda na öbhögarë ichimiita kenda, na öbhötambë kuya igörö ichimiita inyai na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, akahagaacha ëntangë ya amanchë imbiringisu, ëno ëna ichimiita inyai na iritënë kurua kumurigi kuhika kögöndë, ikindumanchë ichimiita ibhërë na ëröbhö, na umuinaarö ichimiita ikumi na isatö na iritënë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumurigi go hansë kuinaara ëntangë ëëra, haarë ni ichinkarra ibhërë cha amachaaria gi ichigaini, örökaarra rumui igörö yö örökaarra röndë; amacharia gayö ngamantërrëyöë hamui na ichigaini chindë chë ëntangë ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntangë ëyö, yaikaribhui igörö yi ibhihooru bhi ichintang'ana ikumi na ibhërë, isatö chigataachërra mööchë, isatö nyancha, isatö Sööchë na isatö chindë Rögörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhörömba bhu umurigi gooyo mboorë ichisentimita muhungatë na iritënë. Umurigi gooyo ngoorëngë kiö ömögëngërëka göë ëgëkombe, na kië ëgësekere ki iriyungiyungi. Ëntangë ëëra, yaarë na ögötöra go kuimukia ëkërengere gi ichiriita ibhiköë mërongo ësansabha (60,000) cha amanchë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.17+EXO.30.18+EXO.30.19+EXO.30.20+EXO.30.21"
              },
              "items": [
                {
                  "text": "Ëgt 30:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nakarua guiki akahagaacha amatibhöngö ikumi ga koogiria ibhintö bhiira wanyoorrë bhikoreeyöë ibhimuenso bhia gösambërëërröa. Ataano kögayö naagatöörrë ëntahana ya söchë, na agandë ataano ëntahana ya möchë. Ëntangë ëyö niyo nabhanchaama bhaarë guisaabhëra amabhoko na amagörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "Ëgt 25:31-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30"
              },
              "items": [
                {
                  "text": "Ëgt 25:23-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agakora ibhitagacha bhi ichitara ikumi bhië ësahaabhu keebhörë wanyoorrë aragirribhui, akabhitööra kömörengo göë ëhekaru; bhitaano söchë, bhitaano möchë. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki agakora ichimeesa ikumi na guchitööra kömörengo göë ëhekaru, isaano göntahana ya sööchë na isaano nchindë göntahana ya mööchë. Hakurua agakora amatubha gë ësahaabhu irigana rimui (100). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akahagaacha ëkëgööra kia abhanchaama na ëtagaachi, na ibhihita bhië ëkëgööra akabhihaka iriche; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ëntangë ëëra akagikaria gönsonkuno go sööchë ya rögörö yi inyumba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramu akabhomba ichinyöngö, amachiko na amatubha. Igo mbe, Huramu agasookia ëmërëmo gëno aakoreeyë Ömögambi Suremani kunyumba yë Ënooköë: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhisigönkö bhibhërë, amatubha, ichiköndö igörö yë ibhisigönkö bhibhërë, na ibhichöngo bhibhërë bhia gukundikiria amatubha gi ichiköndö chino chatöörröë igörö yi imitiiro; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ituubho ya amakomamanga amagana anai (400) gikugira yi ibhichöngo bhibhërë bhiyö, ichinkarra ibhibhërëibhërë icha amakomamanga harë këra gichöngo korri gökoorra öbhömaratati amatubha abhërë gaara gö öbhömaratati gaarëngë kubhisigönkö këgörö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene agakora amatubha këgörö yi ibhikarrio, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ëntangë imui ëëra, na ibhihooru bhi ichigaini ikumi na ibhërë hansë yë ëntangë ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua amahoorra, amachiko na ichihöma na ibhintö bhindë bhionsui bhi inyumba yö ÖMÖNENE bhino Huramu-abhi aakoreeyë Ömögambi Suremani, mbiarë ibhi iriche rëno rëköbharrukia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhintö bhiyö bhionsui, ömögambi naabhikoreeyë kömöndaara gö Yorotani, ëntahana ya ahasë hi iritagito ëno yaarëngë gatai ya Sukoti na Sereta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhurito bhui iriche rëno reekorrë ibhintö bhino tëbhomanyëkaini gikugira Suremani naakorrë ibhintö ibhiaru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suremani naakorrë ibhintö bhionsui bhino bhiarëngë kunyumba yë Ënooköë: Irikëngë rë ësahaabhu na ichimesa cha götööra ëmëgaate ëmëhoreeru ge götööroa mbere yë Ënooköë; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibhitagacha bhi ichitara na ichitara chabhio ichië ësahaabhu inchiiya bhia kömörëkëra ahasë ahahoreeru haara bhökong'u keebhörë yaaragirribhui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhisekere, ichitara na ichikoreo, bhionsui bhino mbiakoreröe gösahaabhu inchiiya kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagasi na amatubha, ibhisahaani bhiö öbhöbhaani na ibhigöhërö bhiö ömörro, bhionsui mbiakorröe gösahaabhu inchiiya. Ichibhata chë ëhekaru chi ibhisaku bhia ahasë ahahoreeru bhökong'u haara, na ichibhisaku bhindë bhiö ömörengo, bhionsui mbiakoreröë gösahaabhu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
      ]
    }
  ],
