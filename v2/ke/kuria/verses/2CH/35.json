          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki ömönaabhi Yeremia naandëkërë ëkërango gë ëkërrro gikugira yu uruku rooe; abhasiringia bhonsui nabho, abhasaacha köbhagaikörö, ngötara bharë Yosia köbhoohu bhoobho kuhika reero röno. Yaabha Ësëëra gökora ëkërrro këno Isiraeri. Gayö ngandëkëröë kögëtabhö gi ikuuro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakora gaandë aga Yosia na amakora gaae amaiya keebhörë gaandëkëröë kumigiro giö ÖMÖNENE, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
