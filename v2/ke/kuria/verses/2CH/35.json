          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharasi bhi imigui nabho bhakarasa Ömögambi Yosia; bhoono nëho ömögambi aateebhiri abhakoramërëmo bhaae iga, “Taandusia hano! Nyahaarröë bhöbhëëbhë bhökong'u.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakoramërëmo bhaae bhakamuruusia kuigari reee rë ëbharaasi, bhakamuimukia na irigaari reee re kabhërë kuhika Yerusaremu. Agakuëra ho na götökëroa guchindua cha abhagambi. Abhantö bha Yuta na Yerusaremu bhagaikara öbhoohu bhuruku ro Yosia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
