              "EZK.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.14"
              },
              "items": [
                {
                  "text": "Yer 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.11"
              },
              "items": [
                {
                  "text": "8:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Abhanaabhi bhayö ngötabhuta bharë abhantö bhaane hano bhaköbhateebhia iga, ‘Ömörembe nho görë,’ na ënkaaga ëyö tëmörembe gööho hai. Abhantö bhaane nköhagaacha bharë urugito röno rötansërë, nabho bharöhaka isuakara! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.10",
            "verseOrgIds": [
              "EZK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono teebhia abhanaabhi bhayö bhaaköhaka indigi isuakara iga imbura nyamutindiki iyi irigörö nëraatöe na indigi ëyö nëraagöe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë, hano rörëgöa, abhantö mbataribhuuria iga, ‘Kana isuakara ëëra moohakërë nëhë ërë?’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.12",
            "verseOrgIds": [
              "EZK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö uni ÖMÖNENE Ënooköë ndagamba iga: Kubhusinanku bhoone nëndërenta imbura nyamutindiki yi irigörö na ömökama umurito bhiguisi indigi ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.13",
            "verseOrgIds": [
              "EZK.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëtëmöra indigi ëyö moohaka isuakara na öbhörösa bhooyo bhötame igo. Hano urugito röyö rörëgöa ndörëbhaguëra musike. Nëho mörëmanya iga uni nö ÖMÖNENE ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhörrö bhoone bhonsui mbörësërra ku urugito röyö na köbhayö bhonsui bhaaröhakërë isuakara. Na bhainyu mmörëteebhibhua iga, ‘urugito tërööho hai, na bhano bhaaröhakërë isuakara tëbhaaho hai,’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.15",
            "verseOrgIds": [
              "EZK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hayö nëho masërra ga abhanaabhi bha Isiraeri bhano bhaanyereeyë Yerusaremu ënaabhi inchiya na kömaaha amamaaho gö ömörembe na haara tëmörembe gööho hai. Uni ÖMÖNENE Ënooköë gambërë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënaabhi guisiira abhakari abhanaabhi abharongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.16",
            "verseOrgIds": [
              "EZK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhoono, uwe ömoona wö ömöntö, ihönchörra abhakari bhë ëhamatë yaao bhano bhakörëa ënaabhi ëno bhaitëgeerreeyë abhiene. Bhanyeera ënaabhi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na köbhateebhia iga ÖMÖNENE Ënooköë aragamba iga, Ëhöbhë kö abhagaikörö bhano mögökora ichinuuga chi ibhitöndö bhiaköbhohera këra ömöntö gököbhoko na gökora ibhitambara bhië ëmëtöe bhino bhiina ibhitöndö hagarëhagarë korri muguëme amabhaho ga abhantö. Gösë hano mukuguëma amabhaho ga abhantö bhaane nköbhööra mörë iga amabhaho gainyu go ngaraabhe ho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monchoria köbhantö bhaane korri munyoore iritonge rë ësayiri na ibhiakörëa bhike igo. Nguita mörë abhantö bhano bhataarë iga bhakue na gutiga bhano bhataarë iga bhamenye, mörateebhia abhantö bhaane öbhörongo nabho nköbhategeerra bharë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igo, uni ÖMÖNENE Ënooköë ndagamba iga, Nëndësaria ibhitöndö bhieinyu bhino mököbhohera abhantö; nindibhitandöratandöra gukurua kömabhoko gainyu na gökora bhayö mukuguëma ki ibhinyunyi bhabhe muchencho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëtandörra ibhitambara bhieinyu na gutuuria abhantö bhaane kurua kömabhoko gainyu; tëmörëbhagootia hai. Hayö nëho mörëmanya iga uni nö ÖMÖNENE ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira moita ömooyo go abhantö abharöngë gökögamba öbhörongo, na haara uni tënaabhaitërë mooyo, motirimikia abhabhëëbhë bhanga gutiga öbhëëbhë bhoobho bhatuuri amabhaho gaabho, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.22",
            "verseOrgIds": [
              "EZK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "igo mbe bhainyu tëmörëmaaha amamaaho ga köng'ainirria, gösë köragöra hai. Nindituuria abhantö bhaane kurua kömabhoko gainyu. Hayö nëho mörëmanya iga uni nö ÖMÖNENE ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.23",
            "verseOrgIds": [
              "EZK.13.23"
            ]
          }
        }
      ]
    }
  ],
