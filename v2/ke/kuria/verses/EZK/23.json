  "bookId": "EZK",
  "reference": "Esekieri 23",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EZK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhasubhaati bhanda imui ibhihööyë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe ömoona wö ömöntö! Bhaarëngë ho abhaisëkë bhabhërë, bhanda imui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.2",
            "verseOrgIds": [
              "EZK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo bhaabhaayë abhaisëkë igo, bhaarëngë Misiri haara, bhagaitabhirria kögootöagootöa ichimbeere chaabho, ichimbeere chaabho chikagöa, bhakabha ibhihööyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.3",
            "verseOrgIds": [
              "EZK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönene naarë köbhërëkëröa iga Ohora, na ömöke öra iga Ohoribha. Bhoono bhonsui mbaabhaayë abhaane, bhakanyibhörra abhaana bhë ëgësaacha na ëgëkari. Bhoono, Ohora nëwe Samaria na Ohoribha nëwe Yerusaremu!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora Ohora mmökaane aarëngë, sibhoono naagenderreeyi köbha umuhurunkani na kuigomba Asuru bhamaiga bhaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.5",
            "verseOrgIds": [
              "EZK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbaarë abhasirikare, bhaasuarrë ichingëbho chiimui ichinchiya, abhagabhana na abhakönaare. Bhonsui mbaarëngë abhaana bhake bhaagötegeria na abhakunguuruku bha kögendia ichibharaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.6",
            "verseOrgIds": [
              "EZK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohora naakorrë öbhöraaya na abhanene bhayö bhonsui bha Asuru na akaigootera ibhikui bhi ibhihooru bhia këra mösaacha aigombërë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.7",
            "verseOrgIds": [
              "EZK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naagenderreeyi na ubhuhurunkani bhooe bhöno atangërë Misiri arëngë moona möke, hano abhasaacha bhaataabhööyë ubhutindë bhooe na köhëkëërania ichigooriö chaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.8",
            "verseOrgIds": [
              "EZK.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö nnaamöhebherreeyi Abhaasuru bhamaiga bhaae bhano arë kuigomba bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.9",
            "verseOrgIds": [
              "EZK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbaamunuurrë ichingebho chaae na kumutiga këng'aabhi. Bhakagoota abhaana bhaae, nawe umuene bhakamuita na inchonge. Iribhöörööta rëyö aahaayöë rëkabha iriigiö kö abhagaikörö bhandë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ohoribha musubhaati omoobho naarööchë ëng'ana ëyö, si nkanyoora ahotoka bhökong'u kubhuigombi bhooe na ubhuhurunkani bhooe mboorë öbhöbhëëbhë gökëra öbho musubhaati omoobho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.11",
            "verseOrgIds": [
              "EZK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaigombërë bhökong'u Abhaasuru: Abhagabhana bhë ëmëndaara, abhakönaare, abhaanacheesi bhano bhaarë gusuara ichingëbho chimui chi iricheesi, abhagendia abhakunguuruku bhi ichibharaasi; bhonsui bhayö bhaarëngë abhamura abhaana bhake bhaagötegeria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.12",
            "verseOrgIds": [
              "EZK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaamöngöyë iga naana ibhikui. Köbhöheene bhonsui bhabhërë bhayö mbaarëngë na ësëëra imui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.13",
            "verseOrgIds": [
              "EZK.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ohoribha neengeeyi ubhuhurunkani bhooe; naategeriibhui na ibhicha bhia Abhagaritayo bhirë waanyoorrë bhichoorröë kundigi, bhiachaaribhua amang'oore amabherretu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.14",
            "verseOrgIds": [
              "EZK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhaibhohërë imichibhi kumikurukuru, bhabhöhërë ichiyaati ichinene kömëtöe; bhiyö bhionsui mbiaatubhaini na abhanene bha Bhabheri, abhamenyi bhë ënsë ya Abhagaritayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niigo arööchë ibhicha bhiyö igo akaigomba, agatöma abhantö kuya Bhögaritayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.16",
            "verseOrgIds": [
              "EZK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, Abhabhabheri bhagaacha köraara nawe. Bhakamögootera ibhikui kumiigombo geebho. Hano abhaayë na ibhikui agatigaana nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.17",
            "verseOrgIds": [
              "EZK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aagenderreeyi köhönyöra ëkëng'aabhi ku ubhuhurunkani bhooe, uni naamutigërë kehaara naatigërë musubhaati omoobho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.18",
            "verseOrgIds": [
              "EZK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo neengeeyi gökora ubhuhurunkani bhooe kehaara arë gökora ubhuhurunkani arëngë Misiri akë moona möke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.19",
            "verseOrgIds": [
              "EZK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaigombërë bhökong'u abhasaacha bhano bhaana ëkëmeeni ëkëbëëbhë kë ëgëtëkërë na ichinguru ichinchaaru gi chi ichigaini chi ichibharaasi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ohoribha naigombërë ubhunyanku bhööra aagakorrë Misiri arëngë moona möke. Hano Abhamisiri bhaataabhööyë ubhutindë bhooe na kögootagoota ichimbeere chaae ichindere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë arakengera umusubhaati ömöke ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhoono Ohoribha! Uni ÖMÖNENE Ënooköë ndagamba iga, Nëndëkora abhamaiga bhaao bhano waatigërë köbhöregaini bhakuimökëre; nëndëbharenta bhagösoherre kurua guchintahana chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndësëgëëta Abhabhabheri na Abhagaritayo bhonsui, abhantö gukurua Bhekoti, Soa na Koa, hamui na Abhaasuru bhonsui. Nëndësëgëëta abhamura bhonsui bhagötegeria, abhagabhana bhë ëmëndaara, abhakönaare na abhaanacheesi bhonsui bhano bharëngë abhagendia bhi ichibharaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.23",
            "verseOrgIds": [
              "EZK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarëkönaria kurua mööchë, hamui na amaagari gi iriihi na agi ichintoora bhatangatërë irikomo irinene ria abhantö. Mbarëkönaaria ichintahana chonsui na ichingubha na ibhigubha na ichingosiira chi ibhiöma. Nëndëbhaha ögötöra go kögökengera ikiina, nabho mbarëgökengera ikiina gököreng'aana na amarago gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.24",
            "verseOrgIds": [
              "EZK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nindigusioria na ubhusinanku bhoone, nabho mbari guitania na öbhörrö öbhönene. Mbarë gökenga amanyëërö na amatui na abhantö bhaao bhano bharëtigara mbaribhaita na inchonge. Mbariimukia abhaana bhaao bhë ëgësaacha na ëgëkari, na abhantö bhaao bhano ndinyoora bhaatigaayë bhabhasambe kömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.25",
            "verseOrgIds": [
              "EZK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbari kunuura ichingëbho chaao na gukuruusia ëmësanga geeo imiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.26",
            "verseOrgIds": [
              "EZK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëgatöra öbhöraaya na ubhuhurunkani bhooo bhöno waakorrë gukurua örëngë Misiri. Törëtachëërra ibhihooru bhirë bhionsui guiki gösë guitegeerra ënsë ya Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igo mbe, uni ÖMÖNENE Ënooköë ndagamba iga, Nëndëköheebherria kuya köbhantö bhano öregërë, abhantö bhano ökömaaha iga ni ikinyinyeeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na köhaara bhaköregërë mbarikuruusia amakö gonsui gë ëmërëmo geeo na kugutiga këng'aabhi, ötaana ngëbho na koorokia ichinsoni chu ubhuhurunkani bhooo. Ubhuhurunkani bhooo na öbhöraaya bhooo ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.29",
            "verseOrgIds": [
              "EZK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhiyö mbio bhiakörenteeyë gayö. Uwe waakorrë ubhuhurunkani na ichihamatë, ökaigootera ibhikui gu ichinooköë chaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.30",
            "verseOrgIds": [
              "EZK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira waagootërë igikuuri ke musubhaati omoinyu, igo mbe, uni nëndëköha ëgëkombe këëra bheene ki iribhörööta unyue.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni ÖMÖNENE Ënooköë ndagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö uni ÖMÖNENE Ënooköë ndagamba iga, Gukugira wansunchiria ömögongo na kunyëbha, igo mbe, öbhöraaya na ubhuhurunkani bhooo mböraguitunge.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë arakengera abhasubhaati bhanda imui ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aganteebhia iga, “Uwe ömoona wö ömöntö! Gösë, örëngë hang'i gökengera Ohora na Ohoribha ikiina? Bhoono, tabharundiria amakora gaabho gi ibhiriirriö! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.36",
            "verseOrgIds": [
              "EZK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaakora ubhuhurunkani na ubhuiti. Bhaakora ubhuhurunkani kubhihooru bhiabho, ëkërengere ge kubhimuensera abhaana bhano bhaanyibhörëëyë bho abhiene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.37",
            "verseOrgIds": [
              "EZK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiiga ngayö bheene hai! Bhachoria ahasë haane ahahoreeru na gösaria ichisabhaato chaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.38",
            "verseOrgIds": [
              "EZK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö rööra bheene bhaaruusiyi ibhihooru ikimuenso kia abhaana bhaabho, ndo bheene bhaachërë kögootera ahasë ahahoreeru ibhikui. Gayö ngo bhaakorrë kunyumba yaane!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbaatömërë abhantö köbhërëkëra abhasaacha kurua aharai, nabho bhagaacha. Kugira yabho, bhagaisaabha, bhagaachaaria ichingiki na götööra ëmësanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.40",
            "verseOrgIds": [
              "EZK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua bhagaikara kömatumbë amaiyamaiya, na haara ëmeesa yaarröë. Na öbhöbhaani bhoone na amaguta gaane bhitöörröe këgörö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.41",
            "verseOrgIds": [
              "EZK.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, wigua igituri kë ëgëkomo kia abhantö bhano bhatatöndörrëëyöë na gëntö, ëgëkomo kia abhasaacha abhareebhi bhano bharëntëröë kurua guiköngö. Köbhasohiria abhagaikörö bhaara ichibhangiri kömabhoko na köbhaimiria ichingosiira ichinchiya kömëtöe geebho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho aagambërë iga, Ngökora bharë ubhuhurunkani na ömögaikörö öno aagotera kö öbhöraaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.43",
            "verseOrgIds": [
              "EZK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra umui naamögëërëëyë kehaara abhasaacha bhakögëëra ömöraaya. Mböyö bhaagëërëëyë abhagaikörö abharaaya bhaara Ohora na Ohoribha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.44",
            "verseOrgIds": [
              "EZK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhakengabhiina abharöngë mbarabhakengere ikiina kehaara bhagökengera abhagaikörö abhahurunkani na abhaiti; kugira bho nabhahurunkani na abhaiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igo mbe, uni ÖMÖNENE Ënooköë ndagamba iga, Nëndëbharentera amanyamörro gaabhahahia na köbharoona ibhintö bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanyamörro gayö ngarabhateme na amagëna, bhabhageeche na inchonge na guita abhaana bhaabho bhë ëgësaacha na ëgëkari na ichinyumba chaabho bhachisambe na ömörro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.47",
            "verseOrgIds": [
              "EZK.23.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nëho nëndëgatöra öbhöraaya bhoobho gönsë ingima, ëbhe ëkögo kö abhagaikörö bhonsui iga bhange gökora ubhuhurunkani ke bhööra mookorrë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.48",
            "verseOrgIds": [
              "EZK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhainyu Ohora na Ohoribha mmörëbhöröötöa gikugira yu ubhuhurunkani bhoinyu na iriraga reinyu re gösengara ibhihooru. Hayö nëho mörëmanya iga uni nö ÖMÖNENE Ënooköë ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        }
      ]
    }
