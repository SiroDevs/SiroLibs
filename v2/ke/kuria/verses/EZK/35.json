                "loc": "MAL.1.2+MAL.1.3+MAL.1.4+MAL.1.5"
              },
              "items": [
                {
                  "text": "Mari 1:2-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.1",
            "verseOrgIds": [
              "EZK.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe ömoona wö ömöntö! Magakiria inguku ya Seiri unyeere abhantö bha ho ënaabhi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëteebhia iga uni ÖMÖNENE Ënooköë ndagamba iga, Uni nkugiriginchania ndë na uwe, iri nguku ya Seiri. Nëndëköhaatirria ököbhoko koone ngökore öbhe iriköngö na irihooru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngökora ndë imigi geeo köbha amang'aanyöa na uwe nöörëbha iriköngö. Hayö nëho örëmanya iga uni nö ÖMÖNENE ndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waarëngë umubhisa wa Isiraeri, ökagira abhantö bhaayo bhagaitua na inchonge gönkaaga yë ëhöbhë yaabho, gönkaaga yi iribhörööta reebho re gösookirria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, uni öno, ÖMÖNENE Ënooköë ndatuenerria ndagamba iga, uruku ngököganya rörë na törëmanya kuruichaabha hai. Gikugira nööna irisaria re guita, igo mbe ubhuiti mböragösoorane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëkora inguku ya Seiri köbha iriköngö na örë wonsui aköheta ho niindimusikia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.7",
            "verseOrgIds": [
              "EZK.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëbhömba abhakuurë bhano ndinyoora bhaitëröë na inchonge guchinguku, kömabhatë na kömahancha gaao gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.8",
            "verseOrgIds": [
              "EZK.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndëgökora öbhe iriköngö kuya ëyö, na imigi geeo tëgërëmenyöa na möntö guiki hai. Hayö nëho örëmanya iga uni nö ÖMÖNENE ndë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe waagambërë iga ichihamatë chiyö ibhërë, Yuta na Isiraeri nö öbhoomë bhooo na iga nurichimeria! Waagambërë igo ninyoora nhayö nö öbhömenyo bhoone uni ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.10",
            "verseOrgIds": [
              "EZK.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, uni öno, ÖMÖNENE Ënooköë ndatuenerria ndagamba iga, nëndëgökora gököreng'aana na öbhörrö na irihari reeo, gököreng'aana na öbhöregaini bhooo harë bho. Hano ndëköbhörööta nëho örëmanya iga nu uni ng'ui! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.11",
            "verseOrgIds": [
              "EZK.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe nörëmanya iga uni ÖMÖNENE umuene nnaaiguurë amatuki gonsui gano waaruusiiyi ichinguku cha Isiraeri, öragamba iga, ‘Ichinguku cha Isiraeri chikorröë köbha iriköngö! Töhaayöë iga tuchiigari!’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.12",
            "verseOrgIds": [
              "EZK.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naigua möna ukuiheema igörö yaane na kögamba amang'ana amaaru harë uni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni ÖMÖNENE Ënooköë ndagamba iga, Hano ndëgökora Etomu öbhe iriköngö ëkëbhara gionsui nkërëgooka ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kehaara uwe waakorrë ënkaaga ëno ënsë ya Isiraeri yaasariibhui. Nörëbha iriköngö, uwe iri nguku ya Seiri, hamui na ënsë yonsui ya Etomu. Nëho abhantö bharëmanya iga uni nö ÖMÖNENE ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
    }
