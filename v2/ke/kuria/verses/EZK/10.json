            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Ese 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Öbhö 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Këra irikerubhi ndeerë na amasiö anai: Ubhusiö bho mbere nu ubhuë ëgaini bhoorë, ubhusiö bho kabhërë nö öbhöömöntö bhoorë, ubhusiö bho gatatö nu ubhui indui bhoorë na ubhusiö bho kanai nö ubhuë ëkoohe bhoorë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amakerubhi gakaibhurruka. Bhino mbio ibhiteemöa ibhihoru bhiira naarööchë hang'i na ömooro go Kebhari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano amakerubhi gayö gaarë kuya, amagörö nago ngaarë kögenda mbarëka yaabhio. Hano gaarë köramböra amabhabha iga bhiimöke igörö kurua hansë, amagörö ngaarë kuya nabhio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhiaarë kuimëërra amagörö nago ngaarë kuimëërra; hano bhiaarë kuimöka igörö amagörö nago ngaarë kuimöka hamui nabhio. Ënkoro yi ibhiteemöa bhiyö nayo guiki yaarë kömagörö gayö.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
