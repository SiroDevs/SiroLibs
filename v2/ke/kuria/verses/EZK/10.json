                "loc": "EZK.1.26"
              },
              "items": [
                {
                  "text": "Ese 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Öbhö 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua ngaataachërra kuriöbha, igörö yë ëmëtöe gia amakerubhi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:1",
              "type": "text"
            },
            {
              "text": "amakerubhi:",
              "type": "text"
            },
            {
              "text": "Ibhiteemöa bhia kuriobha bhino bhiina amabhabha",
              "type": "text"
            }
          ]
        },
        {
          "text": " nkeere ho ëgëntö këno kënga igitumbë kiu ubhuhika këno gikoondo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Öbhö 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënooköë agateebhia ömöntö öra waanyoorrë ana ëhanga inyëke iga, “Heta gataigatai ya amagörö gano garëngë hansë ya amakerubhi, ögöhe amakara gö ömörro göno görëngë gataigatai yaago wichuuri gököbhoko na ögamuse këgörö yu umugi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamömaaha araya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakerubhi gaara nkanyoora ngaimëërëëyë göntahana ya sööchë yi inyumba yö ÖMÖNENE hano ömöntö öra aasohërë mo; na irisaaro rëgaichuuria irigori re mönsë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhuhika bhuë Ënooköë bhökaimöka kuya igörö kurua kö amakerubhi bhökaya kögësaku kinyumba, na irisaaro rëëra rëgaichuuria inyumba, na irigori rëgaichöra öbhörabhu bhu bhuhiku bhö ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ikihimo kia amabhabha ga amakerubhi gaara nkeerë kuigubhua ninyoora nkuigori re isikö kë ëngamba yë Ënooköë Umukumahe hano agusumaacha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ÖMÖNENE ateebhiri ömöntö öra anyoorrë asuarrë ëhanga inyëke iga agöhe ömörro kurua gataigatai ya amagörö gano gaarëngë hansë ya amakerubhi, ömöntö öra naagëyë akaimëërra mbarëka yö ökögörö kumui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irikerubhi rimui rëkarambëka ököbhoko kögöha ömörro göno goorë gataigatai ya amakerubhi, akagöha agatöörra gököbhoko ömöntö öra aanyoorrë asuarrë ëhanga inyëke; akaguimuikia akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakerubhi gayö ngaamahëkaini köbha na ëgëntö kenga ököbhoko kö ömoona wö ömöntö hansë ya amabhabha gaabho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
