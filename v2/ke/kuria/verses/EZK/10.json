        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ubhuhika bhö ÖMÖNENE bhökarua kögësaku kinyumba, bhökaya na kuimëërra igörö ya amakerubhi gaara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakerubhi gaara gakaramböra amabhabha gakaimöka igörö kurua hansë uni ngataachërrëëyë na amagörö gaara garëngë mbarëka yaago. Gakaimëërra mbere yi irihita re rögörö ri inyumba yö ÖMÖNENE, na ubhuhika bhuë Ënooköë wa Isiraeri mboorëngë igörö yaago.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
