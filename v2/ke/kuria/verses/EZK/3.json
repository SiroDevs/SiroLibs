              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, nkaimöka nkaya göntahana yi irihancha. Gökërögööro! Hano naarëngë ho nnaarööchë ubhuhika bhö ÖMÖNENE bhuimërëëyë ho kiu ubhuhika bhööra naanyoorrë ndööchë hang'i na ömooro go Kebhari; nkagöa nkahurama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ënkoro yë Ënooköë ëgansëkërra na kunyimiirria bhöröngë. Sooki Ënooköë agasumaacha nani, aganteebhia iga, “Taya ka waao wisëëkëre nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe ömoona wö ömöntö, nörabhohoe na ichinsiri korri wange kurichoka na kuya köbhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndakore örörëmë roo röbhe ururito, öbhe irimuumu korri wange götöra köbhang'oonera gikugira bho nabhateeyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si hano ndaayi ndasumaacha na uwe, nëndaayi ndaigöra umunyua gooo, na nöraayi örabhateebhia iga, ‘Uni ÖMÖNENE Ënooköë ndagamba iga na iga,’ öno aragötegeerre, agötegeerre; na öno arange kögötegeerra tiga aange; kugira bhayö na abhantö abhateeyu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.27",
            "verseOrgIds": [
              "EZK.3.27"
            ]
          }
        }
      ]
