      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhainyu, irihicho ria amang'ondi gaane, bhainyu na abhantö bhaane, nani në Ënooköë weinyu. Uni ÖMÖNENE Ënooköë ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
          }
        }
