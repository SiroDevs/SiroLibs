              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë aragamba iga, “Ichihamatë chino chisinyaini na Abhaisiraeri chino chaarë köbhanyankia tichirinyahaara Abhaisiraeri guiki kia amahöa gë ëmëgönga hai. Hakurua nchirëmanya iga uni nö ÖMÖNENE Ënooköë ndë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni ÖMÖNENE Ënooköë ndagamba iga, Nindiiria na körenta hamui Abhaisiraeri gukurua guchihamatë chonsui chino bhanyereganibhui kuya. Igo, nëndëkora ichihamatë chimanye iga uni nö ömöhoreeru ndë. Abhantö bha Isiraeri mbaarëmenya gönsë yaabho ëno naahaayë Yakobho ömökoramërëmo waane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarëmenya ho na ësaramita; mbarëhagaacha ichinyumba na körëma ëmësabhibhu. Mbarëmenya bhataana bhoobha kugira ichihamatë chino chaakabhanyankiri uni nindichibhörööta. Hayö nëho bhaarëmanya iga uni nö ÖMÖNENE, Ënooköë waabho ndë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
