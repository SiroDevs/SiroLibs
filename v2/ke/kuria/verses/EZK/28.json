          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö! Magakia kuya kumugi go Sitoni, ugunyeerë ënaabhi ya kuguisiira, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "öragöteebhia iga, ÖMÖNENE Ënooköë aragamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeri niritabhiribhua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
