        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
