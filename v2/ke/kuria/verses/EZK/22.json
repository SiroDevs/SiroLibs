                "loc": "EXO.20.12"
              },
              "items": [
                {
                  "text": "Ëgt 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.16"
              },
              "items": [
                {
                  "text": "Ëhë 5:16",
