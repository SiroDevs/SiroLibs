              "attrs": {
                "loc": "EXO.22.21"
              },
              "items": [
                {
                  "text": "Ëgt 22:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.22"
              },
              "items": [
                {
                  "text": "22",
