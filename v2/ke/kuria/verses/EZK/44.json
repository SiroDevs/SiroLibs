              "items": [
                {
                  "text": "Abhar 22:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhanchaama tëbharaare inyama yi itiinyi gösë ikinyunyi këno gikuurë ikiene gösë guitua na ing'iti.”",
          "type": "text",
          "attrs": {
