          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano iribhëëha reebha ho öbhaahökania gököreng'aana na amarago gaane. Guchisögökörö chonsui bhagoote amarago gaane, na imigiro geene na ichisabhato chaane ichinhoreeru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
