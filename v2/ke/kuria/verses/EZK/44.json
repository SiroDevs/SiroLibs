            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano umui waabho asookia kuigootera ibhikui, aarama guchinsikö muhungatë. Hakurua bhoono airabhia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röno arësoha ahasë ahahoreeru, kurugito ro mönsë gökora ëmërëmo, nariruusia ikimuenso ki iriraga. Uni ÖMÖNENE Ënooköë ngambërë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
