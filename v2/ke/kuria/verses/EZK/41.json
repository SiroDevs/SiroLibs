          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhisaku bhiyö wanyoorrë mbigootaini, köhayö këra gësaku nkeerë kuigöka gataigatai.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
