        },
        {
          "text": "Nkeerë ho ëgësaku këno këgootaini ke gösohera kömörengo göë ëhekaru hamui na ëkëndë ke gösohera ahasë ahahoreeru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
        },
