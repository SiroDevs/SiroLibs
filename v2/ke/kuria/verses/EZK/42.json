{
  "id": "EZK.42",
  "number": "42",
  "bookId": "EZK",
  "reference": "Esekieri 42",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
