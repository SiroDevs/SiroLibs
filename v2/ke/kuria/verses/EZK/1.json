              "EZK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Ese 10:9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano waanyoorrë ndataachërra ibhiteemöa bhiyö nnaarööchë hansë hang'i na këra gëteemöa nkëërë ho ëkëbherenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagörö gayö waanyoorrë ngatuubhaini, garabharrukia ki irigëna re sabharachati, na ituubho yaago yaarë yanga ke bhöno ökögörö körëngë mönsë yö ököndë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gaarë gusugatëra ngaarë kuya ëntahana ërë yonsui guchintahana inyai chë ëkëbhara gataihönchööyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Öbhö 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amagörö anai gayö ngaarë na ibhibherenge na ngaarë na ichisibhoku; na ibhibherenge bhiago wanyoorrë mbiichööyë amaiso ichintahana chonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ibhiteemöa bhihoru bhiyö bhiaarë kuya, amagörö gayö ngaarë kuya mbarëka yaabhio; na hano ibhiteemöa bhiyö bhiaarë kuimöka kurua hansë, amagörö gayö ngaarë kuimöka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano honsui ënkoro yaarë kuya mbiaarë kuya, na amagörö gayö ngaarë kuimöka hamui nabhio; kugira ënkoro yi ibhiteemöa bhihoru yaarëngë mönsë ya amagörö gayö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ibhiteemöa bhiyö bhiaarë kuya, amagörö gayö ngaarë kuya; hano bhiaarë kuimëërra, nago ngaarë kuimëërra; hano bhiaarë kuimöka kurua hansë nago ngaarë kuimöka hamui nabhio. Kugira ënkoro yi ibhiteemöa bhihoru bhiyö mönsë ya amagörö gayö yaarëngë.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
