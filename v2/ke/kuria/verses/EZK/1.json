          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Ese 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Öbhö 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kömasiö gaabhio anai këra ikimui nkeerë na ubhusiö bhö ömöntö göntahana ya mbere, ubhusiö bhui indui göntahana ya bhörëo, ubhusiö bhuë ëntang'ana göntahana ya bhömosi, na nyuma ubhusiö bhuë ëkoohe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabhabha abhërë ga këra gëteemöa waanyoorrë ngarambööyöë kuya igörö na gukunana, na agandë abhërë bhiibhisiri ëmëbhërë geebhio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harë honsui ënkoro yaarë gutuna kuya, mbiarë kuya; këra ikimui keebhio nkeerë kuya bhöröngë gëtasuurri ömöbhërë gookio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Öbhö 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gataigatai yi ibhiteemöa bhihoru bhiyö nkerëngë ho ëgëntö këno keerë kömaahëkana kia amakara gano gagooka ömörro, gi ichindëmë chö ömörro chino chaarë kömörëka ichintahana chonsui gatai yi ibhiteemöa bhiyö. Ömörro göyö ngorëngë köbharrukia na ibhimeniö mbiarë kömenia mo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiteemöa bhiyö mbiarë kuya mbarëëno na mbarëëno kehaara ëkëmeniö gëköbharrukia.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
