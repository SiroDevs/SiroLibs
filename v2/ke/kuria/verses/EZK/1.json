        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
