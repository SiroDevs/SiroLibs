        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëkërengiö gi ichikoohe na ömösabhibhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uwe ömoona wö ömöntö! Tega ëgëtandawiri, öteebhi Abhaisiraeri ëkërengiö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhateebhia iga uni ÖMÖNENE Ënooköë ndagamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësësöro yë ëkërengiö këyö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ëng'ana yö ÖMÖNENE ëkaanyëchëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono bhuuria abhantö abhateeyu bhayö hanga bhasësööyë ëkërengiö këyö. Bhateebhia iga ömögambi o Bhabheri naachërë Yerusaremu, akaruusia ho ömögambi na abhatangati bhaae, akabhahira Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua agatööra ho umui wë ëka yö öbhögambi, öno aakorrë nawe ubhuiguërraini, akamutuenerria. Akaruusia gönsë ëyö abhantö abhakarë akabhahira aharai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "korri öbhögambi bhöyö bhöbhe öbhörosu igo bhögoote amaiguërrano gö ömögambi o Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömögambi ömöhëa öra naatëyëëyë ömögambi o Bhabheri hano aatömërë abhantö bhaae kuya Misiri gösabha ichibharaasi na abhasirikare abhaaru. Bhoono, gösë, ömögambi öyö narëkora bhuuya? Bhoono, gösë, öyö asarri ubhuiguërraini bhooe narichaabha iribhörööta?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uni öno, ÖMÖNENE Ënooköë ndatuenerria ndagamba iga, ömögambi öyö narikuëra gönsë ya Bhabheri, gönsë ëyö ömögambi öno amötöörrë iga abhe ömögambi, sookiri agasera ugutuenerria na gösaria imuuma ëëra aakorrë nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhöheene Bharao na iricheesi reee irinene tiririmutuurria kuiihi, hano Abhabhabheri bhariicha bhamönaarri ichingito na götema öröbha korri bhaite abhantö abhaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.17",
            "verseOrgIds": [
              "EZK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikugira naaserrë ugutuenerria kööra na gösaria imuuma ëëra aakorrë gököbhoko kooe umuene na gökora amang'ana gayö gonsui; köbhöheene tarëhona hai.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö, uni öno, ÖMÖNENE Ënooköë ndatuenerria ndagamba iga, gikugira naaserrë ugutuenerria köno aakorrë kuriina reene na agasaria imuuma yaane, köbhöheene nëndëmöbhörööta bhörrö. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndeeria uruero roone igörö yaae, nawe nëndëmögootia na ömötego goone; mmuhire kuhika Bhabheri na kömökengera ikiina gikugira yö öbhökana bhöno ankoreeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amacheesi gaae gi ikuuge ngariitua na inchonge na ichintirruki nchirinyeregana guchintahana chonsui. Igo mbe, nëho mörëmanya iga uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëndagano yë Ënooköë yu ubhuiteng'eri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE Ënooköë aragamba iga, “Uni umuene nindiimukia ënsonga yö umueresi, igo, nëndësabhöra örösagia örörere gukurua guchinsagi cha igörö na kuruimia sung'unuuni kunguku ëntambë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, nindiimia örösagia röyö nsung'unuuni kunguku ëntambë ya Isiraeri korri rukiine roome amakö. Ndörëbha umueresi umuuya, na ibhinyunyi bhi imiöchö gionsui mbiriikara hansë yaago na köhagaacha amasu gaabhio guchinsagia chago. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.23",
            "verseOrgIds": [
              "EZK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö nho ëmëtë gionsui gënsë ngërëmanya iga uni ÖMÖNENE nköhongora ndë ëmëtë ëmëtambe na gukiinia ëmëtë imiëng'ë. Uni nkuihumia ndë ëmëtë ëmëbhësë na gusibhukia ëmëtë ëmiömö. Uni ÖMÖNENE ngambërë gayö na nëndakore.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
        }
      ]
    }
  ],
