        "style": "s1"
      },
      "items": [
        {
          "text": "Këra möntö na amakora gaae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
