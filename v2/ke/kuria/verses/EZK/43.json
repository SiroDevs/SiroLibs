              },
              "items": [
                {
                  "text": "2 Ich 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibhitëëmëro bhi irikëngë, mbhiraabhe ke bhiira bheene bhië ëhekaru. Gukuinaara öbhörösa bhui irikëngë ömögera ngöraabhe na öbhötambë bhui ichisentimita mërongo ëtaano na öbhögarë bhui ichisentimita mërongo ëtaano, hamui na umurigi gui ichisentimita mërongo ëbhërë na isaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana yi irikëngë ëno ëraabhe hansë bhökong'u kurua köbhörösa nëraabhe na öbhötambë bhui imiita imui. Ëntahana ëno ëragëroobhere nëratööröe nyuma gukurua kumurigi ichisentimita mërongo ëtaano kuinaara, na öbhötambë bhui ichimiita ibhërë. Ëntahana ëno ëraroobhere ëyö nëratööröe nyuma yu umurigi ichisentimita mërongo ëtaano kuinaara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ya igörö yi irikëngë, hano ibhimuenso bhirayi bhirasambëëroa, nëraabhe ichimiita ibhërë këra ntahana. Guchinguraahi chi inyumba ëno, göntahana ya këgörö nchiiraimökëërre gökëra ichindë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana yi irikëngë nërareng'aane yonsui, guchimiita isansabha këra ntahana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana ya gataigatai, nërareng'aane guchisentimiita muhungatë këra ntahana nayo nëraabhe na umurigi gui ichisentimita mërongo ëbhërë na isaano mbarëka. Haraabhe na ömögera gö öbhögarë bhui ichisentimita mërongo ëtaano na ahasë ha gökanëra kuya guikëngë göntahana ya rögörö.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögötööra irikëngë harë Ënooköë",
          "type": "text"
        }
      ]
    },
