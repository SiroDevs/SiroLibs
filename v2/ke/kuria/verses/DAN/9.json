            }
          ]
        },
        {
          "text": "Agaacha aganteebhia iga, Tanieri, niichirë gököha öbhöng'aini na ubhusisuri. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nigo ötangërë gösabha igo, Ënooköë ahunchukiri, nani nkörenteeyë irihunchukio kugira nöhanchëröë bhökong'u. Köhayö, kuruguutia ugutui kuihunchukio rënö korri ösësöre amamaaho gayö.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
