                }
              ]
            }
          ]
        },
        {
          "text": "Kömooka go gatatö göno Yehoyakimu aarë ömögambi wa Yuta, ömögambi Nebhugatinesa",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
