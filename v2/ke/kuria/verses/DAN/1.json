                "loc": "ISA.39.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ömönene akahaatëra ömögambi Yehoyakimu agootoe hamui na ëmongo yi ibhintö bhi inyumba yë Ënooköë akabhirenta gönsë ya Sinari, akabhitööra kömongo yi ichinooköë chaae.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akaruusia ëngamba harë Asibhenasi, inture waae ömönene iga, aahöre gukurua köbhanyambu bha Abhaisiraeri abhahentani bhö örösabhö rö öbhögambi na ichika cha abhasööke.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhabhe bhano bhaana ëgësösa ke götegeria, abhang'aini, bhano bhaigibhua bhuuya, abhangö bhaköngöra na bhano bhataana këbheera, korri bhabhe bhano bhaisaini gökora ëmërëmo kunyumba nköraano. Asibhenasi abhaigi gösoma na kondëka gökëgambo kia Abhagaritayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akaruusia ëngamba iga kuhika ruiso ronsui bhahabhöe ibhiakörëa na itibhaai ëëra bheene ëköhabhöa ömögambi na abantö bhaae bhö öbhögambi. Hano bhagösookia ëmeeka ëtatö gia amaigio gayö bhahiroe mbere yö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhaara bhaahööyöë mbaarëngë Tanieri, Hanania, Misaeri na Asaria, bhonsui bhayö nkurua gukiaro ke Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönene wi ichinture akabhaha amariina amahëa: Tanieri akamöröka iga Bheritësasa, Hanania akamöröka iga Sataraka, Misaeri akamöröka iga Mesaki, na Asaria akamöröka iga Abhetinego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Tanieri akanga iga taraigootere ibhikui gökörëa ibhiakörëa na kunyua itibhaai kurua kunyumba nköraano. Köhayö, agasabha ömönene wi ichinture ange körëa ibhintö bhiyö korri atakaigootera ibhikui. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ënooköë akamaahëra Tanieri amaabhë köhetera harë Asibhenasi ömönene wi ichinture. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora niigo, Asibhenasi ömönene wi ichinture noobhohërë ömögambi, köhayö agateebhia Tanieri iga, “Ömögambi agamba këno öraayi örarëa na këno öraayi öranyua, na hano ökanga kömaahëkana kia abhahentani bhandë nakanyita.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayo, Tanieri akaya kumuimirirri öno Asibhenasi ömönene wi ichinture atöörrë iga amömaahëërre hamui na bhasani bhaae bhatatö akamöteebhia iga, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tösaacha bhaitö abhakoramërëmo bhaao guchinsikö ikumi öratöha amahemba na amanchë ga kunyua. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ututuubhani na abhahentani bhandë bhano bhakörëa ibhiakörëa bhiö ömögambi, igo, ökenge ikiina köreng'ana keebhörë ndanyoore ötörööchë abhakoramërëmo bhaao.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabhaitabhiirria iga bhabhamaahëërre guchinsikö ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masëërra gi ichinsikö ikumi ëkamaahëkana iga mbaarë na ëmëbhërë imiiya na guiki abhanuru gökëra abhahentani bhaara bhaarë körëa ibhiakörëa ibhinuru bhiö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, umuimiriirri ööra akaruusia ho ibhiakörëa bhiabho na itibhaai ëëra wanyoorrë bhahaayöë iga bhanyue, akabhaha ibhiakörëa bhia amahemba bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akaha abhahentani bhanai bhaara öbhöng'aini na ubhunguri bhö öbhösomi bhua amang'oore, na naahaayë Tanieri ubhusisuri bhöa amamaaho na ibhirooto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masëërra gë ëmeeka ëtatö gëno geetöörröë nö ömögambi, Asibhenasi ömönene wi ichinture akahira abhahentani bhaara bhonsui kömögambi Nebhugatinesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi akagamba nabho bhonsui, sibhoono Tanieri, Hanania, Misaeri na Asaria bhakamötegeria bhökong'u gökëra abhandë bhaara bhonsui. Köhayo bhakabha abhairigania bhö ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora ni ibhuuriö re tuubho kë ömögambi aabhuurri, gösë ökögachania körë gonsui abhabhuurri, abhahentani bhanai bhano mboorokiri iga mbaarë abhang'aini harë ikumi bhökong'u gökëra örë wonsui wa abhakoni gösë abhachiirri bhonsui kö öbhögambi bhooe bhonsui. ",
          "type": "text",
          "attrs": {
