            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Nebhugatinesa:",
              "type": "text"
            },
            {
              "text": "Gösë Nebhugatiresa",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa Bhabheri naasohereeyë umugi go Yerusaremu na kugönaaria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
