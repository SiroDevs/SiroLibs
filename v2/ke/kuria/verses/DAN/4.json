          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gönkaaga ëyö igo bheene ubhunguri bhoone bhökandëngëra, nkaringiribhua guiki ësööko yaane, ëgöngo yaane na ubhukumahe bhö öbhögambi bhoone. Abharagiirria na abhatuurria bhaane mbaachërë guntuna, nkaringibhua kö öbhögambi bhoone na köhaabhöa ubhusuuki ge karai haara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        }
