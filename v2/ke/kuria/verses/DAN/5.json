              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " öbhögambi bhooo bhörahökanibhöa harë Abhameti na Abhaachemi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
              "DAN.5.28"
            ]
