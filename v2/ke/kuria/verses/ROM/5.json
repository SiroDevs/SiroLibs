      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atamu na Kirisitö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
