            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.19.4"
              },
              "items": [
                {
                  "text": "Sab 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ndabhuuria iga, gösë nö öbhöheene iga tëbhaiguurë ëng'ana hai? Öbhöheene mbaaiguurë. Kugira kebhörë ërendeko rëkögamba niiga,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
