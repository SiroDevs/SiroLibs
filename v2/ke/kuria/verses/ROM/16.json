              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteo, ömökoramërëmo hamui nani, abhakeerri; hamui na Rukio, Yasoni, na Sosibhita, Abhayahuti bhaitö.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
