            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndatuna kögamba harë bhainyu igörö ya musubhaati ömoitö Bhibhi öno arëngë ömökoramërëmo wë ëkanisa ya Kenkerea; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga mumuirigani kuriina riö Ömönene keebhörë këragërë köbhantö bhë Ënooköë. Mömöhe ubhutuurria bhörë bhonsui bhöno ndanyoore aratuna gukurua harë bhainyu, kugira we umuene naarëngë umutuurria köbhantö abhaaru na ninyoora harë uni umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.2"
              },
              "items": [
                {
                  "text": "Ama 18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mönkeerri Bhirisika na Akuira, abhakoramërëmo hamui nani harë Kirisitö Yesö, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhano bhaairuusiri gikugira yö öbhöhoru bhoone. Nkuruusia ndë umukumo, na tiiga nu uni bheene hai, gëtatiga ninyoora ni ichikanisa chonsui cha Abhabhagani nkuruusia chërë umukumo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri ëkanisa ëëra igusikana kunyumba yaabho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri ömögonche waane Ebhaineto, öno aarëngë öwambere kugukumia harë Kirisitö köröng'ongo ro Asia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Mariamu öno aakoorrë ëmërëmo bhökong'u harë bhienyu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Anderoniko na Yunia, abhantö bha Abhayahuti bhaitö, bhano toorëngë hamui gökëbhohe; bhö mbaamanyëkainë bhökong'u köbhatömöa, nabho mbaabhaayë abhakirisitö mbere ntarakumia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Ambiriato, ömögonche waane kö Ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Aribhano ömökoramërëmo hamui na bhaitö harë Kirisitö, na ömögonche waane Sitakisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Abhere, öno öbhöheene bhooe harë Kirisitö bhooherekibhöa. Mönkeerri abhantö bhonsui bhu umugi go Arisitobhuro. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Herotiona, Umuyahuti weitö. Mönkeerri abhantö bhu umugi go Narikisi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Turubhena na Turubhosa bhano bhaagökora ëmërëmo bhökong'u kö Ömönene, na ömögonche waane Bherisisi öno agökora ëmërëmo kö Ömönene nö ömökea. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.21"
              },
              "items": [
                {
                  "text": "Mk 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mönkeerri Rubho, öno arëngë ömoohöröa kö Ömönene, na nyaköwaabho öno arëngë guiki bhaabha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Asinkirito, Bhuregeoni, Herime Bhatorobha, Herima na bhamura bha moitö bhano bharëngë hamui nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mönkeerri Bhirorogo na Yuria, Nerea na musubhaati omoobho, na Orimba na abhantö bhonsui bhano bharëngë hamui nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mökeerani abhiene kubhiene na ënaamuuno ënhoreeru. Mökeeriibhöë na ichikanisa chonsui cha Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirriö ga gösokeerria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhantö bhaitö, ndabhagëya iga muiraarërre na bhaara bhakörenta öbhösarakania na öbhökong'u na ubhusinkania bhoa amaigiö gano möigiibhöë. Möbhe harai na abhantö bhayö. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.17",
            "verseOrgIds": [
              "ROM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira abhantö bhano bhanga bhayö tëbhagökorra Ömönene weitö Kirisitö hai, gëtatiga ichinda chaabho bheene. Kömang'ana gaabho amaiya na guchisumaacho chaabho nköng'ainirria bharë abhantö abhaheene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhaigua igörö yu ubhuiguiri bhoinyu bhui igichiirate, na gikugira yi ikibhune këyö nëëna ëmëgooko na bhainyu. Ngatuna ndë möbhe abhang'aini gökëno kërëngë ikiiya, sibhoono möbhe kia abhakangi igörö ya këno kërëngë ikinyanku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Ënooköë öno arëngë ënsëmöka yö ömörembe mböngö araminyongore Setani hansë ya amagörö gainyu. Ësaramita yö Ömönene weitö Yesö ëbhe hamui na bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
