              "items": [
                {
                  "text": "Isa 28:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "rëno erendeko rëkögambëra iga,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
