            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Öbh 3:5,6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkömaaha ndë iga imiiriiro gëno tukunyoora gönkaaga ëno ya bhoono tëgëkareng'aana ninyoora hakë nu ubhuhiku bhööra bhörëhönyöröa harë bhaitö hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bhionsui bhino Ënooköë aateemërë nköganya bhirë kögoorio ënene röno bhirëhönyörröa abhaana bhë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.17+GEN.3.18+GEN.3.19"
              },
              "items": [
                {
                  "text": "Ögt 3:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira Ënooköë naakengërë ikiina iga bhionsui bhino aateemërë ni ibhintö bhuchua, tiiga iga ngököhancha koobhio ibhiene hai, getatiga në Ënooköë umuene aahanchërë iga këbhe ke igo. Ninyoora niigo iriiteng'ero nho rërë, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga ibhiteemöa bhionsui mbirëtachöröa kurua gökëbhohe kiö öbhösariku, na gösanga öbhötachörë bhu ubhuhiku bhöa abhaana bhë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira ntömanyërë iga kuhika ënkaaga ëno ya bhoono bhionsui bhino aateemërë ngökema bhirë köbhörrö bhöno bhonga ibhisa bhiö ömökari öno agutuna kuibhora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.2+2CO.5.3+2CO.5.4"
              },
              "items": [
                {
                  "text": "2 Ko 5:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono tiiga iga mbiira Ënooköë aateemërë ibhiene hai, gëtatiga ninyoora mbaitö bhano tööna amakö ga mbere ga Nkoro ngökema törë mönsë yeitö abhiene, nkaaga tököganya kögoorio ënene iga Ënooköë atökore abhaana bhaae, na, öbhöhobhoribhöa bhöë ëmëbhërë geitö. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira kuriiteng'ero rëyö ntoonyoorrë ubhuituuria. Iriiteng'ero rëno raisa kömaahoa, rëyö tiiteng'ero hai. Kugira ning'ui aguiteng'era ëgëntö këno akömaaha? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano ndanyoore töraiteng'era këno tötakömaaha, ntörakëganye kögoorio ënene kubhugumiirria.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkeebhöyö bheene Nkoro nawe agututuurria na bhaitö köbhörosu bhoitö. Kugira tëtömanyërë kebhörë këragërë iga tösabhe; sibhoono Nkoro umuene ngötösabhëra arë kö Ënooköë kuguitumata köno götagaasumaachëroa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawë, öno akömaaha ahikia kumioyo geitö, nkömanya arë amaitegeerro ga Nkoro kebhörë garë; gikugira Nkoro ngösabhëra arë abhantö bhë Ënooköë gököreng'aana na öbhöhanchi bhöë Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaitö ntömanyërë iga kömang'ana gonsui Ënooköë ngökora arë ëmërëmo imiiya hamui na bhaara bhamöhanchërë, bhaara aabhërëkëëyë gököreng'aana na irituno reee. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira bhaara Ënooköë aamanyërë kurua karai naabhaang'ooreeyë iga bhatuubhanane na Ömoona waae, korri iga Ömoona öyö abhe ömötangi köbhaana bha moobho abhaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo bhaara Ënooköë aang'oorrë kurua gönsëmöka, naabhabhërëkëëyë; na bhaara aabhërëkëëyë, naabhakorrë abhaheene; na bhaara aakoorrë abhaheene, naabhahaayë ubhuhiku.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhöhanchi bhöë Ënooköë harë Kirisitö Yesö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkë mbe tökagamba kögayö gonsui? Hano ndanyoore Ënooköë ngöntahana yeitö arëngë, ning'ui agatuisiira? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë taangëëyë Ömoona waae ömömoomui hai, sibhoono naamuruusiri gikugira yeitö bhonsui! Niyekë ëraabhe iga hamui nawe angë götöha ibhintö bhionsui? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui arëchöngëra abhaahöroa bhë Ënooköë? Ënooköë wë umuene nköbhabharra arë öbhöheene! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'ui mbe arëbhaihiima? Nkirisitö Yesö, öno aakuurë, öno aariökërë kurua köbhaku, öno arëngë bhörëo bhöë Ënooköë, öno köbhöheene agötösabhëra! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana nkë, këgatoohokania kurua köbhöhanchi bho Kirisitö? Gösë ni inyaanyi, gösë isina, gösë imiiriiro, gösë inchara, gösë öbhötaka, gösë ëtabhaaribhaaria, gösë uruku? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.22"
              },
              "items": [
                {
                  "text": "Sab 44:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kebhörë ërendeko rëkögamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    }
