              ]
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Yosua iga, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teebhi Abhaisiraeri iga, ‘Ahöra imigi giö öbhöng'osero gëno ömöntö akaang'osera ëgaareeya gëno naateebhiri Mösa iga agöteebhi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ömöntö örë wonsui aita ömöntö atahanchërë ang'ösera ku gumui googio igo aibhechia ömöhakani wi igisiomba kia amaanyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuiti ang'ösera ku gumui gui imigi gëyö aimëërra kuihita reego na göteebhia abhagaaka bhu umugi këno këmöbheereeyë. Abhagaaka bhamösohia mo nawe amenya hamui nabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore ömöntö ööra agutuna köhakana igisiomba amöhaangërë kuhika kumugi göyö, abhagaaka bhu umugi bhatagaacha kurichokia umuiti gucha harë we, kugira ndanyoore nkuiyeega iribhëëbhë aitërë, tibhubhisa bhoorë harë bho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuiti öyö agenderria kömenya kumugi göyö kuhika hano aarëkengeroa ikiina mbere yu umuiraniö umugima gua Abhaisiraeri na guiki kuhika hano umunchaama ömönene öno aarë ho gönkaaga ëyö arikua. Nëho bhoono umuiti öyö aririinga waabho kumugi gööra aang'osërë kurua.’”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, bhakaahöra imigi gënö: Katesi göno görëngë Gariraya guchinguku cha Nabhutari, Sekemu guchinguku cha Ebhuraimu na Kiriati-aribha, ngo Hebhuroni, gönsë yi ichinguku cha Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ihumbu ya Yorotani, rögörö yu umugi go Yeriko, bhakaahöra umugi go Bheseri göno görëngë guiköngö ri iritendeere, gono goorë gui ikiaro ke Rubheni. Guiki bhakaahöra Ramoti göno görëëngë Gireati yi ikiaro ke Gati na Gorani Bhasani haara gukiaro ke Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gëyö ngio imigi gëno geehööyöë gikugira ya abhantö bhonsui bha Isiraeri na abhaitongo bhano bhaamenyërë harë bho, korri iga ömöntö örë wonsui araite öwöndë atahaanchërë ang'ösera mo atagaacha guitöa na öno agutuna köhakana igisiomba kia amaanyinga, kuhika hano arëkengeroa ikiina mbere yu umuiraniö umugima.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
