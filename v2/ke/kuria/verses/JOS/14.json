                "loc": "NUM.34.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12+DEU.3.13+DEU.3.14+DEU.3.15+DEU.3.16+DEU.3.17"
              },
              "items": [
                {
                  "text": "Ëhë 3:12-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira wanyoorrë Mösa aaha ibhiaro bhibhërë na iritene bhiira irirëma reebho ëntahana rögörö ya Yorotani, sibhoono Abharawi bho tëbhaahaayöë hasë hamui nabho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruiboro ro Yusubhu ndoorë ibhiaro bhibhërë: Manase na Ebhuraimu. Na Abharawi tëkeehaayöe söro ërë yonsui yë ënsë, gëtatiga imigi ge kömenya bheene na ibhiriisiriö bhi ichitugo chaabho na ibhiakörea bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Abhaisiraeri bhagatuenana ënsë keehaara bheene ÖMÖNENE aasimisiiyi Mösa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karebhu arahaabhöa umugi go Hebhuroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
