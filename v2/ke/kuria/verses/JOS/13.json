              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.1"
              },
              "items": [
                {
                  "text": "Ëhë 18:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiaro ke Rawi tëkeehayöë rëma rërë rionsui hai. Gëtatiga Ibhimuënso bhiö ömorro bhino bhaaruusiiyi ÖMÖNENE Ënooköë wa Isiraeri mbio bhiabhaayë ësöro yaabho, keebhööra ÖMÖNENE aasimisiiyi Mösa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öröng'ongo röno Rubheni aahaayöë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana yi irirëma ëno Mösa ahaayë ikiaro ke Rubheni gököreng'aana na ichika chaabho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.15",
            "verseOrgIds": [
              "JOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaatangëëyë Aroeri mbarëka yi iribhatë re Arinoni nu umugi göno goorë kuibhatë rëyö hamui na ënsë yonsui yi iritendeera re Metebha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesibhoni hamui ni imigi gionsui gëno geerë guitendeera: Tibhoni, Bhamoti-bhaari, Bheti-bha ari-meoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahasa, Ketemoti, Mebhati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.18",
            "verseOrgIds": [
              "JOS.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriataimu, Sibhuma, Sereti-sahari, kögëkerege ki iribhatë rëyö, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.19",
            "verseOrgIds": [
              "JOS.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheeti-beori, ibhing'araario bhi inguku ya Bisiga, Bheti-yesimoti ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.20",
            "verseOrgIds": [
              "JOS.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni imigi gionsui gi iritendeera, ënsë yonsui ö ömögambi Sihoni wa Abhaamori öno agambëëyë Hesibhoni; Mösa wanyoorrë aakëra Sihoni öyö hamui na abhatangati Abhamitiani, Ebhi, Rekemu, Suri, Huri na Rebha, bhano bhagambëëyë ënsë kwibhaga riö ömögambi Sihoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.21",
            "verseOrgIds": [
              "JOS.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaamu ömoona o Bheori umuchiirri, öno Abhaisiraeri bhaitirë gunchonge naarë umui waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.22",
            "verseOrgIds": [
              "JOS.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëbhaga ya ënsë yi ikiaro ke Rubheni göntahana ya nyancha na ömooro go Yorotani goorë. Imigi ni chigötaroa hayö ncho ichintahana chino abhantö bhi ichika chi ikiaro ke Rubheni bhaahaayöe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öröng'ongo röno Gati aahaayöë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana yi irëma ëno Mösa aahaayë abhantö bhi ikiaro ke Gati gököreng'aana ni ichika chaabho ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeerë: Yaseri, imigi gionsui ge Gireati niritene rië ënsë ya Abhaamoni kuhika Aroeri gëno geerë rögörö ya Rabha, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "guiki gukurua Hesibhoni kuhika Ramati-misibhe, Bhetonimu, na gukurua Mahanaimu kuhika Tebhiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "bhöyö bheene kumigi gëno geerë kuibhatë Bheti-nimura, Sukoti na Sabhoni na ënsë yonsui ëno yaarë iyö ömögambi Sihoni wa Hesibhoni; ëntahana ëyö yarëëngë rögörö ya Yorotani na gusinyana na ëntahana ya sööchë yi inyancha ya Kinereti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigi ni ichimberi chaagio ngio bhaahaayë abhantö bhi ikiaro ke Gati gököreng'aana na ichika chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        }
      ]
    },
