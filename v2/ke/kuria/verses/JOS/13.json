              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki Mösa wanyoorrë aahaayë iritënë ri ikiaro ke Manase gököreng'aana na ichika chaaho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
