          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ëntahana yi irirëma götangëra Mahanaimu kuhika köbhösohero bhöë ënsë yonsui yö ömögambi Ogu wa Bhasani, hamui na imigi mërongo ësansabha ge Yairi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
