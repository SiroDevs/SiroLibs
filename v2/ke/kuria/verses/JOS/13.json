          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "iritënë re Gireati, Asitaroti, Etirei, rëno reerë kö öbhögambi bho Ogu wa Bhasani; ëntahana ëyö yaahaanëröë guitënë riu uruibhörö rua abhaana bha Makiri ömoona o Manase, köreng'aana na ichika chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
