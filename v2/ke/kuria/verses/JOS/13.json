            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Ëbh 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Ëhë 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikiaro ke Rubheni, Gati, ni iritënë rëndë rië ikiaro ke Manase wanyoorrë bhahaayöë ënsë ëno yaarë rögörö ya Yorotani, ke bhööra ÖMÖNENE asimisiyi ömökoramërëmo waae Mösa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëntahana yaabhö yaatangëëyë Aroeri kunguguni yi iribhatë re Arinoni na umugi gööra goorë gataigatai yi iribhatë, na ënsë yonsui yi irihancha gukurua Metebha kuhika Tibhoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamui ni imigi giö ömögambi Sihoni wa Abhaamori, öno agambëëyë Hesibhoni kuhika köbhaga ya Abhaamoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamui na ënsë ya Gireati, ëntahana ya Abhagesuri na Abhamaakati, inguku ya Herimoni na ënsë yonsui ya Bhasani kuhika Sereka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na öbhögambi bhonsui bho Ogu umui wa Abharebhai bhano bhatamërë, öno agambëëyë Asitaroti na Etirei ya Bhasani. Mösa wanyoorrë aakëra bhayö bhonsui na köbharugia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora nigo, Abhaisiraeri tëbharugiri Abhagesuri gösë Abhamaaka gëtatiga mbamenyërë harëbho kuhika reero igo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
