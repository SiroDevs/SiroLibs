      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhagambi bhonsui bha Abhaamori bhano bhaarë nyancha ihumbu ya Yorotani, na abhagambi bhonsui bha Abhakanaani bhano bhaarë mbareka ya Nyancha ya Metiterania bhaaiguurë keebhörë ÖMÖNENE aakamukiri amanchë ga Yorotani kugira ya Abhaisiraeri kuhika bhakaröbhöka bhonsui, imioyo geebho ngeeng'örörökërë, bhakahaha, bhakoobhoha gikugira ya Abhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ësaaro Girigari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö, ÖMÖNENE agateebhia Yosua iga, “Tura ibhikebhi kurua kömagëna amaköng'u ösaare Abhaisiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Yosua agatura ibhikebhi bhia amagëna amaköng'u na agasaara Abhaisiraeri Gibhea-haararoti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:3",
              "type": "text"
            },
            {
              "text": "Gibhea-haararoti:",
              "type": "text"
            },
            {
              "text": "Ësësöro yayo ni inguku ya amachöbhö.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Ëbh 14:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yosua naasaarre Abhaisiraeri gukibhune iga: Abhasaacha bhonsui Abhaisiraeri bhano bhaaruurë Misiri, bhano bhahikiri ëmeeka gekuya kuiihi, mbaakuërëëyë körögendo guiköngö nkaaga bhaatëkërë kurua gönsë ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora bhonsui bhano bhaaruurë Misiri nkanyoora mbasaarre, si bhaara bhonsui bhaibhörëëyöë körögendo guiköngö nkaaga bhaarë kurua Misiri, tëwanyoorrë bhaasaaroa hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira Abhaisiraeri mbaagendërrë örögendo guiköngö ëmeeka mërongo ënai kuhika abhasaacha bhonsui bhë ëhamatë ëyö bhano wanyoorrë bhaana ëmeeka ge kuya kuiihi bhagakua gikugira tëbhaiguërëëyë ëngamba yö ÖMÖNENE. ÖMÖNENE harë bho naatuenerreeyi iga taakabhatiga bhamaahe ënsë ëno aatuenerreeyi bhaaguuka götöha, ënsë ëno ëkögera amabheere na öbhöökë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö abhaana bha abhantö bhayö mbo ÖMÖNENE aakiiniri kuibhaga reebho, na bhayö mbo Yosua aasaarrë gönkaaga ëëra bhaarë körögendo guiköngö kugira tëwanyoorrë bhaasaaroa hai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ësaaro yë ëhamatë yonsui yaasirre, mbaaikaayë kömasanchö gaabho kuhika bhakahuena. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Yosua iga, “Reero mbaruusiiyi ho ichinsoni cha Abhamisiri.” Köhayo ahasë haara hakarököa iga Girigari",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:9",
              "type": "text"
            },
            {
              "text": "Girigari:",
              "type": "text"
            },
            {
              "text": "Ësësöro yi iriina rëyö niiga “Ukuruusiribhua ho.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuhika reero eno.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
