    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öröng'ongo röno Ebhuraimu na Manase ya nyancha bhaahaayöë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irirëma rëno abhaana bha Yusubhu bhaatuenëyöë kögëkoobhöë ndëtangëëyë hang'i nö ömooro go Yorotani, rögörö ya ichinyöörrö cha Yeriko, rëkahetera guiköngö kuhika guchintahana chi ichinguku na kuhika Bheteri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Bheteri ëbhaga ëkëgëëra Rusu ëkaheta Ataroti harë Abhawaariki bhaamenyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
            "verseOrgIds": [
              "JOS.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ëgasëkëra nyancha gönsë ya Abhayabhureti kuhika Bheti-horoni ya Nsë na Geseri na gösërra Nyancha ya Metiterania. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruibhöro ro Yusubhu, nko kögamba iga ikiaro ke Manase na ikiaro ke Ebhuraimu mbaahaayöë irirëma rëyö köbha ömöndö goobho.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebhuraimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro ke Ebhuraimu gököreng'aana na ichika chaabho mbaahaayöë irirëma reebho rëno ëbhaga yario göntahana ya rögörö yahetërë Ataroti-atari kuhika Bheti-horoni ya igörö, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gösërra Nyancha ya Metiterania. Göntahana ya mööchë ëbhaga yahetërë Mikimetati na rögörö yayo yainaarrë ëkagëëra Tanati-siro hano yaheteeyë ëntahana ya rögörö na kuhika Yanoa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Yanoa ëkaya kuhika Ataroti na Naara, na kuhika Yeriko, harë yasërëëyë kömooro go Yorotani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua Tabhua, ëbhaga ëkagëëra nyancha kuhika kögëtabhöka ge Kana na gösërra Nyancha ya Metiterania. Rëno ndio irirëma rëno ikiaro ke Ebhuraimu keehaayöë gököreng'aana na ichika chaabho, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.8",
            "verseOrgIds": [
              "JOS.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamui na imigi na ichimberi chino bhiengeribhöë, kurua gukiaro ke Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.29"
              },
              "items": [
                {
                  "text": "Abh 1:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhaebhuraimu tëbhaarugiri Abhakanaani bhano bhamenyërë Geseri. Abhakanaani bhayö mbaagenderreyi kömenya hamui na Abhaebhuraimu kuhika reero igo, bharëëngë abhagöre bhagökora ëmërëmo ge köhaamiirribhöa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.10",
            "verseOrgIds": [
              "JOS.16.10"
            ]
          }
        }
      ]
    }
  ],
