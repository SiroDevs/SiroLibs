          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano bhaasookiri gutuenana irirëma rië ënsë, Abhaisiraeri mbaatueneeyë Yosua ömoona o Nuni, irirëma gataigatai yaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gököreng'aana na ëngamba yö ÖMÖNENE mbaamöhaayë mugi göno ainëënërë umuene, nago Timunati-sera, göno goorë gönsë yi ichinguku cha Ebhuraimu. Nawe akagöhagaacha bhöhëa na kömenya mo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
