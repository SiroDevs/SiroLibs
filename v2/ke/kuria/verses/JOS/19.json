              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mböyö mbe, umunchaama Ereasari na Yosua, ömoona wa Nuni, hamui na abhatangati bhi ibhiaro bhië ëhamatë ya Isiraeri baatuenerë amarëma gayö kögëkoobhoe mbere yö ÖMÖNENE kuihita ri iritunteera re gusikanëra Siro haara. Igö, bhagasookia gutueena irirëma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
