              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.27+JDG.18.28+JDG.18.29"
              },
              "items": [
                {
                  "text": "Abh 18:27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano Abhantö bhi ikiaro ge Tani bhaarusiibhöe irirëma reebho, mbaagëëyë guitania umugi go Resemu; bhakagökëra na kögögoota. Na hano bhaasookiri guita gunchonge abhamenyi bhaago bhonsui mbaagömerri na köhönchöra iriina reego köbha iga Tani, iriina re guuka waabho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rëyö ndio irirëma rëno ikiaro ge Tani na ichika chaakio keehaayöë.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
