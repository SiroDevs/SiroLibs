          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Tori wö ömöndaara go Nabhati-tori, ömögambi wa Goimu Girigari haara na ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
