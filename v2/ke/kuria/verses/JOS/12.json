        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yosua hamui na Abhaisiraeri bhagakëra abhagambi bhonsui abhië ëntahana yonsui ya nyancha yö ömooro go Yorotani, kögötangëra Bhaari-gati guitendeera re Rebhanoni kuhika kunguku inchua ya Haraki göntahana ya sööchë hang'i na Seiri. Yosua akaha ibhiaro bhia Abhaisiraeri ichinsë chiyö köbha ahasë haabho gököreng'aana na keebhörë wanyoorrë hööröa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichinsë chiyö nchaarë guchintahana chi ichinguku, amatendeera, ëntahana ya Arabha, ibhigörö bhi ichinguku, ichintahana chi iriköngö na ëntahana ya Negebhu. Ichinsë chino nchaarë icha Abhahiti, Abhaamori, Abhakanaani, Abhabheresi, Abhahibhi na Abhayebhusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagambi bhano bhaakërröë mbano: Ömögambi wa Yeriko, ömögambi wa Ai wu umugi göno goorë hang'i na Bheteri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.9",
            "verseOrgIds": [
              "JOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Yerusaremu, ömögambi wa Hebhuroni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.10",
            "verseOrgIds": [
              "JOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Yarimuti, ömögambi wa Rakisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.11",
            "verseOrgIds": [
              "JOS.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
