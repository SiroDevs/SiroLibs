          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Tebhiri, ömögambi wa Geteri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.13",
            "verseOrgIds": [
              "JOS.12.13"
            ]
          }
        },
