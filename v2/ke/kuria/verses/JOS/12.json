          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Simuroni-meroni, ömögambi wa Akisabhi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.20",
            "verseOrgIds": [
