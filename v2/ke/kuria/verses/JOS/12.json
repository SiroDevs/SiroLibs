                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Ëbh 21:21-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Ëhë 2:26—3:11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo abhagambi bhano Abhaisiraeri bhaakërrë na kuimukia ënsë yaabho yonsui ënö yaarë rögörö rö Yorotani gukurua kuibhatë riö ömooro go Arinoni kuhika kunguku ya Herimoni na gönsë yonsui ya Arabha göntahana ya rögörö: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögambi Sihoni wa Abhaamori öno aamenyërë Hesibhoni na kögambëra kurua Aroeri harë igitumbe keee kiö öbhögambi keerë, umugi göno goorë köbhaga yi iribhatë mbarëka ya Arinoni. Guiki naagambëëyë kögötangëra gatai yi iribhatë kuhika ömooro go Yabhoki göno goorë ëbhaga yë ënsë ya Abhaamoni, nko kögamba iga iritënë rië ënsë ya Gireati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki naagambëëyë ënsë yonsui ya Arabha, Inyancha Inku, gukurua kunyancha ya Kinereti, göntahana ya rögörö, kuhika Bheti-yesimoti Nyancha Inku na kögenderria kuhika hansë yi inguku ya Bhisiga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wöndë nö ömögambi Ogu umui wa Abharebhai bhano bhaatigaayë, öno agambëëyë Bhasani na kömenya Asitaroti na Etirei. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhögambi bhooe mboorandërë kunguku ya Herimoni, Sareka, Bhasani yonsui kuhika guchibhaga cha Abhagesuri na Abhamaaka, iritënë re Gireati, kuhika ichibhaga chi ënsë yö ömögambi Sihoni wa Hesiboni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Ëbh 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Ëhë 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mösa, ömökoramërëmo wö ÖMÖNENE, na abhantö bha Isiraeri mbaakërrë abhagambi bhayö, akaimukia ichinsë chaabho akaha ibhiaro bhia Rubheni, Gati na iritënë ri ikiaro ke Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhagambi bhayo bhaakërröë na Yosua",
          "type": "text"
