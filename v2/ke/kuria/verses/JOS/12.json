          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Ketesi, ömögambi wa Yokineamu wu umugi göno goorë kunguku ya Karimeri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
