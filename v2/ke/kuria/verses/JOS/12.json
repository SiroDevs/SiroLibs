          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Tanaki, ömögambi wa Megito, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
