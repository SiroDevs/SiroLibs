          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Horima, ömögambi wa Arati, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.14",
            "verseOrgIds": [
              "JOS.12.14"
            ]
          }
        },
