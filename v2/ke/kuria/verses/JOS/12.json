            "sid": "JOS 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ömögambi wa Egironi, ömögambi wa Geseri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.12",
            "verseOrgIds": [
              "JOS.12.12"
            ]
          }
        },
        {
