              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49"
              },
              "items": [
                {
                  "text": "Yos 19:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.50"
              },
              "items": [
                {
                  "text": "50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nabho bhakamötökëra kuirobha reee rëno wanyoorrë aahaabhöa, Timinati-seari, kunguku ya Ebhuraimu, mööchë yi inguku ya Gaasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
