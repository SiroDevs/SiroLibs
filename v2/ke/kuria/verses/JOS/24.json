            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri mbaakoreeyë ÖMÖNENE ëmërëmo guchinsikö chonsui cha amabhaho ga Yosua. Na hano aakuurë, mbaagendereeyi gökoorra ÖMÖNENE ëmërëmo guchinsikö chonsui cha amabhaho ga abhagaaka bhaara bharööchë amang'ana garë ÖMÖNENE akoreeyë Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
