          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano amang'ana gayö gaasirrë, Yosua ömoona o Nuni na ömökoramërëmo wö ÖMÖNENE agakua ana ëmeeka irigana rimui na ikumi (110) ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
