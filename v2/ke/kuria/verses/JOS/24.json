                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Ëgt 23:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.20"
              },
              "items": [
                {
                  "text": "Ëhë 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naatömëre ibhigui mbere yeinyu bhino bhiaarugiri abhagambi bhabhërë bha Abhaamori. Tigunchonge yeinyu gösë köbhöta bhoinyu hai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        }
      ]
