              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yosua agaköma ibhiaro bhionsui bhia Isiraeri Sekemu haara. Akabhërëkëra abhagaaka, abhatangati, abhahökania na abhaimiriirri bha Abhaisiraeri, nabho bhagaacha mbere yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.1",
            "verseOrgIds": [
              "JOS.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.27"
              },
              "items": [
                {
                  "text": "Ögt 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yosua agateebhia Abhantö bhonsui iga, ÖMÖNENE, Ënooköë wa Isiraeri aragamba iga, “Karai hayö, bhaaguuka bhainyu mbaamenyërë ihumbu yö ömooro go Yubhurati, bhagaseengera ichinooköë chindë. Tera isawaabho Abhurahamu na Nahori nu umui waabho aarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.2",
            "verseOrgIds": [
              "JOS.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.1+GEN.12.2+GEN.12.3+GEN.12.4+GEN.12.5+GEN.12.6+GEN.12.7+GEN.12.8+GEN.12.9"
              },
              "items": [
                {
                  "text": "Ögt 12:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.1+GEN.21.2+GEN.21.3"
              },
              "items": [
                {
                  "text": "Ögt 21:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uni Ënooköë naaruusiri guuka weinyu Ibhurahamu ihumbu yö ömooro go Yubhurati na kömörenta Kanaani, harë naamöhaayë uruibhöro örooru. Naamöhaayë Isaaka, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.3",
            "verseOrgIds": [
              "JOS.24.3"
            ]
          }
        },
        {
