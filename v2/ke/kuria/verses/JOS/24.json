                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isaaka nawe nkamöha Yakobho na Esau. Nahaaye Esau ichinguku cha Seiri achiigari. Sibhoono Yakobho na abhaana bhaae mbaagëëyë Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ëgt 3:1—12:42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ngatöma Mösa na Haruni, nkarentera ënsë ya Misiri amatemo, igo nkabharuusia gönsë ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
