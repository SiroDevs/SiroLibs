              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhoono mötasööka ÖMÖNENE na kömökorra ëmërëmo kömooyo ömörabhu na öbhöheene. Mötatabhuta harai ichinooköë chiira bhaaguuka bhainyu bhaagaseengeyë ihumbu yo omoono go Yubhurati na gönsë ya Misiri. Mökorre ÖMÖNENE ëmërëmo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.14",
            "verseOrgIds": [
              "JOS.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mötagutuna kömökorra ëmërëmo, aahöra reero öno mörakorre ëmërëmo; ndanyoore ni ichinooköë chiira bhaaguuka bhainyu bhaaseengeeyë Mesobhotamia, gösë ichinooköë cha Abhaamori bhano mömenyërë gönsë yaabho. Si uni na umugi goone, nö ÖMÖNENE törakorre ëmërëmo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        }
      ]
    },
    {
