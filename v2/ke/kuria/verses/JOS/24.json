            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.1+JOS.6.2+JOS.6.3+JOS.6.4+JOS.6.5+JOS.6.6+JOS.6.7+JOS.6.8+JOS.6.9+JOS.6.10+JOS.6.11+JOS.6.12+JOS.6.13+JOS.6.14+JOS.6.15+JOS.6.16+JOS.6.17+JOS.6.18+JOS.6.19+JOS.6.20+JOS.6.21"
              },
              "items": [
                {
                  "text": "Yos 6:1-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua mökaröbhöka Yorotani, mökahika Yeriko. Abhamenyi bha Yeriko bhakabhaitania. Na guiki bhano mbaabhaitaini: Abhaamori, Abhabherisi, Abhakanaani, Abhahiti, Abhagirigasi, Abhahibhi na Abhayebhusi. Bhayö bhonsui nkabhahaatirria kömabhoko gainyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
            {
