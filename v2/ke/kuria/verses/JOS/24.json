              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Naabhahaayë ëmëgöndö gë ëmësabhibhu gëno mötaarëmërë, na imigi gëno mötahagaachërë gëno mömenyërë, na körea amakö gë ëmësabhibhu na ëmësaituni gëno mötaimiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
