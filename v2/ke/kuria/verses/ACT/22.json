          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömökönaare ööra akagamba iga, “Uni nnaabha Umurumi gököhakana ichimbiria ichincharu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
