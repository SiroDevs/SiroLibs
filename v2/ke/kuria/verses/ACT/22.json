          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ho hayö igo, abhantö bhano wanyoorrë bharaya kubhuuria Bhauro amang'ana, bhakaringa nyuma kurua harë we; ömökönaare ööra akoobhoha hano aaiguurë iga Bhauro nu Umurumi aarëngë, kugira wanyoorrë aisërë kömöbhoha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro mbere yi inchaama ya Abhayuti",
          "type": "text"
        }
      ]
    },
