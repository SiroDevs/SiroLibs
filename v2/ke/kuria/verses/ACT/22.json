          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhauro akamuhunchukiria iga, “Ee-e.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        }
