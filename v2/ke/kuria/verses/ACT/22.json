              "ACT.22.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.34+ACT.5.35+ACT.5.36+ACT.5.37+ACT.5.38+ACT.5.39"
              },
              "items": [
                {
                  "text": "Ama 5:34-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uni nu Umuyahuti ndë, öno nibhörëëyöë Tariso ëno ërëngë Kirikia, sibhoono Yerusaremu nkënëëyë, ndëngë umuëga wa Gamarieri. Nnaaigiibhui bhökong'u ökögoota imigiro ge bhaguuka bhaitö, na nnaaitöörrë kö Ënooköë kehaara bhainyu bhonsui mörëngë hano reero. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Ama 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naairiirri abhantö bhano bhaasoraini Ënchëra ëno kuhika ugukua. Nnaagootërë abhasaacha na abhagaikörö ndabharekera chëëra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyoora nu umunchaama umuhikërë hamui na inchaama yonsui mbakaherekia iga nö öbhöheene nkögamba. Naanyoorrë kurua harë bho ichinyarubha chino chandëkëëyöë Abhayahuti bhamura bha ömoito kumugi go Tamesike, köhayö nnaagëëyë ho köbhagoota na köbharenta Yerusaremu bhaabhohërë na iminyorro korri bhaache kuiriiribhua.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro aragamba keebhörë aaihönchööyë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hano wanyoorrë ndaya na nhikërë hang'i na Tamesike, ömöbhasö gatai, öbhörabhu öbhöbharruku kurua kuriöbha bhökambarrukiria ho hayö igo bhökanyinaara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.6",
            "verseOrgIds": [
              "ACT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkagöa hansë, nkaigua ëngamba ëranteebhia iga, ‘Sauri, Sauri! Kugira kë ukunyiriiria?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkabhuuria iga, ‘Ömönene, kana nuwe ng'ui?’ Aganteebhia iga, ‘Nu uni Yesö o Nasareti, öno ukuiriiria.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhaara bhaarëngë hamui na nani mbaarööchë öbhörabhu bhööra, sibhoono tëbhaaiguurë ëngamba ëëra ya ööra aagambërë nani hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.9",
            "verseOrgIds": [
              "ACT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamubhuuria iga, ‘Bhoono niiga nkore kë Mönene?’ Ömönene nawe aganteebhia iga, ‘Taimöka uyi Tamesike nëho örateebhiribhue kërë Ënooköë agutuna iga ökore.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaahukuuyë gikugira öbhörabhu bhööra, köhayö, bhano toorëngë nabho bhakandahuuna kuya Tamesike.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kumugi göyö nkanyoora ömöntö wöndë iga Anania, öno aagasengeeyë Ënooköë na guiki naagootërë imigiro geitö na Abhayahuti bhonsui abhamenyi bha hayö mbaamösöökërë bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.12",
            "verseOrgIds": [
              "ACT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanyëchëëyë, akaimëërra hang'i na uni, akamböörra iga, ‘Mura ömoitö Sauri, tamaaha guiki!’ Ho hayö igo bheene nkaramukia nkamömaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.13",
            "verseOrgIds": [
              "ACT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aganteebhia iga, ‘Ënooköë wa bhaguuka bhaitö akoohööyë iga ömanye öbhöhanchi bhooe, ömaahe Ömöröngë, na umuigue arasumaacha köngamba yaae umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.14",
            "verseOrgIds": [
              "ACT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira nuwe öraabhe ömöherekia wa amang'ana gaae kögöteebhia abhantö bhonsui këno örööchë na kuigua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.15",
            "verseOrgIds": [
              "ACT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhoono kana nkë ököganya? Taimöka bhoono öbhaatiisöe, wisaabhibhue amaraga gaao gö kömösaasaama.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ëmbërëkëra ya Bhauro kurundiria Abhahamatë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nkaringa kuya Yerusaremu, na hano wanyoorrë ndasaasaama köhekaru, nkoorokibhua amamaaho, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nnaarööchë Ömönene, aranteebhia iga, ‘Taangöha urue Yerusaremu bhöngöbhöngö kugira abhantö hano, tëbharaigue öbhöherekia bhooo harëuni hai.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkahunchukia iga, ‘Mönene, mbamanyërë bhuuya iga nu uni öno naaya ndaya guchisinagogi ndagoota na götema bhano bhaarë kugukumia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.58"
              },
              "items": [
                {
                  "text": "Ama 7:58",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkaaga ömöherekia waao Sitebhano aitëröë uni nëho naarëngë, ngaitabhërrania na uguitöa koe ndariiha ichingëbho chabhaiti bhaae.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömönene aganteebhia iga, ‘Taya, nëndagötöme aharai köbhahamatë.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö mbaategerreeyë Bhauro bhuuya, hano aagambërë agösookia gonsui, bhagakora igituri, bharagamba iga, “Ömöntö ke öno niiga aitue arue gökëbhara! Taisaini amenye hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaarëngë kögambagamba bharasamunsa ichingëbho chaabho, bharamincha urutu kuya igörö kömërëërro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömökönaare wa Abharumi agateebhia abhasirikare bhaae iga bhahire Bhauro köbhögöe, na guiki akabhateebhia iga bhamöteme na örögose korri abhateebhi nkugira kë Abhayahuti bhaagökora igituri iga tëbhakumutuna hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano wanyoorrë bhaamöbhohërë na ichinsiri iga bhoono atemöe, Bhauro agateebhia ömöhobhisa öno wanyoorrë aimërëëyë ho iga, “Bhoono harë bhainyu mbuuya kögötema Umurumi atarakengeröa ikiina?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        }
      ]
    },
    {
