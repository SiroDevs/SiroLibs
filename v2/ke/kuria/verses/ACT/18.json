        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanyoorrë aigibhua bhuuya igörö yë ënchëra yö Ömönene, naasumaachërë atöndööyë arateebherria na kuigia bhuuya öbhöheene bho Yesö. Ninyoora nigo në ëbhaatiiso ya Yohana bheene wanyoorrë amanyërë. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatangërë gusumaacha köbhökarë gu isinagogi. Nkaaga Bhirisika na Akira bhaamuiguurë, mbaamuirigaini waabho na kömösësörra bhökong'u ënchëra yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhoro akaahöra kuya Akaya, köhayö abhakumia bha Ebheso bhakamötööra ömooyo gökondëkëra abhiëga bha Akaya bharabhageya iga bhamuirigani. Hano aahikërë ho, naatuuriiyi bhökong'u bhaara wanyoorrë gösaramita yë Ënooköë bhaabha abhakumia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.27",
            "verseOrgIds": [
              "ACT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira naakerre Abhayahuti mbere ya abhaaru arabhaherekiria kurua kö Amandëko iga Yesö nëwe Kirisitö.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.28",
            "verseOrgIds": [
              "ACT.18.28"
            ]
          }
        }
