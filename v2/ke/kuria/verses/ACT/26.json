          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki ömögambi hamui na ömögabhana na Bherinike hamui na bhaara bhonsui wanyoorrë bhaikaayë hamui nabho bhakaimöka, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "hano bhaasookiri kurichoka bhagateebhania iga, “Ömöntö öno taasaria ng'ana ya guitöa hai, gösë ya kömöbhoha hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiribha agateebhia Bhesito iga, “Ömöntö öno nakahaatëëyöë hano nkanyoorrë ataasabha iga ikiina kihirue harë Kaisari ömögambi wa Rumi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
