    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro araiyikëngëra umuene mbere Agiribha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiribha agateebhia Bhauro iga, “Nööna umueya go gusumaacha bhoono.” Sooki Bhauro akaramböra ököbhoko kooe araiyikëngëra iga, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ömögambi Agiribha! Ndööchë iga nö ömöntö wi iriöbha ndë, kugira reero nimëërëëyë mbere yaao kuiyikëngëra kömang'ana gano gonsui Abhayahuti bhagunchöngëra, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.2",
            "verseOrgIds": [
              "ACT.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikugira nömanyërë ichisëëra cha Abhayahuti chonsui hamui na öbhöhotokani bhoobho. Ndakögeya iga öntegeerre kubhugumirria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abhayahuti bhonsui mbaamanyërë gukurua öbhoonabhöke bhoone. Mbamanyërë keebhörë naakiina gönsë yaane na Yerusaremu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.6"
              },
              "items": [
                {
                  "text": "Ama 23:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.5"
              },
              "items": [
                {
                  "text": "Bhi 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaammanyërë gönkaaga ëntambë hano ndanyoore bharatuna köherekia kurua nyuma keebhörë naarëngë umui wi irikomo rëno rëtaarë gutuna möhöörö, iria Abhabharisayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bhoono nimëërëëyë hano ndachöngëröa iga nnëëna iriiteng'ero rië ënndagano ëno Ënooköë aahaayë bhaguuka bhaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëndagano ëëra bheene ibhiaro ikumi na bhibhirë bhia abhantö bhaitö bhiteng'eeyë kunyoora, kögösengera Ënooköë ubhutikö na ömöbhasö. Iriiteng'ero rëyö bheene ömögambi ndio rikugira ndachöngëröa na Abhayahuti! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Mak 7:9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira kë bhainyu bhano mööhano mötagukumia iga Ënooköë arariukia abhaku?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Ama 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.4"
              },
              "items": [
                {
                  "text": "22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Uni umuene naaitegerreeyë iga, nsaache gönchëra ërë yonsui konga iriina re Yesö o Nasareti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngayö naakorrë Yerusaremu. Nkahaabhöa ögötöra na abhanchaama abhanene nkahira abhakumia abhaaru gökëbhohe; na hano bhaarë gökengeröa ikiina guitöa, naakorrë ëgëkoobhöe ke guitabhirria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harë kaaru naakabhairiirri guchisinagogi ndabhahaamirria gökaana ubhukumia bhoobho. Naabhëëbhëhërë bhökong'u kuhika nkaya köbhairiiria kumigi ge harai.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro aragamba igörö yu ukuihönchörra kooe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ëyö niyo yaagirrë nkaya Tamesike, nhaayöë ögötöra na abhanchaama abhanene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano wanyoorrë nëëgönchëra ömöbhasö gatai ömögambi, nkamaaha öbhörabhu bhöno bhökërrë öbhörabhu bhui iriöbha bhökarua këgörö kuriöbha bhökanyinaara hamui na bhaara wanyoorrë tönabho hamui. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui tökagöa hansë, nkaigua ëngamba ëragamba gu Ikiebhurania iga, ‘Sauri, Sauri! Kugira kë ukunyiriiria? Nkuinyahaara örë bhuchua kë ëng'ombe ëno ëkörekera ömösegere inyimbo yö ömönene waae.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkamubhuuria iga, ‘Kana nuwe ng'ui Mönene?’ Ömönene akahunchukia iga, ‘Nu uni Yesö, öno ukuiriiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono taimöka wimëërre. Nkurichokeeyë nkoohööyë iga, öbhe ömökoramërëmo waane. Nörateebhi abhantö bhandë keebhörë öndöchë reero na kërë ndakooroki guchinsikö chino chiguucha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndagutuuri kurua Köbhaisiraeri na kö Abhahamatë bhano ndaagötöme harë bho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbharamuki, öbharuusi kugisuntë, öbharente köbhörabhu, bharue guchinguru cha Setani bhayi kö Ënooköë, kugira hano bharaabhe na ubhukumia harëuni bhaabhëröe amaraga gaabho, bhanyoore ahasë haabho hamui na bhaara bhaasabhurua.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhauro aragamba igörö yë ëmërëmo geee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Köhayö, Ömögambi Agiribha, tënaangërë kuiguëra irimaaho rëyö reeruurë kuriöbha hai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.20"
              },
              "items": [
                {
                  "text": "Ama 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.29"
              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbere nnatangëëyë Tamesike göteebherria, sooki Yerusaremu, sooki gökëbhara gionsui ke Yutea na kö Abhahamatë, korri bhatige amaraga gaabho bhaihönchörre Ënooköë, na bhakore amang'ana gano gakoorokia iga bhaisa gutiga amaraga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këyö nkio keegirrë Abhayahuti bhakangoota nkaaga naarëngë köhekaru bhagatuna kunyita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Ënooköë antuuria kuhika bhoono, köhayö nnimëërëëyë hano ndaruusia öbhöherekia bhoone, köbhake na köbhanene. Gano nkögamba ngano bheene abhanaabhi hamui na Mösa, bhaagambërë iga ngarëbha; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
