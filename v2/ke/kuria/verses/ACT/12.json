        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Mak 9:5-28\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herote nkanyoora bhaaserana na abhantö bha Tiro na Sitoni, köhayö bhakaya irikomo kömömaaha. Tanga bhagasumaacha na Bhurasito, öno aarëngë umuimiriirri wi inyumba nköraano yö ömögambi korri iga abhatuurri. Sooki bhakaya harë Herote kömösabha ömörembe, kugira ënsë yaabho yaaiteng'eeyë ënsë yö ömögambi kubhiakörëa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë, röno roohööyöë, Herote agaitöörra ichinganchö chö öbhögambi, agaikara kugitumbë keee kiö öbhögambi agasumaacha na abhantö. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
          "items": [
