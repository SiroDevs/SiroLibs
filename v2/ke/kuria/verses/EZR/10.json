            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhandë Abhaisiraeri: Ëka ya Bharosi: Ramia, Isia, Marikiya, Miyamini, Eriasari, Marikiya na Bhenaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.25",
            "verseOrgIds": [
              "EZR.10.25"
            ]
          }
        },
        {
          "name": "verse",
