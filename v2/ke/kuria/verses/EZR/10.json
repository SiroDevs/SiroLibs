          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Bahati-moabhu: Atina, Kerari, Bhenaya, Maaseya, Matania, Bhesareri, Bhinui na Manase ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.30",
            "verseOrgIds": [
