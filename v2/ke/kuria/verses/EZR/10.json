          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makinatebhai, Sasai, Sarai ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.40",
            "verseOrgIds": [
