          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Eramu: Matania, Sekaria, Yehieri, Abhuti, Yeremoti na Eriya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.26",
            "verseOrgIds": [
              "EZR.10.26"
            ]
          }
