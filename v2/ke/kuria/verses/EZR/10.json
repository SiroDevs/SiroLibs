          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Satu: Eriehoenai, Eriasibhu, Matania, Yeremoti, Sabhati na Asisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.27",
            "verseOrgIds": [
              "EZR.10.27"
            ]
          }
        },
