          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Harimu: Erieseri, Isiya, na Marikiya, Semaya, Simeoni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.31",
            "verseOrgIds": [
              "EZR.10.31"
            ]
