          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Hasumu: Matenai, Matata, Sabhati, Eribhereti Yeremai, Manase na Simei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.33",
