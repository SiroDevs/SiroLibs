          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenchamini, Maruki na Semaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.32",
            "verseOrgIds": [
              "EZR.10.32"
