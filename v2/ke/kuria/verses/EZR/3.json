                "loc": "NUM.28.1+NUM.28.2+NUM.28.3+NUM.28.4+NUM.28.5+NUM.28.6+NUM.28.7+NUM.28.8"
              },
              "items": [
                {
                  "text": "Ëbh 28:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaahagachërë irikëngë rëyö ahasë haara bheene rëërëngë karai, kugira mboobhohërë abhantö bhaara wanyoorrë bhamenyërë gönsë ëyö. Hakurua bhakagëndërria kuruusiria ÖMÖNENE ibhimuenso bhia gösambërëërröa këgörö yario ruiso ronsui inkio na ömögoroobha.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        }
      ]
    },
    {
