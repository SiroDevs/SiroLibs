              "EZR.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bho bhagatuhunchukiria iga, ‘Bhaitö na abhakoramërëmo bhë Ënooköë wa kuriöbha na ëkëbhara, na nköhagaacha törë bhöhëa inyumba ëno ëkëmbere hayö waanyoorrë yahagaachöa na gusira na ömögambi umui ömönene wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11+2KI.25.12"
              },
              "items": [
                {
                  "text": "2 Gam 25:8-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Ich 36:17-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.12+JER.52.13+JER.52.14+JER.52.15"
              },
              "items": [
                {
                  "text": "Yer 52:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si gikugira bhaaguuka bhaitö, mbaaririiyi Ënooköë wa kuriöbha, we naabhatöörrë kömabhoko gö ömögambi Nebhugatinesa wa Bhabheri, Ömögaritayo, önö aanyeregaini inyumba ëno na kuhira abhantö köng'aanyi Bhabheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.12",
            "verseOrgIds": [
              "EZR.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2+EZR.1.3+EZR.1.4+EZR.1.5+EZR.1.6+EZR.1.7+EZR.1.8+EZR.1.9+EZR.1.10+EZR.1.11"
              },
              "items": [
                {
                  "text": "Esr 1:2-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si kömooka go mbere ögöbhögambi bhö ömögambi Koresi wa Bhabheri naaruusiri ëngamba iga inyumba ëno yë Ënooköë ëhagaachöe bhöhëa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, naaringiri ibhintö bhië ësahaabhu na amatiini gi ichimbiria na ibhintö bhionsui bhi inyumba yë Ënooköë bhino ömögambi Nebhugatinesa wanyoorrë aimukia kurua köhekaru Yerusaremu na kubhitööra köhekaru ya Bhabheri. Koresi naaruusiri ibhintö bhiyö kurua köhekaru ya Bhabheri na kubhiha Sesibhasa öno wanyoorrë aahöra köbha ömöbhaahi wa Yuta; naamuruusiiyi ëngamba iga ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.14",
            "verseOrgIds": [
              "EZR.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "aimuki ibhintö bhiyö na kubhiringia köhekaru ya Yerusaremu, na köhagaacha bhöhëa inyumba yë Ënooköë ahasë hano yaarëngë ëkëmbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.15",
            "verseOrgIds": [
              "EZR.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Sesibhasa agaacha na götööra öbhörösa bhui inyumba yë Ënooköë Yerusaremu, na gukurua ënkaaga ëyö öbhöhagaachi mbogenderreyi kuhika bhoono, si tëbhörasira hai’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, hano ökaahaancha uwe ömögambi, taruusia ëngamba ubhuisunchi bhökoröe guchihëëtöko chöbhögambi kumugi go Bhabheri nyoora ömögambi Koresi naaruusiri ëngamba iga inyumba ëno yë Ënooköë ëhagaachöe bhöhëa kumugi go Yerusaremu. Hakurua töragösabha ötötëëbhi obhoragirria bhoo igörö ya ëng'ana ëno.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.17",
            "verseOrgIds": [
              "EZR.5.17"
            ]
          }
        }
      ]
    }
