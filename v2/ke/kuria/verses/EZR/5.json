                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Sek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö, abhanaabhi bhabhërë Hagai na Sekaria ömoona wa Ito, mbaanyereeyë ënaabhi Abhayahuti bhano waanyoorrë bhamenyërë Yuta na Yerusaremu, kuriina rë Ënooköë wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.12"
              },
              "items": [
                {
                  "text": "Hag 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.6+ZEC.4.7+ZEC.4.8+ZEC.4.9"
              },
              "items": [
                {
                  "text": "Sek 4:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Serubhabheri, ömoona o Searitieri, na Yesua ömoona o Yosataki nabho hano bhaiguurë ëng'ana ëyö mbaatangërë guiki köhagaacha inyumba yë Ënooköë kumugi go Yerusaremu, bharatuurribhua na abhanaabhi bhë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Tetania ömögabhana wö ömöndaara go nyancha ya Yubhurati, Setari-bhosenai na bharikia bhaabho, mbaagëëyë Yerusaremu na kubhuuria iga, “Ning'ui aabhaha ëngamba ya köhagaacha inyumba ëno kuhika isirë?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki bhakabhuuria iga, “Mbaabho ng'ui bhaköhagaacha inyumba ëno? Töratuna amariina gaabho.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si Ënooköë naarë kuriiha abhatangati bha Abhayahuti, köhayö abhanene bhayö tëbhaabhakaaniri kuhika hano bhaandëkëëyë ömögambi Tario na kunyoora ëngamba yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Tatenai ömögabhana wö ömöndaara go nyancha ya Yubhurati na Setari-bhosenai na abhagabhana bharikia bhaabho, bhakandëkëra ömögambi Tario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amang'ana gano bhaahereeyë ömögambi: “kö Ömögambi Tario; Ömörembe göbhe na uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tökahanchërë kögöteebhia, wei ömögambi, iga ntoogëyë kömöndaara go Yuta hano inyumba yë Ënooköë Ömuhiku ërëngë. Inyumba ëno nköhagaachöa ërë bhöhëa na amagëna amanene na ichingito chago chaatööröa imisiiri gë ëmëtë. Ëmërëmo gëyö ngökoröa gërë köbhömaahiirri öbhönene na nkögenderria gëërë bhuuya kimui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.8",
            "verseOrgIds": [
              "EZR.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntoobhuurri abhatangati bhayö bhatöteebhi ning'ui aabhahaayë ëngamba ya köhagaacha bhöhëa inyumba ëno kuhika isire? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.9",
            "verseOrgIds": [
              "EZR.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntobhaabhuurri amariina gaabho korri tögöteebhi bhaara bhaagötangata ëmërëmo gëyö.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.10",
            "verseOrgIds": [
              "EZR.5.10"
            ]
          }
        }
      ]
    },
    {
