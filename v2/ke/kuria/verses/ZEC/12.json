                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Öbhö 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uruibhöro ro Tauti na abhamenyi bhu umugi go Yerusaremu nëndabhaichuri ënkoro ya amaabhë na amasabhi, nabho mbaramaahëërre ööra bhaatëbhëtërë; mbaramököörre kehaara ömöntö agököörra ömoona waae ömösorori, gösë kehaara ömöntö agököörra mötangi waae köbhöörrö. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö ikuuro ihiku nërëbha ho kumugi go Yerusaremu gi ikuuro ya gököörra Hatati-rimoni kömahancha ga Megito. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë nërakuure, këra ikiaro nkërangunye ikiene, abhasaacha hagarë na abhagaikörö hagarë; ikiaro ge Tauti ikiene; ikiaro ge Natani ikiene; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikiaro ge Rawi ikiene na ikiaro ge Simei ikiene. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inchintundrra chionsui chino chitamërë mbirakuure; abhasaacha hagarë na abhagaikörö hagarë.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
