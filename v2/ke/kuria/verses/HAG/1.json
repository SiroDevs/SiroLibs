            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Esr 4:24—5:2",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.14"
              },
              "items": [
                {
                  "text": "6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kömooka go kabhërë gö ömögambi Tario wa Achemi, urusikö ro mbere ru umueri go gasansabha, ëng'ana yö ÖMÖNENE ëgaachëra Hagai ömönaabhi iga, ateebhi Serubhabheri ömoona o Searitieri, ömögabhana o Yuta, na Yosua ömoona wa Yehosataki umunchaama umuhikërë.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Hagai iga, “Abhantö bhano nkögamba bhaarë iga ënkaaga ya köhagaacha bhöhëa Ëhekaru yaane tërahika hai.”",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho ëng'ana yö ÖMÖNENE yaachëëyë abhantö köhetera harë Hagai ömönaabhi iga, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbuuya harë bhainyu kömenya guchinyumba cheinyu chë ëtegerio na Ëhekaru yaane yaagota?” ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, ÖMÖNENE aragamba iga, “Muitegeerre bhöhëa nyoore mbuuya mögökora! ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhainyu mueimia ichintetere köbhooru, sibhoono mögesa nke igo; nköraagëra mörë, sibhoono timukuigöta hai; nkunyua mörë itibhaai, sibhoono tëmököheria hai; ngusuara mörë ichingëbho, sibhoono nkuigua mökërë ëmbeho; ngökora mörë ëmërëmo na amahakano gaagio gabha nkanya ngatöröë kumisuko ëmëtobhoku.” ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE wa amacheesi aragamba iga, “Taitegeerra nyoore mbuuya mögökora! ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, mötaya guchinguku, mötëgande ëmëtë, möhagaache bhöhëa ëhekaru ëyö, korri ngookeroe na kögöngöa mo.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mueiteng'eeyë irigesa irinene, sibhoono mökanyoora bhike igo. Na hano moobhirentërë ka, nkabhinyeregania kuya aharai. ÖMÖNENE wa amacheesi arabhuuria. Nkugira kë? Ngikugira ëhekaru yaane nëngotu na hano këra umui weinyu ni inyumba yaae agökööna. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkio kegira kuriöbha hakania imbura ëtaagötöa, ëkëbhara nakio kenga köbha ibhiakörëa. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarenta ëmaaö gökëbhara, yasaria ibhikerege na ëmëgöndö gi ibhiakörëa, ëmëgöndö gë ëmësabhibhu na ëmëgöndö gë ëmësaituni na bhionsui bhino bhikömera, abhantö na ichitinyi na kërë gionsui mooruusiiyi ibhigeri.”",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhantö bharaitabhiirria ëngamba yë Ënooköë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Serubhabheri ömoona o Searitieri, na Yosua ömoona o Yehosataki umunchaama umuhikërë, hamui na bhonsui bhano wanyoorrë bhaaringërë kurua köng'anyi bhagakora kehaara ÖMÖNENE waabho anyoorrë abhateebhiri na keebhörë Hagai ömönaabhi abhateebhiri, kehaara bheene atömëröë na ÖMÖNENE, Ënooköë waabho. Abhantö bhagasengera ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Hagai, ömötömöa wö ÖMÖNENE, aateebhiri abhantö ëng'ana ëno kurua kö Ömönene aragamba iga, ÖMÖNENE aragamba iga, “Uni nhamui ndë na bhainyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo ÖMÖNENE agatirimikia Serubhabheri ömögabhana o Yuta, na Yosua umunchaama umuhikërë na abhantö bhonsui bhano wanyoorrë bhaaringërë kurua köng'anyi, bhagatanga ëmërëmo gi irihagaacha rë Ëhekaru. Mbaatangërë ëmërëmo gëyö ge köhagaacha bhöhëa ëhekaru yö ÖMÖNENE wa amacheesi, Ënooköë waabho, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kurusikö ro mërongo ëbhërë na kanai ru umueri go gasansabha, kömooka go kabhërë gö öbhögambi bhö ömögambi Tario.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
        }
      ]
    }
  ],
