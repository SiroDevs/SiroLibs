              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ësaramita, ömörembe na öbhöhanchi bhiengeribhue köbhooru harë bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
