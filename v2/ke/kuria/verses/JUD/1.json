                  "text": "Ögt 19:1-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nigo bheene Sotoma na Gomora hamui na imigi gëno giginaarrë geisohiri kubhunyanku bhö öbhöraaya, na guitööra kubhuigombi. Abhantö bhi imigi gëyö mbaarëngë igituubhaniö kegökengeröa ikiina kuya kömörro go kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
            "verseOrgIds": [
              "JUD.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JUD 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke hayö bheene köbharoti bhano, ngösaria bharë ëmëbhërë geebho, ngösera bharë ögötöra na götöka ibhiteemöa ibihiku bhia igörö. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.8",
            "verseOrgIds": [
              "JUD.1.8"
            ]
          }
        },
