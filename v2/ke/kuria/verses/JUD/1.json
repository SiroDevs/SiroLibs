          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhasaacha kuhika möhëëtöke gano gaandëkëröë karai na abhatömöa bhö Ömönene weitö Yesö Kirisitö. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.3"
              },
              "items": [
                {
                  "text": "2 Bhe 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaabhateebhiri iga, “Guchinsikö chöömöheriö, abhantö mbaarëbha ho bhano bhariya bharachuaria, bhano bhariya bharagenda kubhuigombi bhoobho abhiene.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhë ëteemo ëyö mbo bhakörenta ököhotokana, kugira bho na abhantö bhë ëkëbhara na guiki tëbhaana Nkoro hai. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhainyu, abhahanchöa, muihagaache kubhukumia bhoinyu öbhöhoreeru, na mösabhe na Nkoro Nhoreeru. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muiriihe abhiene köbhöhanchi bhöë Ënooköë keebhörë mököganya amaabhë gö Ömönene weitö Yesö Kirisitö, kuhika möhëkëëre öbhöhoru bho kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JUD 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Möbhe na amaabhë köbhantö bhano bhaana isi. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.22",
            "verseOrgIds": [
              "JUD.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JUD 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhandë möbhatuuri gököbhasaköra kurua kömörro; abhandë nabho möbhooroki amaabhë gano gaichogaini öbhoobha, sibhoono mösere ichingëbho chaabho chino chiina amatone giichigooriö chaabho icha amaraga.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
            "verseOrgIds": [
              "JUD.1.23"
            ]
          }
        }
      ]
