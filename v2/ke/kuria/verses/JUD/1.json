                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ninyoora mömanyërë amang'ana gano, tiga guiki mbahiituki iga Ömönene naatuurri abhantö bhaae kurua Misiri, sibhoono hakurua agasikia bhaara bhataakumiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.5",
            "verseOrgIds": [
              "JUD.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JUD 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhamaraika bhano bhataagömërë hare ögötöra koobho köhëkëëyë, gëtatiga mbaatigërë öbhömenyo bhoobho bhöë ënsëmöka, bhayö aabhabhoha kugisuntë na ibhirang'ani bhia kuya ëyö, korri bhaache gökengeröa ikiina Kurusikö rööra. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.6",
            "verseOrgIds": [
              "JUD.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
