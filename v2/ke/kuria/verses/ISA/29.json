          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, harë bhainyu amamaaho gano gonsui nkë ëng'ana ëno yaandëköa kögëtabhö këno këbhohërë na öröbhaaso. Hano öraheerre ömöntö örë wonsui amanyërë gösoma, ömöteebhi iga, “Tansomera ëgëtabhö këno,” narahunchuki iga, “Tëndatöre kögësoma kugira nkëbhohërë na öröbhaaso.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano örahe ömöntö örë wonsui atöngööyë gösoma, ömöteebhi iga, “Tansomera ëgëtabhö këno,” narahunchuki iga, “Tëmanyërë gösoma hai.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriteng'ero guchinsikö cha mbere",
          "type": "text"
        }
      ]
    }
  ],
