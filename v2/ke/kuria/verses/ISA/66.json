    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "ÖMÖNENE arakengera ichihamatë ikiina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE aragamba iga, “Ho bharë abhantö bhano bhaguisabhuura na guisaabha iga korri bhasohe kömagori gë ësengero yi ibhihooru; mbanyörööyë na umunchaama arëngë gatai yaabho. Abhantö bhayö nkörëa bharë ichëmbëëchë, ichimbebha, na ibhiakörëa bhindë bhi ibhikui. Abhantö bhonsui bhayö maheene mbarakue hamui igo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëmanyërë amakora gaabho na amaitegeerro gaabho. Nguucha ndë gököma abhantö bhi ichihamatë na ibhigambo bhionsui, bhasangëërrani hamui na kömaaha ubhuhiku bhoone. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndatööre harë bho ëkëmanyiirrio kiö ögötöra koone.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bhano bharatëërröke kurua harë bho nëndabhahire kö abhantö bhi ichihamatë ëntahana ya Tarisisi, Bhuti, Ruti, ichinsë chino chiina abharasi ibhihubheebhe; guiki mbaraayi Tubhaari na Yowani na ichinsë chino abhantö bhataakaiguurë ubhukumahe gösë ubhuhiku kömaaha ubhukumahe bhoone. Abhatömöa bhaane bhayö mbararundi ubhuhiku bhoone guchihamatë chiyö. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbararingi abhantö bhainyu bhonsui kurua guchihamatë ki ibhiruusio bhiane uni ÖMÖNENE. Mbarabharente bharinërë ichibharaasi, ichitëkërë, ichingamëëra na amatoka gi ichibharaasi kuhika Yerusaremu, kunguku yaane ënhoreeru. Mbarabharente kehaara Abhaisiraeri bhakörenta ësataaka yi ibhiakörëa kubhintö ibhiiya kuhika ka waane uni ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki nëndaahöre abhamui bhaabho köbha abhanchaama na abhandë köbha Abharawi. Uni ÖMÖNENE ngambërë.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
