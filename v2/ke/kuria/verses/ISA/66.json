              "text": "\n        Yut 16:17",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.48"
              },
              "items": [
                {
                  "text": "Mk 9:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Sooki mbaraayi kömaaha ibhihundugu bhia bhaara bhantëyëëyë. Amakönde gano garëbharëa tëgarikua, na ömörro göno görëbhasamba tiguririma iga hai. Mbarëbha ikiriirrio kö abhantö bhonsui.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
