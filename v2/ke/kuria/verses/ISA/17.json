              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö, abhantö mbarëmaahëërra ömöteemi waabho, na amaiso gaabho guiteng'era ömöhöreeru öyö wa Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëbharaiteng'ere guiki amakëngë gë ësengero gano garëngë ibhikore bhia amabhoko gaabho abhiene, gösë guiteng'era guiki ibhikore bhia amabhoko gaabho abhiene, nko kögamba iga ibhihooru bhië ënooköë Asera na irikëngë re köhöchööchëra öbhöbhaani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö imigi geebho ëmëkong'u ngiritigua amatongo, ki imigi gëno Abhahibhi na Abhaamori bhang'anyërë hano bhaarë köng'osa uruibhöro ro Isiraeri. Këra gëntö nkërësaribhua.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ichihamatë cha abhabhisa chirakëroa",
          "type": "text"
        }
      ]
    }
  ],
