                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "hayö naarëkora këra hasë igörö yi inguku ya Sayuni na igörö ya imiranio gia abhantö rëbhe ho irisaro ënkaaga yö ömöbhasö, na irioki na ömörro göno gögooka bhuuya ënkaaga ya ubhutikö. Gökëra gayö ubhukumahe bhuë Ënooköë mbörakundikiri na kuriiha umugi gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubhuhiku bhooe mbörëbha ikiiriiri harë bho na köbhaigamiria örööha rö ömöbhasö; na öbhöng'osero na ikiribhiirri keebho gönkaaga yö ömökama umurito na imbura.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
