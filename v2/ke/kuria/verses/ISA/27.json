                }
              ]
            }
          ]
        },
        {
          "text": "Urusikö röyö, ÖMÖNENE narimiuria inchonge yaae ënene, inyögë na ënkong'u, na köha iribhörööta Rewiyatani, uguchoka göno gukuibhurruka, Rewiyatani uguchoka göno guguikonyoora; ÖMÖNENE naraite uguchoka göno gömenyërë kunyancha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
