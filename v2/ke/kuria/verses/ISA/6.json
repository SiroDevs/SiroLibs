            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Ich 26:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kömooka gööra Ömögambi Usia akuurë, naarööchë Ömönene aikaayë kugitumbe kiu ubhuhiku këno kërëngë kuriöbha na igi ikuuge. Umuringo gui isumati yaae ngoichööyë köhekaru ingima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na igörö yaakio amaserabhi wanyoorrë ngaimërëëyë ko, këra umui naarëngë na amabhabha asansabha: Abhërë agakubhisia ubhusio, abhërë agakubhisia ömöbhërë, na abhërë agakuibhörrökëra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Öbhö 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbaabhërëkëraani këra umui waabho iga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
    {
