              "ISA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua nkaigua Ömönene aragamba iga, “Ning'ui ngaatöma? Ning'ui akabha ömötömöa weitö?” Na uni nkamuhunchukiria iga, “Hano ndë! Tantöma uni.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
