            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.31"
              },
              "items": [
                {
                  "text": "Ögt 29:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua abhantö bhonsui na abhagaaka bhano bhaarë kuihita bhakagamba iga, “Nabhaherekia törë. Tiga ÖMÖNENE akore ömögaikörö, öyö aguucha köbha mökao, abhe ke Raheri na Rea, bhano bhasëmööyë hamui uruibhöro ro Isiraeri. Tiga ösaraare guikiaro ke Ebhurata na kuya nkuma Bheterehemu; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.27+GEN.38.28+GEN.38.29+GEN.38.30"
              },
              "items": [
                {
                  "text": "Ögt 38:27-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na umugi gooo göbhe kiögo Bheresi, öno Tamari aaibhörëëyë Yuta, gikugira ya abhaana bhano ÖMÖNENE araaköhe ku umusubhaati öno.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhoasi na uruibhöro rooe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
