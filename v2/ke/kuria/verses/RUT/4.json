            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo Bhoasi akaimuikia Ruti akabha mökaae, akaraara nawe, na ÖMÖNENE akamösakiria akabha nda na kuibhöra ömoona wë ëgësaacha ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho abhagaikörö bhateebhiri Naumi iga, “Tiga ÖMÖNENE aitabhiribhue öno angërë gutiga öbhörë umuri wö ömöndö, tiga iriina riu umuri wö ömöndö öyö riyi nkuma harë Isiraeri! ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naraabhe umuringia na umukunguuri wa öbhöntöbhökörö bhooo; kugira mökamoona waao öno aköhanchërë na öno akërrë abhamura muhungatë, nëwe amuibhööyë.” ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo Naumi akaimukia ömoona ööra akamöhagata, na köbha ömöreri waae.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na abhagaikörö bhö öröbheri bhakamöröka iriina bharagamba iga, “Naumi aibhörëyöe ömoona wë ëgësaacha.” Bhakamöröka iga Obheti, nëwe arëngë isawaabho Yese, isawaabho Tauti.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, bhano mbo abhaibhöroa bha Bheresi: Bheresi akaibhöra Hesironi, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesironi akaibhöra Rami, Rami akaibhöra Aminatabhu, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminatabhu akaibhöra Nasoni, Nasoni akaibhöra Sarimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 4:21"
