          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhurahimu akagamba iga, “Niiruusiri umuene gösumaacha na Ömönene, uni öno ndëëngë urutu na iriibhu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handë bhagatööka abhantö mërongo ënai na bhatano kuibhaga re mërongo ëtaano. Gösë nörasiki umugi umugima gikugira bhasuuhërë bhataano?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
