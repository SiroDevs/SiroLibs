              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akamuhunchukiria iga, “Hano ndanyoore abharöngë mërongo ëtaano bharëngë kumugi go Sotoma, nëndaahoni umugi gonsui gikugira yaabho.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
