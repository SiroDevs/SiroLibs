            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.10"
              },
              "items": [
                {
                  "text": "Ögt 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutu agataachëërra na kömaaha iga Irihancha rë Yorotani rionsui ndëëna amanchë gano gaisërë ichintahana chonsui ki irisamba rio ÖMÖNENE, na keehaara ënsë ya Misiri, ëntahana ya Soari. Hayö në ënkaaga ëno wanyoorrë ÖMÖNENE ataraasikia imigi gë Sotoma na Gomora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Rutu akaiyahörra irihaancha rionsui riö ömooro go Yorotani, akagëëra rögörö, na igo, bhakaahökana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhuramu agatama gönsë ya Kanaani, na Rutu akamenya gatai ya imigi geno geerë kuihancha, akang'aanyia amatunteera gaae kuya Sotoma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Sotoma mbaarëngë abhanyanku, na abhanyamaraga abhanene mbere yö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhuramu arang'aanya kuya Hebhuroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Rutu bhaasokiri kohökana na Abhuramu, ÖMÖNENE agateebhia Abhuramu iga, “Tagaramëra kurua hayö örëngë ömaahe ichintahana chonsui: Mööchë, sööchë, rögörö na nyancha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Ama 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kugira ënsë ëyö ökömaaha nëndakohe ëbhe iyaao hamui na uruibhöro roo kuya ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëndakore uruibhöro rooo röbhe örooru röno rötaköbharöa, keehaara urutu röë ëkëbhara, rötaaköbharoa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.16",
            "verseOrgIds": [
              "GEN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono taimöka örabhe öbhötaambë na öbhögarë, kugira nëndakögëhe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.17",
            "verseOrgIds": [
              "GEN.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö Abhuramu akang'aanyia iritunteera, akaya götööra kömearoni ge Mamure, Hebhuroni haara; hayö nëho ahagaachëëyë ÖMÖNENE irikëngë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
    }
