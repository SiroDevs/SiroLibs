          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.22"
              },
              "items": [
                {
                  "text": "Ögt 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Abhimereki akarua Gerari hamui na umutuurria waae, Ahusati na ömökönaare waae wa iricheesi Bhikori, bhakagëëra Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akabhabhuuria iga, “Nkë mösoorrë hano, naho moondëgërë na kundugia kurua gönsë yinyu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabho bhakahunchukia iga, “Törööchë bhörabhu iga ÖMÖNENE narëngë hamui na uwe, nëho tögambërë iga, tiga uwe na bhaitö tuitueneerri na kunyeerrana imuuma, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "iga törëtökorra ng'ana mbëëbhë, na bhaitö tëtörëgökorra ng'ana mbëëbhë hai. Ntoogutigërë ökang'aanya kömörembe tötagökoreeyë ng'ana mbëëbhë ërë yonsui, Na, bhoono uwe numuitabhiribhöa wa ÖMÖNENE örë.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Isaka akabhakorra ëndaagëra, bhakaraagëra na kunyua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio chuni, bhakabhööka bhonsui bhagaitueneerria abhiene kubhiene. Hakurua Isaka akabharöngëka bhagatigana kömörembe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurusikö rööra bheene abhakoramërëmo bha Isaka bhagaacha kömöteebhia amang'ana igörö ya igisima këëra bhaatukërë, bhakagamba iga, “Tunyoorrë mo amanchë.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka akaröka igisima këëra iga, Sibha. Igo, ninyoora ndeero umugi gööra niiga gököbhërëkëröa iga, Bheeri-sebha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:33",
              "type": "text"
            },
            {
              "text": "Bheeri-sebha:",
              "type": "text"
            },
            {
              "text": "Gukibhurania niiga “Igisima kie imuuma” (maaha guiki 21:31)",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhakari abhahamatë bha Esau",
          "type": "text"
        }
      ]
    },
    {
