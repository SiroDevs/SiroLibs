          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Esau aahikiri ëmeeka mërongo ënai (40) naatetërë Yutiti muisëkë o Bheeri, na Bhasemati muisëkë o Eroni, bhonsui na Abhahiti bhaarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakari bhayö mbaakorrë amabhaho ga Isaka na Rebheka gagaichöra öbhörrö.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
