        "style": "s1"
      },
      "items": [
        {
          "text": "Ënooköë araitabhiria Yakobho Bheteri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
