              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobho akaya harë Isaka isawaabho Mamure, nko kögamba, iga, Kiriati-aribha gösë Hebhuroni. Hano Ibhurahimu na Isaka bhaamenyërë kia abhaitongo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
