                  "text": "Ama 7:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ÖMÖNENE agateebhia Abhuramu iga, “Omanye mmaheene iga, uruibhöro rooo ndörëmenya kia abhaitongo gönsë ëno ëtarë iyaabho, na ndörëbha abhagöre ho, na kuiriiribhua kömeeka amagana anai (400). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Ëgt 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.7"
              },
              "items": [
                {
                  "text": "Ama 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sibhoono nëëndëbhörööta ëhamatë ëëra ërëbhakoria ëmërëmo, hakurua bharue ho bhaana ibhintö ibhiaru bhökong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono uwe nöraabhe na amabhaho amatambe, na gukua ötökëröë kömörembe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaköra anai ngaarëheta nëho uruibhöro rooo ruriringa gönsë ëno. Kugira öbhöbhëëbhë bhua Abhaamori tebhoraahëkëërana hai.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
