        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akamöteebhia iga, “Ndentera ëkëmoori kë ëmeeka ëtatö, isubhiini yë ëmeeka ëtatö, iguruki yë ëmeeka ëtatö, ikiguuti na irichuuchu ri inguuti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhuramu akamörentera bhiyö bhionsui, agakenga këra gëntö harë kabhërë, akabhitööra bhigatachëërrana guchinkarra ibhërë. Sibhoono taakengërë ibhinyunyi harë kabhërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano amatoonyi gaachëëyë ibhihundugu bhiira, Abhuramu naagarugiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        }
      ]
    },
