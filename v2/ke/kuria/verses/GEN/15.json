              "items": [
                {
                  "text": "Yak 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhuramu agakumia ÖMÖNENE, na ÖMÖNENE akamuitabhiirria köbha ömöröngë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        }
