          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua ÖMÖNENE agateebhia Abhuramu iga, “Uni nu uni ÖMÖNENE öno naakuruusiri Uru ya Abhagaritayo, korri iga nköhe ënsë ëno ugiigari.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Abhuramu akamubhuuria iga, “ÖMÖNENE niekë ndakore manye iga nöraang'e ënsë ëno?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
