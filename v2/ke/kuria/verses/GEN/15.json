                {
                  "text": "Rum 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.12"
              },
              "items": [
                {
                  "text": "Ibr 11:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ÖMÖNENE akarichokia Abhuramu isikö na kömöteebhia iga, “Garamëra igörö kuriöbha! Öbhare ichinyunyuunyi, nyoora ögatöra guchibhara.” Mböyö bheene uruibhöro rooo röraabhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        }
      ]
    },
