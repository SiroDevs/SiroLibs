                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano iriöbha rëërë gösëkëra, Abhuramu nagootëröë na ichitërö ichindito irihahia na igisuntë ëkënene gëëkamugubha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
