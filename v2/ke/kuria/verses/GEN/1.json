            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akabhaitabhiria na köbhateebhia iga, “Ibhörana na muichuri ëkëbhara, na mukiigari; möbhaahe ichinsui, na ibhinyunyi; na ibhiteemoa bhia këra tuubho bhino bhikuing'uura gökëbhara.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Ënooköë akagamba iga, “Maaha mbahaayë ëmëtë gi ichintetere gi ichituubho chonsui, na ëmëtë gia amakö gi ichituubho chonsui gökëbhara iga gëbhe ibhiakörea bhienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ichitiinyi chonsui cha ibhara na ibhinyunyi bhionsui na ibhiteemoa bhionsui bhino bhikuing'uura na ibhiteemoa ibhihoru bhionsui, mbihaayë amatö gonsui gë ëmëtë köbha ibhiakörea bhiacho.” Na gëkabha ke hayö ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.30",
            "verseOrgIds": [
              "GEN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akamaaha iga mbuuya kubhintö bhionsui bhino aateemërë, akagookeroa bhökong'u. Bhökaira na bhögakëa, urusikö ro gasansabha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.31",
            "verseOrgIds": [
              "GEN.1.31"
            ]
          }
