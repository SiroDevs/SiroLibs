              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.16"
              },
              "items": [
                {
                  "text": "Ibr 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobho akamöteebhia iga, “Kuhika ntueneerria tanga.” Igo, Esau akamutueneerria, na kumugurria öbhötangi bhooe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho bhoono Yakobho akaha Esau ömögaate na ichihëndë nke igo, nawe akarëa na kunyua, hakurua akaimöka na kuya bhooe. Niigo Esau aaseerrë öbhotangi bhooe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
          }
        }
