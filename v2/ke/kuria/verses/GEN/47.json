          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobho naamenyërë gönsë ya Misiri kömeeka ikumi na muhungatë, kuhika hano aahikiri ëmeeka irigana rimui na mërongo ënai na muhungatë (147). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
