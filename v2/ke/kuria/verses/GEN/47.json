                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hano ënkaaga yu ugukua kooe yabhaayë hang'i, naabhërëkëëyë ömoona waae Yusubhu akamöteebhia iga, “Bhoono, hano ndanyoore maheene nöhanchërë, söhia ököbhoko kooo guchinsangiri",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "47:29",
              "type": "text"
            },
            {
              "text": "Söhia ... Guchinsangiri:",
              "type": "text"
            },
            {
              "text": "Nigo imuuma yakarëywë, na tëgaranchöroa hai.",
              "type": "text"
            }
          ]
        },
        {
          "text": " chaane, öndagane iga nörankorrë gösööko na köbhöheene. Ötagaacha göntökëra gönsë ëno ya Misiri, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "gëtatiga uche kömbëëka hamui na bhaguuka bhaitö, uche kunyimukia kurua Misiri na göntökëra guchimbëëhera chaabho.” Yusubhu akahunchukia iga, “Nëndëkora bhöyö ögambërë.”",
          "type": "text",
