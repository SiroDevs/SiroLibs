                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua Yakobho akamubhuuria iga, “Tateebhia iriina reeo hano ökahancha.” Sibhoono ömöntö ööra akahunchukia iga, “Nkugira kë umbhuuri iriina?” Hakurua agaitabhiria Yakobho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobho akaröka ahasë hayö iga Bhenueri, akagamba iga, “Ndööchë Ënooköë kömaiso, si nangërë gukua.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iriöbha rëkarasa nkaaga Yakobho aarëngë kurua Bhenueri, akaya arasögöra gikugira ya ëntere yaae. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
