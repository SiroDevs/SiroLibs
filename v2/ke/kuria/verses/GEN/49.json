              "items": [
                {
                  "text": "Ögt 35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayö nëho bhano bhatökëëyöë: Ibhurahimu na Sara mökaae, Isaka na Rebheka mökaae, na nëho bheene nabhëkërë Rea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömögöndö gööra hamui na ëmbaate ëëra mbiagörröë kurua Köbhahiti.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        }
      ]
    },
