        },
        {
          "text": "Ënooköë agaitabhiria Nuhu na abhaana bhae akabhateebhia iga, Taibhöra, muiyengeri, muichuri ëkëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichitiinyi chonsui cha ibhara, ibhinyunyi bhionsui bhia igörö, ibhiteemoa bhionsui bhino bhikuing'uura na ichinsui chonsui chi inyancha nchiraabhe na irihahia igörö yainyu na köbhoobhoha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichitiinyi chonsui nchiraabhe ibhiakörea bhienyu keehaara bheene nabhahaayë ichinyinyi cha amatö köbha ibhiakörea bhienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
