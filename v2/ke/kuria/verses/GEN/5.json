          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Seti aasookiri kuibhöra Ënosi, naamenyërë ëmeeka amagana anaanai na muhungatë (807), na kuibhöra abhaana bhandë bhë ëgësaacha na ëgëkari; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
