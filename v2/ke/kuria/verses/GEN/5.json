              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aasookiri kuibhöra Rameki, naamenyërë ëmeeka amagana muhungatë na mërongo ënaanai na ëbhërë (782). ",
          "type": "text",
          "attrs": {
