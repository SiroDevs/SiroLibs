            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.4"
              },
              "items": [
                {
                  "text": "Mat 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.6"
              },
              "items": [
                {
                  "text": "Mk 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naateemërë ömösaacha na ömökari, akabhaitabhiria, na köbharöka iga, “Abhantö.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Atamu aahikiri ëmeeka irigana rimui na mërongo ëtatö (130), naanyoorrë ömoona wë ëgësaacha öno amutuubhërë, naarëngë na ëgësösa keee; akamöröka iga Seti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aasookiri kuibhöra Seti naamenyërë ëmeeka amagana anaanai (800), na kuibhöra abhaana bhandë bhe ëgësaacha na ëgëkari; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamu nakuurë ana ëmeeka amagana kenda na mërongo ëtatö (930).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
