        },
        {
          "text": "Ëno niyo ërondoorio yu uruibhöro ro Atamu. Hano Ënooköë ateemërë ömöntö naamökorre gutuubho yaae umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
