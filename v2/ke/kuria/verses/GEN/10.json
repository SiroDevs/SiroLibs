  "reference": "Ögötanga 10",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "GEN 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruibhöro röa abhaana bha Nuhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Röno ndo uruibhöro roa abhaana bha Nuhu: Semu, Hamu na Yabheti; harëbho mbaibhööyöe abhaana hano ëhöörö yaasirrë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.1",
            "verseOrgIds": [
              "GEN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Yabheti mbano iga: Gomeri, Magogu, Matai, Yabhani, Tubhari, Meseki na Tirasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Gomeri mbano iga: Asikenasi, Ribhati, na Togama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.3",
            "verseOrgIds": [
              "GEN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Yabhani mbano: Erisa, Tarisisi, Kitimu, na Totanimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.4",
            "verseOrgIds": [
              "GEN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo isimisi ya abhantö bhano bhansansërë kömöndaara gui inyancha, këra bhantö na këgambo keebho, guchika chaabho na ichihamatë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.5",
            "verseOrgIds": [
              "GEN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Hamu mbano iga: Kusi, Misiri, Bhuti, na Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.6",
            "verseOrgIds": [
              "GEN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Kusi mbano iga: Sebha, Hawira, Sabhuta, Raama, na Sabhuteka. Abhaana bha Raama mbano iga: Sebha na Tetani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.7",
            "verseOrgIds": [
              "GEN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusi nëwe aarëngë isawaabho Nimuroti, öno aarëngë ömökarë wa mbere gökëbhara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.8",
            "verseOrgIds": [
              "GEN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu umuguimi ömökarë aarëngë mbere yö ÖMÖNENE, nkio gikugira ëkërengio këëho iga, “Kë Nimuroti umuguimi ömökarë mbere yö ÖMÖNENE.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.9",
            "verseOrgIds": [
              "GEN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhögambi bhooe mbootangëëyë kumigi ge: Bhabheri, Ereki, na Akati gionsui ngerëngë gönsë ya Sinari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.10",
            "verseOrgIds": [
              "GEN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua gönsë ëyö, Nimuroti naagëëyë Asuru, akahagaacha imigi gë Ninawi, Rehobhoti-Iri, Kara, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.11",
            "verseOrgIds": [
              "GEN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Reseni göno görëngë gatai ya Ninawi na umugi ömönene go Kara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.12",
            "verseOrgIds": [
              "GEN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri naarëngë isawaabho Abharuti, Abhaanamu, Abharehabhi, Abhanabhutuhi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.13",
            "verseOrgIds": [
              "GEN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhabhatirusi, Abhakasiruhi (mbo bhaarëngë abhasimuri bha Abhabhirisiti), na Abhakabhutori.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.14",
            "verseOrgIds": [
              "GEN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaani naarëngë isawaabho Sitoni ömötangi waae, na Heti ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.15",
            "verseOrgIds": [
              "GEN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "guiki nëwe aarëngë guuka wa Abhayebhusi, Abhaamori, Abhagirigasi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.16",
            "verseOrgIds": [
              "GEN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhahibhi, Abhaariki, Abhasini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.17",
            "verseOrgIds": [
              "GEN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abharibhati, Abhasemari, na Abhahamati. Hakurua Ibhisaku bhia Abhakanaani bikanyeregana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.18",
            "verseOrgIds": [
              "GEN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë yaabho ëgatangëra Sitoni kögëëra sööchë, kuhika Gerari köhëkëëra Gasa, na kögëëra rögörö kuhika Sotoma na Gomora, Atima na Sebhoimu kuhika Rasa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.19",
            "verseOrgIds": [
              "GEN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Röno ndo uruibhöro ro Hamu köreng'aana na ibhiaro bhiabho, ibhigambo bhiabho, ënsë yaabho na ichihamatë chaabho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.20",
            "verseOrgIds": [
              "GEN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semu ömönene öno aarëngë harë Yebheti, nëwe aarëngë isawaabho Abhaebhurania bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Semu mbano iga: Eramu, Asuru, Aribhakisati, Ruti, na Aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.22",
            "verseOrgIds": [
              "GEN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bha Aramu mbano iga: Usi, Huri, Geteri na Masi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.23",
            "verseOrgIds": [
              "GEN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aribhakisati akaibhöra Sera, na Sera akaibhöra Ebheri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.24",
            "verseOrgIds": [
              "GEN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebheri naarë na abhaana bhabhërë; öwambere akamöröka iga, Bheregi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:25",
              "type": "text"
            },
            {
              "text": "Bheregi:",
              "type": "text"
            },
            {
              "text": "Iriina rëyo ndëtubhaine në ëngamba ya Abhaebhurania iga “ökohökana”",
              "type": "text"
            }
          ]
        },
        {
          "text": " kugira nkanyoora ëyö abhantö bhanyeregana gökëbhara; na öwa kabhërë akamöröka iga Yokitani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.25",
            "verseOrgIds": [
              "GEN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yökitani naarëngë isawaabho Arimotati, Serebhu, Hasarimaweti, Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.26",
            "verseOrgIds": [
              "GEN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatotoramu, Usari, Tikira, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.27",
            "verseOrgIds": [
              "GEN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhari, Abhimaeri, Sebha, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.28",
            "verseOrgIds": [
              "GEN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhiri, Hawira na Yobhabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.29",
            "verseOrgIds": [
              "GEN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë yaabho yaatangëëyë Mesa kuhika Sebhari, chöönööche ya rögörö. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.30",
            "verseOrgIds": [
              "GEN.10.30"
