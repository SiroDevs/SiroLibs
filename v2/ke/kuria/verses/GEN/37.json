        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isawaabho akagiöngöra, akagamba iga, “Ee-e, niyo bheene! Handë itiinyi ya ibhara imuitaini na kömörëa. Maheene Yusubhu atandrribhui amang'enga.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yakobho agatandrroa ichingëbho chaae köbhörrö, akaibhoha irigoneera, akang'uunyëra ömoona waae guchinsikö ichincharu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaana bhaae bhë ëgësaacha na ëgëkari bhakamögëëra iga bhamutirimiki, si akanga, akagamba iga, “Mötantiga, uni nëndagenderri köng'uunya gikugira yö ömoona waane, kuhika röno ndësëkëra kuya Bhui harë arëngë.” Niigo isawaabho aamököreeyë.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
