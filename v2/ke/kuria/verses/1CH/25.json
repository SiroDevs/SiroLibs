              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëgëkoobhoe ke mbere gëkaguëra Yusubhu öwë ëka ya Asabhu; ëge kabhërë Getaria hamui na ëka yaabho na abhaana bhaae ikumi na bhabherë; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
