              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhaisari, Kenania na abhaana bhaae mbaahaayöë ëmërëmo gio öbhötangati kia abhanene na abhahökania, gikugira ya Abhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
