              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köbhahebhuroni, Hasabhia na ëka yaabho ëgëköë kimui na amagana muhungatë (1,700), bhonsui igo abhantö abhakarë mbaahaayöë ëmërëmo ge kuimërërra ichintahana cha Isiraeri chino chaarëngë nyancha yö ömooro go Yorotani. Mbaimërërrëyë ëmërëmo gionsui gio ÖMÖNENE në ëmërëmo gio Tauti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
