            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga yö ögötaanga kömooka ömöhëa, ënkaaga ëno abhagambi bhakuya kuiihi, Yoabhu naatangatërë iricheesi na gösoheerra ënsë ya Abhaamoni, guiki akaya na könaria Rabha. Sibhoono Tauti naatigaaë Yerusaremu. Yoabhu nawe agaitania Rabha na kögöserekia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki Tauti akaimukia ëköndö kurua kömötöe gö Mirikoni ënooköë waabho; nawe akööngöra iga ëköndö ëyö yaarëngë nu ubhurito bhui ichikiro mërongo ëtatö na isaano chie ësahaabhu na mönsë yaayo amatiini gi iriguri irinene, Tauti nawe akagaimukia akagatööra gököndö yaae. Guiki, naaronërë ibhintö köbhooru kurua kumugi göyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki akaimukia abhantö bhu umugi göyö, akabhatööra bhakore ëmërëmo ni imisumeeno, ichisurru chi ibhiöma, ni ibhisire bhi ibhiöma. Niigo aakoorrë kumigi gionsui ge Abhaamoni. Hakurua Tauti na abhantö bhonsui bhakaringa Yerusaremu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iriihi na amantö ga Abhabhirisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano gayö gaiheniri, iriihi na Abhabhirisiti rëkarichokera göntahana ya Gaseri. Sibhekai, Umuhusati, agaita Sabhu öno aarëngë umui wu uruibhöro ro Abharebhai, amantö amanene; igo Abhabhirisiti bhagakëröa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.4+1SA.17.5+1SA.17.6+1SA.17.7"
              },
              "items": [
                {
                  "text": "1 Sam 17:4-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guiki iriihi na Abhabhirisiti rëkarichokera. Erihaimu ömoona o Yairi nawe agaita Rahimi mura omoobho Goriati, Umugiti, öno ömötë gui iritimö reee, ngorëëng'ani nö ömötë gu umuruki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga yëndë guiki iriihi rëkarichokera ëntahana ya Gati hano haarëngë na ögöntö gööndë göno gorëëngë na ibhiara bhisansabha këra köbhoko na bhisansabha këra kögörö, bhionsui igo ibhiara mërongo ëbhërë na bhinai. Ninyoora nëwe nu uruibhöro ro Abharebhai aarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe hano aiheemeyë Abhaisiraeri, Yonatani, ömoona o Simea, mura omoobho Tauti, naamuitërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö mbaarëngë uruibhöro ro ibhiraahi ëntahana ya Gati; nabho mbaitëröë na Tauti hamui na abhakoramërëmo bhaae.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
  ],
