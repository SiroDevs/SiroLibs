      },
      "items": [
        {
          "text": "Amaragirrio ga Tauti Igörö yë ëhekaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
