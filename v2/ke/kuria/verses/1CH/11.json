                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.21"
              },
              "items": [
                {
                  "text": "Abh 1:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakurua Tauti na Abhaisiraeri bhonsui bhakaya Yerusaremu harë Abhayebhusi bhaarëngë abhamenyi bhë ënsë ëyö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamenyi bha Yebhusi bhagateebhia Tauti iga, “Tögaasoha kumugi göno hai.” Ninyoora niigo, Tauti naamerri öbhögöe bho Sayuni, nko kögamba iga umugi go Tauti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nëho Tauti agambërë iga, “Ömöntö öno aratangate guitania Abhayebhusi, narabhe ömönene nö ömökönaare guicheesi.” Bhoono Yoabhu ömoona o Seruya, akabha öwambere köbhaitania, igo akabha ömönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti naamenyërë köbhögöe bhu umugi göyö, na kugira ya ëyö, umugi göyö gökabhërëkëroa iga, “Umugi go Tauti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naahagachërë umugi göyö götangëra Miro kuguinaara gonsui, na Yoabhu agakora umugi göyö bhöhëa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akagenderria kuya nkuma bhökong'u kugira, ÖMÖNENE wa amacheesi nhamui aarëngë nawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhaitani abhakarë bha Tauti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo bhaarëngë abhakönaare bha abhakarë bha Tauti, bhano hamui na abhantö bhandë bhonsui bha Isiraeri, mbamösëgëkërë kubhumui korri abhe ömögambi, kehaara ëng'ana yö ÖMÖNENE yaaragërë Köbhaisiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo bhaarëngë abhaitani abhakarë bha Tauti: Yasobheamu, Ömöhakimoni, öno aarëngë ömötangati wa “Bhatatö bhaara.” We naitani iriihi ana iritimö reee agaita abhantö amagana atatö (300) harrë rimui igo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki öno aamösëëyë köbhakare bhatatö bhaara Ereasari ömoona o Toto Umwahohi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë Ereasari aarëngë hamui na Tauti Bhas-tamimu haara, hano Abhabhirisiti bhairaini guitana iriihi. Köhasë hayö haarëënge nö ömögöndö göë ësayiri köbhooru, nëho Abhaisiraeri bhang'osëre Abhabhirisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono Tauti na abhantö bhaae bhakaimëërra bhakagöma gataigatai yö ömögöndö göyö na kuguitanëra, bhagaita Abhabhirisiti; ÖMÖNENE akabhatuuria gököbhaha ögökëra ökönene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sooki abhakarë bhatatö köbhakönaare mërongo ëtatö bhaara bhakang'arara kuhika kuirëngö, hano Tauti agobhërë, guisana re Aturamu. Ënkaaga ëyö iricheesi re Abhabhirisiti nkanyoora rëtöörëyë irisaanchö reebho kuibhatë re Rebhaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënkaaga ëyö Tauti aarëngë köbhögöe, ni iricheesi re Abhabhirisiti nario nëerënge Bheterehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akagamba gökëha ëkënene, “Wei hano ömöntö akang'a amanchë ga kunyua kurua kugisima ke Bheterehemu këno kërëëngë hang'i ni irihita riu umugi!” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhakarë bhaae bhatatö bhaara bhakarichoka, bhakaibhagagania gataigatai yi irisaancho ri iricheesi re Abhabhirisiti, bhakaya bhagataha amanchë kugisima ke Bheterehemu, hang'i ni irihita riu umugi, bhakarentera Tauti. Sibhoono Tauti akanga köganyua, na kuibhaga rëyö akagahöma hansë köbha ikimuenso kö ÖMÖNENE, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "aragamba iga, “Ëng'ana ke ëno ögëhetia harai na uni; tënkagëkora mbërë yë Ënooköë waane. Ubuuya ninyue amanyinga gö öbhohoru bho abhantö bhano? Kugira kögötööra öbhöhoru bhoobho götabharibharia bharëntere amanchë gano.” Köhayö Tauti taanyööyë amanchë gayö hai. Gayö ngo amang'ana gano abhakarë bhatatö bhaara bhaakorrë.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhisai, mura omoobho Yoabhu, naarëngë ömönene wa abhakarë mërongo ëtatö. We naitani iriihi ana iritimö reee agaita abhantö amagana atatö (300) harë rimui igo, iriina reee rëkaneneha köbhakarë bhatatö bhaara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, aköngökana bhökong'u köbhakarë mërongo ëtatö bhaara, igo akabha ömökönaare waabho, sibhoono taabhayë ömökarë kia abhakarë bhatatö bhaara hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenaya nawe, ömoona o Yehoyata, kurua Kabhuseeri, numusirikare ömökarë aarëngë öno aakoorrë amang'ana amaaru gë ëkërögöro. Naitërë abhakarë bhabhërë kurua Moabhu, nu urusikö röndë ënkaaga yi irigörö, nang'aaraarrë na guita indui kubhuina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, naitëre Umumisiri umui, ömöntö ömötambë, öbhötambë bhooe ngi ichimiita ibhërë, nawe gököbhoko kooe wanyoorrë agoterreeyë iritimö irinene bhökong'u, kiö ömoomba. Sibhoono Bhenaya akamögëra ana isiare, akamuruusia iritimö rëëra, na guita Umumisiri öyö ni iritimö reee umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenaya, ömoona o Yehoyata naakorrë amang'ana gayö, iriina reee rëkaya nkuma köbhakarë bhatatö bhaara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, akamanyëkana bhökong'u köbhakarë mërongo ëtatö bhaara, ninyoora ataarëengë ömökarë kia abhakarë bhatatö bhaara. Na Tauti akamöha öbhökönaarë bhua abhariihi bhaae umuene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhasirikare abhakarë bha Tauti mbano bharëngë: Asaheri mura omoobho Yoabhu, Erihanani ömoona o Toto wa Bheterehemu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
              "1CH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samoti Ömöharoti, Heresi Ömöbheroni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira, ömoona wa Ikesi Ömötekoa, Abhieseri Ömuanatoti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.28",
            "verseOrgIds": [
              "1CH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhekai Ömuhusati; Irai Ömuahohi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.29",
            "verseOrgIds": [
              "1CH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maharai Ömönetobhati; Hereti, ömoona o Bhaana Ömönetobhati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.30",
            "verseOrgIds": [
              "1CH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itai, ömoona o Ribhia, kurua Gibhea, uwi ikiaro ke Bhenchamini; Bhenaya Ömöbhiratoni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
              "1CH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurarai kurua kubhitabhöka bhia Gaasi, Abhieri Ömöaibhati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimaweti Ömöbhaharumu; Eriabha Ömösaaribhoni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.33",
            "verseOrgIds": [
              "1CH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "abhaana bha Yaseni Ömögironi; Yonatani, ömoona o Sagee Ömöharari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiamu, ömoona o Sakaria Ömöharari; Eribhari, ömoona o Uri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.35",
            "verseOrgIds": [
              "1CH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebheri Ömömekerati; Ahiya Ömöbheroni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesironi Ömökarimeri; Naarai, ömoona wa Esibhai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.37",
            "verseOrgIds": [
              "1CH.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeri, mura omoobho Natani; Mibhari, ömoona o Hagiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.38",
            "verseOrgIds": [
              "1CH.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sereki Ömöamoni; Naharai wa Ömöbheoroti muimukia bhiögë wa Yoabhu, ömoona o Seruya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira na Garebhu, bhano bhaarëngë Abhaitiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uria, Umuhiti; Sabhati ömoona wa Aharai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atina, ömoona o Sisa Ömöreubheni, ömönene wa Abhareubheni, arëngë hamui na abhantö mërongo ëtatö; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani, ömoona o Maaka, Yosabhati Ömömitini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usia Ömöasterati, Sama na Yeieri, abhaana bha Hotamu Ömöroeri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetiaeri na Yoha mura omoobho, abhaana bha Simuri Ömutisi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erieri Ömömahawi, Yeribhai na Yosabhia abhaana bha Erinaamu; Itima Ömömoabhu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erieri, Obheti, na Yaasieri Ömömesobhai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.47",
            "verseOrgIds": [
              "1CH.11.47"
            ]
          }
        }
      ]
    }
  ],
