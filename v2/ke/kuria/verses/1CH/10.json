                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sauri naakuurë gikugira ya konga köbha ömöheene; taarëënge möheene gikugira taagootërë ëng'ana yö ÖMÖNENE na naagëyë kömöraguri iga amöragöre, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "agatiga kubhuria ÖMÖNENE. Kugira ya ëyö ÖMÖNENE akamuita, nö öbhögambi bhooe akaha Tauti ömoona o Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
