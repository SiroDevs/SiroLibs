{
  "id": "1CH.12",
  "number": "12",
  "bookId": "1CH",
  "reference": "1 Amang'Ana Gi Ichinkaaga 12",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhantö bha Mbere guitabhiirria Tauti kurua Köbhabhenchamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo abhasirikare bhano bhaagotaini na Tauti ëntahana ya Sikiragi, nkaaga wanyoorrë atarëngë muchencho götaara gikugira yö ömögambi Sauri ömoona o Kisi; mbaarë ho abhamui bha abhasirikare abhakarë bhano bhaamutuuriyi kuiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhayö na abhantö bhi ikiaro ke Bhenchamini bhaarëngë kehaara Sauri aarëngë. Na abharasi ibhihubheebhe bhi imigui bhaarëngë, na abharekeri bhi ichindrrruchi bha amabhoko gonsui, ökobhörëo nökobhömosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahieseri nëwe aarëngë ömötangati waabho, öno atuurraini na Yoasi, bhonsui abhaana bha Semaa kurua Gibhea; abhandë mbaabhö: Yesieri na Bhereti, abhaana bha Asimaweti, Bheraka, Yehu kurua Anatoti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimaya kurua Gibheoni, ömöntö ömökarë köbhantö mërongo ëtatö bhaara na guiki ömötangati waabho hamui na Yeremia, Yahasieri, Yohanani, Yosabhati kurua Getera, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erusai, Yeremoti, Bhearia, Semaria, Sebhatia, Mharubhi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erikana, Isia, Asareri, Yoeseri, kurua kögësaku ge Kora ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yoera na Sebhatia, abhaana bha Yerohamu, kurua Getori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhasoorani bha Tauti Kurua gukiaro ke Gati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua gukiaro ke Gati, bhano mbo abhasirikare abhakarë, abhunguri na abhakunguuruku bhi iriihi bhano bhaitabhëraini ni iricheesi re Tauti nkaaga aarëngë köbhögöe guiköngö. Na abhaitani abhakarë bha amatimö ni ichingubha bhaarëngë, bhano bhaana amaiso gakööbhohia kia agichindui, na guchinguku nabhangö bhaarëngë ki ibhichoohe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömötangati waabho ömönene Eseri aarëngë, öwa kabhërë Obhatia, öwa gatatö Eriabhu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "öwa kanai Misimana, öwa gataano Yeremia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "öwa gasansabha Atai, öwa muhungatë Erieri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "öwa kananai Yohana, öwa kenda Erisabhati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "öwa ikumi Yeremia, nö öwa ikumi na kamui makibhanai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambati bho, mbaarëngë abhakönaare bhi iricheesi. Köreng'aana nö öbhönene bhoobho, ömöke naimërrëyë abhasirikare irigana (100), nö ömönene naimërrëyë abhasirikare ëgëköë kimui (1,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo abhantö bhano bharöbhökërë ömooro go Yorotani kumueri go mbere, nkaaga ömooro gonyoore guichöyë na köbhocha guchintahana chonsui na kunyeregania abhantö kuya rögörö na nyancha yö ömooro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhasoorani kurua Köbhabhenchamini na Abhayuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö abhamui gukurua gukiaro ke Bhenchamini na Yuta mbaahikërë köbhögöe hano Tauti aarëngë. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akarichoka këbhara köbhaturung'ana, akabhateebhia iga, “Hano ndanyoore mmuchërë harë uni kia abhaasani korri muntuurri nëndabhairigani gönkoro inchiiya, sibhoono hano ndanyoore mmuchërë korri mönköbhösani köbhabhisa bhaane, ninyoora tëndakora ibhë rërë rionsui, Ënooköë wa bhaguuka bhaitö abhamaahe na abhang'onere.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neho Ënkoro yasëkeerëëye Abhisai, ömönene wa abhantö mërongo ëtatö bhaara, nawe akagamba iga,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhasoorani kurua gukiaro ke Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhasirikare bhaandë kurua gukiaro ke Manase, mbaang'osërë na kuya harë Tauti, nkaaga aatanööyë hamui na Abhabhirisiti kuya guitana na ömögambi Sauri. Sibhoono ninyoora niigo, tabhatuuriyi kugira abhabhaahi bha Abhabhirisiti mbaitabhirraini iga bhamurugi aringe Sikiragi bharagamba iga, “Ntöratöre amabhaho gaitö götabharibharia kugira naratöngösë ariinge harë Sauri ömönene waae.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tauti aarëngë Sikiragi, bhano mbo abhantö bhi ikiaro ke Manase bhano bhaagëyë harë we: Atina, Yosabhati, Yetiaeri, Mikaeri, Yosabhati, Erihu, na Sirethai. Këra umui waabho naarëngë ömötangati wi irikomo ria abhantö ëgëköë kimui (1,000) gukiaro ke Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaatuuriyi Tauti guitana na amacheesi ga abhabhisa, kugira bhonsui mbaarëngë abhaitani abhakarë na abhakönaare guicheesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruiso ronsui, abhantö mbaarë kuya harë Tauti kumutuurria, kuhika akabha ni iricheesi irinene, ki iricheesi rë Ënooköë.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gano ngo amacheesi ga Tauti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ngo amacheesi ga abhasirikare bhano bhaarëngë ni ibhiögë, bhano bhaagootaini na Tauti Hebhuroni haara na kömökora ömögambi kuibhaga re Sauri, köreng'aana nëng'ana yö ÖMÖNENE: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro ke Yuta bhano bhaarëngë na amatimö ni ichingubha, mbaarëngë ibhiköë bhisansabha na amagana anaanai (6,800). Bhonsui bhaana ibhiögë bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ge Simioni, abhantö ibhiköë muhungatë ni irigana rimui (7,100), abhakarë na bhano bhaana öbhunguri öbhönene bhui iriihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro kia Abharawi: Abhantö ibhiköë bhinai na amagana asansabha (4,600). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyata, wu uruibhöro ro Haruni na abhantö bhaae: Abhantö ibhiköë bhitatö na amagana muhungatë (3,700). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëka ya Satoki, umumura ömökarë kuiihi, naarëngë we hamui na abhakönaare mërongo ëbhërë na bhabhërë kurua kögësaku ge isawaabho umuene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ke Bhenchamini (ikiaro ge Sauri): Abhantö ibhiköë bhitatö (3,000). Abhaaru bhaabho mbaagenderreyi köbha abhaheene harë Sauri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ke Ebhuraimu: Abhantö ibhiköë mërongo ëbhërë na amagana anaanai (20,800), bhano bhaarë abhakarë bhökong'u, guiki bhano bhmanyekaini kubhisaku bhiabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua guitënë ri ikiaro ke Manase: Abhantö ibhiköë ikumi na bhinaanai (18,000), bhano bhaatonëröë amariina korri bhaache götööra Tauti abhe ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ke Isakari: Abhanene amagana abhërë (200) hamui na ëka yaabho bhonsui bhaarëngë hansë yö öbhötangati bhoobho. Abhanene bhayö mbaarëngë nu ubhunguri bho kömanya amang'ana gi ichinkaaga na këno keragërë Abhaisiraeri gökora. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ge Sebhuruni: Abhantö ibhiköë mërongo ëtaano (50,000); abharöngë na abhaköraano bhi iriihi. Mbaiseemiri ni ibhiögë bhi iriihi bhichiteemo chonsui, irituno reebho nu ugutuuria Tauti bheene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ke Nabhutari: Abhakönaare ëgëköë kimui (1,000) hamui na abhantö ibhiköë mërongo ëtatö na muhungatë (37,000) bhano bhaana ichingubha na amatimö. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ge Tani: Abhantö ibhiköë mërongo ëbhërë na bhanaanai na amagana asansabha (28,600) bhano bhaibhoheeyë ibhiögë bhi iriihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro ke Aseri: Abhantö ibhiköë mërongo ënai (40,000), abhaköraano bhi iriihi, bhano bhaisemiri guitana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurua gukiaro kia Abhareubheni, Gambati na iritënë ri ikiaro ke Manase kurua ihumbu yö ömooro go Yorotani: Abhantö ibhiköë irigana rimui na mërongo ëbhërë (120,000) bhano bhaana ibhiögë bhi iriihi bhi ichiteemo chonsui.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhasirikare bhayö bhonsui, mbhano wanyoorrë bhaisemiri kimui kuiihi, mbaagëëyë Hebhuroni ni inyonta yaabho ënene nö ögötööra Tauti abhe ömögambi wa Isiraeri yonsui. Na abhantö bhonsui bha Isiraeri, nabho mbaabhayë bhumui bhaana inyonta imui ya götööra Tauti abhe ömögambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, mbaaikaayë na Tauti gönkaaga yi ichinsikö isatö, bhararagëra na kunyua kugira ëka yaabho nkanyoora bhabasemiiyi ibhiakörea. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gökëra gayö, abhanyaröbheri bhaabho bha hang'i na mbaara bha aharai ke bhaara bha Isakari, Sebhuruni, na Nabhutari, mbabharënteyë ibhiakörea bhabhimukiri guchitëkërë, ichingamëëra, ichitërë-bharasi, na ichintang'ana. Mbabharënteyë öbhöse, amakö, ichihagöe ichinyömö chichisabhibhu, itibhaai, na amaguta, ichintang'ana na amang'ondi amaaru, kugira Isiraeri yaabhayë na ëmëgooko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
    }
