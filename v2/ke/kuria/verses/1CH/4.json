            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gunchinsikö chö ömögambi Hesekia wa Yuta, abhantö bhayö bhataröë amariina gaabho mbaagëyë Getori, bhagasaria ibhitume na amagutu ga Abhameuni bhano bhaakamenyërë ho na köbharugia kimui kuhika reero röno. Bhakamenya ho, kugira haarëngë na amanyanki ga guisa kurisia amang'ondi gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhi ikiaro ge Simioni ëkërengere kia amagana atano (500) mbaagëyë kuhika kunguku ya Seiri. Mbatangatëröë na Bheratia, Nearia, Rebhaya na Usieri, abhaana bha Isi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayö bhagaita ichintirruki cha Abhaamareki chino chanyoorrë chaatama, na bhakamenya ho kuhika reero ëno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
