              },
              "items": [
                {
                  "text": "2 Gam 15:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruibhöro ro Yoeri gökörondoria mbaarëngë Semaya, Gogi, Simei, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika, Reaya, Bhaari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bheera, öno ömögambi Tigirati-Bhireseri wë ënse ya Asuru aimukiri ubhunyambu, ninyoora nö ömökönaare wa Abhareubheni aarëngë, akamuhira köng'aanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo abhanene bhi ibhiaro bhano bhaandëkëröë köhëëtöko yë ikiaro ke Rubheni; Yeieri, Sekaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhera, ömoona o Asasi na ömöchökörö o Sema, uwi ikiaro ke Yoeri, bhano bhaakamenyërë Aroeri na göntahana yonsui ya sööchë kuhika Bhera na Bhaari-meoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guiki, kugira yi ichitugo chaabho kuiyengeria köbhooru bhökong'u gönsë ya Gireati, mbaasagankërë kuya göntahana ya rögörö kuhika kubhisohero bhi iribhara rëno regëëyë igo kuhika kömoro go Yubhurati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö chö ömögambi Sauri, ikiaro ke Rubheni ngeitaini na Abhahachiri, bhakabhaita kuihi na köbharuusia ënsë yaabho yonsui ya rögörö ya Gireati, bhakamenya ho kömagutu gaabho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruibhöro ro Gati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiaro ke Gati mbaturraini na ikiaro ke Rubheni ëntahana ya sööchë, gönsë ya Bhasani ëno raayë kuya rögörö kuhika Sareka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeri nëwe aarëngë umusimuri wë ëgesaku ëgëtangati, öwa kabhërë Sabhamu. Yanai na Sebhati mbaarë abhasimuri bhi ëgesaku këndë göntahana ya Bhasani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhamura omoobho köreng'aana na ibhisaku bhiabho mbaarë muhungatë: Mikaeri, Mesuramu, Sebha, Yorai, Yakani, Sia, na Ebheri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhonsui bhano na abhaana bha Abhihairi, öno aarëngë ömoona o Huri, öno aaibhööyöë na Yaroa, ömoona o Gireati, öno aibhööywë na Mikaeri, ömoona o Yesisai, öno aaibhööyöë na Yato, ömoona o Bhusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi, öno aarëngë ömoona wa Abhutieri na ömöchökörö o Guni, nëwe aarëngë ömönene wi ibhisaku bhino. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaamenyërë göntahana ya Gireati, na göntahana ya Bhasani na imigi geeyo na kubhurisiriö bhonsui bho Saroni, kuhika guchibhaga chaabhio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhayö bhonsui mbaandëkëröë guchinsabho, guchinsikö cha Yotamu, ömögambi o Yuta, na Yerobhoamu, ömögambi wa Isiraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amacheesi gi ibhiaro bhia Rögörö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibhiaro bhia Rubheni, Gati, na Manase ya rögörö, mbaarë na abhasirikare abhaitani ibhihubheebhe ëkërengere ki ibhiköë mërongo ënai na bhinai na amagana muhungatë na mërongo ësansabha (44,760), abhichingubha na ichinchonge, na abharasi ibhihubheebhe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagaitana iriihi na ichihamatë cha Abhahachiri, Abhayeturi, Abhanabhisi, na Abhanotabhu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaatörrë amaiteng'ero gaabho harë Ënooköë na bhakamösabha abhatuurri, nawe akabhaitabhëra irisabhi reebho bhagakëra Abhahachiri hamui na bhasaani bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhakabharuusia ichingamëëra ibhiköë mërongo ëtaano (50,000), amang'ondi ibhiköë amagana abhërë na mërongo ëtaano (250,000), ni ichitëkërë ibhiköë bhibhërë (2,000), na abhaanyambu ibhiköë irigana rimui (100,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaitërë abhabhisa abhaaru bhökong'u, gikugira iriihi rëyö nërë Ënooköë rerëëngë. Nabho bhakagenderria kömenya gönsë ëyö, kuhika gönkaaga yë ëng'anyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhantö bha Manase ya Rögörö",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
