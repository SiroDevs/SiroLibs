            "sid": "1CH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono abhantö bhakaanga Ënooköë wa bhaguuka bhaabho, bhagakora ubhuhurunkanu bho gösengera ichinooköë cha abhamenyi bhi ichinsë chiyö, bhano Ënooköë asikiri kömaiso gaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.25",
            "verseOrgIds": [
              "1CH.5.25"
            ]
          }
