            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Manase ya rögörö mbaamenyërë gönsë ya Bhasani. Bhakaiyengeria köbhooru, bhagasansa ëntahana ya sööchë kuhika Bhaari-herimoni, Seniri, na kunguku ya Herimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhano mbo bhaarëngë abhanene bhi ichika chi ikiaro këyö: Ebheri, Isi, Erieri, Asirieri, Yeremia, Hotabhia, na Yatieri. Bhonsui na abhaitani abhakarë bhaarëngë, abhantö bhi ikuuge ënene, abhatangati bhi ibhisaku bhiabho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhiaro bhia rögörö bhiraimukibhua ubhunyambu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
