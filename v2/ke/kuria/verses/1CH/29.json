              "items": [
                {
                  "text": "1 Gam 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nëhö Suremani aikayë kugitumbë kiö öbhögambi kiö ÖMÖNENE, kiö ömögambi kuibhaga re Tauti isawaabho. Nawe agakora bhuuya, na ëhamatë yonsui ya Isiraeri ëkamösööka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhatangati bhonsui na abhakarë nabho na abhaana bhonsui bhö Ömögambi Tauti bhakaragana köbha abhasuuki kö Ömögambi Suremani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ÖMÖNENE akaha Suremani ëgöngo inchiiya kömaiso ga Abhaisiraeri bhonsui, akamöha ikuuge yö öbhögambi ëno ëkërrë ikuuge yö ömögambi, öre wonsui aagambëëyë Isiraeri ataragëgambëra.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhögambi bho Tauti Kubhuëng'ë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
