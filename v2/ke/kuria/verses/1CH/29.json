        "style": "s1"
      },
      "items": [
        {
          "text": "Ibhiruusio bhia Köhagachëra Ëhekaru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
