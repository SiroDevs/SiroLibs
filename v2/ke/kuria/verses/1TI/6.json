  "reference": "1 Timoteo 6",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1TI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bhonsui bhano bharëngë abhagöre kuhika bhasööke abhanene bhaabho, korri abhantö bhatagaacha kögamba Ënooköë bhöbhëëbhë hamui na amaigiö gaitö. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhagöre bhaara abhanene bhaabho bharëngë abhakumia bhange gösera abhanene bhayö gikugira iga na abhakumia, sibhoono kuhika bhabhakorre bhuuya bhökong'u kugira bhayö bhaagökorra na abhakumia guiki abhahanchöa bhaabho.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaigiö gö öbhörongo na öbhoomë bhö öbhöheene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhika wiigi na usimisiri amang'ana gano. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore ömöntö örë wonsui araigia amang'ana amahagarë, ataguitabhërrania na amang'ana amaheene gano gaagambëröë na Ömönene weitö Yesö Kirisitö hamui na amaigiö gu ubhusuuki kö Ënooköë, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "öyö aichöra ubhuihechi na tamanyërë gëntö hai, nö ömöntö öno ahanchërë ichinkaani na iribhëëha kömang'ana amachua. Amang'ana gano ngo gakörenta irihari, iribhëëha, amatuki, uguitegeerra ököbhëëbhë, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ichinkaani ruiso ronsui kurua köbhantö bhano amongo gaabho gaahëtëërana na tëbhaana bhöheene hai. Ngökanya bharë iga ubhusuuki bhöë Ënooköë nkörenta bhörë öbhoomë.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheene ubhusuuki kö Ënooköë mbööna öbhoomë öbhönene, hano ndanyoore nahënyëka na ibhintö bhino anabhio. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugira tëtoorentërë gëntö kërë gionsui gökëbhara hai, na guiki titurirua na gëntö kërë gionsui gökëbhara hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö hano ndanyoore tööna ibhiakörea na ichingëbho, bhiyö mbhituisërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono bhaara bhagutuna koomëha nkögöa bharë kömasaacho, na kögootibhua na ömöhana gu ubhuigombi öbhönene öbhöbhëëbhë bhö öbhötöhö, bhöno bhököbharuta bhaya köbhösaria bho gusika. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ököhancha ichimbiria nko ënsëmöka yu ubhunyaanku bhonsui. Gököhancha ichimbiria abhamui bhaahökëra kurua kubhukumia na bhaitëbhëta abhiene na kuirentera öbhörrö öbhönene.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaragirriö harë Timoteo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono uwe, örë möntö wë Ënooköë öng'ose kurua kömang'ana gayö. Ruiso ronsui öbhe ömöröngë, öbhe na ubhusuuki kö Ënooköë, öbhe na ubhukumia, öbhöhanchi, ubhugumirria hamui na ubhususeenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witane iriihi iriiya rëno rërëngë iriu ubhukumia, korri unyoore öbhöhoru bho kuya ëyö, bhöno waabhërëkërrëëyöë nkaaga waitabhirriiyi ubhukumia bhooo köbhaherekia abhaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.37"
              },
              "items": [
                {
                  "text": "Yoh 18:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbere yë Ënooköë öno aköhaana öbhöhoru kubhintö bhionsui na mbere ya Yesö Kirisitö öno aaruusiri öbhöhereki öbhöheene mbere ya Bhontio Bhiratö, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndagöteebhia iga ögoote bhökong'u amarago köbhöheene kuhika röno Ömönene weitö Yesö Kirisitö ariicha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uguucha kooe nkörëbha ënkaaga ëno yaisa göseemibhua na ööra arëngë umuitabhiribhua, öno arëngë Ömögambi bheene, Ömögambi wa abhagambi na öno bheene arëngë Ömönene wa abhanene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
              "1TI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "We bheene nëwe arëngë ho kuya ëyö kömërengaria gëno ömöntö atagaatöra kuhika hang'i. Taaho öno aakamörööchë hai, na taaho öno akaamömaaha hai. Ahaabhöe ësööko na ögötöra kuya ëyö na ëyö! Amina.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ötaki abhaamë bhi ibhintö iga bhange kuihechera ibhintö gösë öbhoomë bhöno bhötaana bhöheene, sibhoono bhaihechere Ënooköë öno köbhögesa bhooe agötöha ibhintö bhionsui korri iga bhitögooki. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhataki iga bhakore amaiya, bhaamëhe kögökora öbhöheene, bhabhe abhagesa bhano bhagösanga ibhiabho na abhandë. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.18",
            "verseOrgIds": [
              "1TI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mbakora ke hayö, hayö nöranyoore mbaibhëkëëyë ëmongo ëno ërëbha öbhörösa öbhökong'u harë bho guchinsikö chino chiguucha. Kögökora igo hayö bhoono mbaranyoore öbhöhoru bhöno bhörëngë öbhöhoru ënkönëka.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteo, tariiha bhuuya bhino bhionsui bhiatööröa harë uwe. Wibhechi isumaacho yë ëkëbhara na ichinkaani chö öbhötöhö igörö ya këëra bhaköbhërëkëra iga, “Öbhöng'aini.” ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.20",
            "verseOrgIds": [
              "1TI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhamui bhano bhaimaaha iga mbaana öbhöng'aini bhöyö, bhaahökëra kurua gönchëra yu ubhukumia. Ësaramita yë Ënooköë ëbhe na bhainyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    }
  ],
