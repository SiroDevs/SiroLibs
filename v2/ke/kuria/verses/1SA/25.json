          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruku ro Samueri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Samueri aakuurë, Abhaisiraeri bhonsui mbairaini bhakamököörra, hakurua bhakamötökëra waae ka kumugi go Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tauti na Abhigairi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Tauti akaaimöka akaya guiköngö re Bharani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkanyoora ömöntö öndë aarëngë Maoni, öno aarë gökora ubhusuruusia kumugi go Karimeri. Ömöntö öyö nö ömoomë bhökong'u arëngë; naarëngë na amang'ondi ibhiköë bhitatö (3,000), na ichimburi ëgëköë kimui. Naarë kögasa amang'ondi gaae amachoki ku umugi go Karimeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.2",
            "verseOrgIds": [
              "1SA.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö öyö naarë köbhërëkëroa iga Nabhari na mökaae naarë köbhërëkëroa iga Abhigairi. Ömögaikörö naarëngë umunguri na ömörerechu, sibhoono ömösaacha nu umuhiti aarëngë na ömötanini; kurua gööka ya Karebhu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.3",
            "verseOrgIds": [
              "1SA.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röndë, Tauti aarëngë guiköngö akaigua iga Nabhari nkögasa arë amang'ondi gaae amachooki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.4",
            "verseOrgIds": [
              "1SA.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti agatöma abhamura ikumi iga, “Taya Karimeri, harë Nabhari mömönkeerri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.5",
            "verseOrgIds": [
              "1SA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mömöteebhi iga Tauti agökeerri iga, ‘Ömörembe göbhe hamui na uwe hamui na ëka yaao na bhiira bhonsui önabhio. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.6",
            "verseOrgIds": [
              "1SA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiguurë iga nööna abhantö bhano bhagökögasa amang'ondi amachooki; bhoono abhariisia bhaao mbaaya bharabha harë bhaitö, na bhaitö tëtobhanaahërë gösë köbhakaania gëntö guchinsikö chonsui chino bhaabha Karimeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.7",
            "verseOrgIds": [
              "1SA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhuuria abhamura bhaao bhagöteebhi. Köhayö, hano ökahancha tiga abhamura bhaane bhayö bhanyoore igisiö mbere yaao, kugira bhagöchëëyë urusikö ruë ësögökörö. Ndasabha iga, öhe abhakoramërëmo bhaao hamui na Tauti ömoona waao kërë gionsui önakio.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.8",
            "verseOrgIds": [
              "1SA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhamura bhaara bha Tauti bhahikirë mbaateebhiri Nabhari amang'ana gaara ga Tauti gonsui; sooki bhakaganya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.9",
            "verseOrgIds": [
              "1SA.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Nabhari akahunchukiria abhantö bhaara bha Tauti iga, “Tauti nëwe ng'ui? Ömoona o Yese ning'ui? Nsikö chino abhakoramërëmo nabhaaru bhaköng'osa kurua köbhanene bhaabho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.10",
            "verseOrgIds": [
              "1SA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyekë ndaimuki ömögaate goone, na amanchë na inyama ënö ngoogeeyë abhagasi bha amachooki ga amang'ondi gaane, nëhe abhantö bhano ntamanyërë harë bharuurë?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.11",
            "verseOrgIds": [
              "1SA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo abhamura bhaara bha Tauti bhakaihönchöra bhakaringa na göteebhia Tauti këbhörë bhahunchukiribui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.12",
            "verseOrgIds": [
              "1SA.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti agateebhia abhantö bhaae iga, “Këra möntö aibhohe inchonge yaae!” Na këra möntö akaibhoha inchonge yaae; niyoora Tauti nawe wonsui akaibhoha inchonge yaae, akaimukia abhantö amagana anai (400) akaya nabho na abhandë amagana abhërë bhagatama bharariiha ichintoora.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono ömoona umui agateebhia Abhigairi ömökari wa Nabhari iga, “Ömanyërë, Tauti naatömërë abhantö kurua guiköngö bhaachërë gökeeria ömönene weitö; sibhoono abhang'oneeyë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.14",
            "verseOrgIds": [
              "1SA.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hano na abhaiya bhaarë harë bhaitö, tëbhatönahërë gösë götörekia gëntö kërë gionsui, guchinsikö chonsui chino toobhaayë guiköngö. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.15",
            "verseOrgIds": [
              "1SA.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaabhaayë urugito ubhutikö na ömöbhaso guchinsikö chonsui chino toobhaayë nabho törariiha amang'ondi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.16",
            "verseOrgIds": [
              "1SA.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono itegeerra kugira ëng'ana ëyö ëratöra körenterria ömönene weitö inyanko hamui na ëka yaae yonsui, nawe nö ömöbhëëbhë öno möntö atagambe nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhigairi, akaimukia bhöngöbhöngö ëmëgaate amagana (200), ibhiguchi bhibhërë bhi itibhaai, ichinyama ichisambë cha amang'ondi ataano, ichikiro ikumu na muhungatë cha ibhiakörea, ibhiminda igana rimui (100) bhi ichisabhibhu ichinyömö na ëmëgaate amagana abhërë (200) gia amakö, akariinia ibhintö bhiyö bhionsui guchitëkërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.18",
            "verseOrgIds": [
              "1SA.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agateebhia ömöhentani waae ööra iga, “Uwe tatangata ngucha ndë; sibhoono taateebhiri Nabhari mösaacha waae hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.19",
            "verseOrgIds": [
              "1SA.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akariina ëtëkërë akang'aaraara, nigo aisikuuyi inguku igo, gökëmachano, agasikana Tauti na abhantö bhaae bharaacha harë we. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.20",
            "verseOrgIds": [
              "1SA.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akaya araiteebhia iga, kana kura mbuchua nakariihirë ibhintö bhia Nabhari guiköngö gëntö keee gëkanga gusira; anhakaini amabhëëbhë kömaiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.21",
            "verseOrgIds": [
              "1SA.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiga Ënooköë anyite hano ndanyoore kuhika icho nkio niche nyoore honiri ninyoora ni intirruki köbhasaacha bha ëka yaae.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.22",
            "verseOrgIds": [
              "1SA.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhigairi aarööchë Tauti, naasekëëyë bhöngöbhöngö kura götëkërë, akaihiinya kuhika hansë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.23",
            "verseOrgIds": [
              "1SA.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agasigama na göteebhia Tauti iga, “Tiga amasaria gabhe igörö yö ömökoramërëmo wë ëgëkari waao umuene; ndakögeya wigue amang'ana gö ömökoramërëmo wë ëgëkari waao. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.24",
            "verseOrgIds": [
              "1SA.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatiga guitegeerra igörö yö ömöntö ömökangi ke Nabhari, kugira aatuubha iriina reee iga Nabhari, nko kögamba iga (Bhokangi) nawe aabha ömökangi; sibhoono uni ömökoramërëmo wë ëgëkari waao tënaarë ndööchë abhahentani bhano ömönene waane arë atömërë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.25",
            "verseOrgIds": [
              "1SA.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoono, mönene waane këbhörë ÖMÖNENE amenyërë na këbhörë ënkoro yaao ëmenyërë, gikugira ÖMÖNENE aguikëngëëyë wangërë köhöma hansë amanyinga gi irisaria na kuihakanëra igisiomba. Tiga abhabhisa bhaao na bhaara bhakögötönëra amabhëëbhë, bhahë ke Nabhari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.26",
            "verseOrgIds": [
              "1SA.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taimukia ibhituho bhino ömökoramërëmo waao aarenteeyë ömönene waae öhe abhahentani bhaao. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.27",
            "verseOrgIds": [
              "1SA.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndagösabha iga, waabhëre amasaria gumumbisi waao; kugira ÖMÖNENE naaraköhe ëka ëno ëgömërë gikugira ni iriihi reee uguitana; na tibhunyanku bhöratöke harë uwe kömaa bha ho gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.28",
            "verseOrgIds": [
              "1SA.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano nanyoora abhantö bharakörondia na gutuna gusikia amabhaho gaao, ÖMÖNENE abhoha amabhaho gaao hamui na bhaara bharëngë abhahoru kubhuriihi bhooe; na körekera amabhaho ga abhabhisa bhaao kehaara ömöntö akörekera irigëna na indrruuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.29",
            "verseOrgIds": [
              "1SA.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ÖMÖNENE arë gökoorra gököreng'aana na amaiya gaara gonsui aköragaraini, na kögötööra köbha ömögambi wa Isiraeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.30",
            "verseOrgIds": [
              "1SA.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwe mönene waane törëbha na kibhune ge kuihitukia gösë köbha na maachiichi ga köhoma hansë manyinga gano gataana kibhune, gösë kuihakanëra gisiomba. Na hano ÖMÖNENE aarë gökoorra amaiya gayö, uche köhëtöka ömökoramërëmo wë ëgëkari, mönene waane.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.31",
            "verseOrgIds": [
              "1SA.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti agatëëbhia Abhigairi iga, “ÖMÖNENE aitabhiribhöe, Ënooköë wa Isiraeri öno agötömërë gucha gunturung'ana! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.32",
            "verseOrgIds": [
              "1SA.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ögönge ÖMÖNENE köbhöng'aini bhooo bhöno bhönkaniri gökora irisaria re köhöma hansë amanyinga na kuihakanëra igisiomba! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.33",
            "verseOrgIds": [
              "1SA.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Öbhöheene këbhörë ÖMÖNENE, Ënooköë wa Isiraeri aamenyërë, nyoora ötangöhërë gucha gunturung'ana, gukuhika icho nkio tintirruki ëgachërë ëtame köbhasaacha bhë ëka ya Nabhari hai.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.34",
            "verseOrgIds": [
              "1SA.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Tauti akaimukia ibhintö bhiira wanyoorrë Abhigairi amörenteeyë; na kömöteebhia iga, “Taringa kuya moo na ömörembe, niguurë amang'ana gaao, na nëndahëkërani irisabhi reeo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhigairi aringërë, nkanyoora Nabhari akorre inyangi ënörrë ki iyö ömögambi. Nkanyoora Nabhari aigokiri bhökong'u kugira wanyoorrë aareehëröë bhökong'u; igo Abhigairi akanga kömöteebhia ng'ana ërë yonsui kuhika inkio. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.36",
            "verseOrgIds": [
              "1SA.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkio hano bhokëëyë Abhigairi akömaaha iga itibhaai isiirrë harë Nabhari, akamoorra amang'ana gonsui, Nabhari akagootoa na irihiku akabha ki irigëna. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.37",
            "verseOrgIds": [
              "1SA.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ichinsikö ikumi chahetërë, ÖMÖNENE naatëmërë Nabhari agakua. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Tauti aiguure iga, Nabhari akuure, naagambëre iga, “ÖMËNENE aitabhiribhöë öno ahakanëëyë öbhöbhëëbhë bhöno Nabhari aankoreeyë, abhechiri ömökoramërëmo waae kurua kömanyanku; na kuringiria Nabhari öbhöbhëëbhë bhooe umuene.” Sooki Tauti agatöma abhantö bhamögëëre öbhököë harë Abhigairi amötete. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua, abhakoramërëmo bha Tauti bhakaya Karimeri, bhagateebhia Abhigairi iga, “Tauti atötömërë iga tukuhire uyi köbha mökaae.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhigairi akaimöka akaihiinya kuhika hansë akagamba iga, “Uni nö ömökoramërëmo wë ëgëkari wa guisaabhia abhakoramërëmo bhö ömönene waane ndë.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.41",
            "verseOrgIds": [
              "1SA.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhigairi akanguhiirria akaimukia abhagöre bhë ëkëgaikörö bhaae bhataano akariina ëtëkërë bhakagenana na abhatömöa bhaara bha Tauti, akabha ömökari wa Tauti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua guiki Tauti akaimukia Ahinoamu Umuyesireeri bhakabha bhakaae bhonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.14+2SA.3.15+2SA.3.16"
              },
              "items": [
                {
                  "text": "2 Sam 3:14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nkanyoora Sauri aahaana umusubhaati waae Mikari, ömökari wa Tauti harë Bhariti ömoona o Raisi kurua kumugi go Ömögarimu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
            "verseOrgIds": [
              "1SA.25.44"
            ]
          }
        }
      ]
    }
