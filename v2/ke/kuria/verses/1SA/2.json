              "type": "text"
            }
          ]
        },
        {
          "text": "Hana agasabha guiki na kögamba iga:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
