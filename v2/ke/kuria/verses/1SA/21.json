                "loc": "PSA.56"
              },
              "items": [
                {
                  "text": "Sab 56",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akabhëëka amang'ana gayö kömooyo gooe, na agatanga koobhoha Akisi ömögambi wa Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34"
              },
              "items": [
                {
                  "text": "Sab 34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo, Tauti akahönchöra ësëëra yaae, na guikora kiu umuchuuru, akaya arang'oorang'oora amahita gu umugi, na örötai röramögereerra guchinka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Akisi agateebhia abhakoramërëmo bhaae iga, “Igankë mörentere ömöntö öno harë uni na hano mömanyërë iga nu umuchuuru? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gösë moigua iga mbachuuru ngutuna mörandetera umuchuuru araacha gökora amakabhë mbere yaane?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
              "1SA.21.15"
            ]
          }
        }
      ]
    }
