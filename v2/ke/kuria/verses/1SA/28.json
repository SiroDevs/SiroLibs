          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guchinsikö chiira, Abhabhirisiti mbairri amacheesi gaabho, iga bhayi guitania Abhaisiraeri. Akisi agateebhia Tauti iga, “Si, ömanye iga uwe hamui na abhantö bhaao ntöragenane guitana iriihi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauti akamöteebhia iga, “Igo mbuuya bhökong'u, mboono öramanye kërë ömökoramërëmo waao agakora.” Akisi nawe akamöteebhia iga, “Igo, mbuuya bhökong'u, nëndagökore umusirikare waane kömabhaho gaane gonsui.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauri arabhuuria umuchiirri",
          "type": "text"
        }
      ]
    },
