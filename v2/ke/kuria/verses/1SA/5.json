    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irisandëko ri Imuuma kö Abhabhirisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhabhirisiti bhaaronërë Irisandëko ri Imuuma yë Ënooköë rëëra mbarimukiri kurua Ebheneseri kuhika Asitoti; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Abhabhirisiti bhakaimukia irisandëko rëëra rë Ënooköë bhakarihira kunyumba ya Tagoni ënooköë waabho na körëtööra mbarëka ya Tagoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bha Asitoti bhaabhökërë inkio bhakamaaha, nkanyoora Tagoni iguërëëyë ubhusiö mbere yi Irisandëko ri Imuuma yö ÖMÖNENE. Bhakagëgorrokia na kugiringia ahasë haayö. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano bhabhöökërë inkio urusikö ro kabhërë bhakamaaha nkanyoora Tagoni iguërëëyë ubhusiö mbere yi Irisandëko ri Imuuma yö ÖMÖNENE, ömötöe, na amabhoko gaayo bhibhötökërë na kuirambaara guitëndo rië ëgësaku, götamërë ömöbhërë gooyo uguene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëyö niyo ikugira abhanchaama bha Tagoni hamui na abhantö bhonsui bhano bhagösoha kunyumba ya Tagoni gösengera bhanga götacha guitëndo re Tagoni kuhika reero ëno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ököbhoko kö ÖMÖNENE gökaritohera abhantö bha Asitoti, akabhabhörööta hamui na abhanyaröbheri bhaabho kömahutë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano abhantö bha Asitoti bhaaröchë bhörë amang'ana gabhabhereeye, bhakagamba iga, “Irisandëko ri Imuuma rë Ënooköë wa Isiraeri retagatama harë bhaitö hano guiki; kugira ököbhoko kooe kuritohërë harë bhaitö na harë ënooköë weitö Tagoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhagatöma abhantö kuya körarëka abhanene bhonsui bha Abhabhirisiti na köbhabhuuria iga, “Yekë törakore Irisandëko ri Imuuma rëno rë Ënooköë wa Isiraeri?” Bhakahunchukia iga, “Tainaria irisandëko rëyö rë Ënooköë wa Isiraeri kuya Gati.” Bhoono, bhakarihira kumugi go Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano reinaaribhui kuya Gati ököbhoko kö Ënooköë göökaihunchurria umugi, gökarentera irihahia irinene kumugi göyö, akabhörööta abhasaacha bhu umugi, abhagaaka na abhahentani gököbharentera amahutë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo mbe, bhakahira Irisandëko ri Imuuma Ekuroni. Sibhoono hano rehikirë ho, abhantö bha Ekuroni bhagakuura bharagamba iga, “Bhaarentërë Irisandëko ri Imuuma yë Ënooköë wa Isiraeri hang'i na bhaitö hano gucha gutuita hamui na abhantö bhaitö.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhagatöma abhantö kuya körarëka abhanene bha Abhabhirisiti na köbhateebhia iga, “Tariingia Irisandëko ri Imuuma ya Isiraeri, kuya ahasë hario, renge gutuita hamui na abhantö bhaitö.” Mbaakorre igo gikugira mbaagotëröë na irihahia irinene kumugi gonsui gikugira Ënooköë naarë köbhabhörööta bhörrö. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaara bhatakuurë nabho bhakaroora amahutë, kuhika ikuuratë yu umugi ëkahika kuriöbha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
