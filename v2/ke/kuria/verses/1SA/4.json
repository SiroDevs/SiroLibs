        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ököroonoa kui Irisandëko ri Imuuma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö, Abhabhirisiti bhakarichoka kuya guitana na Abhaisiraeri, Abhaisiraeri bhagatöörra irisanchö reebho Ebheneseri, na Abhabhirisiti bhagatöörra ëreebho Abheki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhabhirisiti bhagatema öröhari guisiira Isiraeri, hano iriihi reröörrë Abhaisiraeri mbaakërröë, na Abhabhirisiti mbaitërë abhantö ibhiköë mërongo ënai (40,000) kuiihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ichintirruki chaaringërë guisanchö, abhatangati bha Isiraeri bhakabhuuria iga, “Igankë ÖMÖNENE atigirë tuhichëröë na Abhabhirisiti reero? Tiga tuyi gösoora Irisandëko ri Imuuma yö ÖMÖNENE kurua Siro, korri hanga agaacha gataigatai yeitö na gututuuria kurua guchinguru cha abhabhisa bhaitö.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.22"
              },
              "items": [
                {
                  "text": "Ëgt 25:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Igo abhantö bhagatömöa kuya Siro, na körenta Irisandëko ri Imuuma yö ÖMÖNENE wa amacheesi öno aikaayë kubhiteemoa bhino bhiina amabhabha, abhamura bhaara bha Eri Hobhini na Bhinehasi bhagaacha na irisandëko rëëra rië ëndagano yë Ënooköë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Irisandëko ri Imuuma yö ÖMÖNENE rehikërë guisanchö, Abhaisiraeri bhonsui mbachërëëyë bhökong'u kömëgooko kuhika ëkëbhara gëkarigita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhabhirisiti bhaigure igituri këyö bhakagamba iga, “Igituri këyö kërëngë guisanchö ria Abhaebhurania në ëgekë?” Hakurua bhakamanya iga ni Irisandëko ri Imuuma yö ÖMÖNENE rërentëröë guisanchö, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhabhirisiti bhakoobhoha; kugira mbaagambërë iga, “ënooköë achërë guisanchö! Ëhöbhë yeitö! Kugira tëng'ana ke ëno yakarichokeeyë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.7",
            "verseOrgIds": [
              "1SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ëhöbhë yeitö! Ning'ui aratutuuri kurua gu ichinooköë chino chaitërë Abhamisiri kömatemo hagarëhagarë guiköngö? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.8",
            "verseOrgIds": [
              "1SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatërëmëka na gökarëha bharë Bhabhirisiti, mötabha abhagöre bha Abhaebhurania kehaara bhaabhayë harë bhainyu; takarëha gësaacha na guitana.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo Abhabhirisiti bhagaitania Abhaisiraeri bhakabhakëra, Abhaisiraeri bhakang'osa këra möntö kuya ka waae; ubhuiti bhökabha öbhönene urusikö röyö, kugira abhasirikare bha Abhaisiraeri bha amagörö ibhiköë mërongo ëtatö (30,000) mbaitëröë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irisandëko ri Imuuma yö Ënooköë rëkaimukibhua, na abhamura bha Eri bhabhërë Hobhini na Bhinehasi, bhagaitöa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruku ro Eri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö wöndë Ömöbhenchamini akang'ösa kurua köröhari rui iriihi urisikö röyö bheene, akahika Siro aana ichingëbho ichitanduku na urutu kömötöe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ahikërë, nkanyoora Eri naikaae kögitumbë keee, mbarëka yi irirongatë araganya; kugira naarë köganiria Irisandëko ri Imuuma yë Ënooköë. Hano ömöntö ööra asohërë kumugi na köbhaha amang'ana, umugi gonsui ngoohuuyi gukuura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Eri aigure igituri gi ikuuratë, akabhuuria iga, “Igituri këyö në ëgekë?” Hakurua ömöntö ööra akaya bhöngöbhöngö harë Eri na kömöha amang'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö nkanyoora Eri naana ëmeeka mërongo kënda na ënaanai na amaiso gaae gaahukura. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömöntö ööra agateebhia Eri iga, “Nu uni nduurë kuiihi bhoono igo; ng'osërë kurua kuiihi reero röno.” Eri akamubhuuria iga, “Niyekë amang'ana gabhaayë ho moona waane?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ömörenti wa amang'ana ööra akamöteebhia iga, “Abhaisiraeri bhang'osërë Abhabhirisiti, na abhantö abhaaru bhaitëröë; ninyoora na abhaana bhaao Hobhini na Bhinehasi, bhakuurë na Irisandëko ri Imuuma yë Ënooköë rihiirröë.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano aatarrë Irisandëko ri Imuuma yë Ënooköyë, Eri naagööye kurua kugitumbë keee agasögööta mbarëka yi irihita; akabhönëka ibhigoti na gukua, kugira nö ömöntömökörö arëngë na umuritö. Eri naabhaayë ömohökania wa Abhaisiraeri kömeeka mërongo ënai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uruku ru umusino wa Bhinehasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gönkaaga ëyö mökamoona o Eri, möka Bhinehasi nkanyoora nënda arë. Hano aiguurë iga Irisandëko ri Imuuma yë Ënooköë rihiirröë, na isabhiara waabho na mösaacha waae bhakuurë, naihinyirë akaibhöra kugira nagotëröë na ibhisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga arë gukua abhagaikörö bhaara bhaarë kumuibhuria bhakamöteebhia iga, “Wange koobhoha kugira wibhööyë ömoona wë ëgësaacha.” Sibhoono taahunchukiri gösë köbhategeerra hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaröka ömoona ööra iga, Ikabhoti, aragamba iga, “Ubhuhika bhöng'anyërë kurua Isiraeri.” Gikugira Irisandëko ri Imuuma yë Ënooköë rëronëröë na isabhiara waabho na mösaacha waae bhonsui bhakuurë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënooköë akagamba iga, “Ubhuhika bhuruure Isiraeri, kugira Irisandëko ri Imuuma rëronëröë.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.22",
            "verseOrgIds": [
              "1SA.4.22"
            ]
          }
        }
      ]
    }
  ],
