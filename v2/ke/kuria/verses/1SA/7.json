            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.5+1CH.13.6+1CH.13.7"
              },
              "items": [
                {
                  "text": "1 Ich 13:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abhantö bha Kiriati-yearimu bhagaacha bhakaimukia Irisandëko ri Imuuma yö ÖMÖNENE, bhakarihira kunyumba ya Abhinatabhu kunguku, bhagatööra harë Ënooköë ömoona waae öno arë köbhërëkëröa iga Ereasari, korri iga ariihe Irisandëko ri Imuuma yö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueri aragambëra Isiraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gukurua rono irisandëko ri Imuuma retangere komenya Kiriati-yearimu, ënkaaga tambe yaahetere, emeeka genga mëroongo ëbhërë igo, na Abhaisiraeri bhonsui bhagakoora ÖMÖNENE. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Samueri agateebhia Abhaisiraeri bhonsui iga, “Ndanyoorre mörarëngëra ÖMÖNENE nö ömooyo gueinyu gonsui, ruusia ichinooköë ichingeni na ibhihooru bhia Asitaroti kurua harë bhainyu. Möhaane imioyo gieinyu kö ÖMÖNENE na kömökoorra ëmërëmo we bheene, nawe narabhabhohori kurua guchinguru cha Abhabhirisiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Abhaisiraeri bhagatabhuta ibhihooru bhia Bhaari na Asitaroti na gökoorra Ënooköë umuene ëmërëmo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Samueri akagamba iga, “Abhaisiraeri bhonsui muirani Misibha, nsasaame ÖMÖNENE gikugira yeinyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, bhakairania Misibha, bhagataha amanchë na kögahöma mbere yö ÖMÖNENE, bhagaisasa urusikö röyö na kögamba iga, “Tookora iriraga mbere yö ÖMÖNENE.” (Samueri akabha ömohökania wa Abhaisiraeri Misibha haara). ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano Abhabhirisiti bhaigure iga Abhaisiraeri bhairaini Misibha, abhanene bhaabho bhakaya guiki kubhaisiira. Hano Abhaisiraeri bhaigurë igo, mboobhohërë Abhabhirisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhagateebhia Samueri iga, “Ötakahaatëra gököörra ÖMÖNENE, Ënooköë weitö gikugira yeitö, korri atutuuri kurua guchinguru cha Abhabhirisiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Sir 46:16-18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Köhayö, Samueri akaimukia ëkëmaano ki iring'ondi këno gëkögonka agakiruusia ikigima ikimuenso ke gösambërëërröa kö ÖMÖNENE na gököörra ÖMÖNENE wa Isiraeri, nawe akamuhunchukiria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Samueri, arë kuruusia ikimuenso ke gösambërëërröa, Abhabhirisiti bhakahika hang'i iga bhaitani Abhaisiraeri. Sibhoono ÖMÖNENE akaruusia ëngamba ënene gë ëkëbhagatiö bhagaichoganëröa na köng'osa mbere ya Abhaisiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaisiraeri bhonsui bhakarichoka kurua Misibha, bhakabharugia na guita Abhabhirisiti kuhika hang'i na umugi go Bheti-kari. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Samueri akaimukia irigëna akarimiirria gataigatai ya Misibha na Seni, akarëbhërëkëra iga, Ebheneseri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:12",
              "type": "text"
            },
            {
              "text": "Ebheneseri:",
              "type": "text"
            },
            {
              "text": "Irëgëna riu ubhutuurria",
              "type": "text"
            }
          ]
        },
        {
          "text": ", aragamba iga, “ÖMÖNENE atutuuriiyi kuhika bhoono.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhabhirisiti bhakahichöa, na tëbhakarëhërë gösohërra ënsë ya Isiraeri röndë guiki hai. Ököbhoko kö Ënooköë kögaisiira Abhabhirisiti kömabhaho ga Samueri gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na imigi gia Abhaisiraeri gionsui hamui nënsë ëno waanyöre Abhabhirisiti bhaimukia kurua Ekuroni kuhika Gati gëkabhohoribhöa. Ömörembe gökabha guiki gatai ya Abhaisiraeri na Abhaamori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akahökania Abhaisiraeri kömabhaho gaae gonsui. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këra mooka Samueri naakainaarrë na köhökania Abhaisiraeri kumigi ge Bheteri, Girigari, Misibha hamui na ichintahana chonsui cha Isiraeri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua naakaringirë gucha Rama, na kohökania ibhiina bhia Abhaisiraeri köbhöheene, kugira nëho waae yaarëngë. Guiki naahagachërë ho irikëngë riö ÖMÖNENE.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
