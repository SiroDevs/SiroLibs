          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Sauri akahatëra kurugia Abhabhirisiti, nabho bhakaringa waabho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
