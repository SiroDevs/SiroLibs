          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö röyö Abhaisiraeri bhagatema Abhabhirisiti gukurua Mikimasi kuhika Aiyaroni. Na abhantö mbaarosere bhakabhogeera bhökong'u gikugira yö ömöramböko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Abhantö bhagakënyëra ibhironoa, bhakaimukia amang'ondi, ichintang'ana na ibhimoori, bhagachisincha bhakarea ichinyama na amanyinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
