{
  "id": "1SA.14",
  "number": "14",
  "bookId": "1SA",
  "reference": "1 Samueri 14",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Öbhökarë bho Yonatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusikö rönde, Yonatani ömoona o Sauri agateebhia ömöhentani öno akamuimukiiyi ibhiögë iga, “Taacha, töröbhöke kuya köbhögöe bhui iricheesi ria Abhabhirisiti.” Sibhoono taateebhiri isawaabho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauri nkanyoora aatööra irisanchö hansë yö ömökomamanga Migironi, isikö yu umugi go Gibhea ana abhantö amagana asansabha (600). ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiya, ömoona wa Ahitubhu mura omoobho Ikabhoti ömoona wa Bhinehasi, ömoona wa Eri, umunchaama wö ÖMÖNENE kumugi go Siro nëwe wanyoorrë asuarrë ëkëmaao kiu umunchaama. Na abhantö tëbhaamanyërë iga Yonatani atanööyë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuiröbhöko rëëra yaarë iga Yonatani aröbhökërë araya guicheesi ria Abhabhirisiti, amarëngo abhërë amöögë ngaarëngë ho mbarëno na mbarëno. Irimui ndeerë köbhërëkëröa iga Bhosesi na ërëndë iga Sene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irirëngo irimui nderëëngë Mööchë yu umugi go Mikimasi na ërëndë sööchë bhitachërraini na umugi go Gibhea.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani agateebhia ömöhentani ööra aarë kumuimukiria ibhiögë iga, “Taacha, töröbhöke ihumbu guisanchö ria abhantö bhatasaarrë bhano. Handë ÖMÖNENE agatutuurria; kugira we taakörëbhëërröa gutuurria köhëtera köbhaaru gösë abhake.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuimukia bhiögë waae ööra agateebhia Yonatani iga, “Takora bhörë öhanchërë, kugira uni hamui ndë na iritegeerro reeo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Yonatani akamöteebhi iga, “Tötaröbhökëra abhantö bhaara korri bhatömaahe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano ndanyoore mbatöteebhia iga, Tatöganya tuuche harë bhainyu hayö, ntöraimëërre hano bheene na tëtörabhagëëre hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibhoono hano bharagambe iga, taröbhöka muuche harë bhaitö, ntöraayi gikugira ÖMÖNENE abhatöörrë kömabhoko gaitö na këno nkio këraabhe ëkëmanyiirrio harë bhaitö.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo bhonsui bhabhërë bhakaiyorokania abhiene guicheesi ria Abhabhirisiti; nabho bhakagamba iga, “Tamaaha, Abhaebhurania bharichokërë kurua kömaina gano wanyoora bhaibhisirë.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iricheesi ria Abhabhirisiti rëkabhërëkëra Yotani na muimukia bhiögë waae rëragamba iga, “Taacha harë bhaitö hano töbhooroki ëgëntö.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani agateebhia muimukia bhiögë waae iga, “Tandua nyuma; kugira ÖMÖNENE abhatöörrë kömabhoko ga Abhaisiraeri.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Yonatani akariina na amagörö na amabhoko nu muimukia bhiögë waae anyuma yaae. Yonatani agaitania Abhabhirisiti bhaara arabhaguisia hansë nu muimukia bhiögë akamurua nyuma arabhaita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuubhuiti bhöyö bho mbere, Yonatani na muimukia bhiögë waae mbaitërë hang'i abhantö mërongo ëbhërë ahasë hano haarëngë ichinköbhö ibhërë. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ënsë yonsui ya Abhabhirisiti ëkagotoa na öbhoobha, abhasirikare bhano bhaarëngë guisanchö, bhano bhaaringë guchimberi, bhano bhaarëngë köbhögöe na ninyoora na abhaitani mbaagankaini, ëkëbhara gëkarigita; bhonsui bhakabha na öbhoobha öbhönene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ögökëroa köa Abhabhirisiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhariihi bha Sauri bhano bhaarëngë Gibhea gönsë ya Bhenchamini bhakamaaha abhaaru bharahuunahuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurua Sauri agateebhia abhantö bhaara bhaarëngë hamui nawe iga, “Tabhara abhantö mömaahe öna aruurë harë bhaitö.” Hano bhasokiri köbhara bhakanyoora iga Yonatani nu muimukia bhiögë waae tëbhaaho hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauri agateebhia Ahiya iga, “Tarenta hano Irisandëko ri Imuuma yë Ënooköë.” (Kugira ënkaaga ëyö nkanyoora Irisandëko ri Imuuma nderëngë hamui na Abhaisiraeri.) ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaaga Sauri arë gusumacha na umunchaama, ëkörëërë ëkagendëërria kuiyengeria guisanchö ria Abhabhirisiti; Sauri agateebhia umunchaama iga, “Tiga, körenta irisandëko.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, Sauri na abhantö bhaara aarëngë nabho bhagaiseemia na kuya kuiihi, sibhoono Abhabhirisiti bhakaihönchörrana abhiene kubhiene, kuiguichoganëroa ökönene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhaebhurania bhano bhaarëngë hamui na Abhabhirisiti ëkëmbere, na bhano wanyoorrë bhagëëyë hamui nabho guisanchö, bhakabhaibhëëröka na kögootana na Abhaisiraeri bhano bhaarëngë hamui na Sauri na Yonatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhöyö bheene, Abhaisiraeri bhano wanyoorrë bhaigunyirë gönsë yi ichinguku cha Ebhuraimu, hano bhaiguurë iga Abhabhirisiti bhang'osërë, mbaabhahangërë na köbhatema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igo, ÖMÖNENE akaha Abhaisiraeri ögökëra urusikö röyö; na iriihi rëgaitana köhëtëëra Bheti-abheni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakora hano iriihi rehetërë",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhantö bha Isiraeri mbairiribhui kugira nkanyoora Sauri abhatuenerreeyi aragamba iga, “Aihimöe örë wonsui akörëa ibhiakörea kuhika ömögorobha na ntarahakana igisiomba köbhabhisa bhaane.” Igo, tëmöntö örë wonsui aamenërë bhiakörë hai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
