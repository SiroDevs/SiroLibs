      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîrauga atîrî, “Ka-ngerie kwigwîria kinya ku mbone.” Îndî kinya ku ndîroona nî kwa ûtheri. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîroona kinya ntheko nî cia waa, naku kwigwîria ndîraaga nî gwakî. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ntongeeretue nî ûûme bwaakwa, nî ndaacuîre kwigwîria na ndibei na ndîrageria mantû jangî jonthe jarîa muntû airîragîîria nîkenda menya nî ûntû bûrîkû muntû oomba kûthithia bûkamûgwîria matukûûne jamakai jarîa atûûraga gûkû nthîgûrû.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        },
        {
          "name": "verse",
