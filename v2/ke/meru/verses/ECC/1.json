            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji nî nteto cia Mûtûmîîria, ûrîa waathanaga arî Jerusalemu. We aarî mûtaana wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtûmîîria ariuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jarîa mûtûmîîria ooneete ûtûûroone bwaawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Mûtûmîîria, ntwîre Jerusalemu ndî mûnene wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani nî ndaaugîre ngaatumîra mathûgaanio jaakwa mwanka menye mantû jonthe jarîa jathithagua nthîgûrû îîjî. Ndîroona atî ngûgî irîa Mûrungu aeete muntû nî indito mono. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî ntegeete mantû jarîa jonthe jathithagua gûkû nthîgûrû ndoona atî jonthe nî ja ûtheri, na nî ta kwîngana na ruuo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
