              "items": [
                {
                  "text": "1Ane 4.29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naani ndîraciîra atîrî, “Nî ngîîte ûûme bûbwingî, bûkûrûkîte bwa anene bonthe barîa baathana Jerusalemu mbere yaakwa. Nî nthirîtie kûmenya mantû jamanene jegiî ûûme na ûmenyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî ndeendere kûmenya mantû jegiî ûûme na nthû na waa. Ndîroona kinya kûthithia ûu nî ta kwîngana na ruuo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    }
