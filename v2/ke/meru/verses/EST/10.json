      "items": [
        {
          "text": "Mûnene Aritashashita na Modekai kûgîa nkuma înene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Aritashashita aaugîîte antû bonthe ba nthîgûrû îrîa aathaga, kinya irîa ciaacîgîîrîîtue nî irîa aathaga iritage ûgoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû jonthe jarîa mûnene Aritashashita aathithîrie na ûrîa aaere Modekai gîtîîo gîkînene, nî jaandîki Yukuune rîa ngono cia Anene ba Parasia na Media. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekai ûu Mûyahudi, nîwe waarî mûnini wa mûnene Aritashashita. Nawe nî aaei gîtîîo na kwendwa mono nî Ayahudi bangî. Modekai nî aacwagîra antû baao ba Ayahudi thîîrî na ûthinyaari.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
