                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maandîko jariuga, “Muntû kinya ûrîkû akenda gwikumia, nî aikumîrie ûrîa Mwathani athithîtie.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû muntû ûrîa wîtîkagîrwa tî muntû ûrîa witaraga wengwa arî ûmwega îndî nî muntû ûrîa Mwathani eekagîîra.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
