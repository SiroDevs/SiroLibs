          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kîoneki kiegiî ngaarî inya cia mbarathi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî ndaaciûkîrie meetho o kaîrî ndîroona ngaarî inya cia mbarathi ciaumîîra gatîgatî ka irîma biîrî bia îturutia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.1",
            "verseOrgIds": [
              "ZEC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.4"
              },
              "items": [
                {
                  "text": "Kûg 6.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngaarî ya mbere yaakururîtue nî mbarathi întuune, na ngaarî ya ijîîrî yaakururîtue nî mbarathi înjirû. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.2",
            "verseOrgIds": [
              "ZEC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.2"
              },
              "items": [
                {
                  "text": "Kûg 6.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngarî ya ithatû yaakururîtue nî mbarathi înjerû na ngaarî ya inya yaakururîtue nî mbarathi îrî na maara. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.3",
            "verseOrgIds": [
              "ZEC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîrooria mûraîka ûu waambaragîria atîrî, “Mwathi waakwa, nîmbi gîtûmi kîa ngaarî îîjî?” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.1"
              },
              "items": [
                {
                  "text": "Kûg 7.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe mûraîka arancokeria arambîîra atîrî, “Iji nî Roho inya cia îgûrû irîa ciumîte kîrî MWATHANI wa nthîgûrû yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngarî îrîa yaakururîtue nî mbarathi injirû yeetîte bwa ûrîo bwa Babiloni, nayo îrîa yaakururîtue nî mbarathi injerû yeetîte bwa rûgûrû, na îrîa yaakururîtue nî mbarathi irî na maara yeetîte bwa ûmotho.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.6",
            "verseOrgIds": [
              "ZEC.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mbarathi ciaumîîre nî ciaarî na mpwîî cia gwîta gûcûnkûûna nthî. Mûraîka nawe araciîra atîrî, “Îteeni bûcûnkûûne nthî.” Tontû bûû, mbarathi iu ireeta gûcûnkûûna nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.7",
            "verseOrgIds": [
              "ZEC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe mûraîka arambîîra atîrî, “Mbarathi irîa ciîtîte bwa ûrîo Babiloni igûtûma mûthûûro jwa MWATHANI jûnyiia.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.8",
            "verseOrgIds": [
              "ZEC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MWATHANI kuuga Joshua eekîrwe thirû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.8",
            "verseOrgIds": [
              "ZEC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aambarîîrîrie arambîîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.9",
            "verseOrgIds": [
              "ZEC.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jûkia thaabu na fetha kuuma kîrî atae barîa bacokeete kuuma kîthamîrioone, tabo Helidai, na Tobija, na Jedaia; wîîte o ntukû îîu yongwa nabio nyomba ya Josia mûtaana wa Zefania. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.10",
            "verseOrgIds": [
              "ZEC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weeta ûthithie thirû na thaabu na fetha iu, naagwe wîkîre mûthînjîri-Mûrungu ûrîa mûnene tawe Joshua mûtaana wa Jehozadaki mûtwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.11",
            "verseOrgIds": [
              "ZEC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Jer 23.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.15"
              },
              "items": [
                {
                  "text": "33.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.8"
              },
              "items": [
                {
                  "text": "Zek 3.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî ûmwîre MWATHANI Mweneinya arîkwîra atîrî, ‘Muntû ûrîa wîtagwa Rwang'i akaathinyaarîra arîa akaraga na agaaka kîûrû kîa MWATHANI kaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.12",
            "verseOrgIds": [
              "ZEC.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîwe ûgaaka kîûrû kîu kîa MWATHANI, na akaeewa gîtîîo kîrîa kîeejagwa mûnene, nawe agatua kwathaga antû baawe. Ningî gûkeethîrwa kûrî na mûthînjîri-Mûrungu ûkaigîkaga waathani bwaawe, nabo bobaîrî bagaakaraga na ngwatanîro.’” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.13",
            "verseOrgIds": [
              "ZEC.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo thirû îgakaraga kîûrûûne kîa MWATHANI îrî kîririkano nîûntû bwa gîtîîo kîa Helidai, na Tobija na Jedaia, na Josia mûtaana wa Zefania.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nabo antû barîa batwîre kûraaja bakeeja bakûgwatie gwaka kîûrû. Rîu nîrîo bûkaamenya nî MWATHANI Mweneinya ûntûmîte. Ûntû bûu bûgaakarîka akî bunka bwathîkîra kajû ka MWATHANI Mûrungu weenu.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
  ],
