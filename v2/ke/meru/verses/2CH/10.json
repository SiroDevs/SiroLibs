          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Rehoboamu nî aatûmîre Hadoramu ûrîa waarî mûrûngamîîri wa antû barîa baaritithagua ngûgî na inya, îndî antû ba Israeli baramûûra na maiga arakua. Mûnene Rehoboamu aroomba kwithara arathuuta ngaarî yaawe ya ndwaa aracoka Jerusalemu na rwîro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, antû ba Israeli baatwîre baregeete waathani bwa mûciî jwa Daudi mwanka naarua.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
