            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa antû ba Israeli bonthe boonîre atî mûnene akûrega kûbathikîîra baramûcokeria barauga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
