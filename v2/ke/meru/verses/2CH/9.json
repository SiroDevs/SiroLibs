                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Kîam 15.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.21"
              },
              "items": [
                {
                  "text": "1Ane 4.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Solomoni araa mûnene wakwathaga anene barîa bangî bonthe kuuma rûûjî rwa Eufurate mwanka nthîgûrû ya Filisti, na mwankeene jwa Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiiteene rîa waathani bwaawe fetha yaingîîte Jerusalemu ja maiga. Mîtarakwa yaingîi ja matî. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
