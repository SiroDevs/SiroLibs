          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mathithio jangî ja Solomoni nî jaandîki Rûgonoone rwa kîroria Nathani, na Ûrorieene bwa Ahija ûrîa wa kuuma Shilo, na bionekiine bwa Ido ûrîa kîroria, bûrîa bwaarîîtie kinya mantû ja waathani bwa Jeroboamu, mûnene wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni aathanîre nthî ya Israeli yonthe arî Jerusalemu îgiita rîa mîaka mîrongo îna (40). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arakua, arathikwa Ntûûra ya Daudi, na mûtaana waawe, Rehoboamu araa mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
