            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Solomoni arauga ûjû, “MWATHANI augîîte arîenda gûtûûraga îtuune rîrîtumanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî ngûgwaakîra kîûrû gîkînene na gîkîega, kûrîa gwe ûgatûûraga kenya na kenya.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
