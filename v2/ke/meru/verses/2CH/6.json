              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrîndî gîa Israeli kîonthe kîrûngi au, Solomoni arakîerekera, arakîtharima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
