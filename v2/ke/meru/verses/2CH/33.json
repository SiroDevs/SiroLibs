          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Amoni atainyiiyia mbere ya MWATHANI ta ûrîa îthe aathithîrie. Meeyia jaawe nîka jeetîre na mbere kwongeereka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
