              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni aarî na ûkûrû bwa mîaka mîrongo îîrî na îîrî rîrîa aeere mûnene. Nawe aathanîre mîaka îîrî arî Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
