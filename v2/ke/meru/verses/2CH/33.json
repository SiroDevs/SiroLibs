              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni nî akunyanîîrwe nî nthûûmba ciaawe na iramûûragîra nyomba yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
