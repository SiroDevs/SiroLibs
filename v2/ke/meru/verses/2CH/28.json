          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aakîre irombero bia kûritagîra mîrungu ya mîng'uanano igongwana bia ubaani ntûûreene cionthe cia Juda. Ûntû bûû bûrathûûria MWATHANI, Mûrungu wa biûjûjû biaao mono.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
