              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nî aarî na ûtonga bûbûnene mono na îgweta rîrînene. Nî aaciîkîrîte thaabu na fetha na maiga ja goro, na macoco na rong'o na into bionthe bia bata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.27",
            "verseOrgIds": [
              "2CH.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aarî na kinya nchuku cia gwîkaga irio na ndibei îrîa njerû na maguta. Ningî nî aakîte nkanata cia ng'ombe mwanya mwanya na cia mbûri na cia ng'ondu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.28",
            "verseOrgIds": [
              "2CH.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aarî na ntûûra inyiingî amwe na ndîîthia iu cia mbûri na ng'ondu na ng'ombe nîûntû Mûrungu nî aamweete ûtonga bûbwingî mono.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.29",
            "verseOrgIds": [
              "2CH.32.29"
            ]
          }
        }
      ]
    },
