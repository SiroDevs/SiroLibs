            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni aracoka areeta Ezioni-geberi na Elothi, ntûûra irîa ciaarî rûteere rwa îria rwa nthî ya Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Hiramu aramûtûmîra meri ciîtithîtue nî antû bamwe baawe barîa baijî mantû ja îria. Nabo bareetania na Solomoni mwanka Ofiri, na baracoka na thaabu ya kilo ngiri îkûmi na ithaano (15,000), baranenkera mûnene Solomoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
