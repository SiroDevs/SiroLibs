          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Solomoni araritîra MWATHANI igongwana kîritîroone kîa igongwana kîrîa aakîte mbere ya kîûrû ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
