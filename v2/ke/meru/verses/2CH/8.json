        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni nî aathamîrie mwarî wa Farao kuuma Ntûûra ya Daudi aramwikia nyomba îrîa aamwakîrîte arauga, “Mwekûrû waakwa atîkara mwîrîgeene jwa Daudi, mûnene wa Israeli, nîûntû antû barîa bathirîtie kûriûngîrwa nî Îthandûkû rîa kîrîkanîro nî babatheru.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
