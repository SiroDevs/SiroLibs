        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu Solomoni arîîkîrie ngûgî yaawe yonthe, kuuma ntukû îrîa mûsingi jwa kîûrû kîa MWATHANI jwaambîrwe mwanka rîrîa kîûrû kîojûrîre. Nakîo kîûrû kîa MWATHANI kîroojûra.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
