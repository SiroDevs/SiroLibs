          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkányunyaga rûûjî akî îndî kuundaga ndibei îînkai ya gûteethia kîu nîûntû nî gîkwaajagia îgiita na îgiita.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeyia ja antû bamwe nî jonekaga weerûûne na jagatûma bagambithua îndî meeyia ja antû bangî jaumbûkaga nyumeene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.24",
            "verseOrgIds": [
              "1TI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
