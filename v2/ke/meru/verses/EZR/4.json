            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî waathaniine bwa Aritashashita, Bishilamu na Mithiredathi na Tabeeli na antû bangî ba mûûrû jwaao nî baandîkîîre Aritashashita mûnene wa Parasia barûga. Barûga îîu yaandîki na rûthiomi rwa Kîaramu, nayo îkagarûrwa rîrîa îkûthomwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu, ûrîa mûtongeeria na Shimushai, ûrîa mwandîki, nî baandîkîîre mûnene Aritashashita barûga ya kûthûûkia Jerusalemu bakiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
    },
