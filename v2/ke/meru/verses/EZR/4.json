          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa barûga ya mûnene Aritashashita yaathomeerwe Rehumu, na Shimushai ûrîa mwaandîki na antû ba mûûrû jwaao, nî bookîrîîre na mpwîî bareeta kîrî Ayahudi kûu Jerusalemu baratumîra inya barabagiria gwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
