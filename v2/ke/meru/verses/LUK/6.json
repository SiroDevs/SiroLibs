              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.36",
            "verseOrgIds": [
              "LUK.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bûgátujagîra antû bangî, na Mûrungu atîbûgambithia; bûkámena bangî bûtîkeeje kûgambithua nî Mûrungu. Rekagîreeni bangî naabuî bûkarekerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.37",
            "verseOrgIds": [
              "LUK.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eejanageni, na kinya buî bûkaejagwa nî Mûrungu. Bûkaewa bibingî, bikinyîîri, na bikaunîkara. Nîkwîthîrwa kîthimi kîrîa bûkathimagîra bangî nakîo, nîkîo Mûrungu akabûthimagîra nakîo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        }
      ]
    },
