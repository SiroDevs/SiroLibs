              },
              "items": [
                {
                  "text": "Jer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " akîberaga, “Nî kwaandîki ‘Nyomba yaakwa îkaa nyomba ya kûrombagîra,’ îndî buî nî bûmîethetie gîkurungu kîa atûnyani.”",
          "type": "text",
          "attrs": {
