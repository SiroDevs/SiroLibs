          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "îndî baraaga ûrîa barîngîthithia nîûntû antû bonthe nî baamûthikîîrîte bwega bakîenda kwigua jonthe jarîa augaga.",
          "type": "text",
