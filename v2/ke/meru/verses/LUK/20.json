              "LUK.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabooria, “Nîkî antû baugaga atî Kristû nî mûtaana wa Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi wengwa nî augîîte Yukuune rîa Zaburi atî:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.43",
            "verseOrgIds": [
              "LUK.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Këethîra Daudi aamwîtîre ‘Mwathani’ rî, nîatîa oomba kwîthîrwa arî mûtaana waawe?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kwîra antû baimenyeere aritani ba Waatho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nî eerîre aritwa baawe, antû bonthe bakiigagua, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imenyereeni aritani ba Waatho. Beetaga beekîrîte ndwambambio indaaja na beendaga gûkeethagua barî thokoone. Ningî beendaga gûkarîra itî birîa biega buru iromberoone na kweejagwa gîtîîo biathoone. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaîîragia ntigwa na bagacituunya into biaao na bakaromba maromba jamaraaja nîkenda boonwa nî antû. Bagaakanûkua nkûrûki ya antû bangî bonthe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
      ]
    }
