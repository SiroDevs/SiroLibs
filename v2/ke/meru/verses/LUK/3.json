                "loc": "MAT.12.34"
              },
              "items": [
                {
                  "text": "Mat 12.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.3"
              },
              "items": [
                {
                  "text": "23.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Antû babaingî nî beetîre kîrî Johana bakîendaga ababatithia na arabeera, “Îbuî rûciara rwa njoka! Nûû ûbwîrîte bûmatuke îkanûkia rîrîa rîîjîte? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.33"
              },
              "items": [
                {
                  "text": "Joh 8.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onanieni na mathithio jeenu atî nî bwirirîte buru. Bûkambîrîrieni gûciîra, ‘Tuî tûrî nchiarwa cia Abrahamu.’ Nîkwîthîrwa ndîbwîra na mma atî Mûrungu oomba kweethia maiga jaja nchiarwa cia Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.19"
              },
              "items": [
                {
                  "text": "Mat 7.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî nandî choka nî yûkîrîtue îrîka mîtî kuuma mîriine. O mûtî jûrîa jûtîciara maciara jameega jûgatemwa jûgerwe mwankiine.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bau baramûûria, “Tûkathithia atîa îndî?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arabacokeria, “Ûrîa ûrî na nguû ijîîrî nî agaîre ûrîa ûtî nayo, na ûrîa ûrî na biakûrîa nî arûmie ûrîa ûtî nabio.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29"
              },
              "items": [
                {
                  "text": "Luk 7.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kinya aritithia ûgoti nî beetîre kûbatithua na baramûûria, “Mûritani, tuî tûkathithia atîa?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arabacokeria, “Bûgéetia ûgoti bûbwingî nkûrûki ya ûrîa bûtuîri.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya asikarî baramûûria, “A tuî tûkathithia atîa?” Nawe arabeera, “Bûgátuunya muntû kinya ûrîkû gîntû kîaawe kana bûandîîra muntû mantû jatîo. Ningî ng'anagîrweni nî mûchaara jweenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû barambîrîria kûgîa na wîrîgîîro bûbwingî na barathûgaania atî Johana oomba kwîthîrwa nîwe Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johana areera antû bonthe atîrî, “Ndîbûbatithia na rûûjî, îndî ûrîa wîjîte, arî na inya nkûrûki yaakwa. Ni ntîagîrîte gûkundûra mîrigi ya îratû biaawe. Ûû nîwe ûkabûbatithia na Roho Ûmûtheru na mwanki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî agwete gîtaarû kîaawe nîkenda eera nkano irîa irî îtîriine rîaawe. Ageeka nkano nchukuune yaawe, îndî agaakîîria maûngo na mwanki jûrîa jûtîûmba kwoora.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
