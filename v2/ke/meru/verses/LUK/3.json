          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa antû bonthe baathirîrie kûbatithua, Jesû kinya we nî aabatithîrue. Akîrombaga, îgûrû rîrarugûka, ",
          "type": "text",
          "attrs": {
