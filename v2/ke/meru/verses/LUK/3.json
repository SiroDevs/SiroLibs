                  "text": "Luk 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na Roho Ûmûtheru akari ta kîjea areenama kîrî we. Kajû karaigîîgua kuuma îgûrû gakiugaga, “Gwe nîgwe Mûtaana waakwa ûrîa mpendeete. Nîngwîragua mono nîgwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rûrîîjo rwa Jesû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû aambîrîrie gûtûmîîria aarî na ûkûrû bwa mîaka mîrongo îthatû. Antû baathûgaanagia atî aarî mûtaana wa Josefu ûrîa waarî mûtaana wa Heli. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heli aarî mûtaana wa Mathati, na Mathati aarî mûtaana wa Lawi, na Lawi aarî mûtaana wa Meliki, na Meliki aarî mûtaana wa Janai, na Janai aarî mûtaana wa Josefu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu aarî mûtaana wa Matathia, na Matathia aarî mûtaana wa Amosi, na Amosi aarî mûtaana wa Nahumu, na Nahumu aarî mûtaana wa Esili, na Esili aarî mûtaana wa Nagai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.25",
            "verseOrgIds": [
              "LUK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagai aarî mûtaana wa Maathi, na Maathi aarî mûtaana wa Matathia, na Matathia aarî mûtaana wa Semeini, na Semeini aarî mûtaana wa Joseki, na Joseki aarî mûtaana wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda aarî mûtaana wa Joanani, na Joanani aarî mûtaana wa Resa, na Resa aarî mûtaana wa Zerubabeli, na Zerubabeli aarî mûtaana wa Shealitieli na Shealitieli aarî mûtaana wa Neri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.27",
            "verseOrgIds": [
              "LUK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri aarî mûtaana wa Meliki, na Meliki aarî mûtaana wa Adi, na Adi aarî mûtaana wa Kosamu, na Kosamu aarî mûtaana wa Elimadamu, na Elimadamu aarî mûtaana wa Eri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.28",
            "verseOrgIds": [
              "LUK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri aarî mûtaana wa Joshua, na Joshua aarî mûtaana wa Eliezeri, na Eliezeri aarî mûtaana wa Jorimu, na Jorimu aarî mûtaana wa Mathati, na Mathati aarî mûtaana wa Lawi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.29",
            "verseOrgIds": [
              "LUK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawi aarî mûtaana wa Simioni, na Simioni aarî mûtaana wa Juda, na Juda aarî mûtaana wa Josefu, na Josefu aarî mûtaana wa Jonamu, na Jonamu aarî mûtaana wa Eliakimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.30",
            "verseOrgIds": [
              "LUK.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliakimu aarî mûtaana wa Melea, na Melea aarî mûtaana wa Mena, na Mena aarî mûtaana wa Matatha, na Matatha aarî mûtaana wa Nathani, na Nathani aarî mûtaana wa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aarî mûtaana wa Jesii, na Jesii aarî mûtaana wa Obedi, na Obedi aarî mûtaana wa Boazi, na Boazi aarî mûtaana wa Salimoni, na Salimoni aarî mûtaana wa Nahashoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.32",
            "verseOrgIds": [
              "LUK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahashoni aarî mûtaana wa Aminadabu, na Aminadabu aarî mûtaana wa Adimini, na Adimini aarî mûtaana wa Arini, na Arini aarî mûtaana wa Hezironi, na Hezironi aarî mûtaana wa Perezi, na Perezi aarî mûtaana wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.33",
            "verseOrgIds": [
              "LUK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda aarî mûtaana wa Jakubu, na Jakubu aarî mûtaana wa Isaaka, na Isaaka aarî mûtaana wa Abrahamu, na Abrahamu aarî mûtaana wa Tera, na Tera aarî mûtaana wa Nahori. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
              "LUK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahori aarî mûtaana wa Serugi, na Serugi aarî mûtaana wa Reu, na Reu aarî mûtaana wa Pelegi, na Pelegi aarî mûtaana wa Eberi, na Eberi aarî mûtaana wa Shela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.35",
            "verseOrgIds": [
              "LUK.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shela aarî mûtaana wa Kainani, na Kainani aarî mûtaana wa Arifakisadi, na Arifakisadi aarî mûtaana wa Shemu, na Shemu aarî mûtaana wa Noa, na Noa aarî mûtaana wa Lameki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.36",
            "verseOrgIds": [
              "LUK.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameki aarî mûtaana wa Methusela, na Methusela aarî mûtaana wa Enoki, na Enoki aarî mûtaana wa Jaredi, na Jaredi aarî mûtaana wa Mahalaleli, na Mahalaleli aarî mûtaana wa Kainani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.37",
            "verseOrgIds": [
              "LUK.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainani aarî mûtaana wa Enoshi, na Enoshi aarî mûtaana wa Sethi, na Sethi aarî mûtaana wa Adamu. Adamu ûrîa waarî mûtaana wa Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.38",
            "verseOrgIds": [
              "LUK.3.38"
            ]
          }
        }
      ]
    }
