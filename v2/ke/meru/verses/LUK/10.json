              },
              "items": [
                {
                  "text": "Joh 13.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû areera aritwa baawe atîrî, “Muntû wonthe ûrîa ûkabûthikîîra, nî ni akûthikîîra. Ningî muntû ûrîa ûkabûrega nî ni akûrega, na ûrîa ûkandega, nî ûrîa waantûmîre akûrega.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aritwa barîa mîrongo mûgwanja na baîrî gûcoka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
