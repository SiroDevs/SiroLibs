              },
              "items": [
                {
                  "text": "10.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nî nenkeri into bionthe nî Baaba. Gûtî we wiijî Mûtaana nûû tiga Îthe, na gûtî we wiijî Îthe nûû tiga Mûtaana na barîa mûtaana amenyithagia Îthe nûû.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        }
      ]
