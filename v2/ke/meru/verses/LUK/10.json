          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritwa barîa mîrongo mûgwanja na baîrî nî baacokere bagwîrîtue mono bakiugaga, “Mwathani, kinya roho inthûûku nî iratwathîkîîre rîrîa tûraciîngîre tûgîtumagîra riîtwa rîaaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
