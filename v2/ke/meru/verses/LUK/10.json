                  "text": "Zek 9.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Wûûi kîrî gwe Korazini! Wûûi kîrî gwe Bethisaida! Këethîra biama birîa biaringîrwe kîrî buî nî biaringîrwe Tiro na Sidoni, antû bau barîngî kwîthîrwa bairirîre tene, bekîrîte mathango na baciakîte mûju. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî ntukû ya îgamba yakinya Mûrungu akaigîrua ntûûra ya Tiro na Sidoni kîaao nkûrûki ya baabuî. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naagwe Kaperinaumu ka ûgûciimbaimbia ûkîthûgaanagia ûgakumua mwanka îgûrû? Ûkageerwa mwankiine jwa kenya na kenya.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
