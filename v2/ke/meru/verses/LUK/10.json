        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu araraithîria aritwa baawe na arabeera barî bonka, “Buî nî bûtharimi nîûntû bwa kwona mantû jarîa bûkwona! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî mma iroria na anene babaingî nî beendeete kwona mantû jarîa bûkwona, îndî bataajonere, na nî beendeete kwigua mantû jarîa bûkwigua, îndî batajaigîrue.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya Mûsamaria ûmwega",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
