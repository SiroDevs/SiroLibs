              "items": [
                {
                  "text": "Mar 10.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nî mma kûrî bamwe barî mûthia, bakaa ba mbere na kûrî bamwe barî mbere, bakaa ba mûthia.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
