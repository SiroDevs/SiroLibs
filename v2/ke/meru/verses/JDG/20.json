            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.46",
            "verseOrgIds": [
              "JDG.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî asikarî magana jatantatû (600) nî boombîre kûmatûka bûûrîîne mwanka Iigeene rîa Rimoni. Barakara ku mîeri îna. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.47",
            "verseOrgIds": [
              "JDG.20.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 20:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo asikarî ba mîîrîga îîu îngî ya Aisraeli baragarûkîra antû bau bangî ba mwîrîga jwa Benjamini barabooraga bonthe; arûme, aka, na twaana, na kinya ndîîthia ciaao. Ningî baraîîthia ntûûra ciaao cionthe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.48",
            "verseOrgIds": [
              "JDG.20.48"
            ]
          }
        }
      ]
    }
