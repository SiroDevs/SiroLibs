              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa antû ba Aisraeli barîa baarî amwe nawe boonere atî Abimeleki agûkua, baraana o muntû nja yaawe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
