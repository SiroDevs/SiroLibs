              "JDG.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefitha aatongeererie Israeli mîaka îtaantatû. Nawe arakua, na arathikwa ntûûreene yaao kûu Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibizani, Eloni na Abidoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya Jefitha gûkua, Ibizani, wa kuuma ntûûreene ya Bethlehemu, nîwe waaere mûtongeeria wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibizani nî aarî na ataana mîrongo îthatû, na aarî mîrongo îthatû. Nî eenderie aarî baawe mîîrîgeene îngî, na aragûranîîra ataana baawe kuuma mîîrîgeene îngî. Ibizani aatongeererie Israeli mîaka mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
            "verseOrgIds": [
              "JDG.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arakua, na arathikwa ntûûreene ya Bethlehemu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
