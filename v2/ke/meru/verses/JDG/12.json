          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya Ibizani gûkua, Eloni, wa kuuma mwîrîgeene jwa Zebuloni, nîwe waaere mûtongeeria wa Israeli. Eloni aatongeererie Israeli mîaka îkûmi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
            "verseOrgIds": [
              "JDG.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arakua na arathikwa ntûûreene ya Aijaloni, kûu Zebuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya Eloni gûkua, Abidoni, mûtaana wa Hileli, wa kuuma ntûûreene ya Pirathoni, nîwe waaere mûtongeeria wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
            "verseOrgIds": [
              "JDG.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidoni aarî na ataana mîrongo îna na aana ba ataana baawe mîrongo îthatû. Nabo baakamatagwa nî ntigiri mîrongo mûgwanja. Abidoni aatongeererie Israeli mîaka înaana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arakua, na arathikwa ntûûreene ya Pirathoni, kûu mwîrîgeene jwa Efuraimu, nthîgûrû ya irîma ya Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
              "JDG.12.15"
            ]
          }
        }
      ]
