          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni tawe Jerubaali, mûtaana wa Joashi nî aanîre areeta gûtûûra nja yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
              "JDG.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni nî aarî na ataana mîrongo mûgwanja (70) nîûntû nî aarî na aka babaingî. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
              "JDG.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûka wa gwîka waawe ûrîa watûûraga Shekemu nî aamûciarîre kaîjî, na Gideoni arageeta Abimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        }
      ]
