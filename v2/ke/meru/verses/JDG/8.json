          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu antû ba Midiani boombîrwe ndweene nî antû ba Israeli na îtaacoka kûreteera Israeli thîîna kaîrî. Nthîgûrû îrakara na thîîrî mîaka mîrongo îna (40), rîrîa rîonthe Gideoni atûûrîre mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gîkuû kîa Gideoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
