        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ataana ba ng'ina na ndûgû ciaao bareeta barajûkia mwîrî jwaawe bareeta barajûthika gatîgatî ga ntûûra ya Zora na ntûûra ya Eshitaoli mbîrîreene ya îthe Manoa. Samusoni atongeererie Israeli mîaka mîrongo îîrî.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
