          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya mîeri îîrî, mwarî ûu nî aacokere kîrî îthe, nawe arathithia o ûrîa aciîtîrîtie MWATHANI. Mwarî arakua atîgûri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        }
      ]
    },
