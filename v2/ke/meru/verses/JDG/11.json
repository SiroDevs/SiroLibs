          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîu nîkîo gîtûmi ndeene ya Israeli aarî beetaga ntûkû inya o kîrî mwaka baarîraga kûririkana mwarî ûu wa Jefitha ûrîa Mûgileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.40",
            "verseOrgIds": [
              "JDG.11.40"
            ]
          }
