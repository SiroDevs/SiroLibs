              },
              "items": [
                {
                  "text": "2Ane 14.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntukû îmwe MWATHANI nî aarîîrie Jona mûtaana wa Amitai aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ithuranîre wîte Nineve ntûûra îrîa nene, ûgatûmîîrie antû baayo mantû jegiî ûthûûku bwaao bûrîa bûnkinyîrîte.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jona arookîîra areeta Tarishishi nîkenda amatûka MWATHANI. Nawe areenama areeta Jopa na areethîra meri yaarî akuî gwîta Tarishishi. Tontû bûû, ararîa mbeecha cia rûgendo, arakûrûka ku nîkenda eetania na eetithia ba meri îîu Tarishishi amatûka MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI arareeta ruuo rûrûnene na kûragîa na kiurutani gîkînene mono mwanka meri îreethîrwa îrî ûgwatiine bwa kuunîkanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu eetithia ba meri îîu baragîa ûguaa na o muntû arakaîra mûrungu jwaawe. Baragera mîrigo yaao îrieene nîkenda meri îîu îûtha. Îndî Jona nî aarî akwînama meeriine bwa ndeene buru, na aamama na aagwatwa nî toro înene.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe mûtongeeria wa meri areeta kîrî we aramûûria, “Ka ûmami? Ûkîîra ûkaîre mûrungu jwaaku! Kwoombîka jûgatwigîîrua kîaao tûkarega kûthira.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo eetithia ba meri bareerana, “Njûûni, tuune mîtî nîkenda tûmenya nûû ûtûmîte ûthûûku bûbû bûtwîjîîra.” Barauna mîtî, na mûtî jûragwîîra Jona. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu baramwîra atîrî, “Twîre gwe, nûû ûtûmîte ûthûûku bûbû bûtwîjîîra? Nî ngûgî îrîkû ûritaga? Nîkû uumîte? Nthîgûrû yeenu nî îrîkû? Antû beenu bo rî, nî barîkû?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Jona arabacokeria atîrî, “Ndî Mûhibirania na ndombaga MWATHANI Mûrungu wa îgûrû ûrîa woombîre îria na nthî înjûmo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jona arabeera nîka amatûkîte MWATHANI, nabo antû bau baragwatwa nî ûguaa bûbwingî baramûûria atîrî, “Nîatîa ûûmba kûthithia ûntû bûbûthûûku ûjû?” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îria narîo rîreeta na mbere kûthûûka nkûrûki. Rîu eetithia ba meri baramûûria, “Nîatîa tûgaakûthithîria nîkenda îria rîborera?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jona arabacokeria atîrî, “Njûkieni bûngere îrieene narîo rîkaaborera, tontû nî nkûmenya nî îatia rîaakwa rîtûmîte kiurutani gîkînene ûjû kîbwîjîîra.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî amwe na bûu eetithia ba meri barageria na inya yaao yonthe kûreeta meri akuî na nthî înjûmo nabo batîûmbe nîûntû kiurutani ka gîeetîre na mbere kwongeereka. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu barakaîra MWATHANI bakiugaga, “Twakwerenca, itû MWATHANI, ûgatûkanûkia na gîkuû nîûntû bwa kûûraga muntû ûûjû, ningî ûgatûrîyia tharike ya muntû ûûjû ûtîîtie. Tontû gwe MWATHANI ûthithagia ûrîa ûkwona gûkwagîrîte.” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, baramûjûkia baramûgera îrieene, narîo rîraborera. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûntû bûu bûratûma eetithia ba meri bakîra MWATHANI mono mwanka baramûritîra kîgongwana na baraciîtia mîciîtio ya kûmwathîkîra.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        }
      ]
    },
    {
