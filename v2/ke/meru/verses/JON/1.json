              },
              "items": [
                {
                  "text": "Mat 12.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîu MWATHANI aratûma gîkûyû gîkînene nîkenda kîmeria Jona, nawe arakara kîu kîa gîkûyû mîthenya îthatû na mootukû jathatû.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
