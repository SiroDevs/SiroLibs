                "loc": "REV.19.6"
              },
              "items": [
                {
                  "text": "19.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa biîtîte nî ndaaigagua mathagu jaabio jakîringana jakagamba ta rûûjî rûrûnene, kana ta ngorogoro kuuma kîrî Mweneinya kana mûrurumo jwa njûûrî înene. Nabio biarûngama nî biakûûnjaga mathagu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî biarûngama bikûnjîte mathagu, nî kweethagîrwa kûrî na gîntû gîakûmari gîtegeete bwa nthî nusu kîthiûrûûri îgûrû rîa mîtwe ya bio, na kajû gakaaria kuuma îgûrû rîa gîntû kîu gîakûmari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
