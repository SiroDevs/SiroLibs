              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weerû bûu bwakari ta mûkûngambura rîrîa gûkwenda kuura.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
