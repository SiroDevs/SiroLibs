        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bûî bûrî ng'ondu ciaakwa, bûrî ng'ondu cia ndîîthia yaakwa. Ni nî ni Mûrungu weenu. Ûu nîu ndauga ûûni MWATHANI Mûrungu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
