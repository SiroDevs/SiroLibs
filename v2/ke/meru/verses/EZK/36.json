        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI Mûrungu ariuga atîrî, “Ngaatûma antû ba Israeli bambûûrie ûteethio, naani ngatûma baingîe na bathegee ta ng'ondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.37",
            "verseOrgIds": [
              "EZK.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntûûra irîa cieete maganjo ikoojûra antû ta ûrîa ng'ondu cia igongwana ciûjûraga Jerusalemu îgiita rîa biatho. Rîu nîrîo bakaamenya ni nî ni MWATHANI.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.38",
            "verseOrgIds": [
              "EZK.36.38"
            ]
          }
        }
      ]
