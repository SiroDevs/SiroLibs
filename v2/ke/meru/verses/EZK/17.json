              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, MWATHANI Mûrungu ariuga atîrî, “Nî mma ûntû ngaatûûra mwoyo no mwanka mûrîyie nîûntû bwa gwîka kîrîkanîro agîtumagîra riîtwa rîaakwa na agakîthûûkia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani nkaagera neeti mûgwate nayo. Ningî nkaamwikia Babiloni mûkanûkîrie nao, nîûntû bwa kûrega kwaa mwîtîkua kîrî ni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikarî baawe ba ndwaa barîa beega buru bakooragîrwa ndweene, na barîa bagaatigara bakaanyaganua kunthe. Rîu nîrîo bûkaamenya ni nî ni MWATHANI.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu gwîka wîrane bwa wîrîgîîro",
          "type": "text"
        }
      ]
    },
