            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî muntû ûu arambikia kîaragoone kîa bwa oome. Nakîo nî kîaarî na tûnyomba mîrongo îthatû twaaki tûriganîîrîtie na rûthingo rwa bwa oome. Mbere ya tûnyomba tûu nî kwaathithîtue gûntû gwa gwîtîîra. Gûntû kûu gwa gwîtîîra kwathithîtue na maiga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.17",
            "verseOrgIds": [
              "EZK.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûntû kûu gwa gwîtîîra kwathiûrûkîte kîarago. Kîarago kîu kîa oome kîaarî gûntû kwînami nkûrûki ya kîarago kîa bwa ndeene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        }
      ]
    },
