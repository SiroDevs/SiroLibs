          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûu aracoka arathima arîa gwaakûrûkagîîrwa kuuma ndeene ya mpingîro ya gaiti mwanka mbere ya kîarago kîa ndeene. Naku kwaarî kwa mita mîrongo îtaano (50m).",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        }
