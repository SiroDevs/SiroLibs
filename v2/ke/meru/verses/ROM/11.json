            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantûûne jegiî Nteto Injega cia Mûrungu, Ayahudi nî anthû ba Mûrungu nîûntû bweenu buî antû barîa batî Ayahudi. Îndî mantûûne jegiî kûthuurwa, kinya nandi bo nî acoore ba Mûrungu mono nîûntû bwa biûjûjû biaao. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.28",
            "verseOrgIds": [
              "ROM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa Mûrungu atîgarûraga mathûgaanio jaawe mantûûne jegiî ûrîa athuuraga kana barîa eetaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.29",
            "verseOrgIds": [
              "ROM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buî antû barîa batî Ayahudi kûrî îgiita bûtaathîkagîra Mûrungu îndî nandî nî abwonetie kîaao kîaawe nîûntû bwa kûrega gwîtîkia kwa Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.30",
            "verseOrgIds": [
              "ROM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû nî batwîre batîkwathîka nîkenda o ta ûrîa Mûrungu aabwigîîrue kîaao, abaigîîrua kîaao kinya bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
              "ROM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû Mûrungu nî atûmîte antû bonthe bakara ta nkombo nîûntû bwa kûrega kwathîka kwaao nîkenda abaigîîrua kîaao bonthe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.32",
            "verseOrgIds": [
              "ROM.11.32"
            ]
          }
        }
      ]
