        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.6",
            "verseOrgIds": [
              "ROM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuuge atîa îndî? Antû ba Israeli batoonere kîrîa baacwaga. Nî babakai baao barîa Mûrungu aathuurîre boonere kîrîa baacwaga. Bangî bonthe baraa ndemi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.7",
            "verseOrgIds": [
              "ROM.11.7"
            ]
          }
        }
      ]
    },
