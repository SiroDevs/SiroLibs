      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
