        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
