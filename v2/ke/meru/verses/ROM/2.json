              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûtî Mûyahudi, ûtîtaani, akëeja kûthithia ûrîa Waatho bûkuuga, nî mma akajûkua ta muntû ûtaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.26",
            "verseOrgIds": [
              "ROM.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
