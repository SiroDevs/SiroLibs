              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2Tim 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndîaandîkîra Tito, mûtaana waakwa wa mma ndeene ya wîtîkio bûrîa bûtûgwatithenie. Mûrungu Baaba na Kristû Jesû Mwonokia weetû nî bakwee ûtugi na thîîrî.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngûgî ya Tito kûrîa Krete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaagûtigîre Krete nîkenda ûkeerekania ngûgî irîa ciatigeere na ûthuure akûrû ba kanisa ntûûreene cionthe. Ririkana ûrîa ndaakwathîre: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4+1TI.3.5+1TI.3.6+1TI.3.7"
              },
              "items": [
                {
                  "text": "1Tim 3.2-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " atî mûtongeeria wa kanisa abuîri kwîthîrwa atî na îgi na agûrîte mwekûrû ûmwe. Aana baawe babuîri kwîthîrwa barî eetîkia na batî ngîti kana ndemi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa mûtongeeria wa kanisa nîwe mûmenyeeri wa ngûgî ya Mûrungu, abuîri kwîthîrwa atî na îgi. Atîbuîri kwîthîrwa arî mwikumia kana muntû wa marûrû kana mwogiti kana muntû wa thanga kana muntû wa îtenûka rîa mbeecha na into. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî abuîri kwîthîrwa arî muntû ûgwatanaga ûgeni nja yaawe na wendeete mantû jameega na muntû ûgwikaania mantû wengwa na ûmwagîru na ûmûtherû na muntû ûkûûmba kwatha mwîrî jwaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî abuîri kwîthîrwa arikîtie Nteto Injega o ta ûrîa ciaaritanîrwe nîkenda akoomba kûritana bangî ûrîa kwagîrîte na oombe kwoneeria barîa bakûrwaa na ûritani bwa mma bakîritanaga nteto cia ûrongo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa kûrî na antû babaingî, na mono barîa baumîte ndiniine ya Ayahudi, barîa baragia nteto itî na gîtûmi na kwaîria bangî. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bau babuîri gûkaanua kwaaria nteto iu ciaao nîûntû nî bakwangaratania antû ba mîciî yonthe bakîritanaga mantû jaarîa batîbuîri kûritana nîkenda bacionera mbeecha. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûmwe wa iroria biaao, na kinya we nî Mûkrete, nî aaugîre ûjû, “Antû ba Krete baaragia ûrongo îgiita rîonthe na nî babathûûku ta mbiti cia kîthaka na nî athao bendeete kûrîa mono.” ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteto iu augîre nî cia mma. Tontû bûû bakaanie na inya mono nîkenda bakeethîrwa barî na wîtîkio bwa mma ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "antû a bathikîîra ngono cia Kîyahudi kana mawaatho ja antû barîa bareganîte na ûûma. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrî antû babatheru, into bionthe nî bibitheru, îndî kîrî antû barîa baaî na barîa batîtîkîtie, gûtîkîo kîtheri. Mathûgaanio na nkoro ciaao nî imbîî. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "TIT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baugaga nî baijî Mûrungu îndî bakamûkaana na mathithio jaao. Nî bamenaga antû bangî, na nî ndemi, na nî antû batîagîrîte kûthithia ûntû kinya bûrîkû bûbwega.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
    }
