                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mpingîro ciaayo ikethagîrwa irugûri ntukû yonthe nîûntû gûtîkarotuka kaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
