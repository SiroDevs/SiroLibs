                "loc": "LEV.26.11+LEV.26.12"
              },
              "items": [
                {
                  "text": "Ala 26.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî ndîraigua kajû gakanene gakîaragia kuuma rûrigeene gakiugaga, “atîrî, nandî gîtûûro kîa Mûrungu kîrî amwe na antû. Mûrungu agaatûûrania amwe nabo baae antû baawe, nawe akaa Mûrungu waao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
