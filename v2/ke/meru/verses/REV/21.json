              "items": [
                {
                  "text": "Kûg 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndîroona ntûûra îrîa ntheru, tayo Jerusalemu îrîa njerû, îînamîte yumîte îgûrû kîrî Mûrungu. Nayo yaatungi na yathuranîrwa ta mûiki weteerete gûcemania na mûkûrû waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
