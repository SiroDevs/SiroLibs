              "items": [
                {
                  "text": "Zek 4.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndweni na ngorogoro o na tûjû nî biaumaga rûrigeene rûu. Ningî au mbere ya rûriga nî gwaakanaga inyinga mûgwanja bia mwanki, nabio inyinga biu nî Roho mûgwanja irîa ikaraga mbere ya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
