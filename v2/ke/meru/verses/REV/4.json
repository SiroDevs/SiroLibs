              "items": [
                {
                  "text": "10.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.2+ISA.6.3"
              },
              "items": [
                {
                  "text": "Isa 6.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Biûmbe biu birî mwoyo, o kîmwe kîabio nî kîaarî na mathagu jatantatû. Ningî o kîmwe kîabio kîojûrîte meetho mwîrî jwaakîo junthe bwa oome o na bwa ndeene. Ûtukû na mûthenya biakaraga bikiinaga bikiugaga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
