                  "text": "10.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbere ya rûriga ruû, nî kwaarî na îria rîa kîoo rîrîa rîaarî rîrîkembûku.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
