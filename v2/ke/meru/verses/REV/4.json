          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîonthe rîrîa biûmbe biu birî mwoyo biakumagia na bigeekîîra na gûcokia nkaatho kîrî ûu wakari nthî rûrigeene na ûrîa ûtûûraga kenya na kenya, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akûrû bau mîrongo îîrî na bana nî baagûjaga nthî au mbere ya ûu wakarîrîte rûriga na ûrîa ûtûûraga kenya na kenya bakamûthaathayia na bagîkaga thirû ciaao nthî au mbere ya rûriga, na kwina bakiugaga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
