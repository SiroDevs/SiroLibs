                {
                  "text": "16.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu mûraîka ûu arajûkia karaî ga gwakîîria ubaani na arakoojûria mwanki kuuma kîritîroone kîa igongwana na aracoka arajûgera nthîgûrû. Rîu kûragîta mûrurumo jûmûnene jwa ngorogoro na tûjû na ndweeni o na kwinaina kwa nthîgûrû.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
