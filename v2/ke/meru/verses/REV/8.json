              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûraîka wa baîrî nawe araringa tarumbeta yaawe. Gîntû gîakari ta kîrîma gîkînene gîgwakana mwanki, kîragerwa îrieene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîchunchî kîmwe kîrî bithatû kîa îria kîraa tharike na gîchunchî kîmwe kîrî bithatû kîa biûmbe birîa bitûûraga îrieene birakua. Ningî gîchunchî kîmwe kîrî bithatû kîa meri ireenyangua.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
