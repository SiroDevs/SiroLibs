              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Gatûrûme kaathingûrîre mûûri jwa mûgwanja, kûrakira ki îgûrû nusu îthaa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîroona araîka mûgwanja barîa barûngamaga mbere ya Mûrungu. Nabo araîka bau baranenkerwa tarumbeta mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 8:3"
          },
          "items": [
