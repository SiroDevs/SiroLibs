                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abiashara ba nthîgûrû bakarîra na baithikîîre nîûntû bwa ntûûra îîu. Tontû gûtî muntû kinya ûmwe ûgacoka kûgûra into kuuma kîrî bo kaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
