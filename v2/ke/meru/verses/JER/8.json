            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aambîrîre mbîre antû ba Israeli atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia kwithikîîra nîûntû bwa antû baao",
          "type": "text"
        }
      ]
    }
  ],
