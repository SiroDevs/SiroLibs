          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nî aajûkîrie yuku rîngî, aranenkera mwandîki tawe Baruku mûtaana wa Neria. Baruku araandîka mantû jarîa eeragwa nî Jeremia, jarîa jonthe jaandîki yukuune rîrîa Jehoiakimu mûnene wa Juda aaîthîrie. Ningî kinya mantû jangî jamaingî nî joongeererwe ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
