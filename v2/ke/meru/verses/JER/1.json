          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji nî nteto cia Jeremia mûtaana wa Hilikia. Jeremia aarî ûmwe wa athînjîri-Mûrungu barîa baatûûraga Anathothi nthîgûrûûne ya Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2Ane 22.3—23.27; 2Ma 34.8—35.19",
              "type": "text"
            }
          ]
        },
        {
          "text": " MWATHANI nî aarîîrie Jeremia mwakeene jwa îkûmi na îthatû jwa waathani bwa Josia mûnene wa Juda. Josia aarî mûtaana wa Amoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2Ane 23.36—24.7; 24.18—25.21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
                {
                  "text": "2Ma 36.5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13+2CH.36.14+2CH.36.15+2CH.36.16+2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "11-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî MWATHANI nî aamwarîîrie kaîrî matukûûne ja waathani bwa mûnene wa Juda Jehoiakimu mûtaana wa Josia. Nî amwarîîrie jamaingî mwanka mwakeene jwa îkûmi na jûmwe jwa waathani bwa mûnene wa Juda Zedekia mûtaana wa Josia. Mweriine jwa îtaano jwa mwaka jûu nîrîo antû ba Jerusalemu baataîrwe baraikua kîthamîrioone.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwîto jwa Jeremia",
          "type": "text"
        }
      ]
    },
    {
