          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI ariuga atîrî, “Buugaga gûntû gûkû, ‘Nî îgaanjo rîtî muntû kana nyomoo.’ Îndî ntûûreene iji cia Juda na njîreene cia Jerusalemu irîa ithaami nî antû na nyomoo, nî ndeene yaacio gûkaigîîgua kajû kaîrî ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
