          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI Mweneinya ariuga atîrî, “Gûntû gûkû gweete îgaanjo rîtî na muntû kana nyomoo. Îndî ntûûra cia gûntû gûkû cionthe, igaacoka kwaa gîtûûro kîa arîîthi na ndîîthia ciaao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arîîthi bakaarîîthagia ndîîthia ciaao na bagaciaania ntûûreene cia nthîgûrû ya irîma, na cia bûûrî, na cia bwa ûmotho bwa Juda, na nthîgûrûûne ya Benjamini, na gûntû kûrîa kûthiûrûkîrîte Jerusalemu, na ntûûreene cia Juda. Ûu nîu ûûni MWATHANI nkuuga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
