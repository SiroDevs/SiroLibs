              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2Ma 36.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa MWATHANI ariuga ûjû nîûntû bwa Jehoahazi",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22.11",
              "type": "text"
            },
            {
              "text": "Jehoahazi:",
              "type": "text"
            },
            {
              "text": "nîwe Shalumu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ûrîa ûkwaathana antûûne a îthe Josia. Josia ûrîa waumîre gûntû gûkû. “Josia atîcoka gûkû kaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî agaakuîra gûntû kûrîa bamûthamîrîtie arî mûtae, nawe atîcoka kwona nthîgûrû îîjî kaîrî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nteto irîa Jeremia aarîrie ciegiî Jehoiakimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia kuuga ûrîa Jerusalemu îkaathithîrua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
