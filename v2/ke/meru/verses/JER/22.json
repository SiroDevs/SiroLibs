            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.8+2KI.24.9+2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15"
              },
              "items": [
                {
                  "text": "2Ane 24.8-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2Ma 36.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI ariuga atîrî, “Nî ngûciîtia ni Mûrungu ûrîa ûtwîre mwoyo atî, kinya këethîra Jehoiakini mûnene wa Juda, mûtaana wa Jehoiakimu, nîwe kîmata kîrî na mûûri kîrî kîareene gîaakwa, nîka mûrita nkamûta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaamûnenkanîra njareene cia barîa bacwaga kûmûraga, barîa akîraga, nkaamûnenkanîra kîrî Nebukadineza mûnene wa Babiloni na kîrî Ababiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûgwe na nyakwe ûrîa wagûciarîre nkaabûta nthîgûrûûne îngî îrîa bûtîciarîri, na kûu nîku bûgaakuîra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî bûtîkorocoka nthîgûrûûne îrîa bûkeethîrwa bûnyonterete gûcoka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
