              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa MWATHANI aarîîrie Jeremia nîrîo Zedekia mûnene wa Juda aatûmîre Pashuri mûtaana wa Malikia, na mûthînjîri-Mûrungu na Zefania mûtaana wa Maaseia kîrî Jeremia. Aabatûmîre beeta kwîra Jeremia atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
