            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2Ma 36.17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tûûrîrie kuuma kîrî MWATHANI ûrîa gûgakara nîûntû Nebukadineza mûnene wa Babiloni nî atwithûkîrîte. Kwombîka MWATHANI akaaringa kîama nîûntû bweetû agatûma Nebukadineza atigana naatuî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
