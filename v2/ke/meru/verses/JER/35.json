            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jeremia nî eerîre nchiarwa cia Rekabu atîrî, “MWATHANI Mweneinya, Mûrungu wa Israeli ariuga ûjû mantûûne jabwegiî. Buî nî bwathîkîrîte kîûjûjû kîeenu Jonadabu na bwathingata ûrîa aaugîre na bwathithia jarîa jonthe aabwîrîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, ûûni MWATHANI Mweneinya, Mûrungu wa Israeli ndiuga atîrî, nchiarwa cia Jonadabu mûtaana wa Rekabu itîkoroaga muntû wa gûntumîkîra.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
