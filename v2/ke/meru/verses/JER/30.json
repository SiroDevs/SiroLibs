        "style": "s1"
      },
      "items": [
        {
          "text": "Wîrane bwa MWATHANI kîrî antû baawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
