            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
              },
              "items": [
                {
                  "text": "Zek 9.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî MWATHANI nî aarîrie mantû jegiî Damaski arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
