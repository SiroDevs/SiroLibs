                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî aambarîîrie arambîîra atîrî, “Kinya Musa na Samueli bakarûngama aja bakîerencanîîra antû ba Juda, ntîbaigîîrua kîaao. Beenge baume mbere yaakwa, beete buru!",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia kûnung'unîra MWATHANI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
