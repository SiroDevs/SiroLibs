              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wûi naanû! Nîkî ûntû maama aanciarîre ni muntû ûtetaga na kûrwaa na antû bangî nthîgûrûûne kunthe? Gûtî muntû mpeete îrandû kana ni ndoomba îrandû. Ningî amwe na jau ka antû bakûnduma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI, irumi biaao birorîa, ndîkwîthîrwa ntîbarombagîra wega na ndîkwîthîrwa ntîrombagîra anthû magiita ja thîîna na ja mîthangîko! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî muntû ûûmba anthû ba kuuma bwa ûrîo barîa bakari ta îturutia kana chuuma?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
