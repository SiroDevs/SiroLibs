              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîgaakinya rîrîa aka mûgwanja bagaatua kûgwataga ntomûrûme ûmwe bakamwîra, “Tuî tûkairîmagîra biakûrîa bieetû na twigûragîre nguû cieetû twingwa; bunka akî ûreke twîtagwe eekûrû baaku, ûtwebeerie îgi rîa kwîthîrwa tûtîgûri.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa Zaiûni îgaacokanîîrua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
