              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîgaakinya rîrîa nthîgûrû ya MWATHANI îgaatuîka înthongi na îîthîrwe îrî na nkanya, najo matigari ja Israeli jagaatua kûgwîragîrua maciara ja nthîgûrû yaao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barîa bonthe bakeethîrwa barî Zaiûni batigeere kûu Jerusalemu, barîa bonthe bakeethîrwa baandîki mariîtwa jaao yukuune rîa mwoyo kûu Jerusalemu, bageetagwa babatheru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu MWATHANI akeethîrwa athambîtie Zaiûni yathira rûko rûrîa îîkîri nî aka baayo; akeethîrwa athambîtie Jerusalemu yaathira tharike ya ndwaa. MWATHANI akeeja na inya yaawe gûtuîra antû baawe na kûbatheria. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
