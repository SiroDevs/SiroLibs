            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî MWATHANI ageekaga îgûrû rîa kîrîma kîa Zaiûni kîonthe na îgûrû rîa barîa bakoothûranaga kû îtu mûthenya na ûtukû eekage toogi na rûmûrî rwa mwanki. Tontû bûû, ûkumio bwa Mûrungu bûkaimbagîra, na bwirigagîre Zaiûni, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bweejanage mûng'unye nîûntû bwa riûa mûthenya, na bûtûme Zaiûni yaa kîmatûkîro na gûntû gwa gwiciitha kîbuubani na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
