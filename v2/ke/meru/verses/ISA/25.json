                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI Mûrungu akeebeeria gîkuû nthîgûrûûne mwanka kenya na kenya. Akaangûra antû bonthe meethori na athirie rûmena rûrîa antû baawe bamenetwe kunthe nthîgûrûûne. Nî MWATHANI warîîtie mantû jau.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
