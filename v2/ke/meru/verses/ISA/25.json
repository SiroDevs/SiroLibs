              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu rîakinya antû bagatûmîîria bakiugaga atîrî, “Ûûjû nîwe Mûrungu weetû. Nîwe tûtwîre tweteerete atwonokia. Ûûjû nîwe MWATHANI ûrîa tûtwîre tweteerete. Gatûgwîrîrue wonokio bwaawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu agaakanûkia Moabu",
