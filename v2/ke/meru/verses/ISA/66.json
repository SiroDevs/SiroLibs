        "style": "s1"
      },
      "items": [
        {
          "text": "MWATHANI agaakanûkia mîgongo yonthe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
