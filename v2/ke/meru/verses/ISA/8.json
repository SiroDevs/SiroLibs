              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thithia kîrîkanîro, ûringe nteto ciaakwa mûûri athingati baakwa bakîonaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
