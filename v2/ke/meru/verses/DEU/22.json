          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îndî gûkëeja kwîthîrwa mathitango jau nî ja mma, atî mwarî ûu ataarî karaiti akîgûrwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bûmuumagarie mpingîroone ya mûciî jwa îthe arîa atongeeria boothûranaga. Rîu bûmûûrage na maiga. Nîkwîthîrwa nî athithîtie ûthûûku bûbûnene Israeli, bwa ûmaramari mbere ya agûrwa. Ûu nîu bûkathiragia ûthûûku ta bûu kuuma kîrî buî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
