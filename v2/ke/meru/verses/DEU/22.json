          ]
        },
        {
          "text": " “Ntomûrûme akëeja gûtirimwa agwatîte mwarî ûtîgambagua, na akamama nawe kwa inya, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
