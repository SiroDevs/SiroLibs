          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ntomûrûme akëeja gûtirimana na mwarî ûgambagua nî ntûmûrûme ûngî kûu ntûûreene na akamûthengeera, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bûbaûmagarie bobaîrî mpingîroone ya ntûûra yaao, na bûboorage na maiga. Mwarî akooragwa tontû atiugîre mbu eeja gûtuunyûkua anarî ntûûreene ndeene; na ntomûrûme nawe agaakua nîûntû bwa kûthûûkia mwekûrû wa muntû ûngî. Ûu nîu bûkathiragia ûthûûku ta bûu kuuma kîrî buî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
