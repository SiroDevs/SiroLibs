          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gûkágîta muntû ûjûkia iiga kana nthie ya kûthia mûtu eeka nîkenda arîwa gîntû akoobithanîtie. Ûkäthithia ûu, ûgaatûma mûciî jwa muntû ûrîa ûkobithîtue jûrîîwa nî mpara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
