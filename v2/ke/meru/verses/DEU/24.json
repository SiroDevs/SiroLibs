            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muntû akëeja kûgûrana agéetaga ndweene kana aandîkwa ngûgîîne noo îrîkû mwaka jûmwe jûtîthiri, nîkenda agwîrîrua mûchiere waawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
