              },
              "items": [
                {
                  "text": "Gût 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rikanageeni ûrîa MWATHANI Mûrungu weenu athithîîrie Miriamu rîrîa bwaarî njîreene bumîte Misri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
