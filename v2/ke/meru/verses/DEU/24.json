            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ûkéeja kwayia nthûûmba yaaku îrîa îrî nkîa îrîa waandîkîte, kinya yeethîrwa nî Mûisraeli kana mpinga îrîa îtûûraga ntûûreene cieenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrîage mbeecha ciaawe mbere ya riûa rîthwaa, nîûntû nî nkîa na nîcio erîgîrîte atîkeeje gûkaîra MWATHANI nîûntû bwaaku na MWATHANI agûkanûkia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
