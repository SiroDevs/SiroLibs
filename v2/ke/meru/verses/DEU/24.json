          "items": [
            {
              "text": "\n        Ala 13.1—14.54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Rîrîa bûkägwatwa nî mûrimo jwa mûtigiri, bwimenyeere mono na bûthithie ûrîa athînjîri-Mûrungu ba mwîrîga jwa Lawi bakûbwoneeria bûthithie na bûjûrie jarîa jonthe mbwîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
