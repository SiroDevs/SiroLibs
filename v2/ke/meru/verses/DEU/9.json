              "items": [
                {
                  "text": "Ahi 3.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî rîrîa MWATHANI eendaga buuma Kadeshi-barinea, nî aabwîrîre atîrî, ‘Îteeni bûkaigwatîre nthîgûrû îrîa nkabûnenkera.’ Naabuî nî bwaaremere, bûrauna Waatho bwaawe. Nî bwaaregere kûmwîtîkia kana bûthîkîîra ûrîa aabwîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma rîrîa ndaabûmenyere, bûtwîre bûregeete kwathîkîra MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
