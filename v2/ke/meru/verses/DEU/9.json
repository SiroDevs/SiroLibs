                }
              ]
            }
          ]
        },
        {
          "text": " “Rîrîa bwaarî Tabera na Masaha na Kiburothi-hataava nî bwathûûrîrie MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
