              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.3+JOS.1.4+JOS.1.5"
              },
              "items": [
                {
                  "text": "Josh 1.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûntû kûrîa bûgaakinyithia îkinya rîeenu gûkaa kweenu. Nthîgûrû yeenu îkeethîrwa îrî kuuma rwanda rwa bwa gaiti mwanka irîmeene bia Lebanoni bwa rûgûrû, na kuuma mûuro jwa Eufurate bwa ûrîo mwanka îria rîa Mediterania bwa rûgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtî antû bakabûmîîria ndweene nîûntû MWATHANI Mûrungu weenu agatûma bûkîrwe nthîgûrû cionthe irîa bûgeetîîra o ta ûrîa aabwîrîre.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
