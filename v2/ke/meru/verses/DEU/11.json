                "loc": "LEV.26.3+LEV.26.4+LEV.26.5"
              },
              "items": [
                {
                  "text": "Ala 26.3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.12+DEU.7.13+DEU.7.14+DEU.7.15+DEU.7.16"
              },
              "items": [
                {
                  "text": "Kûr 7.12-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.1+DEU.28.2+DEU.28.3+DEU.28.4+DEU.28.5+DEU.28.6+DEU.28.7+DEU.28.8+DEU.28.9+DEU.28.10+DEU.28.11+DEU.28.12+DEU.28.13+DEU.28.14"
              },
              "items": [
                {
                  "text": "28.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Rîu nandî athîkagîreeni Maathana jonthe jarîa nkûbwatha ntukû îîjî ya naarua. Bweendage MWATHANI Mûrungu weenu na bûmûtumîkagîre na inya yeenu yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akaurithagîria nthîgûrû yeenu ngai îgiita rîaayo rîakinya, îgiita rîa ngai ya mûratho na ya ûthima, nîkenda bûûmba gûketha maketha ja irio na ja zabibû na mîzeituni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akaumithia nyaki bieniine bieenu nîûntû bwa ndîîthia cieenu. Naabuî bûkeethîrwa bûrî na biakûrîa bia kûbûng'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imenyeereeni bûtîkeeje kwangaratanua, bwathîkîra na bûthaathayia mîrungu îngî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI eeja kûthûûra nî buî, na nîûntû bûu arega kuurithîria nthîgûrû yeenu ngai, naabuî bwaga maketha, na bûthira o ntûti nthîgûrû îrîa njega MWATHANI akûbwaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
