        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa MWATHANI Mûrungu weenu agaatûma bûûmbe antû ba mîgongo îrîa bwîtîte kwigwaatîra nthîgûrû yaao, na bwathiria kwigwaatîra yo na bwatûûra ku, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwimenyeere bûtîkeeje gwaatithua, bûthingata mantû jarîa baathithagia na bûgáatuîîria ûrîa bathaathagia mîrungu yaao bûkîenda kûthithia tabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkáthaathayia MWATHANI Mûrungu weenu ûrîa bathaathagia mîrungu yaao, nîkwîthîrwa bo bathithagia mantû jarîa MWATHANI athwîre. Baakagîîria kinya aana baao barî igongwana kîrî mîrungu yaao.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
