          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.29"
              },
              "items": [
                {
                  "text": "Ala 19.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Gûkágîta muntû wa Israeli, ethîrwa arî mûka kana ntomûrûme, waa mûmaraya eeta gûtumîkîra kîromberoone kîa mîrungu ya mîng'uanano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa bûkarîaga mûciîtio o junthe kîrî MWATHANI, bûkárîaga na mbeecha ciumeenie na ûmaraya, bwethîrwa bûrî bwa mûka kana ntomûrûme. Nîkwîthîrwa MWATHANI Mûrungu weenu nî amenete ûntû bûû mono. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
