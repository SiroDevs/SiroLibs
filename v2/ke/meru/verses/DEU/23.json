              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa weeta muundeene jwa mîzabibû jwa muntû ûngî, woomba kûrîa nzabibû o ûrîa ûkwenda. Îndî ûgákamata wîîta nacio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
