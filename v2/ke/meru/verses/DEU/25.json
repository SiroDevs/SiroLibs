                  "text": "1Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ririkanageeni ûrîa Amaleki baabûthithîîrie rîrîa bwaaumîte Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa batakîraga Mûrungu rîrîa baabwithûkîîre bwa nyuma na barooraga antû ba Israeli barîa baatigîîri nyuma nîûntû bwa kûnoga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, rîrîa MWATHANI Mûrungu weenu akabwîka kindaaji nthîgûrû îrîa akabwaa îrî kiigai kîeenu, na atûme bwîthîrwe bûrî na thîîrî na nthîgûrû irîa ibûthiûrûkîrîte, rîu bûthirie Amaleki bonthe ûntû batîrikanwa kaîrî gûkû nthîgûrû. Bûkoorîrua nî ûntû bûu.”",
