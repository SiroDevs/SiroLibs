          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arûme baîrî bakëethîrwa nî bakûrwa, na mwekûrû wa ûmwe akëeja gûteethia ntomûrûme waawe na akagwata mûkûrû ûu ûngî ûrûme, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bûkáaigîîrua mwekûrû ta ûu kîaao. Bûmûgiite njara yaawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
