    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa ntomûrûme abuîri kûthithia mûtaana wa ng'ina akua",
          "type": "text"
        }
      ]
    },
    {
