                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bûgákûnîkaga ndeegwa kanyua rîrîa ikûûra nkano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        }
