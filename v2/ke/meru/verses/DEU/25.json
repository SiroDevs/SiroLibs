            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ûgaákamatanîria kîondoone kîmwe, maiga jaîrî ja kûthima, rîmwe rîrî rîrînene na rîngî rînini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûgeeka ithimi biîrî bitîng'anene nyomba yaakû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îthîrwa ûrî na ithimi birîa birî bia mma nîkenda bûtûûra ûtûûro bûbûraaja nthîgûrû îrîa MWATHANI Mûrungu weenu akabwaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû MWATHANI Mûrungu weenu nî athûûrîte muntû ûrîa waagia ithimiine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
