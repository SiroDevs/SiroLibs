                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî bûkathithia ûu nyuma ya ûkûûji bwa antû baîrî kana bathatû. Bûkóorga muntû nîûntû bwa ûkûûji bwa muntû ûmwe akî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1Ako 5.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akûûjî nîbo bakagera maiga ja mbere, nabo antû bau bangî bonthe bathingatîîrie boorage muntû ûu. Ûu nîu bûkaathiria ûthûûku kuuma kîrî buî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
