            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Rîrîa bûgakinya nthîgûrû îrîa MWATHANI Mûrungu weenu akabwaa yaa yeenu na bûtûûrage ku, bûcoke buuge, nî bûkwenda mûnene abwathaga ja mîgongo îrîa îngî yonthe îkethagîrwa îbûthiûrûkîrîte, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bweethie muntû ûrîa MWATHANI Mûrungu weenu akeethîrwa athuurîte kuuma kîrî buî mûnene. Bûkáeethia mpinga mûnene weenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
