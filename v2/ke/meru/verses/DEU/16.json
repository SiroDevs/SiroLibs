              "items": [
                {
                  "text": "Ala 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûkéeja gûkombokia ûûma, na bûthuuria bûgîtua magamba. Bûgetîkîîria gûkukumwa, nîûntû nkukumo nîka îthûûkagia muntû, na îgatûma îota rîrega kûthingatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîonthe thingatageeni ûûma akî, nîkenda bûgatûûra nthîgûrû îrîa MWATHANI Mûrungu weenu akûbwaa yee kiigai kîeenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
