            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Gût 28.26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tarageeni biumia mûgwanja kuuma rîrîa bûkambagîîria gûketha irio miuundeene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biumia biu biathira, bûthithie mambura ja Maketha nîkenda bûkumia MWATHANI Mûrungu weenu bûkîmûreetagîra biewa bieenu bia gûciendera o kûringana na ûrîa MWATHANI Mûrungu abûtharimîte nabio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî buî amwe na aana beenu na nthûûmba cieenu na Alawi barîa batûûraga ntûûreene cieenu, na mpinga na nkîa na ntigwa irîa itûûranagîra naabuî, bûgwîrîrue bûrî au mbere ya MWATHANI Mûrungu weenu, antû arîa athuurîte nîkenda athaathagîrua o. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iingagieeni Maathana jaja bûkîririkanaga atî buî bwaarî nkombo nthîgûrûûne ya Misri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
