            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ûthûranieni atongeeria ba mîîrîga yeenu yonthe na atongeeria bangî mbere yaakwa nîkenda mbeera mantû jaja. Ni ngeeta îgûrû na nthî biee akûûjî kîrî bo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nî nkûmenya na mma atî ndaakua buî bûkaathûûka mono na bûregane na mantû jarîa mbûritanîte. Bûkathangîka ntukû ikwîîja nîûntû bwa kûrega kwathîkîra MWATHANI. Bûgaatûma athûûre nîûntû bwa îrema rîeenu.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwîmbo rwa Musa",
          "type": "text"
        }
      ]
