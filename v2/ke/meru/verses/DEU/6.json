                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “MWATHANI Mûrungu weenu akabwikia nthîgûrûûne îrîa aciîtîîrie biûjûjû bieenu; nabo nî Abrahamu na Isaaka na Jakubu atî akabaa ntûûra injega na inene irîa bo bataaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI akabwaa nyomba ciûjûri into bibiega birîa buî bûteeka ku na abwee ithima biînji birîa buî bûtenja na miuunda ya mîzabibû na ya mîzeituni îrîa buî bûtaanda; na rîrîa bûkarîa na bûnyire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bûkéeja kûûrîrua nî MWATHANI ûrîa waabûritîre nthîgûrû ya Misri, kûrîa bwaarî nkombo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.10"
              },
              "items": [
                {
                  "text": "Mat 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Luk 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kîrageni MWATHANI Mûrungu weenu, na bûmûtumîkagîre, na bûciîtagie na riîtwa rîaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkáthaathayia mîrungu ya antû barîa bagaatûûraga akuî naabuî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû MWATHANI Mûrungu weenu ûrîa ûtûûraga gatîgatîîne keenu nî Mûrungu wa rûriitho, atîkeeje kûbûtûrîkîria mûthûûro jwaawe jûbûthiria buru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
      ]
    },
    {
