            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Thikîreeni buî Aisraeli: MWATHANI Mûrungu weenu nî ûmwe mma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.37"
              },
              "items": [
                {
                  "text": "Mat 22.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.30"
              },
              "items": [
                {
                  "text": "Mar 12.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.27"
              },
              "items": [
                {
                  "text": "Luk 10.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eendageni MWATHANI Mûrungu weenu na nkoro yonthe na mwoyo junthe na inya yeenu yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.5",
            "verseOrgIds": [
              "DEU.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.18+DEU.11.19+DEU.11.20"
              },
              "items": [
                {
                  "text": "Kûr 11.18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Najo Maathana jaja nkubwatha ntukû ya naarua nî jakare ndeene yeenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ritanageeni bwega aana beenu jo, na bwaragie bwa jo rîrîa bûkari nthî nyomba cieenu, na rîrîa bwîtîte njîreene, na rîrîa bûmami na rîrîa bûûkîîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî bûjaogeere ja rwano njareene cieenu, na ûthiûûne bweenu jarî kîririkania. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûjaandîkage mîrangoone ya nyomba cieenu na mpingîroone cieenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
    {
