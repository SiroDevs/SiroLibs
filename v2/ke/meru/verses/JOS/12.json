                  "text": "Kûr 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anene bau bobaîrî nî baarî bakûûrwa nî Musa, nthûûmba ya MWATHANI, na antû ba Israeli. Musa, nthûûmba ya MWATHANI, aagaîre mwîrîga jwa Rubeni, na Gadi, na nusu ya mwîrîga jwa Manase nthî îîu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
