              "JOS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiiteene rîu MWATHANI nî eerîre Joshua, “Thithia tûchiû twa maiga na ûthithie îtaana rîa antû ba Israeli rîa jaîrî.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua arathithia tûchiû twa maiga na arataanîra antû ba Israeli Gibeathi-haaralothi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.3",
              "type": "text"
            },
            {
              "text": "Gibeathi-haaralothi:",
              "type": "text"
            },
            {
              "text": "nî ta kuuga, “karimene ga ikonde.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîtûmi kîa Joshua kûthithia îtaana rîrî nî atî, arûme bonthe gatîgatî ga kîrîndi barîa baaumîte Misri baarî na ûkûrû bwa gwîta ndweene nî baarî bagûkuîra rwanda rûgendoone nyuma ya kuuma Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antûarûme bau bonthe baaumîte Misri nî baataani, îndî barîa bonthe baaciarîrwe rwanda, rûgendoone nyuma ya kuuma Misri, bataataani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Gût 14.28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Antû ba Israeli baakarîte rûgendoone rwanda mîaka mîrongo îna mwanka nthukî ya arûme barîa baumîte Misri barî na ûkûrû bwa gwîta ndweene îrathirua nîûntû bwa kûrega kwathîkîra MWATHANI. Nabo nîbo barîa MWATHANI aaciîtîrîtie atî atîreka boona nthîgûrû îrîa eerîîrîte beethe baao na mûciîtio, atî akabaa nthîgûrû îrîa nthongi na îrî mûthetu jûmûnoru na ûtonga bûbwingî. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antûûne a bo, nî aana baao MWATHANI ookîrîîrie na nîbo Joshua aataanîre nîûntû batoombîte gûtaanîrwa rûgendoone.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
