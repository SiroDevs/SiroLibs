          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo athînjîri-Mûrungu barîa baakamatîte Îthandûkû rîa kîrîkanîro kîa MWATHANI bararûngama gûntû gûkûûmo gatîgatî ka Jorodani; nabo Aisraeli bonthe bakiunagîîra gûntû gûkûûmo o mwanka rîrîa mûgongo junthe jwathirîrie kuuna Jorodani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
    }
