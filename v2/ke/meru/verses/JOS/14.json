            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12+DEU.3.13+DEU.3.14+DEU.3.15+DEU.3.16+DEU.3.17"
              },
              "items": [
                {
                  "text": "Kûr 3.12-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nî aarî akwaa mîîrîga îîrî na nusu rûgai rwaao rwongo rwa Jorodani rwa gaiti îndî gûtîbio aeere Alawi nao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchiarwa cia Josefu ciaarî mîîrîga îîrî, Manase na Efuraimu. Gûtî rûgai rwa nthîgûrû rwaeerwe Alawi, tiga ntûûra cia gûtûûra, na bieni biaacio nîûntû bwa kûrîîthagia na nîûntû bwa rûmatho rwaao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû ba Israeli nî baagaanîrie nthîgûrû o ûrîa ungwa MWATHANI eerîte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalebu kûewa nthîgûrû ya Heburoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
