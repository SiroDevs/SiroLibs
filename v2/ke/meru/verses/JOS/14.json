              },
              "items": [
                {
                  "text": "34.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mîîrîga kenda na nusu yagaîîrwe nthîgûrû îîu na njîra ya kûringa kuura ûrîa MWATHANI eerîte Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
