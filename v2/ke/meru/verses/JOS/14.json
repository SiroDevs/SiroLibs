              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûjû nîu nthîgûrû ya Kanaani yagaîîrwe antû ba Israeli îrî rûgai rwaao nî Eleazari, ûrîa waarî mûthînjîri-Mûrungu, na Joshua, mûtaana wa Nuni, na atongeeria ba mîciî ya mîîrîga ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
