        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.52+NUM.26.53+NUM.26.54+NUM.26.55+NUM.26.56"
              },
              "items": [
                {
                  "text": "Gût 26.52-56",
