            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni Nehemia nî ndaarûngamîîrîte nthîgûrû ya Juda kuuma Mwakeene jwa mîrongo îîrî jwa waathani bwa mûnene Aritashashita mwanka mwakeene jwa mîrongo îthatû na îîrî kuuma akwambîrîria kwaathana. Îgiita rîu rîonthe ndaathanaga rîa mîaka îkûmi na îîrî, ûûni amwe na antû ba ndûgû cieetû tûtaarîjaga biakûrîa birîa ndaabuîri kûrîa ndî mûtongeeria. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arûngamîîri barîa baathanaga nthîgûrûûne ya Juda mbere ya mpaa mûrûngamîîri wa nthîgûrû îîu, nî bainyagîîria antû mono. Baabeetagia fetha mîrongo îna (40) o ntukû, na bakabeetia irio na ndibei. Kinya barîa baabatumîkagîra no bainyagîîria antû. Îndî ûûni ntaathithia mantû ta jau, nîûntû nî ndeetîkîtie Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni ndaatumîîre îgiita rîaakwa rîonthe gwaka rûthingo. Kinya antû barîa baantumîkagîra baathithagia o ûu. Ûûni ntaaicwîîre ûtonga kuuma kîrî bo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
