            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fetha îîu îgatumagîrwa nîûntû bwa into birîa bikethagîrwa bikîendekanaga kîûrûûne. Nabio nî mîgaate yaathûrîri Mûrungu, na igongwana bia irio na bia gwakîîria birîa biaaritagwa ntukû cionthe, na bia sabatû, na bia mweri jûkîguûka, na bia biatho bitue na bia into bibitheru, na bia kûthiria meeyia ja Israeli na igongwana nîûntû bwa ngûgî irîa iritagwa kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatuî amwe na athînjîri-Mûrungu, na Alawi tûkaaringaga kuura o mwaka o mwaka nîkenda tûmenya nî mîciî îrîkû îkaareetaga nkû kîûrûûne kîa Mûrungu weetû. Nacio nîcio îgaakagîîria kîgongwana kûringana na Waatho nîûntû bwa MWATHANI Mûrungu weetû. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.19"
              },
              "items": [
                {
                  "text": "Kum 23.19",
