                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "Kûr 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî tûkaareetaga maketha ja mbere ja miuunda yeetû na matuunda ja mbere ja mituunda yeetû. Najo tûkaajareetaga kîûrûûne o mwaka o mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Kum 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tûkaathûragîra Mûrungu ataana beetû ba rikithaathi na rikithaathi cia ndîîthia cieetû. Bo amwe na ndîîthia iu tûkabaikagia kîrî athînjîri-Mûrungu o ta ûrîa kwaandîki Wathoone. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Gût 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî tûkaaritaga mîgaate ya mbere kuumania na maketha jeetû îrî kîgongwana, na matuunda, na ndibei na maguta ja nzeituni tûgaikia kîûrûûne kîrî athînjîri-Mûrungu. Ningî tûkaaritaga gîchunchî kîmwe kuuma kîrî îkûmi kîa maketha jeetû tûgakînenkanîra kîrî Alawi. Alawî nîbo babuîrîte kûûthûranagia ichunchî biu bia îkûmi ntûûreene cieetû. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.26"
              },
              "items": [
                {
                  "text": "Gût 18.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Athînjîri-Mûrungu ba rûrîîjo rwa Aaroni bakethagîrwa barî amwe na Alawi îgiita rîa kûûthûrania gîchunchî kîmwe kuuma kîrî îkûmi. Alawi nîbo bagaikagia gîchunchî kîmwe kuuma kîrî îkûmi kuumania na ichunchî biu bia îkûmi tûnyomba twa gwîka into kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuî antû ba Israeli na Alawi tûkareetaga into bia maketha jeetû, na ndibei, na maguta ja nzeituni tûnyomba tûrîa twîkagwa into bia kîûrû birîa bitumagîrwa antû bakîrîa. Tûnyomba tûu nîtu tûkaragwa nî athînjîri-Mûrungu barîa beethagîrwa barî ngûgîîne, na akaria kîûrû, na aini. Tuî tûtîtîîjîra kîûrû.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
