        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma au Nehemia aatigîîrîte Alawi nîbo baambîrîîrie gwaka rûthingo rwa ntûûra. Rehumi mûtaana wa Bani nî aakîre rûthingo rûu kuuma au Nehemia aatigîîrîte. Hashabia ûrîa waathaga rûteere rûmwe rwa Keila nîwe waakîre rûthingo rûu, kuuma arîa Rehumu aatigîîrîte. Aakîre rûthingo rûu antûûne a gûntû kûrîa aathaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavai mûtaana wa Henadadi ûrîa waathaga rûteere rûngî rwa Keila araaka kuuma au Hashabia aatigîîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezeri mûtaana wa Jeshua ûrîa waathanaga kûu Mizipa nî aakîre rûthingo rûu kuuma arîa Bavai aatigîîrîte. Arwakîre mwanka arakinya nyomba îrîa mathaga ja ndwaa jeekagwa, na gwîta mwanka arîa rûthingo rwathiorereete. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruku mûtaana wa Zabai nî aakîre rûthingo rûu kuuma arîa Ezeri aatigîîrîte. Aarwakîre mwanka arîa nyomba ya Eliashibu, mûthînjîri-Mûrungu ûrîa mûnene yaarî. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meremothi mûtaana wa Uria, Uria mûtaana wa Hakozi nî aakîre rûthingo rûu, kuuma arîa Baruku aatigîîrîte. Aarwakîre kuuma mwariine jwa nyomba ya Eliashibu mwanka mûthia jwaayo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
