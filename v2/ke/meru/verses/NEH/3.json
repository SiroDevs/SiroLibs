          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba kuuma Tekoa nî baakîre rûthingo rûu kuuma arîa Pedaia aatigîîrîte. Ningî nî baarwakîre kuuma arîa mûnaareene jûrîa mûnene jwatûmagîrwa gûkaria kîûrû mwanka rûthingo rûrîa rwarî akuî na karîma ka Ofeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
