          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîratheria antû bonthe kuuma kîrî mûgiro jwa antû ba nthîgûrû ingî. Ningî ndîroonia athînjîri-Mûrungu na Alawi ngûgî irîa o muntû abuîri kûritaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîrabangaania ûrîa nkû cia kîgongwana ikareetagwa îgiita rîrîa riaagîrîte, na ûrîa matuunda ja mbere jakareetagwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
