          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririkana antû bau, itû Mûrungu waakwa, tontû nî batûmîte athînjîri-Mûrungu bakagîa îgi na bakathûûkia kîrîkanîro kîrîa weekanîîre na athînjîri-Mûrungu na Alawi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
