              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ririkanaga mantû jau jonthe nthithîtie, itû Mûrungu ûtharimage nîûntû bwaajo.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
