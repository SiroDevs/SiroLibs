          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûrogîa ûtugi na thîîrî kuuma kîrî Mûrungu Baaba weetû na kîrî Mwathani weetû Jesû Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
    {
