          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Zab 8.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.18"
              },
              "items": [
                {
                  "text": "Akol 1.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûrungu nî eekîte into bionthe waathaniine bwa Kristû na amweethia Mwathani wa into bionthe nîûntû bwa ûguni bwa kanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.22",
            "verseOrgIds": [
              "EPH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
