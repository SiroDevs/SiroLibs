              "EPH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, kuuma rîrîa ni ndaaîgîrue nteto cia wîtîkio bweenu ndeene ya Mwathani Jesû na ûrîa bwendeete atheru bonthe, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.15",
            "verseOrgIds": [
              "EPH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "gûtî rîo ndaatiga gûcokeria Mûrungu nkaatho nîûntû bweenu. Nî mbûririkanaga marombeene jaakwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.16",
            "verseOrgIds": [
              "EPH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkîûragia Mûrungu wa Mwathani Jesû Kristû, tawe Baaba mwene ûkumio, abwee Roho ûrîa ûkabwethia baboome na abûguûrîîre bûmenye ûrîa Mûrungu akari. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.17",
            "verseOrgIds": [
              "EPH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndombaga Mûrungu athaarîrie mathûgaanio jeenu nîkenda bûûmba kûmenya nî wîrîgîîro bûrîkû bûrîa abwîtîrîte na bûmenya kwingîa kwa itharimo birîa ekîrîte atheru baawe ûrîa kûng'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.18",
            "verseOrgIds": [
              "EPH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî bumenye ûrîa inya yaawe îrîa înene nkûrûki îrîa îkûrita ngûgî ndeene yeetû tuî barîa twîtîkîtie. Inya îîu îkûrita ngûgî ndeene yeetû no îmwe na ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.19",
            "verseOrgIds": [
              "EPH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " îrîa aatumîîre rîrîa ariûkîrie Kristû kuuma kîrî akuû na aramûkarithia nthî rûteere rwaawe rwa ûrîo kûu îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûu nîku Kristû athûngûûri îgûrû rîa anene barîa barî îgûrû, na athani na moonene na mainya jonthe, na barîa bonthe baathanaga gûkû îgiiteene rîrî tûrî kana rîrîa rîkeeja. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
