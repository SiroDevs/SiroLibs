              "type": "text"
            }
          ]
        },
        {
          "text": " “Muntû atîbuîrîte kûthenganîîra na mûka akîonaga mweri, nîûntû atîtheri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
