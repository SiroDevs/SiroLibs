              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Ala 20.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû atîbuîrîte kûthenganîîra na mûka wa muntû ûngî, aithûûkia nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
