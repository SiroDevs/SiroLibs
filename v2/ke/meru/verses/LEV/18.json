                }
              ]
            }
          ]
        },
        {
          "text": " bûmenyagîîre mooritani jaakwa na mawaatho jaakwa nîûntû muntû aajamenyeera, agaatûûra mwoyo. Ni nî ni MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
