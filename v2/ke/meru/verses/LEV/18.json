        },
        {
          "text": " Muntû atîbuîrîte kûrita aana baawe igongwana bia gwakîîria kîrî mûrungu jwa mûng'uanano jwa Moleki. Kûu nî gwîkîra riîtwa rîaakwa îgi. Ni nî ni MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.13"
              },
              "items": [
                {
                  "text": "Ala 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme atîbuîrîte kûthenganîîra na ntomûrûme ûngî. Bûu nî ûntû bûbûtomoku bwa gûciîkîra mûgiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
