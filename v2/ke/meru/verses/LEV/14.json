        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa muntû ûrî na mûrimo jûmûthûûku jwa gîkoonde abuîrîte kûtherua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
