{
  "id": "LEV.8",
  "number": "8",
  "bookId": "LEV",
  "reference": "Ala 8",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "LEV 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûthuurwa na kwathûrwa kwa Aaroni na ataana baawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aarîîrie Musa aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tûmanîra Aaroni na ataana baawe. Naagwe ûreete nguû na maguta jarîa jatumagîrwa kwathûra athînjîri-Mûrungu. Ningî ûreete ndeegwa ya kîgongwana gîa kûthiria meeyia, na ûreete ntûrûme ijîîrî, na gîkabu kîrî na mîgaate îtîîkîri mûtheega jwa kwimbithia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu wîte kîûthûrano kionthe kîa antû ba Israeli kîûthûrane au mbere ya îema rîa gûtirimanîra.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arathithia ûrîa MWATHANI aamwîrîte. Nakîo kîûthûrano kîa antû ba Israeli kîroothûrana au mbere ya îema rîa gûtirimanîra.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa areera kîûthûrano kîa antû ba Israeli mantû jarîa MWATHANI aamwîrîte athithie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa areera Aaroni na ataana baawe, baumagare au mbere ya kîrîndî na bathambe ûrîa kwagîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa areekîra Aaroni kanjû na aramûkundîka mûcibi. Aracoka aramwîkîra rwambambio, na kaguû geetagwa efodi, arakaoga bwega. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî aramwîkîra nguû ya kîbara, îrîa yaaoogeeri ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.8",
              "type": "text"
            },
            {
              "text": "Ûrimu na Thumimu:",
              "type": "text"
            },
            {
              "text": "nî tûinto twîrî tûrîa twatumagîrwa nî mûthînjîri-Mûrungu kûmenya wendi bwa Mûrungu. Gûtiijîkeene bwega ûrîa twatumagîrwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " tabio into birîa biaatumagîrwa kûmenya wendi bwa MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aracoka aramwoga kîremba. Areekîra kîremba kîu karaûni ga kwonania atî Aaroni nî athuuri na aathûrîrwa MWATHANI. Musa arathithia ûrîa MWATHANI aamwîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Musa nî aajûkîrie maguta areetûûrîria îema rîrîa rîa gûtirimanîra, na areetûûrîria into bionthe birîa biaarî ku, arabiathûra kîrî MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aracoka araminyîria kîritîro kîa igongwana maguta mainda mûgwanja, arakîtheria amwe na into biaakîo bionthe, na kinya kîraî na arîa kîraî kîu gîakinyithagua, arabiathûrîra MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Musa aretûûrîria Aaroni maguta mûtwe nîkenda amwathûrîra MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu, Musa areera ataana ba Aaroni baumagare au mbere ya antû. Arabeekîra kanjû na arabaoga mîcibi, na arabaoga iremba, o ûrîa MWATHANI aamwîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Musa nî aareetere ndeegwa ya kîgongwana gîa kûthiria meeyia; nawe Aaroni na ataana baawe bararîkîîra njara mûtwe jwaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arooraga ndeegwa îîu. Arajûkia tharike îmwe, aratombeka kîara ku, araaka kooneene cio-inya cia kîritîro kîa igongwana, nîkenda akîathûrîra MWATHANI. Tharike îîu îngî areetûûrîria au kîritîroone nthîgûrû. Ûu nîu kîaathûrîrwe nîkenda kîritagîrwa igongwana bia kûthiria meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arajûkia maguta jonthe jarîa jaagwateene na into bia kîu. Arajûkia gachunchî karîa keega ga îtema, na mpigo cio-ijîîrî amwe na maguta jaacio. Musa arabiîthîîria au kîritîroone kîa igongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arajûkia nyama iu ingî cia ndeegwa îîu amwe na mûgûûta, na mara arabiîthîîria oome ya kambî, o ta ûrîa MWATHANI aamwîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aracoka arareeta ntûrûme ya kîgongwana gîa gwakîîria, nawe Aaroni na ataana baawe bararîkîîra njara mûtwe jwaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arooraga ntûrûme îîu, arajûkia tharike araminyîria nteere cio-inya cia kîritîro kîa igongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aragiitanga nyama cia ntûrûme iu, rîu araîîthîîria nyama iu amwe na mûtwe jwaayo na maguta jaayo jonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio into bia kîu na mathagiro nî biaathaambîrue. Musa araakîîria nyama cia ntûrûme îîu cionthe kîritîroone kîa igongwana, irî kîgongwana gîa gwakîîria kîrî na yeera rîrîega kîrî MWATHANI. Ûu nîu MWATHANI aamwîrîte athithie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aracoka arareeta ntûrûme ya ijîîrî, îrîa ya kîgongwana gîa kwathûra athînjîri-Mûrungu. Aaroni na ataana baawe bararîkîîra njara mûtwe jwaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arooraga ntûrûme îîu, arajûkia tharike îmwe araaka nchuuruune ya gûtû kwa ûrîo kwa Aaroni na aramwaka yo kîareene kîrîa kînene kîa njara yaawe ya ûrîo, na aramwaka yo kîareene kîrîa kînene gîa kûgûrû kwaawe kwa ûrîo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ataana ba Aaroni baraumîrua au mbere ya kîrîndî. Musa arabaaka tharike îîu nchuuruune cia matû jaao ja ûrîo, na arabaaka yo biareene birîa binene bia njara ciaao cia ûrîo, na arabaaka yo biareene birîa binene bia magûrû jaao ja ûrîo. Rîu Musa arajûkia tharike îrîa yaatigeere araminyîria nteere cio-inya cia kîritîro kîa igongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aracoka arajûkia maguta; maguta ja kînyanya na maguta jarîa jagwateene na into bia kîu. Arajûkia antû arîa eega a îtema na mpigo cio-ijîîrî amwe na maguta jaacio, na kûgûrû kwa ûrîo kwa nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma gîkabûûne ararita mîgaate mîthemba îthatû: mîgaate îtîîkîri mûtheega jwa kwimbithia îrîa yaaritîri MWATHANI; na tûmîgaate tûtûûthû tûtûnini; na kîîki îrugi na maguta. Areeka mîgaate îîu îgûrû rîa maguta, na kûgûrû kûrîa kwa nyuma kwa ûrîo, gwa ntûrûme îrîa ya kîgongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arabinenkanîra kîrî Aaroni na ataana baawe; nabo barabiûkîîria kîrî MWATHANI birî kîgongwana gîa gûûkîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aracoka arabijûkia kuuma kîrî bo arabiakîrîria au kîritîroone kîa igongwana bia gwakîîria birî kîgongwana gîa kwathûra athînjîri-Mûrungu. Nakîo nî kîaarî na yeera rîrîega kîrî MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arajûkia nyama ya kîbara, ya ntûrûme îrîa yaaritagwa rîrîa athînjîri-Mûrungu baathûragwa, aramîûkîîria kîrî MWATHANI îrî kîgongwana gîa gûûkîîria. Nyama îîu nîyo MWATHANI aaugîîte nî ya Musa. Musa arathithia o ta ûrîa MWATHANI aamwîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthieene Musa arajûkia maguta jamwe jarîa jaathûraga athînjîri-Mûrungu, na tharike îmwe îrîa yaarî kîritîroone kîa igongwana, araminyîria Aaroni na ataana baawe. Aracoka araminyîria nguû ciaao. Ûu nîu aathûrîre nguû ciaao na arabaathûra kîrî MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthieene nî eerîre Aaroni na ataana baawe ûrîa MWATHANI aaugîîte atî, “Chamûkieni nyama iu, au kîritîroone kîa igongwana kîrîa kîrî akuî na mwari jwa îema rîa gûtirimanîra. Naabuî bûrîîjanîrie nyama iu na mîgaate ya kîgongwana gîa kwathûra athînjîri-Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama iu kana mîgaate îîu bikëeja gûtigara, bûbiakîîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî bûtîbuîrîte kuumagara oome ya mwari jwa îema rîa gûtirimanîra mwanka ntukû mûgwanja ithire. Ntukû iu nîcio cia mambura ja kwathûrwa kweenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûu twathithia naarua nîbu MWATHANI augîîte bûthithue nîkenda bûrekerwa meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkare au akuî na mwari jwa îema rîa gûtirimanîra ntukû mûgwanja; mûthenya na ûtukû, bûkîthithagia mantû jarîa MWATHANI augîîte bûthithie, bûtîkeeje gûkua. Ûu nîu MWATHANI arambîîrîre.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaroni na ataana baawe nî baathithîrie mantû jonthe jarîa MWATHANI eerîte Musa bathithie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
        }
      ]
    }
