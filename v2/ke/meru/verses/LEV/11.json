              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûu nîbu Waatho bwegiî nyamû cia kîthaka na nyoni, na biûmbe bionthe birîa bikaraga rûûjîîne, na tûnyamû tunthe tûrîa twîtaîtaga nthîgûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waatho bûu nî bwa kûmenyithanagia nyamû irîa ntheru na irîa itîtheri. Ningî nî bwa kûmenyithanagia nyamû irîa ibuîrîte kûrîîwa na irîa itîbuîrîte kûrîîwa.",
          "type": "text",
          "attrs": {
