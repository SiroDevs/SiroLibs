            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Gût 6.22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aaroni aratharima antû ookîîrîîtie njara. Arakinya nthîgûrû kuuma kîritîroone kîa igongwana arîa aaritagîra igongwana bia kûthiria meeyia na bia gwakîîria na bia thîîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Aaroni baratonya îemeene rîa gûtirimanîra. Rîrîa baumagarîre, baratharima antû. Naju mwago jwa MWATHANI jûracionania kîrî antû bonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI aratûma mwanki, jûreenama jûraîîthia kîgongwana kîu gîa gwakîîria amwe na maguta jarîa jaarî kîritîroone kîa igongwana. Rîrîa antû bonthe boonere mantû jau, baraturia maru bareenamîîria barathaathayia MWATHANI bakîriingaga gîtuma mono.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.24",
            "verseOrgIds": [
              "LEV.9.24"
            ]
          }
        }
      ]
    }
  ],
