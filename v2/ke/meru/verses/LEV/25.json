          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkáajûkagia maciara ja mbeecha kuuma kîrî we kana ûmwîtia mpongeeri. Mbathîkagîreeni na bûkáarekeeria Aisraeli bangî bagatûûrania naabuî. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
