          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûrîa ûmûgûrîte athithagîrie Mûisraeli ûu o ta ûrîa mûriti ngûgî athithagîrua. Muntû ûu atîbuîrîte kwiinyîîrua. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
