          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî akëeja kwîthîrwa atîkûûrwa na njîra îmwe ya iu, nî abuîrîte kûrekeerua amwe na aana baawe rîrîa mwaka jwa gûcokeria antû into biaao jûgakinya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
            "verseOrgIds": [
              "LEV.25.54"
            ]
          }
        },
        {
