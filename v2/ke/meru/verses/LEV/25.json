                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Kûr 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bwamûkoobithia mbeecha bûtîkaamwîtagie maciara jaacio, ningî bwamûrûmia irio bûtîkaamûrîagie nkûrûki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nî ni MWATHANI Mûrungu weenu, ûrîa ûbûritîte nthîgûrûûne ya Misri nîkenda mbîja kûbwaa nthîgûrû ya Kanaani, na nîkenda mbîthagîrwa ndî Mûrungu weenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
