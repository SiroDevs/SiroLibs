          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jau nîjo mawaatho jegiî ntomûrûme ûtigîte kwaa ûmûtheru nîûntû bwa kwiratha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
