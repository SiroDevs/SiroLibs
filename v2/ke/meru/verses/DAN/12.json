            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Kûg 22.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Îndî gwe Danieli kunîka nteto iji, wikûjîre yukuune mwanka îgiita rîa mûthia. Antû babaingî nabo bageetaga gûkû na kûrîa bagîcwaa kûmenya ûrîa gûgakara.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ûûni Danieli ndîraraithîîria ndîroona antû baîrî barûngami rûteere rwa mûuro, ûmwe rûteere rûrû, na ûngî rûteere rûngî. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani ndîrooria mûraîka ûrîa warûngami mûuroone rûgûrû atîrî, “Mantû jaja ja kûrigaria jagaakinya mûthia rî?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        }
      ]
    },
    {
