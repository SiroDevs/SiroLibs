          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakîo kîroria kîraritanga gîtambaa ûthiû, rîu mûnene aramenya nî ûmwe wa iroria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu kîroria kîramwîra atîrî, “MWATHANI ariuga ûjû: ‘Tontû nî ûrarekererie muntû ûrîa ndîraugîîte ooragwe amatûka, ûkooragwa antûûne aawe na njûûrî yaaku yûûragwe antûûne a njûûrî yaawe.’” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
