        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, asikarî babeethi barîa bakaragia atongeeria nî baaumagarîre bathingati nî njûûrî ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.19",
            "verseOrgIds": [
              "1KI.20.19"
            ]
          }
        }
      ]
