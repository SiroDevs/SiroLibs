            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Ahabu aroothûrania asikarî barîa baarî babeethî baakaragia arûngamîîri barakinya magana jaîrî ja mîrongo îthatû na baîrî (232). Ningî arathuranîra asikarî ba Israeli ngiri mûgwanja (7,000) barathingata bau.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baraumagara kûrî thaa thita. Îgiita rîu mûnene Beni-hadadi no aanyunyaga barî na atongeeria barîa mîrongo îthatû na baîrî barîa baamûgwataga mbaru barî maemeene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.16",
            "verseOrgIds": [
              "1KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo asikarî barîa baarî babeethî nî baumagarîre barî mbere. Nabo achûnkûûni barîa mûnene Beni-hadadi aarî agûtûma, baracoka baramwîra atîrî, “Kûrî antû bakuumagara ntûûreene ya Samaria.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.17",
            "verseOrgIds": [
              "1KI.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Beni-hadadi arauga atîrî, “Îteeni bûbareete barî mwoyo, bëethîrwa beejîte gûcwaa thîîrî kana gûcwaa ndwaa.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        }
      ]
    },
