          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Solomoni nî aagererie kûûraga Jeroboamu, îndî Jeroboamu aramatûka areeta kîrî Shishaki, mûnene wa Misri. Nawe aratûûra Misri mwanka rîrîa Solomoni aakuîre.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûkua gwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
