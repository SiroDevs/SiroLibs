          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nako kagiita kau konthe Rehoboamu aathanîre nî aakarîre akîrûjaga na Jeroboamu magiita jamaingî. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
