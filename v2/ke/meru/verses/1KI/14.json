          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rîrîa mûnene eetaga kîûrûûne, akaria bau nî bakamataga rong'o iu na nyumeene bagaicokia o arîa ciaaingagîrwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
