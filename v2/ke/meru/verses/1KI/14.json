                  "text": "2Ma 9.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe arataa mûthithû junthe na into bionthe birîa biaarî kîûrûûne na gîkaro kîa mûnene na kinya rong'o cia thaabu irîa Solomoni aarî akûthithia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Rehoboamu nî aathithîrie rong'o cia îturutia nîkenda ciîkwa arîa iu ciaataîrwe cieekagwa, arainenkanîra njareene cia akaria ba mpingîro ya gîkaro kîa mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
