              "1KI.6.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20"
              },
              "items": [
                {
                  "text": "Kum 25.18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nî aathithîrie biûmbe biîrî bia mathagu jaîrî biîtagwa kerubimu na mbaaû cia mîthaata, na aabiîka antû atheru buru. O kîmwe kîaarî kîa akuî mita ithaano (5m) gwitia bwa îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O îthagu rîmwe rîa kerubimu, rîaarî rîa ûraaja bwa mita injîîrî na nusu (2.5m). Kuuma mûthia jwa îthagu rîmwe mwanka mûthia jwa îthagu rîngî kwaarî mita ithaano (5m). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya mathagu jo-jaîrî ja kerubimu ûu ûngî jaarî ja uraaja bwa mita ithaano (5m). Nabio biûmbe biu bio biîrî nî biang'uaneene na biang'anana buru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubimu ûmwe aarî wa mita ithaano (5m) gwitia bwa îgûrû kinya ûu ûngî aarî na ûraaja o ta bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe areeka kerubimu bau antû atheru buru bereekene. Mathagu jaabo jaambaarîte, jaringithagia rûthingo na jaîrî jaringithanîtie gatîgatî na jaîrî jangî jakaringithia rûthingo, o îthagu rûteere rwaarîo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni arereeria kerubimu iu na thaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakîo kîûrû bwa ndeene kîragemua na biûmbe bia kerubimu na mîkîndû na maûa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî kinya nthîgûrû yeereererue na thaabu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku mwariine jwa antû arîa atheru buru areekîra mûrango jwaatûri gatîgatî. Naju jwaatumi na mbaaû cia mîthaata. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo mîari îragemua na mbicha cia kwaja cia kerubimu na mîtî ya mîkîndû na maûa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku mwariine jwa kîûrû areekîra mûrango jwa kona inya jûtumi na mbaaû cia mîthaata. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichunchî bio-biîrî bia mîari yo-îîrî biaarî bia gûkûnja. Nayo yaathithîtue na mbaaû cia mîthithinda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe aragemia mîrango îîu na mbicha cia kwaja cia kerubimu na mîtî ya mîkîndû na maûa, nabio nî bieereeretue na thaabu îng'anu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni araaka kîarago au mbere ya kîûrû, na rûthingo rweekîri kosi îmwe ya mîtarakwa kîrî kosi ithatû cia maiga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
