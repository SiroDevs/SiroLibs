            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu Jehu aatûmîre mûrungu jwa Baali jûtiga kûrombagwa nthîgûrûûne ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.28",
            "verseOrgIds": [
              "2KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1Ane 12.28-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî Jehu ataatiganîre na meeyia jarîa Jeroboamu mûtaana wa Nebati, aathithagia, jarîa jaatûmîre antû ba Israeli batonya meeyiene ja kûthaathayia mîrungu ya mîng'uanano ya tûjaû twa thaabu îrîa yeeki ntûûreene ya Betheli na ya Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Jehu atîrî, “Ûkûthithia mantû jameega meethoone jaakwa, na wathithiria nchiarwa cia Ahabu ûrîa ndîngîenda ithithîrua. Tontû bû nchiarwa ciaaku ikaathana ndeene ya Israeli mwanka nthukîîne ya inya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jehu atáthîkîîre Waatho bwa MWATHANI Mûrungu wa Israeli na nkoro yaawe yonthe. Ningî ataatiganîre na meeyia jarîa mûnene Jeroboamu aathithagia jarîa jaatûmîre Israeli îtonya meeyiene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gîkuû kîa Jehu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiiteene rîu, MWATHANI nî aambîrîîrie kûnyiyia nthîgûrû ya Israeli. Mûnene Hazaeli wa Sîria nî aataîre nthîgûrû ya Israeli yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma rûteere rwa bwa gaiti rwa Jorodani, gwîta bwa ûmotho mwanka ntûûreene ya Aroeri, îrîa yaarî rûteere rwa mûuro jwa Arinoni. Nayo îîu yaarî nthîgûrû ya antû ba Gileadi, na ba Bashani, na nîyo yaarî nthîgûrû ya mîîrîga ya Gadi, na Rubeni na Manase ya bwa gaiti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mantû jangî jamanene jarîa Jehu aathithîrie nî jaandîki yukuune rîa Mantû ja Karaaja jegiî Anene ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehu nî aakuîre na arathikwa ntûûreene ya Samaria. Jehoahazi mûtaana waawe araa mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.35",
            "verseOrgIds": [
              "2KI.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jehu arî Samaria, rîaarî mîaka mîrongo îîrî na înaana (28).",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
            "verseOrgIds": [
              "2KI.10.36"
            ]
          }
        }
