            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî antû bau barakira ki batîmûcokerie ûntû noo bûmwe nîûntû mûnene aaugîîte, “Bûkámûcokerieni ûntû.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliakimu mûtaana wa Hilikia, ûrîa waarî mûrûngamîîri wa gîkaro kîa mûnene, na Shebuna ûrîa waarî karani, na Joaha mûtaana wa Asafu ûrîa waarî mwandîki nî baacokere kîrî Hezekia batambûrangîte nguû kwonania nî baithikîîrîte. Nabo bareera mûnene ûrîa atongeeria ba mûnene wa Asîria baarî bakuuga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
