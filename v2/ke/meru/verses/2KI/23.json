                  "text": "32.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî mûnene Josia nî aathûûkangîrie gûntû kûrîa kwaaritagîrwa igongwana nîûntû bwa mîrungu ya mîng'uanano, kûrîa gweetagwa Tofethi, Gûntû kûu kwaarî kîguuruune kîa ataana ba Hinomu. Aathûkangîrie gûntû kûu nîkenda antû batiga kûritîra mûrungu jwa Moleki aana baao barî igongwana bia gwakîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî aaritîre mbarathi mwariine jwa kîûrû irîa cieeki nî anene ba Juda nîûntû bwa kûthaathayia mûrungu jwa riûa. Mbarathi iu cieeki akuî na kanyomba ka mûtongeeria ûmwe weetagwa Nathani-meleki. Josia aracoka araîîthia ngaarî cia ndwaa îria ciatûmagîrwa kûthaathayia mûrungu jwa riûa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.5"
              },
              "items": [
                {
                  "text": "2Ane 21.5",
