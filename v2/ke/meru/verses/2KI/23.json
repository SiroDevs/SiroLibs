        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahazi aarî na ûkûrû bwa mîaka mîrongo îîrî na îthatû rîrîa aaere mûnene wa Juda. Aathanîre mîeri îthatû arî Jerusalemu. Ng'ina eetagwa Hamutali, na aarî mwarî wa Jeremia kuuma ntûûreene ya Libuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie mantû jamathûûku mbere ya MWATHANI o ta jarîa biûjûjû biaao biaathithagia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao Neko nî aamûtheekere ncheera ntûûreene ya Ribula nthîgûrûûne ya Hamathi nîkenda atîkaathane arî Jerusalemu. Ningî Farao Neko nî aaritithagia nthîgûrû ya Juda ûgoti bwa Kilo ngiri ithatû cia magana jana (3,400) cia fetha na kilo mîrongo îthatû na inya (34) cia thaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Jer 22.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Farao Neko nî aaeetherie Eliakimu mûtaana wa Josia mûnene wa Juda. Ningî aragarûra riîtwa rîa Eliakimu aramwîta Jehoiakimu. Farao Neko arajûkia Jehoahazi aramwikia Misri, nawe Jehoahazi arakuîra ku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        }
      ]
