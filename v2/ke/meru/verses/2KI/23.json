      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûnene Josia kûthiria ûrombi bwa mîrungu ya mîng'uanano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
