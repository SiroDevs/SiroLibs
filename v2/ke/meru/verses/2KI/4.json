        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrakara atîrî, muntû ûmwe nî aaumîre Baali-shalisha araikîria Elisha mîgaate mîrongo îîrî yaathithîtue na mûtu jwa mûnyaki jwa îketha rîa mbere. Ningî aramwikîria nkano nkunia îmwe ciakethi o rîo. Elisha arauga atîrî, “Nenkeeria antû barîe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nthûûmba yaawe îrooria atîrî, “Nîatîa nkaagaîra antû îgana into bibi?” Elisha aracokia atîrî, “Banenkere bio barîe, nîûntû MWATHANI augîîte ûjû: ‘Bakaarîa na bitigare.’” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, nthûûmba îrabanenkeera. Nabo bararîa na biratigara o ta ûrîa MWATHANI aaugîîte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
