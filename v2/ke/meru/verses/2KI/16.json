                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2Ma 4.2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûnene Ahazi nî aathûûkangîrie tûgaarî twa îturutia tûrîa twatumagîrwa kîûrûûne, na ararita iraî birîa biaarî îgûrû rîa tu. Ningî nî aaritîre gîtangi kîrîa kînene kîaarî îgûrû rîa ndeegwa cia îtûrûtîa arakîrîkîîra mûsingiine jwa maiga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ararita karîngo karîa gaaki kîûrûûne ga kûrîkagîîra gîtî kîa mûnene na arainga njîra îrîa mûnene eetagîîra agîtonya kîûrûûne ntukû ya sabatû. Aathithîrie mantû jau nîkenda agwîria mûnene wa Asîria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
