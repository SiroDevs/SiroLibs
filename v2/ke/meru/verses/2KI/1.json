        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia nî aakuîre kûringana na nteto cia MWATHANI irîa Elija aarîîtie. Ahazia ataarî na mûtaana. Tontû bûû, mûtaana wa ng'ina Joramu nîwe waajûkîrie ûnene. Joramu aaere mûnene mwakeene jwa îîrî jwa waathani bwa mûnene wa Juda, tawe Jehoramu mûtaana wa Jehoshafati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
    {
