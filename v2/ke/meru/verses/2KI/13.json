              "2KI.13.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.12"
              },
              "items": [
                {
                  "text": "2Ane 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisha nî aajîtue mbajua înene mono na nî aarî akuî gûkua. Jehoashi, mûnene wa Israeli nî eetîre kûmûraitha. Jehoashi aramûrîrîra akiugaga, “Wûi baaba, Wûi baaba! Gwe nchamba ya Israeli ûgwîta!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha aramwîra atîrî, “Jûkia ûta na mîgwî.” Jehoashi arajûkia ûta na mîgwî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha areera mûnene wa Israeli ûjû, “Ithuranîre kûratha.” Nawe mûnene araithuranîra. Elisha ararîkîîra njara yaawe njareene ya mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha areera mûnene atîrî, “Rugûra ndiricha ya bwa gaiti.” Nawe mûnene aramîrugûra. Elisha aramwîra atîrî, “Rîu ratha.” Nawe mûnene araratha. Elisha arauga, “Jûu nî mûgwî jwa MWATHANI jwa ûûmbani. Nî mûgwî jûrîa jûgatûma Sîria yûûmbwa. Nîkwîthîrwa gwe ûkaarwîra na antû ba Sîria ntûûreene ya Afeki mwanka ûbathirie buru.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha aracoka aramwîra, “Jûkia mîgwî.” Nawe aramîjûkia. Elisha aramwîra atîrî, “Ratha nthîgûrû na mîgwî îîu.” Nawe Jehoashi araratha nthî maratha jathatû rîu aratiga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha arathûûra mono nîwe, aramwîra atîrî, “Këethîra ûkûratha maratha jataano kana jatantatû, ûrîngî kwithûkîra antû ba Sîria mwanka ûkabathiria buru. Îndî nandî ûkaboomba ndweene mainda jathatû akî.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha nî aakuîre, na arathikwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambîrîrioone jwa o mwaka o mwaka, ikundi bia atuunyani nî biaithûkagîra nthîgûrû ya Israeli kuuma Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiiteene rîmwe, rîrîa muntû ûmwe aathikagwa, gîkundi ta kîu kîa atuunyani nî kîonerwe. Nabo antû baragera kiimba mbîrîreene ya Elisha baramatûka. Rîrîa kiimba kîagwîre mbîrîreene, kîragwa marûitûûne ja Elisha kîrariûka, kîrarûngama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndwaa ya Israeli na Sîria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
