              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumeene nîrîo ndeetîre nthîgûrû ya Sîria na Cilicia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
