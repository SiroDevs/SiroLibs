              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiteene rîu, antû ba kanisa cia Judea bataarî bakûmbona baameenya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
