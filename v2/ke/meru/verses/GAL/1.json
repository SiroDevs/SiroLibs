              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijî akî nteto irîa bangî baugaga, atî: “Muntû ûrîa waatwîre agîtûthangîkagia, nandî nîwe ûgûtûmîîria mantû ja wîtîkio bûrîa aageragia kûthiria!” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
