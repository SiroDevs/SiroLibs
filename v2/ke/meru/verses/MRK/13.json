              "items": [
                {
                  "text": "Kûg 6.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nyuma ya mîthangîko yaathira, riûa rîkagîa muundu na mweri jûtige kûthaara. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
            "verseOrgIds": [
              "MRK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
