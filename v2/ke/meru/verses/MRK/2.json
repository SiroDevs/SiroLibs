              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Jesû arabeera, “Sabatû yaatuîrwe nîûntû bwa antû îndî antû batoombîrwe nîûntû bwa sabatû. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
