          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.38"
              },
              "items": [
                {
                  "text": "Mat 10.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.27"
              },
              "items": [
                {
                  "text": "Luk 14.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu Jesû areeta antû bonthe amwe na aritwa baawe na arabeera, “Këethîra muntû nî akwenda kûnthingata, nî airege na akamate mûtharaba jwaawe na anthingate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
