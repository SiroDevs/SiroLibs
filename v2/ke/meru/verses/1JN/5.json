          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aana baakwa, ciathûranageni na mîrungu ya mîng'uanano!",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.21",
            "verseOrgIds": [
              "1JN.5.21"
