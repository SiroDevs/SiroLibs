              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîbwaandîkîra mantû jaja nîûntû bwa antû barîa bakûgeria kûbwaîria. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
