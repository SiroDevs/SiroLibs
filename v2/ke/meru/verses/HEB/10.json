          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa tûkëeja kwîyia ntabarako tûkwamba kûmenya ûûma, tûtîkoroona kîgongwana kîngî gîa kûrekera meeyia, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
