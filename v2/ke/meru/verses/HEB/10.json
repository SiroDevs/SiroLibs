            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tontû bûû, rîrîa Kristû eejîre nthîgûrû nî augîre ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
