                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû ûrîa waunaga Waatho bwa Musa nî ooragagwa antû batîkûmwigîîrua kîaao kwëethîrwa kûrî na akûûjî baîrî kana bathatû. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.8"
              },
              "items": [
                {
                  "text": "Kum 24.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îkanûkia rîa muntû ûrîa ûmeneragia Mûtaana wa Mûrungu kana akoona tharîke ya kîrîkanîro, îrîa yaamûthererie kuuma meeyiene teeka îrî ya ûtheri kana akaruma na akûthûûria Roho Ûmûtheru ûrîa ûreetagîra antû ûtugi rîkeethîrwa rîrî rîrîî nkûrûki. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.35+DEU.32.36"
              },
              "items": [
                {
                  "text": "Kûr 32.35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tuî nî tûkûmenya ûrîa waugîre atî, “Nî ni nkabûrîagîîria,” na kaîrî arauga, “Mwathani nîwe ûkagambithia antû baawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî ûntû bwa kûmakania muntû kûringwa nî njara ya Mûrungu ûrîa ûrî mwoyo!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
