          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.11"
              },
              "items": [
                {
                  "text": "Isa 26.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî kîrîa gîkeethîrwa gîtigeere nî gûtuîrwa îgamba na mwanki jûmûnene jûrîa jûkaîîthia anthû baawe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
