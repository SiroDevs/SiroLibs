              "items": [
                {
                  "text": "Hab 2.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maandîko jariuga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
