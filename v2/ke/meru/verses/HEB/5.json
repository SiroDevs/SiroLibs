      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû o mûthînjîri-Mûrungu ûrîa mûnene athuuragwa kuuma kîrî antû nîkenda aikagia biewa birîa antû baritaga na abaritagîra igongwana kîrî Mûrungu nîkenda barekerwa meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Mûrungu ûu, nî aremeeragwa nî mantû jamwe ta bangî. Tontû bûû, atiinyagîîria barîa batiijî na barîa barî na maatia. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Ala 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû kinya we kûrî mantû jamûremagîîra, nî aritaga kîgongwana nîûntû bwa meeyia jaawe na akarita kîgongwana nîûntû bwa meeyia ja antû barîa bangî. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Kum 28.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûtî muntû ûûmba gûciaa wengwa gîtîîo kîu gîa kwaa mûthînjîri-Mûrungu ûrîa mûnene. Muntû aejaga mûthînjîri-Mûrungu ûrîa mûnene rîrîa athuurwa nî Mûrungu ta ûrîa Aaroni aathuurîrwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
