              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îtageni na mbere kwendanaga buru o muntû na ûngî ta akristû. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
          }
        },
        {
          "name": "verse",
