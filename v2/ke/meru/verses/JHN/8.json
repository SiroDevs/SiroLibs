              "JHN.8.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.14"
              },
              "items": [
                {
                  "text": "Mat 5.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.5"
              },
              "items": [
                {
                  "text": "Joh 9.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû ararîîria Afarisayo kaîrî arabeera atîrî, “Ni nî ni weerû bwa nthîgûrû. Muntû wonthe ûrîa ûnthingataga atiitagîîra muunduune, îndî akagîa weerû bûrîa bûretaga ûtûûro.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.31"
              },
              "items": [
                {
                  "text": "Joh 5.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîu Afarisayo baramwîra, “Nîka ûgwikûûjîîra wengwa tontû bûû ûkûûjî bwaaku tî bwa mma.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabacokeria, “Kinya këethîra ka ngwikûûjîîra, ûkûûjî bwaakwa nî bwa mma nîûntû ûûni nî mbijî kûrîa ndaumîre na nî nkûmenya kûrîa mbîtîte. Îndî buî bûtiijî kûrîa ndaaumîre kana bûmenya kûrîa mbîtîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.14",
            "verseOrgIds": [
              "JHN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buî bûtujanagîra îgamba kûringana na mathûgaanio jeenu, îndî ni gûtî muntû nkûgambithia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.15",
            "verseOrgIds": [
              "JHN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya nkëeja kûgambithania, ûrîa nkagiita nî bwa mma nîûntû ntîgiitaga magamba ninka. Ngiitaga ndî na Baaba ûrîa waantûmîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.16",
            "verseOrgIds": [
              "JHN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî kwaandîki Waathoone bweenu atî ûkûûjî bwa antû baîrî nî bwa mma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.17",
            "verseOrgIds": [
              "JHN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni nî ngwikûûjîîra ningwa, na Baaba ûrîa waantûmîre kinya we nî agûnkûûjîîra.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.18",
            "verseOrgIds": [
              "JHN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu baramûûria, “Nîkû Abaagu arî?” Jesû aracokia, “Buî bûtîmbijî, na kinya Baaba bûtîmwijî. Këethîra nî bûmbijî, bûrîngîmenya kinya Baaba.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû augîre nteto iu arî kanyomba karîa biewa biekagwa kûu kîûrûûne. Aaritanaga arî ku na gûtî muntû ûrîngîmûgwata nîûntû îgiita rîaawe rîtaakinyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naarîa mbîtîte buî bûtîumba gûkinya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabeera kaîrî atîrî, “Ûûni nîka mbîtîte, na bûgancwaa, îndî bûgaakua bûrî na meeyia. Kûrîa mbîtîte buî bûtîumba gûkinya.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.21",
            "verseOrgIds": [
              "JHN.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu atongeeria ba Ayahudi barauga, “Ka agaciûraga? A nîatîa îndî akuuga: ‘Kûrîa mbîtîte buî bûtîûmba gûkinya?’” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.22",
            "verseOrgIds": [
              "JHN.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabeera, “Buî bûrî ba aja nthî, îndî ûûni mpuumîte îgûrû; buî bûrî ba nthîgûrû îîjî, îndî ûûni ntî wa nthîgûrû îîjî. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.23",
            "verseOrgIds": [
              "JHN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîu nîkîo gîtûmi nkûbwîra atî bûgaakua bûrî na meeyia. Nîkwîthîrwa tiga bûgeetîkia ni nî ni we, bûgaakua bûrî na meeyia.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.24",
            "verseOrgIds": [
              "JHN.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baramûûria, “A gwe nîgwe ûû?” Jesû arabacokeria, “No ûrîa ndaabwîrîre kuuma kîambîrîria! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndî na jamaingî ja kwaria jabwegiî na jamaingî jagûtûma mbûgambithia. Îndî ûrîa waantûmîre nî wa mma. Nî mbîraga nthîgûrû nteto irîa mbigîtue kuuma kîrî we cionka.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataaciûkîîrwe atî Jesû aaragia mantû jegiî Îthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.27",
            "verseOrgIds": [
              "JHN.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Jesû arabeera atîrî, “Rîrîa bûgookîîria Mûtaana wa Muntû îgûrû, nîrîo bûkamenya atî ‘Ûûni nî ni we,’ na atî gûtîkîo nthithagia na bwaakwa ningwa, îndî mbaragia nteto irîa Baaba aanditanîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.28",
            "verseOrgIds": [
              "JHN.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûrîa waantûmîre arî amwe naani; we ataantiganîria ninka nîûntû nthithagia mantû jarîa jamûgwîragia magiita jonthe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.29",
            "verseOrgIds": [
              "JHN.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "O akîaragia antû babaingî nî baamwîtîkîrie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûûma bûkabûkûûra ûkomboone",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Jesû areera Ayahudi barîa bamwîtîkîtie, “Bwathingata mooritani jaakwa nîrîo bûkaa aritwa baakwa ba mma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.31",
            "verseOrgIds": [
              "JHN.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkamenya ûûma, nabu ûûma bûkabûkûûra kuuma ûkomboone.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.32",
            "verseOrgIds": [
              "JHN.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.9"
              },
              "items": [
                {
                  "text": "Mat 3.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.8"
              },
              "items": [
                {
                  "text": "Luk 3.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo baramûcokeria, “Tuî tûrî ba rûrîîjo rwa Abrahamu, na gûtî rîo tweethîrwa tûrî nkombo cia muntû noo ûrîkû. Nandî nîatîa ûkwenda gûtwîra rîrîa ûkuuga: ‘Bûgakûûrwa kuuma ûkomboone!’” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabacokeria, “Ga nkûbwîra na mma, muntû ûrîa ûthithagia meeyia nî nkombo ya meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.34",
            "verseOrgIds": [
              "JHN.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkombo îtîtaragwa îrî ya nja îrîa îrî îgiita rîonthe, îndî mûtaana nî ataragwa arî wa nja îîu îgiita rîonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.35",
            "verseOrgIds": [
              "JHN.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Mûtaana akëeja kûbûkûûra kuuma ûkomboone, bûkauma ku buru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.36",
            "verseOrgIds": [
              "JHN.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni nî mbijî atî bûrî ba rûrîîjo rwa Abrahamu îndî amwe na bûu buî nî bûkwenda kûmbûraga nîûntû bûtîtîkagia mooritani jaakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.37",
            "verseOrgIds": [
              "JHN.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni mbaragia mantû jarîa mboneete kuuma kîrî Baaba, îndî buî bûthithagia jarîa bwigîtue kuuma kîrî abaagu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baramûcokeria bakiugaga, “Baaba weetû nî Abrahamu.” Jesû nawe arabeera, “Këethîra buî bûrî aana ba Abrahamu, bûrîngîthithia ûrîa Abrahamu aathithîrie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni nî mbwîrîte ûûma bûrîa ndaaigîrue kuuma kîrî Mûrungu; îndî buî nî bûkwenda kûmbûraga. Abrahamu ataathithia ûntû ta bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.40",
            "verseOrgIds": [
              "JHN.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buî bûthithagîa mantû o jarîa jongwa abaagu aathithîrie.” Nabo baramûcokeria, “Tuî tûtîciaari kumaania na ûthûûngîîri. Baaba weetû nî ûmwe na nî Mûrungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabeera, “Këethîra Mûrungu nî abaagu, kinya ni bûrîngîmpenda, nîûntû ndaumîre kîrî we ndîreeja kîrî buî. Nteejîre na bwaakwa ningwa, îndî nîwe waantûmîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.42",
            "verseOrgIds": [
              "JHN.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkî bûtîgûciûra mantû jarîa nkûbwîra? Gîtûmi nî atî bûtîkûûmba kûthikîîra jarîa nkûbwîra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.43",
            "verseOrgIds": [
              "JHN.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buî bûrî aana ba abaagu tawe Nkoma, na bûrîenda kûthithia wendî bwa abaagu. We aarî mûûragani kuuma tene; atîeendaga mantû ja ûûma nîûntû mma îtî ndeene yaawe. Rîrîa aaragia ûrongo, abwaragia nîûntû nî wîthîre bwaawe. Nîkwîthîrwa we nî mûrongo na nî kaumo ka ûrongo bunthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.44",
            "verseOrgIds": [
              "JHN.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî ni mbaragia ûûma, na kîu nîkîo gîtûmaga bûrega kûmbîtîkia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.45",
            "verseOrgIds": [
              "JHN.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nûû kîrî buî ûûmba kûrikithia atî ndî mwîyia? Këethîra mbaragia ûûma rî, nîkî bûtîkûmbîtîkia? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.46",
            "verseOrgIds": [
              "JHN.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû wonthe ûrîa ûrî wa Mûrungu nî athikagîîra nteto cia Mûrungu. Îndî buî bûtîthikagîîra nteto iu nîûntû bûtî ba Mûrungu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nî aarî o mbere ya Abrahamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Ayahudi baramûcokeria atîrî, “Anga tûtî kuuga ûntû bûrîo rîrîa tûkuuga atî gwe ûrî Mûsamaria na ûrî na roho înthûûku?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.48",
            "verseOrgIds": [
              "JHN.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Jesû arabacokeria, “Ûûni ntî na roho înthûûku îndî nî Baaba ntîîaga îndî buî bûtîntîîaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.49",
            "verseOrgIds": [
              "JHN.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni ntîcwaga gwikumithia ningwa, îndî kûrî we ûrîa ûcwaga gûnkumithia na nîwe ûgambithanagia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.50",
            "verseOrgIds": [
              "JHN.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga nkûbwîra na mma atî muntû wonthe ûrîa waathîkagîra nteto ciaakwa atîkorookua.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.51",
            "verseOrgIds": [
              "JHN.8.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Ayahudi baramwîra atîrî, “Nandî tûkûmenya na mma atî ûrî na roho înthûûku. Abrahamu nî aakuîre, na kinya iroria nî biakuîre, na nî ûkuuga atî, ‘Ûrîa ûkaathîkîra nteto ciaakwa atîkorookua!’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.52",
            "verseOrgIds": [
              "JHN.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ûrî ûmûnene nkûrûki ya Abrahamu, kîûjûjû gîeetû? We nî akuîre na kinya iroria nî biakuîre. Gaûkûthûgaania gwe ûrî ûû?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabacokeria, “Këethîra ga ncwaga gwikumithia, ûkumio bwaakwa nî bwa ûtheri. Baaba o ûrîa buî buugaga atî nîwe Mûrungu weenu, nîwe ûnkumithagia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.54",
            "verseOrgIds": [
              "JHN.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buî bûtamûmenya îndî ni nî mwijî. Nkëeja kuuga ntîmwijî mbîthîrwa ndî mûrongo o ta buî. Ni nî mwijî na nî mwathîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.55",
            "verseOrgIds": [
              "JHN.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîûjûjû kîeenu, Abrahamu nî kîagwîrîrue mono nîûntû nî kîaarî gîkoona ntukû yaakwa. Nî kîamîonere na kîragwîrua mono.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.56",
            "verseOrgIds": [
              "JHN.8.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Ayahudi baramwîra “Ûgwe ûtîkinyîtie mîaka mîrongo îtaano. Îndî nîatîa ûkuuga ûroona Abrahamu?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.57",
            "verseOrgIds": [
              "JHN.8.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arabeera, “Ga nkûbwîra na mma atî mbere ya Abrahamu aciarwa, ni nî ndaarî o.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.58",
            "verseOrgIds": [
              "JHN.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakwigua ûu barooja maiga bamûringa najo îndî Jesû araiciitha na arauma kîûrûûne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.59",
            "verseOrgIds": [
              "JHN.8.59"
            ]
          }
        }
      ]
    }
