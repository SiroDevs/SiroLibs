          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûka mûthûngîîri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jesû areeta kîrîmeene kîa Mîzeituni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rûûneene, rûkîîrî kainda Jesû areeta kîûrûûne kaîrî na antû bonthe bareeta kîrî we, nawe arakara nthî kûbaritana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akîritanaga, aritani ba Waatho na Afarisayo nî baamwikîîrie mûka ûmwe waagwati akithûngagîîra na baramwîka mbere yaawe ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na baramwîra atîrî, “Mûritani, mûka ûûjû aagwatwa akîthûngagîîra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Ala 20.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.22+DEU.22.23+DEU.22.24"
              },
              "items": [
                {
                  "text": "Kûr 22.22-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waatho bwa Musa buugaga atî nî tûbuîri kûûraga mûka ta ûûjû na maiga. A gwe rî, ûriuga atîa?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baugîre ûu nîkenda boona ûntû bwa kûmûthitangîra. Îndî Jesû nî eenamîîrie nthî na araandîka mûthetuune na kîara. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa baamwatîkîre na biûria, Jesû nî ookîîrîre na arabeera atîrî, “Ûrîa weenu ûtî na meeyia, nî aee wa mbere kûmûringa na iiga.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu areenamîîria nthî kaîrî, na araandîka mûthetuune. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa baigîrue ûu, bonthe bareeta ûmwe ûmwe kwambîrîria na barîa akûrû mwanka Jesû aratigwa wenka na mûka ûu arûngi mbere yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Jesû arookîîra na arooria mûka ûu, “Mwekûrû, antû barîa barîkû? Gûtî kinya ûmwe ûtigeere akûgambithia?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûka ûu aracokia, “Mwathani, gûtî we!” Nawe aramwîra, “Kinya ni ntîkûgambithia. Ciîtîre na kuuma nandî ûkéeyia kaîrî.”]",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.11",
              "type": "text"
            },
            {
              "text": "Maandîko jamwe jatî na gîchunchî gîkî.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwe weerû bwa nthîgûrû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
