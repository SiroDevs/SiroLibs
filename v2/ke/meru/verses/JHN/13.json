                "loc": "JHN.7.34"
              },
              "items": [
                {
                  "text": "Joh 7.34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Aana baakwa, ndî naabuî kagiita gagakai. Bûgancwaa; îndî ka mbwîre o ta ûrîa ndeerîre atongeeria ba Ayahudi: ‘Kûrîa mbîtîte bûtîûmba kwîja.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.33",
            "verseOrgIds": [
              "JHN.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
