                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.23"
              },
              "items": [
                {
                  "text": "Joh 3.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.5"
              },
              "items": [
                {
                  "text": "2 Joh 5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nî nkûbûnekera rîathana rîrîerû: Endanageni. O muntû nî eendage ûngî o ta ûrîa ni mbwendeete. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwaakara bwendeene nîrîo antû bonthe bakamenya atî buî bûrî aritwa baakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kuuga atî Peterû akamûkaana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simioni Peterû nî aamûûrîrie, “Mwathani, nîkû wîtîte?” Jesû nawe aramûcokeria, “Kûrîa mbîtîte, ûtîûmba kûnthingata nandî, îndî ûkanthingata nyumeene.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peterû aramûûria, “Nîkî ntîûmba gûkûthingata nandî? Ni nî ncieejanîte kûûragwa nîûntû bwaaku!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû aracokia, “Ûrî na mma nî ûcieejanîte kûûragwa nîûntû bwaakwa? Ga ngûkwîra na mma atî, nchamba ya ngûkû îtîgamba, ûtîrankaana maita jathatû.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        }
      ]
    }
