              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.10",
            "verseOrgIds": [
              "JHN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîkî nîkîo kîama kîa mbere kîrîa Jesû aaringîre arî Kana ya Galili. Nî oonanîrie mwago jwaawe na aritwa baawe baramwîtîkia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
      ]
    },
    {
