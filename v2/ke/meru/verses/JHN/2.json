                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20+EXO.12.21+EXO.12.22+EXO.12.23+EXO.12.24+EXO.12.25+EXO.12.26+EXO.12.27"
              },
