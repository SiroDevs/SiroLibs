              },
              "items": [
                {
                  "text": "15.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû arabeera, “Koborangeni kîûrû gîkî, naani ngaagîaka na mîthenya îthatû.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
            "verseOrgIds": [
              "JHN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Ayahudi barauga, “kîûrû gîkî kîajûkîrie mîaka mîrongo îna na îtantatû gûgîaaka, nagwe nî ûkuuga ûgaagîaka na ntukû îthatû?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        }
      ]
    },
    {
