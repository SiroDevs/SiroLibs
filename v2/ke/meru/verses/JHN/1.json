            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîambîrîriene, nî kwaarî na Rûteto; Rûteto rwaarî na Mûrungu; na Rûteto rwaarî Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kîambîrîria Rûteto rwaarî na Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.2",
            "verseOrgIds": [
              "JHN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Into bionthe biombîrwe na njîra yaawe; gûtî gîntû kinya kîmwe kîombîrwe atî o. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.3",
            "verseOrgIds": [
              "JHN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtûûro buumaga kîrî we, na ûtûûro bûu nî bwaretere weerû kîrî antû. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.4",
            "verseOrgIds": [
              "JHN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weerû bûu bûthaaraga muunduune, naju muundu gûtî rîo jwaabûciinda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
