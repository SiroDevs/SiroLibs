          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, barîa bathangîkagua kûringana na kwenda kwa Mûrungu nî bathithagia ûrîa kwagîrîte na nî bainenkanîîre kîrî Mûûmbi waao ûrîa mwîtîkîkua.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.19",
            "verseOrgIds": [
              "1PE.4.19"
            ]
          }
        }
      ]
    }
