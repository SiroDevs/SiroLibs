              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amwe na ûu, antû ba Israeli bakaa babaingî o ta mûthanga jwa îria, jûrîa jûtîûmba gûtarîka kana kûthimwa. Antû barîa bareetagwa ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "text": " îgiita nî rîîjîte rîrîa bageetwa ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba Juda na ba Israeli bakagwatanîra kaîrî baithuurîre mûnene ûmwe, baume nthîgûrû cionthe irîa baathamîrîtue, tontû ntukû ya Jezereeli îkeethîrwa îrî ntukû înene.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
