              "HOS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa MWATHANI aarîîrie Israeli agîtumagîra Hosea, nî aamwîrîre atîrî, “Îta ûgûre mûka mûmaraya na ûgîe twaana twa ûmaraya nawe. Ûu nou antû ba nthîgûrû îîjî batiganîte na MWATHANI na bakathaathayia mîrungu îngî.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Hosea areeta aragûra Gomeri, mwarî wa Dibilaimu. Gomeri aragîa îu, aramûciarîra kaîjî. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.11"
              },
              "items": [
                {
                  "text": "2Ane 10.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI areera Hosea, “Kae riîtwa ûgeete Jezereeli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.4",
              "type": "text"
            },
            {
              "text": "Jezereeli:",
              "type": "text"
            },
            {
              "text": "nî kuuga nî kagiita gagakai gatigeere mbûkanûkia.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nîûntû nî kagiita gagakai gatîgeere nkanûkia mûnene wa Israeli wa mûciî jwa Jehu, nîûntû Jehu nî ooragîîre antû mono au gwîtagwa Jezereeli. Nkathiria waathani bwa mûciî jwaawe ndeene ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû îîu nkaathirîria mbûûtû cia Israeli kîguuruune kîa Jezereeli.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
