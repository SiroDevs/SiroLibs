            {
              "text": "18.1—20.21; 2Ma 26.1—27.8; 28.1—32.33",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iji nîcio nteto irîa MWATHANI eerîre Hosea mûtaana wa Beeri, o rîrîa mûnene o ûmwe ûmwe wa anene baba aathanaga Juda: Uzia na Jothamu na Ahazi na Hezekia. Îgiita rîu Jeroboamu, mûtaana wa Jehoashi, nîwe waarî mûnene wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwekûrû na aana ba Hosea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
