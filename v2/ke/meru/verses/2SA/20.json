              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu aarî mûtongeeria wa njûûrî ya Israeli, Benaia mûtaana wa Jehoiada nawe aarî mûtongeeria wa Akerethi na Apelethi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoramu aarî mûtongeeria wa antû barîa barîtithagua ngûgî kwa inya. Jehoshafati mûtaana wa Ahiludi aarî mwaandîki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheva aarî karani, Zadoki na Abiathari baarî athînjîri-Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
