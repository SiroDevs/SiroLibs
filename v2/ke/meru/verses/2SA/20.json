          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira ûrîa Mûjairi, aarî mûthînjîri ûrîa wamenyagîîra Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
