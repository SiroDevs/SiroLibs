          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.36",
            "verseOrgIds": [
              "2SA.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Hushai mûcoore wa Daudi arakinya Jerusalemu o rîrîa Abusalomu akinyaga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.37",
            "verseOrgIds": [
              "2SA.15.37"
