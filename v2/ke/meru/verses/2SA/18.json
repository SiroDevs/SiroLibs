          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaria areeta na mbere kuuga, “Ndîona muntû ûrîa ûkûûgîi mbere oogîi ta Ahimaazi mûtaana wa Zadoki.” Mûnene aramwîra, “Ahimaazi nî muntû ûmwega, nî areetaga nteto injega.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
