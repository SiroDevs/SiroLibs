          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaazi arakinya areeta kîrî mûnene araigwîthia nthî aramûkeethia aramwîra, “MWATHANI Mûrungu waaku arokumua, we ûrîa wanenkanîra anthû baaku barîa barakûremeete njareene cia mûnene.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene aramûûria, “Mûthaka ûrîa Abusalomu nî ûmwega?” Ahimaazi aramûcokeria, “Rîrîa Joabu agûntûmaga nî mbonere antû barî na gachagacha îndî ntîmenyere gîtûmi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
