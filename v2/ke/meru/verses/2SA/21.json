              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumeene, nî kwagîîre na ndwaa kaîrî gatîgatî ga Israeli na Afilisti ntûûreene ya Gobu. Sibekai wa kuuma Husha arooraga kîmuntû gîeetagwa Safu ûmwe wa nchiarwa cia imuntû bibinene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
    },
    {
