          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa aamarîrie njûûrî cia Israeli, Jonathani nî aamûûragîre. Jonathani aarî mûtaana wa Shimei. Shimei nawe aarî mûtaana wa ng'ina wa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        },
