          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kaîrî Afilisti bareeta baranyagana kîguuruune kîa Refaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi o kaîrî arooria MWATHANI kîrîra. MWATHANI aramûcokeria atîrî, “Ûgéeta gûtirimana ndweene nabo, îndî bathiûrûke ûbaume bwa nyuma rûteere rûrîa rwerekeene na mîtî ya balisamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa ûkaigua gîtuma kîa makinya kîîjîrîte îgûrû rîa mîtî îîu, rîu umbuthûke, tontû MWATHANI akeethîrwa arî mbere yaaku, kûûra mbûûtû ya Afilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi arathithia o ta ûrîa MWATHANI aamwathîte, araûûra Afilisti kuuma Geba mwanka Gezeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
              "2SA.5.25"
            ]
          }
        }
