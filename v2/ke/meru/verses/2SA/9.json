      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi na mûtaana wa Saûlû ûrîa wetagwa Mefiboshethi",
          "type": "text"
        }
      ]
    },
    {
