        "style": "s1"
      },
      "items": [
        {
          "text": "Ntûmwa ya kîroria Nathani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
