        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.22",
            "verseOrgIds": [
              "2SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Ahithofeli oonere kîrîra kîaawe gîtîrathingatwa, arathuuta ntigiri yaawe aracoka ntûûreene yaao. Akûthûranîra mantû ja nja yaawe, araicuuria arakua. Arathikwa kaburiine ka îthe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.23",
            "verseOrgIds": [
              "2SA.17.23"
            ]
          }
        }
      ]
    },
