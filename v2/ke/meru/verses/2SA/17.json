          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi aakinyîre Mahanaimu, Shobi mûtaana wa Nahashi kuuma ntûûra ya Raba nthîgûrû ya Amoni, na Makiri mûtaana wa Amieli kuuma Lodebari, na Barizilai Mûgileadi kuuma Rogelimu bareta kîrî Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
