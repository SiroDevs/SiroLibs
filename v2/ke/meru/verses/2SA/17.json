            }
          ]
        },
        {
          "text": "Rîrîa Abusalomu na antû baawe baunîre mûuro jwa Jorodani, Daudi nî aarî agûkinya ntûûra ya Mahanaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.24",
            "verseOrgIds": [
              "2SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu nî aarî akweethia Amasa mûtongeeria wa njûûrî antû a Joabu. Amasa aarî mûtaana wa Mûishmaeli weetagwa Ithira. Nawe agûrîte Abigali mwarî wa Nahashi, mwari wa ng'ina wa Zeruia ûrîa waarî ng'ina wa Joabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.25",
            "verseOrgIds": [
              "2SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu na antû ba Israeli baraamba kambî yaao nthîgûrû ya Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        }
      ]
