                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi akuuma kathûmbîîne ga kîrîma kîu, aratirimana na Ziba nthûûmba ya Mefiboshethi. Ziba nî aarî na ntigiri inyiingî mma ciaîkîtue mîgaate magana jaîrî (200), na imanja îgana rîmwe (100) rîa nzabibû injûmo, na imanja îgana (100) bia matuunda na kîgîîna kîûjûri ndibei. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.1",
            "verseOrgIds": [
              "2SA.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Daudi arooria Ziba atîrî, “Nî biambi bibi?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziba aramûcokeria, “Ntigiri nî cia gûkamata antû ba nja yaaku mwathi waakwa, mîgaate na matuunda nî bia kûrîwa nî antû babeethî, na ndibei nî ya barîa bakanoga na kûnyoonta barî rwanda.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.26+2SA.19.27"
              },
              "items": [
                {
                  "text": "2Sam 19.26-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi aramûûria, “Arî kû Mefiboshethi mwana wa Jonathani mûtaana wa Saûlû mwathi waaku?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zîba aramwîra, “Nî aratigîrwe Jerusalemu tontû nî agwîtîkia Aisraeli bakamûcokeria ûnene bwa ûjûûwe Saûlû.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûnene Daudi areera Ziba, “Tega bionthe birîa biraarî bia Mefiboshethi nandî nî biaaku.” Ziba aracokia akiugaga, “Nî nkwinyiiyia mbere yaaku, mwathi waakwa mûnene, ndîrokara nkîonaga wega kuuma kîrî gwe.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shimei kûruma Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi aakinyîre ntûûra ya Bahurimu, muntû ûmwe wa rûrîîjo rwa Saûlû weetagwa Shimei mûtaana wa Gera, araumagara akîrumanaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei arambîrîîria kûgera Daudi maiga, amwe na atongeeria baawe, kinya këethîra aakarîîtue nteere cionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei ararumana akiugaga, “Îta, uma aja îta, mûûragani na mwînyangia! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî atûmîte ûcokerwa nî tharike ya antû ba nja Saûlû barîa wooragîre. MWATHANI nî anenkanîre ûnene kîrî mûtaana waaku Abusalomu, na nandî ûkûthira gwe mûûragani!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Abishai mûtaana wa Zeruia areera mûnene Daudi atîrî, “Nîkî tontû mûnene ûgwîtîkîîria kurû îîjî îkûruma? Mbîtîkîîria mbîte mîng'eere.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi areera Abishai na mûtaana wa ng'ina Joabu, “Îîjî tî ngûgî yeenu buî ataana ba Zeruia. Akëeja kwîthîrwa arînduma nîûntû MWATHANI nî amwîtîkîîrîtie anduma, nûû ûbuîrîte kûûria?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi areera Abishai na atongeeria bangî bonthe atîrî, “Këethîra mûtaana waakwa weengwa nî agûcwa ûrîa ambûraga, a Mûbenjamini ûûjû agacwaa ûrîa ambûragîkia bûng'ana? Tiganeni nawe arumane, tontû MWATHANI nî amwîtîkîîrîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwombîka MWATHANI oomba kûraithîîria mîthangîko îrîa ndî nayo akareeta itharimo antû a irumi bia naarua.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Daudi na antû bau baawe baraciîtîra, nawe Shimei areeta arî rûteere rwa kîrîma akuî nabo akîbageraga maiga, na akîbauragîria tîîri na kûbarumanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene na antû barîa bonthe baarî amwe nawe nî baanogi mono. Tontû bûû, bagûkinya mûuroone jwa Jorodani baranogoka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abusalomu gûkinya Jerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu na antû ba Israeli bonthe barîa baarî amwe nawe o na kinya Ahithofeli nî baakinyîre Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
              "2SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Hushai ûrîa waarî wa kuuma Ariki na waarî mûcoore wa Daudi eetîre kîrî Abusalomu nî aamwîrîre atîrî, “Ûrotûûra matukû jamaingî mûnene! Ûrogîta ûtûûro bûbûraaja mûnene!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu aramûûria, “Gûkû nîku kwîthîrwa ûrî mwîtîkua kîrî mûcoore waaku? Nîkî tontû ûtîreetania na mûcoore waaku” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushai nawe aramûcokeria, “Gûtîûmbîka! Ûûni ngatuîka wa ûrîa ûthuuri nî MWATHANI na antû baba na antû ba Israeli na nkare amwe nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kaîrî rî nûû mbwîrîte gûtumîkîra? Anga tî mûtaana waawe? O ta ûrîa ndîratumîkagîra abaagu, nîu ngagûtumîkagîra.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
