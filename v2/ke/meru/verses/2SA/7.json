          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nandî, gwe MWATHANI Mûrungu, ûroojûria mîciîtio îrîa wanciîtîria ni nthûûmba yaaku na nchiarwa cia nja yaakwa igatûûra mwanka kenya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
