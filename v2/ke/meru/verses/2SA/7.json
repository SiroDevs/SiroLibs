          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo nkuma yaaku îkaigîîgua rîrîa antû bakauga ‘MWATHANI Mûrungu Mweneinya nîwe Mûrungu wa Israeli, na agatûûria waathani bwa nja ya Daudi mwanka kenya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe MWATHANI Mweneinya Mûrungu wa Israeli ndî na ûchamba bwa kûromba nîûntû nî ûguûrîrîte nthûûmba yaaku mantû jaja ûkiugaga, ‘Ngatûûria waathani bwa antû ba nja yaaku.’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        }
