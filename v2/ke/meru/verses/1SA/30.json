    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi kûrwaa na Amaleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi na antû baawe baakinyîre ntûûra ya Zikilagi ntukû ya ithatû kuuma bakwambîrîrîa gûcoka, nî beethîîre Amaleki bakwithûkîra rwanda rûrîa rûrî ûmotho bwa Juda, amwe na ntûûra ya Zikilagi na bamîmuntia mwanki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baarî bagûtaa aka na antû bangî bonthe barîa baarî ku: banene na banini na baraciîtîra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi na asikarî baawe baakinyîre ntûûra ya Zikilagi nî beethîîre ntûûra îu îîthîtue na eekûrû na aarî amwe na ataana baao nî bataaîtue. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Daudi na asikarî baawe bararira na kaajû mwanka baraaga inya ya kûrîra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.42+1SA.25.43"
              },
              "items": [
                {
                  "text": "1Sam 25.42-43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eekûrû ba Daudi bobaîrî; Ahinoamu kuuma Jezereeli na Abigaili ntigwa ya Nabali kuuma Karimeli kinya bo nî baataîtwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nî aarî ûgwatiine bûbûnene nîûntû asikarî baawe barîa baithikîîrîte nîûntû bwa gûtawa kwa eekûrû na ataana na aarî baao, nî beendaga kûmûûraga na maiga. Îndî Daudi araciîkîra inya ndeene ya MWATHANI Mûrungu waawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.20+1SA.22.21+1SA.22.22+1SA.22.23"
              },
              "items": [
                {
                  "text": "1Sam 22.20-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Daudi areetia Abiathari mûtaana wa Ahimeleki, mûthînjîri-Mûrungu, nguû îrîa yaarî ya efodi. Abiathari aramûretera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi arooria MWATHANI atîrî, “Mpîngane na anthû baba? Nkabagwatagwata?” MWATHANI aramûcokeria, “Îî thingatana nabo, ûkabagwatagwata na wonokie atae.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûu Daudi amwe na asikarî magana jatantatû (600) barîa baarî amwe nawe barambîrîria rûgendo. Bagûkinya kamûuroone ka Besori, asikarî magana jaîrî (200) nî baanogi mono bararemwa nî kuuna, tontû bûu baratigwa o. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Daudi amwe na asikarî magana jana (400) bareeta na mbere kûthingatia Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikarî bamwe ba Daudi nî baatirimanîre na muntû ûmwe wa kuuma Misri kûu bûûrîîne na baramwikia kîrî Daudi. Nî bamûrûmîrie mûgaate na baramûkundia rûûjî. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî bamûrûmîrie kinya nkûû inkarange na imanja biîrî bia nzabibû injûmo. Akûthiria kûrîa, aragwata inya, tontû ataarî akûrûma gantû kana akuunda no mbi antû a mîthenya îthatû na mootukû jathatû. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aramûûria, “Mwathi waaku nûû? Uumîte nthîgûrû îrîkû?” Muntû ûu aramûcokeria, “Ni ndî mûthaka wa kuuma Misri na mwathi waakwa nî Mûamaleki. Mwathi waakwa aantîgîre njîreene ntukû ithatû ithirîte ndîkwambîrîria kwajua. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî tûraarî tûkwîthûkîra Akerethi barîa batûûraga rwanda, na twaithûkîra rwanda rûrîa rûrî ûmotho bwa Juda amwe na nthîgûrû ya mwîrîga jwa Kalebu. Twacoka twaîîthia ntûûra ya Zikilagi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aramûûria, “Ûkambikia kîrî aithûki bau?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthaka ûu aramwîra, “Nciîtîria riîtweene rîa Mûrungu atî ûtîmbûragithia, kana ûnenkanîra kîrî mwathi waakwa, naani ngagwikia kîrî aithûki bau.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu arabaikia kîrî aithûki bau. Nabo aithûki bau nî baanyaganîte kunthe bakînyunyaga na kûrîa birîa baataîte kuuma nthîgûrû cia Afilisti na Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na asikarî baawe barabaithûkîra na barabooraga kuuma rûkîîrî kainda mwanka rûûnene ûgoro. Gûtî muntû waao noo ûmwe woonokere tiga nthaka magana (400) jana irîa ciathuutîre nkamîîra iramatûka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aratunyûkia înto bionthe birîa biataîtwe nî Amaleki na aroonokia eekûrû baawe bobaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtî muntû kana gîntû kîaûra, gîkînini kana gîkînene. Daudi nî oonekerie nthaka na aarî na bionthe birîa biataîtwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na asikarî baawe barajûkia ndîîthia cionthe bareeta barî mbere ya Daudi bakiugaga, “Into bibi bitaîtwe nî bia Daudi!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Daudi aracoka kîrî asikarî baawe magana jaîrî (200) barîa baatigi kamûuroone ka Besori tontû nî baagîîte inya ya gwîtania nawe. Nabo baratirimana na Daudi na antû baawe. Daudi arabakeethia agwîrîtue. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî asikarî bamwe barîa baarî babathûûku na ba ûtheri mono barîa baarî bagwîtania nawe barauga atîrî, “Tontû bateetanîrie naatuî, tûtîbagaîra birîa tûtaîre. Nî bajûkie eekûrû baao na aana baao baciîtîre.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi arabeera atîrî, “Ataana ba baaba, bûtîbuîri kûthithia ûu na birîa MWATHANI atûnenkerete. Nîwe ûratûkarîtie na atûma tûûmba barîa baratwithûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî mma gûtî we ûûmba gwîtîkanîîria naabuî mantûûne jau bûkuuga! Antû bonthe barîa beetîre ndweene na barîa baatigîrwe bakarîtie mîrigo bagaanaga into birîa bitai bang'anenie.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi areeka bûu bûrî waatho nabu bûtwîîre bûkîthingatagwa Israeli mwanka naarua tûrî.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi aakinyîre ntûûra ya Zikilagi, nî aatûmanîîre into bimwe birîa biatai kîrî acoore baawe barîa baarî atongeeria ba Juda, akîbeeraga atîrî, “Gîkî nî kîewa kîeenu twabûreetera kuuma kîrî birîa tûrataîte kuuma kîrî anthû ba MWATHANI.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aratûmanîra biewa biu kîrî atongeria ba Betheli na ba Rama barîa baarî bwa ûmotho bwa Juda na kîrî ba ntûûra ya Jatiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî aratûmanîra bingî kîrî atongeeria ba Aroeri na Sigumothi na Eshitemoa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Rakali. Bingî kîrî antû ba ntûûra ya Jerahimeeli na Akeni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kîrî antû ba ntûûra cia Horima na Borashani na Athaki, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Heburoni. Aratûmanîra gûntû kunthe o kîrîa antû baawe baarî.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
            "verseOrgIds": [
              "1SA.30.31"
            ]
          }
        }
      ]
    }
