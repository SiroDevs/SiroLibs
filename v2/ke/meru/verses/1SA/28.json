        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî MWATHANI agakûnenkanîra ûûgwe amwe na Israeli kîrî Afilisti. Rûûjû gwe amwe na ataana baaku, bûkeethîrwa bûrî amwe naani. Nayo njûûrî ya Israeli, MWATHANI akamînenkanîra kîrî Afilisti.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
