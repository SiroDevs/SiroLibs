      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Afilisti baroothûrania njûûrî ciaao cia ndwaa nîkenda barwaa na Israeli. Akishi, mûnene wa Gathi, areera Daudi atîrî, “Nî nkwenda ûmenya atî ûgwe na antû baaku bûkarwaa bûrî rûteere rwaakwa tweeta ndweene.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi areetîkîîria akiugaga, “Ûkoona ûrîa ni nthûûmba yaaku nkathithia.” Akishi aramwîra, “Nî bwega! Naani ngakweethia mûnkaria ûnkaragie mwanka kenya.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saûlû gwîta kûringîrua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
