          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Samueli areeta Rama, na Saûlû araana kwaawe Gibea. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
              "1SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma ntûkû îîu mwanka gûkua gwa Samueli, Samueli atoona Saûlû kaîrî. Îndî we nî aithikîrîîre nîûntû bwa Saûlû. MWATHANI nî airirîre nîûntû bwa kweethia Saûlû mûnene wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        }
