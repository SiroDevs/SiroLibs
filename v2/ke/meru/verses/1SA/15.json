                "loc": "1KI.11.30+1KI.11.31"
              },
              "items": [
                {
                  "text": "1Ane 11.30-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Samueli aagarûkaga aciîtîra, Saûlû aragwata rwambambio rwa Samueli naru rûratambûka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueli aramwîra atîrî, “MWATHANI agûtambûra ûnene bwa Israeli kuuma kîrî gwe kuuma naarua na abûnenkanîra kîrî mûtûûri waaku ûrîa ûrî ûmwega nkûrûki yaaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrungu we ûrîa ûrî ûkumio bwa Israeli atîûmba kwaria ûrongo kana agarûka. We tî muntû auugûka ûrîa augîîte.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
