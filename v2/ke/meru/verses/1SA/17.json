{
  "id": "1SA.17",
  "number": "17",
  "bookId": "1SA",
  "reference": "1Sam 17",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
