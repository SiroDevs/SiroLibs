              "1SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi araciîtîra, aramatûka Saûlû kuuma ntuku îu, areeta kîrî Akishi mûnene wa Gathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.7"
              },
              "items": [
                {
                  "text": "1Sam 18.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.5"
              },
              "items": [
                {
                  "text": "29.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nacio nthûûmba cia mûnene Akishi iramwîra, “Ûûjû tî Daudi mûnene wa nthî Israeli? Ûjû tîwe barainaga mantû jamwegiî bakiugaga,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        }
