              "items": [
                {
                  "text": "Luk 6.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi areeta Nobu kîrî Ahimeleki mûthînjîri-Mûrungu. Ahimeleki araumagara kûmûthagaana agîteetemaga na aramûûria atîrî, “Nîkî tontû ûrî wenka, na gûtî ûngî bûreejania nawe?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        }
      ]
