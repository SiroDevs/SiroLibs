              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aracokeria Ahimeleki mûthînjîri-Mûrungu atîrî, “Mûnene nî ambîrîte ûntû, ambîîra atîrî, ‘Ûkeera muntû kinya ûrîkû ûntû bûû ngûgûtûma ûthithia, bûu ndakwîrîra.’ Naani nî mbîkîte kîatho gîa gûtirimana na nthaka antû ana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.2",
            "verseOrgIds": [
              "1SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî, nîmbi ûrî nayo? Nenkera mîgaate îtaano, kana gîntû kîngî kîrîa ûrî nakîo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Mûrungu aracokeria Daudi aramwîra atîrî, “Ntî na mûgaate jûrîa tûrîîjaga ntukû ingî, îndî kûrî na mûgaate jûmûtheru bunka akî nthaka iu ciethîrwa itîthengereete aka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aracokeria mûthînjîri-Mûrungu aramwîra atîrî, “Tûtîthengereete aka o ta ûrîa wîthîre bweetû bûkari rîrîa twîtîte ndweene. Mîîrî ya nthaka ciaakwa nî îmîtheru, na kinya naarua no ûu nkûrûki.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8+LEV.24.9"
              },
              "items": [
                {
                  "text": "Ala 24.5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu, mûthînjîri-Mûrungu aramûnenkera mîgaate îrîa mîtheru, tontû gûtaarî na mîgaate îngî tiga îrîa yariti antû aatheru nîkenda îngî îrîa îrî na mwanki îîkwa o.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
