            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi aaigîrue Nabali agûkua, arauga atîrî, “MWATHANI arokumua, we ûrîa wandîîria kîrumi kîrîa Nabali aandumîre na andigîîria ni nthûûmba yaawe ntîrathithia ûthûûku. MWATHANI agûkanûkia Nabali tontû bwa ûthûûku bwaawe.” Rîu Daudi aratûmana kîrî Abigaili akîmûûragia ae mwekûrû waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa nthûûmba cia Daudi cieetîre Karimeli kîrî Abigaili baramwîra atîrî, “Daudi atûtûma kîrî gwe nîkenda tûkwîjîra waa mwekûrû waawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigaili arookîîra na arenamîîria na aratiirithia ûthiû bwaawe nthî, arauga atîrî, “Ni nthûûmba yaawe no nthambagie magûrû ja nthûûmba ciaawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.41",
            "verseOrgIds": [
              "1SA.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Abigaili araithuranîra na mpwîî, amwe na aarî batano barîa baamûmenyagîîra. Araitia ntigiriine yaawe areetania nabo athingatîte antû barîa baatûmi nî Daudi, na kuuma rîu araa mûka wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        }
      ]
    },
