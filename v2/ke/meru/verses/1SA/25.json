          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi aracoka aragûra Ahinoamu kuuma Jezereeli nabo bo baîrî baraa aka baawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
