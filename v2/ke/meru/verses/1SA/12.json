                  "text": "Kum 6.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Samueli areera antû atîrî, “MWATHANI nî mûkûûjî, we wathuurîre Musa na Aaroni na ararita biûjûjû bieenu kuuma Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.6",
            "verseOrgIds": [
              "1SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî, rûngameni aja mbere ya MWATHANI naani mbûgambithie, nkîbûririkanagia mathithio jaawe jamaagîru jarîa aabûthithîria na jarîa aathithîria biûjûjû bieenu ja kûbwonokia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.7",
            "verseOrgIds": [
              "1SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.23"
              },
              "items": [
                {
                  "text": "Kum 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Jakubu eetîre Misri na Amisri barainyîîria biûjûjû bieenu, nî biakaîîre MWATHANI na MWATHANI aratûma Musa na Aaroni, barîa babaritîre Misri na baatûma batûûra gûntû gûkû. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.8",
            "verseOrgIds": [
              "1SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.12"
              },
              "items": [
                {
                  "text": "Agam 3.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.2"
              },
              "items": [
                {
                  "text": "4.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî baroorîrua nî MWATHANI Mûrungu waao, nawe arabanenkanîra kîrî Sisera, mûtongeeria wa mbûûtû ya Jabini, mûnene wa Hazori, na kîrî Afilisti na kîrî mûnene wa Moabu, bararwaa nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.9",
            "verseOrgIds": [
              "1SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.10.10+JDG.10.11+JDG.10.12+JDG.10.13+JDG.10.14+JDG.10.15"
              },
              "items": [
                {
                  "text": "Agam 10.10-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu bararîrîra MWATHANI barauga, ‘Nî twîîtie nîûntû nî twîrûkîrîte MWATHANI, twaathîkîra Baali na Ashitarothi. Îndî nandî twonokie kuuma kîrî anthû beetû, natuî tûgakwathîkîra.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.10",
            "verseOrgIds": [
              "1SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.20"
              },
              "items": [
                {
                  "text": "1Sam 3.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.4.6"
              },
              "items": [
                {
                  "text": "Agam 4.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.1"
              },
              "items": [
                {
                  "text": "7.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.29"
              },
              "items": [
                {
                  "text": "11.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI aratûma Gideoni na Baraki na Jefitha na Samueli, nawe arabwoonokia kuuma kîrî anthû beenu nteere cionthe, naabuî bûratûûra kiindajî. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.11",
            "verseOrgIds": [
              "1SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.19"
              },
              "items": [
                {
                  "text": "1Sam 8.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî rîrîa bwonere Nahashi mûnene wa Aamoni eejîte kûrwaa naabuî, nî bwambîrîre atî buî, bûrîenda mûnene wa kûbwathaga, kinya këethîra MWATHANI Mûrungu weenu nîwe waarî mûnene weenu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.12",
            "verseOrgIds": [
              "1SA.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 12:12"
