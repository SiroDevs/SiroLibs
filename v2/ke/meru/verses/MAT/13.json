              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bwa kwaaga wîtîkio kwaao, ataringîre biama bibingî ku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
            "verseOrgIds": [
