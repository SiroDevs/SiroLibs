              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        },
        {
          "name": "verse",
