                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, bararega kûmwîtîkia. Jesû arabeera, “Kîroria kîrî îgweta gûntû kûngî kunthe tîga ntûûreene yaao na mûciî jwaao.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
