                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.11"
              },
              "items": [
                {
                  "text": "Mar 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Luk 3.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Peterû akîaragia o ûu, îtu rîrîerû rîrabakunîkîra, na kajû karaigîgua kaumîte îtuune rîu gakiugaga, “Ûjû nî Mûtaana waakwa ûrîa mpendeete na nî ngwîragua nîwe, mûthikagîîreni.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.5",
            "verseOrgIds": [
              "MAT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritwa bakûigua ûu nî baagwîre nthî na kîuu nîûntû bwa ûguaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.6",
            "verseOrgIds": [
              "MAT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jesû areeta arabaringithia akîbeeraga, “Ûkîîreeni, na bûgákîra.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.7",
            "verseOrgIds": [
              "MAT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa bookîîrîre gûtî muntû ûngî boonere tiga Jesû wenka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.8",
            "verseOrgIds": [
              "MAT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa beenamîte kuuma kîrîmeene, Jesû arabeera, “Bûkéera muntû kinya ûrîkû mantû jarîa bwona kîonekiine kîu, mwanka rîrîa Mûtaana wa Muntû akariûkua kuuma kîrî akuû.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.5"
              },
              "items": [
                {
                  "text": "Mal 4.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu aritwa baramûûria, “Nîkî îndî aritani ba Waatho baugaga atî no mwanka mbere kîroria Elija aambe eeje?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.10",
            "verseOrgIds": [
              "MAT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû aracokia, “Îî bûrio, Elija akamba kwîja mbere nîkenda acokanîîria mantû jonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.11",
            "verseOrgIds": [
              "MAT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.14"
              },
              "items": [
                {
                  "text": "Mat 11.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî ndîbwîra na mma atî Elija nî athirîtie kwîja na antû batamûmenyere na gûtî ûthûûku batamûthithîria. O ûu nîu bakathangîkia Mûtaana wa Muntû.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.12",
            "verseOrgIds": [
              "MAT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu aritwa baramenya atî aaragia nteto ciegiî Johana Mûbatithania.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.13",
            "verseOrgIds": [
              "MAT.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kworia mwana waarî na roho inthûûku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.13",
            "verseOrgIds": [
              "MAT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa baakinyîre kîrî ntundu, muntû ûmwe nî eetîre kîrî Jesû na aramûturîria maru aramwîra, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.14",
            "verseOrgIds": [
              "MAT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwathani, igîrua mûtaana waakwa kîaao! Nî agwatagwa nî mûrimo jwa kîbaba, na akathangîka mono. Nî agwîte mwankiine magiita jamaingî na ringî akagwa rûûjîîne. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.15",
            "verseOrgIds": [
              "MAT.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî mûretere kîrî aritwa baaku îndî batîûmbîre kûmworia.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.16",
            "verseOrgIds": [
              "MAT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arauga, “Îbuî nthuukî îtî wîtîkio na yaangaratanîte! Ngakara naabuî mwanka rî? Ngeteera mwanka rî bûgîa na wîtîkio? Ndetereni mwana ûu aja.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.17",
            "verseOrgIds": [
              "MAT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû aragondokera roho îîu, nayo îrauma kîrî mwana ûu o rîu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
              "MAT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumeene aritwa bareeta kîrî Jesû barî bonka, baramûûria, “Nîkî tuî tûremerwe kwînga roho îîu?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.19",
            "verseOrgIds": [
              "MAT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "Mat 21.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.23"
              },
              "items": [
                {
                  "text": "Mar 11.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1Ako 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû arabacokeeria, “Nîkwîthîrwa wîtîkio bweenu nî bûbûkai. Ndîbwîra na mma atî, bûkëethîrwa bûrî na wîtîkio bûng'ana ta gapîndî ka mûthandûkû, bwoomba kwîra kîrîma gîkî, ‘Kûûka uume aja, na wîte arîa!’ Nakîo gîgaakûûka na gîte. Gûtî ûntû kinya bûmwe bûkabûrema kûthithia. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.20",
            "verseOrgIds": [
              "MAT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho ya mûthemba jûu îtîngîka tiga na njîra ya maromba na gûciata biakûrîa.”]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.21",
              "type": "text"
            },
            {
              "text": "Maandîko jamwe jatî na gîchunchî gîkî.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kwaria kaîrî mantû jegiî gûkua na kûriûka kwaawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritwa bakûthûûrana amwe kûu Galili Jesû arabeera, “Mûtaana wa Muntû agakunyanîrwa na anenkanîrwe kîrî antû. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bakamûûraga, îndî ntukû ya ithatû akariûka.” Aritwa baraigua bûûbûî mono.",
          "type": "text",
          "attrs": {
