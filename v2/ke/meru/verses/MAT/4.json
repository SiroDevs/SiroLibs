                "loc": "MAT.14.3"
              },
              "items": [
                {
                  "text": "Mat 14.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17"
              },
              "items": [
                {
                  "text": "Mar 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.19+LUK.3.20"
              },
              "items": [
                {
                  "text": "Luk 3.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Jesû aigîrue atî Johana nî aingîri ncheera, nî eetîre nthîgûrû ya Galili. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Joh 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nî aumîre Nazarethi na areeta Kaperinaumu, ntûûra îrîa yaarî rûteere rwa îria rîa Galili rîrîa rîaarî mwankeene jwa nthîgûrû ya Zebuloni na Nafutali na arakara ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, rûteto rûrîa rwaarîtue nî kîroria Isaya rûroojûûra:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû gwîta antû bana barîa bagwatagia makûyû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jesû eetîrîte rûteere rwa îria rîa Galili nî oonere antû baîrî ba ng'ina ûmwe bakîgwatagia makûyû bagîtumagîra ngara. Nabo baarî Simioni ûrîa weetagwa Peterû na Anderea. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu arabeera, “Nthîngateni naani nkabweethia agwatia ba antû” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rîo baratiga ngara ciaao, baramûthingata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwîtaîta mbere aroona ataana bangî baîrî ba ng'ina ûmwe. Nabo baarî Jakubu na Johana, ataana ba Zebedii. Nabo baarî gîtarûûne amwe na îthe Zebedii bagîtumaga ngara ciaao cia kûgwatia makûyû, nawe Jesû arabeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baratiga gîtarû amwe na îthe o rîo, baramûthingata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kûritana na kworia antû babaingî",
          "type": "text"
        }
      ]
    },
    {
