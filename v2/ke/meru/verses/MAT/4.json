              },
              "items": [
                {
                  "text": "4.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu Roho aratongeeria Jesû mwanka rwanda nîkenda agerua nî Nkoma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araciata biakûrîa ntukû mîrongo îna, mûthenya na ûtukû. Rîrîa ntukû iu ciathirîre araigua mpara. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Nkoma areeta kîrî we aramwîra, “Ûkëethîrwa nîgwe Mûtaana wa Mûrungu, atha maiga jaja jaee mîgaate.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.3"
              },
              "items": [
                {
                  "text": "Kûr 8.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî Jesû aracokia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kwambîrîîria ngûgî yaawe nthîgûrûûne ya Galili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
