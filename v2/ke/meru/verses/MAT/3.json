                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.15"
              },
              "items": [
                {
                  "text": "Mar 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Irireeni, nîkwîthîrwa ûnene bwa îgûrû bûrî akuî.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Isa 40.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Johana nîwe ûrîa kîroria Isaya aarîrie mantû jamwegiî akiugaga:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûbatithua kwa Jesû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Jesû nî aumîre Galili areeta mûuro jwa Jorodani kûbatithua nî Johana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Johana nî aagererie ûrîa oomba kûrega kûmûbatithia akiugaga, “Gwe nîgwe ûbuîrîte kûmbatithia na rîu nîka wîjîte kîrî ni?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Jesû aramûcokeria, “Reka gûkare ûu nandî, nîûntû ûû nîu tûkoojûria waagîru bunthe.” Rîu Johana areetîkîîria kûmûbatithia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rîu Jesû abaatithua araumîra rûûjîîne na o rîo îgûrû rîrarugûka na aroona Roho wa Mûrungu eenamîte ta kîjea aramûkinya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
