                  "text": "Luk 10.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu areera aritwa baawe, “Maketha nî jamaingî, îndî akeethi nî babakai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
