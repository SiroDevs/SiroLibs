                  "text": "Luk 10.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî ndîbwîra ntukû ya îgamba yakinya, Mûrungu akabûkanûkia nkûrûki ya Sodomu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
            "verseOrgIds": [
              "MAT.11.24"
            ]
          }
        }
      ]
    },
    {
