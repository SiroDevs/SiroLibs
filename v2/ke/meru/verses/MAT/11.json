          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu Jesû aratûmîîria arauga, “Nî ngûgûcokeria nkaatho gwe Baaba, Mwathani wa îgûrû na nthî, nîûntû nî wiithîte mantû jaja kîrî antû barîa boome na mbîjî, na wajaguûrîra antû barîa batî na ûmenyo bûbwingî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe Baaba, ûu nîu wendere gûkarîka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        }
      ]
