              "items": [
                {
                  "text": "Jer 6.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jûkieni gîchooki gîaakwa bwîkîre, na bwiritane kuuma kîrî ni, nîûntû ni ndî ûmûkiri na mwinyiiyia nkoroone, naabuî bûkanogoka nkoroone cieenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa gîchooki gîaakwa nî gîkîûthû, na mûrigo jwaakwa nî jûmûûthû.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.30",
            "verseOrgIds": [
              "MAT.11.30"
            ]
