                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, Mûtaana wa Muntû akeeja arî na araîka baawe barî na mwago kuuma kîrî Îthe, na arîee o muntû kûringana na mathithio jaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
