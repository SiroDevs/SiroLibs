          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî umîthio bûrîkû muntû akoona, këethîra akaa mwene wa into bia nthîgûrû bionthe îndî aage ûtûûro bwa kenya na kenya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
