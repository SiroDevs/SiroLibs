                  "text": "Joh 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa muntû ûrîa ûkeenda kwonokia ûtûûro bwaawe akaûrîrwa nîbu na ûrîa ûgaciata ûtûûro nîûntû bwaakwa akabûtûûria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
