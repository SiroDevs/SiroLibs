      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû kwenda Jesû aringa kîama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
