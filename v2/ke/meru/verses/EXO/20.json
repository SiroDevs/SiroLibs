              },
              "items": [
                {
                  "text": "Kûr 7.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûkámîturîria maru kana ûmîthaathayia; nîûntû ni MWATHANI Mûrungu waaku, ndî Mûrungu ûtîendaga kûng'ananua na mîrungu îngî na nthîngatithagia aana îkaanukîa rîa aciari baao kinya kîrî nthukî ya ithatû na ya inya ya barîa banthûûraga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nî mbigagîîrua kîaao ngiri na ngiri cia barîa bampendaga na bakaathîkîra maathana jaakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
