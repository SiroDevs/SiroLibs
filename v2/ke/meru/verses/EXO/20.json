                  "text": "Josh 8.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûgätua kûmbakagîra kîritîro kîa igongwana kîa iiga, bûgîakage na maiga jatîaji; nîûntû bûkëeja kûjaaja nîka bûkajeekîra mûgiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûgákaga kîritîro kîa igongwana kîrî na nkinyo bûtîkeeje gûturamîra antû.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
