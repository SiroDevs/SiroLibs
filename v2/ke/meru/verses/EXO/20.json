              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Musa atîrî, “Îîra antû ba Israeli ûjû: ‘Nî bwoneete bwingwa atî nî mbarîîtie naabuî kuuma îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkáithithîria mîrungu ya fetha kana ya thaabu bûmîthaathayia na bûcoka bûnthaathayia.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        }
      ]
    },
