            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Musa atîrî, “Nandî ûkoona mantû jarîa nkaathithîria Farao. Ngatumîra inya nîkenda abarekeeria na ntumîre inya kûmûkinyîîria abeenge kuuma nthîgûrûûne yaawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu gwîta Musa",
          "type": "text"
        }
      ]
    },
