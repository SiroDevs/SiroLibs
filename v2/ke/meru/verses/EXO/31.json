        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI athiria kwarîria Musa kîrîmeene gîa Sinai, aramûnenkera tûkongoro twîrî twa maiga jarîa jaandîki maathana ja kîrîkanîro, najo jaandîki na kîara kîa Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
