                "loc": "EXO.35.2"
              },
              "items": [
                {
                  "text": "35.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Ala 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Kûr 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngûgî îritagwe ntukû ithanthatû, îndî ntukû ya mûgwanja nî sabatû ya kûnogoka nayo nî întheru kîrî MWATHANI. O muntû wonthe ûrîa ûkarita ngûgî ntukû ya sabatû nî abuîrîte kûûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, antû ba Israeli bakamenyagîîra sabatû nthukîîne ciaao cionthe îrî kîrîkanîro gîa kenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.11"
              },
              "items": [
                {
                  "text": "Kum 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîyo rwano rwa kenya gatîgatîîne gaakwa na antû ba Israeli rwa kwonania antû MWATHANI oombîre nthîgûrû na îgûrû ntukû ithanthatû na ntukû ya mûgwanja aranogoka.’”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
