          ]
        },
        {
          "text": " Riitho kûrîwa riitho, îîgo kûrîwa na îîgo, njara kûrîwa na njara, kûgûrû kûrîwa na kûgûrû, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
