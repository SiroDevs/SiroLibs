            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe akëeja kûûmba gûûkîîra ageetaîta na mûregi, mûmûringi atîûrua; îndî akamûrîaa îgiita rîrîa amûtereete. Gwakara ûu, amûmenyeere mwanka rîrîa akaabua buru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
