              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kîîrwa kûrîwa na kîîrwa, kîronda kûrîwa na kîronda, kîringîrwa kûrîwa na kîringîrwa.",
          "type": "text",
