            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî muntû akëeja gûcwaa njîra ya kûûraga muntû ûngî na witho, kinya akëethîrwa arî kîritîro kîa igongwana gîaakwa bûkamûrita o bûmûûrage.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
