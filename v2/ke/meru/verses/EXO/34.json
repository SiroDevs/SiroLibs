                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Irio bia mbere buru kîrî maketha jeenu ja mbere kuuma miuundeene yeenu noo mwanka bûkaajareetaga nyomba ya MWATHANI Mûrungu weenu. Ûkarîruga kabûri kana kang'ondu gagwonka.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
