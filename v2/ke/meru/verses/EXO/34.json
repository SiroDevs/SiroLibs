                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûmenyagîîre kwîthagîrwa bûrî na mambura ja maketha; kîa maketha ja mbere ja nkano, na maketheene ja mûthia jwa mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
