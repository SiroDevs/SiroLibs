              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Musa atîrî, “Aandîka nteto iji: kûringana na nteto iji ngwîîka kîrîkanîro naagwe na kinya Israeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nî aakarîre kîrîmeene amwe na MWATHANI ntukû mîrongo îna ûtukû na mûthenya. Nawe ataarîjaga irio kana akunda rûûjî. Nî aandîkîre nteto iu cia kîrîkanîro maigeene jarîa jaîrî, tacio maathana îkûmi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa kwînama kuuma kîrîmeene gîa Sinai",
          "type": "text"
        }
      ]
    },
