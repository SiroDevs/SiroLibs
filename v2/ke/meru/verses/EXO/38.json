              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûthithia kîarago kîa îema rîa gûtirimanîra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie kîarago. Rûteere rwa ûmotho rwathithîtue na nanga itumi bwega cia mita mîrongo îtaano (50m). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio itugî biaarî mîrongo îîrî na biathithîtue na îturutia nîûntû bwa rûteere rûu rwa ûmotho. Îndî biango bia itugî biu na tûrûkuurio twaabio biathithîtue na fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûntû bwa rûteere rwa ûrîo rûrîa rwaarî na ûraaja bwa mita mîrongo îtaano (50m) nî aathithîrie itugî mîrongo îîrî na ikinyithio biaabio mîrongo îîrî bia îturutia. Îndî biango bia itugî na tûrûkuurio twaabio biathithîtue na fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naru rûteere rwa rûgûrû nî rwaarî na nanga cia gûcuurua cia mita mîrongo îîrî na ithaano (25m) na itugî îkûmi, na ikinyithio îkûmi. Nabio biango bia itugî biu na tûrûkuurio twaabio biathithîtue na fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naru rûteere rwa gaiti, ntûrîro ya kîarago kwaarî mita mîrongo îîrî na îthaano (25m). ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio nanga cia rûteere rûmwe rwa mpingîro ciaarî cia mita mûgwanja na nusu (7.5m) na itugî bithatû, na ikinyithio bithatû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu rûteere rûngî rwa mpingîro ya kîarago bwa ûmotho na bwa ûrîo. O rûteere gwacuurîîtue nanga cia mita mûgwanja na nusu (7.5m) na itugî bithatû na ikinyithio bithatû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio nanga cionthe irîa ciacuurîtue kîaragoone ciaarî cia gîtambaa gîtumi bwega mono. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio ikinyithio bia itugî biaarî bia îturutia, îndî biango bia itugî na turukuurio twaabio biathithîtue na fetha. Biûmbwa birîa biaarî îgûrû rîa itugî bierereetue na fetha na itugî bionthe bia kîarago biagwatithanîtue na tûrûkuurio twa fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo nanga îrîa yaingaga mpingîro ya kîarago yatumi na mîtumi bwega na mîrigi ya rangi ya wiirû bwa îgûrû na ya mûkû na întuune. Nayo yaarî na ûraaja bwa mita îkûmi (10m) na mita ijîîrî na nusu (2.5m) gwitia bwa îgûrû kunthe kûthiûrûkîra, kûringana na ûrîa nanga irîa ciacuurîtue kîaragoone ciaakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio itugî bia nanga îîu biaarî bina, na ikinyithio biaabio bina biathithîtue na îturutia, nabio biango biaarî bia fetha, na biûmbwa birîa biaarî îgûrû itugîîne bierereetue na fetha, na itugî biagwatithenue na tûrûkuurio twa fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio biango bia kîarago bionthe bia îema rîa gûtirimanîra kûthiûrûkîra biaarî bia îturutia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chuuma irîa ciatumîîrwe gwaka îema rîa gûtirimanîra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Into bibi bikagwetwa nîbio biatumîkîre kîrî gwaka îema rîa gûtirimanîra, o ta ûrîa biatari maathaneene ja Musa, nîûntû bwa ngûgî ya Alawi batongeeretue nî Ithamari mûtaana wa mûthînjîri-Mûrungu Aaroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezaleli mûtaana wa Uri, Uri mûtaana wa Huri wa mwîrîga jwa Juda, nîwe wathithîrie into bionthe birîa MWATHANI eerîrîte Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûrîa waamûteethagîîria aarî Oholiabu mûtaana wa Ahisamaki kuuma mwîrîgeene jwa Dani, Oholiabu aarî mûtea ûmûnene na mûbangi mîthithîrie ya into, na mûtumi nguû injega na mûtumi agîtumagîra rangi cia wiirû bwa îgûrû, na mûkû na întuune. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo thaabu yonthe îrîa yaatumîkîre mwakoone junthe jwa kîrombero, yaarî talanta mîrongo îîrî na kenda cia thaabu îrîa yariti îrî biewa, na shekeli magana mûgwanja ja mîrongo îthatû kûringana na kîthimi kîa shekeli gîa kîrombero. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
