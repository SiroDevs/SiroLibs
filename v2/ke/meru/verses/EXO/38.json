                "loc": "EXO.30.18"
              },
              "items": [
                {
                  "text": "Kum 30.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nî aathithîrie kîraî kîa îturutia na gîkinyithio gîaakio kîa îturutia, kuumanîa na iciicio bia aka barîa batumîkaga îemeene rîa gûtirimanîra.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
