                  "text": "Kum 30.11-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo fetha îrîa yaumîte kîrî kîûthûrano kîa antû barîa baatarîtwe ûtarine yaarî talanta îgana, na shekeli ngiri îmwe magana mûgwanja ja mîrongo mûgwanja na ithaano kûringana na kîthimi kîa shekeli gîa kîrombero. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
