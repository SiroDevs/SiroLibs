                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ûgátaambia nguutû cia ûrongo. Ûkágwatanîra na muntû ûmûûî ûmûteethia na ûkûûjî bwa ûrongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkáthingata mwingî mathithioone jamathûûku; ningî ûgátujanîîra ûkûûjî bwa ûrongo îgambeene ûgarûra ûûma ûthingateene na mwingî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Ala 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûkéendera muntû nkîa îgambeene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
