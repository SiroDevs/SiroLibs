                }
              ]
            }
          ]
        },
        {
          "text": " “Ûkagiria muntû nkîa mma bûrîa abuîrîte kûthithîrua îgambeene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaga kûraaja na mantû ja ûrongo, ningî ûkooraga muntû ûtî na maatia kana ûmwagîru, nîûntû ntîkarîagîria muntû ûmûûî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkarîjûkia nkukumo nîûntû nkukumo nîka îkunîkaga muntû meetho na ikagiria nteto cia mma ithikîîrwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
