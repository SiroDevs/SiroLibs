            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bwaandage miuunda yeenu îgiita rîa mîaka îtaantatû na bûkethage birîa bikaumaga ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî mwakeene jwa mûgwanja bûrekagîrie miuunda îkanogoka îtîrîmi, nîkenda antû barîa barî na thîîna gatîgatîîne keenu boona biakûrîa na birîa bigatigara birîewe nî nyamû cia kîthaka. Ûu no u bûkaathithagia na miuunda yeenu ya mîzabibû na mîkandamia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
