              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrîo Musa aatambûrûkîrie njara îgûrû rîa îria, nawe MWATHANI areeta ruuo rûrûnene rwa bwa gaiti aratindîka naru îria ûtukû bunthe, aratûma rûujî rwathûkana na îria riaa nthî înjûmo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.1+1CO.10.2"
              },
              "items": [
                {
                  "text": "1Ako 10.1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.29"
              },
              "items": [
                {
                  "text": "Ahi 11.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo antû ba Israeli bareetîîra îrieene gatîgatî nthî înjûmo, rûûjî rûciûmbîte ta rûthingo rûteere rwaao rwa bwa ûrîo na rwa bwa ûmotho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Amisri bareengana na Aisraeli, barakûrûka îrieene gatîgatî babathingatîte, amwe na mbarathi cionthe cia Farao, na ngaarî ciaawe cia ndwaa, na eetithia mbarathi baawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.23",
            "verseOrgIds": [
              "EXO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî akuî gûkîa, MWATHANI arî mwankiine jûrûngi ja gîtugî na îtuune nî eenîkîre meetho nthîgûrû araraithîria njûûrî ya Amisrî, nawe aramîangaratania. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI aratûma magûrû ja ngaarî cia Amisri cia ndwaa jaremwa nî kûthiûrûka iraremwa nî gwîta bwega. Nabo Amisri barauga atîrî, “Twithareni tûmatûke tuume kîrî Aisraeli, nîkwîthîrwa MWATHANI nîwe ûkûbarwîrîîra kîrî Amisri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
      ]
    },
