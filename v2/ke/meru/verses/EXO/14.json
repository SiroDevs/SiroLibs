          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu MWATHANI oonokerie Israeli ntukû îîu kuuma njareene cia Amisri; nayo Israeli nî yoonere Amisri bakuîte barî rûteere rwa îria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Aisraeli boona mantû jamanene jarîa MWATHANI aathithîrîtie Amisri; nabo baramûkîra mono na bareetîkia MWATHANI na nthûûmba yaawe Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
