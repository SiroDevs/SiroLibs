              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya athînjîri-Mûrungu barîa bakeeja akuî na MWATHANI no mwanka baitherie; batîkeeje kumbuthûkîrwa nî MWATHANI.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
