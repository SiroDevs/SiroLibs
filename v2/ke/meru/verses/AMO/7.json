        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî MWATHANI Mûrungu nî aanguûrîîre mantû jaja: Atîrî, ndîroona MWATHANI Mûrungu agîîtaga mwanki jwîja gûkanûkia antû. Naju jûroomia îria rîrînene rîrîa rîrî rungu rwa nthîgûrû na jûrambîrîria gwitia jûkîîthagia nthîgûrû înjûmo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîrauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
