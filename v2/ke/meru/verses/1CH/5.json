                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.3+GEN.49.4"
              },
              "items": [
                {
                  "text": "49.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rubeni mwana wa kîranga wa Jakubu nî aathengereere mûka wa gwîka wa îthe. Tontû bûû, arata kiigai kîrîa mwana wa kîranga abuîrîte kûewa. Kiigai kîu kîanenkanîîrwe kîrî ataana ba Josefu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.8+GEN.49.9+GEN.49.10"
              },
              "items": [
                {
                  "text": "Kîam 49.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî kinya këethîra mwîrîga jwa Juda nî jwagîîre inya nkûrûki ya mîîrîga îrîa îngî na mûnene arauma ku, kiigai kîaarî kîa Josefu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni aarî na ataana bana. Nabo baarî Hanoki na Palu na Hezironi na Karami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji nîcio ciaarî nchiarwa cia Joeli: Shemaia na Gogi na Shimei, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mika na Reaia na Baali na ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2Ane 15.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Beeraha. Beera nîwe waarî mûtongeeria wa mwîrîga jwa Rubeni, na nîwe mûnene Tigilathi-pileneseri wa Asîria aataîre aramwikia kîthamîrioone. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûringana na maandîko ja rûrîîjo jwa Rubeni Jeieli na Zekaria baarî atongeeria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongeeria bangî baarî Bela mûtaana wa Azazi, nawe Azazi aarî mûtaana wa Shema, Shema nawe aarî mûtaana wa Joeli. Antû bau baatûûraga gûntû gweetagwa Aroeri. Naku kwaumaga Nebo mwanka Baali-meoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî baarî na ndîîthia inyingî kûu nthîgûrûûne ya Gileadi. Tontû bûû, nî baarîîthagia nthîgûrûûne îrîa yaarî bwa gaiti ka rwanda mwanka rûteere rwa Eufurate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Saûlû aathanaga, antû ba mwîrîga jwa Rubeni nî baaithûkîîre antû ba Hagiri barîa baatûûraga maemeene rûteere rwa Gaiti ka Gileadi, barabooraga. Rîu barataa nthîgûrû ya Ahagiri îraa yaao.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nchiarwa cia Gadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchiarwa cia Gadi ciaatwîre kuuma nthîgûrûûne ya Bashani mwanka Saleka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joeli nîwe waarî mûtongeeria waao, athingatwa nî Shafamu, Shafamu nawe athingatwa nî Janai. Janai athingatwa nî Shafati. Janai na Shafati nî baarî atongeeria ba mîîrîga îrîa yaarî Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bangî ba ndûgû ciaao barîa baarî atongeeria ba mîîrîga baarî mûgwanja, nabo nî Mikaeli na Meshulamu na Sheba na Jorai na Jakani na Zia na Eberi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana bau mûgwanja baarî ba Abihaili mûtaana wa Huuri, Huurî aarî mûtaana wa Jaroa. Jaroa aarî mûtaana wa Gileadi. Gileadi aarî mûtaana wa Mikaeli. Mikaeli aarî mûtaana wa Jeshishai. Jeshishai aarî mûtaana wa Jahido. Nawe Jahido aarî mûtaana wa Buzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi nîwe waarî mûtongeeria wa mîîrîga îîu. Ahi aarî mûtaana wa Abidieli, Abudieli nawe aarî mûtaana wa Guni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baatûûraga nthîgûrûûne ya Gileadi na Bashani, na tûtûûreene tûrîa twaarî ku. Nthîgûrûûne ya Sharoni nîku baarîîthagia ndîîthia ciaao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongeeria bau baandîkîrwe Yukuune rîa ndûrîîjo îgiiteene rîrîa Jothamu aarî mûnene wa Juda na Jeroboamu aarî mûnene wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî kwaarî na nchamba cia ndwaa ngiri mîrongo îna na inya cia magana mûgwanja na mîrongo îtantatû (44,760). Bau nîbo barîngî gwîta kûrwaa bagîtumagîra rong'o na nchiû na ûta na mîgwî. Nchamba iu ciaumîte mîîrîgeene ya Rubeni na Gadi na nusu ya mwîrîga jwa Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bau baithûkîîre mîîrîga ya Hagiri na Jeturi na Nafishi na Nodabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî baarombere Mûrungu na arabateethia baroombana ndweene nîûntû nî baamwîtîkîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakûboomba ndweene nî baataîre antû ngiri îgana (100,000). Ningî barataa nkamîîra ngiri mîrongo îtaano (50,000) na ng'ondu ngiri magana jaîrî ja mîrongo îtaano (250,000) na barataa ntigiri ngiri ijîîrî (2,000). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî booragîre anthû babaingî, nîkwîthîrwa Mûrungu nî aabateethagia. Rîu barataa nthîgûrû cia anthû bau, na baratûûra ku mwanka rîrîa baataîrwe baraikua kîthamîrioone.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû barîa batûûraga nthîgûrû ya Manase bwa Gaiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nusu ya antû ba mwîrîga jwa Manase nî beetîre gûtûûra nthîgûrûûne ya Bashani na ya Baali-herimoni na ya Seniri mwanka kîrîmeene kîa Herimoni. Antû bau nî baathegeere baraingîa mono. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû baba nîbo baarî atongeeria ba ndûrîîjo ciaao: Nabo nî Eferi na Ishi na Elieli na Azirieli na Jeremia na Hodavia na Jahidieli. Baarî nchamba cia ndwaa na baarî na îgweta mono. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nî beeîîrie Mûrungu wa biûjûjû biaao nîûntû bwa kûthaathayia mîrungu ya mîng'uanano îrîa antû ba nthîgûrû îîu baathaathagia barîa Mûrungu aarî akwînga kuuma ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.25",
            "verseOrgIds": [
              "1CH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
