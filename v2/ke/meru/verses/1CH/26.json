      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alawi barîa baakaragia mpingîro cia kîûrû baagaîrwe ûjû. Kuuma mwîrîgeene jwa Kora kwaarî na Meshelemia mûtaana wa Kore, wa kuuma rûrîîjoone rwa Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana ba Meshelemia baarî mûgwanja. Nabo baathingateene ûjû: wa mbere aarî Zekaria, wa baîrî aarî Jediaeli, na wa bathatû aarî Zebadia, na wa bana aarî Jathinieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na wa bataano aarî Elamu, na wa bataantatû aarî Jehohanani, na wa mûgwanja aarî Eliehoenai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
