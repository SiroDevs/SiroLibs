              "1CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaia mûtaana wa Jehoiada aarî nchamba kuuma Kabuzeeli. Nî aathithîtie mantû jamanene. Bûmwe bwaajo nî kûûraga nchamba ijîîrî cia ndwaa cia njûûrî ya Moabu. Ntukû kwaarî na nkamia, nî eenamîre îriinyeene na arooraga ngatûnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî ooragîre muntû ûmûnene kuuma Misri ûrîa waarî na ûraaja bwa mita ijîîrî na nusu (2.5m). Mûmisri ûu aarî na îtumo rîrînene. Benaia nawe aarî na nchûgûma. Benaia aramwithûkîra aramûtuunya îtumo rîu aramûûraga narîo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jau nîjo mantû jamanene jarîa Benaia mûtaana wa Jehoiada aathithîrie. Najo jaratûma aragîa îgweta o ta nchamba irîa ithatû. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, aragîa îgweta mono kîrî asikarî barîa mîrongo îthatû, îndî rîtakinya rîa asikarî barîa bathatû. Daudi aramweethia muntû wa kûmûkaragia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchamba îngî cia ndwaa cia njûûrî ya Israeli nî iji: Asaheli mûtaana wa ng'ina wa Joabu, ûngî nî Elihanani mûtaana wa Dodo wa kuuma ntûûreene ya Bethlehemu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
              "1CH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shamothi wa kuuma Harodi, na Helezi wa kuuma Peloni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûngî aarî Ira mûtaana wa Ikeshi wa kuuma Tekoa, na Abiezeri wa kuuma Anathothi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.28",
            "verseOrgIds": [
              "1CH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Sibekai wa kuuma Husha, na Ilai wa kuuma Ahohi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.29",
            "verseOrgIds": [
              "1CH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî kwaarî na Maharai na Heledi mûtaana wa Baanaha wa kuuma Netofa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.30",
            "verseOrgIds": [
              "1CH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ithai mûtaana wa Ribai wa kuuma Gibea ya Benjamini, na Benaia wa kuuma Pirathoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
              "1CH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangî baarî Hurai wa kuuma akuî na ndûûjî cia Gaashi na Abieli wa kuuma Arabati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Azimavethi wa kuuma Baharumu, na Eliaba wa kuuma Shaaliboni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.33",
            "verseOrgIds": [
              "1CH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hashemu wa kuuma Gizoni na Jonathani wa mûtaana wa Shagee wa kuuma Harari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî kwaarî na Ahiamu mûtaana wa Sakari wa kuuma Harari na Elifali mûtaana wa Uru, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.35",
            "verseOrgIds": [
              "1CH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Heferi wa kuuma Mekera na Ahija wa kuuma Peloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Heziro wa kuuma Karimeli na Naarai mûtaana wa Ezibai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.37",
            "verseOrgIds": [
              "1CH.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangî baarî Joeli mûtaana wa ng'ina wa Nathani. Mibihari mûtaana wa Hagiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.38",
            "verseOrgIds": [
              "1CH.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Zeleki wa kuuma Amoni, na Naharai wa kuuma Beerothi ûrîa waarî mûkamati wa mathaga ja ndwaa ja Joabu mûtaana wa Zeruia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî kwaarî na Ira na Garebu ba kuuma Ithiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Uria wa kuuma Hiti, na Zabadi mûtaana wa Ahilai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Adina mûtaana wa Shiza wa kuuma mwîrîgeene jwa Rubeni. Adina nîwe waarî mûtongeeria wa asikarî mîrongo îthatû kuuma mwîrîgeene jûu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchamba ingî ciaarî Hanani mûtaana wa Maaka na Joshafati wa kuuma Mithini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Uzzia wa kuuma Ashiterathi, na Shama na Jeieli baarî ataana ba Hothamu ba kuuma Aroeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jediaeli na mûtaana wa ng'ina Joha barîa îthe aarî Shimuri baarî ba kuuma Tizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî kwaarî na Elieli wa kuuma Mahavi, na Jeribai na Joshavia barîa baarî ataana ba Elinaamu, na Ithima wa kuuma Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchamba ingî ciaarî Elieli na Obedi na Jaasieli ba kuuma Mezoba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.47",
            "verseOrgIds": [
              "1CH.11.47"
            ]
          }
        }
      ]
    }
