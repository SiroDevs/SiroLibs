          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka babuîri gûkiraga ki barî kaniseene. Batîtîkîrîtue kwaria, îndî babuîri kwathîka ta ûrîa waatho bwa Ayahudi bûkuuga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beethîrwa barî na ûntû bakwenda kûmenya, nî booragie akûrû baao barî nja ciaao, nîûntû nî nthao mûka kwaria kaniseene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka bûkûthûgaania rûteto rwa Mûrungu nî kîrî buî rwaumîre, kana no bwinka akî bwakinyîîrwe nî rû?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        }
      ]
    },
    {
