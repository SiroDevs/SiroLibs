                  "text": "Afi 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ing'uananagieni naani o ta ûrîa kinya ni nding'uananagia na Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
