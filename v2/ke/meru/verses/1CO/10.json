              "1CO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.12"
              },
              "items": [
                {
                  "text": "1Ako 6.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Antû bamwe baugaga, “Nî twîtîkîîirîtue kûthithia mantû jonthe.” Îndî tî mantû jonthe jarî bata. Kaîrî bakaûga, “Tûrî na rûûtha rwa kûthithia mantû jonthe.” Îndî tî mantû jonthe jagunaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.23",
            "verseOrgIds": [
              "1CO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûkágîta muntû ûcwaa mantû ja kwiguna akî, îndî acwaage jarîa jakaguna antû bangî. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.24",
            "verseOrgIds": [
              "1CO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Womba kûrîa kîonthe kîrîa kîendagua arîa nyama ciendagîrua ûtîgûtinda kûria biûria nîûntû bwa kwigambithia nkoroone yaaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.24.1"
              },
              "items": [
                {
                  "text": "Zab 24.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû nthîgûrû na into bionthe birîa birîku nî bia Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.26",
            "verseOrgIds": [
              "1CO.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûtîtîkîtie Kristû akëeja kûbwîta kîatho kwaawe, na bûgetîkîîria gwîta, rîeeni kîonthe kîrîa bûkanenkeerua bûtîkûûria biûria nîûntû bwa kwigambithia nkoroone. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
              "1CO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî muntû akëeja gûkwîra atîrî, “Biakûrîa bibi birariti birî kîgongwana kîrî mîrungu ya mûng'uanano,” rîu nîûntû bwa muntû ûu na ningî nîûntû bwa kwigambithia nkoroone, ûkábirîa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.28",
            "verseOrgIds": [
              "1CO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiuga nî kwigambithia kwa muntû ûu ûngî. Bwoomba kûmbûûria, “Ee atîa?” Ka ûciathi bwaakwa bûgatongerua nî ûûthû bwa muntû ûngî? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.29",
            "verseOrgIds": [
              "1CO.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Këethîra ncokagîria Mûrungu nkaatho nîûntû bwa biakûrîa biû, nîkî nkûgambithua nîûntû bwa kûbirîa?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waarîa kana wanyua, kana ûntû bunthe bûrîa ûkathithia, thithagia nîûntû bwa ûkumio bwa Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûûraga na mûtûûrîre jûrîa jûtîtûma muntû kinya ûrîkû agitara eethîrwa arî Mûyahudi, kana muntû ûrîa ûtî Mûyahudi kana muntû ûrîa ûrî wa kanisa ya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thithagieni ta ûrîa nthithagia; nî ngeragia kûgwîria antû bonthe mantûûne jonthe jarîa nthithagia. Ntîcwaga ûntû bûrîa bûkanguna ninka îndî ncwaga mantû jaarîa jakaguna antû bonthe nîkenda boonokua.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.33",
            "verseOrgIds": [
              "1CO.10.33"
            ]
          }
        }
      ]
    }
