              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aarî barîa bataathenganîîra na arûme ngiri îkûmi na ithanthatû (16,000). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
