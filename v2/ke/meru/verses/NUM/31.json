              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aarî barîa bataathenganîîra na arûme ngiri mîrongo îthatû na ijîîrî (32,000), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
