          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ng'ombe ngiri mîrongo mûgwanja na ijîîrî (72,000), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
