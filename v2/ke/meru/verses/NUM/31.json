              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba Israeli barîa baarî ndweene baataîre ng'ondu ngiri magana jatantatû ja mîrongo mûgwanja na ithaano (675,000), ",
          "type": "text",
          "attrs": {
