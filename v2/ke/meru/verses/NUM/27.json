                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.5"
              },
              "items": [
                {
                  "text": "Ezek 34.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9.36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mar 6.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû ûrîa ûkaabatongagîîria bagîîta na bakiuma ndweene, nîkenda kîûthûrano gîa antû ba MWATHANI gîtîgakare ta ng'ondu itî na mûrîîthi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.13"
              },
              "items": [
                {
                  "text": "Kum 24.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI areera Musa atîrî, “Jûkia Joshua mûtaana wa Nuni, nîûntû nî muntû ûrî na Roho, naagwe ûmûrîkîîre njara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ûmwîre arûngame mbere ya Eleazari mûthînjîri-Mûrungu na mbere ya kîûthûrano kîonthe, naagwe ûmweethie mûtongeeria bategeete. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ûmwe waatho bûmwe bwa bûrîa ûrî nabu nîkenda kîûthûrano kîonthe gîa antû ba Israeli kîmwathîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Kum 28.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.41"
              },
              "items": [
                {
                  "text": "1Sam 14.41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "28.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nawe akaarûngama mbere ya Eleazari mûthînjîri-Mûrungu ûrîa ûkamwîraga wendi bwa MWATHANI agîtumagîra into bia kûringwa tabio ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "text": ". Nîwe ûkeeraga kîûthûrano gîa antû bonthe ba Israeli ûrîa bakaathithagia.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arathithia ûrîa MWATHANI aamwîrîte, areera Joshua arûngame au mbere ya Eleazari mûthînjîri-Mûrungu na kîûthûrano kîonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
