          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî arîîrie Musa aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îîra antû ba Israeli nî beenge kuuma kambîîne antû bonthe barîa barî na mûrimo jûmûthûûku jwa gîkonde, kana barîa bonthe bakuumwa nî maira kana tharike, na barîa bonthe bagîte mûgiro nîûntû bwa gûtonga kiimba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû bau bëethîrwa barî arûme kana aka no mwanka beengwe baumagarue oome ya kambî nîkenda batîgeekîre kambî ciaao mûgiro kûrîa ntûûraga amwe nabo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû ba Israeli bareenga antû bau, barabaumagaria oome ya kambî, o ta ûrîa MWATHANI eerîte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawaatho jegiî îrîi rîa kûthithiria muntû ûthûûku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
