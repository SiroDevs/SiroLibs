        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bûu nîbu Waatho bûrîa bûbuîrîte kûthingatagwa rîrîa ntomûrûme atîgwîtîkia mwekûrû waawe. Bûthingatagwe rîrîa mwekûrû amaramara na agûri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana rîrîa ntomûrûme atîgwîtîkia mwekûrû waawe. Ntomûrûme ûu agaikagia mwekûrû waawe mbere ya MWATHANI. Nawe mûthînjîri-Mûrungu agaatûmaga mwekûrû ta ûu athingata Waatho bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrûme wa mwekûrû ta ûu atîîthagîrwa arî na maatia, îndî mwekûrû ta ûu agakanûkagua nîûntû bwa meeyia jaawe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
        }
      ]
