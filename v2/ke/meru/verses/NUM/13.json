              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu nawe araboreria antû arabeera atîrî, “Twîteeni o nandî tûkagwate nthîgûrû îîu, nîûntû tûkoomba kûmîtaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        },
        {
          "name": "verse",
