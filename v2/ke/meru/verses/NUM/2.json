          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa atongeeretie nî ya antû ngiri mîrongo îna na îmwe cia magana jataano (41,500). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
