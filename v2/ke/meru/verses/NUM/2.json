          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba mwîrîga jwa Simioni nîbo bakamba maema jaao bathingateene na mwîrîga jwa Rubeni. Mûtongeeria waao akeethîrwa arî Shelumieli mûtaana wa Zurishadai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
