            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Antû ba mwîrîga jwa Zebuloni nîbo bakaamba maema jaao bathingateene na mwîrîga jwa Isakari. Mûtongeeria waao akeethîrwa arî Eliabu mûtaana wa Heloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
