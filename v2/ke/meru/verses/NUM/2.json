          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa atongeeretie nî ya antû ngiri mîrongo îthatû na ijîîrî cia magana jaîrî (32,200). ",
          "type": "text",
          "attrs": {
