              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aarîîrie Musa na Aaroni arabeera atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa antû ba Israeli bakaambaga kambî, o muntû nî aambage îema rîaawe arîa kûrî na rwano rwa mwîrîga jwaao. Maema jaambagwe jathiûrûkîrîte îema rîa gûtirimanîra, na jeerekeene narîo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba mwîrîga jwa Juda nîbo bakaamba kambî yaao rûteere rwa bwa gaiti rwa îema rîa gûtirimanîra, arîa gûkethagîrwa kûrî na rwano rwaao. Nabo bagaatongagîîrua nî Nahashoni mûtaana wa Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa arûngamîrîte nî ya antû ngiri mîrongo mûgwanja na inya cia magana jatantatû (74,600).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        }
      ]
    },
    {
