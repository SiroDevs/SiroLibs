              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa atongeeretie nî ya antû ngiri mîrongo îtaano na ithatû cia magana jana (53,400). ",
          "type": "text",
          "attrs": {
