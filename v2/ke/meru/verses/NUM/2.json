          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa arûngamîrîte nî ya antû ngiri mîrongo îtaano na kenda cia magana jathatû (59,300). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
