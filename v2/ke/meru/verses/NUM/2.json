          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa arûngamîrîte nî ya antû ngiri mîrongo îtaano na mûgwanja cia magana jana (57,400). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bonthe ba mîîrîga îrîa îkethagîrwa yaambîte maema jaao arîa gûkethagîrwa kûrî na rwano rwa mwîrîga jwa Juda nî antû ngiri îgana rîa mîrongo înaana na ithanthatû cia magana jana (186,400). Bau nîbo bageetaga barî mbere.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
