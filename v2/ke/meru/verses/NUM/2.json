          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njûûrî îrîa akeethîrwa arûngamîrîte nî ya antû ngiri mîrongo îna na ithanthatû cia magana jataano (46,500). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
