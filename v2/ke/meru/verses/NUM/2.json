          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Alawi baatátaranîîrue amwe na antû bangî ba Israeli o ta ûrîa MWATHANI eerîte Musa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
              "NUM.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
