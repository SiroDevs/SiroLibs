          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, na Aaroni amwe na antû bau mariîtwa jaao jagweti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nî boothûranîrie kîûthûrano kionthe kîa antû ba Israeli kûrî ntukû ya mbere ya mweri jwa îîrî. Nabo baraandîka mariîtwa ja arûme barîa baarî na ûkûrû bwa mîaka mîrongo îîrî na nkûrûki, o muntû o muntû kûringana na mûciî jwaao na mwîrîga jwaao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arabatara barî rwanda rwa Sinai, o ta ûrîa MWATHANI aamwîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
