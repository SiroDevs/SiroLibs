          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kîrî nchiarwa cia Rubeni, ûrîa waarî mûtaana wa mbere wa Jakubu, arûme bonthe barîa baarî na ûkûrû bwa mîaka mîrongo îîrî na nkûrûki, barîa barîîngî gwîta ndweene, nî baandîkîrwe mariîtwa jaao, o muntû o muntû kûringana na mûciî jwaao na mwîrîga jwaao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arûme bau ba mwîrîga jwa Rubeni baarî antû ngiri mîrongo îna na ithanthatû cia magana jataano (46,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
