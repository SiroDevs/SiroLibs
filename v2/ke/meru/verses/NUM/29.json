              "type": "text"
            }
          ]
        },
        {
          "text": "“Kûrî ntukû ya inyaanya bûûthûranage bûnthaathagie ni Mûrungu, na bûkáritaga ngûgî ntukû îîu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.35",
            "verseOrgIds": [
              "NUM.29.35"
            ]
          }
        },
        {
          "name": "verse",
