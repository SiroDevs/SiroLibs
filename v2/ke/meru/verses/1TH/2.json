              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû buî bwingwa ataana na aarî ba baaba nî bwijî atî kwîja gweetû kîrî buî gûtaeere kwa ûtheri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
