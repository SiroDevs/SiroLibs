                  "text": "18.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bo nîbo booragîre Jesû na iroria, na nîbo baatwîngîre tûrauma kûu. Nî baaigithîrie Mûrungu bûbûûî bakîrûjaga na antû bangî bonthe, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na barageria gûtûrigîîria gûtûmîîria kîrî antû barîa batî Ayahudi nîkenda boonoka. Baathithagia ûu ta antû bakûgeria kûjûrîîria mûng'ana jwa meeyia jaao jarîa baatwîre kûthithia. Îndî nandî mûthûûro jwa Mûrungu nî jûthirîtie kûbakinyîra.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paûlû kwirîrîria kûriûngîra Athesalonike kaîrî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
