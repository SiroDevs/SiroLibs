          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyeni nî kuuma kîrî Mwathani bûkoona rûgai rûrî îtuui rîeenu. Buî nî Kristû Mwathani bûtûmîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
