              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngûgî kinya îrîkû îrîa bweei bûrita, mîritageni bûrî na wîru teeka bûkûritîra Mwathani na tî antû bûkûritîra. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
