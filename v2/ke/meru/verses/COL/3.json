            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1Pet 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Buî eekûrû, inyiiagieeni kîrî akûrû beenu, o ta ûrîa kwagîrîte mbere ya Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Aef 5.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.7"
              },
              "items": [
                {
                  "text": "1Pet 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naabuî akûrû, endageni eekûrû beenu na bûkábainyagîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.1"
              },
              "items": [
                {
                  "text": "Aef 6.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naabuî aana, athîkagîreeni aciari beenu mantûûne jonthe tontû ûntû bûu nîbu bûgwîragia Mwathani.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.20",
            "verseOrgIds": [
              "COL.3.20"
            ]
          }
        }
      ]
