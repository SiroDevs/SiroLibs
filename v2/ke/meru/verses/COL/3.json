                  "text": "Aef 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naabuî nkombo, athîkagîreeni barîa babwathaga mantûûne jonthe. Bûkáthithagia ûu akî rîrîa babûtegeete rîonka teeka bûgûcwa gûciendithia kîrî bo; îndî thithagieni ûu na nkoro yonthe nîûntû bwa gûkîra Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.22",
            "verseOrgIds": [
              "COL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
