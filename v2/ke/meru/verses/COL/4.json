              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rombageni Mûrungu magiita jonthe bûtîkûnoga na bûkarage bûciûki ndeene ya maromba na bûgîcokagîria Mûrungu nkaatho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûrombagîreni kinya tuî nîkenda Mûrungu agatwonera kaanya gakeega ga gûtambia rûteto rwegiî witho bwa Kristû. Kîu nîkîo gîtûmîte mbîthîrwa ndî ncheera nandî. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, ndombereni nîkenda nkaaria o ta ûrîa mbwîrîte kûthithia nîkenda rûteto rûu rûkamenyekana carûrûkû.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        }
      ]
    },
