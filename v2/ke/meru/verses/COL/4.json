              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûtaana wa baaba ûmwende, Tukiko, ûrîa ûrî mûriti ngûgî mwîtîkîkua na ûmwe weetû kîrî ngûgî ya Mwathani, akabwîra mantû jaakwa jonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkîo gîtûmi ndamutûma nîkenda akabûmenyithia ûrîa tûrî na abûmîrîria. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Fil 10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bakeejania na Onesimo, mûtaana wa baaba ûrîa mwende na mwîtîkua na ûrîa ûrî ûmwe weenu. Bakabwîra mantû jonthe jarîa jakarîkîte naaja tûrî.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
