              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tûûrageni na ûûme rîrîa bûrî na antû barîa batî ba mûûrû jweenu na bûtumagîre o kaanya karîa bûroona bwega. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwaria rweenu nî rwîthagîrwe rûrî rûrwega na rûmaarîri nîkenda bûûmba gûcokeria o muntû wonthe ûrîa kwagîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
