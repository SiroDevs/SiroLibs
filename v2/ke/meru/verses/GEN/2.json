              },
              "items": [
                {
                  "text": "Kum 20.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntukû ya mûgwanja Mûrungu nî aarî akûthiria ngûgî yaawe îrîa aaritaga. Ntukû îîu ya mûgwanja aranogoka kuuma kîrî ngûgî îrîa aaritaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Mûrungu aratharima ntukû îîu ya mûgwanja na aramîathûra, nîkwîthîrwa nîyo aanogokere kuuma kîrî ngûgî îrîa aaritaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûjû nîu mantû jaathingatanîre rîrîa îgûrû na nthî bioombagwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munda jwa Edeni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
