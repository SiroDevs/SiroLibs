        },
        {
          "text": "Nabo Aisraeli nî baatûûrîre kûu Gosheni nthîgûrû ya Misri. Baragîa na into bibingî ku na baraciarana na barathegea mono. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
