                  "text": "50.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Israeli aarî akuî gûkua nî eetîre mûtaana waawe Josefu aramwîra atîrî, “Këethîra nî ûkwona mbagîrîte nandî îkîra njara yaaku gatîgatî ka bieero biaakwa ûkaambathîkîra na ûtîngarûka. Itû menya wîja kûnthika Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî ûnthike kûrîa ba baaba bathiki. Ûnkamate kuuma Misri ûkaanthike antû arîa baathikanaga.” Josefu aramûcokeria arauga, “Nkaathithia o ûu wauga.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 47:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe aramwîra atîrî, “Ciîtie.” Josefu aramûciîtîria. Israeli aracokia nkaatho arî au gîtandeene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.31",
