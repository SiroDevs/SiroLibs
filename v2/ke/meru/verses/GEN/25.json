              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakubu aramwîra atîrî, “Mbere mpenderia kiigai gîaaku kîa ûrikithathi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
