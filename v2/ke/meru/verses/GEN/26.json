          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ntukû îîu, nthûûmba cia Isaaka nî cieejîre îramwaa nteto cia kîthima kîrîa cieenjîte, iramwîra atîrî, “Tûkwona rûûjî!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe areeta kîthima kîu Shiba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26.33",
              "type": "text"
            },
            {
              "text": "Shiba:",
              "type": "text"
            },
            {
              "text": "nî kuuga “Mûciîtio” kana “Mûgwanja.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kîu nîkîo gîtûmi ntûûra îîu îtagwa Beerisheba",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26.33",
              "type": "text"
            },
            {
              "text": "Beerisheba:",
              "type": "text"
            },
            {
              "text": "nî kuuga “kîthima kîa mûciîtio kana kîthima kîa mûgwanja.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwanka nandî.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
