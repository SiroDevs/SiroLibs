              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaû aakinyia mîaka mîrongo îna, nî aagûrîre mûka ûgwîtwa Judîthi, mwarî wa Mûhiti weetagwa Beeri. Ningî aragûra Basemathi, kinya we, mwarî wa Mûhiti weetagwa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
