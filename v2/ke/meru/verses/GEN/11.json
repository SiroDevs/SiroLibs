              "type": "text"
            }
          ]
        },
        {
          "text": "Aripakishadi aakinyia mîaka mîrongo îthatû na îtaano (35) nîrîo aagîîre na mûtaana waawe Shela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya kûgîa na Shela, Aripakishadi aratûûra mîaka magana jana na îthatû (403). Ningî nî aarî na ataana bangî na aarî.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
