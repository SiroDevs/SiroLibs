        "style": "s1"
      },
      "items": [
        {
          "text": "Nchiarwa cia Tera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
