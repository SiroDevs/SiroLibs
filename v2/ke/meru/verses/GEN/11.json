          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera nî aajûkîrie mûtaana waawe Abramu na Loti mwana wa mûtaana waawe Harani, na Sarai mwekûrû wa mûtaana waawe Abramu, barauma ntûûra ya Uru îrîa yaarî nthîgûrûûne ya Ababiloni, beetîte nthîgûrû ya Kanaani. Îndî bagûkinya ntûûra ya Harani, baratûûra ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera aakuîrîîre kûu ntûûra ya Harani arî na ûkûrû bwa mîaka magana jaîrî na îtaano (205).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
