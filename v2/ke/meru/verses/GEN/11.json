              "type": "text"
            }
          ]
        },
        {
          "text": "Tera agûkinyia mîaka mîrongo mûgwanja (70) nî aagîîre na ataana beetagwa Abramu, na Nahori, na Harani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
