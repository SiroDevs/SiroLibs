{
  "id": "ACT.5",
  "number": "5",
  "bookId": "ACT",
  "reference": "Maj 5",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
