          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûnene Agripa, na mûrûngamîîri na Baanice amwe na antû bangî bonthe barîa baakari nthî au bararûngama ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bakuireba barauga, “Gûtî u muntû ûûjû athithîtie bwa gûtûma ooragwa kana atheekwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Agripa areera Festasi, “Muntû ûûjû arîngîthaûrwa tiga ûrîa aaugîre îgamba rîaawe riikue kîrî Kaisarî.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
            "verseOrgIds": [
              "ACT.26.32"
            ]
          }
        }
      ]
