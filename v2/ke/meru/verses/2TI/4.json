                  "text": "1Tim 1.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûturi ûrîa wîtagwa Alexanda nî anthithîîrie mantû jamathûûku mono. Mwathani nîwe ûkamûrîaa kûringana na mathithio jaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imenyagîîre kîrî we tontû nî aareganîre na inya mono nteto irîa twatûmagîîria.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
