        },
        {
          "text": " Ntigi na Luka akî. Cwaa Maariko bwîjanie nawe tontû eeja aganteethia mono. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
