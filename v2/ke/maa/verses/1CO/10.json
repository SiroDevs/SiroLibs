                {
                  "text": "Enki 21.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimikitem iyiook Olaitoriani, anaa enaikuna apa kulikae lenye, nemut ilasuriaa lelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.41+NUM.16.42+NUM.16.43+NUM.16.44+NUM.16.45+NUM.16.46+NUM.16.47+NUM.16.48+NUM.16.49"
              },
              "items": [
                {
                  "text": "Enki 16.41-49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eming'unyung'uny anaa enaikuna kulikae lenye, lelo apa ooidaikie Olmalaika Omutisho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.10",
            "verseOrgIds": [
              "1CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eineputua ninche nena pooki pee eaku enkikoo, netisiraki pee eikoki iyiook aarishie, ilaa te nkata ang eitabayioki nkatitin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
