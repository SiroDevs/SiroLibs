              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netonita apa Elisha te nkaji enye, netonita ilpayiani tenebo ninye. Neirriwayie apa olaiguanani oltung'ani, kake ore eton eitu ebaiki ilo kilikuai Elisha, nejoki Elisha lelo payiani, “Idolidolo aajo eirriwua ele oitayu iloikop oltung'ani laalotu adung'oo endukuya? Eng'orisho ore ake pee elotu ilo kilikuai ninkenikene kutukaji, nimbung'ubung'u enkikenet e kutukaji aaibooyo ninye. Aimening'o oltoilo loo nkejuk olkitok lenye te siadi ninye?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eton eirorita ninye o lelo payiani, nedou olaiguanani alotu enetii ninye, nejoki, “Ore ena nyamali naa Olaitoriani eing'uaa! Kainyoo nanu pee aitoki aanyu Olaitoriani?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
