              "attrs": {
                "loc": "1CH.7.23+1CH.7.24+1CH.7.25+1CH.7.26+1CH.7.27+1CH.7.28+1CH.7.29+1CH.7.30+1CH.7.31+1CH.7.32+1CH.7.33+1CH.7.34+1CH.7.35+1CH.7.36+1CH.7.37+1CH.7.38+1CH.7.39"
              },
              "items": [
                {
                  "text": "1 Int 7.23-39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.2+2KI.4.3+2KI.4.4+2KI.4.5+2KI.4.6"
              },
              "items": [
                {
                  "text": "2 Ilai 4.2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nedung olaiguanani nena kitotoneta enkitashoto, neiwuang'ie ilo moti oitukuoreki aitung'uaa ninche, neiwuang'ie ilo moti le nkare aitung'uaa lelo mong'i ooitobiruno to suyai apa ootii tiabori, neiteleiki ninye isoito. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ine wueji apa neitobiraki te nkaraki sabato, tiatua enkaji o laiguanani, oina kishomi e auluo o laiguanani, neiwuang'ie ninye tiatua enkaji o Laitoriani, te nkaraki ilo aiguanani le Asiria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa nkulie kiaasin e Ahas naataasa eigeroki tiatua embuku oo ntepen oo laiguanak le Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Isa 14.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neirura Ahas etua anaa apa loo menye, nenukari ninye tenebo loo menye tiatua enkanasa e Daudi; neitoreisho Hesekia olayioni lenye te rishata enye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
