              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedumunye taa Senakerib olaiguanani le Asiria alo ang, nelo abik te Ninawi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
