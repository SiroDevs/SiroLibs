              "attrs": {
                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Saka 14.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naaitoki aitodol nanu olkeju le nkare e mpuaan, owang anaa oltotoi orukunye aing'uaa olorika le nkitoo le Enkai o lo Kuoo le Ker. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Enk 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.12"
              },
              "items": [
                {
                  "text": "Esek 47.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neruko aim empolos enkoitoi nalala e ina anasa. Ore sii too lkekuno pokira leilo keju netii ilo shani le mpuaan te nebo o mpukunot tomon o aare oo lng'anayio lenyena. Neiu ake to lapa lelo ng'anayio lenyena; ore imbenek e ilo shani naa ninche naaishiunye iloreren. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Saka 14.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nemeitokini ae kata aata hoo toki nadiaa, kake ilo orika le nkitoo le Enkai o lo Lkuoo le Ker, ninche kenya ootii atua ine, naa keserem ninye isinkan lenyena; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa Kedol ninche enkomom enye, ore inkarn enye netii ilpurai loo nkomomi enye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.18"
              },
              "items": [
                {
                  "text": "Dan 7.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nemeitokini ai kata aata enkewarie nemeetayie ninche tipat ewang'an o ltaa aashu ene nkolong, amu Olaitoriani Enkai oaku ewang'an, naa keitoreisho ninche intarasi ontarasi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elotunoto e Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki ninye nanu, “Keisiligayu nesipa kulo rorei. Naa Olaitoriani Enkai o nkiyang'eta oo loibonok le Enkai nairriwua olmalaika lenye meitoduaa isinkan lenyena nena nemeeta nchere pee eitu epuonu aasieku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ng'ura, kalotu asioku.” Emayiana ilo oibung ororei le naibon e na buku.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu Yohana ilo otoning'o nadol kuna baa, Ore ake pee aning nadol ninche, nabatata too nkejek e ilo malaika laaitoduaa ninche aserem ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake aatiaaka ninye nanu, “Mintoki aiko neijia! Ara nanu osinka te nebo iyie o lalashera linono lelo oibonok le Enkai, o lelo ooibung irorei le na mbuku. Enkai teserema.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki ninye nanu, “Minuk irorei le naibon e na buku, amu etinyikua enkata. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.10"
              },
              "items": [
                {
                  "text": "Dan 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Inchoo olarruoni eton aas enkarrueisho, nchoo oloiduruk eton eiduruk, nchoo osupat eton aas isupati. Neton osinyati aa sinyati. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.10"
              },
              "items": [
                {
                  "text": "Isa 40.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.11"
              },
              "items": [
                {
                  "text": "62.11",
