              "items": [
                {
                  "text": "48.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ara nanu Alfa o Omega, ole dukuya o le siadi, enkiterunoto o enkiting'oto.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
