                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.28.4"
              },
              "items": [
                {
                  "text": "Olke 28.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.10"
              },
              "items": [
                {
                  "text": "Yer 17.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ng'ura, kalotu asioku naata olekoisiaayio lai te nebo nanu, pee alaaki pooki ng'ae anaa anataasa ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
