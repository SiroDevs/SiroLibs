        },
        {
          "text": "Ore te siadi ena nadol likae malaika edou aing'uaa shumata neeta enkidimata sapuk, neitawang'i enkop te ina sikar enye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
