                }
              ]
            }
          ]
        },
        {
          "text": " Nedumu olmalaika ogol osoit kitok laaijo oloiwutuutishoreki nenang aki atua enaiposha nejo, “Neijia eikunakini Babilon kitok ina ang kitok esuluni enkop te ngolon, meitokini ae kata aatum; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        },
