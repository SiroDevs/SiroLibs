                "loc": "PRO.8.22"
              },
              "items": [
                {
                  "text": "Ndung 8.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naa ore to lmalaika le sirit natii atua Laodikea, ingeroki, ‘Irorei le ilo oji Esai, Oloisiligayu naa olchakeni osipa, naa ninye enkiterunoto e nkitobirata naitobira Enkai seuseu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ayiolo nkiaasin inono. Mirobi iyie nimirowua, oi imut airopiju aashu irowuaju. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.15",
            "verseOrgIds": [
              "REV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ore amu imololong, mirobi nimirowua, ekaanotu aitayu te nkutuk ai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.16",
            "verseOrgIds": [
              "REV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ijo iyie, Kara nanu karsis, atudupe, malau toki. Nimiyiolo iyie ajo ira menati, ira tolut, nira olaisinani modooni niminchopo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.17",
            "verseOrgIds": [
              "REV.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
