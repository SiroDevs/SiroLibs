    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enikinko pee kintiship Enkai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchoo enyorrata oo lalashera ebikoo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.1+GEN.18.2+GEN.18.3+GEN.18.4+GEN.18.5+GEN.18.6+GEN.18.7+GEN.18.8+GEN.18.9"
              },
              "items": [
                {
                  "text": "Enk 18.1-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3"
              },
              "items": [
                {
                  "text": "19.1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Emintololoiki enkitoomono oo lomon amu te ina eitoomono apa kulikae ilmalaika meyiolo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.2",
            "verseOrgIds": [
              "HEB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entadamu lelo ootii korokoroni, anaa eitii korokoroni te nebo ninche, o lelo ooinyali, amu itii sii intae atua ilo sesen. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchoo eyanyiti enkiyama ti atua iltung'ana pooki naa emincho ina rruat e nkiyama eisarkionieki; amu Enkai naiguanare lelo ooibor onyek o loololoito.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
