              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eikiyiolo ilo otejo, “Enaai elap, nanu oitalaku.” Nejo sii, “Olaitoriani oiguanare iltung'ana lenyena.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entoki naitureisho ti nibatatakino inkaik e Enkai naishu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
