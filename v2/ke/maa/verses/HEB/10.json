                  "text": "Ena 24.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ijo kebaa elusoo enkitamioto nayaki kewan oltung'ani oany Oinoti le Enkai, neisarkionie osarge lo sotua laa ninye eitukuyieki neitagor ina Kiyang'et e mpiris? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
