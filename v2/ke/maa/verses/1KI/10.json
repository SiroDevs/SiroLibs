        "style": "s1"
      },
      "items": [
        {
          "text": "Emutanata e nkaiguanani e Sheba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
