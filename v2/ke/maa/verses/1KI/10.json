          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitaa olaiguanani enkosholai entoki nalelek tumoto te Yerusalem, neitotiu anaa isoito, ore iltarakua nebayu anaa ilkeek lo lpurkel. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
