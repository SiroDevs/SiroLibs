              "items": [
                {
                  "text": "Enkig 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore apa imbartan e Solomon naa Misiri eing'uaa o Kilikia. Ore lelo ooinyiang'u engarri oo mbartan te Misiri te shekeli iip uni e nkosholai, ore embarta naa te shekeli iip o onom; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
