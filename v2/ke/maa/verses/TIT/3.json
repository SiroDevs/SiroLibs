                  "text": "2 Tim 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Te nairriu nanu Atemas aashu Tikikos meeu enitii, tonyuaa oleng, wou ene natii te Nikapolis, amu atudung'o pee aton te ine te nkata e nkirobi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Iat 18.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.12"
              },
              "items": [
                {
                  "text": "1 Ilkor 16.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tonyuaa isosionie Senos, ilo loo nkitanapat o Apolos te lototo enye; nimincho eng'oriki hoo toki. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa nchoo iltung'ana lang meitamoo ate nkiasin sidain, pee eretu nkolati naarrish nemeaku ilemeeta ilng'anayio.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
