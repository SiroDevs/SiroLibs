                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulo o Silvano, o Timoteo, Enetii esirit oo Lsesalonike e Enkai Papa lang o Laitoriani Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa eninyi empiris o eseriani naing'uaa Enkai Papa o Laitoriani Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkiguana te lotunoto e Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeta inchere pee mikincho Enkai enashe inkatitin pooki te nkaraki intae ilalashera, anaa enaishiaakino amu ebulu oleng enkirukoto inyi, ore enyorrata e pooki ng'ae te intae to likae o likae neponari. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkaraki aikiwuasare iyiook intae maate ti atua nena sirito e Enkai te nkitashoto inyi nemeiwuatiwuata o enkirukoto ti atua inkisilisilot inyi pooki, o ti atua isinaitin ling'iriri taata.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olmonekie ele le nkiguana nasipa e Enkai, pee etumi aaitaa intae ilooishiaakino enkitoria e Enkai naa te ninye eisilisilitoi intae ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te nkaraki natoduaa Enkai inchere esipata te nelaaki te nkisilisiloto lelo ooisilisilito intae, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.6",
            "verseOrgIds": [
              "2TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "neisho intae ilooisilisiloki enkiyeng'iyeng'ata te nebo iyiook, te ina kata naibalunyeki Olaitoriani Yesu Kristo eing'uaa shumata te nebo ilmalaika lenyena magil, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti atua enkima nayupuyup neyau enkitamioto e nkitalaata shumata kuldo lemeyiolo Enkai, o shumata kuldo lemening Ilomon Supati lo Laitoriani lang Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.8",
            "verseOrgIds": [
              "2TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.10"
              },
              "items": [
                {
                  "text": "Isa 2.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu keitamei te mutata oo ntarasi nekepari aaitalam enetii Olaitoriani o enetii enkitoo e nkidimata enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nelotu ninye te ina olong pee eitaai kitok ti atua isinyat lenyena pee eing'asiakinoi ninye te atua lelo pooki ooiruko, amu ore shakenisho ang te intae neirukoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina pee kiomonoki oshiaake intae, pee eitaa intae Enkai ang ilooishiaakino te nkipototo enye, neitabaya pooki bae sidai o esiaai enkirukoto te ngolon enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.11",
            "verseOrgIds": [
              "2TH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pee aa ore enkarna o Laitoriani lang Yesu, neisisi ti atua intae, neisisi intae tiatua ninye, te risioroto e mpiris e Enkai ang o Laitoriani Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.12",
            "verseOrgIds": [
              "2TH.1.12"
            ]
          }
        }
      ]
    }
  ],
