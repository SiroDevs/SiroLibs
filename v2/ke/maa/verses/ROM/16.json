          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Metaa te nebo intae empiris o Laitoriani lang Yesu Kristo. Esai.]",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        }
      ]
    },
    {
