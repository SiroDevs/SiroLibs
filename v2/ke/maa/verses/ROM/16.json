              },
              "items": [
                {
                  "text": "2 Tim 4.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eiroroki sii intae Gayo laa enkaji enye atii, o Erasto olashumani le nkanasa, o lalashera lang Kuarto. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
