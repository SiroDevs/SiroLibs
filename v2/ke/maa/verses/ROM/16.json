                  "text": "Iat 16.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eiroroki intae Timoteo, laaisiritore te siai; naa neijia etiu Lukio o Yason o Sosipater oora le mudong lang.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu Tertio, olaigeroni le na palai, oiroroki intae ti atua Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        }
      ]
    },
