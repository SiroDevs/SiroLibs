            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Netabuaa Isaya ajo ti alo Siraeli: “Ore hoo neba nkera e Siraeli anaa osinyai le naiposha, oloti pisiai ake eitajeuni ti atua ninche; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu keitabaiki Enkai enkop enkiguana natudung'oko asioki o te ngolon.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
