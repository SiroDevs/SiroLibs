                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore pooki ng'ae ojo agolie enkishui enye neiminie, kake ore pooki oiturraa enkishui enye neitopoki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
