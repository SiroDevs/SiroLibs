          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajoki intae, Ore te ina kewarie keirrag ltung'ana aare erruat nabo; neyai obo, neing'uari olikae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiutuutisho nkituaak are te nebo to soit obo; neyai nabo neing'uari enkae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
