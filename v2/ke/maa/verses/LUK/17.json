          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ninche ninye, “Olaitoriani, ae ti aji?” Nejoki, “Enetii empopok, eiturrurrokino lmotonyi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
