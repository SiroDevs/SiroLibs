          },
          "items": [
            {
              "text": "Enk 18.20–19.25",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neijia sii apa etiu too nkolong'i e Lot aa, kedaae apa, neokishoi, neinyiang'ishoi, nemirishoi, neunishoi, neshetishoi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ore ake ina olong natupukuo Lot aing'uaa Sodom neshau enkima oo soito le nkima eing'uaa shumata neidaikie ninche pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
