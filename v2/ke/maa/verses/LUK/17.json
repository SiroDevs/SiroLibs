          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neijia sii etiu ina olong naibalunyeki Enkerai e Tung'ani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
