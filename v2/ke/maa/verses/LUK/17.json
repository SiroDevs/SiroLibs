                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore anaa enatiu apa too nkolong'i e Noah, neijia etiu too nkolong'i e Nkerai e Tung'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
