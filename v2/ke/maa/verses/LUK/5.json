              "LUK.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.1+MAT.13.2"
              },
              "items": [
                {
                  "text": "Mat 13.1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.9+MRK.3.10"
              },
              "items": [
                {
                  "text": "Mk 3.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "4.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore eiding'akino ltung'ana aamanita einining'u lomon le Nkai, neitashe ninye te mbata e naiposha e Genesaret, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nedol impeuti are eirrag te mbata e naiposha. Etupukutuo larreshok loo sinkir aapuo aaisuj irresheta lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejing atua empeut nabo, naa ene Simon nejoki meturrumoi peno aitalam enkop natoyio. Neton aiteng'en olorere eton ninye ti atua empeut. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eidip airoro nejoki Simon, “Terewa enegut nintadoikiki rresheta inyi enaiposha aaibung isinkir.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.3"
              },
              "items": [
                {
                  "text": "Yhn 21.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nejoki Simon, “Lo Kitok, kitaasishote enkewarie nalulung'a neitu kitum toki, kake ore amu itejo, kaitadoyio resheta.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Yhn 21.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore pee eiko neijia neibung olkito turrur loo sinkir neiteru aang'era resheta lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyuku ilenchuluek enye ootii enkae peut meetu aaret. Nepuonu, neiput impeuti pokira are, o metaa keimis. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee edol Simon Petero ina nebatata too nkejek e Yesu, ejoki, “Olaitoriani, tung'uayioki nanu amu, kara oltung'ani loo ng'ok.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eing'asie ninye o lelo ooboitare, te nkumoi oo sinkir ooibung'a; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eing'asiate sii ninche layiok le Sebedayo, aa Yakobo o Yohana, oora le ncholiek e Simon, Nejoki Yesu Simon, “Miureishoyu; ore ebaiki taata, iltung'ana intorioo aibung.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyau mpeuti enkop natoyio, neing'uaa pooki toki nesuj ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshiunye Yesu oltung'ani oata enkeeya oo lbolot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore etii ninye ae ang, ng'ura, netii oltung'ani oata enkeeya oo lbolot, ore pee edol ninye Yesu, nebatata te nkomom, neserem ajoki, “Olaitoriani, te niyieu eikindim aishiunye atisika.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitorioo enkaina enye neiseyie nejoki, “Ekayieu, ninchiu tisikayu.” Neishiu asika nabo kata ina keeya oo lbolot. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.1+LEV.14.2+LEV.14.3+LEV.14.4+LEV.14.5+LEV.14.6+LEV.14.7+LEV.14.8+LEV.14.9+LEV.14.10+LEV.14.11+LEV.14.12+LEV.14.13+LEV.14.14+LEV.14.15+LEV.14.16+LEV.14.17+LEV.14.18+LEV.14.19+LEV.14.20+LEV.14.21+LEV.14.22+LEV.14.23+LEV.14.24+LEV.14.25+LEV.14.26+LEV.14.27+LEV.14.28+LEV.14.29+LEV.14.30+LEV.14.31+LEV.14.32"
              },
              "items": [
                {
                  "text": "Ilaw 14.1-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitanap Yesu ninye pee meliki likae tung'ani; nejoki, “Kake inyo, intoduaai kewan mikitisipu olapolosani ninchooyo olasar le nkishiunoto naaitanapishe Musa pee eitadedeyie ina sikata ino te ninche.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etoponari lomon lenyena aaibulu enkop pooki, nepuonu siamon kumok enetii aainining neishiunye mueyiaritin enye pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake kekepari ake nelo ong'ata, aomon Enkai openy.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eishiunye Yesu oltung'ani maima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nabo olong eiteng'enisho, netii ine ilfarisayo olasirak ooing'uaa nkang'itie pooki e Galilaya, o Yudea o Yerusalem. Netii engolon e Nkai atua Yesu pee etum aishiunye olorere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.17",
            "verseOrgIds": [
              "LUK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuonu ina kata ltung'ana oonapita te rruat, oltung'ani maima, netem aajo mayaki Yesu ti atua aji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.18",
            "verseOrgIds": [
              "LUK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkaraki enkiding'a o lorere nelaikino aayaki. Nedumu aailepakinye shumata enkaji, nebol aaitayu elusie, neitadou te rruat aaitadoiki nkejek e Yesu te mpolos o lorere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.19",
            "verseOrgIds": [
              "LUK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee edol Yesu enkirukoto naata ninche, nejoki ilo tung'ani, “Olchore, kitapalakaki ng'ok inono.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiteru lasirak o Lfarisayo aaishankarra ejo, “Ae ng'ae ele oiro amor Enkai? Ai mme Nkai ake naidim atapalaki oltung'ani ng'ok?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.21",
            "verseOrgIds": [
              "LUK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedol Yesu eishankarra newaliki ajoki, “Ainyoo pee inchankarrarra maate? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaa nalelek, te najo, ‘Kitapalakaki ng'ok inono,’ ana te najo, ‘Inyo shomo?’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.23",
            "verseOrgIds": [
              "LUK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore pee iyiolouu aajo keeta Enkerai e Tung'ani enkitoria te nkop napalakinye ng'ok,” nejoki ilo tung'ani maima, “Aajoki inyo tudumu erruat ino shomo ang.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neinyototo nabo kata te dukuya ninche, nedumu enaduoo rruat napetita, nelo ang eisisita Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.25",
            "verseOrgIds": [
              "LUK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neing'asia pooki nesis Enkai, neureishoyu, nejo, “Kitoduaa ake taata mbaa e nking'asia!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
              "LUK.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eipoto Yesu Lawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
              "LUK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eidipayu nena nelo Yesu, nedol oltung'ani osotu kodi oji Lawi, eton te wueji nesotunye kodi; nejoki, “Tusujuki nanu.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neing'uaa pooki toki, neinyototo asuj Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoomon Lawi ninye to sirua kitok netii esiamo kitok oo loosotu kodi o kulikae ake oodaa te nebo ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.1+LUK.15.2"
              },
              "items": [
                {
                  "text": "Lk 15.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neing'unyung'unyaki Lfarisayo o lasirak ilooiteng'eni lenyena ajo, “Oo pee ing'arierie endaa niokishosho te nebo iloosotu kodi o laing'okok?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaliki Yesu ajoki, “Imeyieu iltung'ana biyot olabaani, iloomuoi ooyieu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitu alotu aipot lelo supati kake ilaing'okok meetu aairridu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eiparishoreki Yesu too mbaa e mpukoroto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.32",
            "verseOrgIds": [
              "LUK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki taa ninche ninye, “Anaa eijo keen ate aapukoo oshi ilooiteng'eni le Yohana neomon Enkai naleng sii, naa neijia eiko ilooiteng'eni loo Lfarisayo, nedaa ninche linono neokisho?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.33",
            "verseOrgIds": [
              "LUK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu ninche, “Indimidimi aaitupukoi ilomon lo loyamisho eton eboitare oloyamisho? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.34",
            "verseOrgIds": [
              "LUK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake keyooki aapuonu nkolong'i naayae oloyamisho aaitung'uaa, nepukoo taa ninche te nena olong'i.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.35",
            "verseOrgIds": [
              "LUK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki aliki enkitanyaanyukoto nejoki, “Meetae oltung'ani oboru erashe to lkila ng'ejuk aripaki olkila musana, pee meinyal ilo ng'ejuk elde musana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.36",
            "verseOrgIds": [
              "LUK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meetae sii olobukoki enaisho oo sabibu ng'ejuk ilbenia musan pee medany ina aisho oo sabibu lelo benia musan, neibukori ninye neidaaya ilbenia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.37",
            "verseOrgIds": [
              "LUK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ilbenia ng'ejuko epiki enaisho ng'ejuk. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.38",
            "verseOrgIds": [
              "LUK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meetae sii oltung'ani otooko enaisho nao oitoki ayieu enajon, amu kejo, ‘Enao esidai.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.39",
            "verseOrgIds": [
              "LUK.5.39"
            ]
          }
        }
      ]
    }
  ],
