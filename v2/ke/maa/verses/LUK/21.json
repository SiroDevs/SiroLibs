              "type": "text"
            }
          ]
        },
        {
          "text": " Neiteng'enisho dama nkolong'i pooki te nkaji e Nkai, kake ore kewarie neipang alo airrag oldoinyo oji oloo Loirienito. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
