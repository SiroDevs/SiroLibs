                "loc": "ZEC.9.2+ZEC.9.3+ZEC.9.4"
              },
              "items": [
                {
                  "text": "Saka 9.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ee kake ayia iyie Korasin! Ee kake ayia iyie Betsaida! Amu te naa ketaasaki apa te Tiro o Sidon nena e nking'asia naatasaki tiaatua intae, anaata eirridutua apa moitie, neishop lkuniyiani, neelare nkuruon. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake Tiro o Sidon eikashieki te nkolong e nkiguana aaitalang intae. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Oi iyie Kapernaum, eijo shumata kilepieki, kintadouni shomo enemeneng'a.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mat 10.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
