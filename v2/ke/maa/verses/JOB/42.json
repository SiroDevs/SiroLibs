        "style": "s1"
      },
      "items": [
        {
          "text": "Ewalata e Yoab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
