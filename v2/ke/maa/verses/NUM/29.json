          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "te nebo sii ositima obo le kine to lasar le ng'oki; epudare ilo asar opejori le anaake o ilo asar lenye le ntapa o ilo asar lenye ooki.",
          "type": "text",
          "attrs": {
