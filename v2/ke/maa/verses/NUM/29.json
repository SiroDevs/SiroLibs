          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore te nkolong e ong'uan naa iloing'ok tomon, o lmeregeshi oare, o sitiman tomon o ong'uan le kerra lo lari obo lemeeta entioto, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.23",
            "verseOrgIds": [
              "NUM.29.23"
            ]
          }
        },
        {
