          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "te nebo ilo asar le ntapa o lelo asarri ooki te lelo oing'ok o te lelo meregeshi, o lelo sitiman le kerra, te nkikenata te risioroto e nkitanapata; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.27",
            "verseOrgIds": [
              "NUM.29.27"
            ]
          }
        },
        {
