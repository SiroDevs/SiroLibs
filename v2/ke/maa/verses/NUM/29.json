        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore te nkolong e are entopolos iloing'ok tomon o are ooti, o lmeregeshi oare, o sitiman tomon o ong'uan lo lari obo lemeeta ntiot, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "te nebo olasar le ntapa o lasar ooki te lelo oing'ok, o loo lmeregeshi, o loo sitiman le kerra, te nkikenata te risioroto e nkitanapata; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "o sitima obo le kine oaku olasar le ng'oki, epudare ilo asar opejori li anaake, o lasar lenye le ntapa, o lasarri lenye ooki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
