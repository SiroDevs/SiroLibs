            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te siadi kuna baa neye Yoshua olayioni le Nuni, osinka lo Laitoriani, aa oloo larin iip o tomon. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
