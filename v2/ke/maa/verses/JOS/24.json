              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Yosh 19.49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nenukaa ninche ninye ti atua enjung'ore enye te Timnat-sera, apa naa ninye natii ina kop oo ldoinyo e Efraim, moikuape o ldoinyo le Gaash.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
