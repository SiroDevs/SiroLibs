          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neisiaai Israel Olaitoriani too nkolong'i pooki e Yoshua, o nkolong'i pooki e lelo payiani apa ootung'uayie Yoshua, apa ooyiolo esiaai pooki nataasa Olaitoriani te nkaraki Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
