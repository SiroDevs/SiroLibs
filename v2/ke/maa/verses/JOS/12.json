          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Maden, obo; olaiguanani le Hasor, obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.19",
            "verseOrgIds": [
              "JOS.12.19"
            ]
          }
        },
