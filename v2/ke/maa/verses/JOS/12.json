          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Makeda, obo; olaiguanani le Betel, obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.16",
            "verseOrgIds": [
              "JOS.12.16"
            ]
          }
        },
