          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Afek, obo; olaiguanani le Lasharon, obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.18",
            "verseOrgIds": [
              "JOS.12.18"
            ]
          }
