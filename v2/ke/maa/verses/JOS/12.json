            "sid": "JOS 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Kedesh, obo; olaiguanani le Yokneam ti atua Karmel, obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
