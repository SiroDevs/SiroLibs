          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Tapua, obo; olaiguanani le Hafer; obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.17",
            "verseOrgIds": [
              "JOS.12.17"
            ]
          }
        },
