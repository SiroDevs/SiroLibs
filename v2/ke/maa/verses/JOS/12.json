          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "olaiguanani le Shimron-meron, obo; olaiguanani le Akshaf, obo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.20",
            "verseOrgIds": [
              "JOS.12.20"
            ]
          }
        },
