              "JOS.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13"
              },
              "items": [
                {
                  "text": "Ena 12.1-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore eton etii iltung'ana le Israel ilng'oborri te Gilgal nenya ninche Pasaka te nkolong e tomon o ong'uan o lapa teipa too nkisiajat e Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ekenyu te siadi Pasaka, te ina olong, nenya ninche ilng'anayio le ina kop, imukateni neitu eisuijieki o entapa natapejoki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.35"
              },
              "items": [
                {
                  "text": "Ena 16.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neishunye mana pee ekenyu ina kata apa enya ilng'anayio le ina kop; neitu eitoki iltung'ana le Israel aatum mana, kake einosa ilng'anayio le nkop e Kanaan te ilo ari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoshua o ilo tung'ani oata olalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa etii Yoshua embata e Yeriko, neshumu nkonyek enyena aing'orisho, naa ng'ura, eitashe oltung'ani te mbata ninye eeta olalem lenye oshutuno te nkaina enye; nelo Yoshua enetii ninye nejoki ninye, “Eira iyie ole nkalo ang, aashu oloo lmang'ati lang?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo ninye, “A-a; kake aewuo nanu anaa olarikoni le njore o Laitoriani.” Nebatata Yoshua te nkomom enye o metabaiki enkop, neserem, nejoki ninye, “Kainyoo ejoki Olaitoriani lai osinka lenye?” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo arikoni le njore o Laitoriani nejoki Yoshua, “Ntayu inamuka inono too nkejek inono; amu ore ine wueji nintasheyie naa eisinyati.” Neas Yoshua ina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    }
