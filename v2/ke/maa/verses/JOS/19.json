            "sid": "JOS 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "o Yironi, o Migdalel, o Horem, o Betanat o Bet-shemesh - nkanas tomon o oudo te nebo nkang'itie enye kutiti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
