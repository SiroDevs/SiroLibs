              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena ninye enjung'ore o losho le Naftali te risioroto oo lmareita lenye - kuna anas te nebo nkang'itie enyena kutit.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
