          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee eidip ninche aatoor enkop aitaa injung'oreitin, neisho lelo tung'ana le Israel enjung'ore ti atua ninche Yoshua olayioni le Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "O teina kitanapata o Laitoriani neisho ninche ninye ina anasa natoomonuo, Timnat-sera te ina kop oo ldoinyo e Efraim; neitoki ninye ashetu ina anasa nemany atua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
