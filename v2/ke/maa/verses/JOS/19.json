              "attrs": {
                "loc": "JDG.18.27+JDG.18.28+JDG.18.29"
              },
              "items": [
                {
                  "text": "Ilari 18.27-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore ake pee elau lelo le Dan enkop enye, nepuo lelo le Dan aarare Leshem, ore ake pee eidip aaibung'a ina kop nepik ninye olalem neya ninye nemany atua, neipot Leshem aajo, Dan; aaipotie enkarna e nkakuyiaa lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena ninye enjung'ore o losho le Dan, te risioroto oo lmareita lenyena - kuna anas te nebo nkang'itie enyena kutiti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
