          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkop e njung'ore enye neitushulu o Sora, o Eshtaol, o Ir-shemesh, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
