              "type": "text"
            }
          ]
        },
        {
          "text": "Ena ninye enjung'ore o losho le Asheri te risioroto oo lmareita lenyena - kuna anas te nebo nkang'itie enyena kutiti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
