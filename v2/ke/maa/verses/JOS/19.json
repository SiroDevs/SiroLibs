            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna ninche njung'oreitin apa naatoorikitia Eliesa olapolosani, o Yoshua olayioni le Nuni, o lukuny oo nkajijik oo ltung'ana le Israel, iltung'ana te oshoto e nkukuo te Shilo, te dukuya Olaitoriani, te kutukaji o lng'obor le ntumo. Neaku eidipa apa ninche aatudung enkop.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
