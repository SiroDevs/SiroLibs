              "type": "text"
            }
          ]
        },
        {
          "text": "Naitisiny nanu ninche te pooki toki oo loreren, naitobir mbaa naaipirta, isiaaitin oo lapolosak o Lawi, o ltung'ani ake te siaai enye; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
