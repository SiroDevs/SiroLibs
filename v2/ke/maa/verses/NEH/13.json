          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "naishoru nanu ilkeek oopejorieki olasar, too rishat enye naageluno, o too rishat oo lng'anayio le dukuya. Tadamuaki nanu Enkai ai, te mbae supat.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
