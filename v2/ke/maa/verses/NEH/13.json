          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 13:15"
          },
          "items": [
