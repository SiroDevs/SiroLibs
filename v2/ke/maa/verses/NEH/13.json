              "type": "text"
            }
          ]
        },
        {
          "text": " Ore apa obo loo layiok le Yehoiada olayioni le Eliashib, ilo apolosani kitok, naa olaputani le Sanbalat le Horoni; ore enkaraki ina aterewa nanu ninye aitalam kewan. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tadamu ninche, Enkai ai, Amu eisarkionie ninche empolosare o lning'o lo sotua le mpolosare oo lawi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
