                {
                  "text": "Enkig 7.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore sii apa te nena olong'i, atoduaa nanu Ilyahudi ooyama nkituaak e Ashdod, o Amon, o Moab; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
