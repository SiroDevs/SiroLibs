          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neisikong olorere ninche aaitigir, kake enyaakita aaitulusoo aabuak aajo, “Lo Kitok ara Daudi, ing'urrie iyiook.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        }
      ]
