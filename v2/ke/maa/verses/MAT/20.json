          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore oloyieu neaku ole dukuya te intae neaku osinka linyi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
