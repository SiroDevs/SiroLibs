                  "text": "Lk 22.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore te intae metiu nejia; kake ore pooki tung'ani te intae oyieu neaku kitok; inchoo eaku olaisiaayiani linyi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
