                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neipot Yesu ajoki, “Iyiololo aajo, ore laitoriak loo Loreren eitaa ate kituaak, neitoreisho te ngolon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
