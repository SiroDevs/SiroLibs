          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neing'uaa shetani ninye te ina kata; naa ng'ura, nepuonu ilmalaika aaisiaai ninye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        }
      ]
    },
