            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kake newaliki ajoki, “Etisiraki, ‘Meishuyie oltung'ani emukate ake, kake eishuyie pooki rorei opukunye enkutuk e Nkai.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki shetani arik enkanasa sinyati neitoton ninye te ntopij e nkaji e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.11+PSA.91.12"
              },
              "items": [
                {
                  "text": "Olke 91.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki. “Te naa ira iyie Enkerai e Nkai, tusulai kewan enkop; amu etisiraki aajo: ‘Keitanap ninye ilmalaika lenyena te nkaraki iyie, eikinap ninche too nkaik enye, pee mikinkob osoit enkeju ino.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
