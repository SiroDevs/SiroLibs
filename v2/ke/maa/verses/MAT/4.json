          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neibulu olning'o lenye enkop pooki e Siria; neyakini ninye iltung'ana pooki oomueyiaa ooibung'a nkeyaitin oo mpukunot kumok o looata loiriruani o looata emuoyian e nkiterria o lmaiman o looidimua emion; neishiunye ninye ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesuj ilororani kituaak ooing'uaa Galilaya o Dekapoli o Yerusalem o Yudea o lido kekun le Yordan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
