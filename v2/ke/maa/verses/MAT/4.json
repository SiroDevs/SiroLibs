                  "text": "Mk 1.39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nemanaa Yesu te Galilaya pooki eiteng'enisho too nkajijik enye e ntumo, nelikioo ilomon Supati le ina kitoria, neishiunye pooki keeya o emueyian ti atua olorere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
