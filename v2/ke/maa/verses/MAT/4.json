              "type": "text"
            }
          ]
        },
        {
          "text": " Nejoki Yesu ninye, “Shomo shetani amu, etisiraki aajo, ‘Teserema Olaitoriani Enkai ino naa ninye ake openy isiaai.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
