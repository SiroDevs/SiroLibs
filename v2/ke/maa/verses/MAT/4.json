                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neing'uaa Nasaret nelotu abik te Kapernaum, enkang natii embata e naiposha te nkop e Sebulon o Naftali, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
