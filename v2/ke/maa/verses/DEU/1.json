              "DEU.1.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.9.23"
              },
              "items": [
                {
                  "text": "Enkig 9.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.16"
              },
              "items": [
                {
                  "text": "Ilh 3.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ore ake eyia eitu intae ipuopuo, kake itogolong'akita enkitanapata o Laitoriani Enkai inyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ning'unyung'unyunyu tiatua ilng'oborri linyi, nijojo ‘Enkaraki naiba iyiook Olaitoriani pee eitupukuo iyiook te nkop e Misiri, pee elotu apik iyiook atua nkaik oo Lamoni, pee eidaikie iyiook. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyoo iyiook kiilep aapuo aaing'oru? Eitalepoitie ilalashera lang iltauja lang, ejo, “Eisapuki lelo tung'ana naa adoru aalang iyiook; eikituaak nena anas naashetuno aabaiki shumata; ore sii kitoduaa ilayiok le Anakim teine.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitoki nanu ajoki intae, eming'aeng'ai aashu iureyuyu ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Olaitoriani Enkai inyi oshi laa ninye orikoo intae, ninye makewan olo aarisho amitu intae, anaa apa enaitaasa ninye intae te Misiri te dukuya nkonyek inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.18"
              },
              "items": [
                {
                  "text": "Iat 13.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " o tiong'ata teine apa netodolie Olaitoriani Enkai inyi enap intae, anaa enanap oltung'ani enkerai enye teina oitoi apa pooki niima o metaba anaa nipuonunu ene wueji. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.19"
              },
              "items": [
                {
                  "text": "Ilh 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore ake etii ele rorei eitu, intae irukuruku Olaitoriani Enkai inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "laa ninye apa oshomo dukuya intae te nkoitoi pee eing'uraki intae ewueji niunienie ilng'oborri linyi, nerikoo intae te nkima kewarie, pee eitodol intae enkoitoi niimiimi, nerikoo intae te nkatampoi te ndama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eitamio Olaitoriani Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Ilh 3.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nening Olaitoriani lelo rorei linyi, negoro, neinos ninye olmumai ejo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Medol ninye oltung'ani obo le ilo porror torrono, ina kop apa nainosie olmumai nchere kaisho loo papaai linyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "meteleku ake Kaleb olayioni le Yefune; kelo ninye adol, ninye ake o nkera enyena alo nanu aisho ina kop metororua ninye too nkejek enyena, enkaraki nairukurukore ninye tukul Olaitoriani!’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aatagorokine sii nanu, Olaitoriani te nkaraki intae, nejo, ‘Milo sii iyie ajing atua ine, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua olayioni le Nuni, ilo oitashe te dukuya iyie, ninye olo ajing; ntagolo ninye oshoke, amu ninye olo aidimie Israel metujung'o ina kop. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nena kera inyi nitejo intae keidaikieki o nkera inono, nena nemeyiolo taata ninche esidai o entorrono, kepuo ninche atua ine, naa kaisho nanu ninche ina kop, naa keya ninche aaitaa enenye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore iyie, mbelekenyayu, shomo ong'ata mpira enkalo Enaiposha Nanyokie.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nikintokiki intae aawalaki nanu nijojo, ‘Kitasa eng'oki to Laitoriani, eikilep iyiook aapuo olarrabal, anaa enaitanapa iyiook Olaitoriani Enkai ang.’ Nerretena ake pooki tung'ani too masaa enyena olarrabal, ejo tenaa kelelek eilepakini ina kop oo ndoinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki nanu Olaitoriani, ‘Tiaaki ninche, Emilep aapuo olarrabal amu matii nanu atua intae, pee memiri ake intae te dukuya ilmang'ati linyi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku airorie nanu intae nianyianya intae ining'ining'i; kake itogolong'akita enkitanapata o Laitoriani, ore to lwuasa linyi nilepilepe aapuo ina kop oo ldoinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo tung'ana le Amori oomanya ina kop oo ldoinyo nepuonu aarare intae, nemir intae anaa enamirisho ilotorok, near intae aairragie te Seir, o metabaiki Horma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirrinyunyenye intae aapuonu aaishir te dukuya Olaitoriani; kake eitu ening Olaitoriani oltoilo linyi neitu eisho intae enkiok. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku itobiko intae te Kadesh nkolong'i kumok, te nena olong'i apa nitobiko intae teine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
