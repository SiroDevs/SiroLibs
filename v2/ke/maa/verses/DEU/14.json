                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Irara intae nkera o Laitoriani Enkai inyi; midung'udung'u ate nimibarnibarna nkomomi inyi teninchirakiki ilmeneng'a, ootuata. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
