                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit 2.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu irara intae iltung'ana oosinya to laitoriani Enkai inyi netegelua intae Olaitoriani pee iakuku olorere lenye makewan, agelu intae te lelo tung'ana pooki ootii oriong enkop.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ing'uesi Sidain o Naaiduruk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Minosinoso intae pooki toki ake ninye nadiaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.3",
            "verseOrgIds": [
              "DEU.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna ng'uesi indimidimi aainosa: olkiteng, enker o enkine, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "o empanas, o entarakuet, o olkondi, enkine oo soito, aashu osirua, o eng'ues nanyaanyukie olkibulekeny o enker-oo ldoinyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.5",
            "verseOrgIds": [
              "DEU.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki ng'ues narisha loisotok anaa neiperra iloisotok kat are, neinyaku ng'amura tiatua ng'uesi indim ainosa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake eyia te nena naainyiaku ng'amura aashu nemerisha loisotok minos: entames, enkitejo, o e suni, amu keinyaku ninche ing'amura kake merisha loisotok, naa olminong ina te intae. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olbitir enkaraki narisha iloisotok kake meinyaku ng'amura, naa olminong te intae. Eminosinoso intae nkiri enye ore mpopong'i enye emiseyie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore nena pooki naatii atua enkare indimidimi aainosa; ore mpukunot pooki oo sinkir indimidimi aainosa. Ore pooki toki naata naipuko neeta ilpala nindimidimi aainosa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.9",
            "verseOrgIds": [
              "DEU.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki nemeeta inaipuko anaa ilpala niminosinoso, mesinya nena te ntae.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Indimidimi aainosa imotonyi pooki sidain, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake mindimidimi ainosa kuna, olkurragos, olmotonyi loo lmurran o mpukunot oo sidan, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12",
            "verseOrgIds": [
              "DEU.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "olkurruk o olkupelia o mpukunot enye pooki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.13",
            "verseOrgIds": [
              "DEU.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "o lkurruk o mpukunot e pooki toki naata naipuko o mpukunot enyena pooki, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.14",
            "verseOrgIds": [
              "DEU.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "o esidai o lmuntut o motonyi e naiposha, o lenkalem, o mpukunot enye pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.15",
            "verseOrgIds": [
              "DEU.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O enkiti motonyi oo nkiyiaa, o emotonyi oo nkiyiaa sapuk, o emotoroki e nkare ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.16",
            "verseOrgIds": [
              "DEU.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "o enkakaya, osakeri, o lmagero, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.17",
            "verseOrgIds": [
              "DEU.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "o entilagos, o empukunoto e motoroki o lanke, o enagor kewan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.18",
            "verseOrgIds": [
              "DEU.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ntokitin pooki naapuo too naipuko naa olminong te intae, meidimi aainosa ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.19",
            "verseOrgIds": [
              "DEU.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nena tokitin pooki naasinyari naapuo too naipuko indimidimi aainosa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        }
      ]
    },
