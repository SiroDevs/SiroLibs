              "DEU.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Yosh 1.12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naitanap apa nanu intae teina kata, ajoki, ‘Eishoo intae Olaitoriani Enkai inyi ena kop pee eaku eninyi; ore lelo lewa linyi ootanapate keeim ninche ene eeta ruparen te dukuya ilalashera linyi, lelo tung'ana le Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore nkituaak inyi, o nkera inyi kutiti, o nkishu inyi (ayiolo nanu ajo iatata nkishu kumok) netoni ninche te nena anas naishoo nanu intae, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ometaba anaa neisho Olaitoriani enkiyeng'iyeng ilalashera linyi, anaa enaishoo intae, nemany sii ninche ina kop naisho Olaitoriani Enkai inyi ninche te lido kekun le Yordan; nitumutumu taa aatorrinyoto, oltung'ani ake, ashomo ine wueji enye naishoo nanu intae.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitanapa apa nanu Yoshua ina kata ajoki, Etoduaa nkonyek inono nena pooki naataasa Olaitoriani Enkai ino te kulo aiguanak pokira oare; neijia elo aiko Olaitoriani too nkitoriat pooki nilo iyie aimaa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "miureyu ninche amu Olaitoriani Enkai ino oarisho te nkaraki iyie.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etomitikioki Musa elo ajing enkop e Kanaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
