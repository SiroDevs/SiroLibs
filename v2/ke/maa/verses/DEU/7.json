              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Amu irara intae olorere oitisinyakaki Olaitoriani Enkai inyi; etegelua intae Olaitoriani Enkai inyi pee iakuku olorere lenye makewan, negelu intae tiatua lelo oreren pooki ootii oriong enkop. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mme apa enkaraki nirara intae kumok aalang ilkulikae tung'ana pee etipika Olaitoriani enyorrata enye shumata intae negelu intae, amu intae apa kuti aalang iloreren pooki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake enkaraki nanyor intae Olaitoriani; neibung'ita ninye ilo mumai apa oinosie loo papaai linyi, ina pee eyaua intae Olaitoriani aipang'unye te nkaina magilani, nekordu intae Olaitoriani aitupuku te nkaji e sinkaisho, aitung'uaa enkaina e Farao ilo aiguanani le Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5+EXO.20.6"
              },
              "items": [
                {
                  "text": "Ena 20.5-6",
