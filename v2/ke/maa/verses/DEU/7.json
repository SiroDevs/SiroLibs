              },
              "items": [
                {
                  "text": "34.6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Enki 14.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9+DEU.5.10"
              },
              "items": [
                {
                  "text": "Enkig 5.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tayiolo naa nchere, Olaitoriani Enkai ino ninye Enkai, ina Ai naisiligayu naibung olning'o o enyorrata nauno te lelo oonyor ninye neibung nkitanapat enyena, ometabaiki iishoritin enkalifu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitalaku te lelo ooiba ninye, eidaikie ninche; meshololo te lelo ooiba ninye, keitalaku te ninye teine ake. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'ura naa pee iasiasa ina kitanapata, o nena kikoot, o nkiguanat naitanapa nanu intae ena olong.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
