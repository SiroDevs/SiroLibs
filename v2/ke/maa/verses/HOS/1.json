          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Irm 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kake ore esiana oo ltung'ana le Israel naa kebayu anaa osinyai le naiposha, lemeidimi aatetem anaa aaikena, naa ore to ine wueji apa netiakinyeki ninche, “Mirara iltung'ana laainei,” keaku keji ninche, “Nkera e Nkai naishu.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iltung'ana le Yuda o ltung'ana le Israel nepuo aaiturrurr te nebo negelaki ate o lkitok obo; naa keilep ninche aapuo te ina kop, amu eikitok kenya ina olong e Yesreel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
