          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena eitalakuni te ninche to lwuasa lenye, enkaraki natusukenya nerup ate ti alo iltung'ana lo Laitoriani loo lororani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kegilunore Olaitoriani ninche; keishie ninye nkaitin pooki e nkop, neaku ninye eirrugokinoi, pooki ake te wueji enye, nkuapi pooki oo loreren.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        }
      ]
    },
