                  "text": "14.24-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Nah 1.1–3.19",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naa keitorioo ninye enkaina enye aarare moikuape, neidaikie Asiria; neitaa ninye Ninawi olmuate, ewueji netoyio anaa olpurkel. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
            "verseOrgIds": [
              "ZEP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keirrag iluaat te mpolos enye, ing'uesi pooki e ong'ata; ore olmotonyi o enjolis nemany ilpaashen lenyena; neishiraki emotonyi oo nkiyiaa ilusien enye neru olkurruk tembata e kishomi enye ore nkeek oo lpaashen lenye neitomijooni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkanasa naturupa kewan ena apa natobiko te seriani, apa najo ninye makewan, “Nanu ake nemeetae ae.” Ketaa ninye olmuate anaa nyoo, ewueji neirragie ing'uesi e ntim! Ore pooki ng'ae ogiroo ninye neiputukuny nenunuk enkaina enye aikirikirie.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.15",
            "verseOrgIds": [
              "ZEP.2.15"
            ]
          }
        }
      ]
