              "type": "text"
            }
          ]
        },
        {
          "text": "Wootu enturrurroto entuumata ele osho lemedol enkurruna, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eton eitu kirewi anaa nguetat, eton eitu elotu shumata iyie engoro o Laitoriani napi, eton eitu elotu shumata iyie ina olong e ngoro o Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'oru Olaitoriani, intae pooki oobor lena kop, lelo ooas nkitanapat enyena; eng'oru esupatisho, eng'oru emborron; eidimayu neisudori intae te ina olong e ngoro o Laitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkinyalata oo iloshon oomanita Isirael",
          "type": "text"
        }
      ]
    },
