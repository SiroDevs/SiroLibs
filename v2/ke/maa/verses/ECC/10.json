      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midek ake olaiguanani, too ndamunot inono, nimidek to lgilata lirrag ilo karsis, amu ore imotonyi oloing'ang'e neya oltoilo lino, arashu eboloo kulie nyaun oo naipuko ina bae.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.20",
            "verseOrgIds": [
              "ECC.10.20"
            ]
          }
        }
      ]
    }
