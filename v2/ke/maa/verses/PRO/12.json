            "style": "v",
            "sid": "PRO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etii obo laa ore irorei oitasieku netiu anaa enang'unoto olalem. Kake ore olng'ejep lo lng'en neyau enkishiunoto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.18",
            "verseOrgIds": [
              "PRO.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
