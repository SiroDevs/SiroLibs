          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eng'eno oltung'ani ng'en naa pee emusu enkoitoi enye, kake ore emodai oo lmoda naa elejare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
