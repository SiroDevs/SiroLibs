              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo omoda neiruk pooki toki, kake ore olng'en neing'or enkoitoi enye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
