              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani ng'en naa kerripo neibelekenya aing'uaa intorrok, kake ore olmodai nemerrip kewan eas intorrok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
