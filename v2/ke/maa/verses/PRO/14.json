            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eing'oru olomenisho eng'eno nagut te mpesho, kake elelek eng'eno to ltung'ani oota ening'unoto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
