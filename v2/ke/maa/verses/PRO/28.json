            "style": "v",
            "sid": "PRO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.19",
            "verseOrgIds": [
              "PRO.28.19"
