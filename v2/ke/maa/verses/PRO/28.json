          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki ng'ae opur menye arashu ng'otonye nejo, “Imme enkitarruorroto ina katukul,” naa olencholiek e ilo tung'ani amutani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.24",
            "verseOrgIds": [
              "PRO.28.24"
            ]
          }
        }
