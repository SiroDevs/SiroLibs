              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oisikong oltung'ani, ore te siadi naa keitoki atum omom, alang ilo opakas ninye too rorei lo lng'ejep lenye oopuyiapuy.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.23",
            "verseOrgIds": [
              "PRO.28.23"
            ]
          }
        }
