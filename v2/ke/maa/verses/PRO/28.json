          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oisilig endamunoto enye naa olmodai, kake ore ilo olo te ng'eno nagut naa kekorduni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.26",
            "verseOrgIds": [
