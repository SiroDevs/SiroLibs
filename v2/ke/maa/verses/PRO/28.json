              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oleng too laisinak, nemeng'oriki toki, kake ore ilo oisudoo inkonyek enyena netum ildeketa kumok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.27",
            "verseOrgIds": [
