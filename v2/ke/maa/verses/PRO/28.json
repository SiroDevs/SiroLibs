          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani oisiligayu naa ketum imayianat kumok. Kake ore ilo osioki aaku olkarsis nemelo eitu eitamei.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.20",
            "verseOrgIds": [
              "PRO.28.20"
            ]
          }
        }
      ]
    },
    {
