          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani lo lorok neing'oru enkarsisisho nasieku, nemeyiolo ajo kelotu osina enetii ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.22",
            "verseOrgIds": [
              "PRO.28.22"
            ]
