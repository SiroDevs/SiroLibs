          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinintodolu olkep neme sidai; kake eas oltung'ani ntorrok te neishori enkiti daa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.21",
            "verseOrgIds": [
              "PRO.28.21"
            ]
          }
        }
      ]
