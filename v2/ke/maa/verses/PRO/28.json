          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo otur enkurma enye naa ketum endaa sapuk, kake ore ilo osuj imbaa nemeeta tipat naa ketum aisinanisho sapuk.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.19",
            "verseOrgIds": [
              "PRO.28.19"
            ]
          }
        }
      ]
    },
    {
