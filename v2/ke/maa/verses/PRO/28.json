            "sid": "PRO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani lo lorok neinyeyie olarrabal, kake ore ilo oisilig Olaitoriani naa keitaae karsis.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.25",
            "verseOrgIds": [
              "PRO.28.25"
            ]
