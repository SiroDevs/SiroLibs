              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani oleng naa keitaae ninye karsis, ore ilo opiku enkare, naa kepikakini sii ninye enkare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.25",
