          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani torrono netum olekoisiaayio lelejare, kake ore ilo oun esupatisho netum olerrinyore osipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
              "PRO.11.18"
            ]
          }
        }
      ]
    },
