              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tayiolo miata olng'ash ajo, melo oltung'ani torrono eitu eitamei, kake ore lelo supati naa kelakuni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.21",
            "verseOrgIds": [
              "PRO.11.21"
