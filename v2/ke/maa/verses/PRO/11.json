              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani supat neret kewan, kake ore oltung'ani otolo naa kewan eitame.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.17",
            "verseOrgIds": [
              "PRO.11.17"
            ]
          }
        }
      ]
    },
