              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oitashe too sipat nebik eishu. Kake ore ilo osuj intorrok naa keye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
