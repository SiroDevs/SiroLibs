          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iltung'ana oota indamunot naapaashaa naa olminong to Laitoriani, kake ore lelo le meeta entioto too nkoitoi enye naa enchipai te ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.20",
            "verseOrgIds": [
              "PRO.11.20"
            ]
          }
        }
