              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa enaikununo olgisoi le sahabu te nkume embitir, nejia etiu enkitok sidai nemeeta eng'eno naret.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.22",
            "verseOrgIds": [
