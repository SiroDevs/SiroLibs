          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore irorei le nking'oming'om netiu anaa embelati e mukate namelok, nejing'aa atua osesen lenye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
