          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oshal te siaai enye, naa olalashe le ilo oidaikie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
