              "PRO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eng'iri oltau lo ltung'ani emuoyian; paa amaa oltau otigile aing'ae oidim ating'iria?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
