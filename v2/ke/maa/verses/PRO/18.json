            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyieu nitumore oltung'ani kitok? Iyaki ninye enkishooroto naa kelelek itum ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
          }
        }
