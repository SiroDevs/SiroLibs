          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo ong'as airo te dukuya nelioo aa kesipa enkiroroto enye o metaba anaa nelotu likae ajur ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.17",
            "verseOrgIds": [
              "PRO.18.17"
            ]
          }
