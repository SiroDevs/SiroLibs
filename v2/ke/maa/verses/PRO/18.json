          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore imasaa o lkarsis naa enkanasa enye nagol, netiu anaa esuntai naado namitu ninye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
