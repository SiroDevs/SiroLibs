          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teneishooyo oltung'ani ewalata eton eitu ening'u, naa emodai enye o enkurruna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
