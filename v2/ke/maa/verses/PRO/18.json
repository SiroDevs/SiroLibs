          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eoshoto enkukuo neiting'ie enchankar nerishu autu iloogol ooishankarra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.18",
            "verseOrgIds": [
              "PRO.18.18"
            ]
          }
        }
