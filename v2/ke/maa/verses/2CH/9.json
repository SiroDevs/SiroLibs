                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neeta apa Solomon ilaleta nkalifuni ong'uan loo mbartan, o ngarrin oo mbartan, o lakedok loo mbartan nkalifuni tomon o are, ootamanya nena anas oo ngarrin oo mbartan tenebo olaiguanani te Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
