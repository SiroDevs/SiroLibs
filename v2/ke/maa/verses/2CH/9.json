              "items": [
                {
                  "text": "1 Int 4.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitore ninye ilaiguanak pooki ebaiki olkeju le Frati, ometabaiki enkop oo Lfilisti, o metabaiki olpolosie le Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitotiu olaiguanani sahabu te Yerusalem anaa isoito nebayu iltarakua te nkumoi anaa ilng'abolo le Shefela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
