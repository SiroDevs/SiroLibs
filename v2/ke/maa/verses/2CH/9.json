                  "text": "Enkig 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neyakini Solomon mbartan naaing'uaa Misiri neing'uaa nkuapi pooki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
