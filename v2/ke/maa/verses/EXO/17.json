            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Enkig 25.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki Olaitoriani Musa, “Ing'ero ena te mbuku metaa endamunoto niliki Yoshua ajoki ekamut nanu aimisie endamunoto oo Ilmaleki aiwuang'ie ti abori keper.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshetu Musa olperere lo lasar nejo enkarna enye, Olaitoriani ninye enanka ai ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejo, “Einosa Olaitoriani olmumai nchere kearare ninye Ilmaleki ebaiki eishoi o eishoi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
