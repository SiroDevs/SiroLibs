            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ti ninang'arere enkiteng arashu osikiria lo lmanga'tinta lino eimina tushukoki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti nidol osikiria li obo likimba etepetikia olola enkop, nimilo aing'uaa, taretoki ninye metudumu olola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
