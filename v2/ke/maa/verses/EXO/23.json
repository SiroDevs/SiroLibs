              },
              "items": [
                {
                  "text": "Enki 28.26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Imbung'a osirua le nkisampuare, oo lng'anayio le dukuya le siaai ino, te nena nintera aun ti atua enkurma, imbung'a osirua le nkiturrurrorre te nkiting'oto o lari, ti ninturrur te nkurma lelo ng'anayio le siaai ino. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katitin uni to lari epuonu ilewa linyi pooki dukuya o Laitoriani Enkai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
