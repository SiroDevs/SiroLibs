                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Entaas esiaai inyi too nkolong'i ile, kake ore te nkolong e naapishana niyeng'iyeng'a pee etum olkiteng lino o sikiria lino enkiyeng'iyengata, negolu olayioni le rrindik ino o ilo dokunoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embung'a nena pooki natiaaka intae, nimimpotipoto ake nkarn e kulie aitin arashu minchosho metoning'i eimu nkutukie inyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
