            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ore to lari li opishana nipalipala nimisampumpu hoo ae toki nabulu. Pee enya ilaisinak le lelo tung'ana linyi; ore inaaleku nenya ing'uesi e ntim. Ninkoko neijia too sabibu linyi o too lng'anayio linyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
