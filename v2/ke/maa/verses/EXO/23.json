                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Misoruru olomoni, iyiololo oltau lo lomoni, amu irara apa intae ilomon te nkop e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
