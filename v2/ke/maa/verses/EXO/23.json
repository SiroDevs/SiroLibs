                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mintayuyu intae ilomon le lejare. Mimbung'arere oltung'ani torrono aaitayu enchakenisho e lejare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirubarere esiamo aas intorrok, nimintayuyu shakenisho te nkiguana aarubare esiamo pee inturraa esipata. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Ilaw 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nimintodolu olkep to ltung'ani aisinani te nkiguana enye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
