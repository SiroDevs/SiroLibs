                  "text": "Enkig 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Te nelo niya olkila le ilo le latia ino pee intalakunye esile tushukoki ninye eitu edoyio enkolong, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
