              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mimutie te nkishorunoto e nkiputakinoto e nkisampuare ino o te mborei nadooyo e naisho oo sabibu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
