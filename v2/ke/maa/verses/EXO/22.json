                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Eminyal olomoni arashu imbooki ninye enkop, amu irara sii apa intae ilomon te nkop e Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
