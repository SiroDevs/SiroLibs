              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiko neijia iltung'ana pooki loo Siraeli anaa enaitanapa Olaitoriani Musa o Aron, neas ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
