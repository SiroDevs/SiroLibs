                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mat 17.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Beka nabo te lukunya, aa taa (olpisiai le shekeli te risioroto e wueji sinyati) te pooki ng'ae apa oikenaki, ebaiki ilarin tikitam neilep, too ltung'ana iip ile, o nkalifuni uni, o iip imiet oonom. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ntalantani iip e nkosholai naa inaaitobirieki apa nkitotoneta e wueji sinyati, o nkitotoneta e ilo karasha le ndung'oroto nera iip too ntalantani iip e ntalanta ake te nkitotonet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too shekeli enkalifu o iip naapishana o ntomoni naapishana o imiet neitobir ilala oo lolo te nkaraki ing'apeta nemur ilukuny enye neitobiraki ninche irubat. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo suyai apa oishoruaki naa ntalantani ntomoni naapishana, o shekeli nkalifuni are o iip ong'uan; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa ninche eitobirie ninye nkitotoneta te nkaraki kutuk aji e ilo ng'obor le ntumo, olperere lo lasar lo suyai o eng'esherrie o suyai te nkaraki ninye o ntokitin pooki e ilo perere lo lasar; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 38:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "o nkitotoneta naamanita ina dung'oroto o nkitotoneta e kishomi e ina dung'oroto, o ncheito pooki o lng'obor le Nkai, o ncheito pooki naamanaa te dung'oroto.",
          "type": "text",
