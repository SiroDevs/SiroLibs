        "style": "s1"
      },
      "items": [
        {
          "text": "Inkitanapat naaipirta sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
