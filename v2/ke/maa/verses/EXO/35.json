                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.3"
              },
              "items": [
                {
                  "text": "Ilaw 23.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Enkig 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Too nkolong'i ile easi esiaai inyi, kake ore te nkolong e naapishana nitumutumu sabato sinyati e nkiyeng'iyeng to Laitoriani; ore pooki ng'ae oas esiaai te ina olong neari metua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minokinoko enkima too nkajijik inyi te nkolong e sabato.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inkishorot e ilo ng'obor sinyati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Musa olturrur pooki loo ltung'ana loo Siraeli, “Ena toki ninye eitanapishe Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyautu ti atua ntae enkishoroto eyaki Olaitoriani; ore pooki ng'ae oata oltau le leng'on nchoo ninye eyaki Olaitoriani enkishooroto; sahabu, o enkosholai o suyai; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "o iusin pusi, o morijo o mpilei o katani napuyiapui napiyaya; o lpapit loo nkineji, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ndapan naanota oo lmeregeshi o noo nkineji, o nkeek o lerai, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "o eilata oo ltaai, isonkoyoni te ina ilata naputishoreki, o te nkorropil naisonkoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "oltoto barrikon, o ltoto pee epiki enkila dorrop o embene o lgoo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masaa o lng'obor le manyisho o Laitoriani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninchosho pooki tung'ani oata enkidimata ti atua intae meetu aitobir nena pooki naaitanapishe Olaitoriani: olng'obor le Nkai, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "olng'obor lenye o entoki naitushurieki o enkitushurata enye, o lala oo lolo lenyena, o rubat enyena, o loom lenyena, ing'apeta enyena o neeitotonieki enyena; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilo sanduku o nkeek enyena, ilo orika lo lng'ur o ilo liatua lenye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ina mesa o mbokishi enyena o masaa enyena pooki, o ina mukate naitoduari; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nena kitasheta oo ltaai sii te nkaraki ewang'an te nebo imasaa enyena o ltaai lenyena, o eilata o ltaa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "olperere le nkorropil te nebo mbokishi enyena, o ina ilata naputishoreki o ina orropil naisonkoyo o ilo odung'oro le kutuk aji te kutuk aji o lng'obor le Nkai; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilo perere lo lasar opejori te nebo ina ng'esherrie enye o suyai, imbokishi enyena o ntokitin enyena pooki oilo moti oitukuoreki o eneitotonieki enye; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "o nena kisiong'at endung'oroto, ing'apeta enyena o neeitotonieki enyena o ilo odung'oroto le kishomi e ndung'oroto; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nena sheito e nkaji e Nkai o nena sheito o olodung'oro, o nkeenta enye; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
            "verseOrgIds": [
              "EXO.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nena kilani naaripuno aaitobiruno te nkaraki enkisiaayiare te wueji sinyati, lelo kilani oosinya le Aron ilo apolosani, o lelo kilani loo layiok lenyena, te nkisiayiare enye anaa ilapolosak.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyautua olorere nkishorot enye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuo olorere pooki loo ltung'ana loo Siraeli te ine netii Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.20",
            "verseOrgIds": [
              "EXO.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuonu ninche, ore pooki ng'ae otudumua oltau lenye, o pooki otuputuo oltau lenye, neyau enkishoroto o Laitoriani pee easishoreki te ilo ng'obor le ntumo, o te nkisiayiare enye pooki, o te lelo kilani oosinya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.21",
            "verseOrgIds": [
              "EXO.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuonu ninche, ilewa o nkituaak; ore pooki oora ilo ltau le yieunoto neyau ilgameta, o lmiintoni, o lgiso, o mankek (isaen loo murto) o lkataarri, o ntokitin oo mpukunot pooki e sahabu eiteng'elaki ake pooki tung'ani Olaitoriani enkishoroto e sahabu Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.22",
            "verseOrgIds": [
              "EXO.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki tung'ani oinepuaki eeta iusin pusi arashu morijo, arashu mpilei arashu katani napuyiapui napiyaya, arashu ilpapit loo nkineji arashu ndapan naanota oo lmeregeshi arashu inoo nkineji, neyau ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.23",
            "verseOrgIds": [
              "EXO.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki ng'ae oidim aitayu enkishoroto e nkosholai arashu osuyai neyau anaa enkishoroto o Laitoriani; ore pooki tung'ani oinepuni eeta enchata o lerai naata tipat te siaai, neyau ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.24",
            "verseOrgIds": [
              "EXO.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nkituaak pooki naata enkidimata napiyayisho too nkaik enye, neyau nena naapiyaya, too usin pusi, o morijo o mpilei o te katani sidai napuyiapui; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.25",
            "verseOrgIds": [
              "EXO.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore nena kituaak pooki naatudumutua iltauja lenye te nkarriyiano nepiyai ilpapit loo nkineji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.26",
            "verseOrgIds": [
              "EXO.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyau ilarikok iltoto barrikon ooji oniks o soito pee epiki, te nkaraki enkila dorrop o ina bene o lgoo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
              "EXO.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "o sonkoyoni o eilata te nkaraki ewang'an, o ina ilata naputishoreki, o enkorropil naisonkoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
            "verseOrgIds": [
              "EXO.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilewa pooki o nkituaak, lelo tung'ana loo Siraeli, ootupututuo iltauja lenye eyau pooki toki te nkaraki ina siaai naitanapishe Olaitoriani te Musa metaasi neyau nkishorot enye olpela aaisho o Laitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilashetak arriyiak lo lng'obor le manyisho o Laitoriani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Musa iltung'ana loo Siraeli, “Eng'ura, eipoto Olaitoriani te nkarna Besalel olayioni le Uri, olayioni le Huri lo losho le Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "neiputa Enkai ninye te nkiyang'et e Nkai, te nkidimata, o te nkalamasisho, o te ng'eno, o te nkarriyiano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pee eipiru nkitobirat e nkarriyiano, neasisho te sahabu o te nkosholai o to suyai, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ndung'oto oo soito oopiki o te ng'uetata oo nkeek, te siaai e nkarriyiano pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nchoo ninye enkidimata enye naiteng'enishore, ninye te nebo o Oholiab olayioni le Ahisamak lo losho le Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiputa ninye ninche te nkidimata metaasa empukunoto e siaai pooki naas laguetak loo soito, o ilasirak, o laripak loo usin pusi, o morijo o mpilei, o katani naapuyiapui napiyaya arashu ilashetak, te pooki pukunoto o laisiaayiani arashu olaipirunoni arriyia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
