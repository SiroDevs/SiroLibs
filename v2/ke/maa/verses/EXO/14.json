          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eshomo iltung'ana loo Siraeli te nkop natoyio te mpolos e naiposha, etaa nkariak esuntai te ninche te nkaina enye e tatene o te kedienye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        }
