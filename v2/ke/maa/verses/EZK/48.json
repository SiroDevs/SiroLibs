              "EZK.48.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.12+REV.21.13"
              },
              "items": [
                {
                  "text": "Emb 21.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Keaku keetae ineepukunyeki enkanasa: Ore te nkalo e moikuape ina naaku intemat enkaina inkalifuni tikitam o ong'uan o iip imiet te ntemet, inchomito uni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "e nkishomi e Ruben, e nkishomi e Yuda, o enkishomi e Lawi, ore nchomito enkanasa naa keipotieki iloshon le Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkalo oloosaen, ina naaku intemat enkaina inkalifuni oong'uan o iip imiet, naa inchomito uni, kishomi e Yosef, kishomi e Benchamen, o kishomi e Dan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkalo e kopikop, ina naaku intemat enkaina inkalifuni ong'uan o iip imiet te ntemet, naa inchomito uni, kishomi e Simion, kishomi e Isaakar, o kishomi e Sebulon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkalo oloo ntoluo ina naaku intemat enkaina inkalifuni ong'uan o iip imiet naa nchomito uni, kishomi e Gad, o kishomi e Asheri, o kishomi e Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore emanaroto e nkanasa naa keaku intemat enkaina inkalifuni tomon o isiet. Ore enkarna e nkanasa eiteru teina kata nelo dukuya naa keji, Etii Olaitoriani ine!”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
