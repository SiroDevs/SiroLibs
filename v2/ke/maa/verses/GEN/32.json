          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etiaaka, “Ainyoo doi peyie inkilikuanu enkarna ai?” Nemayian ninye teine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        }
      ]
