                "loc": "GEN.5.1+GEN.5.2"
              },
              "items": [
                {
                  "text": "Enk 5.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemayian Enkai ninche, nejoki “Entoisho entoponari emputa enkop nintorere. Entoria sii isinkir le naiposha o motony o loing'ang'e, o pooki toki ake ninye naishu naiseuseu te nkop.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Enkai: “Ng'ura, aaishoo iyie pooki aitubului naiu ilanterera natii oriong enkop, o pooki shani oota ilanterera too ilng'anayio lenyena intaa endaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "O pooki ng'ues e nkop, o pooki motonyi o loing'ang'e, o pooki toki naiserpepiari te nkop, o pooki toki naata enkiyang'et e nkishui aaishoo enkaitubului pooki nanyori peyie intaa endaa.” Neaku neija. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.30",
            "verseOrgIds": [
              "GEN.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedol Enkai pooki toki naitobirua ajo aisidai katukul. Neaku teipa neaku tadekenya enkolong e ile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.31",
            "verseOrgIds": [
              "GEN.1.31"
            ]
          }
        }
