              "items": [
                {
                  "text": "Mk 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Metaa eitayio Enkai oltung'ani te nkitanyaanyukoto enye makewan. Te nkitanyaanyukoto Enkai eitayio ninye ninche, olee o eng'oruoi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
