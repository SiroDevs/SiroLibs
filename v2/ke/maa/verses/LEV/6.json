          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neidim pooki lee tiatua ilapolosak ainosa, entoki nasinya ena oleng. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
