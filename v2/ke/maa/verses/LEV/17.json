                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ore pooki tung'ani le nkaji e Israel aashu o le lelo tung'ana omon ootoni tiatua ninche, te nenya osarge, naing'orie nanu enkomom ai te ngoro ilo tung'ani oinosa osarge, naiwuang'ie ninye tiatua iltung'ana lenyena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Ilh 9.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore enkishui oo nkiri naa atua osarge etii, naishooyie nanu te nkaraki intae te nchumata olperere lo lasar pee eitobir olning'o lo sotua te nkaraki iltauja linyi; amu osarge oitobir olning'o lo sotua, te nkaraki e nkishui. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku atiaaka nanu iltung'ana le Israel, Meetae oltung'ani tiatua intae oinos osarge, nemeinos ilo tung'ani omoni oton tiatua intae osarge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore sii pooki tung'ani too ltung'ana le Israel aashu lelo omon ootii atua ninche olo arresh aibung eng'ues aashu emotonyi pee etumi aainosa neibukoo osarge lenye neitemoo too nkulukuok.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amu ore enkishui e pooki toki naishu naa osarge lenye etii. Neaku atiaaka nanu iltung'ana le Israel, Eminos ake osarge li ae toki ake ninye pooki, amu ore enkishui e pooki toki naishu naa osarge lenye etii; ore pooki ng'ae oinos osarge neiwuang'ieki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pooki tung'ani oinos entoki natua openy aashu enataara louarak te ntim, aa oinoti aashu olomoni oidurrua, nelo ninye aituku ilkilani lenyena, neisuj osesen lenye te nkare, neton ninye eata olduruk o metaa teipa, netum taa atisidana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake tenemeituku ninye ilkilani lenyena anaa eituku ososen lenye nenap ninye entorroni enye.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
    }
