                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Naa teneaku olalashe lino aisinani, neaku meidim ataretu kewan tenebo iyie, tareto iyie ninye, anaa olomoni anaa olamutanani likiewuo ashulare. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
