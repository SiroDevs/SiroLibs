              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake tenemeeta ninye ntokitin naaidip naarrinyokinye kewan enye, neaku naa ore apa ina natimira neton too nkaik eilo apa oinyang'ua ometabau olari le Yubilii",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25.28",
              "type": "text"
            },
            {
              "text": "Yubili",
              "type": "text"
            },
            {
              "text": "osirua odamunyeki ilarin onom",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ore te Yubilii nelaari ninye nerrinyokino ninye imasaa enyena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
