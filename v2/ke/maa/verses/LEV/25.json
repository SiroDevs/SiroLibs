        "style": "s1"
      },
      "items": [
        {
          "text": "Elaaroto oo rrindiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
