              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Ena 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Enkig 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Misilenoki iyie ninye mpisai inono te mponikinoto nimincho iyie ninye endaa ino aing'oru dupoto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara nanu Olaitoriani Enkai ino, ilo likiyawua iyie aitupuku te nkop e Misiri pee kincho iyie enkop e Kanaan; neaku ninye Enkai ino.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
