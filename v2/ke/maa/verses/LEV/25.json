            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ming'orunye ninye dupoto aashu ing'orunye toki, kake turia Enkai ino; pee etum olalashe lino atotona te mbata iyie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
