            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naa teneeta olee anaa enkitok enkeeya te ndukuya anaa to lboony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejur olapolosani ine; ore pee elioyu ine egut alang olchoni lo sesen lenye, ore ilpapit leine naa eisikitok naa nelamilama, neibalunye olapolosani ninye ajo olduruk; amu olpepedoi ilo, enkeeya oo lbolot e ndukuya aashu enolboony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa tenejur olapolosani ina muoyian e mion, nelioyu ajo megut alang olchoni lo sesen, nemetii ilpapit oorook ine, netum taa olapolosani aikenoi ilo tung'ani oota olpepedoi nkolong'i naapishana, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te nkolong e naapishana nejur olapolosani ina keeya; naa teneitu eibulaa ilo pepedoi nemetii ilpapit sikitok, nemelio ilo pepedoi etugumo alang olchoni lo sesen, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "netum taa ilo tung'ani atabarno kewan kake mebarn ilo pepedoi; neitoki olapolosani aikenoo ilo tung'ani oata olpepedoi kulie olong'i naapishana ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te nkolong e naapishana neitoki olapolosani ajur ilo pepedoi, naa teneitu eibulaa ilo pepedoi to sesen nelioyu ajo megut alang olchoni lo sesen neibalunye olapolosani ajo meiduruk; neituku ninye ilkilani lenyena, nesidanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake teneibulayie ilo pepedoi osesen eidipaki aaisuja ninye, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitoki olapolosani ajur ninye, ore ake pee eibulayie ilo pepedoi osesen lenye, nemeeta tipat pee eitoki olapolosani aing'oru ilpapit sikitok; amu keiduruk ninye ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake tenetujurruoki ilo pepedoi too nkonyek enyena, netubulakitia ilpapit oorook neishiuo ilo pepedoi, meeta ninye entioto, neibalunye olapolosani ninye ajo meiduruk ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
