          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "netum naa olapolosani aitanapisho meitukui ina toki natijing'a enkeeya neikenoo ninye nkulie olong'i naapishana; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitoki olapolosani ajur ina toki natijing'a enkeeya ina kata eidipaki aaitukuo. Naa teneitu eibelekenya emua e ilo tipoti le nkeeya, hoo neitu eibulaa ina keeya, naa olduruk; nipejoo iyie ninye te nkima, aa enkalo e oriong etii ilo tipoti le nkeeya oo lbolot aashu ene dukuya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
