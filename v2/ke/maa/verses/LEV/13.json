            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore ilo tung'ani oata enkeeya oo lbolot nchoo eishop nkilani naapolosa neisho ilpapit le ndukuya enye eisiong'a, neimulumul ninye enkutuk enye ajo, ‘Olo lduruk olo lduruk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebik ninye aa oltung'ani oata olduruk enkata pooki naba anaa enaata ina keeya; neaku ninye olaata entioto; neton ninye openy te wueji enye tiauluo ilng'borri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkitanapat naaipirta nkiporo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
