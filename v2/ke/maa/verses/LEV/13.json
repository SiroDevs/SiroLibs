          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naa tenejur olapolosani, neitu eitoki ina keeya adaari teilo kila oripuno anaa o too ntokitin naapiyaya, anaa oloripuno anaa pooki toki oo ndapan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
