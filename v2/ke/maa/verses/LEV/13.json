          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naa tenetii oltudutai osesen lo ltung'ani, neishiu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ine wueji apa oltudutai nejing ewueji naibor neteijia aashu ewueji oo ltipot ooibor o loo nyokie, nepuoi aaitodol olapolosani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore olapolosani nejur ine, naa teneliooyu egut alang olchoni lo sesen ore ilpapit leine neibelekenyate aaiborru neibalunye olapolosani ninye ajo olo lduruk, enkeeya oo lbolot ninye nayopua ilo tudutai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake tenejur olapolosani ine, ore ilpapit leine neitu eiborru neitu egutu alang olchoni lo sesen kake etunukunye neikenoo olapolosani ninye aiwuang'ie to lorere nkolong'i naapishana; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa tenedaari to lchoni lo sesen, netum taa olapolosani aibalunye ninye nchere oloiduruk; etijing'a ninye enkeeya oo olbolot. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake tenetoni lelo tipot te wueji nebo nemeponari naa enkiporoi ake oltudutai, neibalunye olapolosani ninye ajo meiduruk.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
