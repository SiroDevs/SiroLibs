              "HAB.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.41"
              },
              "items": [
                {
                  "text": "Iat 13.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ing'ura atua iloshon, pee idol; ning'asia nimputukuny. Amu aasita nanu esiaai too nkolong'i inyi, nimindimidimi intae aairuko tenelikini intae. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.2"
              },
              "items": [
                {
                  "text": "2 Int 24.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eng'ura, kailepunye nanu Ilkaldayo ilo osho odua neisosion, nelo aibulu enkop pooki, nepuonu aaya imanyishoritin neme nkunenye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iltung'ana ooitureisho ninche; ore isipat enye o nkiguanat enye naa ninche maate epukunye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eneneng mbartan enye aalang ilowuarak kerin, nepi aalang isuyian le nteipa; ore lakedok lenye loo mbartan nenyok oleng to lwuasa. Ee enelakua eing'uaa lakedok lenye loo mbartan, nepuo tiai anaa olkurragos oipirri alo ainos eng'ues. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eetuo pooki te nkaraki olarrabal; ore olkirutoto te nkaraki ninche nelo te dukuya ninche. Neiturrur ninche iyarunot anaa osinyai. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te dukuya ilaiguanak nesukenyisho ninche. Ore ilaitoriak neiguranie ninche. Ekueniyie ninche pooki sempewuet, amu kerup ninche enterit neya ine. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuo ninche neor, enkop epuo anaa olkutati, aapuo ninche eeta entioto, kulo tung'ana ooitaa engolon enye enkai enye.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enyaaka Habakuki aing'unyung'unyaki Olaitoriani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimira iyie oloo ntarasi, iyie Olaitoriani Enkai ai lo Sinyati lai? Mikiye iyiook, Olaitoriani itegelua iyie ninche aitaa iladung'ok le nkiguana; ore iyie na dapidapoi, nintasheyie ninche pee eitameisho. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyie oloata nkonyek sidain nemeidim aaing'ura entorroni nemeidim aaing'ura enkarruoisho, kainyoo iyie pee ing'or iltung'ana lemeisiligayu, nintirring'a iyie eijoo ilarruok, lelo supati aalang ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ntotiu iyie iltung'ana anaa sinkir le naiposha, anaa nena tokitin naaikurtutari nemeeta oloitore. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.14",
            "verseOrgIds": [
              "HAB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyau ninye ninche pooki to ltarge, neyietu ninche pooki to rreshet neiturrur ninche to rreshet lenye sapuk; netum taa atishipayu neitokoos. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkaraki ina eitayio ninye olasar te nkaraki orreshet lenye, nepej enkorropil te nkaraki orreshet lenye sapuk; amu te nkaraki ninche pee eishu ninye te sikar, nepir endaa enye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keitayu ninye lelo ootii orreshet lenye, near ninye iloshon metuata nemeing'urrie ntarasi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.17",
            "verseOrgIds": [
              "HAB.1.17"
            ]
          }
        }
      ]
    }
  ],
