          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entagolie ninche, ning'oring'oro ninche ometaba anaa nimpimipimi ninche te dukuya ilapolosak kituaak o Lawi o lukuny oo nkajijik oo loo menye te Israel te Yerusalem, tiatua ilgilat le nkaji o Laitoriani.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa eibung'a ilapolosak o Lawi enkipimore e nkosholai o sahabu o masaa, neyau ninche Yerusalem atua ina aji e Nkai ang.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Errinyunoto e Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
