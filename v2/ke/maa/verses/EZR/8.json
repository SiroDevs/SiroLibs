        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore teina kata lelo apa ooetuo eing'uaa eyararoto, lelo yararot ootorrinyunye, neishoru ilasarri oopejori aaisho Enkai e Israel, iloing'ok tomon oare tenkaraki Isiraeli pooki o lmeregeshi ntomoni naaudo o ile, o lkuoo le kerra ntomoni naapishana, neitayuni anaa olasar le ng'oki ilkineji tomon oare: ore kuna pooki naa ilasarri oopejokini Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyautua sii apa empalai naishorua olaiguanani aayaki ilkituaak o lbalusuni lo lkerenket otii teidia alo olkeju; neretu ninche iltung'ana o enkaji e Nkai.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
