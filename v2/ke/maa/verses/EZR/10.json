          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too layiok le Pahat-moab: netumi Adna, o Chelai, o Benania o Maaseia, o Matania, o Besalel, o Binui o Manase. ",
          "type": "text",
          "attrs": {
