          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too layiok le Satu netumi: Elioenai, o Eliashib, o Matania, o Yeremot o Sabad, o Asisa. ",
          "type": "text",
