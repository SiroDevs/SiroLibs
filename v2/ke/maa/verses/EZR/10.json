            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore too layiok le Elam netumi: Matania, o Sekaria, o Yehiel, o Abdi, o Yeremot o Eliya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.26",
