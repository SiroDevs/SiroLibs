              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepuoi kenya aajo te ina olong, “Ng'ura, Enkai ang ena; kitaanyutua apa iyiook ninye, pee elotu aitajeu iyiook. Olaitoriani ele, kitaanyutua iyiook ninye, mating'idata iyiook nikishipakino enjeunoto enye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keitame Olaitoriani Moab",
          "type": "text"
        }
      ]
    },
