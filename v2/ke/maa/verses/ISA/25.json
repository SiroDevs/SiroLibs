                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu kemitu enkaina Olaitoriani oldoinyo le Sion, naa kepuoi aaitunyoki Moab enkop te wueji enye, anaa enaitunyi olkujita te wueji olokidong'oi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kelo ninye aitorioo nkaik enyena te neitorit ninye, anaa enaitorioo nkaik o ltung'ani oisompira te nkare, kake kelo Olaitoriani airragie ilo wuasa lenye te nebo ina arriyiano oo nkaik enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nena sunta adoru e nkang enye nesulu ninye, neitadou, nenang'aki enkop, neitabaiki enterit.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
      ]
