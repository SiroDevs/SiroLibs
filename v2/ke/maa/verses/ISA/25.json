              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neijoo ninye keeya ntarasi, nejutoo Olaitoriani Enkai ilkiyio too nkomomi pooki, ore ina sulare oo ltung'ana lenyena neiwuang'ie ninye te nkop pooki; amu Olaitoriani oiroro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
