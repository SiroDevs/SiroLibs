        {
          "text": "Keisho Olaitoriani iltung'ana lenyena metimirisho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endung'okinoto e nkiguana o errinyunoto",
          "type": "text"
        }
