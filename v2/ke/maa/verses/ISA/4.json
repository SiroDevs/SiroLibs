              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore kenya te ina olong kesidanu olng'osila lo Laitoriani, ore lng'anayio le ina kop naa keaku esikar o enkitoo e ilo pisiai otelekua loo Siraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore ilo otelekua te Sion neton te Yerusalem, neipoti aajo sinyati, pooki ng'ae ake ninye oigeroki enkarna enye te nkaraki puaan te Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ina kata eidipa Olaitoriani aitukuo olduruk too ntoyie e Sion neitukuo iltipot lo sarge le Yerusalem, aiwuangie te mpolos enye, to ltau le nkiguana o to ltau le mpejoroto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
