              "items": [
                {
                  "text": "Ena 13.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Netum taa Olaitoriani aitobira te shumata o ldoinyo pooki le Sion o te shumata ilturrurri lenyena pooki enkatampoi te ndama, o empuruo o enkimerlel e nkima te nkewarie, amu ore te shumata naa kelo atii enkitushurata o lng'obor. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keaku ninye oloip te ndama te nkaraki enkirowuaj, o te nkaraki sii enesaruni o enelutori te nkaraki olkutati o enchan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
