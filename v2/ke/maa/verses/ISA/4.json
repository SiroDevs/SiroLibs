              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa keibung kenya nkituaak naapishana olee obo te ina olong ejo, “Eikinya iyiook endaa ang maate nikinchop nkilani ang maate, nchoo ake duoo eipotieki iyiook enkarna ino, iwuang'ie enkurruna ang.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keitasheyieki Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 4:1"
          },
          "items": [
