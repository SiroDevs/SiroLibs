              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.15+LEV.23.16+LEV.23.17+LEV.23.18+LEV.23.19+LEV.23.20+LEV.23.21"
              },
              "items": [
                {
                  "text": "Ilaw 23.15-21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.9+DEU.16.10+DEU.16.11"
              },
              "items": [
                {
                  "text": "Enkig 16.9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore pee ebau enkolong o Pentekoste, netii apa pooki ewueji nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.1",
            "verseOrgIds": [
              "ACT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nabo kata nelotu enkikurrukur naing'uaa keper neeijo eno lkutati, neiput ina aji pooki natii ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.2",
            "verseOrgIds": [
              "ACT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedol ninche entoki neeijo lng'ejepa le nkima eisuaari: neiseyie ake ina ng'ejep neeijo enkima o lng'ejep le pooki tung'ani otii ine. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.3",
            "verseOrgIds": [
              "ACT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neigany Enkiyang'et Sinyati ninche pooki neiteru aairo kulie kutukie, anaa enaidimie Enkiyang'et Sinyati meiroro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.4",
            "verseOrgIds": [
              "ACT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemanya Yerusalem Ilyahudi laa iltung'ana asayiak le Nkai, ooetuo ninche eing'uaa nkuapi pooki e nkop. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.5",
            "verseOrgIds": [
              "ACT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening ina kikurrukur neiturrurro olorora kitok. Neiputukuny neing'asia pooki amu meetae ake oleitu ening ninche eiro enkutuk naikini ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.6",
            "verseOrgIds": [
              "ACT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiputukuny neing'asia nejo, “Amaa kulo tung'ana aime Lgalilaya pooki! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.7",
            "verseOrgIds": [
              "ACT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aainyo naa pee kining'ito iyiook pooki eiro nkutukie ang naaikini iyiook? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.8",
            "verseOrgIds": [
              "ACT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "King'uaa iyiook Partia, Media, Elam; niking'uaa Mesopotamia, Yudea, o Kapodokia; niking'uaa Ponto o Asia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.9",
            "verseOrgIds": [
              "ACT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "niking'uaa Frigia o Pamfiliam niking'uaa Misiri o lkirinen le Libya o Kirene, neing'uaa kulikae lang Roma, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.10",
            "verseOrgIds": [
              "ACT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndung'ot pokira, Lyahudi o Loreren ooibelekenyate aaku Lyahudi; niking'uaa kulikae lang Krete o Arabia kake eji nikining pooki eiro ninche nkutukie ang eimaki mbaa kituaak naataasa Enkai!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.11",
            "verseOrgIds": [
              "ACT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eing'asiate pooki nemilo neikilikuana taa ake aajo, “Ainyoo eutu ena bae?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.12",
            "verseOrgIds": [
              "ACT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etii ilookueniyie ilairukok ejo, “Ketemerate kulo tung'ana!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilomon ooinosua Petero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.13",
            "verseOrgIds": [
              "ACT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake neinyototo Petero eboitare ninye lelo kulikae tomon o obo, neiteru airorie olorere to ltoilo sapuk ajoki, “Lo lewa lang loo Lyahudi, o intae pooki oomanya Yerusalem, entoning enajo, matoliki intae enautu ena bae. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.14",
            "verseOrgIds": [
              "ACT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitu emera kulo tung'ana anaa ina nijojo, ene uni ena saa anaa pee ekenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.15",
            "verseOrgIds": [
              "ACT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maa, enapa bae ena natolimuo oloiboni le Nkai oji Yoel pee ejo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.16",
            "verseOrgIds": [
              "ACT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.21",
            "verseOrgIds": [
              "ACT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lo lewa le Israeli! Entoning kulo rorei. Ore Yesu le Nasaretii, oltung'ani otisirua Enkai abaraki te intae too mbaa e ngolon o ine nking'asia o nkitoduaat o lmonek ooitaasa intae Enkai te nkaina enye; niyiololo intae ina amu atua intae etaasieki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.22",
            "verseOrgIds": [
              "ACT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.35"
              },
              "items": [
                {
                  "text": "Mat 27.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.24"
              },
              "items": [
                {
                  "text": "Mk 15.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.33"
              },
              "items": [
                {
                  "text": "Lk 23.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.18"
              },
              "items": [
                {
                  "text": "Yhn 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enkai openy natudutayie te yieunoto o te ng'eno enye makewan apake nchere, keitarasari Yesu, nitara intae ninye, aaisho ltung'ana arruok metasho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.5+MAT.28.6"
              },
              "items": [
                {
                  "text": "Mat 28.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.6"
              },
              "items": [
                {
                  "text": "Mk 16.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.5"
              },
              "items": [
                {
                  "text": "Lk 24.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake eitopiwuo Enkai ninye aitung'uaa ilootuata: nelaku aoru emion e keeya amu meidimayu apa neenikino enkeeya ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Olke 16.8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eimaka Daudi ninye nejo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilalashera laainei, enchooki maibalakinye intae ashirraki too mbaa e papa lang Daudi, Etua ninye, nenukari, netii enkurare enye atua iyiook o tene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.29",
            "verseOrgIds": [
              "ACT.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.11"
              },
              "items": [
                {
                  "text": "Olke 132.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12+2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O loiboni le Nkai apa metaa ketayiolo ina naisiligie Enkai ajoki, ore eishoi enye keikini likae aiguanani kitok oitoreisho anaa apa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.30",
            "verseOrgIds": [
              "ACT.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina etodolua Daudi naas kenya ake Enkai, paa keiroro aimaki empiunoto e Kristo pee ejo: ‘Eitu eing'uari ninye te nemeneng'a. Neitu epurda osesen lenye ang'uoyu.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ele Yesu likiimaki eitopiwuo Enkai aitung'uaa ilootuata, nikira iyiook lchakenini le ina bae. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.32",
            "verseOrgIds": [
              "ACT.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee eilepieki nepiki tatene e Nkai, neng'amu Enkiyang'et Sinyati te Menye anaa enatejo apake; naa ore ena nidolitata nining'itoto ina kishorunoto enye etubukoko iyiook. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.33",
            "verseOrgIds": [
              "ACT.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Olke 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eitu elo Daudi makewan keper; kake etejo ninye kewan, ‘Etiaka Olaitoriani Olaitoriani lai: Totona te tatene ai, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee aitadou ilmang'ati linono metotiutu anaa olorika loo nkejek inono.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.35",
            "verseOrgIds": [
              "ACT.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entayioloito naa taata enkaji pooki e Israel ena nadede nchere, ele Yesu, lishomo intae aashe to salaba, eitaa Enkai Olaitoriani o Kristo.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna ake etoning'o ninche nerem ilo rorei iltauja, nejoki Petero o lkulikae kipaareta, “Kaa naa kiaas, ilalashera lang?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Petero ninche, “Erridutu pooki tung'ani, neibatisai pooki te intae te nkarna e Yesu Kristo, pee epalakini intae ng'ok inyi; naa ing'amumu enkishorunoto e Enkiyang'et Sinyati. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore ena kisiligata eninyi apa o nkera inyi, o lelo pooki oolakua lelo pooki ooipotoki Enkai kewan.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitirrishaki Petero aitadedeyie te kulie baa kumok, nejoki, “Entajeu ate te ina nainepu kulo tung'ana arruok.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.40",
            "verseOrgIds": [
              "ACT.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiruk ilkumok nena baa naainosua ninye, neibatisai; neponikini ilo turrur iltung'ana oobaya nkalifuni uni te ina olong. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.41",
            "verseOrgIds": [
              "ACT.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ketumo ninche anaa ake te nkiteng'enare oo lkipaareta, neshulare aaisiritore, neng'arie endaa, neshulare te nkomono.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enataasa lelo ooiruko Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
