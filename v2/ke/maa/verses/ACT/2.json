      },
      "items": [
        {
          "text": "Elotunoto e Nkiyang'et Sinyati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
