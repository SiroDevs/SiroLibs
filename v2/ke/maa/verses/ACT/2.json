        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.42",
            "verseOrgIds": [
              "ACT.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejing aiput enkuretisho pooki ng'ae; neasi inenking'asia, olmonek too lkipaareta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
              "ACT.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.32+ACT.4.33+ACT.4.34+ACT.4.35"
              },
              "items": [
                {
                  "text": "Iat 4.32-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nebik ilairukok pooki te nebo te nchula neyau masaa enye aang'ar. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku kemir masaa enye o ntokitin naata neorikino pooki mpesai, anaa enaatayie oltung'ani enkolat. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netumo anaa ake ilo turrur te nkaji e Nkai, neng'ar ndaiki too nkajijik enye, neng'ida edaa to ltau obo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "neisis Enkai, neshipakino iltung'ana pooki ninche. Neponaa Olaitoriani ilo turrur lenye anaa ake te lelo ooitajeuni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.47",
            "verseOrgIds": [
              "ACT.2.47"
            ]
          }
        }
