                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore Aleksanta ele kunoni loo suyan aaitaasa ntorrok oleng, keitalak Olaitoriani te nkaraki nkiaasin enyena. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torripo naa kewan te ninye amu etishirraka aany olkilikuai lang. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa ang'orito kewan te dukuya metii hoo obo laatijing'a enkoriong; aatung'uatie pooki. Oi ake eaku meikenakini ninche ena!",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        }
      ]
