              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eitasho Olaitoriani te nkalo ai, naaisho nanu engolon nalimunye ororei te lulung'ata, pee etum iloreren pooki aatoning, neaku aatang'adieki enkutuk o lng'atuny. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.17",
            "verseOrgIds": [
              "2TI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee kaakordu Olaitoriani te ntorroni ake pooki naitajeu aaitaany ina kitoo enye e shumata metaa enenye enkitoo ntarasi o ntarasi. Eesai.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        }
      ]
    },
