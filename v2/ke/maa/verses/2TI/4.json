                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore te nilotu iyie nishoru olkila apa latung'ueikia Karpo te Troas o mbukui sii neisulaki nena oo ndapan. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
