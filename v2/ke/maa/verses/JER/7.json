          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Entudung'oi ilpapit linyi ninturraa; to sina elepie olkiyioi too nkisiajat naaika; amu etanya Olaitoriani netung'uayie ina ishoi e ngoro enye napi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
