          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amu etaasa ilaiyiok le Yuda entorroni too nkonyek aainei, Olaitoriani ojo; etipika ninche ilo minong lenye atua enkaji naa ninye eipotieki enkarna ai, pee eisarkionie ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
