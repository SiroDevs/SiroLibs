              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ele rorei lo Laitoriani oewuo enetii Yeremia eipirta olameyu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki nanu Olaitoriani, “Miomon tenkaraki olmabarishoi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14.11",
              "type": "text"
            },
            {
              "text": "olmabarishoi",
              "type": "text"
            },
            {
              "text": "oltonie sidai teneitobira imbaa enye pooki",
              "type": "text"
            }
          ]
        },
        {
          "text": " le kulo tung'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore hoo neen ate aaitupukoo, maning nanu olkiyioi lenye, naa ore hoo neishoru ninche ilasarri oopejori o lasar le ntapa, mang'amu nanu ninche; kake kamut nanu ninche to lalem, o to lameyu o tolmeitai.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo nanu; “Oi Olaitoriani Enkai, ng'ura, ejoki iloibonok ninche, ‘Midolidolo intae olalem arashu itumutumu olameyu, kake kaisho nanu intae eseriani nadede tiatua ene wueji.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki nanu Olaitoriani: “Elejare eibonu lelo oibonok tenkarna ai: eitu nanu airriwaa ninche, neitu nanu aitanap ninche arashu airorie ninche. Kimbonokito ninche iyie enduaata e lejare, o enaibon e pesho, o elejare oo ndamunot enye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa nji ejo Olaitoriani tialo lelo oibonok ooibonisho te nkarna ai hoo neitu nanu airriwaa ninche, o lelo oojo melotu olalem arashu olameyu ena kop: to lalem o to lameyu emuti lelo oibonok. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo tung'ana laa ninche eibonoki nenang'ari boo tiatua nkoitoi e Yerusalem, pee ear ninche olameyu o lalem, metii hoo obo onukaa ninche o nkituaak enye, o layiok lenye o ntoyie enye. Amu kabukoki nanu entorroni enye shumata ninche.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.16",
            "verseOrgIds": [
              "JER.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etasayia iltung'ana Olaitoriani",
          "type": "text"
        }
      ]
    }
  ],
