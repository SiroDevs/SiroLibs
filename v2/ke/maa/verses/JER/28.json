        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia o loiboni oji Hanania",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
