          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifelet olayioni le Ahasbai le Maaka, Eliam olayioni le Ahitofel le Gilo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
