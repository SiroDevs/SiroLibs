        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
