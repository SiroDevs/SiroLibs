  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiengʼ ochungʼ kar tiende",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Adoni-Zedek ruodh Jerusalem nowinjo ni Joshua osekawo Ai mi okethe chuth kendo onego ruodhe mana kaka nosetimone Jeriko kendo ni jo-Gibeon osetimo winjruok mar kwe gi jo-Israel mi gidak butgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.1",
            "verseOrgIds": [
              "JOS.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En gi joge ne gibuok ahinya kuom wachni nikech Gibeon ne en dala maduongʼ mongirore, mana kaka achiel kuom mier madongo maka ruoth. Ne oduongʼ moloyo Ai, kendo joge duto ne gin jokedo mabeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.2",
            "verseOrgIds": [
              "JOS.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Adoni-Zedek ruodh Jerusalem nokwayo Hoham, ruodh Hebron, Piram ruodh Jarmuth, Jafia ruodh Lakish kod Debir ruodh Eglon niya,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.3",
            "verseOrgIds": [
              "JOS.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Biuru mondo ukonya monjo Gibeon nikech oseloso kwe kod Joshua gi jo-Israel.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.4",
            "verseOrgIds": [
              "JOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ruodhi abich mar jo-Amor; ruodhi ma Jerusalem, Hebron, Jarmuth, Lakish to gi Eglon noriwo jolwenjgi kaachiel. Negidhi kod jolweny mag-gi mi gimonjo Gibeon kendo gikedo kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Gibeon nooro wach ni Joshua e kambi man Gilgal niya, \"Kik ijwangʼ jotichgi. Bi irwa piyo mondo ireswa! Konywa nikech ruodhi jo-Amor duto moa e piny manie wi got oseriwore mondo omonjwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.6",
            "verseOrgIds": [
              "JOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Joshua kaachiel gi jolweny mage mathuondi nowuok Gilgal mapiyo nono mondo odhi oresgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.7",
            "verseOrgIds": [
              "JOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowachone Joshua niya, \"Kik iluorgi; asechiwogi e lwetu. Onge kata ngʼata achiel kuomgi mabiro sirou.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.8",
            "verseOrgIds": [
              "JOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gisewuotho otieno duto ka gia Gilgal, Joshua nomonjogi apoya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.9",
            "verseOrgIds": [
              "JOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nomiyo gichalo joma orundore e nyim jo-Israel, mine giloyogi gi loch maduongʼ e Gibeon. Jo-Israel nolawogi ka giluwo yo madhi Beth Horon mi ginegogi ma gichopo kodgi nyaka Azeka kod Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.10",
            "verseOrgIds": [
              "JOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde mane giringo e nyim jo-Israel e yo moa Beth Horon kadhi Azeka, Jehova Nyasaye nolwaro pe madongo kuomgi koa e polo kendo thothgi nomedo tho nikech peno nonego ji mangʼeny moloyo mago mane jo-Israel onego gi ligangla.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ mane Jehova Nyasaye ochiwo jo-Amor ni jo-Israel, Joshua nowachone Jehova Nyasaye e nyim jo-Israel niya,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "\"Yaye wangʼ chiengʼ, chungʼ kar tiendi ewi Gibeon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "to in dwe, chungʼ mana ewi holo mar Aijalon.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo wangʼ chiengʼ nochungʼ kar tiende,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "to dwe bende ne ok osudo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "nyaka oganda mar jo-Israel nochulo kuor kuom wasikgi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "mana kaka nondike e Kitap Jashar.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "Wangʼ chiengʼ nosiko kochungʼ e polo kuom thuolo madirom odiechiengʼ achiel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge odiechiengʼ machal gi ma manosebetie ma Jehova Nyasaye nowinje kwayo mar dhano. Adier, adier Jehova Nyasaye ne kedo ni jo-Israel!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Joshua noduogo gi jo-Israel duto e kambi man Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruodhi abich mag Amor onegi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ruodhi abichgo noringo kendo gipondo e rogo mantiere Makeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.16",
            "verseOrgIds": [
              "JOS.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane owach ne Joshua ni ruodhi abichgo nopondo e rogo mar Makeda,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.17",
            "verseOrgIds": [
              "JOS.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nowacho niya, \"Dinuru dho rogono gi kidi maduongʼ kendo uket jomoko kanyo mondo orite.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.18",
            "verseOrgIds": [
              "JOS.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un to kik uchungʼ kanyo, lawuru wasiku, monjgiuru kua gichien kendo kik uwegi gichop e miechgi madongo, nikech Jehova Nyasaye ma Nyasachu osechiwogi e lwetu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Joshua kod jo-Israel notiekogi chuth makmana joma tin ema nodongʼ e miechgi madongo mochiel kod ohinga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.20",
            "verseOrgIds": [
              "JOS.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolweny duto noduogo ir Joshua e kambi man Makeda maonge hinyruok moro, kendo onge ngʼama nowuoyo marach kuom jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nowacho niya, \"Yawuru dho rogono kendo ugol ruodhi abichgo oko mi ukelgi ira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo negigolo ruodhi abichgo oko mi gikelogi, ne gin ruodh Jerusalem, Hebron, Jarmuth, Lakish kod Eglon.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gisekelo ruodhigi ne Joshua, noluongo jo-Israel duto kendo owachone jotend lweny mane obiro kode niya, \"Biuru ka kendo unyon ngʼut ruodhigi.\" Omiyo negibiro mi ginyono ngʼutgi piny.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nowachonegi niya, \"Kik uluor, kendo kik chunyu nyosre. Beduru motegno kendo gi chir. Ma e gima Jehova Nyasaye biro timo ne wasigu duto ma ubiro kedogo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Joshua nomonjogi mi onego ruodhigo kendo olierogi e yien abich. Nowegi ka giliero e yiendego nyaka odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane chiengʼ osepodho, Joshua nogolo chik mondo olor ringregi e yiende mane oliergie kendo odirgi e rogo kama negisepondoe. Negidino dho rogono gi kite madongo, ma pod ni kanyo nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengno Joshua nokawo Makeda. Notieko dala maduongʼno kod ruodhe gi ligangla kendo otieko ngʼato angʼata mane ni e iye. Onge ngʼama notony kanyo. Notimone ruodh Makeda mana kaka notimone ruodh Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olo mier madongo man milambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joshua kod jo-Israel duto mane ni kode nodhi Libna koa Makeda mi omonje.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nochiwo dala maduongʼni bende kod ruodhe e lwet jo-Israel. Dala maduongʼni to gi jogo duto modak e iye Joshua nonego gi ligangla. Onge ngʼama notony kanyo. Notimone ruodhgi mana kaka notimone ruodh Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joshua kod jo-Israel duto mane ni kode nodhi Lakish koa Libna; mi gimonje.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nochiwo Lakish ne jo-Israel, to Joshua to ne okawe e odiechiengʼ mar ariyo. Dala maduongʼno kod ji duto modak kanyo nonego gi ligangla, mana kaka ne otimone Libna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, Horam ruodh Gezer nobiro mondo okony Lakish, to Joshua noloye kaachiel gi jolweny mage maonge ngʼama notony.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joshua gi jo-Israel mane ni kode nodhi Eglon koa Lakish mi gimonje.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gikawe odiechiengʼ nogono mi ginego ji duto kendo giketho gimoro amora mangima manie iye, mana kaka negisetimone Lakish.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joshua gi jo-Israel mane ni kode nodhi Hebron koa Eglon, mi gimonje.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negikawo dala maduongʼno mi ginego ruodhe kod gimoro amora mangima mane ni kuno kaachiel gi mago mane nitie e mier matindo mokiewo kode. Onge ngʼama notony, mana kaka ne otimone Eglon.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joshua gi jo-Israel mane ni kode noduogo mi omonjo Debir.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negikawo dala maduongʼno, ruodhe kod mier matindo mokiewo kode mi ginegogi. Ji duto mane odak kanyo negitieko chuth kendo onge joma notony. Negitimone Debir kod ruodhe mana kaka negitimone Libna gi ruodhe, to gi Hebron.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Joshua nokawo gwengʼno duto kaachiel gi piny manie got ma en Negev, e tiend gode ma yo podho chiengʼ, to gi kuonde mag pewe kaachiel gi ruodhigi duto. Onge joma notony. Notieko jogo duto mangima, mana kaka Jehova Nyasaye, ma Nyasach Israel, nosechiko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nokawogi koa Kadesh Barnea nyaka Gaza kendo koa e gwenge duto ma Goshen nyaka Gibeon.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nomako ruodhigo duto kaachiel gi pinjegi e lweny achielno nimar Jehova Nyasaye, ma Nyasach Israel, nokedo ni joge.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Joshua noduogo gi jo-Israel duto e kambi man Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
      ]
    }
  ],
