{
  "id": "NUM.19",
  "number": "19",
  "bookId": "NUM",
  "reference": "Kwan 19",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "NUM 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pi mar pwodhruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho ne Musa gi Harun niya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.1",
            "verseOrgIds": [
              "NUM.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma e dwaro mar chik ma Jehova Nyasaye osechiko: Nyis jo-Israel mondo okel nyaroya ma silwal maonge songa kata ma ok ongʼol kendo mapok otwe e jok.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwe ne Eliazar jadolo; kendo nyaroyano nyaka gol oko mar kambi mi yangʼe ka oneno.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Eliazar jadolo nyaka kaw rembe moko e lith lwete kendo okwoye nyadibiriyo kochiko nyim Hemb Romo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde ma pod ongʼicho nyaroyano nyaka wangʼ piende, ringe, rembe kod wen.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jadolo nokaw yiende moko mag sida, owino gi usi marakwaro kendo owitgi kuom nyaroya ma wangʼno.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano, jadolo nyaka luok lepe kendo olwokre gi pi. Bangʼe onyalo donjo e kambi, makmana ni obiro bedo mochido nyaka chop odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno mowangʼo nyaroyano bende nyaka luok lepe, kendo olwokre, en bende nobed mochido nyaka chop odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngʼat maler nochok buru mag nyaroyano kendo oketgi kar misango maler e oko mar kambi. Ginikan-gi gi dhout oganda mar jo-Israel mondo ti kodgi e pi pwodhruok; nikech en mar pwodho ji aa e richo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno mochoko buch nyaroyano nyaka luok lepe bende, to en bende nobed mochido nyaka chop odhiambo. Ma nobedi chik mosiko ne jo-Israel kaachiel gi jopinje mamoko modak kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngʼato angʼata momulo ringre ngʼama otho biro bedo mochido kuom ndalo abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka opwodhre owuon gi pi chiengʼ mar adek kod chiengʼ mar abiriyo; eka obiro bedo maler. To ka ok opwodhore owuon chiengʼ mar adek gi chiengʼ mar abiriyo, to ok obi bedo maler.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato angʼata momulo ringre ngʼama otho kendo ma ok opwodhore owuon ochido hekalu mar Jehova Nyasaye. Ngʼatno nyaka gol oko mar Israel. Nikech pi mar pwodhruok pod ok okir kuome, ochido; kendo chidono odongʼ kuome.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chik momako ngʼama otho e hema ema: Ngʼato angʼata modonjo ei hema kendo ngʼato angʼata mantiere e iye nobed mochido kuom ndalo abiriyo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo mikebe moro amora maonge raum moumego nobed mochido.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngʼato angʼata man oko momulo ngʼatno mane onegi gi ligangla kata ngʼat motho kende, kata ngʼatno momulo chok dhano, kata liel, nobedi mochido kuom ndalo abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ne ngʼatno mochido, ket buru moko moa e misango mar pwodhruok kendo uruw gi pi maler mi uol e wigi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ngʼatno maler nokaw owino, gilute e pi kendo gikuo pi e hema kod e gik moko duto molosgo ii hekalu gi ji man kanyo. Bende nyaka okwo pi kuom ngʼato angʼata mabed ni osemulo chok ngʼama osetho kata liel kata ngʼato ma osenegi kata ngʼato motho athoya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat maler ema nyaka kir pi kuom ngʼat mochidono chiengʼ mar adek gi mar abiriyo, to kochopo e odiechiengʼ mar abiriyo nyaka opwodhe. Ngʼama ipwodhono nyaka luok lepe kendo luokre gi pi, kendo odhiambono nobed mapoth.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.19",
            "verseOrgIds": [
              "NUM.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ngʼat mochido ok opwodhore owuon, nyaka gole oko e dier oganda, nikech osemiyo kama ler mar lemo mar Jehova Nyasaye ochido. Pi pwodhruokgo pod ok okir kuome, omiyo ochido.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik mosiko ne gin ema.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 19:21"
      },
      "items": [
        {
          "text": "\"Ngʼat mokiro pi mar pwodhruok nyaka luok lepe bende, kendo ngʼato angʼata momulo pi mar pwodhruok nobed mochido nyaka chop odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimoro amora ma ngʼat mochido omulo nobed mochido, kendo ngʼato angʼata momule nobed mochido nyaka chop odhiambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.22",
            "verseOrgIds": [
              "NUM.19.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NUM.20",
    "number": "20",
