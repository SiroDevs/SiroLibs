              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa Kibroth Hatava, ji nodhi nyaka Hazeroth kendo negidak kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
