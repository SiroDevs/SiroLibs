          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo duto mane odak e dala Dan noromo ji alufu mia achiel gi piero abich gabiriyo, gi mia auchiel (157,600). Gin ema giniwuogi mogik kaluwore gi rangʼiny moketi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
