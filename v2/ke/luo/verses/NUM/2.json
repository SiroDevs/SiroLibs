              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Naftali noromo ji alufu piero abich gadek gi mia angʼwen (53,400).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        }
      ]
    },
    {
