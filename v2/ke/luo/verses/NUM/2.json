  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NUM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chenro mar kuonde dak mag dhoudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho ne Musa gi Harun niya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jo-Israel nyaka chokre kolworo Hemb Romo kochwalore matin kode, ka ngʼato ka ngʼato ni e bwo jatendgi kod gima ondikie nying dhoodgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa yo wuok chiengʼ,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:3"
      },
      "items": [
        {
          "text": "migepe mag joka Juda nodag kanyo kaluwore gi rangʼiny moketi. Jatend Juda ne en Nashon wuod Aminadab.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Juda ne romo ji alufu piero abich gangʼwen gi mia angʼwen (74,600).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhood Isakar nodag butgi. Jatend dhood Isakar ne en Nethanel wuod Zuar.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Isakar ne romo ji alufu piero abich gangʼwen gi mia angʼwen (54,400).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhood Zebulun noluwogi. Jatend dhood Zebulun ne en Eliab wuod Helon.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Zebulun ne romo ji alufu piero abich gabiriyo gi mia angʼwen (57,400).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo duto mane odak e dala Juda, kaluwore gi migepegi, ne romo ji alufu mia achiel gi piero aboro gauchiel gi mia angʼwen (186,400). Gin e joma biro wuok motelo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa yo milambo nobedie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:10"
      },
      "items": [
        {
          "text": "migepe mag Reuben kaluwore gi rangʼiny moketi. Jatend dhood Reuben ne en Elizur wuod Shedeur.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Reuben ne romo ji alufu piero angʼwen gauchiel gi mia abich (46,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhood Simeon nodag butgi. Jatend dhood Simeon ne en Shelumiel wuod Zurishadai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Simeon ne romo ji alufu piero abich gochiko gi mia adek (59,300).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluwogi ne en dhood Gad. Jatend dhood Gad ne en Eliasaf wuod Reuel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Gad ne romo ji alufu piero angʼwen gabich gi mia auchiel gi piero abich (45,650).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo duto mane odak e dala Reuben, kaluwore gi migepe mag-gi, noromo ji alufu mia achiel gi piero abich gachiel, mia angʼwen gi piero abich (151,450). Gin ema giniwuogi mar ariyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Hemb Romo kod kar dak mar jo-Lawi noket e dier kambe mamoko. Ginichanre mana kaka kuondegi mag bworo ochanore ka jomoko ka jomoko ni kargi giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa yo podho chiengʼ nobedie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:18"
      },
      "items": [
        {
          "text": "migepe mag Efraim kaluwore gi rangʼiny moketi. Jatend dhoodno ne en Elishama wuod Amihud.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18",
            "verseOrgIds": [
              "NUM.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Efraim noromo ji alufu piero angʼwen gi mia abich (40,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhood Manase ema nobed butgi. Jatend dhoodno ne en Gamaliel wuod Pedazur.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Manase noromo ji alufu piero adek gariyo gi mia ariyo (32,200).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluwogi ne en dhood Benjamin. Jatend dhood Benjamin ne en Abidan wuod Gideoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Benjamin noromo ji alufu piero adek gabich gi mia angʼwen (35,400).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo duto mane odak e dala Efraim, kaluwore gi migepe mag-gi noromo ji alufu mia achiel gaboro gi mia achiel (108,100). Gin ema ne giwuok mar adek.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa yo nyandwat nobedi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:25"
      },
      "items": [
        {
          "text": "migepe mag kuonde dak mag Dan, kaluwore gi rangʼiny moketi. Jatend dhood Dan en Ahiezer wuod Amishadai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Dan noromo ji alufu piero auchiel gariyo gi mia abiriyo (62,700).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluwogi ne en dhood Asher. Jatend dhood Asher ne en Pagiel wuod Okran.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Migawo mar dhood Asher noromo ji alufu piero angʼwen gachiel gi mia abich (41,500).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluwogi ne en dhood Naftali. Jatend dhood Naftali ne en Ahira wuod Enan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
          "name": "verse",
