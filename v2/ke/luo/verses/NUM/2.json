        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo jo-Israel notimo gik moko duto mane Jehova Nyasaye ochiko Musa; mano e yo mane gichokore godo e rangʼiny mag-gi giwegi, kendo mano e kaka negichokore, moro ka moro gi dhoodgi kod joge.",
          "type": "text",
