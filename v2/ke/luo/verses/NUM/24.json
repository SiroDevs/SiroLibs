      "attrs": {
        "style": "q1",
        "vid": "NUM 24:20"
      },
      "items": [
        {
          "text": "\"Amalek ema ne okwongo kuom ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
