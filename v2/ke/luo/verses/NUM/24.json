      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:21"
      },
      "items": [
        {
          "text": "\"Kar dak mari nigi kwe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        }
      ]
