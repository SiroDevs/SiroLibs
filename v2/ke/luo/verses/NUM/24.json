      "attrs": {
        "style": "q2",
        "vid": "NUM 24:21"
      },
      "items": [
        {
          "text": "kari mar pondo ni e bwo lwanda;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
