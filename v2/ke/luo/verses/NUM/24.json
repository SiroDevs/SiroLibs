          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anene, to ok sani;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
