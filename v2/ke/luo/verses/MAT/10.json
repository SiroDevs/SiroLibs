        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji duto nochau nikech an, to ngʼat ma ochungʼ motegno nyaka giko ema noresi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.22",
                "verseOrgIds": [
                  "MAT.10.22"
