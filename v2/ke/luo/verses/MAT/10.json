        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik upar ni asebiro mondo akel kwe e piny. Ne ok abiro mondo akel kwe, to nabiro mondo akel ligangla.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.34",
