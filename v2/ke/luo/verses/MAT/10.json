              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kendo ngʼato angʼata ma ok kaw msalape mondo oluwa ok owinjore koda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.38",
                "verseOrgIds": [
                  "MAT.10.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼatno momako ngimane matek, ngimane biro lalne; to ngʼatno mowito ngimane, nikech an, biro yude.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.39",
                "verseOrgIds": [
                  "MAT.10.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
