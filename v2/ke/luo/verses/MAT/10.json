        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omiyo kik uluorgi. Onge gimoro mopandi ma ok nofweny, kata malingʼ-lingʼ ma ok nongʼere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.26",
                "verseOrgIds": [
                  "MAT.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gima anyisou kama opondo, wuouru kuome e ler; kendo gima akuodhonu e tie itu, huluru matek ewi udi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.27",
                "verseOrgIds": [
                  "MAT.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
