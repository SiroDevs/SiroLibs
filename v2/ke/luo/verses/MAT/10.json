          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ngʼato angʼata mokweda e nyim ji an bende nakwede e nyim Wuora manie polo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.33",
                "verseOrgIds": [
                  "MAT.10.33"
