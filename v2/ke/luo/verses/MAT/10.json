        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Japuonjre ok duongʼ moloyo japuonjne, kata jatich bende ok duongʼ moloyo ngʼama ruodhe motiyone.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.24",
                "verseOrgIds": [
                  "MAT.10.24"
                ]
              }
            }
          ]
