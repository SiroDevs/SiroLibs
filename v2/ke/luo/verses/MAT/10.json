              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kik uluor jogo manego ringruok to ok nyal nego chuny. To ngʼama onego uluor en Jal manyalo tieko chuny kaachiel gi ringruok e gehena.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.28",
                "verseOrgIds": [
                  "MAT.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
