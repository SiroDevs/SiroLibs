              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bende, kata mana yie wiu duto osekwan mongʼe kar rombgi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.30",
                "verseOrgIds": [
                  "MAT.10.30"
