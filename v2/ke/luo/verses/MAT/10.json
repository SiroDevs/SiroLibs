            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼato angʼata mohero wuon-gi kata min-gi moloya ok owinjore koda. Kamano bende, ngʼato angʼata mohero wuode kata nyare moloya ok owinjore koda;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.37",
                "verseOrgIds": [
                  "MAT.10.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
