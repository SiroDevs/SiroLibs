          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wasik ngʼato nobed joode owuon.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.36",
                "verseOrgIds": [
                  "MAT.10.36"
