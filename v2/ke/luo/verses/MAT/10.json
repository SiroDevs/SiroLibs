          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omiyo kik uluor, nikech uloyo oyundi nyadi mangʼeny.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.31",
                "verseOrgIds": [
                  "MAT.10.31"
                ]
              }
