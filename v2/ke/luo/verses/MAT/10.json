          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼato angʼata morwako janabi, nikech en janabi, noyud pok ma janabi yudo, kendo ngʼato angʼata morwako ngʼama kare, nikech en ngʼama kare, noyud pok ma ngʼama kare yudo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.41",
                "verseOrgIds": [
                  "MAT.10.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.41",
            "verseOrgIds": [
              "MAT.10.41"
            ]
          }
        },
        {
