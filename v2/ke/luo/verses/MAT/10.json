          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka isandou kamoro, to daruru kanyo udhi kamachielo. Awachonu adier ni ok unutiek dhi e mier duto mag Israel kapok Wuod Dhano obiro.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.23",
                "verseOrgIds": [
                  "MAT.10.23"
                ]
              }
            }
