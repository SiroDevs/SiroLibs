          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼat morwakou orwaka, kendo ngʼama orwaka, orwako jal ma noora.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.40",
                "verseOrgIds": [
                  "MAT.10.40"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.40",
            "verseOrgIds": [
              "MAT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
