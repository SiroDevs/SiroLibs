          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼato angʼata mohulo ni ongʼeya e nyim ji, an bende abiro hulo ni angʼeye e nyim Wuora manie polo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.32",
