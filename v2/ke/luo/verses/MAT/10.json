          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyundi ariyo donge ingʼiewo otonglo achiel? To kata kamano kata achiel kuomgi ok nyal lwar piny e lowo ka ok Wuonu ema oyie.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.29",
                "verseOrgIds": [
                  "MAT.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
