          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bende ka ngʼato angʼata omiyo achiel kuom jomatindogi kata mana pi mangʼich gi kikombe, nikech en japuonjrena, to awachonu adier ni pokne ok nobaye ngangʼ.\"",
              "type": "text",
              "attrs": {
