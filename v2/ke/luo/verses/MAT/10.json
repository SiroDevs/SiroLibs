        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ber mondo japuonjre obed machal gi japuonjne, kendo ka jatich obedo machal gi ruodhe. Ka oseluong jatend ot ni Belzebub, koro jokanyo mag ode to ibiro luong kamano marom nade!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.25",
                "verseOrgIds": [
                  "MAT.10.25"
                ]
              }
            }
          ]
        }
