              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unune malit un jopuonj chik gi jo-Farisai mawuondoregi! Uchiwo achiel kuom apar mar gik ma milimili kaka kado, apoth kod onyulo. To ok usedewo gik madongo moloyo ma chik dwaro, kaka adiera gi kech kod yie. Owinjore ne utim gik ma achien-go ka ok uweyo mak utimo mokwongogo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.23",
                "verseOrgIds": [
                  "MAT.23.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Un jotelo ma muofnigi! Ungʼudho kikun to ngamia to umuonyo!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.24",
                "verseOrgIds": [
                  "MAT.23.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unune malit un jopuonj chik gi jo-Farisai mawuondoregi! Ulwoko ngʼe kikombe gi bakul, to gi e chunygi to gipongʼ gi wuoro kod anjawo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.25",
                "verseOrgIds": [
                  "MAT.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Jo-Farisai ma muofnigi! Kuong ulwok i kikombe gi bakul, eka ngʼegi oko bende biro bedo maler.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.26",
                "verseOrgIds": [
                  "MAT.23.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unune malit un jopuonj chik gi jo-Farisai mawuondoregi! Uchalo liete mowir marachar, manenore maber gi oko, to gie iyegi to gipongʼ gi choke joma otho kod gimoro amora mogak.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kamano e kaka un bende unenoru ne ji ni un joma beyo gioko, to gie iu to upongʼ gi wuondruok kod timbe maricho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.28",
                "verseOrgIds": [
                  "MAT.23.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unune malit un jopuonj chik gi jo-Farisai mawuondoregi! Ugero mi umwon liete jonabi kendo ugoro maber liete joma kare.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.29",
                "verseOrgIds": [
                  "MAT.23.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bende uwacho ni, 'Ka dine bed ni wangima e ndalo mag kwerewa, dine ok wariwore kodgi e chwero remb jonabi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuom mano ungʼado buchu uwegi ni un nyikwa joma nonego jonabi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.31",
                "verseOrgIds": [
                  "MAT.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kara koro dhiuru mana nyime gi chopo okangʼ mar richo mane kwereu ochako!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.32",
                "verseOrgIds": [
                  "MAT.23.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
