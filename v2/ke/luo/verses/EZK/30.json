        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro olo mirimba mager kuom Pelusiuma",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
              "EZK.30.15"
            ]
          }
        }
      ]
    },
