{
  "id": "EZK.30",
  "number": "30",
  "bookId": "EZK",
  "reference": "Ezekiel 30",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EZK 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wer miywagogo Misri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach Jehova Nyasaye nobirona kama:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wuod dhano, kor wach ni, 'An Jehova Nyasaye Manyalo Gik Moko Duto wacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "\" 'Ywaguru kendo uwach niya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "\"Mano kaka masira maduongʼ nobed chiengʼno!\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar odiechiengno osudo machiegni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "adier odiechiengʼ Jehova Nyasaye chiegni;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "enobed odiechiengʼ ma piny dudoe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "ma en kinde mar masira ne ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lweny nobed e piny Misri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "kendo Kush nobed gi rem malit.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "Ji notho e piny Misri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "to mwandugi noyaki,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "kendo mise mag-gi nomuki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kush gi Put, gi Lidia gi Arabia duto; kod Libya gi jopiny singruok bende nopodhi e dho ligangla kaachiel gi Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "\" 'Jokor Misri nopodhi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "kendo tekone mosungorego norem.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "Chakre Migdol nyaka Aswan",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "Ginipodhi duto e dho ligangla manie diergi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:6"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginidongʼ gunda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "e kind pinje modongʼ gunda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "kendo miechgi madongo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:7"
      },
      "items": [
        {
          "text": "nokethre e kind mier madongo mokethore.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka kinde ma anatiek Misri gi mach,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:8"
      },
      "items": [
        {
          "text": "kendo aneg joma konye,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:8"
      },
      "items": [
        {
          "text": "eka giningʼe ni An e Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'E odiechiengno joote nodhi koa ira e yiedhi mondo obwog jo-Kush modak kodhialore. Achiedh-nade nomakgi chiengʼ mikethoe Misri, nikech gino biro timore adier.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:10"
      },
      "items": [
        {
          "text": "\" 'Abiro keto giko mar oganda maduongʼ mar jo-Misri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:10"
      },
      "items": [
        {
          "text": "ka atiyo gi lwet Nebukadneza ruodh Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "En kaachiel gi jolweny mage,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "ma gin joma mirimbgi ger moloyo ogendini duto,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "nokel mondo otiek ji e pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "Giniked gi jo-Misri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:11"
      },
      "items": [
        {
          "text": "kendo piny nopongʼ gi joma onegi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo aore mag Nael dwon,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "kendo abiro jwangʼo pinyno e lwet joma richo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "Abiro loko piny gunda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "kaachiel gi gik moko duto manie iye",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:12"
      },
      "items": [
        {
          "text": "ka atiyo gi lwet ogendini mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
    {
