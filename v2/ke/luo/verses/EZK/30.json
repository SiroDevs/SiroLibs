            "number": "13",
            "style": "v",
            "sid": "EZK 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "\" 'Abiro ketho nyiseche ma dhano oloso",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "kendo abiro tieko kido molosi man Memfis.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "Onge ruoth ma nobed gi loch e piny Misri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:13"
      },
      "items": [
        {
          "text": "kendo abiro miyo luoro landre e pinyno duto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo yo ka Malo mar Misri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        },
        {
          "text": "doko gunda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:14"
      },
      "items": [
        {
          "text": "Zoan to abiro chinyoe mach,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        }
