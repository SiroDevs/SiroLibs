      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:16"
      },
      "items": [
        {
          "text": "Koth maduongʼ nochwe Thebes mamuk ohinga mare;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.16",
            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
        }
      ]
    },
    {
