      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:15"
      },
      "items": [
        {
          "text": "en kar konyruok mar Misri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
              "EZK.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:15"
      },
      "items": [
        {
          "text": "kendo abiro tieko oganda maduongʼ modak Thebes.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
              "EZK.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
