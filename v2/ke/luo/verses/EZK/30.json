          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro moko mach kuom Misri;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.16",
            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
