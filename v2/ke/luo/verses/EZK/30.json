      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:14"
      },
      "items": [
        {
          "text": "to Thebes to abiro kumo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
