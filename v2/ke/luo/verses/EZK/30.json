      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:17"
      },
      "items": [
        {
          "text": "notieki gi ligangla,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.17",
            "verseOrgIds": [
              "EZK.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:17"
      },
      "items": [
        {
          "text": "kendo mier madongo nomaki ma ter e twech.",
          "type": "text",
          "attrs": {
