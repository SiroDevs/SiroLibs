      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:16"
      },
      "items": [
        {
          "text": "to Memfis biro bedo gi chandruok ma ok rum.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.16",
            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
