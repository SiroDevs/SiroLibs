          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jerusalem en mzabibu maonge tich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach Jehova Nyasaye nobirona kama:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.1",
            "verseOrgIds": [
              "EZK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wuod dhano, ere kaka yadh mzabibu ber moloyo bad yien moro amora manie bungu?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.2",
            "verseOrgIds": [
              "EZK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende inyalo gol kuome bao malosgo gimoro minyalo tigo? Bende inyalo los kode gig mocho?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.3",
            "verseOrgIds": [
              "EZK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koso ka odire e mach kaka gima liel mi mach owangʼe koni gi koni kendo orewo diere, bende dochak obed gima inyalo tigo gimoro amora?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.4",
            "verseOrgIds": [
              "EZK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mokwongo ne oonge tich kane pok gimoro otime, donge en gima tek moloyo mondo olose obed gima nigi tich bangʼ ka mach, osewangʼe kendo orewore?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kuom mano, ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho: Kaka asechiwo yadh mzabibu e dier yiende mag bungu modoko gima ichwakogo mach, e kaka abiro timo ne joma odak Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro kumogi kata obedo ni gisewuok e mach, to mach pod biro mana wangʼogi. Kendo kinde ma abiro kumogi to unungʼe ni An e Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo piny doko kama otwo nikech ok gisebedo jo-ratiro, Jehova Nyasaye Manyalo Gik Moko Duto owacho.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
      ]
    }
  ],
