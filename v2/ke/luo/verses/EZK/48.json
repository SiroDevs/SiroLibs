  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "EZK 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pogo lowo e kind dhout Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Magi e ogandago, ka ochan moro ka moro gi nyinge:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "\"E tongʼ pinyno ma yo nyandwat, Dan noyud lowo kochakore e yo moa Hethlon nyaka Lebo Hamath; nyaka dala mar Hazar Enan motundo nyaka e piny manie kind Damaski kod Hamath. Lopgino nochakre yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Asher ema nogo tongʼ gi lop Dan kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Naftali ema nogo tongʼ gi lop Asher, kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop Manase ema nogo tongʼ gi lop Naftali, kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop Efraim ema nogo tongʼ gi lop Manase, kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop Reuben ema nogo tongʼ gi lop Efraim, kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop Juda ema nogo tongʼ gi lop Reuben, kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lowo mogoyo tongʼ gi Juda chakre wuok chiengʼ nyaka podho chiengʼ ema nobed migawo mowinjore ichiw kaka mich makende. Lachne nobed kilomita apar gariyo gi nus, to borne koa yo wuok chiengʼ nyaka yo podho chiengʼ, nobed maromre gi mano mipogone dhoot ka dhoot. E dier lowono tir e kama nogerie kama ler mar lemo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pok makende mowinjore ichiw ni Jehova Nyasaye nobed kilomita apar gariyo gi nus kuom borne kendo nobed kilomita abich kuom lachne.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ema nobed hekalu mopwodhi ni jodolo. Enobed kilomita apar gariyo gi nus kuom borne man yo nyandwat, lachne kilomita abich yo podho chiengʼ kendo lachne ma yo podho chiengʼ bende kilomita abich, bangʼe borne mochomo yo milambo nobed kilomita apar gariyo gi nus. E dier lowono tir e kama nogerie kama ler mar lemo mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ema nobed lop jo-Zadok, ma gin jodolo maler mopwodhi, mane otiyona gadiera, kendo mane ok obaro oweyo yo kaka jo-Lawi mamoko notimo, kane jo-Israel obaro oweyo yo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enobed mich makende mimiyogi, kogol kuom bath lowo maler mopwodhi, ma en kama ler moloyo momigi, mokiewo gi lop jo-Lawi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bath lop jodologo ema nongʼadne jo-Lawi kaka pok margi; ma borne norom kilomita apar gariyo, to lachne nobed kilomita abich; lopno borne duto nobed kilomita apar gariyo gi nus, to lachne nobed kilomita abich.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok oyienigi kawo chudo moro kata wilo bath lopno kata matin. En e lowo maber mogik kendo ok nyal chiwe e lwedo mamoko, nikech oler kendo owale ni Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kama odongʼ, ma lachne romo kilomita ariyo gi nus, to borne romo kilomita apar gariyo gi nus notigo tije mapile mag dala maduongʼ, kuom gero udi kendo kaka lek mar jamni. Dala maduongʼ nobed e diere tir,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo pim mare nochal kama: Bathe mochomo nyandwat, kilomita ariyo, bathe mochomo milambo, kilomita ariyo, bathe mochomo wuok chiengʼ, kilomita ariyo, kendo bathe mochomo podho chiengʼ, kilomita ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonde mowe kaka lek mikwaye mag dala maduongʼ nobed fut mia angʼwen gi apar, bathe mochomo yo nyandwat, fut mia angʼwen gi apar, yo milambo, fut mia angʼwen gi apar, yo wuok chiengʼ kod fut mia angʼwen gi apar yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima odongʼ kuom lopno; motongʼ gi lowo maler mopwodhi, momakore kode nobed kilomita abich, bathe mochomo wuok chiengʼ kod kilomita abich, bathe mochomo yo podho chiengʼ. Gimoro amora machiek e dala maduongʼno ema nobed chiemb joma tiyo kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotich moa e dala maduongʼ ma pure noa e oganda mar Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bethe lopni nobed maromre, kilomita apar gariyo gi nus koni gi koni. Iniket tenge bathe koma ler mopwodhi kaka mich makende, kaachiel gi lowo mogerie dala maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lowo modongʼ kolworo bath lowo maler mopwodhi koni gi koni kaachiel gi lowo mowe ni dala maduongʼ nobed mar ruoth. Lowo maler mopwodhi koa yo wuok chiengʼ nyaka podho chiengʼ nobedi kilomita apar gariyo gi nus maromre koni gi koni. Lope ariyogi duto borgi nobed maromre gi lope mopogne dhoot ka dhoot kendo ginibed mag ruoth. Lowo maler mopwodhi kaachiel gi kama ler mar lemo mar hekalu nobed e diergi tir.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo lop jo-Lawi gi lowo mogerie dala maduongʼ nobedie dier lowo mar ruoth. To lop ruoth nobed e kind tongʼ mar Juda kod kiep Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To pok mar dhoudi mamoko duto modongʼ nochal kama:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:23"
      },
      "items": [
        {
          "text": "\"Benjamin noyud lowo kochakore yo podho chiengʼ nyaka yo wuok chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Simeon ema nogo tongʼ gi lop Benjamin kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Isakar ema nogo tongʼ gi lop Simeon kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Zebulun ema nogo tongʼ gi lop Isakar kochakore yo wuok chiengʼ nyaka yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lop dhood Gad ema nogo tongʼ gi Zebulun kochakore wuok chiengʼ nyaka podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo milambo mar lowo mopogne Gad nochakore Tamar nyaka e sokni mag Meriba Kadesh, eka bangʼe nochom Wadi manie piny Misri nyaka e Nam maduongʼ mar Mediterania.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma e lowo monego ipogi ni dhout Israel kaka girkeni margi, kendo lowo mopogne dhoot ka dhoot ema nobed margi.\" Jehova Nyasaye Manyalo Gik Moko Duto osewacho.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhorangeye mag Dala Maduongʼ Manyien",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kuonde tony mag wuokie dala maduongʼ e magi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:30"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:30"
      },
      "items": [
        {
          "text": "\"Kochakore yo nyandwat, ma borne romo kilomita ariyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhorangeye mag dala maduongʼ nochak nying moluwore gi nying dhout Israel. Dhorangeye adek man yo nyandwat noluong ni rangaj Reuben, rangaj Juda kod rangaj Lawi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo wuok chiengʼ, ma en kilomita ariyo, rangeye adek nobedie, ma gin: rangaj Josef, rangaj Benjamin gi rangaj Dan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo milambo, ma pimne romo kilomita ariyo, rangeye adek nobedie, ma gin: rangaj Simeon, rangaj Isakar gi rangaj Zebulun.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo podho chiengʼ ma en kilomita ariyo, rangeye adek nobedie, ma gin: rangaj Gad, rangaj Asher, gi rangaj Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bor mar dala maduongʼno duto nobed kilomita ochiko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:35"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 48:35"
      },
      "items": [
        {
          "text": "\"Kendo chakre ndalono nying dala maduongʼno noluong ni:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "EZK 48:35"
      },
      "items": [
        {
          "text": "Jehova Nyasaye nika.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
  ],
