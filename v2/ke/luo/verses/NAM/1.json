      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "Abiro tieko nyisecheu manono mopa kaachiel gi mochwe gi lowo",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
