      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "\"Ok inibed gi nyikwayi mabiro tingʼo nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
