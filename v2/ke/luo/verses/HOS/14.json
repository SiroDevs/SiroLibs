  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "HOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lokruok kuom richo kelo gweth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwoguru ir Jehova Nyasaye ma Nyasachu, yaye Israel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:1"
      },
      "items": [
        {
          "text": "Richou ema osemiyo upodho.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaw wechegi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kendo uduog ir Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "Wachne kama:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "\"Wenwa richowa duto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kendo yie irwakwa gi ngʼwono,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "mi wanapaki gi dhowa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuria ok nyal resowa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "bende ok wana idhi faresegi mag lweny.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "Ok wanachak wawach kendo ni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "'Nyisechewa' ne gik mwaloso gi lwetwa wawegi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "nimar kuomi, ema, nyithi kiye yude kech.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anachang-gi kuom baro margi mane gibarogo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "kendo anahergi maonge achuna,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "nimar mirimba osewuok kuomgi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachal mana ka thoo mar okinyi ne Israel;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "kendo nolodhi mana ka ondanyo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "kendo tiende nokar",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "mana ka yiend Lebanon;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bade nolodhi makee.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "Enobed maber ka yiend zeituni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "kendo nodungʼ mangʼwe ngʼar ka yiend Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nochak odag e tipone.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Nonyaa maber mana ka cham,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "kendo nonyag maber ka mzabibu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "mi nobed gi huma ka divai moa Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Efraim en angʼo ma datim gi nyiseche manonogi kendo?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Anadwoke kendo rite,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "achalo gi obudo mangʼich,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "nyak mari aa kuoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼat mane mariek?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Obiro fwenyo tiend gigi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "En ngʼat mane manyalo fwenyo tiend wechegi?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Obiro ngʼeyogi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Yore mag Jehova Nyasaye nikare,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "joma nikare ema wuothoe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "to joma jendeke to chwanyore.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    }
  ],
