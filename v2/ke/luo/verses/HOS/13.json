  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mirimb Jehova Nyasaye kuom jo-Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Efraim owuoyo, to ji ne tetni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "nodhiale e piny Israel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "To notimo richo kuom lamo Baal, mi notho.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro gimedo timo richo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "bende giloso nyisechegi mag fedha mondo gilam,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "ma gin kido molos gi rieko mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "magi duto gin tich jopa bepe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "Wachore kuom jogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "\"Gitimo misango gi dhano,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "kendo ginyodho kido molos mar nyaroya.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emomiyo ginichal mana kaka ongʼwengʼo mokinyi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "bende kaka thoo mar okinyi malal nono ka nyango owuok,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "bende kaka mihudhwe ma yamo keyo kar dino,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "bende kaka iro mawuok e dirisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To An e Jehova Nyasaye ma Nyasachu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "mane ogolou ua e piny Misri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "Ok unyal yango Nyasaye moro amora ma ok An,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "onge Jawar machielo makmana An.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aritou e piny motwo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:5"
      },
      "items": [
        {
          "text": "maliel ka mach.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane apidhogi ne giyiengʼ chuth;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "kane giseyiengʼ to sunga nomakogi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "ma wigi owil koda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo anabi irgi ka sibuor,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:7"
      },
      "items": [
        {
          "text": "kendo ka kwach abiro buto negi e bath yo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamonjgi mi ayiechgi matindo tindo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "mana ka ondiek ma omaa nyithinde.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "Anatiekgi mana ka sibuor,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "bende le mag bungu noyiechgi matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Osetieku yaye Israel, nikech ok udwara,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:9"
      },
      "items": [
        {
          "text": "ok udwar jakonyu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere ruodhu mondo koro oresu?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "Ere jotendu e miechu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "mane usekwayo ni,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "'Miwa ruodh kod jotendwa?'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom ich wangʼ mare ne amiyou ruoth",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:11"
      },
      "items": [
        {
          "text": "kendo e mirimba ne agole oko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamono mag Efraim osekan,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.12",
            "verseOrgIds": [
              "HOS.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:12"
      },
      "items": [
        {
          "text": "kendo richoge osendik e kitabu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.12",
            "verseOrgIds": [
              "HOS.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rem machalo gi mar dhako mamuoch kayo nobine,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.13",
            "verseOrgIds": [
              "HOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:13"
      },
      "items": [
        {
          "text": "to en nyathi maonge gi rieko,",
          "type": "text",
          "attrs": {
