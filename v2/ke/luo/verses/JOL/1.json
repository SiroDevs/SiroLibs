  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach Jehova Nyasaye mane obiro ne Joel wuod Pethuel.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.1",
            "verseOrgIds": [
              "JOL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bonyo omonjo piny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru ma, un jodongo;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "chikuru itu, un duto ma udak e piny.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "Bende gima chalo kama osetimore e ndalou,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:2"
      },
      "items": [
        {
          "text": "kata e ndalo mag kwereu?",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.2",
            "verseOrgIds": [
              "JOL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyis nyithindu wachni,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "kendo nyithindu onyis nyithindgi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:3"
      },
      "items": [
        {
          "text": "kendo nyithindgi bende onyis tiengʼ maluwogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.3",
            "verseOrgIds": [
              "JOL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gik ma mony mar bonyo oweyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "bonyo madongo osechamo;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "gik ma bonyo madongo oweyo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "bonyo matindo osechamo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "gik ma bonyo matindo oweyo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:4"
      },
      "items": [
        {
          "text": "bonyo mamoko nochamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.4",
            "verseOrgIds": [
              "JOL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un jomer, chiewuru kendo ywaguru!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "Gouru nduru, un duto ma jomath mag divai;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "gouru nduru nikech divai manyien,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:5"
      },
      "items": [
        {
          "text": "nikech oseyudhe ogole e dhou.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.5",
            "verseOrgIds": [
              "JOL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oganda moro osemonjo pinya, en oganda maratego",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "kendo gingʼeny mokadho akwana;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "en gi leke mag sibuor madichwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:6"
      },
      "items": [
        {
          "text": "leke mager mag sibuor madhako.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.6",
            "verseOrgIds": [
              "JOL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oselwero it mzabibu maga,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "kendo ketho yiende ngʼopega.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "Osepoko potgi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "mi owitogi kucho,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:7"
      },
      "items": [
        {
          "text": "kendo oweyo bedegi kodongʼ rachere.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.7",
            "verseOrgIds": [
              "JOL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ywaguru ka ukuyo ka dhako ma pod tin ma orwakore gi law kuyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:8"
      },
      "items": [
        {
          "text": "ka oywago chwore mane ohange.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.8",
            "verseOrgIds": [
              "JOL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwo mag cham kod misango miolo piny",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "orumo e od Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "Jodolo ywak",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:9"
      },
      "items": [
        {
          "text": "joma tiyo e nyim Jehova Nyasaye ywak.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.9",
            "verseOrgIds": [
              "JOL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puothe okethore,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "lowo otwo;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "cham okethore,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "divai manyien orumo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:10"
      },
      "items": [
        {
          "text": "mo bende onge.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.10",
            "verseOrgIds": [
              "JOL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ugen gimoro un jopur,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "denguru un jopidh mzabibu,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 1:11"
      },
      "items": [
        {
          "text": "beduru mokuyo nikech ngano gi shairi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.1.11",
            "verseOrgIds": [
              "JOL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 1:11"
      },
      "items": [
        {
