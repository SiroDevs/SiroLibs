      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:17"
      },
      "items": [
        {
          "text": "adak e Sayun, goda maler.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.17",
            "verseOrgIds": [
              "JOL.4.17"
            ]
          }
