          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethogi mar chwero remo mapok aweyonegi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.21",
            "verseOrgIds": [
              "JOL.4.21"
            ]
