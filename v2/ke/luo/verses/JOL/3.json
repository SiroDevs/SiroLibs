      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:19"
      },
      "items": [
        {
          "text": "kendo Edom nobed piny ongoro maonge tich,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.19",
            "verseOrgIds": [
              "JOL.4.19"
            ]
          }
        }
      ]
