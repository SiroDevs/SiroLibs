      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:19"
      },
      "items": [
        {
          "text": "mane gichweroe remo maonge ketho e pinygi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.19",
            "verseOrgIds": [
              "JOL.4.19"
            ]
          }
