          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ gi dwe nolokre mudho,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.15",
            "verseOrgIds": [
              "JOL.4.15"
            ]
          }
        }
