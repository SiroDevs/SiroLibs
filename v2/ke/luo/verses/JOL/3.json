      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:16"
      },
      "items": [
        {
          "text": "Piny gi Polo noyiengni;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.16",
            "verseOrgIds": [
              "JOL.4.16"
            ]
          }
        }
      ]
