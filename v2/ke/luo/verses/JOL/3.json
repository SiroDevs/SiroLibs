          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eka unungʼe ni An, Jehova Nyasaye, ma Nyasachu,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.17",
            "verseOrgIds": [
              "JOL.4.17"
            ]
