      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:16"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye nobed kar pondo mar joge;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.16",
            "verseOrgIds": [
              "JOL.4.16"
            ]
          }
        }
      ]
