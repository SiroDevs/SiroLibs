            "sid": "JOL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye noruti koa Sayun",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.16",
            "verseOrgIds": [
              "JOL.4.16"
            ]
          }
