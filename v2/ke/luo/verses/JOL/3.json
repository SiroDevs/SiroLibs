      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:15"
      },
      "items": [
        {
          "text": "kendo sulwe ok nochak orieny.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.15",
            "verseOrgIds": [
              "JOL.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
