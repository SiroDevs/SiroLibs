      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:18"
      },
      "items": [
        {
          "text": "kendo chak nomol kawuok ewi thuche,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.18",
            "verseOrgIds": [
              "JOL.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:18"
      },
      "items": [
        {
          "text": "holo mag pi nopongʼ chuth.",
