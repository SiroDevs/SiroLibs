              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ngʼato odenyo, to ber mondo ochiem dala, mondo kik chokruok ma ubedogo kelnu kum.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
