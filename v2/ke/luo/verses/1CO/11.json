              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, jowetena, ka uchokoru kaachiel mondo uchiem, to ngʼato ka ngʼato mondo orit nyawadgi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
