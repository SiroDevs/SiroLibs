  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ROM 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo omoso ji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apwoyonu nyaminwa Fibi, ma en jatich e kanisa man Kenkrea.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwayou mondo urwake kuom Ruoth, kaka onego tim ni jomaler, kendo mondo umiye gimoro amora ma dodwar kuomu, nimar osebedo kokonyo ji mangʼeny, nyaka an bende.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Priskila gi Akula, ma jotich koda kaachiel e Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiketo ngimagi e chandruok nikech an. Ok an kenda, to kanise duto mag joma ok jo-Yahudi, bende pako timgino.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanisa machokore e odgi bende mosnauru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:5"
      },
      "items": [
        {
          "text": "Mosnauru Epaineto, osiepna mageno, ma en ema nokwongo bedo ja-Kristo e piny Asia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
            "verseOrgIds": [
              "ROM.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Maria, mosebedo katiyonwa matek ahinya e dieru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.6",
            "verseOrgIds": [
              "ROM.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Androniko kod Junias, ma wedena, kendo mane ni koda e od twech, bende mosnauru. Ji ariyogi gin joma oluor e kind Joote, kendo ne gikwongona yie kuom Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.7",
            "verseOrgIds": [
              "ROM.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Ampliato ma jaherana kuom Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.8",
            "verseOrgIds": [
              "ROM.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urbano, ma en jatich Kristo wadwa, kod Stakus ma osiepna mageno bende mosnauru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.9",
            "verseOrgIds": [
              "ROM.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Apele, ngʼat mosetem moyud ni ja-Kristo mar adier.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:10"
      },
      "items": [
        {
          "text": "Jood Aristobulo bende mosnauru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.10",
            "verseOrgIds": [
              "ROM.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru watna ma Herodion.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:11"
      },
      "items": [
        {
          "text": "Mosnauru jood Narkiso, mohero Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.11",
            "verseOrgIds": [
              "ROM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Turfena gi Turfosa, ma gin mon matiyo matek ni Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:12"
      },
      "items": [
        {
          "text": "Mosnauru osiepna Persi ma en dhako mosetiyo matek ni Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.12",
            "verseOrgIds": [
              "ROM.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Rufus, ngʼat ma Ruoth oyiero kod min-gi mosebedona kaka minwa an bende.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.13",
            "verseOrgIds": [
              "ROM.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru bende Asunkrito, Filgona, Hermes, Patroba, Hermas, kod Jowete duto man kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.14",
            "verseOrgIds": [
              "ROM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosnauru Filologo gi Julia gi Nerea kod nyamin mare; gi Olumpa kod jomaler duto man kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.15",
            "verseOrgIds": [
              "ROM.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosreuru, uduto ngʼato gi ngʼato, gi yogruok maler.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:16"
      },
      "items": [
        {
          "text": "Kanise duto mag Kristo omosou.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.16",
            "verseOrgIds": [
              "ROM.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owetena, asiemou mondo ungʼi maber joma kelo pogruok, kendo keto chwanyruok e yoreu ma ok oluwore gi puonj museyudo. Wereuru kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.17",
            "verseOrgIds": [
              "ROM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar joma kamago ok ti ne Kristo Ruodhwa, to gitiyo mana ne igi giwegi. Giwuoyo gi weche mayom ka giolo ji mondo giwuond chunje joma pachgi thany thany.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.18",
            "verseOrgIds": [
              "ROM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji duto osewinjo kaka uwinjo wach kendo mano omiyo chunya opongʼ gi mor kuomu, to adwaro mondo ubed mariek korka timo gima ber, kendo ubed maonge wach korka timo gima rach.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.19",
            "verseOrgIds": [
              "ROM.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasach kwe biro miyo unyon Satan gi tiendu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ROM 16:20"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:20"
      },
      "items": [
        {
          "text": "Ngʼwono mar Ruodhwa Yesu Kristo obed kodu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timotheo, mwatiyogo kaachiel okowonu mos; Lukio gi Jason kod Sosipatro ma wedena bende jomosou.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Tertio, ma jandiko mar baruwani, bende amosou kuom Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayo, moserwaka e ode, kaachiel gi kanisa duto, omosou.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:23"
      },
      "items": [
        {
          "text": "Erasto, jakeno maduongʼ mar dalani, kod owadwa Kwarto bende ooronu mos.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 16:23"
      },
      "items": [
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad ngʼwono mar Ruodhwa Yesu Kristo obed kodu un duto. Amin.]",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
