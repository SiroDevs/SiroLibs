  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ISA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bad Yath moa kuom Jesse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakwar Jesse moro nowuogi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "mana ka bad yath maloth;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "Kuom tiende, Bade nonyag olemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho mar Jehova Nyasaye nobi kuome,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "en Roho makelo rieko gingʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "kendo mangʼadone ji rieko kendo miyogi teko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "bende en Roho mapuonjo ji luoro Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo enobed mamor gi joma oluoro Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 11:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "Ok nongʼad bura kuom gima oneno giwangʼe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "kata chiwo parone kod gima owinjo gi ite;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to gi adiera nongʼad bura ne joma odhier,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "kendo kuom bura makare enongʼad wach,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "mowinjore ni joma ochando manie piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "Dhoge ema nobed luth mogoyogo piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "bende wach moa e dhoge ema noneg-go joma timbegi mono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tim makare nobed okanda mare",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:5"
      },
      "items": [
        {
          "text": "kendo adiera nobed misip motweyo e nungone.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondiek nodag kaachiel gi nyirombe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "kwach nonind kaachiel gi diel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "nyaroya kod sibuor nokwa kaachiel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "kendo nyathi matin nokwagi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiangʼ gi ondiek nokwa kaachiel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "kendo nyithindgi nonind kanyakla,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "kendo sibuor nocham lum ka rwath.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyathi madhoth notug machiegni gi dho bur thuond rachier,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:8"
      },
      "items": [
        {
          "text": "kendo rawera noso lwete e bur thuond fu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok ginihiny kata ketho gimoro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "e godena duto maler,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "nimar rieko mar Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "nopongʼ piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "mana ka pi mopongʼo nam.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiechiengno Nyakwar Jesse nochungʼ kaka ranyisi ne ji; mi ogendini nobi ire, kendo kare mar yweyo nobed gi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kindeno Ruoth Nyasaye norie bade kendo koresogo joge mane odongʼ e lwet jo-Asuria, koa Misri mamwalo nyaka mamalo, koa Kush, Elam, Babulon, Hamath to gi chula manie ii nam.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enochung bandera ne ogendini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "mi ochok jo-Israel mane oriembi e pinygi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "kendo enochok jo-Juda kanyakla",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "ka ogologi e tunge angʼwen mag piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiego mar jo-Efraim norum",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "bende jowasik Juda notieki;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "kendo jo-Efraim ok nochak obed gi nyiego gi jo-Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
          "text": "kata jo-Juda ok nobed gi ich wangʼ kod jo-Efraim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
