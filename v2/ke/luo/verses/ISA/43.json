  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "ISA 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakony makende mar Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro ma e gima Jehova Nyasaye wacho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "Nyasaye mane ochweyi, yaye Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "Nyasaye mane ochweyi, yaye Israel:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "\"Kik ibed maluor, nimar aseresi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:1"
      },
      "items": [
        {
          "text": "kendo aseluongi gi nyingi ni in mara awuon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ikadho ei pige matut,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "to anabed kodi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "kendo ka ungʼado aore",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "to ok giniteru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "Ka uwuotho e mach mager",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "to ok nowangʼu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:2"
      },
      "items": [
        {
          "text": "kata mana mach makakni ok nowangʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.2",
            "verseOrgIds": [
              "ISA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar an Jehova Nyasaye, ma Nyasachi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "Nyasaye Maler mar Israel, ma Jawarni;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "achiwo Misri gi Kush kod Seba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:3"
      },
      "items": [
        {
          "text": "ka gir chudo mondo oresigo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.3",
            "verseOrgIds": [
              "ISA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech in ngʼat makare kendo mogen e nyima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "kendo nikech aheri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "abiro chiwo ji kar loi mondo aresigo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:4"
      },
      "items": [
        {
          "text": "kendo abiro chiwo ji mamoko mondo ochungʼ e loi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.4",
            "verseOrgIds": [
              "ISA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ibed maluor, nimar an kodi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:5"
      },
      "items": [
        {
          "text": "abiro duogo nyithindi koa yo wuok chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:5"
      },
      "items": [
        {
          "text": "kendo abiro choko nyithindi moa yo podho chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.5",
            "verseOrgIds": [
              "ISA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro wachone joma odak nyandwat ni, 'Wegi gidhi!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "Kendo ni joma odak milambo ni, 'Kik ugengʼ-gi.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "Keluru yawuota moa mabor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:6"
      },
      "items": [
        {
          "text": "kaachiel gi nyiga koa e tunge piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
            "verseOrgIds": [
              "ISA.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngʼato angʼata miluongo gi nyinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:7"
      },
      "items": [
        {
          "text": "ngʼat mane achweyo mondo omiya duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:7"
      },
      "items": [
        {
          "text": "ngʼat mane achweyo kendo amiyo ngima.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.7",
            "verseOrgIds": [
              "ISA.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keluru jogo man-gi wenge to ok nyal neno,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:8"
      },
      "items": [
        {
          "text": "to bende gin gi it to ok giwinj wach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini duto chokore kanyakla",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "kendo ji duto chokore kamoro achiel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "En ngʼa kuomgi mane ofwenyo gima kama kapok otimore",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "kendo mane owachonwa gigo mane otimore chon?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "Wegiuru gikel joneno mag-gi mondo onyiswa ane ni ne gin kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:9"
      },
      "items": [
        {
          "text": "eka joma owinjo owachi niya, \"En adier.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.9",
            "verseOrgIds": [
              "ISA.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya, \"Un joneno maga ma wuoyo kuoma\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "kendo jotichna ma aseyiero,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "mondo mi ungʼe kendo uyie kuoma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "kendo ubed gingʼeyo ni An e Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 43:10"
      },
      "items": [
        {
          "text": "Onge Nyasaye moro ma nobetie kapok abet",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.10",
            "verseOrgIds": [
              "ISA.43.10"
            ]
          }
        }
      ]
    },
    {
