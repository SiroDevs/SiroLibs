{
  "id": "ISA.66",
  "number": "66",
  "bookId": "ISA",
  "reference": "Isaya 66",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "ISA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum kod bedo gi geno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "\"Polo e koma mar duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "to piny e raten tienda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "Koro ere kama dugerna e ot?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "To kar yweyo mara nobed kanye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge lweta ema osechweyo gigi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "duto momiyo gibedo mangima?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ema owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 66:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "\"Ma e ngʼat ma ayiego ma en ngʼat ma hore",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "kendo man-gi chuny motur,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "kendo ngʼama oluoro wachna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ngʼato angʼata moyangʼo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "rwath katimogo misango chal gi ngʼat monego dhano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "kendo ngʼato angʼata motimo misango mar rombo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "chal gi ngʼama oturo ngʼut guok,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "kendo ngʼato angʼata mochiwo misango mar cham",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "chal gi ngʼat mochiwo remb anguro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "bende ngʼato angʼata mowangʼo ubani mangʼwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "ngʼar mar rapar, chal gi ngʼama lamo nyiseche manono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "Giseyiero yoregi giwegi kendo chunygi mor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "gi timbegi mag rondogo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omiyo an bende abiro yieronegi masiche",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "mondo omakgi kendo abiro kelo kuomgi gik ma giluoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "Nimar kane aluongo, to onge ngʼat mane odwoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "kendo kane awuoyo, to onge ngʼat mane owinjo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "Negitimo timbe mamono e nyima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "kendo ne giyiero mana gik mamorogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru wach Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "un jogo matetni kuwinjo dwonde:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "\"Oweteni mochai kendo ok kwani ka gimoro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "nikech ihero nyinga osewacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "'Mad Jehova Nyasaye mi duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "mondo omi wane morni!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "Kata kamano gin giwegi ema ginine wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru kaka nduru wuok e dala maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "kendo winjuru kaka kokono wuok e hekalu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "Ma en dwond Jehova Nyasaye kochulogo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "kuor ne wasike moromo gi timbegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kapok muoch ochako kaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:7"
      },
      "items": [
        {
          "text": "to osenywolo nyathi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:7"
      },
      "items": [
        {
          "text": "kapok owinjo rem to osenywolo wuowi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa mosewinjo wach machal kamano?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "En ngʼa moseneno gik machalo kamano?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "Bende piny dichwe godiechiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "achiel koso ogendini dichok dichiel?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "To mana e seche mane muoch ochako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "kayo Sayun ema nonywoloe nyithinde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende dawe sa ma dhako nywolie",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "chopi mak amiye teko mar nywol?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "\"Bende dadin ich",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "kochopo sa mar chiwo nyathi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "Nyasachi owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Moruru gi Jerusalem kendo bed mamor kode,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "un duto muhere;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "beduru gi ilo maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "un duto man-gi kuyo nikech en.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ibiro piru maber kudhodho thunde;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:11"
      },
      "items": [
        {
          "text": "kendo unumethi gi ilo mi ubed gi mor mogundho.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "\"Abiro miyo kwe ma en-go mol ka aora",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "kendo mwandu mag pinje namiye mamol ka oula;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "unubed mamor ka odhodhou kotingʼou e bade",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "kendo kopirou e chonge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka miyo hoyo nyathine,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:13"
      },
      "items": [
        {
          "text": "e kaka abiro hoyou;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:13"
      },
      "items": [
        {
          "text": "kendo noho chunyu e Jerusalem.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka uneno ma, to chunyu nobed gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "kendo dendu nobed maber mana ka lum matwi ndalo chwiri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "lwet Jehova Nyasaye nofwenyre ne jotichne,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "to mirimbe to none kuom wasike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nee, Jehova Nyasaye biro gi mach,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "kendo gechene mag lweny chalo ka kalausi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "obiro kelo mirimbe makakni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "kendo chwat mare nopilre ka mach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar mach kod ligangla",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "ema Jehova Nyasaye noyalgo ji duto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "kendo joma Jehova Nyasaye nonegi nobed mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya, \"Joma pwodhore kendo bedo maler mondo odhiye puothe, kamoro ka moro luwo wadgi kendo chamo ring anguro, oyieyo kod gik moko duto makwero norum duto dichiel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An Jehova Nyasaye angʼeyo timbeni gi paroni achiegni biro mondo achok ogendini duto kod dhoudi mawacho dhok mopogore opogore kendo ginibi mi ginine duongʼ mara maler.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anatim ranyisi e kindgi kendo anaor jomoko manok ma notony mane pok owinjo humba kata mane pok oneno duongʼ mara maler ma gin: Tarshish, Libya, Lud (mongʼere gi nying mar jolweny mongʼeyo kedo gi asere), jo-Tubal kod jo-Yunani kaachiel gi joma odak e dho nembe man kuonde maboyo. Gibiro nyiso duongʼna e kind ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo ginikel oweteni duto koa e ogendini duto, e goda maler ma en Jerusalem kaka gir misango ne Jehova Nyasaye ka moko oidho farese, geche lweny, pundane kod ngamia,\" Jehova Nyasaye owacho. \"Gibiro kelogi mana kaka jo-Israel kelo misengini e od Jehova Nyasaye, ka gitingʼogi e tewni maler.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo moko kuomgi bende nayier mondo obed jodolo kod jo-Lawi,\" Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 66:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya, \"Mana kaka polo manyien machweyo gi piny manyien nosiki e nyima, e kaka nyingi kod nying nyikwayi nosiki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 66:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka dwe por kendo podho kendo machielo por, bende mana kaka chiengʼ Sabato nyaka chiengʼ Sabato machielo e kaka ji duto biro bedo kendo kulore e nyima,\" Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "name": "verse",
