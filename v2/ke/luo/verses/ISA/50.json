  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "ISA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Richo mar Israel kod bolruok mar jatich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Ere baruwa mar weruok",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "manyiso nine ariembo minu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Koso ngʼato nitie mane achiwene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "mondo achulgo gope ma an-go?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Nousu nikech richou;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "kendo minu noriembi nikech ketho mage.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane abiro iru, angʼo momiyo ne ok ayudo ngʼato?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Kane aluongou, ere gima omiyo ne ok ngʼato odwoka?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Koso uparo ni bada ne chiek ma ok nyal konyou?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Uparo ni aonge gi teko mar resou?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Wuoyona matin nomiyo nam oduono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "kendo ne amiyo aore obedo piny motwo mi rech manie eigi otho",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "kendo otop nikech onge mar pi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloko polo doko maratengʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:3"
      },
      "items": [
        {
          "text": "ti mana ka gima aume gi pien gugru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto osemiyo apongʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "kod puonj,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "mondo omi angʼe wach manyalo hoyogo ngʼama ni e chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "Ochiewa pile okinyi kokinyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "kendo oyawo ita mondo abed gi winjo ka ngʼat mipuonjo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto oseyawo pacha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "kendo ok asetamore winjo wachne;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "bende ok asedok chien.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne achiwora ne joma goya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "ne joma pudho yie tika;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "kendo ne ok apando",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "wangʼa ne joma nyiera kendo ngʼulo kuoma olawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech Jehova Nyasaye Manyalo Gik Moko Duto konya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "ok anayud wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "Kuom mano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "asechomo wangʼa tir kuome maonge luoro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "kendo angʼeyo maber ni ok nayud achaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jal mabiro ngʼadona bura ni koda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Kare koro en ngʼa manyalo donjona?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Owuogane oko koro!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "En ngʼa modonjona?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Owuogane okwera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "En mana Jehova Nyasaye Manyalo Gik Moko Duto ema konya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "En ngʼa mabiro ngʼadona bura?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Gibiro ti mana ka law, ma olwenda ochamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼatno e dieru moluoro Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:10"
      },
      "items": [
        {
          "text": "kendo mako weche jatichne?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
