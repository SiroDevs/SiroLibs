  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "ISA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa malo, Aa malo, yaye Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "jiw badi motegno!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "Rwak lepi mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "yaye Jerusalem dala maduongʼ maler.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "Nimar joma ok oter nyangu kendo mogak,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:1"
      },
      "items": [
        {
          "text": "ok nochak odonji e Jerusalem kendo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tengʼ buru momaki oko;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "aa malo kendo ibed piny e kom duongʼ, yaye Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "Gony nyoroche motwe ngʼuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:2"
      },
      "items": [
        {
          "text": "yaye in Nyar Sayun manie twech.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:3"
      },
      "items": [
        {
          "text": "\"Nongʼiewi maonge chudo moro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:3"
      },
      "items": [
        {
          "text": "omiyo ibiro wari ma ok ochulie pesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye Manyalo Gik Moko Duto wacho:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:4"
      },
      "items": [
        {
          "text": "\"Mokwongo joga nodhi Misri mondo odagie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:4"
      },
      "items": [
        {
          "text": "bangʼe jo-Asuria nosandogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To koro en angʼo manenoni?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "\"Joga okaw nono maonge gima ochul",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "kendo joma tiyogi koro goyonegi siboi,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:5"
      },
      "items": [
        {
          "text": "\"Kendo kinde duto giyanyo nyinga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano joga biro ngʼeyo nyinga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "kendo odiechiengno giningʼe maber ni an,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "ema ne asewacho wechegi chon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:6"
      },
      "items": [
        {
          "text": "Adier, en An.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka en gima ber neno tiend joote maringo ewi gode",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "kakelo wach maber, mar kwe, mar resruok,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "kod mar warruok kagiwachone Sayun niya, \"Nyasachu olocho!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru! Jorito mau mondo okog matek;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "giduto gikok nikech gimor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "Ka Jehova Nyasaye noduog Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "to ginine lochne ayanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru matek gimor un duto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "un kuonde mokethore mag Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "nimar Jehova Nyasaye osehoyo chuny joge,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "osereso Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro rieyo bade maler ka ogendini duto neno,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:10"
      },
      "items": [
        {
          "text": "kendo tungʼ piny ka piny none warruok mar Nyasachwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoguru, wuoguru, auru kanyo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:11"
      },
      "items": [
        {
          "text": "Kik umul gima ochido!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:11"
      },
      "items": [
        {
          "text": "Wuoguru kuome mondo ubed maler,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:11"
      },
      "items": [
        {
          "text": "un mutingʼo gik ler mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
