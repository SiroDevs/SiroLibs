      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:20"
      },
      "items": [
        {
          "text": "\"Jehova Nyasaye osereso jotichne ma joka Jakobo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.20",
            "verseOrgIds": [
              "ISA.48.20"
            ]
