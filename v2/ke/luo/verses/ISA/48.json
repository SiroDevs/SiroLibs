      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "ee, an ema aseluonge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
