          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane otelonegi e thim, to riyo ne ok oloyogi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.21",
            "verseOrgIds": [
              "ISA.48.21"
            ]
