          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chokreuru un duto mondo uwinji:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:14"
      },
      "items": [
        {
          "text": "Ere kata achiel kuom nyiseche manono mosehulo gima biro timore?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:14"
      },
      "items": [
        {
          "text": "Oganda ma osiep Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:14"
      },
      "items": [
        {
          "text": "ema nokel kum mare kuom Babulon;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        }
      ]
