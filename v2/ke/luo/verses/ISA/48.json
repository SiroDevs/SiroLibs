      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "kendo enobed gi loch kuom gik mochano timo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
