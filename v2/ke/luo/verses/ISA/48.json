      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:14"
      },
      "items": [
        {
          "text": "mirimbe nobed kuom jo-Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.14",
            "verseOrgIds": [
              "ISA.48.14"
            ]
          }
        }
      ]
