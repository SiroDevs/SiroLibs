      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "mapuonji gima owinjore kodi kendo manyisi yo monego iluw.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
