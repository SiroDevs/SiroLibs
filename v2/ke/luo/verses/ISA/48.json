      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:13"
      },
      "items": [
        {
          "text": "kendo lweta ma korachwich ema ne oyaro polo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.13",
            "verseOrgIds": [
              "ISA.48.13"
            ]
          }
