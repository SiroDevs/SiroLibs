  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "ISA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jo-Israel matheko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Winjuru ma, yaye un joka Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "miluongo ni jo-Israel kendo ma koth Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "un ma ukwongʼoru gi nying Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "kendo un muluongo nying Nyasach Israel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "to ok e yo madiera kata makare;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "un muluongoru ni weg dala maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "maler kendo moketo genogi kuom Nyasach Israel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Maratego, e nyinge:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akoro chon gik makoro osetimoregi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "dhoga nohulogi mi namiyo gingʼere;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "bangʼe ne akelogi piyo magitimore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar nangʼeyo wich tekou;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "ka leche mag ngʼutu ochungʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "kendo pat wengeu tek ka nyinyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, ne anyisou magi duto chon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "kapok negitimore, to ne asewachonugi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "mondo omi kik uwach niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "'Nyisechena manono ema otimo magi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "kido mopa mara kod nyasacha mar mula ema oselerona ma?'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isewinjo wechegi, rang-gi ane duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Donge ibiro yie kodgi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "\"Kochakore sani abiro nyisi gik manyien,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "gik mopondo mapok ingʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gik mochwe sani, kendo mapok obudho;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "bende gin gik mapok iwinjo nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "Omiyo ok inyal wacho ni, 'Ee, ne angʼeyogi.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chutho ok osewinjo kata mana ngʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "nimar nyaka aa chon itu ne pok oyaw.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "To bende angʼeyo ni un gi mwandu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "kendo un oganda ma jopiem nyaka aa nywolu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agengʼo mirimba nikech nyinga awuon;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "kendo ahora mondo arit pakna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "mondo omi kik atieku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asepwodhou, to ok kaka ipwodho fedha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:10"
      },
      "items": [
        {
          "text": "kendo asetemou gi masira mager ka mach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asetimo kamano kuom rito nyinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "mana kuom rito nyinga awuon, emomiyo asetimo ma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "Ere kaka dayie mondo nyinga oyany?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:11"
      },
      "items": [
        {
          "text": "Ok ayie mondo duongʼ ma imiya, omi ngʼato machielo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.11",
            "verseOrgIds": [
              "ISA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogony Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Winjauru, yaye joka Jakobo in Israel ma aseluongo:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.12",
            "verseOrgIds": [
              "ISA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:12"
      },
      "items": [
        {
          "text": "An e en; an ema okwongo kendo an ema ogik.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.12",
            "verseOrgIds": [
              "ISA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
