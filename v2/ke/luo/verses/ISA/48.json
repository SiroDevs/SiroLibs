      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:13"
      },
      "items": [
        {
          "text": "ka aluongogi to giwuok kadiemo wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.13",
            "verseOrgIds": [
              "ISA.48.13"
            ]
          }
