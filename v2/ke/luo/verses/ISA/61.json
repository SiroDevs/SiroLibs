  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "61",
        "style": "c",
        "sid": "ISA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Higa mar ngʼwono mar Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho mar Jehova Nyasaye Manyalo Gik Moko Duto ni kuoma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "nikech Jehova Nyasaye osewira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "mondo aland wach maber ne joma odhier.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "Oseora mondo akwe chuny jok modakie lit,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "kendo mondo aland ne joma otwe ni gin thuolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "bende mondo ahul ne joma otwe modakie mudho ni koro osegonygi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende oseora mondo aland ni ma e higa mar ngʼwono mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "kendo chiengʼ ma Nyasachwa biro chuloe kuor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "kohoyo ji duto manie kuyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abiro konyo jogo man-gi lit Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "kendo gik mabiro miyogi e magi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "ketonegi maua mabeyo kar buru magi bukorego,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "kendo mor kar lit ma gin-go,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "kendo chiwo lewni mag pak kar chuny mool.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "Enoluong-gi ni yiend ober mag tim makare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "mopidh gi Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "konyiso godo duongʼne.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginichak giger kuonde machon mane omukore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "ka gidwoko kare kuonde mane okethore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "kendo ginichak giger mier madongo mane",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "okethore mosebedo kojwangʼ e tiengʼ ka tiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodak nobed jokwadh jambu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:5"
      },
      "items": [
        {
          "text": "jopinje mamoko nopurnu puotheu mag cham,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:5"
      },
      "items": [
        {
          "text": "kod mago mag mzabibu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo noluongu ni jodolo mag Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "kendo noluongu ni jotich Nyasachwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "Unucham mwandu mag pinje",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "kendo unungʼaru gi sunga kuom mwandugigo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kar yudo wichkuot to joga noyud pok nyadiriyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "kendo kar yudo achaya to ginibed mamor gi pokgi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "kuom mano giniyud pok nyadiriyo e pinygi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "kendo mor mochwere nobed margi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimar an Jehova Nyasaye ahero adiera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "amon gi mecho kod timbe mamono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "Kuom adiera mara abiro miyogi pok",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "kendo anatim kodgi singruok mosiko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 61:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikwagi nongʼere e kind ogendini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "kendo nyithindgi nomi luor e kind ji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "Ji duto monenogi nongʼe ni gin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "oganda ma Jehova Nyasaye ogwedho.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 61:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "An-gi mor maduongʼ e nying Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.10",
            "verseOrgIds": [
              "ISA.61.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:10"
      },
      "items": [
        {
          "text": "chunya opongʼ gi ilo kuom Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.10",
            "verseOrgIds": [
              "ISA.61.10"
