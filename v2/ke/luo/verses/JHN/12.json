        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar ne ok awuoyo gi dwacha awuon, to Wuoro ma noora ema nochika mondo awachi gik ma asebedo ka awacho kendo kaka onego awachgi.",
