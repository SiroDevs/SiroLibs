        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nitie Ngʼat mangʼado bura ne ngʼama odaga kendo ma ok oyie wechena. Ngʼama kamano wachna mane awacho ema biro ngʼadone bura marach chiengʼ giko piny.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.48",
