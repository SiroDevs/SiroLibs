        },
        {
          "text": "Chiengʼ onogo jotich Isaka nobiro ire monyise kuom soko mane gisekunyo. Negiwachone niya, \"Waseyudo pi!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
