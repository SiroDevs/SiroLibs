              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noluongo kanyo ni Shiba (tiende ni kar singruok) nyaka chil kawuono dalano osebed kiluongo ni Bersheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
