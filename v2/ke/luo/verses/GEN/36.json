          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Husham otho, Hadad wuod Bedad, mane oloyo jo-Midian e piny jo-Moab nobedo ruoth kare. Dalane maduongʼ niluongo ni Avith.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
