  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "GEN 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Welo adek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nofwenyore ne Ibrahim machiegni kod yiende madongo mag Mamre kane obet e dho hembe kar odiechiengʼ tir.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.1",
            "verseOrgIds": [
              "GEN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim notingʼo wangʼe malo kendo noneno ji adek machwo kochungʼ bute. Kane onenogi, noringo matek koa e dho hema mondo oromnegi kendo nopodho piny auma e nyimgi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya, \"Ruodha ka ayudo ngʼwono e wangʼi, to kik ikadh jatichni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.3",
            "verseOrgIds": [
              "GEN.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rituru mondo okel pi matin, mondo uluokgo tiendu eka uywe e tiend yien-ni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.4",
            "verseOrgIds": [
              "GEN.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ayudnue chiemo moro matin mondo ucham omednu teko eka udhi nyime gi wuodhu mosekelou ir misumbauni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:5"
      },
      "items": [
        {
          "text": "Negidwoke niya, \"Mano ber, tim kamano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Ibrahim noreto kadhi ir Sara ei hema mowachone niya, \"Kaw mogo mayom gorogoro adek, idwale kendo itedgo makati piyo piyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.6",
            "verseOrgIds": [
              "GEN.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka noringo odhi e dipo kendo noyiero nyarwath mopugno kendo nomiyo jatich molose piyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.7",
            "verseOrgIds": [
              "GEN.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nokawo mo gi chak mar adila kod ring nyarwath mane osetedi maber mi oketogi e nyimgi. Kane gichiemo, Ibrahim nochungʼ butgi e tiend yath.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negipenjo Ibrahim niya, \"Ere Sara chiegi?\" Ibrahim nodwokogi niya, \"En ei hema.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka achiel kuomgi nowacho niya, \"Adier anaduog iri e kinde maka ma higa mabiro kendo Sara chiegi biro nywolo nyathi ma wuowi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:10"
      },
      "items": [
        {
          "text": "To kara Sara ne winjo wachno kobet e dho hema e ngʼe welogo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim kod Sara nosebedo moti kendo hikgi noniangʼ kendo ndalo Sara mag nywol nosekadho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Sara nohum kanyiero gie chunye niya, \"Bende ma ditimre adier ka an kod ruodha wasedoko joma oti ka ma?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nopenjo Ibrahim niya, \"Angʼo momiyo Sara nonyiero kawacho ni, 'Bende danywol nyathi kaka asetini?'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende nitie gimoro amora matek ne Jehova Nyasaye? Abiro duogo iri e kinde mowinjore e higa mabiro kendo Sara biro nywolo nyathi ma wuowi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Sara noluor mokwer niya, \"Ne ok anyiero.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:15"
      },
      "items": [
        {
          "text": "To kata kamano Jehova Nyasaye nowachone niya, \"En adier ni ninyiero.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibrahim okwayo Nyasaye mondo ongʼwon ne Sodom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jogo owuok mondo odhi, Ibrahim nowuok kodgi ka kowogi ka gichomo Sodom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho niya, \"Bende dapand ne Ibrahim gima adwaro timo?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adieri Ibrahim biro bedo oganda maduongʼ kendo maratego, kendo ogendini duto manie piny nogwedhi nikech en.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.18",
            "verseOrgIds": [
              "GEN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar aseyiere mondo ochik nyithinde kod nyikwaye mondo oluw yore Jehova Nyasaye ka gitimo timbe mabeyo kendo makare. Kamano Jehova Nyasaye biro timo ne Ibrahim gik moko duto mane osingone.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho niya, \"Ywak mi ywaknego Sodom gi Gomora duongʼ kendo richogi ngʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuom mano abiro dhi mondo ane ka gik magisetimo richo kaka ywak osechopo ira, eka abiro ngʼeyo adiera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo nowuok kendo negiluwo yo madhi Sodom, to Jehova Nyasaye nodongʼ kochungʼ e nyim Ibrahim.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nosudo machiegni kode kendo openjo niya, \"Bende ditiek joma kare machal gi joma timbegi richo?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaponi nitie ji piero abich maonge ketho e dalano? Dikethe koso diweye nikech ngima ji makare piero abichgo?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok dineg joma onge ketho machal gi joma oketho, adier ok inyal timo kamano nikech kaponi itimo kamano to joma onge ketho diyud kum mana maromre gi joma nigi ketho. To mano ok nyalre nikech jangʼad bura nyaka ngʼad bura kare?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho niya, \"Ka ayudo ji piero abich maonge ketho e dala mar Sodom, to abiro reso dalano nikech joma onge kethogo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nowacho kendo niya, \"Kaka koro asebedo gichir ma awuoyo gi Ruoth Nyasaye, kata obedo ni ok an gimoro to makmana lowo kod buru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka dipo ni kwan joma onge ketho oromo mana ji piero angʼwen gabich, dikech dalano nikech ji abich kende?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:28"
      },
      "items": [
        {
          "text": "Jehova Nyasaye nodwoke niya, \"Kayudo ji piero angʼwen gabich kanyo, to ok nakethe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim nomedo wuoyo kode kendo niya, \"To ka dipo ni ji piero angʼwen kende ema oyudore kanyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:29"
      },
      "items": [
        {
          "text": "Ruoth Nyasaye nodwoke niya, \"Kayudo ji piero angʼwen kanyo, to ok nakethe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nomedo wachone niya, \"Kik isin koda, to weya aweya awuo. To ka dipo ni ji piero adek ema oyudi e dalano?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:30"
      },
      "items": [
        {
          "text": "Jehova Nyasaye nodwoke niya, \"Ok nakethi ka ayudo ji piero adek maonge ketho kanyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahim nowacho niya, \"Kaka koro asebedo gi chir ma wuoyo gi Ruoth Nyasaye, angʼoma ditim ka ji piero ariyo ema oyudore e dalano?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:31"
      },
      "items": [
        {
          "text": "Jehova Nyasaye nodwoke niya, \"Nikech ji piero ariyo maonge ketho ok anakethe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ibrahim nowacho niya, \"Mad Jehova Nyasaye kik sin koda, to oyie awach wach achiel mogik. Ka dipo ni ji apar kende ema oyudi e dalano?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:32"
      },
      "items": [
        {
          "text": "Ruoth Nyasaye nodwoke niya, \"Nikech ji apar maonge ketho ok natiek dalano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jehova Nyasaye osetieko wuoyo kod Ibrahim, nowuok kendo Ibrahim nodok dala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
          }
        }
      ]
    }
  ],
