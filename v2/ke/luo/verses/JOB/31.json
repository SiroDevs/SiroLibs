      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:21"
      },
      "items": [
        {
          "text": "nikech an gi teko kama ingʼadoe bura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
