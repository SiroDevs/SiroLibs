          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapo ni ne achomo wangʼa e ler mar wangʼ chiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
