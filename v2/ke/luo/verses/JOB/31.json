          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ne aluoro kethruok ma Nyasaye nyalo kelona",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:23"
      },
      "items": [
        {
          "text": "nikech luoro mane aluorogo duongʼne,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:23"
      },
      "items": [
        {
          "text": "omiyo ne ok anyal timo gik ma kamago.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
