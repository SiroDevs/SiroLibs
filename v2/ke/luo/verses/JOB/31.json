          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaye, mad dine ngʼato bedie manyalo winja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
