          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapo ni ne aneno ngʼato angʼata ka koyo nego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
