          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech ne aluoro ogandana ahinya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "kendo ne aluor ni anywolana ne nyalo sin koda mine alingʼ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "kendo ne ok anyal wuok oko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
