      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:24"
      },
      "items": [
        {
          "text": "kata asewachone dhahabu maler ni in e kar pondona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
