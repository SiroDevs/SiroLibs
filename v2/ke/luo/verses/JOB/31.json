      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:19"
      },
      "items": [
        {
          "text": "kata ka jachan moro onge gi law,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
