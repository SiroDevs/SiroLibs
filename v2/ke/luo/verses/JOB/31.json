      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:30"
      },
      "items": [
        {
          "text": "mondo otim richo ka aluongo kwongʼ e ngimane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
