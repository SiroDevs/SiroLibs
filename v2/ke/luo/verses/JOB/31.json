      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:20"
      },
      "items": [
        {
          "text": "nikech ne atwangʼone lewni maliet gi yie rombena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
