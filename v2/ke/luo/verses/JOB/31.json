      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:26"
      },
      "items": [
        {
          "text": "kata ka dwe ringo e tekone mos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
