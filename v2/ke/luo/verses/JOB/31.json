      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:22"
      },
      "items": [
        {
          "text": "kendo mad ochodi olwar piny koa kama ochomoree.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
