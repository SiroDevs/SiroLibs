          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kapo ni aseketo genona e dhahabu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
