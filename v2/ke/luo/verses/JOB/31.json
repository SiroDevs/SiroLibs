          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kapo ni asebedo mamor ka jasika ni e chandruok",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
