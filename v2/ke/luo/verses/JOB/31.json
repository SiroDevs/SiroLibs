      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:25"
      },
      "items": [
        {
          "text": "kata ka asemor kuom mwandu mathoth ma lweta osechoko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
