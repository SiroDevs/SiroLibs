      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:27"
      },
      "items": [
        {
          "text": "kendo ne atingʼonegi bada ka agombo lamogi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
