      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:28"
      },
      "items": [
        {
          "text": "nikech ginyiso ni ok asebedo ja-ratiro ne Nyasaye man malo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
