          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "to donge ne ogwedha gi chunye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
