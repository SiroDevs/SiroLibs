      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:29"
      },
      "items": [
        {
          "text": "kata ka asenyiere ka masira obirone,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "to chutho pod ok ayiene dhoga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
