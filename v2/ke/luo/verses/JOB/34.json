      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:22"
      },
      "items": [
        {
          "text": "kata kama olil gi tipo ma joricho nyalo pondoe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge gima ochuno ni Nyasaye nyaka non dhano amingʼa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:23"
      },
      "items": [
        {
          "text": "eka okelgi e nyime mondo oyalgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oketho telo mar joma roteke ma ok oyalogi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:24"
      },
      "items": [
        {
          "text": "kendo oketo joma moko e telo kargi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ongʼeyo timbegi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:25"
      },
      "items": [
        {
          "text": "oloko loch mag-gi gotieno mi otiekgi chuth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumo joricho e lela",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:26"
      },
      "items": [
        {
          "text": "nikech timbegi maricho kama ji duto nyalo nenogie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech negilokore giweyo luwe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
