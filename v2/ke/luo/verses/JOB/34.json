  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Elihu nowacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Winjuru wechena, un joma riek;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:2"
      },
      "items": [
        {
          "text": "chiknauru itu, un joma osomo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech it temo weche",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:3"
      },
      "items": [
        {
          "text": "mana kaka lep bilo chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayieruru kendwa gima nikare;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:4"
      },
      "items": [
        {
          "text": "wapuonjreuru kaachiel kuom gima ber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ayub wacho ni, 'Aonge ketho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:5"
      },
      "items": [
        {
          "text": "to Nyasaye otamore timona maber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni an kare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "to pod ikwana mana ni an ja-miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "kata obedo ni aonge ketho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "to asere mare osechwoya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "moweya gi adhola ma ok thiedhre!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To en ngʼa machalo gi Ayub;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:7"
      },
      "items": [
        {
          "text": "mamodho ajara kaka pi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "En e achiel gi joma timbegi richo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:8"
      },
      "items": [
        {
          "text": "kendo oriwore gi joricho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech osebedo kowacho ni, 'Onge ohala ma dhano yudo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:9"
      },
      "items": [
        {
          "text": "ka otemo matek mondo otim gima ber ne Nyasaye!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omiyo lingʼuru uwinja, un joma nigi winjo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Nyasaye ok nyal timo gima rach kata dichiel,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Maratego ok tim gima ok owinjore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochulo dhano kaluwore gi timbene",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:11"
      },
      "items": [
        {
          "text": "okelone mana gima owinjore gi timbene.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En gima kwero mondo Nyasaye otim gima ok owinjore;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:12"
      },
      "items": [
        {
          "text": "kendo mondo Jehova Nyasaye Maratego ongʼad bura ma ok nikare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa mane okete jarit piny?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:13"
      },
      "items": [
        {
          "text": "En ngʼa mane oketo piny duto e bwo tekone?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka dabed ni Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:14"
      },
      "items": [
        {
          "text": "ogolo muche makelo ngima kuom dhano,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ji duto ditho dichiel",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:15"
      },
      "items": [
        {
          "text": "kendo dhano didogi e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka un gi winjo adier to winjuru wachni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:16"
      },
      "items": [
        {
          "text": "kendo chikuru itu ne gima awacho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama ochayo adiera bende nyalo rito loch adier?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:17"
      },
      "items": [
        {
          "text": "Ere gimomiyo iketo bura kuom ngʼama ja-ratiro kendo Jal Maratego?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge Nyasaye ema wacho ne ruodhi ni, 'Un joma nono,'",
          "type": "text",
          "attrs": {
