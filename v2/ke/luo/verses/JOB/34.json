      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:27"
      },
      "items": [
        {
          "text": "kendo ne ok gidewo yorene kata achiel.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negimiyo ywak joma odhier ochopo malo e nyime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:28"
      },
      "items": [
        {
          "text": "mine owinjo ywak jochan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ka nenore ni olingʼ, to en ngʼa ma dingʼadne bura?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Koso kopando wangʼe, to en ngʼa ma dinene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "To kata kamano en ema orito ogendini",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo kik gibed e bwo loch ngʼat mokia Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:30"
      },
      "items": [
        {
          "text": "kendo machiko ni ji obadho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka dipo ngʼato nyalo wachone Nyasaye ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:31"
      },
      "items": [
        {
          "text": "'Aseketho to ok anachak atimne ngʼato marach.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonja mondo ane gik mopondona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:32"
      },
      "items": [
        {
          "text": "kapo asetimo gimoro marach,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:32"
      },
      "items": [
        {
          "text": "to ok abi achak atim kamano kendo!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere kaka idwaro ni Nyasaye otimni maber,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "to in to idagi lokori?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "In ema nyaka ingʼad e pachi iwuon,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "ok an, omiyo koro nyisane gima ingʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Joma nigi winjo nyiso pachgi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:34"
      },
      "items": [
        {
          "text": "joma riek mawinja wachona ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
