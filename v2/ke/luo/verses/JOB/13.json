  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wengena oseneno magi duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:1"
      },
      "items": [
        {
          "text": "kendo ita osewinjo tiendgi maber.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima ungʼeyo, an bende angʼeyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:2"
      },
      "items": [
        {
          "text": "kik upar ni afuwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye Maratego ema daher mondo awuogo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:3"
      },
      "items": [
        {
          "text": "kendo mondo anyis Nyasaye gik mane chunya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un to uumo adiera gi miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:4"
      },
      "items": [
        {
          "text": "uchalo jothieth ma ok nyal thiedho tuo!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudwaro nyiso ni uriek",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:5"
      },
      "items": [
        {
          "text": "to mad koro ulingʼ alingʼa kar wuoyo!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro winjuru ane gima awacho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:6"
      },
      "items": [
        {
          "text": "chikuru itu ne ywakna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere gima omiyo uwuoyo marach kuom Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:7"
      },
      "items": [
        {
          "text": "Koso uparo ni miriambou biro konyo Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende Nyasaye nyalo yie kodu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:8"
      },
      "items": [
        {
          "text": "kudwaro loko adiera bedo miriambo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende doyud adiera kuomu kononou?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:9"
      },
      "items": [
        {
          "text": "Bende duwuonde kaka uwuondo dhano?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro kwerou ratiro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:10"
      },
      "items": [
        {
          "text": "kapo ni udew wangʼ ji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge tekone biro goyou gi kihondko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:11"
      },
      "items": [
        {
          "text": "Donge mbi mare biro bwogou?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeche muthoro mangʼenygo onge tich mana ka buch kendo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:12"
      },
      "items": [
        {
          "text": "wecheu yomyom mana ka agulni mag lowo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lingʼuru kendo weyauru awuo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:13"
      },
      "items": [
        {
          "text": "mondo gima dwaro timorenano otimre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo madimi abed e chandruok,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:14"
      },
      "items": [
        {
          "text": "ka atiyo gi ngimana mana kaka an ema ahero?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ka onega, to pod abiro keto genona kuome;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:15"
      },
      "items": [
        {
          "text": "omiyo pod abiro mana wacho wechena e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chutho, mano ema biro kelona resruok",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:16"
      },
      "items": [
        {
          "text": "nikech onge ngʼama okia Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:16"
      },
      "items": [
        {
          "text": "manyalo hedhore michopi e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik iti mos mondo iwinj wechena;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:17"
      },
      "items": [
        {
          "text": "kendo yie mondo iwinj gik ma awacho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka koro aseikora dwoko wach makora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:18"
      },
      "items": [
        {
          "text": "angʼeyo ni ubiro kwana kaka ngʼama kare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ngʼato kuomu nyalo donjona ni an jaketho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
