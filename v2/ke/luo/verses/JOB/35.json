  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JOB 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Elihu nowacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.1",
            "verseOrgIds": [
              "JOB.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende iparo ni itimo gima ber",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:2"
      },
      "items": [
        {
          "text": "kiwacho ni, 'In kare e nyim Nyasaye?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e iyeno bende ipenjo ni, 'Mano to konya gangʼo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:3"
      },
      "items": [
        {
          "text": "koso ohala mane ma ayudo ka ok atimo richo?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daher mondo adwoki",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:4"
      },
      "items": [
        {
          "text": "in kaachiel gi osiepenigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼiuru polo malo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:5"
      },
      "items": [
        {
          "text": "mondo unee boche polo kaka ni kuma bor.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka umedo timo richo, to obadhe gangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:6"
      },
      "items": [
        {
          "text": "Kata ka richou ngʼeny to mano nyalo timone angʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka un joma kare to bedou makare miye angʼo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:7"
      },
      "items": [
        {
          "text": "koso en angʼo muchiwone?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbeu maricho hinyo mana dhano machal kodu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:8"
      },
      "items": [
        {
          "text": "kendo timbeu makare bedo konyruok mana ne yawuot ji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ji ywak malit nikech tingʼ mapek moyie kuomgi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:9"
      },
      "items": [
        {
          "text": "giywak mana ni mondo ogolgi e bwo loch joma thirogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "To onge ngʼato kuomgi mawachoe ni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:10"
      },
      "items": [
        {
          "text": "'Nyasaye mane ochweya nikanye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:10"
      },
      "items": [
        {
          "text": "Nyasaye mamiyo ji wende gotieno,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mapuonjowa gik mathoth moloyo kaka opuonjo le manie piny",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:11"
      },
      "items": [
        {
          "text": "kendo mamiyo wabedo mariek moloyo winy mafuyo e kor polo?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok odwok ji ka giywakne",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:12"
      },
      "items": [
        {
          "text": "nikech wich teko mar joricho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adier, Nyasaye ok chik ite ne ywakgi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:13"
      },
      "items": [
        {
          "text": "maonge tiendgi Jehova Nyasaye Maratego ok dewgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwacho ni Nyasaye ok winj wecheni",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "ka iwacho ni ok inene,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "kata obedo ni isetero kwayoni e nyime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "kendo pod irite mondo odwoki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende imedo wacho ni kata ji ok okum gi mirimbe mager",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "kendo kata mana richo ma ji timo ok obadhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Ayub wuoyo ka ngʼama ofuwo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:16"
      },
      "items": [
        {
          "text": "maonge rieko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    }
  ],
