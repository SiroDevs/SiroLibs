          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adier, ananene gi wangʼa awuon mana an ma ok ngʼat moro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
