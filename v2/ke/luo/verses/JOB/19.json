          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata ndikgi gi kalamb chuma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
