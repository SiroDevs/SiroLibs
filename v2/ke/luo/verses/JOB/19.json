  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOB 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayub odwoko Bildad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ayub nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.1",
            "verseOrgIds": [
              "JOB.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ubiro chando chunya nyaka karangʼo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:2"
      },
      "items": [
        {
          "text": "ka uchuoya gi weche?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro useyanya nyadipar",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:3"
      },
      "items": [
        {
          "text": "kendo uonge gi wichkuot ka umonja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapo ni en adier ni asebaro mabor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:4"
      },
      "items": [
        {
          "text": "to mano obadhou gangʼo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kapo ni unyalo tingʼoru malo moloya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:5"
      },
      "items": [
        {
          "text": "kendo uchuoya gi wach nikech chandruok ma an-go,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "to kara ngʼeuru ni Nyasaye osechwanya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:6"
      },
      "items": [
        {
          "text": "kendo gogo mare osemaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka aywak ni, 'Itimona marach!' Onge ngʼama dewa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:7"
      },
      "items": [
        {
          "text": "to kata ka adwaro kony, to ok anyal yudo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osedino yorena ma ok anyal kalo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:8"
      },
      "items": [
        {
          "text": "kendo osemiyo kuonde maluwo otimo mudho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osemaya duongʼna",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:9"
      },
      "items": [
        {
          "text": "mi ogolo osimbo e wiya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oseturo denda duto motieka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:10"
      },
      "items": [
        {
          "text": "kendo opudho genona ka ngʼama pudho yien.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirimbe maliel ka mach ni kuoma;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:11"
      },
      "items": [
        {
          "text": "kendo okwana kaka achiel kuom wasike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolweny mage pangore kochoma gi tekregi duto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "gigona agengʼa ka gidwaro kedo koda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "kendo giguro hembegi e alwora mar dalana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Osepoga gi owetena monywolago;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:13"
      },
      "items": [
        {
          "text": "kendo jogo mosiepena bende oseringo oweya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anywolana oseringo oweya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:14"
      },
      "items": [
        {
          "text": "kendo osiepena wigi osewil koda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenda gi jotichna ma nyiri kwana kaka ngʼat ma gikia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:15"
      },
      "items": [
        {
          "text": "kendo ginena kaka japiny moro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aluongo jatichna moro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:16"
      },
      "items": [
        {
          "text": "kata bed mana ni asaye gi dhoga awuon, to ok odewa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiega ok dwar winjo tikna;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:17"
      },
      "items": [
        {
          "text": "kendo kata mana owetena bende ok dwar sudo buta machiegni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka yawuowi matindo bende jara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:18"
      },
      "items": [
        {
          "text": "kendo ka ginena, to ginyiera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osiepena mageno ok dwara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
      ]
    },
    {
