      "attrs": {
        "style": "q2",
        "vid": "JOB 19:29"
      },
      "items": [
        {
          "text": "nikech paro marach ma un-gono,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
