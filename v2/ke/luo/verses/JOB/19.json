      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:27"
      },
      "items": [
        {
          "text": "Mano kaka chunya ogeno odiechiengno!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
