      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:20"
      },
      "items": [
        {
          "text": "kendo gima adongʼ-go en mana ring laka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.20",
            "verseOrgIds": [
              "JOB.19.20"
            ]
          }
        }
      ]
