          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka uwacho ni, 'Mano kaka udhi nyime kungʼadona bura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
