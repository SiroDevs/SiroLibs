      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:25"
      },
      "items": [
        {
          "text": "kendo chiengʼ giko nochungʼ kongʼado bura ne piny.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
