      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:24"
      },
      "items": [
        {
          "text": "kata ne gorgi e lwanda kama ok ginyal ruchoree!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
