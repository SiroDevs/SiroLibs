      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:26"
      },
      "items": [
        {
          "text": "to e ringruogni anane Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
