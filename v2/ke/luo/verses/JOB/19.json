      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:23"
      },
      "items": [
        {
          "text": "kendo ndikgi e kitabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
    {
