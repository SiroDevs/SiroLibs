      "attrs": {
        "style": "q2",
        "vid": "JOB 19:19"
      },
      "items": [
        {
          "text": "jogo mane chunya ohero bende ok dwara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.19",
            "verseOrgIds": [
              "JOB.19.19"
            ]
          }
        }
