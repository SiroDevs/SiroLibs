          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kechauru, yaye osiepena, kechauru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
          }
        }
      ]
