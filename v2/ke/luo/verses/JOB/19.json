      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:28"
      },
      "items": [
        {
          "text": "mana ka gima oseyala moseyudi ni an jaketho,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
