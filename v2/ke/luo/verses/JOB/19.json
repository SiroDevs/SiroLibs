          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼeyo ni Jawarna nitie kendo ngima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
