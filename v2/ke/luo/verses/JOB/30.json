      "attrs": {
        "style": "q2",
        "vid": "JOB 30:20"
      },
      "items": [
        {
          "text": "achungʼ e nyimi to ingʼiya angʼiya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
