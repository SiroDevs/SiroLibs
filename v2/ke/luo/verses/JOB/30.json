      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:18"
      },
      "items": [
        {
          "text": "mangʼeny ma asebedogo kendo tuo noketho denda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
