              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye ngʼwana gi ngʼuta kuom chandruok",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
