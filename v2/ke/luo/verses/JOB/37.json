          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyiswa ane gima dwanyis Nyasaye machalo kamano",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:19"
      },
      "items": [
        {
          "text": "ka kata mana pek ma wan-go ok wanyal ketone e yo mayot.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
      ]
    },
    {
