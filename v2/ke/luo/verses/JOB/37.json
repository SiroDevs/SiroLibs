          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wuok koa yo nyandwat",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
            ]
          }
