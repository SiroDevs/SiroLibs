  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JOB 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An bende mor ma kamano",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:1"
      },
      "items": [
        {
          "text": "miyo chunya bwok kendo ridore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingʼuru kendo uwinj dwond Nyasaye kaka mor ka polo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:2"
      },
      "items": [
        {
          "text": "kendo winjuru weche mawuok e dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "En emomiyo mil polo menyo kor polo duto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:3"
      },
      "items": [
        {
          "text": "chakre tungʼ piny konchiel nyaka komachielo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano iwinjo dwonde ka mor matek",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "kendo omor gi dwol mar duongʼne.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "Ka dwonde ochako mor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "to onge gima nyalo gengʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwond Nyasaye mor e yo miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:5"
      },
      "items": [
        {
          "text": "otimo gik madongo moyombo parowa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacho ne pe ni, 'Lwar piny,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:6"
      },
      "items": [
        {
          "text": "kendo ne nyidho matin ni, 'Lokri koth maduongʼ.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otimo kamano mondo ji duto mane ochweyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:7"
      },
      "items": [
        {
          "text": "ongʼe kaka tichne chalo mi ji duto bed gi luoro nikech teko mare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le ringo pondo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:8"
      },
      "items": [
        {
          "text": "gisiko e buchegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiti biro koa kuma opandee,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:9"
      },
      "items": [
        {
          "text": "kendo koyo mangʼich bende yamo riembo mi ke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Much Nyasaye kelo pe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:10"
      },
      "items": [
        {
          "text": "kendo pige mopongʼo wi lowo poto mabed matek ka lwanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opongʼo boche polo gi ngʼich mar pi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:11"
      },
      "items": [
        {
          "text": "kendo okeyo mil polo mare ei bochego.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilwore mana kaka Nyasaye dwaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "ka gidhi e wangʼ piny duto ka gitimo gima ochikogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalo moko Nyasaye kelo rumbi e piny mondo okumgo ji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:13"
      },
      "items": [
        {
          "text": "to ndalo moko okelo koth mondo onyisgo herane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Winjie wachni, Ayub;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:14"
      },
      "items": [
        {
          "text": "bed mos ipar gik miwuoro mag Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ingʼeyo kaka Nyasaye chiko boche polo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:15"
      },
      "items": [
        {
          "text": "kendo kaka omiyo polo mil?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ingʼeyo kaka boche oliero e kor polo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:16"
      },
      "items": [
        {
          "text": "gik miwuoro mag Jal ma riekone tut mogik?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To in ma kinde ma yamb milambo kudho mi two piny,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:17"
      },
      "items": [
        {
          "text": "to isiko mana ka luya chami ei lewni mirwakogi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bende inyalo konye yaro polo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:18"
      },
      "items": [
        {
          "text": "mi obed matek ka mula mothedhi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.18",
            "verseOrgIds": [
              "JOB.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
