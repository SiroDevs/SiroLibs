      "attrs": {
        "style": "q2",
        "vid": "JOB 37:22"
      },
      "items": [
        {
          "text": "ka en gi duongʼ malich machalo gi lich mar dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
