      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:21"
      },
      "items": [
        {
          "text": "yamo oseriembo boche duto moweyo kor polo nono.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
