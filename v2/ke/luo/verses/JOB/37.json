      "attrs": {
        "style": "q2",
        "vid": "JOB 37:23"
      },
      "items": [
        {
          "text": "nikech en ja-adiera kendo opongʼ gi tim makare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
