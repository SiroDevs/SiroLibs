          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro onge ngʼama nyalo rango wangʼ chiengʼ tir,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
      ]
    },
