      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:21"
      },
      "items": [
        {
          "text": "nikech polo olendo kendo orieny makech;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
        }
      ]
    },
