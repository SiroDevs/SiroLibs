      "attrs": {
        "style": "q2",
        "vid": "JOB 37:23"
      },
      "items": [
        {
          "text": "kendo en gi teko maduongʼ ok otim marach ne ji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
