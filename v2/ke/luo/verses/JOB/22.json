  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOB 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elifaz odwoko Ayub",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Elifaz ja-Teman nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhano adhana to konyo Nyasaye gangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:2"
      },
      "items": [
        {
          "text": "Kata bed ni ngʼato riek mogik,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:2"
      },
      "items": [
        {
          "text": "angʼo ma dokonygo Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere ohala ma Jehova Nyasaye Maratego yudo kibedo ngʼat makare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "Koso iparo ni ka yoregi oriere, to mano konye gangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iparo ni Nyasaye kwedi kendo kumi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:4"
      },
      "items": [
        {
          "text": "nikech in ngʼama kare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge otimoni kamano",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:5"
      },
      "items": [
        {
          "text": "nikech timbegi kod richo misetimo ngʼeny?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ikawo lep oweteni kaka gir singo miweyogi duk;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:6"
      },
      "items": [
        {
          "text": "eka mondo gichuli mwandu mane gikawo kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ituono joma ool pi modho",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:7"
      },
      "items": [
        {
          "text": "kendo ne ipando chiemo ne joma odenyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne itimo kamano kata obedo nine in ngʼama duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:8"
      },
      "items": [
        {
          "text": "ne in gi lopi iwuon midakie, kendo ji noluori.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ok ikonyo mon ma chwogi otho",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:9"
      },
      "items": [
        {
          "text": "kendo nyithind kiye bende ne ithago.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano emomiyo obadho oluori moketi diere",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:10"
      },
      "items": [
        {
          "text": "kendo masira mabiro apoya ochomi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano emomiyo mudho olwori ma ok inyal neno",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:11"
      },
      "items": [
        {
          "text": "kendo chandruok malich olwori.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Donge Nyasaye odak e polo malo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:12"
      },
      "items": [
        {
          "text": "Donge en malo moyombo nyaka sulwe man malo mogik?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To eka in iwacho ni, 'Nyasaye to ongʼeyo angʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:13"
      },
      "items": [
        {
          "text": "Ere kaka onyalo ngʼadonwa bura to boche polo oime?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boche mogingore oime, omiyo ok onyal nenowa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:14"
      },
      "items": [
        {
          "text": "seche mowuotho koni gi koni e kor polo.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idwaro siko e yore machon",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:15"
      },
      "items": [
        {
          "text": "kuonde ma joma richo osewuothe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gin joma ne kargi olal nono kapok ndalogi ochopo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:16"
      },
      "items": [
        {
          "text": "kendo ma mise margi ne ohula oywero modhigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwachone Nyasaye ni, 'Wewa mos!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:17"
      },
      "items": [
        {
          "text": "En angʼo ma Jehova Nyasaye Maratego nyalo timonwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To eka Nyasaye ema ne opongʼo utegi gi gik mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:18"
      },
      "items": [
        {
          "text": "omiyo an apogora gi rieko ma joma timbegi richo ngʼado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma kare neno masira to pod gimor amora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
