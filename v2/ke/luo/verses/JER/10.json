{
  "id": "JER.10",
  "number": "10",
  "bookId": "JER",
  "reference": "Jeremia 10",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JER 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye kod nyiseche manono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winji gima Jehova Nyasaye wachoni, yaye od Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "\"Kik ipuonjri yore ogendini",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "kata ibed gi bwok gi ranyisi manie kor polo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:2"
      },
      "items": [
        {
          "text": "kata obedo ni gibwogo ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar kit jogi kod timbegi onge tiende;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:3"
      },
      "items": [
        {
          "text": "gingʼado yien koa e bungu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:3"
      },
      "items": [
        {
          "text": "bangʼe japecho paye gi koyo mare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwire gi fedha gi dhahabu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:4"
      },
      "items": [
        {
          "text": "giriwe motegno gi musmal ka gigoye gi nyundo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:4"
      },
      "items": [
        {
          "text": "mondo kik oyiengni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka gima ibwogogo gik moko e puothe mag budho,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "e kaka nyisechegi manonogo ok nyal wuoyo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "nyaka tingʼ-gi nikech ok ginyal wuotho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "Kik uluorgi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "ok ginyal hinyou",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:5"
      },
      "items": [
        {
          "text": "kata timonu gima ber.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ngʼama chalo kodi, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:6"
      },
      "items": [
        {
          "text": "iduongʼ, kendo nyingi maratego nigi teko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa ma ok onego miyi luor,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "yaye Ruodh ogendini?",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "Ma gima iwinjori godo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "Kuom jorieko duto mag ogendini kod",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "kuom pinjeruodhigi duto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:7"
      },
      "items": [
        {
          "text": "onge ngʼama chalo kodi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giduto gionge paro kendo gifuwo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:8"
      },
      "items": [
        {
          "text": "ipuonjogi gi nyiseche manono mag bepe mopa maonge tich.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedha mothedhi ikelo koa Tarshish",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "kendo dhahabu koa Ufaz.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "Gima japecho kod jatheth oseloso",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "irwako gi lewni marambulu gi maralik,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:9"
      },
      "items": [
        {
          "text": "giduto olosgi gi jotich molony.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye e Nyasaye madieri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "en e Nyasaye mangima, Ruoth manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "Ka iye owangʼ, to piny tetni;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:10"
      },
      "items": [
        {
          "text": "ogendini ok nyal mirimbe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyisgi ma: 'Nyiseche manonogi, mane ok ochweyo polo gi piny, nolal nono e piny kendo e bwo polo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.11",
            "verseOrgIds": [
              "JER.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Nyasaye nochweyo piny gi tekone;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:12"
      },
      "items": [
        {
          "text": "ne ochako piny gi riekone,",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 10:12"
      },
      "items": [
        {
          "text": "kendo oyaro polo gi ngʼeyo mare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.12",
            "verseOrgIds": [
              "JER.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka omor ka polo, to pige manie polo wuo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.13",
