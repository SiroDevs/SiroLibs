{
  "id": "MIC.6",
  "number": "6",
  "bookId": "MIC",
  "reference": "Mika 6",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MIC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wach ma Jehova Nyasaye nigo kuom jo-Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "\"Chungʼ malo, ket kwayoni e nyim gode;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "thuche mondo owinj wach ma in-go.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Un gode, winjuru wach ma Jehova Nyasaye nigo kodu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "chikuru itu un mise mochwere mag piny.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "Nikech Jehova Nyasaye nigi wach kod joge;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "en gi bura gi jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Un joga en angʼo ma asetimonu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:3"
      },
      "items": [
        {
          "text": "Asemiyou tingʼ mapek e yo mane? Dwokauru ane.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne agolou e piny Misri",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "kendo agonyou thuolo e piny wasumbini.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Ne aoro Musa, mondo otelnu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "bende naoro Harun gi Miriam.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un joga parieuru",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "kaka Balak ruodh jo-Moab nongʼado rieko,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "kendo kaka Balaam wuod Beor nodwoko.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "Parieuru wuoth mane uago Shitim nyaka Gilgal,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "mondo mi ungʼe timbe makare mag Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En angʼo ma dabigo e nyim Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "kendo akulrago e nyim Nyasaye moloyo?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "Dabi e nyime gi misengini miwangʼo pep",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "koso gi nyiroye ma jo-higa achiel?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge Jehova Nyasaye dibed mamor ka akelone imbe alufe gi alufe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "kata ka kelone moo mamol ka aora?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Dachiw nyathina makayo eka wena kethona,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "koso nyodo mar ringra eka wena richona?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osenyisi gima ber yaye dhano.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "To angʼo ma Jehova Nyasaye dwaro ni itim?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Odwaro ni iti gadiera kendo iher kecho ji",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "kendo iwuoth mobolore e nyim Nyasachi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ketho kod kum mar jo-Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru! Luong Jehova Nyasaye ne dala maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "chutho luoro nyingi en rieko.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "\"Yie kum momiyi kaachiel gi ngʼama ochiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye oganda ma timbegi mono, bende wiya pod diwil awila",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
      "items": [
        {
          "text": "gi mwandu-u muyudo e yor mecho,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
      "items": [
        {
          "text": "kod giu mag pimo mokwongʼ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende dagony ngʼat man-gi rapim mag mayo ji",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:11"
      },
      "items": [
        {
          "text": "gi gorogoro modi?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joge machwo momewo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "gin joma ohero lweny.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "To joge mamoko duto gin jo-miriambo",
          "type": "text",
