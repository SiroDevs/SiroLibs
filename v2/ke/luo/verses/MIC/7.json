  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MIC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Midhiero mar Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka midhiero omaka malit!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Chutho achalo ngʼat ma hulo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "e puoth mzabibu e ndalo oro.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Onge olemb mzabibu mochokore ma dacham,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "ngʼope mokwongo chiek ma agombo bende onge.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma oluoro Nyasaye bende osetieki morumo e piny;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "ja-ratiro onge kata mana achiel modongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "Ji duto pondo karito mondo ochwer remo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "moro ka moro manyo nyawadgi mondo odwodi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lweteni duto ariyo olony e timo richo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "Jatelo dwaro mich githuon,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "jangʼad bura kawo asoya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "jogi maroteke chuno ji gi timo gigegi magidwaro,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "giduto kaachiel giwinjore e wachni.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma nenore ni longʼo kuomgi; chalo gi kuth oriangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Joma ikwano ni odimbore mogik eigi richo moloyo kuth chiedo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Odiechieng jorito mau osechopo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "odiechiengʼ ma Nyasaye limoue.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Ma e kinde ma ikeyoue.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik igen kuom ngʼama odak e bathi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "kata osiepni kik iyiego.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "Wuo kitangʼ kata gi chiegi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "ma ugenorugo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech wuowi koro ochayo wuon mare,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "kendo nyako noked kod min mare;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "chi wuowi bende noked gi damare,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "wasik ngʼato nobed joode owuon.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anto amanyo Jehova Nyasaye gi wangʼa ka an kod geno,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "arito Nyasaye ma Jawarna;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "kendo Nyasacha biro winja.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel biro chungʼ kendo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "In jasika kik inyiera",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "kata obedoni asepodho to abiro chungʼ kendo!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Kata obedo ni abet e mudho",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye biro doko lerna.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech aseketho e nyim Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "ayie tingʼo mirimbe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "nyaka chop oket kwayona kare,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "mi oyud ni aonge ketho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "Obiro kela e ler",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "mi ane adierane.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wasika none gima otimore",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "mi ginipongʼ gi wichkuot,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "gin mane giwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
