{
  "id": "2CH.20",
  "number": "20",
  "bookId": "2CH",
  "reference": "2 Weche Mag Ndalo 20",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2CH 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafat oloyo jo-Moab kod jo-Amon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano jo-Moab kod jo-Amon kaachiel gi jo-Meun moko nobiro mondo oked gi Jehoshafat.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomoko nobiro monyiso Jehoshafat niya, \"Oganda lweny maduongʼ moa Edom bironi koa e loka Nam kocha. Gisechopo Hazazon Tamar\" (tiende ni, En Gedi).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat nobwok omiyo nokwayo Jehova Nyasaye kendo nochiko jo-Juda duto mondo otwe chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Juda duto nobiro kaachiel mondo gikwa Jehova Nyasaye kony, adier negia e mier mag Juda duto mondo gidwar wangʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehoshafat nochungʼ e nyim oganda mar Juda kod Jerusalem e hekalu mar Jehova Nyasaye e nyim laru manyien",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 20:6"
      },
      "items": [
        {
          "text": "\"Jehova Nyasaye ma Nyasach kwerewa, donge in e Nyasaye mantie e polo? In ema itelone pinyruodhi duto mag ogendini. Teko gi nyalo ni e lweti, kendo onge ngʼato manyalo siri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasachwa, donge niriembo joma nodak e pinyni ka jo-Israel neno mimiyo nyikwa Ibrahim osiepni pinyni nyaka chiengʼ?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.7",
            "verseOrgIds": [
              "2CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gisedak e pinyni kendo gisegeroni kama ler mar lemo maluongo Nyingi kagiwacho ni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.8",
            "verseOrgIds": [
              "2CH.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ka gima rach ogore kuomwa, bed ni en kum gi ligangla kata dera mar tho kata kech, to wabiro chungʼ e nyimi e hekaluni miluongo gi Nyingi kendo wanaywagreni nikech masirani, kendo iniwinjwa mi ireswa.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.9",
            "verseOrgIds": [
              "2CH.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To koro jo-Amon gi jo-Moab kod jo-Got Seir mane ok iyiene jo-Israel mondo omonj pinygi kane gia Misri; kuom mano ne giweyogi ma ok gitiekogi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye gima gitimonwa kuom biro mondo giriembwa e gima nimiyowa kaka girkeni marwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasachwa, donge dingʼadnegi bura? Wan to waonge kod teko ma wanyalo kedogo kod oganda lweny maduongʼni ma monjowani. Wan ok wangʼeyo gima dwatim, genowa waketo kuomi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Juda duto gi mondegi gi nyithindgi kod nyithindgi matindo nochungʼ e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Roho mar Jehova Nyasaye nolor kuom Jahaziel wuod Zekaria ma wuod Benaya, ma wuod Jeyel ma wuod Matania ma ja-Lawi kendo nyakwar Asaf kane ochungʼ e dier chokruok.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya, \"Chik iti in Ruoth Jehoshafat kaachiel gi jogo duto modak Juda gi Jerusalem! Jehova Nyasaye wachoni kama: 'Kik ibed gi luoro kendo chunyi kik parre nikech oganda lweny maduongʼni, nimar lweny ok maru, to en mar Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiny upangru ka udhi irgi. Gibiro biro ka gitwenyo got ka giluwo Holo mar Ziz kendo ubiro yudogi e giko piny mar kamotuo mar Jeruel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok ochuno ni uked e lwenyni. Kawuru kuondeu, chunguru motegno mondo une loch ma Jehova Nyasaye nomiu, yaye Juda kod Jerusalem. Kik ubed maluor, kendo kik chunyu nyosre. Kiny dhiuru mondo urad kodgi nimar Jehova Nyasaye nobed kodu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat nokulore piny auma kendo jo-Juda duto kod Jerusalem nogoyo chonggi piny e nyim Jehova Nyasaye ka gilame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Lawi moko, jo-Kohath kod jo-Kora nochungo mopako Jehova Nyasaye ma Nyasach jo-Israel gi dwol maduongʼ ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gokinyi mangʼich negiwuok gidhi e piny Tekoa motwo. Kane giwuok Jehoshafat nochungʼ kawacho niya, \"Chikuru itu un jo-Juda kod joma odak Jerusalem! Beduru kod geno kuom Jehova Nyasaye ma Nyasachu eka unukuwo, bende yieuru gi jonabi mage eka unulo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane osepimo wach gi joge, Jehoshafat noyiero joma onego owerne Jehova Nyasaye mondo gipak berne mokalo apima mar lerne ka gitelo e nyim jolweny ka giwer niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "\"Dwokneuru Jehova Nyasaye erokamano,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "nikech herane osiko nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gichako wer kendo pake, Jehova Nyasaye norundogi ma jo-Amon kod jo-Moab kaachiel gi jo-Got Seir manomonjo Juda nochako kedo kendgi giwegi mi nologi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Amon gi jo-Moab noriwore mochako kedo kod jo-Got Seir monegogi kendo otiekogi pep. Kane gitieko nego jo-Got Seir, negikonyore kuom tiekore kendgi giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jo-Juda nobiro kama omanyore gi kama otimo ongoro kendo gingʼiyo oganda lweny maduongʼ, negineno mana ringre joma otho koriere piny kendo ne githo maonge ngʼama notony.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehoshafat gi joge nodhi mondo giyak mwandu kendo neginwangʼo gige lweny mangʼeny kod lewni kod gik moko ma nengogi tek mangʼeny ma ok neginyal tingʼo duto. Gik miyako ne ngʼeny ahinya mane otieko ndalo adek mondo giyakgi duto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To chiengʼ mar angʼwen negichokore e Holo mar Beraka kama ne gipakoe Jehova Nyasaye. Ma emomiyo iluonge ni Holo mar Beraka nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Juda gi jo-Jerusalem duto kotelnegi kod Jehoshafat nodok Jerusalem ka gimor gi ilo nikech Jehova Nyasaye nomiyogi mor kuom loyo wasikgi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidonjo Jerusalem e hekalu mar Jehova Nyasaye ka gigoyo nyatiti gi asili kod turumbete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro mar Nyasaye nomako pinjeruodhi mag pinje kane giwinjo kaka Jehova Nyasaye nokedo gi wasik jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano pinyruoth Jehoshafat ne nigi kwe nikech Nyasache nomiye yweyo kuonde duto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Giko mar loch Jehoshafat",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano e kaka Jehoshafat norito Juda. Ne en ja-higni piero adek gabich kane obedo ruodh Juda kendo norito piny kodak Jerusalem kuom higni piero ariyo gabich. Min mare ne nyinge Azuba nyar Shilhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noluwo yore Asa wuon mare kendo ne ok oweyogi, nimar notimo gima kare e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano kuonde motingʼore gi malo mag lemo ne ok omuki kendo ji ne pok oketo chunygi kuom Nyasach kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gik mamoko manotimore e ndalo loch Jehoshafat aa chakruok nyaka gikogi ondikgi e weche mag ndalo mag Jehu wuod Hanani kaka ochan-gi e kitap ruodhi mag Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Jehoshafat ruodh Juda notimo winjruok kod Ahazia ruodh Israel manongʼadne bura nikech timbene maricho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne giwinjore ni gihondho yiedhi mangʼeny mag loko ohala. Bangʼe kane oselosgi Ezion Geber,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliezer wuod Dodavahu ma ja-Maresha nokoro wach marach kuom Jehoshafat kowacho niya, \"Nikech isetimo winjruok kod Ahazia, Jehova Nyasaye biro ketho gigo ma iseloso.\" Yiedhigo nobarore kendo ne ok ginyal kwangʼ mondo gitim ohala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
    }
  ],
