  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "2CH 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia otimo Sap Pasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nooro wach ni jo-Israel duto gi jo-Juda kendo nondiko barupe ni jo-Efraim kod jo-Manase kokwayogi mondo gibi Jerusalem e hekalu mar Jehova Nyasaye mondo gitim Sap Pasaka ni Jehova Nyasaye ma Nyasach jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth gi jodonge kod joma nochokore Jerusalem nowinjore ni gitim Sap Pasaka e dwe mar ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ok ginyal time e kinde mane onego otime nimar jodolo moromo ne pok opwodhore to ji bende ne pok ochokore Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenroni ne berne ruoth kod joma nochokore.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negingʼado bura mondo giland wachni e Israel duto kochakore Bersheba nyaka Dan kagiluongo ji mondo gibi Jerusalem otim Pasaka mar Jehova Nyasaye Nyasach Israel nikech ne pok otime gi ji mangʼeny kaka ondiki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo joote nodhi Israel gi Juda duto kaka ruoth nochiko ka gitingʼo barupe mane oa ir ruoth kod jodonge mondikie niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 30:6"
      },
      "items": [
        {
          "text": "\"Jo-Israel dwoguru ir Jehova Nyasaye ma Nyasach Ibrahim gi Isaka kod Israel mondo mi oduog iru un joma odongʼ mosetony e lwet ruodhi mag Asuria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ubed ka kwereu gi oweteu mane oweyo luwo Jehova Nyasaye ma Nyasach kwereu momiyo gidoko gima iluoro mana kaka uneno sani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ubed gi tok matek kaka kwereu nobedo, bolreuru ni Jehova Nyasaye. Biuru e kama ler mar lemo ma osepwodho nyaka chiengʼ. Tineuru Jehova Nyasaye ma Nyasachu mondo mi mirimbe mager owuog kuomu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka udwogo ir Jehova Nyasaye eka joweteu gi nyithindu notimnegi ngʼwono mi nowegi giduogi e pinygi kod joma noterogi e twech nikech Jehova Nyasaye ma Nyasachu en jangʼwono kendo en gihera maduongʼ omiyo ok noloknu ngʼeye ka udwogo ire.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joote nodhi e dala ka dala e piny Efraim gi Manase duto nyaka ochopo Zebulun to ji nocharogi kendo nyierogi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano jo-Asher moko kod jo-Manase kaachiel gi jo-Zebulun nobolore modhi Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e piny Juda bende ema ne lwet Nyasaye ne nitie kuom jogo mondo omigi bedo e paro achiel mondo gitim gima ruoth gi jodonge nochiko kaluwore gi wach mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mangʼeny nochokore Jerusalem e dwe mar ariyo mondo gitim Sap Makati ma ok oketie Thowi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negigolo kende mag misango miwangʼoe liswa mane nitie Jerusalem kaachiel gi kende mag misango miwangʼoe ubani mi giwitogi e Holo mar Kidron.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne giyangʼo nyarombo mar Pasaka Chiengʼ mar apar gangʼwen mar dwe mar ariyo jodolo kod jo-Lawi noyudo wichkuot omiyo negipwodhore mi gikelo misengini miwangʼo pep e hekalu mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe negikawo keregi mapile kaka ondikie chike Musa ngʼat Nyasaye. Jodolo nokiro remo manomigi kod jo-Lawi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ji mangʼeny ei oganda ne pod ok opwodhore, nochuno jo-Lawi mondo oyangʼ nyirombe mag Sap Pasaka ni jogo duto mane ok ler kendo ne ok nyal chiwo nyirombegi ni Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni ji mathoth manowuok e piny Efraim gi Manase gi Isakar kod Zebulun ne ok opwodhore, to kata kamano negichamo Pasaka ka ok giluwo gima nondiki. To Hezekia nolamonigi kawacho niya, \"Mad Jehova Nyasaye mangʼwon owene ngʼato angʼata,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "moseketo chunye mondo oluw Nyasaye ma en Jehova Nyasaye ma Nyasach kwerene kata obedo ni ok oler kaluwore gi chike mag kama ler mar lemo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehova Nyasaye nowinjo kwayo mar Hezekia mochango jogo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel mane nitiere Jerusalem notimo Sap Makati ma ok oketie Thowi kuom ndalo abiriyo ka gimor gi-ilo maduongʼ ka jo-Lawi kod jodolo werne Jehova Nyasaye pile ka pile ka gigoyo thumbe mag pak mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nojiwo jo-Lawi duto mane ongʼeyo tich mar tiyo ne Jehova Nyasaye. Kuom ndalo abiriyo negichamo chiemo mane opognigi kendo negitimo misango mar lalruok kagipako Jehova Nyasaye ma Nyasach kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo mane ochokore nowinjore mondo gimed timo sawoni ndalo abiriyo mamoko, omiyo kuom ndalo abiriyo mamoko negitimo kamano gi mor.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia ruodh Juda nochiwo ni joma nochokore rwedhi alufu achiel kod rombe gi diek alufu abiriyo, to jodonge nochiwonegi rwedhi alufu achiel kod rombe gi diek alufu apar. Jodolo mangʼeny ahinya nopwodhore.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma nochokore duto mane oa Juda kaachiel gi jodolo kod jo-Lawi kod joma nochokore koa Israel kaachiel gi jodak mane odak Israel kod mane odak Juda ne mor gi ilo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nitie mor maduongʼ Jerusalem mapok nobedo Jerusalem chakre ndalo Solomon wuod Daudi ma ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodolo gi jo-Lawi nochungʼ mondo ogwedh ji, kendo Nyasaye nowinjogi nikech lembgi nochopo e polo kar dakne maler.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        }
      ]
    }
  ],
