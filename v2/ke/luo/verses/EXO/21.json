          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "to wuon burno nyaka chul kuom lalno; kendo nyaka ochul wuon gigi kendo jamni mothogo nobed mage.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
