              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka rwath ochwowo dichwo kata dhako ma misumba, to wuon rwadhno nyaka chul ruodh misumbano fedha ma pekne romo nus kilo, kendo rwadhno nyaka negi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
