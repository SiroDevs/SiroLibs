  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EXO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya, \"Ne, aseketi kaka Nyasaye ni Farao, kendo Harun owadu biro bedoni janabi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka iwach gik moko duto ma achiki, kendo Harun owadu nonyis Farao mondo owe jo-Israel owuog e pinye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro keto chuny Farao bedo matek, ma kata obedo ni abiro nwoyo honni kod ranyisi e piny Misri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to Farao ok nowinju. Omiyo anasand jo-Misri gi masiche madongo kakumogi malich mi anagol joga ma jo-Israel e piny Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo jo-Misri nongʼe ni an Jehova Nyasaye e kinde ma anakumgi ka agolo jo-Israel kuomgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kod Harun notimo mana kaka Jehova Nyasaye nochikogi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde mane giwuoyo gi Farao, Musa ne ja-higni piero aboro to Harun to ne ja-higni piero aboro gadek.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ludh Harun olokore thuol",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho ne Musa kod Harun niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka Farao onyisou ni mondo utim hono moro, to in Musa nyis Harun ni, 'Kaw ludhi kendo dire piny e nyim Farao,' kendo obiro lokore thuol.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, Musa kod Harun ne odhi ir Farao mi gitimo mana kaka Jehova Nyasaye nochikogi. Harun nodiro ludhe piny e nyim Farao kod jodonge mi nolokore thuol.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao noluongo jorieko kod ajuoke mag Misri mine gitimo gik machal gi mane Harun otimo ka gitiyo gi teko mag yedhegi mopondo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato kuomgi nodiro ludhe piny kendo nolokore thuol. To ludh Harun nomwonyo ludhegigo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano, chuny Farao ne odoko matek kendo ne ok onyal winjogi mana kaka Jehova Nyasaye ne osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masira mar remo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya, \"Chuny Farao pod tek, odagi weyo joga mondo odhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhi ir Farao gokinyi ka odhi e aora. Rite e bath aora Nael mondo irom kode, bende kaw luth mane olokore thuol cha e lweti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka inyise ni, 'Jehova Nyasaye, ma Nyasach jo-Hibrania, oseora mondo anyisi niya: We joga odhi, mondo gilama e thim. To nyaka chop koroni pok iwinjo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho: Ranyisini biro miyo ingʼe ni an Jehova Nyasaye: Abiro chwado pi aora Nael gi luth mantie e lwetani kendo pigno biro lokore remo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rech manie aora Nael biro tho, kendo aora biro dungʼ, jo-Misri ok nomodh pigno.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho ne Musa niya, \"Nyis Harun ni, 'Kaw ludhi mondo irie badi ewi pige mag Misri, ma gin aore matindo kod madongo, yewni kod kuonde duto mag kano pi, kendo gibiro lokore remo.' Remo biro bedo kamoro amora e piny Misri nyaka ei agulni molos gi kite.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa kod Harun notimo mana kaka Jehova Nyasaye nochikogi. Notingʼo ludhe e nyim Farao kod jodonge duto mi ochwado aora Nael kendo pige duto nolokore remo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rech manie aora Nael notho, kendo aora nodungʼ marach ma jo-Misri ne ok nyal modho pige. Remo ne nitie kamoro amora e piny Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ajuoke mag Misri notimo mana gik machal kamano gi tijegi mag ajuoke mi chuny Farao nomedo doko matek; ne ok onyal winjo wach Musa kod Harun mana kaka Jehova Nyasaye nosewacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano nodok e kare mar dak, kendo ne ok odewo wechegi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Misri duto nokunyo bath aora Nael mondo giyud pi modho, nikech ne ok ginyal modho pi aorano.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masira mar ogwende",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalo abiriyo norumo bangʼ ka Jehova Nyasaye nosechwado aora Nael.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
  ],
