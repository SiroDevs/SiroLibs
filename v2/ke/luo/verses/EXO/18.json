  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EXO 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jethro olimo Musa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro Jethro, jadolo mar Midian kendo jaduongʼ Musa, nowinjo gik moko duto mane Nyasaye osetimo ni Musa, kaachiel gi joge ma jo-Israel, bende kaka Jehova Nyasaye nosegolo jo-Israel kawuok e piny Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka Musa ne oseriembo chiege ma Zipora, jaduongʼne Jethro norwake",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi yawuote ariyo. Wuowi achiel niluongo ni Gershom nimar Musa nowacho niya, \"Asebedo jadak e piny ma ok marwa,\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to machielo nochako ni Eliezer nimar nowacho niya, \"Nyasach wuonwa ema ne jakonyna, ne oresa kane Farao dwaro nega gi ligangla.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jethro, jaduongʼ Musa, kaachiel gi yawuot Musa gi chi Musa, ne jobiro ire e thim kama ne ojotie but got mar Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyudo ka Jethro oseorone wach niya, \"An, jaduongʼni Jethro abiro iri gi chiegi kaachiel gi nyithindi ariyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Musa nowuok mondo orom ni jaduongʼne mi nokulore piny kendo onyodhe. Ne gimosore eka bangʼe gidonjo ei hema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.7",
            "verseOrgIds": [
              "EXO.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nonyiso jaduongʼne gik moko duto ma Jehova Nyasaye notimone Farao kaachiel gi jo-Misri, nikech jo-Israel. Bende nonyise chandruok duto mane giseyudo e yo kendo kaka Jehova Nyasaye noseresogi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.8",
            "verseOrgIds": [
              "EXO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jethro ne mor mar winjo gik mabeyo duto ma Jehova Nyasaye nosetimo ne jo-Israel kuom resogi e lwet jo-Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.9",
            "verseOrgIds": [
              "EXO.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya, \"Opak Jehova Nyasaye, ma noresoi e lwet jo-Misri bende e lwet Farao kendo oreso oganda e lwet jo-Misri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.10",
            "verseOrgIds": [
              "EXO.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro angʼeyo ni Jehova Nyasaye duongʼ moloyo nyiseche moko duto, nimar notimo kamano ne joma nosando jo-Israel marach.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jethro, jaduongʼ Musa, nokelo misango miwangʼo pep kod misengni mamoko bende ne Nyasaye, kendo Harun nobiro kod jodongo duto mag jo-Israel mondo gichiem gi jaduongʼ Musa e nyim Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyne, Musa nobet e kome mondo obed jangʼad bura ne ogandano, kendo negichungʼ ka gilwore chakre okinyi nyaka odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jaduongʼne oneno gik moko duto mane Musa timo ne oganda, nowacho ne kama, \"En angʼo ma itimo ne ogandani? En angʼo momiyo in kendi ema ibedo kaka jangʼad bura, ka jogi olwori chakre okinyi nyaka odhiambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.14",
            "verseOrgIds": [
              "EXO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nodwoke niya, \"Nikech ji biro ira mondo omany dwach Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gin gi larruok moro amora e kindgi, to ikelona kendo athego joma ochwanyorego mi anyisgi buche kod chike mag Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
            "verseOrgIds": [
              "EXO.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaduongʼ Musa nodwoko kawacho niya, \"Gima itimoni ok ber.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.17",
            "verseOrgIds": [
              "EXO.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "In kaachiel gi joma osebiro irigi ubiro mana ool. Tijni pek mohewi; ok inyal time kendi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik iti mondo angʼadni rieko kendo Nyasaye obed kodi. Onego ibed jachungʼ jogi e nyim Nyasaye kendo iter larruokgi e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.19",
            "verseOrgIds": [
              "EXO.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonjgi buche kod chike duto kendo nyisgi kaka onego gidagi kod tije monego gitim.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nyaka iyier joma niginyalo ma gin ji moluoro Nyasaye, joma ogen ma ok kaw asoya, kendo iketgi gibed jotend ji maromo alufu alufu, mia mia, piero abich abich, kod apar apar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.21",
            "verseOrgIds": [
              "EXO.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketgi mondo gibedi jongʼad bura ni oganda kinde duto, to buche matek kende ema ginyalo keloni. Buche mayot ginyalo ngʼado giwegi, nimar mano biro miyo tingʼ ma in-go bedo mayot, nimar gibiro lawe kodi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.22",
            "verseOrgIds": [
              "EXO.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka itimo kama kaka Nyasaye dwaro, to ok ibi ol kendo jogi biro dok e miechgi kamor.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.23",
            "verseOrgIds": [
              "EXO.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nowinjo jaduongʼne mi notimo gik moko duto mane owacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.24",
            "verseOrgIds": [
              "EXO.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyiero joma riek kuom jo-Israel duto mi noketogi jotelo mag ji alufu alufu, mia mia, piero abich abich, kod apar apar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.25",
            "verseOrgIds": [
              "EXO.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negitiyo kaka jongʼad bura mar oganda kinde duto. Buche matek negikelo ne Musa, to buche mayot negitieko giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.26",
            "verseOrgIds": [
              "EXO.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa nokowo jaduongʼne e yo kendo Jethro nodok e pinygi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.27",
            "verseOrgIds": [
              "EXO.18.27"
            ]
          }
        }
      ]
    }
  ],
