        "sid": "AMO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e weche Amos mane en achiel kuom jokwath mane odak Tekoa. Wechegi ne oneno kuom Israel higni ariyo kane piny pok oyiengni, kendo e kindeno Uzia ema ne ruodh Juda, to Jeroboam ma wuod Joash to ne ruodh Israel.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "\"Jehova Nyasaye ruto koa Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "kendo dwonde mor koa Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "lege ma jokwath kwayoe two,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "kendo wi got Karmel mosebedo ka ngʼich koro ner.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bura mibiro ngʼado ni ogendini modak mokiewo gi jo-Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "\"Jo-Damaski osebedo katimo richo mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "omiyo ok abi weyo ma ok akumogi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Nikech gisesando jo-Gilead,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "ka gigoyogi kod gima bith molos gi nyinyo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuom mano abiro oro mach e od Hazael,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:4"
      },
      "items": [
        {
          "text": "ma biro wangʼo ohinga mochiel motegno mag Ben-Hadad.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro muko dhoranga Damaski,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "kendo abiro riembo joma odak e Holo mar Aven,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "kaachiel gi ngʼat motingʼo ludh Jehova Nyasaye man Beth Eden.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Jo-Aram ibiro dar miter mabor e twech e piny Kir,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "\"Jo-Gaza osebedo katimo richo mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "omiyo ok abi weyo ma ok akumogi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Nikech gisemako ogendini duto",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "mi giterogi e twech e piny Edom,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuom mano abiro oro mach",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:7"
      },
      "items": [
        {
          "text": "mi owangʼ ohinga mag Gaza mochiel motegno.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro riembo ruodh Ashdod",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "kaachiel gi ngʼat motingʼo ludh Jehova Nyasaye man Ashkelon.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "Abiro kumo dala mar Ekron,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "kendo abiro nego jo-Filistia duto modongʼ,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto owacho.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "\"Nikech richo adek ma jo-Turo osetimo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "kata richo angʼwen, omiyo ok abi weyo ma ok akumogi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "Nikech gisemako ogendini duto mi giterogi e twech e piny Edom,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "ma ok girito winjruok mar osiep mane gitimo kodgi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuom mano abiro oro mach",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.10",
            "verseOrgIds": [
              "AMO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:10"
      },
      "items": [
        {
          "text": "mi wangʼ ohinga mag Turo mochiel motegno.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.10",
            "verseOrgIds": [
              "AMO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "\"Nikech richo adek ma jo-Edom osetimo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "kata richo angʼwen, omiyo ok abi weyo ma ok akumogi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "Nikech nolawo owadgi gi ligangla",
          "type": "text",
