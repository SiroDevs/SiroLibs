{
  "id": "JON.2",
  "number": "2",
  "bookId": "JON",
  "reference": "Jona 2",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JON 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lemo mar Jona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jona ne ni ei rech, nolamo Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "\"Ei masichena naluongo Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "kendo nodwoka.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "Ei bur matut ne aywak mondo ikonya",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "mane iwinjo ywakna.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niluta kuma tut mar nam,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "nyaka kama tutne ogikie piny,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "mi ataro noketa diere;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "kendo apaka kod ahiti madongo duto nokadho kuoma.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne awacho ni,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "'Oseriemba e wangʼi;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "to kata kamano,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "pod abiro siko ka angʼiyo hekalu mari maler.'",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pi mane olwora nobwoga kendo kude mag nam",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:5"
      },
      "items": [
        {
          "text": "bende noima kendo buya mag nam nogajore e wiya.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalutora nyaka e tiend gode mag nam",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "kendo piny nouma chuth nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "To nigola oko kangima",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "e bur matut, yaye Jehova Nyasaye, ma Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka chunya ne dwaro aa ne apari Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "kendo lemona nochopo nyaka e hekalu mari maler.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Joma otwere kalamo nyiseche manono,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:8"
      },
      "items": [
        {
          "text": "jwangʼo ngʼwono mado bedo margi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "An to napaki kod wend goyo erokamano",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "mi natimni misango.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "Gima asesingora nachop kare",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "nikech warruok wuok kuom Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Jehova Nyasaye nowuoyo gi rech mi rechno nongʼogo Jona oko e dho wath kama otwo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JON.3",
    "number": "3",
    "bookId": "JON"
  },
