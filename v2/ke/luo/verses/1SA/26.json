  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1SA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ochako oweyo Saulo ma ok onego",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Zif nodhi Gibea ir Saulo ma giwachone niya, \"Donge Daudi opondo ewi got Hakila momanyore gi Jeshimon?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Saulo nodhi mwalo e piny motimo ongoro e Zif, nodhi gi joge alufu adek, jo-Israel moyier, mondo odwar Daudi kuno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.2",
            "verseOrgIds": [
              "1SA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo noloso kambine but yo man e got Hakila momanyore gi Jeshimon, Daudi to ni kama otwo ma otimo ongoro. Kane oneno ni Saulo noseluwe kuno,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.3",
            "verseOrgIds": [
              "1SA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne ooro jombetre mane ongʼeyo ratiro ni Saulo nosechopo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.4",
            "verseOrgIds": [
              "1SA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Daudi nowuok modhi kuma Saulo nojotie. Noneno kama Saulo gi Abner wuod Ner ma jatend jolwenje, noyudo osenindoe. Saulo ne nindo ei kambi, ka jolweny olwore.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nopenjo Ahimelek ja-Hiti gi Abishai wuod Zeruya, mowadgi Joab niya, \"Ngʼama biro dhi koda mwalo e kambi ir Saulo?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:6"
      },
      "items": [
        {
          "text": "Abishai nowacho niya, \"Abiro dhi kodi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi gi Abishai nodhi ir jolweny gotieno, Saulo nonindo kanyo e kambi kochwoyo tonge piny yo ka wiye. Abner gi jolweny nonindo kolwore.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai nowachone Daudi niya, \"Kawuono Nyasaye oseketo jasiki e lweti. Koro yiena mondo achwowe dichiel gi tonga; ok abi chwowe diriyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Daudi nowachone Abishai niya, \"Kik inege! En ngʼa manyalo keto lwete kuom ngʼat Jehova Nyasaye mowir ma ok oket ne bura?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya, \"Akwongʼora gi nying Jehova Nyasaye mangima, ni Jehova Nyasaye owuon ema nonege; kata ndalone chiengʼ moro nochopi mi otho kata nodhi e lweny mi notho kuno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye ok diyiena ni mondo ater lweta kuom ngʼat Jehova Nyasaye mowir. Koro kaw tongʼ gi puga mar pi machiegni gi wiye kaeto wadhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Daudi nokawo tongʼ kod puga mar pi mane nitie machiegni gi wi Saulo kendo negidhi. Onge ngʼama nonenogi kata mane ongʼeyo wachno, bende onge ngʼama ne ochiewo. Giduto ne ginindo, nikech Jehova Nyasaye nomiyogi nindo matut.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Daudi nongʼado modhi loka machielo mochungʼ ewi got kuma bor; ne odhi mochwalore kodgi; ne nitie thuolo malach e kindgi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nopenjo jolweny kod Abner wuod Ner niya, \"Bende unyalo dwoka, Abner?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:14"
      },
      "items": [
        {
          "text": "Abner nodwoke niya, \"In ngʼa maluongo ruoth?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nopenjo Abner niya, \"Donge in ngʼama dichwo? To ere ngʼama chal kodi e Israel? Angʼo momiyo ne ok irito ruodhi ma en ruoth? Ngʼato nobiro mondo oneg ruodhi ma ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima isetimo ok ber. Akwongʼora gi nying Jehova Nyasaye mangima ni in kod jogi uwinjoru gi tho, nikech ne ok urito ruodhu ma ngʼat Jehova Nyasaye mowir. Ranguru anena, ere tongʼ mar ruoth gi puga mar pi mane nitiere machiegni gi wiye?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nochamo dwond Daudi mowacho niya, \"Mano en dwondi Daudi wuoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:17"
      },
      "items": [
        {
          "text": "Daudi nodwoke niya, \"Ee mano dwonda ruodha ma ruoth.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo nomedo wacho niya, \"Angʼo momiyo ruodha lawo jatichne? Angʼo masetimo, rach mane madimi abed jaketho?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.18",
            "verseOrgIds": [
              "1SA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ruoth ma ruodha oyie owinj weche ma jatije wacho. Ka diponi Jehova Nyasaye ema thuya kodi, to madoyie okaw misango. To ka dipo ni ji ema timo mano to mondo okwongʼ-gi e nyim Jehova Nyasaye! Koro giseriemba mondo kik ayud girkeni ma Jehova Nyasaye omiya kagiwacho ni, 'Dhi iti ne nyiseche mamoko.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro yie mondo remba kik oo piny kuma bor gi kama Jehova Nyasaye nitie. Ruodh Israel osewuok mondo odwar kikun mana kaka ngʼato dwaro winyo e gode.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Saulo nowacho niya, \"Asetimo marach, omiyo duogi, Daudi wuoda. Nikech ne ineno ni ngimana ber kendo owinjore bedie kawuono. Ok nachak atem mondo ahinyi kendo. Adieri asetimo tim ngʼat mofuwo kendo aseketho marach.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nodwoko niya, \"Tongʼ mar ruoth eri ni ka. Or achiel kuom yawuowi obi oome.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye chiwo pok ne ngʼato ka ngʼato moromore gi ratiche gi timne makare. Kawuono Jehova Nyasaye nochiwi e lweta to ne ok anyal keto lweta kuom ngʼat Jehova Nyasaye mowir.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ngimani nelongʼona kawuono, mad ngimana bende bed malongʼo ni Jehova Nyasaye mondo oresa e chandruok duto.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Saulo nowachone Daudi niya, \"Mad gwedhi wuoda Daudi; ibiro timo gik madongo adieri inilochi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:25"
      },
      "items": [
        {
          "text": "Bangʼ mano Daudi nodhi yore, to Saulo nodok dala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1SA.27",
    "number": "27",
    "bookId": "1SA"
  },
  "previous": {
    "id": "1SA.25",
    "number": "25",
    "bookId": "1SA"
  }
}