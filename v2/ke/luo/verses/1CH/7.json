  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isakar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Isakar ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:1"
      },
      "items": [
        {
          "text": "Tola, Pua, Jashub kod Shimron. Yawuot Isakar duto ne gin yawuowi angʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Tola ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:2"
      },
      "items": [
        {
          "text": "Uzi, Refaya, Jeriel, Jamai, Ibsam kod Samuel, mane en jotend anywolagi. Ndalo loch Daudi, joka Tola kokwan chwo ma jolweny koluwore gi nonro mar nywolgi ne gin ji alufu piero ariyo gariyo gi mia auchiel (22,600).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuod Uzi ne en:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izrahia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Yawuot Izrahia ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Mikael, Obadia, Joel kod Ishia. Yawuowi abichgo ne gin ruodhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaluwore gi nonro mar anywolagi ne gin gi chwo alufu piero adek gauchiel (36,000) mane nyalo dhi e lweny, nimar ne gin gi mon gi nyithindo mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wede mag jo-Isakar machwo mane ni e lweny kokwan-gi kaluwore gi nonrogi mar nywolgi ne ji alufu piero aboro gabiriyo (87,000).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Benjamin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Benjamin ne gin adek:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:6"
      },
      "items": [
        {
          "text": "Bela, Beker kod Jediael.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Bela ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:7"
      },
      "items": [
        {
          "text": "Ezbon, Uzi, Uziel, Jerimoth kod Iri, giduto yawuowi abichgo ne gin jotend anywolagi. E ndiko mar nonrogi mar nywol ne gin chwo ma jolweny maromo alufu piero ariyo gariyo gi piero adek gangʼwen (22,034).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Beker ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:8"
      },
      "items": [
        {
          "text": "Zemira, Joash, Eliezer, Elioenai, Omri, Jeremoth, Abija, Anathoth kod Alemeth. Magi duto ne gin yawuot Beker.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonro manie anywolagi, notingʼo nying jotend dhoutgi kod jolweny alufu piero ariyo gi mia ariyo (20,200).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuod Jediael ne en:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Bilhan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Yawuot Bilhan ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Jeush, Benjamin, Ehud, Kenana, Zethan, Tarshish kod Ahishahar.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Jediael duto ne gin jotend anywolagi. Ne nitiere ji ma jolweny alufu apar gabiriyo gi mia ariyo (17,200) mane oikore dhi e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Shup gi jo-Hup ne gin joka Ir, to jo-Hush to ne gin joka Aher.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naftali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Naftali ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:13"
      },
      "items": [
        {
          "text": "Jaziel, Guni, Jezer kod Shilem ma joka Bilha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joka Manase ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:14"
      },
      "items": [
        {
          "text": "Asriel ne nyakware koa kuom dhako machielo ma nyar Aram. Dhakoni nonywolo Makir mane wuon Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makir ne okawo dhako koa kuom jo-Hup kod Shup. Nyamin Makir ne iluongo ni Maaka. Watne machielo ne ochak Zelofehad mane onywolo nyiri kende.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaod Makir ma Maaka ne onywolo wuowi mochake Peresh. Owadgi ne iluongo ni Sheresh, to yawuote ne Ulam kod Rakem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuod Ulam ne en:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Bedan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Magi ne yawuot Gilead ma wuod Makir, ma wuod Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamin mare miluongo ni Hamoleketh nonywolo Ishhod, Abiezer kod Mala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Shemida ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:19"
      },
      "items": [
        {
          "text": "Ahian, Shekem, Liki kod Aniam.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efraim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
