{
  "id": "REV.1",
  "number": "1",
  "bookId": "REV",
  "reference": "Fweny 1",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "REV 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Weche motelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e fweny ma Nyasaye nomiyo Yesu Kristo mondo onyisgo jotichne gik manyaka timre mapiyo. Kristo nomiyo fwenyni ongʼere ka nooro malaikane mondo onyis Johana jatichne.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johana nyiso gigo duto mane oneno e fweny ma en wach Nyasaye kod weche duto mane Yesu Kristo owacho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno masomo weche mokorgi en jahawi kendo ogwedh jogo mawinjo wechegi kendo kano weche mondikgi e chunygi, nikech kinde ma gigi biro timoree chiegni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mos kod pak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Johana,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Andiko ni kanise abiriyo manie piny Asia:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Ngʼwono kod kwe obednu koa kuom Jal mantie, Jal mane nitie kendo Jal mabiro betie, kendo koa kuom Roho abiriyo manie nyim kom duongʼne,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo moa kuom Yesu Kristo, ma janeno mar adier ma ok lokre, jal mane okwongo chier oa kuom joma otho, jaloch mar ruodhi manie piny.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:5"
      },
      "items": [
        {
          "text": "Ne Jal moherowa kendo mosegonyowa kuom richowa gi rembe,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi osemiyo wadoko oganda mag pinyruodhi kod jodolo matiyone Nyasache kendo Wuon mare kendo wuon-gi, mad duongʼ odogne manyaka chiengʼ! Amin.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Neuru, obiro gi boche polo,\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "kendo \"wenge duto nonene,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "nyaka jogo mane ochwowe gi tongʼ\";",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "kendo ogendini duto \"manie piny noywagre nikech en.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Mano e kaka enobedi! Amin.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth Nyasaye wacho niya, \"An e Alfa gi Omega, tiende ni Chakruok kendo Giko, Jal mantie, Jal mane nitie, kendo Jal mabiro betie, Jehova Nyasaye Maratego.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Johana oneno ngʼat machalo gi Wuod Dhano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Johana ma owadu, ma bende achiel kodu e sand gi pinyruoth kod dhil e kinda marwa kuom Yesu, ne an e chula mar Fatimo nikech wach Nyasaye, kod timo neno kuom Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechieng Ruoth, ne an kuom Roho, ne awinjo dwol maduongʼ makok ka turumbete yo kangʼeya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndik gik moko duto mineno e kitabu kendo orgi ne kanise abiriyogi: Efeso, gi Smurna, gi Pergamo, gi Thuatira, gi Sarde gi Filadelfia kod Laodikia.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.11",
                "verseOrgIds": [
                  "REV.1.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nalokora mondo ane ngʼat mane wuoyo koda. Kane alokora ne aneno rachungi teyni abiriyo mag dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "to e dier rachungi teynigo ne nitie ngʼato machalo gi wuod dhano",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "text": "morwakore gi kandho mochopo nyaka e tiende piny, kendo kotweyo kore gi okanda mar dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yie wiye ne rachar ka yie rombo, bende ne rachar ka pe, to wengene ne chalo gi mach makakni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendene ne pakni ka mula mopwodhi gi mach, bende dwonde ne mor ka pi mopongʼ mawuo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E lwete ma korachwich notingʼo sulwe abiriyo, bende ligangla mabith ma dhoge ariyo ne wuok e dhoge. Lela wangʼe ne rieny ka chiengʼ marieny mangʼangʼni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane anene, ne apodho e tiende mana ka ngʼat motho. Eka noketo lwete ma korachwich kuoma mowachona niya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik iluor. An e Jal Mokwongo kendo Jal Mogik.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.17",
                "verseOrgIds": [
                  "REV.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "An e Jal Mangima; ne atho, to koro angima nyaka chiengʼ! An-gi rayaw mar tho kod mar piny joma otho.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.18",
                "verseOrgIds": [
                  "REV.1.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kuom mano, ndik gigo miseneno, gigo mantie kod gigo mabiro timore e kindego mabiro.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.19",
                "verseOrgIds": [
                  "REV.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tiend wach mopandi mar sulwe abiriyo mane ineno e lweta ma korachwich, kod rachungi teyni abiriyogo mag dhahabu ema: Sulwe abiriyogo e malaike mag kanise abiriyo, to rachungi teyni abiriyo gin e kanise abiriyogo.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.20",
                "verseOrgIds": [
                  "REV.1.20"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "next": {
    "id": "REV.2",
