    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 144:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak obed ni Jehova Nyasaye ma en Lwandana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "pakeuru en motego lwetena ne lweny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "kendo en momiyo lith lwetena bedo mongʼith e kedo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 144:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Nyasacha ma jahera kendo en ohingana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "bende en kar pondona kendo en jakonyna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "En okumbana ma agengʼorago,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "kendo en ema oloyona joma ni e bwoya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 144:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano to en angʼo, yaye Jehova Nyasaye, momiyo iketo chunyi kuome,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:3"
      },
      "items": [
        {
          "text": "koso wuod dhano to en angʼo, momiyo isiko ipare?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 144:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano chalo gi muya nono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:4"
      },
      "items": [
        {
          "text": "kendo ndalone chalo gi tipo makadho piyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 144:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuogi e polo, yaye Jehova Nyasaye, wuogi mondo ilor piny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:5"
      },
      "items": [
        {
          "text": "lor piny imul gode, mondo gidhuol iro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 144:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or mil polo, mondo ike wasigu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:6"
      },
      "items": [
        {
          "text": "dir aserni magi, mondo itiekgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 144:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rie lweti koa e polo nyaka piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "mondo ikonya, kendo igola,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "e pige ma tekregi ngʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "kendo e lwet jopinje mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 144:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma dhogi opongʼ gi miriambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:8"
      },
      "items": [
        {
          "text": "kendo ma lwetgi ma korachwich opongʼ gi wuondruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 144:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro weroni wer manyien, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "abiro weroni wer mamit ka agoyoni thum man-gi tonde apar,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 144:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abiro werne Jal mamiyo ruodhi locho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "kendo makonyo Daudi jatichne e dho ligangla mager.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 144:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konya kendo gola",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "e lwet jopinje mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "ma dhogi opongʼ gi miriambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "kendo ma lwetgi ma korachwich opongʼ gi wuondruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 144:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka yawuotwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "biro chalo gi yiende mayudo pi maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "kendo nyiwa biro chalo gi sirni modol maber",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "mondo olich dala ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 144:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dechewa biro pongʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "gi kit mwandu duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "Rombewa biro medore gana gi gana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "ee, gibiro bedo gana mathoth e lek magwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 144:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo rwedhi magwa biro ywayo misike mapek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.14",
            "verseOrgIds": [
              "PSA.144.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
