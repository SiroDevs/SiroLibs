        {
          "text": "Zaburi 99",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 99:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye e Ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "ogendini mondo okirni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "obet e kom lochne e kind kerubi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "piny mondo oyiengni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 99:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye duongʼ miwuoro e Sayun;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:2"
      },
      "items": [
        {
          "text": "otingʼe malo moyombo ogendini duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 99:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owinjore gipak nyingi maduongʼ kendo miwuoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:3"
      },
      "items": [
        {
          "text": "nyinge ler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 99:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nyalo, ohero bura makare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "isechungo adiera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "isetimo ne joka Jakobo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:4"
      },
      "items": [
        {
          "text": "gima adier kendo makare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.4",
            "verseOrgIds": [
              "PSA.99.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 99:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhialuru Jehova Nyasaye ma Nyasachwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:5"
      },
      "items": [
        {
          "text": "kendo lameuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:5"
      },
      "items": [
        {
          "text": "e tiend kome mobetie nikech oler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 99:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa gi Harun ne gin jodolo mage e dier jodolo mamoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:6"
      },
      "items": [
        {
          "text": "Samuel ne en achiel kuom joma ne luongo nyinge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:6"
      },
      "items": [
        {
          "text": "negiluongo Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:6"
      },
      "items": [
        {
          "text": "kendo nodwokogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.6",
            "verseOrgIds": [
              "PSA.99.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 99:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne owuoyo kodgi e siro mar bor polo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:7"
      },
      "items": [
        {
          "text": "negirito chikene gi buche mane omiyogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 99:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye ma Nyasachwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:8"
      },
      "items": [
        {
          "text": "ne idwokogi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:8"
      },
      "items": [
        {
          "text": "ne in Nyasaye maweyo richo ne jo-Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:8"
      },
      "items": [
        {
          "text": "kata obedo ni ne ikumo timbegi mobam.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 99:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingʼuru nying Jehova Nyasaye ma Nyasachwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:9"
      },
      "items": [
        {
          "text": "kendo lamuru e gode maler,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:9"
      },
      "items": [
        {
          "text": "nimar Jehova Nyasaye ma Nyasachwa ler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        }
      ]
    }
  ],
