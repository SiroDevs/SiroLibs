  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PSA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Kaluwore gi",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "sheminith",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kony ji yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:1"
      },
      "items": [
        {
          "text": "nikech joma oluoro Nyasaye koro onge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:1"
      },
      "items": [
        {
          "text": "joma jo-adiera oserumo e dier ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato riambo ne nyawadgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "dhogi mohero jaro ji wuoyo gi wuond.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye ongʼad oko lep duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:3"
      },
      "items": [
        {
          "text": "ma jaro ji kod lep duto masungore;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mawacho niya, \"Wabiro wuoyo kaka wahero;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "kendo onge ngʼama biro tamowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "Koso en ngʼa ma ruodhwa manyalo tamowa timo kamano?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nikech dich modigo joma ok nyal",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "kod chur ma joma ochando churgo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "koro abiro aa malo,\" Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "\"Abiro ritogi e lwet joma sandogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche Jehova Nyasaye liw,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "giliw ka fedha moleny e lowo mowangʼ maliet ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "mopwodhi ndalo abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, yie iritwa maber kik gimoro ohinywa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:7"
      },
      "items": [
        {
          "text": "kendo reswa e lwet joma kamago nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma timbegi richo wuotho koni gi koni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:8"
      },
      "items": [
        {
          "text": "kendo gima rach ema ji puoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    }
  ],
