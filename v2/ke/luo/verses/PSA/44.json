          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "To pod ne igoyowa agoya mimiyo ondiegi olawowa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
