  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "PSA 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar yawuot Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Nyasaye, wasewinjo gi itwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "kendo kwerewa osenyisowa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "gik mane itimo e ndalogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "ndalo machon gi lala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iriembo ogendini mamoko gi lweti iwuon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "kendo ne iguro kwerewa kargi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "ne itieko ogendinigo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "mi imiyo kwerewa okar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ok giloyo pinyno gi liganglagi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "kendo kata bedegi bende ne ok okelonigi loch;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "to mana badi iwuon ma korachwich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "kod ler mar wangʼi ema nomiyo gilocho nimar ne iherogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "In e Ruodha kendo Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "magolo chik mondo Jakobo olochi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasiro wasikwa nikech in,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:5"
      },
      "items": [
        {
          "text": "waloyo joma kedo kodwa kuom nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atungʼ mara ok ageno kuome,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:6"
      },
      "items": [
        {
          "text": "liganglana bende ok mi alochi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "to in ema imiyowa loch ewi wasikwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:7"
      },
      "items": [
        {
          "text": "imiyo joma kedo kodwa neno wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungawa ni kuom Nyasaye odiechiengʼ duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "kendo wabiro pako nyingi nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.44.8",
                "verseOrgIds": [
                  "PSA.44.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro isedagiwa kendo isedwokowa piny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:9"
      },
      "items": [
        {
          "text": "tinde ok idhi e kedo gi jolwenjwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne imiyo waringo e nyim wasigu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "kendo joma kedo kodwa oseyakowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ijwangʼowa mondo ongamwa ka rombe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:11"
      },
      "items": [
        {
          "text": "kendo isekeyowa e dier pinje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iuso jogi nono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "maonge ohala mane iyudo kuom usogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isemiyo wadoko joma iyanyo e dier joma odak butwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:13"
      },
      "items": [
        {
          "text": "wan joma inyiero kendo ma ocha gi joma olworowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isemiyo olokwa ngero e dier ogendini;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "kendo ogendini kino wigi konenowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wichkuot mara osiko neno e wangʼa odiechiengʼ duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:15"
      },
      "items": [
        {
          "text": "kendo lela wangʼa wichkuot oumo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seche ma joma ochaya kendo yanya dirona weche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:16"
      },
      "items": [
        {
          "text": "nikech jasigu oramo ni nyaka ochul kuor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
