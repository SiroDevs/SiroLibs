          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nikech in, tho ochomowa odiechiengʼ duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
