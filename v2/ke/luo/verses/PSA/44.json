          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunywa ne pok oa moweyi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
