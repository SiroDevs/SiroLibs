          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi duto notimorena, kata obedo ni wiwa ne pok owil kodi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
