      "attrs": {
        "style": "q2",
        "vid": "PSA 44:20"
      },
      "items": [
        {
          "text": "kata ni ne waseyaro lwetwa ne nyasaye moro ma wendo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
