          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiew, yaye Ruoth Nyasaye! Inindo nangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
