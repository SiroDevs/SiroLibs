      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:18"
      },
      "items": [
        {
          "text": "kendo tiendewa ne pok okier moweyo yori.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
      ]
