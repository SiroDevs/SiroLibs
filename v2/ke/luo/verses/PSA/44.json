      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:19"
      },
      "items": [
        {
          "text": "kendo ne iumowa gi mudho mandiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
