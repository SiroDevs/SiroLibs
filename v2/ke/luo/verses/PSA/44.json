      "attrs": {
        "style": "q2",
        "vid": "PSA 44:23"
      },
      "items": [
        {
          "text": "Yaw wangʼi inen! Kik ikwedwa nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
