          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye e jakwadha, ok anachand gimoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
