  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "83",
        "style": "c",
        "sid": "PSA 83"
      },
      "items": [
        {
          "text": "83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 83",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer. Zaburi mar Asaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 83:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ilingʼ, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:1"
      },
      "items": [
        {
          "text": "kik iywe, yaye Nyasaye, bende kik ibed mos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.1",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 83:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye kaka wasiki piem kodi gi koko maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "Neye kaka joma kedo kodi ngʼanyoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 83:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichano timo ne jogi marach lingʼ-lingʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "giloso chenro maricho ne joma chunyi ohero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 83:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwacho niya, \"Biuru watiekgi mi girum pep kaka oganda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:4"
      },
      "items": [
        {
          "text": "mondo nying mar Israel kik chak par kendo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 83:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giloso chenro ka giriwo pachgi bedo achiel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "gilosoni riwruok mondo giked kodi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 83:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin jo-Edom gi jo-Ishmael, jo-Moab gi jo-Hagri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 83:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo-Gebal, jo-Amon kod jo-Amalek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:7"
      },
      "items": [
        {
          "text": "jo-Filistia kaachiel gi joma odak Turo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 83:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka jo-Asuria bende oseriwore kodgi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:8"
      },
      "items": [
        {
          "text": "mondo oriw lwetgi ne nyikwa Lut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.83.8",
                "verseOrgIds": [
                  "PSA.83.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 83:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timnegi kaka ne itimo ne Midian,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "mana kaka nitimo ne Sisera gi Jabin e Aora Kishon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 83:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mane jotho Endor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "modoko owuoyo mar dhok e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 83:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi jogi momew ochal gi Oreb kod Zeb",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:11"
      },
      "items": [
        {
          "text": "mi ruodhigi duto chal gi Zeba kod Zalmuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 83:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mane jowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "\"Wakawuru pewe mag kwath mag Nyasaye mondo obed marwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 83:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi gichal gi buya mayot-yot, yaye Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:13"
      },
      "items": [
        {
          "text": "mi gichal gi mihudhwe ma yamo tero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 83:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka mach wangʼo bungu maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:14"
      },
      "items": [
        {
          "text": "kata kaka mach wangʼo wi got,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 83:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "e kaka in bende ilawgi gi ahiti maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:15"
      },
      "items": [
        {
          "text": "kendo ibwog-gi gi yambi makudho matek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 83:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pongʼ wengegi gi wichkuot",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:16"
      },
      "items": [
        {
          "text": "mondo ji omany nyingi, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 83:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad wigi kuodi nyaka chiengʼ kendo gisiki ka luoro omakogi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.17",
            "verseOrgIds": [
              "PSA.83.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:17"
      },
      "items": [
        {
          "text": "mad gilal nono ka gin gi wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.17",
            "verseOrgIds": [
              "PSA.83.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 83:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi gingʼe ni in, ma nyingi Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.18",
            "verseOrgIds": [
              "PSA.83.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:18"
      },
      "items": [
        {
          "text": "ni in kendi e Nyasaye Man Malo Moloyo kendo ni iloyo piny duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.18",
            "verseOrgIds": [
              "PSA.83.19"
            ]
          }
