          "text": "90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "Kitabu mar Angʼwen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.90-PSA.106"
          },
          "items": [
            {
              "text": "Zaburi 90–106",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Lamo mar Musa ngʼat Nyasaye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 90:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, isebedo kar dak marwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:1"
      },
      "items": [
        {
          "text": "nyaka nene e tienge duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 90:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane pok gode obetie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "kata kane pok ichweyo piny gi ji modak e iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "to isebedo ka in Nyasaye nyaka nene kendo manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 90:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idwoko dhano e lowo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:3"
      },
      "items": [
        {
          "text": "kiwacho niya, \"Doguru e lowo un koth dhano.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 90:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar higni alufu achiel e nyimi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "chalo gi odiechiengʼ manyoro mosekalo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "kata gi sa mar otieno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 90:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iywoyo dhano ilalgo nono ka nindo mar tho terogi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:5"
      },
      "items": [
        {
          "text": "gichalo gi lum mangʼich mar okinyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 90:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma kata obedo ni loth ka ngʼich gokinyi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:6"
      },
      "items": [
        {
          "text": "to godhiambo to ner kendo two.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 90:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirimbi tiekowa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:7"
      },
      "items": [
        {
          "text": "kendo kecho mikechogo kodwa bwogowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 90:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseketo richowa e nyimi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:8"
      },
      "items": [
        {
          "text": "ee, richowa ma watimo lingʼ-lingʼ ineno seche duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 90:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalowa kadho piyo nikech mirimbi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:9"
      },
      "items": [
        {
          "text": "hikwa rumo piyo gi chir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 90:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalowa en piero abiriyo kata piero aboro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "ka ringrewa otegno;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "to kata kamano ndalogo duto opongʼ gi chandruok kod kuyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "nimar gikalo piyo, kendo gilal nono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 90:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa mongʼeyo teko mar mirimbi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:11"
      },
      "items": [
        {
          "text": "Nimar gero mari nigi teko machalo gi teko ma luori kelo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 90:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo puonjwa kwano ndalowa kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:12"
      },
      "items": [
        {
          "text": "mondo wabed gi chuny mariek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 90:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiro siko kikecho nyaka karangʼo, yaye Jehova Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:13"
      },
      "items": [
        {
          "text": "Lokri, kech jatichni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 90:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Romwa gokinyi gi herani ma ok rem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:14"
      },
      "items": [
        {
          "text": "mondo wawer gi ilo kendo wabed mamor ndalowa duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 90:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wabed mamor amingʼa mana kaka isemiyo waneno malit,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:15"
      },
      "items": [
        {
          "text": "marom gi higni ma wasenene chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 90:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad tijeni nere gi jotichni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:16"
      },
      "items": [
        {
          "text": "mad duongʼni nyisre ne nyithindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
