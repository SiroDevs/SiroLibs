        {
          "text": "Zaburi 98",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 98:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru ne Jehova Nyasaye wer manyien,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "nimar osetimo gik miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "lwete korachwich gi bade maler",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "osekelone warruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 98:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye osemiyo warruokne ongʼere",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:2"
      },
      "items": [
        {
          "text": "kendo osefwenyone ogendini timne makare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 98:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oseparo herane",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "kod adierane ne dhood Israel;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "kuonde duto ma piny ogikie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "oseneno warruok mar Nyasachwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 98:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koguru gi mor ni Jehova Nyasaye, un piny duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:4"
      },
      "items": [
        {
          "text": "weruru kod ilo gi dwol mamit;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 98:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "weruru mamit ne Jehova Nyasaye kugoyo nyatiti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:5"
      },
      "items": [
        {
          "text": "werneuru mamit kugoyo nyatiti gi dwond wer molungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 98:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "werneuru gi turumbete kod tung im maywak matek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:6"
      },
      "items": [
        {
          "text": "koguru gi mor e nyim Jehova Nyasaye ma Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 98:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nam mondo owuo, kaachiel gi gik moko duto manie iye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:7"
      },
      "items": [
        {
          "text": "kod piny duto, gi ji duto modak e iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 98:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aore mondo opam lwetgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:8"
      },
      "items": [
        {
          "text": "gode mondo ower kaachiel ka gimor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 98:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "onego giwer e nyim Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "nimar obiro mondo ongʼad bura ne piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Obiro ngʼado bura ne piny e yo makare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "kendo obiro yalo ji maonge dewo wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    }
  ],
