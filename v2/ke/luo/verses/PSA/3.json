  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "PSA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi, kane oringo oa ir wuode Abisalom.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, mano kaka wasika thoth!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:1"
      },
      "items": [
        {
          "text": "Mano kaka joma lawa ngʼeny!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mangʼeny wuoyo kuoma, kagiwacho ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:2"
      },
      "items": [
        {
          "text": "\"Nyasaye ok bi rese.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.2",
                "verseOrgIds": [
                  "PSA.3.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To In e okumbana mogengʼa, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:3"
      },
      "items": [
        {
          "text": "In ema imiyo alocho, kendo isetingʼo wiya malo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aywak matek ka alemo ni Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:4"
      },
      "items": [
        {
          "text": "kendo odwoka gie gode maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.4",
                "verseOrgIds": [
                  "PSA.3.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariera piny mondo anindi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:5"
      },
      "items": [
        {
          "text": "kendo achako aa malo, nikech Jehova Nyasaye orita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok abi luoro ji gana gi gana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:6"
      },
      "items": [
        {
          "text": "molwora mondo otimna marach.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa malo, yaye Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Resa, yaye Nyasacha!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Tur chok lemb wasika duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Muk leke joma timbegi richo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resruok aa mana kuom Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:8"
      },
      "items": [
        {
          "text": "Mad igweth jogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.8",
                "verseOrgIds": [
                  "PSA.3.9"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
