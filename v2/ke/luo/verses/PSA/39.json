  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "PSA 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Ne Jeduthun. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne awacho niya, \"Abiro ritora e yorena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "kendo abiro rito lewa kik wach richo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "abiro tweyo dhoga gi tol kinde duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "ma joma timbegi richo ni buta.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e seche mane ok awuo kendo alingʼ mos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "kane ok awach gimoro amora maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "pek manie chunya nomedore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya nodoko maliet e iya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "kendo kane amedo paro matut, to nomedo bedo malit;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "eka ne atingʼo dhoga mi awuoyo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, nyisa giko mar ngimana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "bende nyisa kar romb ndalona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "mondo abed ka angʼeyo ni ndalona kadho piyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseketo ndalona obedo machiek ka bad dhano;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "kar romb higni maga ok gimoro e nyimi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "ngima dhano ka dhano en mana muya nono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.5",
                "verseOrgIds": [
                  "PSA.39.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhano en mana tipo makadho kata ka owuotho koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "orikni gi tijene mapile kayiem;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "ochoko mwandu mathoth ka ok ongʼeyo ngʼama obiro weyonegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro, yaye Ruoth, en angʼo ma amanyo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:7"
      },
      "items": [
        {
          "text": "Genona aketo kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa kuom ketho maga duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:8"
      },
      "items": [
        {
          "text": "kik imi abedi ngʼama joma ofuwo jaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne alingʼ alingʼa, kendo ne ok anyal yawo dhoga mondo awuo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:9"
      },
      "items": [
        {
          "text": "nikech in ema isetimo ma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gol chwat ma isechwadago oko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:10"
      },
      "items": [
        {
          "text": "goch ma lweti goyago ohinga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwero ji kikumogi nikech richogi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "itieko mwandugi mana kaka thuth tieko oduma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "dhano ka dhano en mana muya nono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.11",
                "verseOrgIds": [
                  "PSA.39.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj lamona, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "chik iti ni lamona ma adwarogo kony;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "kik idin iti ne ywakna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "nikech adak kodi mana ka japiny moro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "an mana wendo kaka kwerena duto ne gin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ngʼiya, mondo achak abed moil kendo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:13"
      },
      "items": [
        {
          "text": "kapok adar aweyo pinyni mi alal e wangʼ ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
