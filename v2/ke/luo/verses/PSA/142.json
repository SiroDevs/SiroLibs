      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 142",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Daudi. Kane en ei bur. Lamo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 142:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aywak matek ne Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:1"
      },
      "items": [
        {
          "text": "atingʼo dwonda ne Jehova Nyasaye mondo okecha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 142:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahulone gik mathaga duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:2"
      },
      "items": [
        {
          "text": "anyise chandruokna duto ka abet e nyime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 142:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde ma chunya chandore e iya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "to in ema ingʼeyo yor konyruokna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "E bugo matut ma awuothoe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "ji osechikonae obadho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 142:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rang batha korachwich;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "mondo ine kaonge ngʼama dewa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "Aonge kar pondo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "bende aonge ngʼama rito ngimana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 142:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aywakni, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "awachoni niya, \"In e kar pondona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "kendo in e pokna e piny joma ngima.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 142:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yie iwinj ywakna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "nimar an-gi chandruok maduongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "resa e lwet joma lawa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "nimar gitek moloya mabor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 142:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonya e twech ma antie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "mondo apak nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "Eka joma kare biro chokore buta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "nikech ber misetimona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    }
  ],
