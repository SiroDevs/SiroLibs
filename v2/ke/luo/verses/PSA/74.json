      },
      "items": [
        {
          "text": "74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Asaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 74:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo isedagiwa nyaka chiengʼ, yaye Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "Angʼo momiyo mirimbi dhwolore ka iro kochomo rombe mag lek mari iwuon?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 74:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Par jogi mane ingʼiewo chon gi lala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "oganda ma gin girkeni mari, kendo mane iwaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "Got Sayun, kama in iwuon idakie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 74:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokri ichom kuonde mosebedo kokethore nyaka nene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "lokri ichom kethruok maduongʼ ma jasigu osekelo e kari maler mar lemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 74:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasiki noruto kama iromoe kodwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "kendo negichungo bendechegi mochungʼ kar timbegi maricho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 74:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negitimore marach mana ka ji mangʼawo leyegi malo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:5"
      },
      "items": [
        {
          "text": "ka gidwaro tongʼo yiende madongo dongo modongo modhigore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 74:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negituro chumbe modol odol",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "gi tindogi kod nyundogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 74:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne giwangʼo kari maler mar lemo molokore buru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "kendo ne gidwanyo kama nyingi dakie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 74:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwacho e chunygi niya, \"Wabiro tiekogi chuth!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "Ne giwangʼo kuonde duto e piny mane ilame Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 74:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinde ok wayud honni kata ranyisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "kendo onge jonabi modongʼ kata achiel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "to onge kata ngʼato achiel kuomwa mongʼeyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "ni mano biro bedo kamano nyaka karangʼo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 74:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka karangʼo ma jasigu biro jarie, yaye Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "Ibiro yiene jasigu mondo oyany nyingi nyaka chiengʼ koso?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 74:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo itamo lweti tiyo tichne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "mana lweti ma korachwich?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "Gole oko kama isoye ei lepi mondo itiekgi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 74:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Nyasaye in e Ruodha nyaka chakre chon, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "kendo isebedo kikelo resruok e piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 74:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema ne ipogo nam e diere ariyo gi tekoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:13"
      },
      "items": [
        {
          "text": "kendo ne itoyo wiye ondiek marach ei pi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 74:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema ne itoyo wiye Leviathan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:14"
      },
      "items": [
        {
          "text": "mi ichiwe kaka chiemo ne le modak e thim.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 74:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema ne iyawo sokni gi aore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:15"
      },
      "items": [
        {
          "text": "kendo ne imiyo aore madongo ma ok dwon otwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 74:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiechiengʼ en mari, kendo otieno bende mari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:16"
      },
      "items": [
        {
          "text": "bende ne iguro wangʼ chiengʼ gi dwe keregi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
