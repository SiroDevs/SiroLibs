    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Lamo mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, yie iwinj kwayona makare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "chik iti ne ywakna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "chik iti ne lemona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "lamona ok aa e dhok mawuondo ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad chwak michwakago oa kuomi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:2"
      },
      "items": [
        {
          "text": "mad wengeni nee gima kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni inono chunya kendo itema gotieno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "kata ka itema to ok ibi yudo gimoro kuoma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "asengʼado e chunya ni dhoga ok bi timo richo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kuom gik ma joma moko timo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "kaluwore gi wach mowuok e dhogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "an awuon asepogora",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "gi yore jo-mahundu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tienda osesiko e yoreni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:5"
      },
      "items": [
        {
          "text": "tiendena pok okier.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluongi, yaye Nyasaye, nikech ibiro dwoka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:6"
      },
      "items": [
        {
          "text": "chik iti kendo winj lamona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyisie teko mar herani maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "in ma ireso ji gi lweti ma korachwich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "joma pondo ne wasikgi kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rita adimba kaka tong wangʼi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:8"
      },
      "items": [
        {
          "text": "panda e bwo tipo mar bwombi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo atony e lwet joma richo ma lawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:9"
      },
      "items": [
        {
          "text": "mondo atony e lwet wasika ma dhano molwora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunjegi odinore matek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:10"
      },
      "items": [
        {
          "text": "kendo dhogi wuoyo gi wich teko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giselawa kuonde duto, mi koro gilwora,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:11"
      },
      "items": [
        {
          "text": "ka wengegi ochiek, mondo gidira piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichalo sibuor ma nigi kech mar mako le,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:12"
      },
      "items": [
        {
          "text": "mana ka sibuor maduongʼ mopondo kokichore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa malo, yaye Jehova Nyasaye, chomgi tir, mi igogi piny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "resa e lwet joma richo gi liganglani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, resa e lwet joma kamago gi lweti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "resa e lwet jopinyni ma pokgi ni e pinyni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 17:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "Itieko kech ma joma ihero nigo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "yawuotgi nigi chiemo mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "kendo gikano mwandu ne nyithindgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To anane wangʼi ka ngimana nikare;",
