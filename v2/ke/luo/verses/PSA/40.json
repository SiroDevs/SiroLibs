  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "PSA 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne arito Jehova Nyasaye ka ahora mos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:1"
      },
      "items": [
        {
          "text": "ne odwogo ira mi owinjo ywakna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oywaya oko e bur motimo otodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "ne ogola e chwodho gi thidhna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "Ne oketo tiendena e lwanda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "kendo nomiya kama otegno mondo achungie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oketo wer manyien e dhoga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "en wer mipakogo Nyasachwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "Ji mangʼeny biro neno mi gibed maluor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "kendo gibiro keto genogi kuom Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat moketo Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "kaka kar geno mare en ngʼat mogwedhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "ngʼat ma ok many kony kuom josunga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "bende ok omany kony kuom joma lokore mondo olam nyiseche mag miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ranyisi misetimo thoth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "yaye Jehova Nyasaye ma Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "Gigo mane ichanonwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "onge ngʼama nyalo kwanoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "ka dine bed ni wanyalo wuoyo kuomgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "to dine gibedo mangʼeny ma ok wanyal wacho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misengini kod chiwo ok ema ne idwaro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "to ita ema iseyawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "misengini miwangʼo pep kod chiwo mag golo richo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "ne ok idwaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nawacho niya, \"Eri an ka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "asebiro mana kaka ondiki kuoma e Muma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya dwaro timo dwaroni, yaye Nyasacha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:8"
      },
      "items": [
        {
          "text": "chikni ni ei chunya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alando tim makare e chokruok maduongʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "ok aumo dhoga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "mana kaka ingʼeyo, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok apando timni makare e chunya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "to awuoyo kuom adierani gi warruokni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "Ok apando herani gi adierani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "ni chokruok maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik itamri kecha, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:11"
      },
      "items": [
        {
          "text": "mad herani gi adierani osik ka rita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech chandruok mokalo akwana olwora;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "richona osejuka kendo ok anyal neno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "Gingʼeny moloyo yie wiya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.13"
            ]
