  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "PSA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. E dwol mar \"Kik iketh gik moko.\"",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Miktam",
              "type": "text"
            }
          ]
        },
        {
          "text": "mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un jotelo, bende uwuoyo gi adiera?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "Bende ungʼado bura moriere tir e dier ji?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ooyo, uchano mayo ji ratiro magi e chunyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:2"
      },
      "items": [
        {
          "text": "kendo lwetu chano kelo dhawo e piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma timbegi richo chako lal ae nywolgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:3"
      },
      "items": [
        {
          "text": "gin jo-jendeke kendo gin jo-miriambo aa nywolgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwiri margi chalo gi kwich thuol,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:4"
      },
      "items": [
        {
          "text": "chalo gi kwich thuond rachier ma tege oyienyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma kata ja-bochne wuone to ok owinji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:5"
      },
      "items": [
        {
          "text": "kata bed ni ja-bochneno olony machal nadi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muk lekegi ei dhogi, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:6"
      },
      "items": [
        {
          "text": "yiech kwiri mag sibuoche oko, yaye Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi gilal nono ka pi mamol;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:7"
      },
      "items": [
        {
          "text": "ka giywayo atungegi to mi asernigi obed madik.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ndach kamnie maleny nono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:8"
      },
      "items": [
        {
          "text": "kendo mana kaka nyathi monywol kosetho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:8"
      },
      "items": [
        {
          "text": "mad kik gine wangʼ chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapok agulni magi ochako winjo liet mach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:9"
      },
      "items": [
        {
          "text": "bed ni en mach mabebni kata maliel mos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:9"
      },
      "items": [
        {
          "text": "to joma timbegi richo ibiro ywe oko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 58:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma kare biro bedo mamor kichulonigi kuor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:10"
      },
      "items": [
        {
          "text": "ka giniluok tiendegi e remb joma timbegi richo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 58:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ji nowach niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "\"Kara en adier ni joma kare pod yudo pok;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "kara nitie Nyasaye mangʼado bura ne piny.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.59",
