  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "PSA 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama paro joma ok nyal en jahawi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:1"
      },
      "items": [
        {
          "text": "Jehova Nyasaye rese ka chandruok omake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro rite kendo biro miyo obed mangima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "Jehova Nyasaye biro gwedhe e piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "kendo ok obi jwangʼe e lwet wasike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro rite e kitandane mar tuo midekre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:3"
      },
      "items": [
        {
          "text": "kendo obiro miyo oa malo e kitandane ka ohewore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne awacho niya, \"Yaye Jehova Nyasaye, kecha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:4"
      },
      "items": [
        {
          "text": "changa, nikech aseketho e nyimi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasika wuoyo kuoma ka chunygi rach koda, kagiwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:5"
      },
      "items": [
        {
          "text": "\"Obiro tho karangʼo mondo nyinge olal chuth?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa asaya ma ngʼato obiro nena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "to owuondore ni owuoyo kuoma maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "to ei chunye to ofwambo weche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "mondo okethgo nyinga eka oa odhi kendo okeyo wechego ne ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasika duto kuodho wach kuoma kaachiel kaka ginyalo hinya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:7"
      },
      "items": [
        {
          "text": "chunygi paro gik maricho mogik mondo ohinya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:7"
      },
      "items": [
        {
          "text": "kagiwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tuo marach osekete piny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:8"
      },
      "items": [
        {
          "text": "ok obi aa malo kama oninde.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koda ka osiepna mane ageno kuome,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "ngʼat mane chiemo koda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "bende osendhoga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "To in, yaye Jehova Nyasaye, yie ikecha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:10"
      },
      "items": [
        {
          "text": "chunga malo, mondo achulgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼeyo ni chunyi mor koda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:11"
      },
      "items": [
        {
          "text": "nimar jowasika ok loya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itingʼa malo nikech timna makare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:12"
      },
      "items": [
        {
          "text": "kendo ichunga e nyimi nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak ne Jehova Nyasaye, ma Nyasach Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:13"
      },
      "items": [
        {
          "text": "nyaka chiengʼ kendo nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "PSA 41:13"
      },
      "items": [
        {
          "text": "Amin kendo Amin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
      ]
    }
  ],
