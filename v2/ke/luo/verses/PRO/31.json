      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:22"
      },
      "items": [
        {
          "text": "orwakore gi lewni marep-rep maralik ma nengogi tek.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.22",
            "verseOrgIds": [
              "PRO.31.22"
            ]
          }
        }
      ]
