          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka piny ngʼich, oonge luoro ne joode,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
              "PRO.31.21"
            ]
          }
        }
      ]
