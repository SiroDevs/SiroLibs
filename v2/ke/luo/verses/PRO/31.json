      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:20"
      },
      "items": [
        {
          "text": "kendo otero lwete ne jogo mochando.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        }
      ]
