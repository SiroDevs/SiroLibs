          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyawo bade ne joma jochan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        }
      ]
    },
