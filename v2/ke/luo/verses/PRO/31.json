          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei lwete otingʼo yie rombe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:19"
      },
      "items": [
        {
          "text": "kendo omako gir chwecho gi lith lwetene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.19",
            "verseOrgIds": [
              "PRO.31.19"
            ]
          }
        }
      ]
    },
    {
