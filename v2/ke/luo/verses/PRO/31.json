      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:23"
      },
      "items": [
        {
          "text": "kama obedoe e dier jodongo mag gwengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.23",
            "verseOrgIds": [
              "PRO.31.23"
            ]
          }
