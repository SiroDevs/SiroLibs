  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "PRO 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuowi mariek winjo puonj wuon mare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:1"
      },
      "items": [
        {
          "text": "to ngʼat ma wangʼe tek ok winj wach kikwere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat makare yudo pok maber kaluwore gi gik mowacho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:2"
      },
      "items": [
        {
          "text": "to ngʼatno ma ok ja-adiera nigi gombo mar miero.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno morito dhoge orito ngimane,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:3"
      },
      "items": [
        {
          "text": "to ngʼatno ma wuoyo karodho wach biro dhiyo e kethruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo dwaro gimoro gi chunye duto to ok oyud gimoro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:4"
      },
      "items": [
        {
          "text": "to jakinda yudo gik moko duto modwaro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat makare mon kod gima ok adiera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:5"
      },
      "items": [
        {
          "text": "to joricho kelo wichkuot kod dwanyruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tim makare rito ngʼat mobidhore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:6"
      },
      "items": [
        {
          "text": "timbe maricho to tieko jaricho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat moro wuondore ni en ja-mwandu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:7"
      },
      "items": [
        {
          "text": "to adiera oonge gimoro;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 13:7"
      },
      "items": [
        {
          "text": "to ngʼat machielo wuondore ni en jachan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:7"
      },
      "items": [
        {
          "text": "to adiera en gi mwandu mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwandu ngʼato sa moro nyalo reso ngimane,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:8"
      },
      "items": [
        {
          "text": "to jochan onge gima bwogo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ler mar ngʼat makare rieny maler,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:9"
      },
      "items": [
        {
          "text": "to taya mar ngʼat marach inego.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sunga nywolo mana dhawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:10"
      },
      "items": [
        {
          "text": "to rieko iyudo kuom jogo moyie puonj.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pesa moyud e yo ma ok kare lal nono,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:11"
      },
      "items": [
        {
          "text": "to ngʼat makano pesa matin matin miyo omedore.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima igeno mobudho miyo chuny bedo matuo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:12"
      },
      "items": [
        {
          "text": "to gima igeno motimore en yath mar ngima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat ma jaro puonj biro yudo pokne,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:13"
      },
      "items": [
        {
          "text": "to ngʼat moluoro chik imiyo pok maber.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonj mar ngʼat mariek en soko mar ngima",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:14"
      },
      "items": [
        {
          "text": "ma reso ngʼato e obadho mag tho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bedo gi winjo kelo luor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:15"
      },
      "items": [
        {
          "text": "to yor ngʼato ma ok ja-adier tek.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato mariek timo gik moko kuom ngʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:16"
      },
      "items": [
        {
          "text": "to ngʼat mofuwo nyiso mana fupe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 13:17"
          },
          "items": [
            {
