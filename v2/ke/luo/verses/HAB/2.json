      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Kata ni kite maonge ngima ni, 'Chiew!'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
