      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Koro en kindeni mar mer! Methi kendo dongʼ duk!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
