      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "kendo wichkuot biro umo duongʼ ma in-go.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
