      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "ka omedogi ameda nyaka gimer,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
