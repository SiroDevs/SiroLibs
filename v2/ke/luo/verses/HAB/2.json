      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "Nimar isechwero remb dhano,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
