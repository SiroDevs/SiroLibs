      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "nimar dhano ema opayogi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
