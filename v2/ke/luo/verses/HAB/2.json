      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:14"
      },
      "items": [
        {
          "text": "kaka pi kwako nam.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
