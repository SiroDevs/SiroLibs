      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "kuom gima oloso owuon;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
