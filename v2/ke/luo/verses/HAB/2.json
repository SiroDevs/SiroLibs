      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Kata obedo ni obawgi gi dhahabu gi fedha;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
