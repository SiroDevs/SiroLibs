      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "kendo gi ji duto manie igi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
