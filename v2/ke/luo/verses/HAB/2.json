          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"En ohala manade miyudo kuom nyiseche manono",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
