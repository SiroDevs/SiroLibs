      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Okombe moa e lwet Jehova Nyasaye ma korachwich bironi,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
