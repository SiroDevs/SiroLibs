      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "iseketho pinje gi mier madongo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
