          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge Jehova Nyasaye Maratego osechiko",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "ni tije ogendini maricho biro bedo ramok mach,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "ogendini tiyo ma ol kayiem nono?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
