{
  "id": "LUK.17",
  "number": "17",
  "bookId": "LUK",
  "reference": "Luka 17",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LUK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Richo, yie, tich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nowachone jopuonjrene niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gik mamiyo ji donjo e richo ochunore ni nyaka bedie, to okwongʼ ngʼatno makelo gigo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.1",
                "verseOrgIds": [
                  "LUK.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dine obedo maber ka otwene pongʼ e ngʼute, mi onyumego e nam moloyo komiyo achiel kuom jomatindogi timo richo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.2",
                "verseOrgIds": [
                  "LUK.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omiyo ritreuru uwegi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka owadu otimo richo, kwere, to ka olokore oweyo richo, to wene.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka otimoni richo nyadibiriyo odiechiengʼ achiel to obiro iri nyadibiriyo kendo owacho ni, 'Alokora aweyo richo,' to nyaka iwene.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.4",
                "verseOrgIds": [
                  "LUK.17.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joote nowachone Ruoth niya, \"Med yiewa!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka un gi yie matin marom gi koth karadali, to unyalo wacho ne yadh ngʼowuni ni, 'Pudhri ia mondo ipithri e nam,' to dine owinjou motimo kamano.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.6",
                "verseOrgIds": [
                  "LUK.17.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka dibed ni nitie achiel kuomu man-gi jatich mapurone kata makwayo rombe. Dowachne jatichne koa e puodho ni, 'Bi koroni kendo ibed piny mondo ichiem'?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.7",
                "verseOrgIds": [
                  "LUK.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Donge dowachne mana ni, 'Losna chiemba mar otieno, ikri mondo imiya acham kendo metho, eka bangʼe inyalo chiemo kendo metho'?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.8",
                "verseOrgIds": [
                  "LUK.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bende onyalo goyone jatichneno erokamano nikech notimo gima nowachone notim?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.9",
                "verseOrgIds": [
                  "LUK.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omiyo un bende, ka usetimo gik moko duto mane onyisu mondo utim, onego uwach ni, 'Wan mana jotich aticha ma ok owinjore to wasetimo mana tijwa.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.10",
                "verseOrgIds": [
                  "LUK.17.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jodhoho apar ochangi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro e yo kane odhiyo Jerusalem, Yesu nowuotho e kind Samaria gi Galili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka noyudo odonjo e dala moro, ji apar man-gi dhoho noromo kode. Negichungo mabor",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo negiluongo gi dwol maduongʼ niya, \"Yesu, Ruoth! Kechwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka nonenogi, nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dhiuru, unyisru uwegi ni jodolo.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.14",
                "verseOrgIds": [
                  "LUK.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "To kane gidhi, negipwodhore.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiel kuomgi, kane oneno ni osechange, nodok ir Yesu, kopako Nyasaye gi dwol maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nopodho auma e tiend Yesu kendo nogoyone erokamano, to ngʼatno ne en ja-Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nopenjo niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Donge ji apar duto nopwodhi? Ere ji ochiko mamoko?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.17",
                "verseOrgIds": [
                  "LUK.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onge ngʼato madineyudre kuomgi monego duogi mondo omi Nyasaye pak, mana japiny moro nononi kende ema odwogo?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.18",
                "verseOrgIds": [
                  "LUK.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chungi kendo idhi, yieni osemiyo ibedo mangima.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.19",
                "verseOrgIds": [
                  "LUK.17.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Biro mar Pinyruoth Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ moro, kane openje gi jo-Farisai kinde ma pinyruodh Nyasaye nobiye, Yesu nodwokogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pinyruoth Nyasaye ok bi mana mineno gi wangʼ,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.20",
                "verseOrgIds": [
                  "LUK.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kata ji ok nowach ni, 'Eri go,' kata ni, 'Ee cha go cha,' nikech pinyruodh Nyasaye ni eiu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.21",
                "verseOrgIds": [
                  "LUK.17.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowachone jopuonjre niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndalo biro ma unugomb nenoe chiengʼ achiel kuom ndalo mag Wuod Dhano, to ok ununene.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.22",
                "verseOrgIds": [
                  "LUK.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji biro wachonu ni, 'En kucha!' Kata ni, 'En ka!' Kik uring udhi bangʼ-gi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.23",
                "verseOrgIds": [
                  "LUK.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar biro mar Wuod Dhano nobed machalo ka mil polo ma piatore e kor polo koa konchiel nyaka komachielo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.24",
                "verseOrgIds": [
                  "LUK.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
              "LUK.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To mokwongo nyaka one masiche mangʼeny, kendo tiengʼni nodage.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.25",
                "verseOrgIds": [
                  "LUK.17.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mana kaka notimore e ndalo mag Nowa, e kaka biro bedo bende e ndalo mag Wuod Dhano.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.26",
                "verseOrgIds": [
                  "LUK.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji ne chiemo kendo metho, chwo ne kendo bende nyiri ne ikendo nyaka nochopo odiechiengʼ mane Nowa odonjo e yie. Eka pi mar ataro nobiro motieko ji duto.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.27",
                "verseOrgIds": [
                  "LUK.17.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kamano e kaka ne chalre e ndalo mag Lut, ji ne chiemo, kendo metho, negingʼiewo kendo negiloko ohala, bende negipitho kendo gedo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.28",
                "verseOrgIds": [
                  "LUK.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To chiengʼ mane Lut oa Sodom, mach kod kite maliel mager nolwar koa e polo kendo notiekogi duto.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.29",
                "verseOrgIds": [
                  "LUK.17.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kamano e kaka nobedi e ndalo ma Wuod Dhano nofwenyre.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.30",
                "verseOrgIds": [
                  "LUK.17.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Odiechiengʼno onge ngʼato manobedie ewi tat ot, man-gi gige ei ot, manolor mondo ogolgi. Machalre gi mano, onge ngʼato manie puodho manodog dala ne gimoro amora.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.31",
                "verseOrgIds": [
                  "LUK.17.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Paruru chi Lut!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.32",
                "verseOrgIds": [
                  "LUK.17.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼatno matemo reso ngimane, ngimane biro lalne, to ngʼatno mowito ngimane, nores ngimane.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.33",
                "verseOrgIds": [
                  "LUK.17.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awachonu ni, otienono ji ariyo nobed e kitanda achiel: achiel nokaw to machielo nowe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.34",
                "verseOrgIds": [
                  "LUK.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mon ariyo noyudi karego cham kaachiel, achiel nokaw, to machielo nowe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.35",
                "verseOrgIds": [
                  "LUK.17.35"
                ]
              }
            }
          ]
        },
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chwo ariyo nobed e puodho, achiel ibiro kawo, to machielo nowe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.36",
                "verseOrgIds": [
                  "LUK.17.36"
                ]
              }
            }
          ]
        },
        {
          "text": "]",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.36",
                "verseOrgIds": [
                  "LUK.17.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negipenje niya, \"Mano notimre kanye, Ruoth?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:37"
      },
      "items": [
        {
          "text": "Nodwokogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kama ringruok motho nitie, ema achudhe chokore.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.37",
                "verseOrgIds": [
                  "LUK.17.37"
                ]
              }
            }
          ]
        }
      ]
    }
