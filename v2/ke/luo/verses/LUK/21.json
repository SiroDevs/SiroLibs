  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "LUK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiwo mar dhako ma chwore otho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ongʼiyo malo, Yesu noneno ka jo-mwandu keto chiwogi e kar chiwo mar hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneno bende dhako moro modhier ma chwore notho ka keto pesa mamingli ariyo matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu adier, dhako ma chwore otho modhierni osegolo chiwo moloyo joma moko duto.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.3",
                "verseOrgIds": [
                  "LUK.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Joma mokogi duto nogolo mana matin nono kuom mwandu ma gin-go, to dhakoni kata obedo ni nodhier to ne ochiwo duto mane onego okonyrego.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.4",
                "verseOrgIds": [
                  "LUK.21.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ranyisi mag giko mar ndalo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopuonjrene moko ne wuoyo kuom hekalu kawuoro kaka olose gi kite mabeyo kod mich mochiw ni Nyasaye. To Yesu nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To kuom mano ma uneno kani, ndalo biro biro maonge kidi kata achiel mabiro dongʼ kochungʼ ewi wadgi, moro ka moro biro redhore piny.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.6",
                "verseOrgIds": [
                  "LUK.21.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negipenje niya, \"Japuonj, gigi biro timore karangʼo? To angʼo mabiro bedo ranyisi ni gichiegni timore?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru motangʼ mondo kik wuondu. Nimar ji mangʼeny nobi e nyinga ka hedhore ni, 'An e en,' kendo ni, 'Sa chiegni,' kik uluwgi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.8",
                "verseOrgIds": [
                  "LUK.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka uwinjo ka pinje gore kod koko mangʼeny, to kik ubed maluor. Gigi nyaka timre mokwongo, to ok onyiso ni giko chiegni.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.9",
                "verseOrgIds": [
                  "LUK.21.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Oganda noked gi oganda machielo, kendo pinyruoth noked gi pinyruoth machielo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.10",
                "verseOrgIds": [
                  "LUK.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Piny noyiengni malich, kech kod tuoche nobedie kuonde mopogore opogore, kendo gik malich mabwogo ji gi honni madongo notimre koa e polo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.11",
                "verseOrgIds": [
                  "LUK.21.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To kapok magi duto otimore, to gibiro makou kendo sandou. Giniteru e sinagoke kod ute mag twech, kendo nokelu e nyim ruodhi gi jotelo, to mago duto notim nikech nyinga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.12",
                "verseOrgIds": [
                  "LUK.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mano biro miyou thuolo mondo ubednegi joneno.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.13",
                "verseOrgIds": [
                  "LUK.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To beduru gi paro ma ok yiengni mondo kik uparru motelo ni ere kaka ubiro dwoko wach.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.14",
                "verseOrgIds": [
                  "LUK.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar abiro miyou weche gi rieko maonge wasiku kata achiel ma biro tamore kata kwero wachuno.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.15",
                "verseOrgIds": [
                  "LUK.21.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ibiro ndhogu kata mana gi jonywolu kod oweteu, wedeu gi osiepeu, kendo gibiro nego jomoko kuomu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.16",
                "verseOrgIds": [
                  "LUK.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji duto biro sin kodu nikech an.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.17",
                "verseOrgIds": [
                  "LUK.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kata mana yie wiu achiel onge manolal.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.18",
                "verseOrgIds": [
                  "LUK.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka uchungo motegno to ubiro reso ngimau.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.19",
                "verseOrgIds": [
                  "LUK.21.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka uneno Jerusalem olwor kod ogend lweny, ubiro ngʼeyo ni kindene mar kethruok chiegni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.20",
                "verseOrgIds": [
                  "LUK.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koro eka joma ni Judea oring odhi ewi gode, kendo joma ni e dala maduongʼ nyaka wuog oko, to jogo man oko ei piny kik donjie dala maduongʼ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.21",
                "verseOrgIds": [
                  "LUK.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar ma e kinde ma kum bedoe mondo ochop kare gigo duto mane ondiki.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.22",
                "verseOrgIds": [
                  "LUK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mano kaka nodok malit ne mon ma yach kod mago madhodho nyithindo e ndalogo! Chandruok malit maduongʼ biro bedo e piny gi mirima kuom jogi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.23",
                "verseOrgIds": [
                  "LUK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ibiro negogi gi ligangla kendo notergi kaka joma otwe e pinje duto. Jerusalem ibiro nyono piny gi joma ok jo-Yahudi nyaka chop kinde ma loch mar joma ok jo-Yahudi rume.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.24",
                "verseOrgIds": [
                  "LUK.21.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ranyisi biro bedo e wangʼ chiengʼ gi dwe kod sulwe. E piny, to ogendini nobed kodhier kendo kongʼengʼ, nikech nam mawuo kendo apaka magore.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.25",
                "verseOrgIds": [
                  "LUK.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji biro podho nikech gik malich matimore, ka luoro omakogi nikech gima biro timore e piny, nimar chwech mag polo noyiengni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.26",
                "verseOrgIds": [
                  "LUK.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To gie kindeno gibiro neno Wuod Dhano kabiro koa e bor polo gi teko kod duongʼ malich.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.27",
                "verseOrgIds": [
                  "LUK.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka gigi chako timore, chunguru kendo tingʼuru wiwu malo, nikech ndalou mag warruok chiegni.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.28",
                "verseOrgIds": [
                  "LUK.21.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogoyonegi ngero kama:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Neuru yadh ngʼowu kod yien duto.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.29",
                "verseOrgIds": [
                  "LUK.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka gichako loth, unyalo neno uwegi kendo ungʼeyo ni ndalo oro chiegni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.30",
                "verseOrgIds": [
                  "LUK.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kata kamano, ka uneno ka gigi timore to ngʼeuru ni pinyruoth Nyasaye ni machiegni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.31",
                "verseOrgIds": [
                  "LUK.21.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu adier ni, tiengʼni ok norum ngangʼ kapok gigi duto otimore.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.32",
                "verseOrgIds": [
                  "LUK.21.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Polo gi piny norum to wechena ok norum ngangʼ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.33",
                "verseOrgIds": [
                  "LUK.21.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru motangʼ, nono chunyu biro bedo monyosore gi pek, mer kod parruok mar ngima to ndalono nochopnu apoya kaka obadho.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.34",
                "verseOrgIds": [
                  "LUK.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar obiro biro ne ji duto modak e wangʼ piny mangima.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.35",
                "verseOrgIds": [
                  "LUK.21.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Beduru kurito kinde duto, kendo lemuru mondo utony ne gigo duto mabiro timore, kendo mondo uchungʼ e nyim Wuod Dhano.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.36",
                "verseOrgIds": [
                  "LUK.21.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiechiengʼ ka odiechiengʼ Yesu ne puonjo e hekalu, kendo odhiambo kodhiambo nodhi monindo e Got miluongo ni Zeituni gotieno.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ji duto nobiro e hekalu chon gokinyi mondo giwinje.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
    }
  ],
