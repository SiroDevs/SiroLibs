  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ZEP 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e wach mar Jehova Nyasaye mane obiro ne Zefania wuod Kushi, ma wuod Gedalia, ma wuod Amaria, ma wuod Hezekia e kinde loch Josia wuod Amon ruodh Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siem kuom kum mabiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abiro tieko gik moko duto",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:2"
      },
      "items": [
        {
          "text": "mantie e piny mi lal nono,\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:2"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abiro tieko dhano kaachiel gi le,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "bende abiro tieko winy mafuyo e kor polo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "kaachiel gi rech manie nam.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "Jomaricho biro pie pidhe pidhe,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "e ndalo manatiek dhano e wangʼ piny,\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum mar jo-Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abiro kumo jo-Juda",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "kaachiel gi ji duto modak Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "Abiro tieko jo-Baal duto mane odongʼ ka,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "mi agol oko nying joma luwo nyiseche mopa kaachiel gi jodologi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende abiro tieko ji duto makulore ewi tat udi",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "kalamo chiengʼ, dwe gi sulwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "Ji duto makulore ka kwongʼore gi nying Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "to bangʼe gikwongʼore gi nying Molek nyasach jo-Amon.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji duto moseweyo luwo Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:6"
      },
      "items": [
        {
          "text": "kendo ok gimany Jehova Nyasaye kata mana penje wach.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingʼuru e nyim Jehova Nyasaye Manyalo Gik Moko Duto;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "nikech odiechiengʼ mar Jehova Nyasaye chiegni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "Jehova Nyasaye oseloso misango,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "kendo osepwodho joma oseluongo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"E odiechiengʼ mitimoe misango mar Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "abiro kumo joka ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "yawuot ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "kaachiel gi ji duto morwakore",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "gi lewni mag jopinje mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼno,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "anakum ji duto mamiel e laru mar dino cham,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "kendo mapongʼo hekalu mar nyiseche manono",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "gi timbe mahundu kod wuond.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya, \"Chiengʼno,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "ywak noywagre koa e rangach miluongo ni Dhoranga Rech,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "nduru noa e bath dala koma nyien,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "kendo koko nogore matek koa e gode.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gouru nduru un joma odak e mier moluoro chiro,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "johala mau madongo duto ibiro yweyo oko,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "kendo ji duto maloko ohand pesa notiek pep.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
