          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negigoyo ombulu, kendo ombulu nolwar kuom Mathias. Omiyo nomede kuom joote apar gachiel mamoko.",
          "type": "text",
          "attrs": {
