              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo notieko kawachonegi niya, \"Emomiyo adwaro ni ungʼe ni warruok mar Nyasaye osechopo ni joma ok jo-Yahudi, kendo gibiro rwake!\" [",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        },
        {
