          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ wacho mano, jo-Yahudi mane winje nowuok odhi, ka gigoyo mbaka matek e kindgi giwegi.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        }
