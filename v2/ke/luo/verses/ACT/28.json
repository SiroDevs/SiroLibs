              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom higni ariyo, Paulo nodak e ode owuon mochulo, kendo norwako ji duto mane obiro ire mondo onene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
