  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1KI 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sandug Muma okel e hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Ruoth Solomon noluongo jodong jo-Israel mondo odhi ire Jerusalem gi jodong dhoudi duto gi jotend anywola mag Israel mondo gikel Sandug Muma mar singruok mar Jehova Nyasaye koa Dala Maduongʼ mar Daudi miluongo ni Sayun.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.1",
            "verseOrgIds": [
              "1KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel duto nochokore kanyakla ir Ruoth Solomon e kinde mag nyasi e dwe mar Ethanim, ma en dwe mar abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jodong Israel duto osechopo, jodolo nokawo Sandug Muma,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.3",
            "verseOrgIds": [
              "1KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo negikelo Sandug Muma mar Jehova Nyasaye gi Hemb Romo kod gik moko duto maler mane ni e iye. Jodolo kod jo-Lawi notingʼogi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.4",
            "verseOrgIds": [
              "1KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo Ruoth Solomon kod oganda jo-Israel duto mane ochokore molwore nochopo e nyim Sandug Muma; kendo negichiwo rombe kod dhok mangʼeny mane kwan-gi ok nyal ndiki kata kwan kaka misango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jodolo nokelo Sandug Muma mar singruok mar Jehova Nyasaye kama ne olosne ei kama ler mar lemo mar hekalu ma en Kama Ler Moloyo mi gikete e bwomb kerubi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.6",
            "verseOrgIds": [
              "1KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubigo noyaro bwombegi ewi kama noketie Sandug Muma kendo ne giumo Sandug Muma gi ludhe mitingʼego.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.7",
            "verseOrgIds": [
              "1KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ludhegi ne boyo ahinya ma gikogi ne inyalo ne koa e nyim Kama Ler e nyim kama ler mar lemo, to ne ok ginen gi oko mar Kama Ler kendo pod gin kanyo nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.8",
            "verseOrgIds": [
              "1KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne onge gimoro ei Sandug Muma makmana kite ariyo mopa mane Musa oketo e iye kane en Horeb kama Jehova Nyasaye ne otimoe singruok kod jo-Israel kane gisewuok Misri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jodolo osewuok ei Kama Ler, bor polo noimo hekalu mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.10",
            "verseOrgIds": [
              "1KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo jodolo ne ok nyal tiyo tijegi nikech bor polo nimar duongʼ mar Jehova Nyasaye nopongʼo hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Solomon nowacho niya, \"Jehova Nyasaye osewacho ni enodag ei bor polo motimo mudho;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.12",
            "verseOrgIds": [
              "1KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "adier asegeroni hekalu marahuma kama inidagie nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.13",
            "verseOrgIds": [
              "1KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oganda jo-Israel duto ochungʼ kanyo, ruoth nolokore mogwedhogi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.14",
            "verseOrgIds": [
              "1KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 8:15"
      },
      "items": [
        {
          "text": "\"Pak obed ne Jehova Nyasaye, ma Nyasach Israel, mosetimo gi lwete gima ne osingo gi dhoge owuon ni Daudi wuonwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar nowacho ni, 'Chakre ndalo mane agolo joga koa Misri, pok ayiero dala maduongʼ e dhoot moro amora mar Israel mondo oger hekalu kanyo ni Nyinga, to aseyiero Daudi mondo otel ni joga Israel.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.16",
            "verseOrgIds": [
              "1KI.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daudi wuora noketo e chunye mondo oger hekalu moluongo nying Jehova Nyasaye, ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.17",
            "verseOrgIds": [
              "1KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye nowacho ni Daudi wuora ni, 'Nitimo maber mondo ibed gi wach gero hekalu ni nyinga e chunyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.18",
            "verseOrgIds": [
              "1KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, in ok niger hekalu, to wuodi, ma en ringri gi rembi iwuon, en ema noger hekalu ni Nyinga.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.19",
            "verseOrgIds": [
              "1KI.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehova Nyasaye oserito singruok mane otimo: Asekawo loch wuora Daudi kendo asebet e kom loch mar Israel, mana kaka Jehova Nyasaye nosingo, kendo asegero hekalu ni Nying Jehova Nyasaye, ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.20",
            "verseOrgIds": [
              "1KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseloso kar Sandug Muma, moketie singruok mane Jehova Nyasaye otimo kod kwerewa kane ogologi Misri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.21",
            "verseOrgIds": [
              "1KI.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lemo mar Solomon mar gwedho hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Solomon nochungʼ e nyim kendo mar misango mar Jehova Nyasaye e nyim oganda duto mar jo-Israel, kendo norieyo bedene kochomo polo",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.22",
            "verseOrgIds": [
              "1KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kowacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.23",
            "verseOrgIds": [
              "1KI.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 8:23"
      },
      "items": [
        {
          "text": "\"Yaye Jehova Nyasaye, ma Nyasach Israel, onge Nyasaye moro amora machal kodi e polo malo kata e piny mwalo, in e Nyasaye marito singruok mar herane ni jotichne maluwo yoreni gi chunygi duto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.23",
            "verseOrgIds": [
              "1KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iserito singruokni mane itimo gi jatichni Daudi wuora ne isingori gi dhogi kendo isechopo singruokno gi lweti mana kaka en kawuononi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.24",
            "verseOrgIds": [
              "1KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro Jehova Nyasaye, ma Nyasach Israel rit singruok mane itimo gi jatichni Daudi wuora kiwachone niya, 'Ok inibed maonge gi ngʼato mobedo e kom loch e nyima e piny Israel, to mana ka yawuoti otimo tim makare e nyima mana kaka isetimo.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.25",
            "verseOrgIds": [
              "1KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro, yaye Nyasach Israel, yie wach mane isingo ni jatichni Daudi wuora otimre mana kaka ne isingo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.26",
            "verseOrgIds": [
              "1KI.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To bende Nyasaye nyalo dak e piny? Kata polo malo kata polo mabor moloyo ok nyal romi. To koro hekalu mageroni, to diromi nade!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.27",
            "verseOrgIds": [
              "1KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano chik iti ni lamo jatichni gi kwayone mar ngʼwono, yaye Jehova Nyasaye Nyasacha. Winji ywak gi lemo ma jatichni lamo e nyimi kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.28",
            "verseOrgIds": [
              "1KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad wangʼi rang hekaluni otieno kod odiechiengʼ, kama niwacho niya, 'Nyinga nobed kanyo,' mondo iwinji lemo ma jatichni lamo kochomo odni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.29",
            "verseOrgIds": [
              "1KI.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winji lamo mar jatichni kaachiel gi jogi Israel ka gilamo ka gichomo odni. Winji gi e polo kar dakni, kendo kiwinjo, to iwenwa richowa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.30",
            "verseOrgIds": [
              "1KI.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka ngʼato oketho ni wadgi kendo dwarore ni mondo okwongʼre kendo obiro mokwongʼore e nyim kendo mar misango manie hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.31",
            "verseOrgIds": [
              "1KI.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "to iwinji gi e polo kendo itim kaka owinjore. Ngʼad bura e kind jotichni, kikumo joketho kendo iket richogi e wigi bende joma onge ketho iket kare kaluwore gi timgi makare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.32",
            "verseOrgIds": [
              "1KI.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka jogi Israel olo e lweny gi jowasikgi nikech gisekethoni, to bangʼe gilokore mi gipako nyingi, ka gilamo kendo gikwayo e hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.33",
            "verseOrgIds": [
              "1KI.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "to iwinjgi gi e polo kendo iwe richo jogi Israel kendo iduog-gi e piny mane imiyo kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.34",
            "verseOrgIds": [
              "1KI.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka polo olor kendo koth onge nikech jogi osekethoni to ka gilemo kaeni ka gipako nyingi kendo ka gilokore giweyo richogi nikech isekelonegi chandruok,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.35",
            "verseOrgIds": [
              "1KI.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie mondo iwinjgi gie polo kendo iwene jotichni ma jo-Israel richogi. Puonjgi yo makare mar dak kendo iornegi koth e piny mane imiyo jogi kaka girkeni margi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.36",
            "verseOrgIds": [
              "1KI.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka kech kata dera omako piny, kata ka abach omako cham ewi dongo kata ka bonyo kata kungu kata ka jowasigu olworo miechgi madongo kata ka midekre kata tuo omakogi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.37",
            "verseOrgIds": [
              "1KI.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka ngʼato kuom jogi ma jo-Israel olemo kata okwayi, ka gingʼeyo gima chando chunygi kendo ka girieyo bedegi kochomo hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.38",
            "verseOrgIds": [
              "1KI.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie iwinji gie polo, kama idakie. Wenegi richogi kendo tim ne ngʼato ka ngʼato gima owinjore gi gik motimo nikech ingʼeyo chunygi (nikech in kendi ema ingʼeyo chuny dhano),",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.39",
            "verseOrgIds": [
              "1KI.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo omi gilwori ndalogi duto ma gin-go e piny mane imiyo kwerewa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.40",
            "verseOrgIds": [
              "1KI.8.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To kuom jadak ma ok achiel kuom jogi Israel moa e piny mabor nikech nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.41",
            "verseOrgIds": [
              "1KI.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar ji biro winjo humb nyingi maduongʼ gi mar lweti maratego kod badi marabora moriere, ka gibiro ma gilemo ka gichomo hekaluni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.42",
            "verseOrgIds": [
              "1KI.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie mondo iwinji gie polo kama idakie kendo tim gimoro amora ma jadakno okwayi, mondo ogendini duto mag piny ongʼe nyingi kendo oluori mana kaka jogi Israel, kendo mondo gingʼe ni ot ma asegeroni luongo nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.43",
            "verseOrgIds": [
              "1KI.8.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka jogi odhi kedo gi jowasikgi, kamoro amora ma ibiro orogie, ka gilamo Jehova Nyasaye ka gichomo dalani miseyiero kendo hekalu masegero maluongo nyingi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.44",
            "verseOrgIds": [
              "1KI.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie iwinji gie polo lamogi kod kwayogi kendo konygi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.45",
            "verseOrgIds": [
              "1KI.8.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To ka giketho e nyimi, nimar onge ngʼato kata achiel ma ok jaketho mi ikecho kodgi, kendo ichiwogi e lwet wasikgi mondo otergi e twech e piny wasikgigo, kuma bor kata machiegni;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.46",
            "verseOrgIds": [
              "1KI.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "to eka bangʼe giloko pachgi e piny motwegieno mi chunygi olokore giweyo richo, kendo gikwayi ka gin e piny wasikgi niya, 'Wasetimo richo kendo waseketho bende wasetimo tim mamono.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.47",
            "verseOrgIds": [
              "1KI.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo ka gidwogo iri gi chunygi duto kod ngimagi duto, e piny wasikgi mane otweyogieno, kendo gilami ka gichomo pinygi mane imiyo kweregi, kod dala mane iyiero, gi hekalu ma asegero ni nyingi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.48",
            "verseOrgIds": [
              "1KI.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie mondo iwinj lemogi gi kwayogi gie polo kama idakie kendo ikonygi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.49",
            "verseOrgIds": [
              "1KI.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yie iwe ni jogi mosetimo richo e nyimi, wenegi kethogi duto magisetimo e nyimi kendo mi joma ne omakogi okechgi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.50",
            "verseOrgIds": [
              "1KI.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar gin jogi kendo mwanduni mane igolo e piny Misri, kigologi kama mae kakni ka kama ithedhe nyinyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.51",
            "verseOrgIds": [
              "1KI.8.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yie wangʼi one kwayo jatichni kod kwayo mag jogi Israel, bende yie iwinjgi kinde moro amora ma giywaknie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.52",
            "verseOrgIds": [
              "1KI.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar niyierogi e kind ogendini duto mag piny mondo gibed girkeni, mana kaka ninyiso jatichni Musa kane igolo kwerewa e piny Misri; yaye Jehova Nyasaye Manyalo Gik Moko Duto.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.53",
            "verseOrgIds": [
              "1KI.8.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1KI 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Solomon osetieko lamogi duto kod kwayogi ni Jehova Nyasaye, nochungʼ oa e nyim kendo mar misango mar Jehova Nyasaye, kama nogoyoe chonge kotingʼo bade kochomo polo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.54",
            "verseOrgIds": [
              "1KI.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1KI 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochungʼ mogwedho chokruok duto mar Israel gi dwol maduongʼ kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.55",
            "verseOrgIds": [
              "1KI.8.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1KI 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pak obed ni Jehova Nyasaye mosemiyo joge Israel kwe mana kaka nosingo. Onge kata mana wach achiel ma ok osechopo kuom gik moko duto mabeyo mane ochiwo kuom jatichne Musa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.56",
            "verseOrgIds": [
              "1KI.8.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1KI 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye ma Nyasachwa obed kodwa mana kaka nobedo gi kwerewa, mad kik owewa kata jwangʼowa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.57",
            "verseOrgIds": [
              "1KI.8.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1KI 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad olok chunywa ire, mondo wawuoth e yorene duto kendo wamak chikene gi puonjne kod buchene mane omiyo kwerewa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.58",
            "verseOrgIds": [
              "1KI.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "1KI 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo mad wechenagi maselamo e nyim Jehova Nyasaye, obed machiegni gi Jehova Nyasaye ma Nyasachwa odiechiengʼ gotieno, mondo okony jatichne kendo okony joge Israel kaluwore gi dwaro mar odiechiengʼ kodiechiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.59",
            "verseOrgIds": [
              "1KI.8.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "1KI 8:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo ji duto manie piny ongʼe ni Jehova Nyasaye e Nyasaye kendo ni onge moro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.60",
            "verseOrgIds": [
              "1KI.8.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "1KI 8:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "To chunyu nyaka chiwre chuth ni Jehova Nyasaye ma Nyasachwa kudak moluwore gi yorene kendo kurito chikene kaka e kindeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.61",
            "verseOrgIds": [
              "1KI.8.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomon ogwedho hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "1KI 8:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ruoth kod jo-Israel duto mane ni kode nochiwo misengini e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.62",
            "verseOrgIds": [
              "1KI.8.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "1KI 8:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon nochiwo misango mag lalruok ni Jehova Nyasaye: kwan-gi ne romo dhok alufu piero ariyo gi ariyo kod rombe gi diek maromo alufu mia achiel gi piero ariyo. Kamano ruoth kod jo-Israel duto nowalo hekalu ni Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.63",
            "verseOrgIds": [
              "1KI.8.63"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "1KI 8:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼono ruoth nopwodho dier laru mane nitie e nyim hekalu mar Jehova Nyasaye kendo kanyo nochiwoe misengini miwangʼo pep gi cham michiwo kod bor misango mar lalruok, nikech kendo mar misango mar mula mantie e nyim Jehova Nyasaye ne tin ahinya mane ok nyal tingʼo misangogo duto, kaka misango miwangʼo pep gi mag cham kod mag sawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.64",
            "verseOrgIds": [
              "1KI.8.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "1KI 8:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano Solomon notimo sawo e kindeno kaachiel gi jo-Israel duto mane ni kode chokruok maduongʼ miwuoro kotingʼo joma oa Lebo Hamath nyaka Wadi man Misri. Negitimo nyasino e nyim Jehova Nyasaye ma Nyasachwa kuom ndalo abiriyo kendo gichak gimedo ndalo abiriyo mamoko duto ne gin ndalo apar gangʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.65",
            "verseOrgIds": [
              "1KI.8.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "1KI 8:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinyne nomiyo ji thuolo mar ke. Negigwedho ruoth mi gidhi e miechgi, ka gimor kendo giil e chunygi nikech gik moko duto mabeyo mane Jehova Nyasaye osetimo ni jatichne Daudi kod joge Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.66",
            "verseOrgIds": [
              "1KI.8.66"
            ]
          }
        }
      ]
