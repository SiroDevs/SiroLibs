  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshisatu tshia bukelenge bua Hoshea, muana wa Ela, mukelenge wa Isalele, Hezikiya, muana wa Ahaza, mukelenge wa Yuda, wakabanga kukokesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakadi ne bidimu makumi abidi ne bitanu hakabangeye kukokesha; wakakokesha mu Yelushalema bidimu makumi abidi ne tshitema; dina dia mamu wandi diakadi Abi, muana wa Zekâya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza malu mimpe ku mesu kua Yehowa bu muakenza Davidi, nkambua wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumusha bitendelelu biakadi ku mutu kua mikuna, wakashimbula makunshi akatendelelabo, wakatahila Bashela hanshi, wakabutula nyoka wa tshiamu tshia mitaku Wakenza Mose, bualu bua mu matuku au Bena Isalele bakadi boshila nyoka au musenga wa manananshi; wakamubikila ne, Nehushetana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakeyemena Yehowa, Nzambi wa Isalele; kakuakadi muntu mukuabo bu yeye munkatshi mua bakelenge ba Yuda bakalonda ku nyima kuandi, anyi munkatshi mua bakadi ku mpala kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua yeye wakalamata Yehowa; kakasesuka mu nshila wandi, kadi wakatumikila mikenji yandi yakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakadi nʼandi, wakamuvuisha diakalengele kuonso kuakayeye; yeye wakatombokela mukelenge wa Ashû, kakamukuatshila mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakahita Bena Peleshete bukole ku luseke lua Gaza ku tshibumba tshia batentekedi tô ne ku musoko wakadi ne lumbu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshinai tshia bukelenge bua Hezikiya, mukelenge wa Yuda, ne mu tshidimu tshia muanda mutekete tshia bukelenge bua Hoshea, muana wa Ela, mukelenge wa Isalele, Shalamanesê, mukelenge wa Ashû, wakalua bua kuluangana ne Bena Samalea; wakabatshintshimika. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita bidimu bisatu, bakahaula musoko; mu tshidimu tshisambombo tshia bukelenge bua Hezikiya ne tshia tshitema tshia bukelenge bua Hoshea, mukelenge wa Isalele, bakanyenga musoko wa Samalea. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Ashû wakaya ne Bena Isalele mu Ashû; wakabateka mu Halaha ne kukala kua musulu wa Habo mu Gozana ne mu misoko ya Bena Madai, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua kabakatumikila dî dia Yehowa, Nzambi wabo, kadi bakashiha tshihungidi tshiandi; bakabenga mikenji yonso yakabambila Mose, muntu wa Yehowa, kabakayunvua, kabakayenza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia dikumi ne binai tshia bukelenge bua Hezikiya, Saneheliba, mukelenge wa Ashû, wakalua, wakaluangana ne bena misoko yonso ya Yuda yakadi ne ngumbu, wakayinyenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezikiya, mukelenge wa Yuda, wakatumina mukelenge wa Ashû dî mu Lakisha ne Nakukuenzela bibi; usesuke kundi, nenkuhe mulambu udi ungambila Mukelenge wa Ashû wakafutshisha Hezikiya, mukelenge wa Yuda, milambu ya ntalanta ya argent",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18.14:",
              "type": "text"
            },
            {
              "text": "Tangila 2 Bakelenge 5.5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nkama isatu ne ntalanta ya or",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18.14:",
              "type": "text"
            },
            {
              "text": "Ntalanta wa or wakadi ne bujitu bua 59 kg.",
              "type": "text"
            }
          ]
        },
        {
          "text": " makumi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezikiya wakamuha argent yonso yakadi mu nsubu wa Yehowa, ne bintu bionso bia mushinga mukole bia mu nsubu wa mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshikondo atshi Hezikiya wakumusha or yonso ya ku bibi bia mu ntempelo wa Yehowa ne ya ku makunshi yakalamika Hezikiya, mukelenge wa Yuda; wakabifila kudi mukelenge wa Ashû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Ashû wakatuma Tâtana ne Labasalisa ne Labashake, bafume ku Lakisha ne masalayi a bungi bua kuluanganabo ne Hezikiya, mukelenge wa Yuda, mu Yelushalema Bakafika ku Yelushalema. Hakafikabo, bakimana ku mushimi wa mai udi hehi ne nshila wa mu muaba wa muvu wa bilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabikilabo mukelenge, Eleyakima, muana wa Hilekiya, wakadi ku mutu kua nsubu wa mukelenge, ne Shebena secrétaire, ne Yoa, muana wa Asafa, mufundi wa malu a bukelenge, bakaluhuka kudiye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labashake wakabambila ne, Numanyishe Hezikiya ne, Mukelenge munene wa Ashû udi ukuebesha ne, Udi ne tshieyemenu kai tshiudi weyemena? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe udi Wamba (kadi udi wamba mei a hatuhu) ne, Hatuahunga dî, tudi ne bukole bua kuluangana nʼabu. Udi weyemena nganyi, hawakuntombokela? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe udi weyemena ku mulangala mutshibuke, bukelenge bua Ejipitu mene: bieyemenahu muntu tshianza tshiandi, neubuele mu tshianza tshiandi, neutshisompoke; Palô, mukelenge wa Ejipitu, udi nunku kudi bonso badi bamueyemena. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuangambila ne, Netueyemene Yehowa, Nzambi wetu; kanyeye mene wakumusha Hezikiya bitendelelu biandi ku mikuna ne bioshelu biandi, wakambila Bena Yuda ne Bena Yelushalema ne, Bunudi nʼabu mbua kutendelela ku mpala kua tshioshelu etshi mu Yelushalema, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku ndi nnusengelela ne, Nuhunge dî ne mukelenge wanyi, mukelenge wa Ashû, hashishe nennuhe tubalu binunu bibidi binuamanya mua kushikika bantu ha nyima hatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi mudi mumanye mua kusesuisha kapitene kamue kadi katamba kuhuekela munkatshi mua bantu ba mukelenge wanyi bua kutekemenaku Bena Ejipitu bua kunuhabo makalu ne badi benda ha nyima ha tubalu? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nakuluila bua kuhaula muaba eu Yehowa kayi nʼanyi, anyi? Yehowa wakungambila ne, Uye biebe, uhaule buloba ebu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Eleyakima, muana wa Hilekiya, ne Shebena ne Yoa bakambila Labashake ne, Tudi tukusengelela ne, Uyikile ne bantu bebe mu muaku wa Bena Sulia, bualu bua tuetu tudi baumanye; kuyikidi nʼetu mu muaku wa Bena Yuda mu matshu a bantu badi ha lumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Labashake wakabambila ne, Mukelenge wanyi wakuntuma anu kudi mukelenge wenu ne kunudi kabidi bua kunuambila mei au nkayenu? Yeye kakuntuma kudi bantu badi bashikame ha mutu ha lumbu, bua bobo hadie tunvi tuabo, banue menyi abo diatshimue nʼenu, anyi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Labashake wakimana, wakela dî diandi bikole nu muaku wa Bena Yuda, wakamba ne; Unvuai dî dia mukelenge munene wa Bena Ashû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge udi wamba ne, Hezikiya kanudingi, bualu bua yeye kena ne bukole bua kunusungila mu tshianza tshiandi; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanueyemenyi Yehowa bualu hua dî dia Hezikiya ne, Yehowa neatusungile, kabena bafila musoko eu mu bianza bia mukelenge wa Ashû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanunvu dî dia Hezikiya nansha: bualu bua mukelenge wa Ashû udi wamba ne, Nuhunge nʼanyi dî, nuluhuke kundi, muntu ne muntu adie bintu muinshi mua mitshi yandi ya tumuma tukese ne mitshi ya nfigi, anue mai a mu mena andi kabidi; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "tô ne hanaya nʼenu ku buloba budi bifuana buloba buenu, buloba bua blé ne nvinyo mihia-mihia ne mampa ne mitshi ya tumuma tukese, ne mitshi ya olive ne buitshi; bua nuenu nuikale ne muoyo, kanufu; kanunvu dî dia Hezikiya hanuambileye ne, Yehowa neatusungile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munga nzambi wa mu bisamba bikuabo wakusungila buloba buandi mu bianza bia mukelenge wa Ashû, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi ya Hamata ne ya Âpada idi kudi kunyi? Nzambi ya Sefâwayima ne ya Hena ne ya Iwa idi kudi kunyi? Yakasungila Samalea mu tshianza tshianyi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganyi wa munkatshi mua nzambi yonso ya bisamba wakasungila buloba buabo mu tshianza tshianyi, bua Yehowa amanye mua kusungila Yelushalema mu tshianza tshianyi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bantu bakahuwa, kabakamukudimuna dî; bualu bua mukelenge wakadianjila kubambila ne, Kanumukudimunyi dî nansha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Eleyakima, muana wa Hilekiya, ne Shebena secrétaire, ne Yoa, muana wa Asafa, mufundi wa malu a bukelenge, bakahingana kuai Hezikiya ne bilulu biabo bihanda, bakamuambila mei a Labashake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
