              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Saneheliba, mukelenge wa Ashû, wakumuka, wakahingana, wakashikama ku Ninewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
