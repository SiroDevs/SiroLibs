          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buhianyi buitanu buakadi bua tshisamba tshia Bena Ashê ku meku abo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukalu wabo wakadi Helekata ne Hali ne Betena ne Akasafa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Alameleke ne Amada ne Mishala; Wakafika ku Kâmele ku wesete ne ku Shihô-libenata; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakanyunguluka ku Bete-dagona kudi kuhatukila diba, wakafika ku Zebuluna ne ku tshibanda tshia Yifetahele ku Bete-emeke ne Niele; wakahatukila ku Kabula ku tshianza tshia bakashi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Ebelona ne Lehoba ne Hamona ne Kana tô ne ku Sidona, musoko munene; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukalu wakanyunguluka ku Lama ne ku musoko wa Tulo wakadi ne lumbu; mukalu wakanyunguluka ku Hosa; wakahatukila kukala kua mai manene ku luseke lua Akiziba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Uma kabidi ne Afeke ne Lehobo; bimenga makumi abidi ne bibidi ne misoko yabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebu mbuhianyi bua tshisamba tshia Ashê ku meku abo: bimenga ne misoko yabi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        }
      ]
    },
    {
