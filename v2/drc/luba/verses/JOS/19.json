              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikishabo kuabanyangana buloba buakahanabo ku mikalu yabu, Bena Isalele bakaha Yoshua, muana wa Nuna, buhianyi munkatshi muabo: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
