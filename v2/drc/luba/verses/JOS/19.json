          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "bu mu dî dia Yehowa bakamuha musoko wakalombeye, Timena-tasela ku mikuna ya Efelayima; yeye wakasa musoko, wakashikamamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
