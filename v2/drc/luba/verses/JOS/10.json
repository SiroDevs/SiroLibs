          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Holama, mukelenge wa Gezê, wakalua bua kukuatshisha Bena Lakisha; Yoshua wakamushiha ne bantu bandi bonso, kakashiya nansha umue.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
