              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakumuka ku Makeda ne Bena Isalele bonso bakadi nʼandi, bakalua ku Libina, bakaluisha Bena Libina; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakabafila ne mukelenge wabo mu bianza bia Bena Isalele; wakashiha Libina ku muele wa nvita, ne bantu bonso bakadimu; kakashiyamu nansha umue; yeye wakenzela mukelenge wau bu muakenzeleye mukelenge wa Yeleko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
