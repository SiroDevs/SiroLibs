          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakahingana ne Bena Isalele bonso ku Debî, bakauluisha; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakanyenga musoko ne mukelenge wau, ne misoko yau yonso; bakabashiha ne muele wa nvita ne bakabutula bantu bonso bakadimu; kakashiya nansha umue: bu muakenzeye ku Hebelone, nunku wakenzela Debî ne mukelenge wau bu muakenzeleye Libina ne mukelenge wau.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
