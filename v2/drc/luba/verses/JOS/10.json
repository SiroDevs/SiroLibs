              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakumuka ku Egelona ne Bena Isalele bonso bakadi nʼandi, bakalua ku Hebelone, bakauluisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaunyenga, bakashiha ku muele wa nvita, ne mukelenge wau, ne misoko yau yonso, ne bantu bonso bakadimu; kakashiya nansha umue, bu muakenzeleye Egelona; kadi yeye wakaubutula ne bantu bonso bakadimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
