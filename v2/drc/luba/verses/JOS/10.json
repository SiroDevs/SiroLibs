              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakumuka ku Lakisha ne Bena Isalele bonso bakadi nʼandi, bakalua ku Egelona, bakasaku tshitudilu, bakauluisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakanyenga musoko dituku adi, bakashiha ku muele wa nvita; wakabutula bantu bonso bakadimu dituku adi, bu muakenzeleye Lakisha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
