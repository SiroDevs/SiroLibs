    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bakadi ku mutu kua meku a Bena Lewi bakalua kudi Eleazâ muakuidi, ne kudi Yoshua, muana wa Nuna, ne kudi bakadi ku mutu kua meku a Bena Isalele; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabambila mu Shilo mu buloba bua Bena Kanâna ne, Yehowa wakela mukenji wandi kudi Mose bua kutuha misoko ya kushikamamu ne miaba ya kudishamu bimuna bietu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakaha Bena Lewi misoko ei ne miaba ei munkatshi mua buhianyi buabo bu muakadi dî dia Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meku a Bena Kohata akangata tshiabo tshituha; bana ba Alona muakuidi, Bena Lewi mene mene, bakangata tshiabo tshituha munkatshi mua tshisamba tshia Yuda ne mu tshisamba tshia Shimeona ne mu tshisamba tshia Benyamina, bimenga dikumi ne bisatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuabo ba Bena Kohata bakangata tshiabo tshituha munkatshi mua meku a tshisamba tshia Efelayima ne mu tshisamba tshia Dana ne mu tshituha tshia tshisamba tshia Manashe, bimenga dikumi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Gêshona bakangata tshiabo tshituha munkatshi mua meku a tshisamba tshia Yisakâ ne mu tshisamba tshia Ashê ne mu tshisamba tshia Nafatale ne mu tshituha tshia tshisamba tshia Manashe tshia mu Bashana, bimenga dikumi ne bisatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Melali ku meku abo bakangata tshiabo tshituha munkatshi mua tshisamba tshia Lubena ne mu tshisamba tshia Gada ne mu tshisamba tshia Zebuluna, bimenga dikumi ne bibidi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakaha Bena Lewi bimenga ebi ne miaba ya ku matshika bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabaha bimenga ebi biakatelabo mena munkatshi mua tshisamba tshia Bena Yuda ne mu tshisamba tshia Bena Shimeona; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "biakadi bia bana ba Alona ba mu meku a Bena Kohata, bakadi bana ba Lewi; tshituha tshiabo tshiakadi tshia kumudia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabaha Kîyata-âba, Aba wakadi tatu wa Anaka (udi tshimenga tshia Hebelone) ku mikuna ya Yuda ne miaba ya ku matshika idi mitshinyunguluke. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.11",
            "verseOrgIds": [
              "JOS.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bakaha Kaleba, muana wa Yefune, madimi adi ha buihi ne tshimenga ne misoko yatshi bu buhianyi buandi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaha bana ba Alona muakuidi, Hebelone, tshimenga tshia kunyemenabo kudi mushihianganyi, ne miaba ya ku matshika, ne Libina ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.13",
            "verseOrgIds": [
              "JOS.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Yati ne miaba ya ku matshika, ne Eshetemo ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.14",
            "verseOrgIds": [
              "JOS.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Holona ne miaba ya ku matshika, ne Debî ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.15",
            "verseOrgIds": [
              "JOS.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayina ne miaba ya ku matshika, ne Yuta ne miaba ya ku matshika, ne Bete-shemeshe ne miaba ya ku matshika; bimenga tshitema munkatshi mua bisamba ebi bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.16",
            "verseOrgIds": [
              "JOS.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshisamba tshia Benyamina, Gibeona ne miaba ya ku matshika, ne Geba ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatota ne miaba ya ku matshika, ne Alamona ne miaba ya ku matshika: bimenga binai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.18",
            "verseOrgIds": [
              "JOS.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bimenga bionso bia bana ba Alona bakuidi biakadi bimenga dikumi ne bisatu ne miaba yabi ya ku matshika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meku a Bena Kohata, Bena Lewi, bakashala, bakangata bimenga bia mu tshituha tshiabo tshia mu tshisamba tshia Efelayima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.20",
            "verseOrgIds": [
              "JOS.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabala Shekeme ne miaba ya ku matshika mu mikuna ya Efelayima, tshimenga tshia kunyemenamu, ne Gezê ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Kibesayima ne miaba ya ku matshika, ne Bete-holona ne miaba ya ku matshika; bimenga binai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.22",
            "verseOrgIds": [
              "JOS.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munkatshi mua tshisamba tshia Dana, Eleteke ne miaba ya ku matshika, ne Gibetona ne miaba ya ku matshika, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayalona ne miaba ya ku matshika, Gata-limona ne miaba ya ku matshika: bimenga binai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
              "JOS.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munkatshi mua tshituha tshia tshisamba tshia Manashe, Tanaka ne miaba ya ku matshika, ne Gata-limona ne miaba ya ku matshika: bimenga bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
              "JOS.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bimenga bionso biakashikama meku a Bena Kohata akashala biakadi dikumi ne miaba yabi ya ku matshika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
      ]
    },
