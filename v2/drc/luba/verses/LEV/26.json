  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "LEV 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanusongi mpingu, kanujadiki luhingu lua tshiamu tshiakafulabo, anyi dikunshi anyi dibue diakasongabo mu buloba buenu bua kubmamina, bualu bua meme ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuvuluke matuku anyi a lumingu, nuikale ne kanemu mu nsubu wanyi, meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binualonda mei, anyi binuatumikila mikenji yanyi, binuayenza, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nennuhe nvula mu tshidimu tshia nvula, ne buloba nebukuame bintu bia bungi, ne mitshi ya mu madimi neyikuame mamuma a bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshikondo tshidibo bashehula bintu netshikale tô ne ku tshikondo tshidibo bahuola mamuma a mitshi, ne tshikondo tshidibo bahuola mamuma netshikale tô ne ku tshikondo tshidibo bakuna bintu, nenukute mafu tente ne bia kudia, nenushikame mu buloba buenu talala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nennuhe ditalala mu buloba, nenulale tulu, ne bantu kabena banutshinyisha, nengihate nyama mibi mu buloba buenu, ne kabena balue ne muele wa nvita mu buloba buenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nenuihate bantu badi nʼenu lukuna, nenubashihe ne muele wa nvita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batanu benu nebihate bantu lukama, ne bantu benu lukama nebihate binunu dikumi bia bantu, badi nʼenu lukuna nebafue ku muele wa nvita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nengikale nʼenu luse, nennuleleshe bana ba bungi, nennuvudishangane, nenjadike tshihungidi tshianyi munkatshi muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenudie bintu binuakahuola kale, nenumushe bia kale bua kushila bihia-bihia muaba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenshimike nsubu wanyi wa tshitendelelu munkatshi muenu, mutshima wanyi kawena wikala ne tshiji kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nengendakane munkatshi muenu, nengikale Nzambi wenu, ne nuenu nenuikale bantu banyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme ndi Yehowa, Nzambi wenu, wakanuhatula mu buloba bua Ejipitu bua nuenu kanuikadi bahika babo, nakatshibula mitshi ya tshikokedi yakatekabo ha nshingu yenu, nakanujalamisha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi binuahidia kunvua dî dianyi, binuahidia kutumikila mikenji yanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "binuahidia mikandu yanyi, binuabenga mei anyi mu mitshima yenu, kanuyi nuenza mikenji yanyi, binuashiha tshihungidi tshianyi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "meme kabidi nennuenzele nunku nengenze malu adi anutshinyisha, nennutumine masama adi anyanyisha mibidi yenu ne disama dia mubidi kahia, masama au neashihe mesu enu, neanyanyishe mitshima yenu, nenukune bintu bienu tshianana, bualu bua bantu badi nʼenu lukuna nebabidie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nengumushe mesu anyi kunudi, nenuhone ku mpala kua bantu badi nʼenu lukuna, bantu badi nʼenu lukuna nebanukokeshe, nenunyeme tshianana, bantu kabayi banze ku nuihata. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuahidia kunvua di dianyi meme mumane kunuenzela malu au onso, nennukengeshe bikole misangu muanda mutekete bualu bua mibi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenjimishe kudisua kunudi nʼaku bua bukole buenu, diulu nedikale bu tshiamu tshifike ne buloba nebuikale bu tshiamu tshia mitaku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenuenze mudimu wenu tshianana bualu bua buloba kabuena bukuama bintu, ne mitshi ya mu buloba kayena ikuama mamuma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuenda mu nshila mdi muhidie, kanuyi nunvua mei anyi, meme nendiundishe makenga enu mahite mibi yenu misangu muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nentume nyama ya muitu munkatshi muenu, neyinunyenge bana benu bakese, neyishihe bimuna bienu, nuenu nenulue bantu banya-banya nshila yenu neyikale hatuhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala malu a onso kayi akudimuna mitshima yenu kundi, binuampidia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "meme nennuhidie kabidi, nennukume misangu muanda mutekete bualu bua mibi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nendue ne muele wa nvita munkatshi muenu bu musombuedi wa tshihungidi tshianyi, ne hanuadisangisha mu misoko yenu, meme nentume masama makole munkatshi muenu, nennufile mu bianza bia bantu badi nʼenu lukuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanakehesha bintu bienu bia kudia, bakashi dikumi nebalambe bidia mu luesu lumue, bobo nebanuhimine bintu bia kudia mu tshihimu, nuenu nenuhidie kadi kanuena nukuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuahidia kunvua mei anyi bua malu a onso, binuampidia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "meme nennuhidie kabidi, nengikale nʼenu tshiji nennukengeshe misangu muanda mutekete bualu bua mibi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenudie munyinyi wa bana benu balume ne wa bana benu bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nenshimbule bitendelelu bienu bidi ku mutu kua mikuna, nenkose mpingu inudi nutendelela nʼai diba, nengele bitalu bienu ha mutu ha mpingu yenu, mutshima wanyi neunulengulule. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nembutule misoko yenu, ne bitendelelu bienu nebikale hatuhu, bintu bienu kabiena bi tua dihembu kundi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme nembutule buloba buenu, ne bantu badi nʼenu lukuna badi bashikamamu nebakeme bua bualu buabu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nennumuangalashe mu bisamba bikuabo, nempatule muele wa nvita ku nyima kuenu, buloba buenu nebuikale hatuhu ne misoko yenu neyikale mihaula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku buloba nebuikale ne bidimu bia kubanda, nebuikale hatuhu hanuikala mu buloba bua bantu badi n enu lukuna buloba buenu nebuikale mua kubanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buloba nebuikale ne bidimu bia buhafe tô bu bungi bua bidimu binuakuhidia kushiya buloba bua kubandabu hanuakashikamamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bungi bua bantu benu badi bashala nebikale ne mitshima mitekete mu buloba bua bantu badi nʼabo lukuna, nebanyeme hunvuabo tshiona tshia dibeshi dia mutshi didi dinyunga kudi luhehele, nebanyeme bu mundi udi unyema ku muele wa nvita, nebadishinde, mundi kayi ubihata. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebalenduishangane, mundi kayi ubihata, bu bantu badi banyema ku muele wa nvnta, kanuena nuikala ne bukole bua kuimana ku mpala kua bantu badi nʼenu lukuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nenufue munkatshi mua bisamba bikuabo, ne buloba bua bantu badi nʼenu lukuna nebunumine ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu benu badi bashala nebanyingalale ne makenga a mibi yabo mu buloba bua bantu badi nʼenu lukuna, nebanyingalale ne makenga a mibi ya batatuʼabo kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo nebatonde mibi yabo, nebatonde mitu ya batatuʼabo kabidi disambuka diabo dia mikenji ne kumpidia kuabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku meme nakabahidia, nakabafila mu buloba bua bantu badi nʼabo lukuna. Biahuekeshabo mitshima yabo idi kayiyi mitengula, bitabushabo dikenga dia mibi yabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenvuluke tshihungidi tshianyi ne Yakoba ne tshihungidi tshianyi ne Isaka ne tshihungidi tshianyi ne Abalahama, nenvuluke buloba ebu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buloba buakashiyabo nebuikale ne bidimu bia kubanda, nebuikale hatuhu; bobo nebitabushe dikenga dia mibi yabo bualu bua bobo bakahidia mei anyi, ne mitshima yabo yakalengulula mikenji yanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bua malu au onso hayabo mu buloba bua bantu badi nʼabo lukuna, meme tshiena mbahidia, tshiena ngikala nʼabo tshiji bua kubashiha tshiendelele ne bua kushiha tshihungidi tshianyi tshinakahunga nʼabo, bualu bua meme ndi Yehowa, Nzambi wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi bua bualu buabo nenvuluke tshihungidi tshianyi tshinakahunga ne bankambua babo banakahatula mu buloba bua Ejipitu ku mesu kua bisamba bia bantu, bua meme kuikala Nzambi wabo meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
