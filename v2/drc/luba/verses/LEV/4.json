          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienza mukokeshi wa bantu bualu bubi ku mpukahuka budi Yehowa uhidia ne biahilabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne hamanyeye bualu bubi buakenzeye, neafue mpumbu wa mbushi udi kayi ne tshilema bu mulambu wandi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "neatenteke tshianza tshiandi ha mutu ha mbushi, neamushihe kudibo bashihela mulambu wa kuosha ha kahia ku mesu kua Yehowa, eu udi mulambu wa kubuikila nʼau bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi nealue munu wandi mu mashi makuabo a mulambu, nealabe ku nsengu ya ku tshioshelu tshia kahia, neahongolole mashi makuabo ku tshitaku tshia tshioshelu tshia kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neoshe dianyi dionso ha tshioshelu, bu muakenzeye ne dianyi dia mulambu wa kuikisha nʼau ditalala, muakuidi neafue mulambu wa ku buikila nʼau bubi buandi ne bubi buandi nebuikale bubuikidibue.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
