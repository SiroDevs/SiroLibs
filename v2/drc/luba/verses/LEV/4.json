              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienza Muena Isalele bualu bubi ku mpukahuka budi Yehowa uhidia ne biahileye, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
