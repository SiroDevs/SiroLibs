        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Bienza muntu bualu bubi ku mpukahuka budi Yehowa uhidia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bienza muakuidi muela manyi ha mutu bualu bubi budi buhisha bantu, yeye nealele mulambu wa muana wa ngombe udi kayi ne tshitema kudi Yehowa, bu mulambu wa kubuikidila nʼau bubi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nealue ne muana wa ngombe ku mbelu kua ntenta wa kusangakena ku mesu kua Yehowa, neatenteke tshianza tshiandi ha mutu ha muana wa ngombe, neashihe muana wa ngombe ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi muela manyi ha mutu neangate mashi makuabo a muana wa ngombe, nealue nʼau mu ntenta wa kusangakena, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi neafue munu wandi mu mashi, neamiamine mashi misangu muanda mutekete ku mpala kua tshilulu tshikudika tshidi hankatshi ha nsubu wa tshitendelelu ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi nealabe mashi ku nsengu ya ku tshioshelu tshia musenga wa manananshi tshidi mu ntenta wa kusangakena ku mesu kua Yehowa, neahongolole mashi onso a muana wa ngombe ku tshitaka tshia tshioshelu tshia kahia tshidi ku mbelu kua ntenta wa kusangakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neamushe dianyi dionso dia muana wa ngombe wa mulambu wa kubuikila nʼau bubi ne dianyi didi ha mutu ha bintu bia munda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tumuma tubidi ne dianyi didi ha mutu hatu hehi ne bituntuku bia bibelu ne lukutu lua mutshima ne lua tumuma neanumushe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bu mudibo bumusha dianyi dia muana wa ngombe wa mulambu wa kuikisha nʼau ditalala, muakuidi neabioshe ha tshioshelu tshia kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshiseba tshia muana wa ngombe ne munyinyi wandi wonso ne mutu wandi ne bioku biandi ne bintu bia munda ne tuma tuandi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mubidi wandi mujima, neabituale ku butshika bua tshitudilu ku muaba muteke kudibo bela butue, neabioshe ha nkunyi ne kahia, yeye neabioshile kudibo bela butue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienza Bena Isalele bonso bualu bubi, ne bikala bualu ebu busokome ku mesu kuabo, bienzabo bualu budi Yehowa uhidia ne biahilabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne hamanyabo bualu bubi buakenzabo, bantu bonso ba mu tshisumbu tshia Bena Isalele nebafile muana mulume wa ngombe bu mulambu wa kubuikila nʼau bubi, balue nʼandi ku mbelu kua ntenta wa kusangakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakulu ba mu tshisumbu tshia Bena Isalele nebatentekashe bianza biabo ha mutu ha muana mulume wa ngombe ku mesu kua Yehowa, nebashihe muana mulume wa ngombe ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi nealue ne mashi makuabo a muana mulume wa ngombe ku nsubu wa tshitendelelu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi nealue munu wandi mu mashi, neamiamine misangu muanda mutekete ku mpala kua tshilulu tshikudika ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nealabe mashi ku nsengu ya ku tshioshelu tshidi mu ntenta wa kusangakena ku mesu kua Yehowa, yeye neahongolole mashi onso ku tshitaku tshia tshioshelu tshia kahia tshidi ku mbelu kua ntenta wa kusangakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neumushe dianyi dionso, neadioshe ha tshioshelu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye nênze nunku ne muana mulume wa ngombe, bu muakenzeye ne muana mulume wa ngombe wa mulambu wa kubuikila nʼau bubi bua bantu, muakuidi neafile mulambu wa kubuikila nʼau bubi buabo nunku, ne bubi buabo nebuikale bubuikidibue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.20",
            "verseOrgIds": [
              "LEV.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neatuale muana mulume wa ngombe ku butshika bua tshitudilu, neamuoshe ha kahia bu muakenzeye ne muana mulume wa ngombe wa kumudilu eu udi mulambu wa kubuikila nʼau bubi bua bantu bonso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
    },
