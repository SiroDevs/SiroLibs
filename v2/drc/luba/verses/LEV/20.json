    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele kabidi ne, Muntu yonso wa Bena Isalele anyi wa benyi ba munkatshi mua Bena Isalele udi ufila muana wandi kudi Moleke neashihibue bulelela, bena buloba nebamukume ne mabue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.2",
            "verseOrgIds": [
              "LEV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme kabidi nengumushe mesu anyi kudi muntu au, nemmumushe munkatshi mua bana babo, bualu bua yeye wakafua muana wandi kudi Moleke bua kuona nsubu wanyi ne kunyangisha dina dianyi dia tshijila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biabuikila bena buloba mesu abo kudi muntu au hafileye bana bandi kudi Moleke, kabayi bamushihe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "meme nengumushe mesu anyi kudi muntu au ne bantu bonso ba mu nsubu muandi, nemmumushe ne bantu bandi bonso badi benza handi malu a masandi ne Moleke, munkatshi mua bana babo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi ubuelakana ne bena muhongo ne batempi ba mbuku bua kulonda malu abo a masandi, nengumushe mesu anyi kudi muntu au, nemmumushe munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nudilengeshe nunku, nuikale bantu ba tshijila bualu bua meme ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutumikile mikenji yanyi, nuyenze meme ndi Yehowa udi unulengesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi wela tatuʼandi anyi mamuʼandi mulau nebamushihe bulelela, wakela tatuʼandi anyi mamuʼandi mulau mashi andi neikale hamʼbidi handi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulume udi wenda masandi ne mukashi wa mulume mukuabo, nebashihe mulume ne mukashi wake ndeye nʼandi masandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulume udi ulala ne mukashi wa tatuʼandi udi bu muntu wakavula bilulu bia tatuʼandi nebabashihe bubidi buabo, ne mashi abo neikale hamʼbidi habo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mulume ne mukashi wa muanʼandi, nebabashihe bubidi buabo, bobo bakenza bualu bubi, ne mashi abo neikale hamʼbidi habo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mulume ne mulume mu kuabo bu mudiye ulala ne mukashi, bubidi buabo bakenza bualu bubi nebabashihe, ne mashi abo neikale hamʼbidi habo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biabaka mulume mukashi ne mamuʼandi, bualu ebu budi bubi, nebaboshe mu kahia, busatu buabo, bualu bubi kabuikadi munkatshi muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mulume ne nyama, nebanshihe yeye ne nyama kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mukashi ne nyama, nebashihe mukashi ne nyama kabidi, mashi abi neikale hamʼbidi habi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biangata mulume muanʼabo mukashi, muana wa tatuʼandi anyi muana wa mamuʼandi, biavuleye bilulu biandi, ne biamuvula mukashi bilulu, ebu mbualu bua bundu, nebumushibue munkatshi mua bana babo, yeye wakavula muanʼabo mukashi bilulu, yeye nendituadile bubi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mulume ne mukashi hatshidiye ku katshetshi, bia muvuleye bilulu, yeye wakamuela bilulu ne mukashi wakitabusha hakadiye ku katshetshi kandi, nebumushibue bubidi buabo munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mamu webe mukuabo anyi tatu webe mukashi bilulu, bualu bua yeye wakavula bana babo bilulu, bobo nebadituadile bubi buabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.19",
            "verseOrgIds": [
              "LEV.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialala mulume ne mukashi wa mansebʼandi, udi bu muntu wakavula mansebʼandi bilulu, bobo nebadituadile bubi buabo, kabena balela bana tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biangata mulume mukashi wa muanʼabo mulume, ebu mbualu bubi, yeye wakavula muanʼabo mulume bilulu, bobo kabena balela bana tshiendelele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.21",
            "verseOrgIds": [
              "LEV.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nutumikile mei anyi ne mikenji yanyi, nubienze, buloba bundi musue kunuha bua kushikamamu kabunuluki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.22",
            "verseOrgIds": [
              "LEV.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuendi mu bilele bia tshisamba tshindi ngihata ku mesu kuenu, bualu bua bobo bakenza malu au onso, nunku nakabalengulula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.23",
            "verseOrgIds": [
              "LEV.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi meme nakanuambila ne, Nenuhiane buloba buabo, nennuhebu, buloba budi bûle tente ne mabele ne buitshi meme ndi Yehowa, Nzambi wenu, nakanujidila munkatshi mua bantu bakuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.24",
            "verseOrgIds": [
              "LEV.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nuenu nenutahulule nyama udi muimpe ne nyama udi kayi muimpe ne nyunyu udi muimpe ne udi kayi muimpe, kanuonyi mitshima yenu kudi nyama anyi nyunyu anyi kudi tshintu tshidi tshidikoka hanshi binakunuhidisha bu tshintu tshidi ka tshiyi tshimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.25",
            "verseOrgIds": [
              "LEV.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuikale bantu ba tshijila kundi, bualu bua meme Yehowa ndi wa tshijila, nakanusungula munkatshi mua bantu bua nuenu nuikale bantu banyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        }
      ]
    },
