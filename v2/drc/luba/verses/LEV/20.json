              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulume anyi mukashi udi ne muhongo anyi udi mutempi wa mbuku neashihibue, nebakumibue ne mabue, mashi abo neikale hamʼbidi habo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
