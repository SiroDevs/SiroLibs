        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose mu mukuna wa Sinai ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Hanuabuela mu buloba bundi nnuha, nenushiye buloba bua kubandabu kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenukune bintu mu madimi enu bidimu bisambombo, nenulongolole mitshi ya tumuma, ne nuhuole tumuma tua mitshi bidimu bisambombo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi tshidimu tshia muanda mutekete buloba nebuikale mua kubandabu kudi Yehowa, kanukunyi bintu mu madimi, kanulongolodi mitshi ya tumuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuhuodi bintu bidi bidimenena anyi tumuma didi tudimenena etshi ntshidimu tshia kubanda kua buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu bidi bidimenena mu tshidimu tshia kubanda kua buloba nebikale bintu bienu bia kudia, bintu biebe ne bia muhika webe mulume ne bia muhika webe mukashi ne bia muena mudimu webe ne bia muenyi udi ushikama nʼebe ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bia bimuna biebe ne bia nyama yonso idi mu buloba buebe bintu bionso biakadimenena nebikale bintu bia kudia.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neubale bidimu bia kubanda kua buloba muanda mutekete, bidimu muanda mutekete misangu muanda mutekete, neubale nunku bidimu muanda mutekete bia kubanda kua buloba misangu muanda mutekete tô ne ku bidimu makumi anai ne tshitema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku wewe neweleshe mpungi bikole dituku dia dikumi mu ngondo wa muanda mutekete, mu dituku dia kubuikila bubi bua bantu wewe neweleshe mpungi kuonso mu buloba buenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neujidile tshidimu tshia makumi atanu, newele di bua bantu bonso bahete budishikaminyi, etshi ntshidimu tshia disanka dinene kunudi, neuhingishe buloba buonso kudi bena buloba, ne muntu yonso neahingane kudi bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshidimu tshia makumi atanu netshikale tshidimu tshia disanka dinene kunudi, kanukunyi bintu, kanuhuodi bintu bidi bidimenena anyi tumuma tudi tudimenena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etshi ntshidimu tshia disanka dinene, netshikale tshidimu tshia tshijila kunudi, nenudie bintu bidi bidimenena mu madimi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu etshi tshia disanka dinene nenuhingane muntu yonso ku buloba buandi muntu yonso ku buloba buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuahanyisha mukuenu bintu bienu anyi binuasumba bintu ku bianza bia mukuenu, kanuenzedianganyi bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu mudi bungi bua bidimu ku nyima kua tshidimu tshia disanka dinene wewe neusumbe bintu kudi mukuenu, ne yeye neakusumbishe bu mudi bungi bua bidimu biakamaneye kuhuola bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biahita bidimu bia bungi, wewe udi mumanye mua kuhandisha mushinga wa bintu, ne bialeha bidimu bikese, wewe neuhuekeshe mushinga wabi bu mudi bungi bua bintu bidiye ukusumbisha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuenzedianganyi bibi, nuenu nenutshine Nzambi webe bualu bua meme ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nenutumikile mei anyi ne mikenji yanyi, nenubienze, nenushikame mu buloba talala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buloba nebukuame bintu bia bungi, nuenu nenukute mafu tente, nenushikame bienu talala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuadikonka ne, Netudie tshinyi tshidimu tshia muanda mutekete hatudi katuyi tukuna bintu, katuyi tuhuola bintu? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nennuvudishile disanka dianyi tshidimu tshisambombo, ne buloba nebukuame bintu bia bidimu bisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuakuna bintu tshidimu tshia muanda mukulu, nenudie bintu bia diambedi biakadi bishale mu nsubu yenu, tô ne ku tshidimu tshia tshitema hanuahuola bintu, nenudie bintu bia diambedi biakadi bishale.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuena mua kusumbisha muntu buloba bua yeye kuikala nʼabu tshiendelele, buloba buonso mbuanyi, ne nuenu nudi bu benyi ne bena luendu ku mesu kuanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buloba buonso bunudi nuhiana biasumbabo bukuabo, nebashiye tshieya tshia buhikudi bua buloba kudi wakabusumbisha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialua mukuenu muntu muhele, biahaneye tshituha tshia buloba buandi, ne bialua bana babo bua kubuhikula, badi mua kuhikula buloba buakahanabo kudi muanʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muntu eu kayi ne muanʼabo bua kubuhikula, kadi bialueye muntu mubanji udi ne bintu bia kubuhikula nʼabi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye neabale bungi bua bidimu biakahita hakamusumbisheye buloba, neamuhingashile mushinga wabu ne bintu bikuabo ha mutu, yeye neahingane mu buloba buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikaleye kayi ne bintu bia kubuhikula nʼabi, nunku buloba buakahaneye nebuikale mu bianza bia muntu wakabusumba tô ne halua tshidimu tshia disanka dinene, mu tshidimu tshia disanka dinene buloba nebuhikudibue ne yeye neahingane mu buloba buandi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
