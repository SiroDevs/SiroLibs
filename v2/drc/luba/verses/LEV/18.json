      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.1",
            "verseOrgIds": [
              "LEV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Meme ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuenji bilele bia mu buloba bua Ejipitu bunuakadi bashikame, kanuenji bilele bia mu buloba bua Kanâna bundualua kunuha, kanulondi mikenji yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nuenze mei anyi ne mikenji yanyi, nubilonde meme ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
              "LEV.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nutumikile mei anyi ne mikenji yanyi, bienza muntu nunku, neikale ne muoyo. Meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyi ha buihi ne muanʼenu bua kumuvula bilulu biandi, meme ndi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi tatuʼebe anyi mamuʼebe bilulu, yeye udi mamu webe, kumuvudi bilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mukashi wa tatuʼebe bilulu, yeye udi bu tatu mene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi muanʼenu mukashi bilulu, bikaleye muana wa tatuʼebe anyi muana wa mamuʼebe udi muledibue mu nsubu muenu, anyi muaba mukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi muana mukashi wa muana webe mulume, anyi muana mukashi wa muana webe mukashi bilulu, bobo badi bu wewe mene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi muana mukashi wa mukashi wa tatuʼebe bilulu, yeye udi muanʼenu mukashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi tatuʼebe mukashi bilulu, yeye udi muanʼabo ne tatuʼebe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mamuʼebe mukuabo bilulu, yeye udi muanʼabo ne mamuʼebe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi muanʼabo ne tatuʼebe mulume bilulu, kuyi ha buihi ne mukashi wandi, yeye udi mukashi wa tatuʼebe mukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mukashi wa muanʼebe bilulu, yeye udi mukashi wa muana webe, kuvudi bilulu biandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mukashi wa muanʼenu mulume bilulu, yeye udi mukashi wa mua nʼenu mulume. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mukashi ne muanʼandi mukashi bilulu, kuvudi muana mukashi wa muanʼandi mulume, anyi muana mukashi wa muanʼandi mukashi bilulu, badi bana benu, bualu ebu budi bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubala muan abo ne mukashi ebe, bua kumutatshisha hatshidiye ne muoyo ne kumuvula bilulu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudi mukashi bilulu hatshidiye ne tshijila tshia kulela kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuladi ne mukashi wa mukuenu bua kudionena bualu buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuadi bana bebe bua kubahitshisha mu kahia ka Moleke, kutedi dina dia Nzambi wenu tshitelatela meme ndi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuladi ne mulume bu mudibo balala ne mukashi, bualu ebu budi bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.22",
            "verseOrgIds": [
              "LEV.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuladi ne nyama bua kudionena mutshima webe, ne mukashi kimanyi biandi ku mpala kua nyama bua kulala handi, bualu ebu budi butamba bubi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanudionenyi mitshima yenu ne malu au Ebi mbilele bia bisamba bindi ngihata ku mesu kuenu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "buloba buabo buakoneka, nempingishe bubi ha mutu habu, buloba nkayabu budi buluka bena buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nutumikile mei anyi ne mikenji yanyi, kanuenji bilele ebi bidi bitambe bubi, nansha bana baledibue mu nsubu yenu nansha benyi badi munkatshi muenu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(bualu bua bena buloba bakadi ku mpala kuenu bakenza malu mabi â onso, ne buloba buakoneka), ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "buloba kabunuluki kabidi hanuabuona, bu muakadi buloba buluka tshisamba tshiakadi ku mpala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso batu benza malu mabi au nebumushibue munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nutumikile dî dianyi, kanuenji bilele ebi bibi biakenzabo ku mpala, kanudionyi mu malu au meme ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        }
      ]
    }
  ],
