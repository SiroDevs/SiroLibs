    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Bimita mukashi difu, bialeleye muana wa balume, yeye neikale mundi udi kayi muakane tô matuku muanda mutekete, bu muakadiye mu matuku a tshijila a disama dia lulelu luandi, yeye neikale bu mundi udi kayi muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia muanda mukulu, nebatengule muana wa balume. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neikale ne mashi a kudilengesha kuandi tô matuku makumi asatu ne asatu, kalengi tshianza tshiandi ha tshintu tshia tshijila, kabuedi mu nsubu wa tshitendelelu tô ne hashikisheye matuku a kudilengesha kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bialeleye muana wa bakashi, yeye neikale mundi udi kayi muakane tô mbingu ibidi, bu matuku a tshijila tshiandi, neikale ne mashi a kudilengesha kuandi tô matuku makumi asambombo ne asambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashika matuku a kudilengesha kuandi, nansha matuku a muana wa balume nansha a muana wa bakashi, yeye nealue ne muana wa mukoko wa tshidimu tshimue bu mulambu wa kuosha ha kahia, ne mputu nyunyu anyi nyunyu wa nkutshi bu mulambu wa kubuikila nʼau bubi, ku mbelu kua ntenta wa kusangakena, kudi muakuidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne yeye neayifile ku mpala kua Yehowa, bua kumubuikidila nʼau bubi; yeye neikale mulengeshibue kudi mashi andi. Eu udi mukenji wa mukashi udi ulela nansha muana wa balume nansha muana wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikaleye kayi ne mushinga wa muana wa mukoko, alue biandi ne nyunyu ya nkutshi ibidi anyi mputu nyunyu ibidi, umue bu mulambu wa kuosha ha kahia ne mukuabo bu mulambu wa kubuikila nʼau bubi, muakuidi munene neayifile bua kumubuikidila nʼau bubi, ne yeye neikale mulengeshibue.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        }
      ]
    }
  ],
