          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutumikile mei anyi onso ne mikenji yanyi yonso, nubienze, meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
