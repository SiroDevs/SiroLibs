          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuendeshi muanʼebe mukashi masandi, malu a masandi neikale mu buloba, ne buloba nebukale ne malu mabi tente. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvuluke matuku a lumingu, wakale ne ditshina mu nsubu wanyi meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
