            "sid": "LEV 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuenji bubi hanualumbulula bilumbu, anyi hanuidikisha bule bua bintu anyi bujitu buabi anyi bungi buabi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuikale ne bihimu bimpe ne bihiminu bimpe, nuikale ne épha",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
