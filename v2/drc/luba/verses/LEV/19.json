          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uleshe kanemu kudi muntu udi ne nsuki yandi mitoke tô, unemeke muntu mununu, utshine Nzambi webe meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
