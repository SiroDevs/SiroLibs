          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biashikama muenyi mu buloba buenu, kanumuenzedi bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muenyi udi ushikama munkatshi muenu ikale bu muntu udi muledibue mu nsubu yenu, numusue bu munudi badisue, bualu bua nuenu nuakadi benyi mu buloba bua Ejipitu meme ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
    },
