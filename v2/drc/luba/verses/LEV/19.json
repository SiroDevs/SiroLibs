  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "LEV 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Nuikale bantu ba tshijila bualu bua meme Yehowa, Nzambi wenu, ndi wa tshijila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso atshine tatuʼandi ne mamuʼandi, nuvuluke matuku a lumingu ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanukudimunyi mitshima yenu kudi mpingu, kanudienzedi mpingu ne tshiamu tshiakengululabo mu kahia ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanualua ne mulambu wa kubisha nʼau ditalala kudi Yehowa, nûfile ne mutshima udiye mua kuitabusha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenudie mulambu dituku dinudi nûfila ne makelela kabidi, biashala tshintu tô ne dituku disatu nebatshioshe mu kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.6",
            "verseOrgIds": [
              "LEV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biatshidiabo dituku disatu, bualu ebu budi bubi, tshiena ngitabusha mulambu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.7",
            "verseOrgIds": [
              "LEV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "muntu yonso udi ûdia neadituadile bubi buandi, bualu bua yeye wakuona tshintu tshijila tshia Yehowa, nebumushe muntu au munkatshi mua bana babo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuahuola bintu binuakakuna mu buloba, kanuhuodi ku matengu a madimi, kanusangishi bintu bionso binudi nuhuola. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.9",
            "verseOrgIds": [
              "LEV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanusangishi tumuma tuonso ludi mu madimi enu, kanuambudi tumuma tuakahona hanshi mu madimi enu, nushiye bintu ebi bia kukuatshisha nʼabi bahele ne benyi meme ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuibi, kanudingidianganyi, kanushimianganyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuditshihi ne mashina ne dina dianyi, kanutedi dina dianyi tshitelatela, meme ndi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanukengeshi mukuenu, kanuibi bintu biandi, kanushadi ne difutu dia muena mudimu butuku tô ne dinda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuhendi muena mahaha, kanuteki tshintu tshia ku lenduisha nʼatshi muntu mufofo, kadi nuenu nutshine Nzambi wenu meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuenji bibi hanualumbulula tshilumbu, kanunemekedi muntu muhele, kanutumbishi muntu munene, kadi nulumbulule bilumbu bia muena mutumba nʼenu ne buakane mu mutshima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuendakanyi bu bena mukoso munkatshi mua bantu benu, kanuhuwi bikala muena mutumba nʼenu mikuata kudi tshilumbu meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuikadi ne lukuna mu mutshima kudi muanʼenu, kadi ubele muena mutumba nʼebe, bua wewe kutuadi bubi bua bualu buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudisombuedi, kuikadi ne lukuna kudi bana ba bana benu, kadi sua mukuenu bu mûdi mudisue, meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutumikile mei anyi. Kanubueshakanyi bimuna bienu, kanukunyi ntete ya mishindu ibidi mu budimi bumue, kanuluatshi bilulu bikuma ne munda mashilangane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi ulala ne mukashi muhika, udi mubangila kudi mulume, udi kayi muanze kuhikudibua, nebabakengeshe bubidi buabo, kabena babashiha bualu bua yeye kakadi muhikudibue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulume eu nealue ne mulambu wa kubuikila nʼau disambuka diandi dia mikenji kudi Yehowa, ku mushiku wa mbelu wa ntenta wa kusangakena, neafile tshimpanga tshia mulambu wa kubuikila nʼau disambuka diandi dia mikenji. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neafile mulambu wa kumubuikidila nʼau bubi buakenzeye ku mpala kua Yehowa, ne bubi buandi buakenzeye nebuikale bubuikidibue.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuahuola mu buloba ne hanuakuna mitshi ya mamuma, kunudi mamuma a mitshi tô bidimu bisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi halua tshidimu tshinai, nujidile mamuma onso a mu tshidimu atshi bua kutendelela nʼau Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua tshidimu tshitanu, nudi mua kudia mamuma ne kuendulula nʼau mushinga meme ndi Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanudi tshintu ne mashi atshi, kanutempi mbuku, kanuenji bilengulengu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanubeyi nsuki yenu biketu, kanuhungi miedi yenu ku bihanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.27",
            "verseOrgIds": [
              "LEV.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
