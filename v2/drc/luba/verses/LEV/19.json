          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanubuelakanyi ne bena mulongo anyi batempi ba mbuku, kanubakebi, kunudionyi kudibo meme ndi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
