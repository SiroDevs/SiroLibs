              "text": "19.36",
              "type": "text"
            },
            {
              "text": "Lewitiki 5.11",
              "type": "text"
            }
          ]
        },
        {
          "text": " muimpe ne hin",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19.36",
              "type": "text"
            },
            {
              "text": "Hin wakadi tshihiminu tshia 6 litres",
              "type": "text"
            }
          ]
        },
        {
          "text": " muimpe meme ndi Yehowa, Nzambi wenu, wakantaha tula mu buloba bua Ejipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
