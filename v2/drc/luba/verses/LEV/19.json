          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanutahi mputu hamʼbidi henu bua kujinga nʼai bantu bafue, kanutahi nsalu hamʼbidi henu meme ndi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        }
      ]
    },
    {
