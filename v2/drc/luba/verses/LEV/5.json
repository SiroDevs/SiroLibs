        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienza muntu bualu bubi, yeye mumane kuditshiha ne muikale mumanyi wa bualu, mubumone ne mesu andi, mubumanye mu mutshima wandi kadi yeye muhidie kumanyisha bantu, yeye neadituadile dihila dia bubi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialenga muntu tshianza tshiandi ha tshintu tshibi, nansha mifuba ya nyama udi kayi muakane, nansha mifuba ya ngombe udi kayi muakane, nansha mifuba ya tshintu tshidi tshidikoka hanshi tshidi katshiyi tshiakane, ne bikala bualu ebu busokoka ku mesu kuandi, yeye udi muntu wa bukoya, neahile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyi bialengeye tshianza ha manyanu a muntu ne bikala bualu ebu busokoka ku mesu kuandi, hamanyeye bualu ebu, yeye neahile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyi biaditshiha muntu lubilu ne mishiku yandi bua kuenza bualu bubi anyi bualu buimpe, biaditshiha muntu lubilu nunku ne bikala bualu ebu busokoka ku mesu kuandi, hamanyeye bualu, yeye neahile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahileye bua bualu bubi, yeye neatonde bualu bubi buakenzeye ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye neafile mulambu kudi Yehowa wa disambuka dia mikenji, nansha muana mukashi wa mukoko nansha muana mukashi wa mbushi, bu mulambu wa disambuka dia mikenji, ne muakuidi neafile mulambu bua kumubuikidila nʼau bubi buandi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikaleye kayi ne mushinga wa muana wa mukoko, yeye neafile mulambu wa disambuka dia mikenji kudi Yehowa, nansha nyunyu ya nkutshi ibidi nansha mputu nyunyu ibidi, nyunyu umue bu mulambu wa kubuikila nʼau bubi ne mukuabo bu mulambu wa kuosha ha kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye nealue nʼai kudi muakuidi, neafile mulambu wa kubindila nʼau bubi diambedi, neanyengabashe nshingu wandi kadi kena umuhandulula nansha, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "neamiamine mashi makuabo a mulambu wa kubuikala nʼau bubi ku luseke lua tshioshelu, ne mashi makuabo yeye neahongolole ku tshitaku tshia tshioshelu, tshintu etshi mmulambu wa kubuikila nʼau bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neafile nyunyu muibidi bu mulambu wa kuosha ha kahia, bu muakadi mikenji, muakuidi neafile mulambu wa kumubuikidila nʼau bubi buandi ne bubi buandi nebuikale bubuikidibue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikaleye kayi ne mushinga wa nyunyu ya nkutshi ibidi anyi mputu nyunyu ibidi, yeye neafile tshituha tshia dikumi tshia épha",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.11",
              "type": "text"
            },
            {
              "text": "Épha wakadi tshihiminu tshia 37 litres",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa bukula bu mulambu wa kubuikila nʼau bubi bua bantu, kedihu nansha manyi nansha musenga wa manananshi, eu mmulambu wa kubuikila nʼau bubi bua bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye nealue nʼabu kudi muakuidi, ne muakuidi neabuambule dianza tente bu tshivulukidi, neabuoshe ha tshioshelu bu mulambu wa kuoshila Yehowa ha kahia eu udi mulambu wa kubuikila nʼau bubi bua bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neafile mulambu wa kumubuikidila nʼau bubi buakenzeye, ne bubi buandi nebuikale bubuikidibue, tshituha tshia bukula tshidi tshishale netshikale tshia muakuidi, bu mudibo benza ne mulambu wa bukula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biasambuka muntu ku mikenji bua kuenza bualu bubi ku mpukahuka mu malu a tshijila a Yehowa, yeye neafile mulambu wa disambuka dia mikenji kudi Yehowa, tshimpanga tshidi katshiyi ne tshitema mushinga wa nshekele",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.15",
              "type": "text"
            },
            {
              "text": "Nshekele wakadi ne bujitu bu bua 15 grammes",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa mu nsubu wa Nzambi bu mulambu wa disambuka dia mikenji. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neahingishe mushinga wa tshintu tshia tshijila ne tshituha tshitanu ha mutu, neabifile mu bianza bia muakuidi, ne muakuidi neafile tshimpanga bu mulambu wa disambuka dia mikenji, ne bubi buandi nebuikale bubuikidibue.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienza muntu bualu bubi budi Yehowa uhidia, kayi mumanye bualu, yeye neahile, neadituadile dihila dia bubi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neafile tshimpanga tshidi katshiyi ne tshilema kudi muakuidi tshia mushinga ûdi witabusha bu mulambu wa disambuka dia mikenji, ne muakuidi neafile mulambu wa disambuka dia mikenji buakenzeye ku mpukahuka, kayi mubumanye, ne bubi buandi nebuikale bubuikidibue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eu udi mulambu wa disambuka dia mikenji, yeye udi ne dihila dilelela ku mesu kua Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
