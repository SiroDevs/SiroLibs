        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabika mu Elima ne Bena Isalele bonso, bakalua mu tshihela, dina diatshi Sina, hankatshi ha Elima ne Sinai. Bakafika nunku dituku dia dikumi ne ditanu dia ngondo muibidi hakumukabo mu buloba bua Ejipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele buonso buabo bakajiana Mose ne Alona mu tshihela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakabambila ne, Biakadi bimpe bua tuetu kufua mu Ejipitu ku tshianza tshia Yehowa hatuakashikama hadi bivuadi bia munyinyi ne hatuakukutshika mafu ne bidia, kadi nuenu nuakuluila nʼetu mu tshihela etshi bualu bua kushiha tshisumbu etshi tshionso ne nzala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, Mona, nennulokeshile bidia bia mu diulu, bantu nebaye, nebabisangishe ku dituku bikumbane ku dituku bikumbane. Nembatete ne badi benda mu di dianyi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku disambombo nebalongolole bidibo bangate, bikale tshituha ha mutu ha tshituha tshidibo basangisha ku dituku ku dituku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ne Alona bakambila Bena Isalele bonso ne, Dilolo nenumanye ne, Yehowa wakunuluhula mu buloba bua Ejipitu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne dinda nenumone butumbi bua Yehowa, bualu bua Yehowa udi munvue munudi numujiana, tuetu tudi banganga bua nudi nutujiana? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakamba ne, Halua Yehowa kunuha munyinyi dilolo ne kunukutshisha bidia ne dinda, bualu bua Yehowa udi munvue bu munudi numujiana, tuetu tudi banganyi? Kanuena nutujiana, nudi nujiana Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila Alona ne, Ambila tshisumbu tshionso tshia Bena Isalele ne, Luai ha buihi ku mpala kua Yehowa, bualu bua yeye wakunvua tshitanu tshienu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadi Alona wambila tshisumbu tshionso tshia Bena Isalele nunku, bakatangila ku tshihela, ne monai, butumbi bua Yehowa buakamueneka mu ditutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.11",
            "verseOrgIds": [
              "EXO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakunvua tshitanu tshia Bena Isalele, ubambile ne, Dilolo nenudie munyinyi, dinda nenukute bidia, nuenu nenumanye ne, Meme ndi bianyi Yehowa, Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua dilolo nkuadi yakalua, yakabuikila tshitudilu, dinda dime diakadi dinyunguluka tshitudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakahanda dime diakadi hanshi, monai, tshintu tshikese tshibulunge tshiakadi ha tshihela, tshiakadi tshikese bu dime dikuatakane ha buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshimonabo, Bena Isalele bakakemangana ne, Etshi ntshinyi? bua bobo kabakatshumanya Mose wakabambila ne, Tshidi bidia biakunuha Yehowa bua kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshidi tshintu tshiakunuambila Yehowa ne, Muntu ne muntu adisangishilebi mudiye mua kudia, tshihiminu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.16",
              "type": "text"
            },
            {
              "text": "Di didi omer, tshihiminu tshia litres 3 anyi 4.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku muntu ne muntu, muntu ne muntu adisangishilebi bu bungi bua bantu ba mu ntenta wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakenza nunku, bakuabo bakasangisha bia bungi, bakuabo bakasangisha bikese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabidikishabo ne tshihiminu, muntu wakadi usangisha bia bungi bintu kabiakashala kudiye, ne muntu wakadi usangisha bikese kakadi ne nzala, muntu ne muntu wakadisangishilabi bu muakamanyeye mudiadieye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakabambila ne, Muntu kabishiyi tô ne dinda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bobo kabakitabusha dî dia Mose, bakuabo bakabishiya tô ne ku dinda, bishi biakabuelamu, bidia biakanunka muhuya mubi, Mose wakadi nʼabo tshiji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabisangisha buatshia-buatshia, muntu ne muntu bu muakamanyeye mudiadieye, ne hakatema munya, bidia biakenguluka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua dituku disambombo, bakasangisha bituha bibidi, bihiminu bibidi ku muntu ne ku muntu, ne bakulu ba munkatshi muabo Bakalua, bakamanyisha Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Edi ndî diakuamba Yehowa ne, Makelela udi dituku dia kuikisha dia tshijila, dituku diakadijidila Yehowa nulambe bidia ne munyinyi binudi basue, ne bintu bionso bidi bishala, nubitekele bua kudia makelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalekela bidia tô ne ku dinda bu muakamba Mose, ne bidia kabiakabola, ne bishi kabiakabuelamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakamba ne, Nudie bintu ebi lelu, bualu bua edi ndituku diakadijidila Yehowa, kanuena nubisangana mu mpata lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nudisangishe matuku asambombo, kadi dituku dia muanda mutekete didi dijidila, kabiena bikalaku dituku adi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua dituku dia muanda mutekete, bakuabo bakaya kusangisha bidia, kadi kabakabisangana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, Nenuhidie kutumikila mikenji ne mei anyi musangu bule munyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, Yehowa wakunuha dituku dijidila, nunku yeye wakunuha bidia bia matuku abidi ku dituku disambombo, muntu ne muntu ashale mu muaba wandi, kaluhuki mu muaba wandi dituku dia muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bantu bakikisha dituku dia muanda mutekete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakabikila bidia abi ne, Mana Tshiakadi tshintu tshitoke tô bu ntete ya conandre, tshiakadi tshintu tshia kutua kuimpe bu mikata mienza ne bintshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakamba ne, Etshi ntshintu tshiakuamba Yehowa ne, Nushale ne tshihiminu tshia bintu ebi tô ne ku bikondo bienu bionso, bua nuenu numone bidia binakanudisha nʼabi mu tshihela, hanakanuhatula mu buloba bua Ejipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila Alona ne, Angata tshivuadi, tekamu tshihiminu tshia bidia abi tente, ubiteke ku mesu kua Yehowa, nushale nʼabi tô ne ku bikondo bienu bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alona wakabiteka ku mpala kua Mushete wa Yehowa bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakadia bidia abi tô bidimu makumi anai, tô ne hakaluabo mu buloba muakadi bantu, baka dia bidia abi tô ne hakaluabo ku matshika a buloba bua Kanâna. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshihiminu etshi tshidi bu tshia dikumi tshia épha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.36",
              "type": "text"
            },
            {
              "text": "Epha wakadi tshihiminu tshia litres 37.",
              "type": "text"
            }
          ]
        }
