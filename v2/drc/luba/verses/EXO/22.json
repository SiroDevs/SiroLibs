          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biwasombesha mukuabo muhele wa munkatshi mua bantu banyi argent, kumubadi bu muena dibanza, kumulombi tshia kasombelu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biwangata tshilulu tshia mukuenu bu tshieya, wewe neutshihingashe kudiye diambedi diba kadiyi dianzekubuela, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua tshiotshi tshidi anu tshiandi tshia kudibuikila nʼatshi, yeye nealale tulu munyi? Hadileye kundi, nemmunvuile, bualu bua meme ndi ne luse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
