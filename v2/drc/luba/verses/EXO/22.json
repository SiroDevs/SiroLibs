              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne tshiji tshianyi netshitambe bukole, nennushihe ne muele wa nvita, ne bakashi benu nebikale bakashi ba mu lufuila ne bana benu nebikale bana ba nshiya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
