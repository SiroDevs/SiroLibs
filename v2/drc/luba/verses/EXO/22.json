          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzai nunku ne ngombe yenu ne mikoko yenu kabidi, muana neikale ne mamu wandi matuku muanda mutekete, kadi numufile kundi dituku dia muanda mukulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
