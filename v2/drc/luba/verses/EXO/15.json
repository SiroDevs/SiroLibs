            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalua ku Elima kuakadi mpokolo ya mai dikumi ne ibidi, ne mabue makumi muanda mutekete bakashikamaku hehi ne mai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
