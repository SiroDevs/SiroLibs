          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuendi masandi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.14",
            "verseOrgIds": [
              "EXO.20.14"
            ]
          }
        }
