              "type": "text"
            }
          ]
        },
        {
          "text": "Binuangashila tshioshelu tshia mabue, kanusongi mabue ne biamu, bualu bua binuâheya ne tshiamu, nuenu nuakuona mabue au. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
