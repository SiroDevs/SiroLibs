      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza bilulu bia bleu ne bikunzubile ne bikunze-kunzu bia kuenza nʼabi mudimu mu muaba wa tshima, bakenzela Alona bilulu bia tshijila bu muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza efoda ne or ne bilulu bia bleu ne bikunzubile ne bikunze-kunzu ne bia lin muimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatula tshiamu tshia or to ku muhimbu mukese, bakenza nshinga ya or, bakatshikuma ne buanda bua bleu ne bukunzubile ne bukunze-kunzu ne bua lin kudi bantu ba lungenyi lule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.3",
            "verseOrgIds": [
              "EXO.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza bintu bia kuteka ha maha bua kutuishangana bituha bia efoda bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.4",
            "verseOrgIds": [
              "EXO.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza mukaba wa efoda bu muakadibo benza efoda ne bintu bia or ne bilulu bia bleu ne bikunzubile ne bikunze-kunzû ne bia lin, bu muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza mabue a onyx, bakabuesha mu masoso a or, bakafundahu mena a bisamba bia bana ba balume ba Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakâteka ha bilulu bia ha maha bia efoda, mabue â akadi bu tshivulukidi kudi bana ba balume ba Isalele bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza tshilulu tshia ha tshiadi kudi bantu ba lungenyi lule, bu muakenzabo efoda ne bintu bia or ne bilulu bia bleu ne bikunzubile ne bikunze-kunzu ne bia lin muimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.8",
            "verseOrgIds": [
              "EXO.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakidikisha nseke yonso ne luidi lumue, bakatshibula tshilulu, buludi buatshi buakadi bunene bua ntanta wa tshianza ne butshiama buatshi buakadi bunene bua ntanta wa tshianza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.9",
            "verseOrgIds": [
              "EXO.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatshitekahu milongo ya masoso a mabue mai mu mulongo wa kumudilu bakateka mabue a sardoine ne topaze ne émeraude, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu mulongo muibidi mabue a rubis ne saphir ne calcédoine, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu mulongo muisatu mabue a opale ne agate ne améthyste, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.12",
            "verseOrgIds": [
              "EXO.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu mulongo muinai mabue a chrysohthe ne onyx ne jaspe. Bakabuesha mabue au mu masoso a tshiamu tshia or. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabue akadi bungi bua mena a bisamba bia Bena Isalele, dikumi ne bibidi, bakafundahu mena a bisamba bia Bena Isalele dikumi ne bibidi ku mulongo wa tshisamba ne tshisamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.14",
            "verseOrgIds": [
              "EXO.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza tukanu tua or tuakadi tuhindakana bu muonshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.15",
            "verseOrgIds": [
              "EXO.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza masoso a or abidi ne nkanu ibidi, bakateka nkanu ei ibidi ku nseke ibidi ya tshilulu tshia ha tshiadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.16",
            "verseOrgIds": [
              "EXO.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabuesha tukanu tua or tuhindakana mu nkanu ibidi yakadi ku nseke ya tshilulu tshia ha tshiadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.17",
            "verseOrgIds": [
              "EXO.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baketeka nsonga ibidi mikuabo ya tukanu tuhindakana mu masoso abidi, nunku bakatuteka ha bilulu bia efoda bia ha maha ku mpala kua tshilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.18",
            "verseOrgIds": [
              "EXO.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza nkanu ya or ibidi bakayiteka ku luseke lua tshilulu tshia ha tshiadi luakadi lutuangane ne efoda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.19",
            "verseOrgIds": [
              "EXO.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza nkanu ya or ibidi, bakayiteka muinshi mua bilulu bia ha maha, ku mpala kuabi ne ku mutu kua mukaba muimpe wa efoda ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.20",
            "verseOrgIds": [
              "EXO.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasanka tshilulu tshia ha tshiadi ne nkanu yatshi ku nkanu ya efoda ne muonshi wa bleu muhindakana tshilulu etshi tshiakashala hehi ne mukaba wa efoda, kabakatshisulula, bu muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza tshikowelu tshia efoda ne buanda bua bleu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.22",
            "verseOrgIds": [
              "EXO.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakashiya disoso bua kubueshamu mutu, bakanyunguluka disoso ne muonshi muhindakana bu mudibo benza tshikowelu tshia nvita, bua tshikowelu katshihandiki nansha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakafunda bifuanyikishi bia tumuma tukese tua grenade ne buanda bua bleu ne bukunzubile ne bukunze-kunzû kuinshi kua tshikowelu tshionso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza ndibu ya or nkayandi, bakateka ndibu hankatshi ha tumuma tuakadi kuinshi kua tshikowelu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadibu ne kamuma kadibu ne kamuma kuinshi kua tshikowelu tshia kuenza nʼatshi mudimu, bu muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenzela Alona ne bana bandi balume bikowelu bia lin, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bifulu bia lin, ne bilulu bikuabo bia ha mutu, ne mihanu ya lin, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mukaba wa lin ne bilulu bia bleu ne bikunzubile ne bikunze-kunzû, mudimu wa bantu ba lungenyi lule, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakenza tshitotolo tshia tshijila tshia tshiamu tshia or, bakafundahu bu muakafundabo ha mabue ne, TSHINTU TSHIJIDILA KUDI YEHOWA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatekahu muonshi wa bleu muhindakana, bakatshisuika ha tshilulu, bu muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
