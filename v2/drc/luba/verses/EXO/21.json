          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biahuoleye dinu dia muhika wandi mulume anyi muhika wandi mukashi, yeye neamumushe ku buhika buandi bualu bua dinu diandi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
