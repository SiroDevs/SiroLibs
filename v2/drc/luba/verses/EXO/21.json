          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bikala ngombe muikale ne tshilele tshia kukuma bantu nsengu, ne bakamanyisha mukelenge wandi, ne yeye wakahidia kumukanda, biashiheye nansha mulume nansha mukashi, nebakume ngombe ne mabue, nebashihe mukelenge wandi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
