        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Boaza wakaya ku tshilumbuluidi tshia ku tshibi tshia musoko, wakashikamaku, ne monai, muena tshiota au wakamba Boaza wakahitaku wakamuambila ne, Mulumiana, lua somba aha Yeye wakahuka, wakashikama. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.1",
            "verseOrgIds": [
              "RUT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabikila bakulu ba mu musoko dikumi, wakabambila ne, Shikamai bienu Bobo bakashikama. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakambila muena tshiota ne, Naomi, nguakafuma mu buloba bua Moaba udi uhana tshituha tshia buloba tshiakadi tshia muanʼetu, Elimeleke; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakuelangana meji bua kukuambila bualu ebu ku matshu ne, Wewe utshisumbe ku mpala kua bantu badi bashikama aha, ne ku mpala kua bakulu banyi. Biwasua kutshihikula, utshihikule, kadi biwahidia kutshihikula hashishe ngambilaku meme mmanye, bualu bua kakuena mukuabo wa kutshihikula, ne meme ndi nkulonda. Yeye wakamba ne, Nentshihikule. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Boaza wakamba ne, Dituku diudi usumba budimi abu ku tshianza tshia Naomi, budi nʼabu mbua kubusumba kudi Luta, muena Moaba, kabidi, mukashi wa mufu, bua kuhingisha dina dia mufu au ku buhianyi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muena tshiota wakamba ne, Tshiena mua kudihikuilatshi, bingenza nunku, nenyange buhianyi buanyi, utshihikule wewe muine, bualu bua tshiena mua kutshihikula.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshilele etshi tshiakadi mu Isalele mu tshikondo tshia ku mpala tshia kuhikula kua bintu ne tshia kushintakasha kua bintu, bua kujadikabo malu onso muntu wakadi umusha tshisabata tshiandi, wakatshiha mukuandi etshi tshiakadi tshilele tshia kujadikabo bualu mu Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku muena tshiota wakambila Boaza ne, Udisumbiletshi Yeye wakumusha tshisabata tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boaza wakambila bakulu ne bantu aba bonso ne, Nuenu nudi bamanyi ba bualu lelu ne, Meme nakusumba bintu bionso bia Elimeleke ne bia Kiliona ne bia Malona ku tshianza tshia Naomi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bukuabo, nakasumba Luta Muena Moaba, mukashi wa Malona bu mukashi wanyi, bua kuhingisha dina dia mufu ku buhianyi buandi, bua dina dia mufu kadijiminyi mu nkatshi mua bana babo ne ku tshibi tshia muaba wandi nudi bamanyi ba bualu ebu lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso bakadi ku tshibi ne bakulu kabidi bakamba ne Tudi bamanyi Yehowa avuishe mukashi eu wakalua mu nsubu muebe bu Lakele ne Lea, bubidi buabo bakibaka nsubu wa Isalele, wenze biebe malu a kanemu mu Efelata, wikale ne butumbi mu Beteleheme; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba mu nsubu webe bikale bu ba mu nsubu wa Pelese, nguakalelela Tama Yuda, bua bana badi Yehowa ukulelesha ne nsongakashi eu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Boaza wakangata Luta bu mukashi wandi, yeye wakaya ku diye ne Yehowa wakamuimitshisha difu, wakamulelela muana wa balume. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashi bakambila Naomi ne, Yehowa, udi kayi mukushiye kuyi ne muena tshiota, asanlashibue, dina diandi ditumbishibue mu Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neikale kûdi bu musangalashi wa muoyo ne bu mudishi wa mu bununu buebe, bualu bua mamuen ebe, udi mukusue, udi muhite bana ba balume muanda mutekete buimpe kûdi, nguakamulela. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi wakangata muana, wakamuladika mu tshiadi tshiandi, wakalua ndeshi wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashi, bena mutumba nʼandi, bakamuidika dina, bamba ne, Bakalelela Naomi muana, bakamuidika dina ne, Obeda, nyeye udi tatu wa Yishai, tatu wa Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei ndelanganyi ya Pelese: Pelese wakalela Heselona, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Heselona wakalela Lama, ne Lama wakalela Aminadaba, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Aminadaba wakalela Nashona, ne Nashona wakalela Salamona, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Salamona wakalela Boaza, ne Boaza wakalela Obeda, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.21",
            "verseOrgIds": [
              "RUT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Obeda wakalela Yishai, ne Yishai wakalela Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.22",
            "verseOrgIds": [
              "RUT.4.22"
            ]
          }
        }
      ]
