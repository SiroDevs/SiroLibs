        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshibidi tshia mukelenge Dayawesha, mu ngondo muisambombo, mu dituku dia kumudidi dia ngondo, dî dia Yehowa diakalua mukana mua muprofete Hagai kudi Zelubabela, muana wa Shalatiele, gouverneur wa mu Yuda, ne kudi Yoshua, muana wa Yehosadaka, muakuidi wa ha mutu ha bakuabo, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diakamba ne, Yehowa wa misumba udi wamba ne, Bantu aba badi bamba ne, Tshikondo kantshianze kulua bua kuibaka nsubu wa Yehowa kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu diba adi dî dia Yehowa diakalua mukana mua muprofete Hagai ne, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etshi ntshikondo tshia nuenu bine kushikama mu nsuhu yenu idi ne mabaya malamike munda muai, hatshidi nsubu eu ushala munyanguke, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mpindiu Yehowa wa misumba udi wamba ne, Elanganai meji a bienzedi bienu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakukuna bintu bia bungi, nuakuhuola bintu bibalê; nudi nudia, kadi kanuena mua kukuta; nudi nunua, kadi kanuena mua kukuta ne binudi nunua; nudi nudiluatshisha bilulu, kadi kanuena mua kuota nʼabi; ne muntu udi wangata difutu ku mudimu wandi udi udiangata bua kuditeka mu tshibombi tshidi tshitubuke.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba udi wamba ne, Elanganai meji a bienzedi bienu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandai ku buloba bua mu mikuna, hinganai ne mabaya, ibakai nsubu eu; ne meme nensanke nʼandi ne nentumbishibuemu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakutekemena bia kudia bia bungi, ne monai, biakadi anu bibalê; hanuakulua nʼabi kuenu, nakubihehuka! Bualu kai? Edi ndikonka dia Yehowa wa misumba. Mbualu bua nsubu wanyi udi mulale munyanguke, hanudi nunyema, muntu ne muntu, ku nsubu kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua muanda eu diulu didi ha mutu henu didi dikanda dibungi, ne buloba hudi bukanda kuvudisha kuabu kua bia kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabikila munanga bua kulua mu buloba, ne ha mikuna ne ha maminu ne ha nvinyo ne ha manyi, ne ha bintu bionso bidi buloba bulua nʼabi; ne kudi bantu ne nyama, ne ku midimu yonso ya ku bianza biabo.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Zelubabela, muana wa Shalatiele, ne Yoshua, muana wa Yehosadaka, muakuidi wa ha mutu ha bakuabo, ne bantu bonso bakadi bashala, bakatumikila dî dia Nzambi wabo, ne mei a muprofete Hagai, bualu bua Yehowa Nzambi wabo, wakamutuma; ne bantu bakadi batshina ku mpala kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Hagai, muena mukenji wa Yehowa, wakambila bantu dî dia Yehowa diakabatumineye ne, Yehowa udi wamba ne, Meme ndi nʼenu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakasonsola mutshima wa Zelubabela, muana wa Shalatiele, gouverneur wa mu Yuda, ne mutshima wa Yoshua, muana wa Yehosadaka, muakuidi wa ha mutu ha bakuabo, ne mitshima ya bantu bonso bakadi bashala, ne bua muanda eu bakalua ne bakabanga mudimu wa ku nsuhu wa Yehowa wa misumba, Nzambi wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu dituku dia makumi abidi ne anai dia ngondo muisambombo, mu tshidimu tshibidi tshia bukokeshi bua mukelenge Dayawesha.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
        }
      ]
    }
  ],
