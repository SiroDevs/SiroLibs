    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakadi ku mutu kua nsubu ya batatuʼabo ba diku dia Bena Gilada, muana mulume wa Makî, muana mulume wa Manashe, wa meku a bana balume ba Yosefe, bakalua kudi Mose ne kudi bakelenge ba ku mutu kua nsubu ya batatuʼabo ba mu Isalele, bakamba ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakela dî kudi mukelenge wetu bua kutahulula buloba bua buhianyi ku nshobo, Yehowa wakela dî kudi mukelenge wetu kabidi bua kuha buhianyi bua Selofehada muanʼetu mulume kudi bana bandi bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikalabo babakibue kudi balume ba mu tshisamba tshikuabo tshia Bena Isalele, nunku nebanyeme buhianyi buabo ku buhianyi bua batatuʼetu, nebabusangishe ku buhianyi bua tshisamba tshiakayabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.3",
            "verseOrgIds": [
              "NUM.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku halua tshidimu tshia disanka dia Bena Isalele, buhianyi buabo nebusangishibue ku buhianyi bua tshisamba tshiakayabo, nunku buhianyi buabo nebumuke ku buhianyi bua batatuʼetu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila Bena Isalele bu mu dî dia Yehowa ne, Ba mu tshisamba tshia bana balume ba Yosefe badi bamba dî dilelela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi ndî diakamba Yehowa bualu bua bana bakashi ba Selofehada ne, Bobo babakibue kudi balume hadibo basue, kadi babakibue kudi balume ba mu meku a tshisamba tshia batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku buhianyi bua Bena Isalele kabuena bumuka ku tshisamba ne ku tshisamba, muntu ne muntu wa munkatshi mua Bena Isalele neashale ne buhianyi bua tshisamba tshia batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana mukashi yonso udi ne buhianyi munkatshi mua Bena Isalele, neikale mukashi wa umue wa mu tshisamba tshia tatuʼandi, nunku muntu ne muntu wa Bena Isalele neikale ne buhianyi bua batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku buhianyi bumue kabuena bumuka ku tshisamba ne ku tshisamba, tshisamba ne tshisamba tshia Bena Isalele netshikale ne buhianyi buatshi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana bakashi ba Selofehada bakenza muakambila Yehowa Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua Mahala ne Tîza ne Hogela ne Mileka ne Noa, bana bakashi ba Selofehada, bakadi babakibua kudi bana balume bakadi bana babo ne tatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.11",
            "verseOrgIds": [
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakadi babakibua kudi ba mu meku a bana balume ba Manashe, muana mulume wa Yosefe, buhianyi buabo buakashala mu tshisamba tshia meku a tatuʼabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
