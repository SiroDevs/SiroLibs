          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au mmei ne mikenji bakambila Yehowa Bena Isalele mukana mua Mose mu mpata ya Moaba hehi ne Yadene mitangilangane ne Yeleko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        }
      ]
