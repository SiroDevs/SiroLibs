        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
