          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eu udi mukenji wa Munazi udi uditshiha, ne mulambu wa tshijila tshiandi kudi Yehowa, ha mutu ha bintu bidiye mumanye mua kufila bu kuditshiha kuakaditshiheye nʼaku mbudiye nʼabu mbua kuenza bu mudi mukenji wa tshijila tshiandi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
