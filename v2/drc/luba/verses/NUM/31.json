              "type": "text"
            },
            {
              "text": "Tangila Nomba 3.47",
              "type": "text"
            }
          ]
        },
        {
          "text": " binunu dikumi ne bisambombo ne nkama muanda mutekete ne makumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bualu bua bena nvita bonso bakadiangatshila bintu mundi ne mundi.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ne Eleazâ muakuidi bakangata or ya tuhita tua binunu ne binunu ne tuhita tua nkama ne nkama, bakalua nʼai mu ntenta wa kusambakena bu tshivulukidi tshia Bena Isalele ku mesu kua Yehowa.",
          "type": "text",
