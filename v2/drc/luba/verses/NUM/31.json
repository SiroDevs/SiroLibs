  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "NUM 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa Wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usombuele Bena Isalele bualu bua Bena Midiyana, ku nyima wewe neusangakene ne bankambua bebe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila bantu ne, Bena nvita badi munkatshi muenu bangate bintu bia nvita bualu bua kushikisha dikenga didi Yehowa musue kusombuela nʼadi Bena Midiyana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshisamba ne tshisamba tô ne bisamba bionso bia Bena Isalele nebitume bantu tshinunu ku nvita. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakasangisha ku bisamba bionso bia Bena Isalele bantu tshinunu ku tshisamba, bantu tshinunu ku tshisamba, bena nvita binunu dikumi ne bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.5",
            "verseOrgIds": [
              "NUM.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakabatuma ku nvita, bantu tshinunu ku tshisamba ku tshisamba, Pinehasa, muana mulume wa Eleazâ muakuidi, wakaya nʼabo ne bintu bikuabo bia mu nsubu wa tshitendelelu ne mpungi ya kuela nʼai dî dikole mu tshianza tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaluangana ne Bena Midiyana bu muakambila Yehowa Mose, bakashiha balume bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashiha bakelenge ba mu Midiyana kabidi: Evi ne Lekeme ne Sû ne Hû ne Leba bakelenge batanu ba Midiyana bakashiha Belama, muana mulume wa Beô, ne muele wa nvita kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakaya ne bakashi ba Bena Midiyana ne bana babo bakese, bakangata kabidi bimuna biabo ne bisumbu bia mikoko ne bintu biabo bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.9",
            "verseOrgIds": [
              "NUM.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakosha misoko yabo yakadibo bashikamamu ne bitudilu biabo ne kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.10",
            "verseOrgIds": [
              "NUM.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakangata bintu bionso bia bantu ne bia bimuna kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.11",
            "verseOrgIds": [
              "NUM.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalua ne bantu bakakuatabo ne bintu biabo bionso kudi Mose ne kudi Eleazâ muakuidi ne kudi tshisumbu tshionso tshia Bena Isalele, ku tshitudilu tshiakadi mu mpata ya Moaba, hehi ne Yadene ku Yeleko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ne Eleazâ muakuidi ne bakelenge bonso ba mu tshisumbu bakaya bua kusangakena nʼabo ku butshika bua tshitudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.13",
            "verseOrgIds": [
              "NUM.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakadi ne tshiji kudi ba ku mutu kua bena nvita, tuhita tua binunu binunu ne tuhita tua nkama nkama, bakahingana ku nvita. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakabambila ne, Nuakushiya bakashi bonso ne muoyo, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.15",
            "verseOrgIds": [
              "NUM.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, bobo bakenzesha Bena Isalele bua kuenzabo malu mabi kudi Yehowa bualu bua dî dia Belâma mu bualu bua Peô, nunku dikenga dikole diakadi munkatshi mua bantu ba Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nushale bana ba balume bakese bonso badi munkatshi muabo ne mukashi yonso ukadi mumanyibue kudi mulume. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.17",
            "verseOrgIds": [
              "NUM.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bana ba bakashi badi kabayi banze kumanyibua kudi balume nubashiye ne muoyo bualu buenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nushikame ku butshika bua tshitudilu matuku muanda mutekete, muntu yonso wakashiha mundi mukuabo, anyi wakalenga muntu mufue tshianza, adilengeshe ku dituku disatu ne dituku dia muanda mutekete ne nuenu ne bantu banuakukuata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.19",
            "verseOrgIds": [
              "NUM.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bilulu, ne bintu bionso biakenzabo ne biseba, ne bintu bionso biakenzabo ne miosa ya mbushi, ne bintu bionso biakenzabo ne mabaya, nenudilengeshe bua bintu ebi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazâ muakudi wakambila bena nvita bakaya mu nvita ne, Eu udi mukenji wakela Yehowa kudi Mose: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi or ne argent ne tshiamu tshia mitaku ne tshiamu tshifike ne tshiamu tshia étain ne tshia plomb ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.22",
            "verseOrgIds": [
              "NUM.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne tshintu tshionso tshidi katshiyi tshitua mu kahia, nenutshiteke mu kahia bua kutshilengesha, kadi nenutshilengeshe ne mai adibo balengesha nʼau bintu, bintu bionso bidi bihia mu kahia nenubilengeshe mu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.23",
            "verseOrgIds": [
              "NUM.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuvuwe bilulu dituku dia muanda mutekete, nenubale bakane, ku nyima nenuhingane mu tshitudilu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubale bungi bua bintu biakangatabo ne bia bantu ne bia bimuna, ne wewe ne Eleazâ muakuidi ne ba ku mutu kua nsubu ya batatuʼabo mu Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.26",
            "verseOrgIds": [
              "NUM.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutahulule bintu bituha bibidi, tshituha kudi bena nvita bakaya mu nvita ne tshikuabo kudi tshisumbu tshionso tshia Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.27",
            "verseOrgIds": [
              "NUM.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuangate kabidi mulambu wa Yehowa kudi bantu bakaya mu nvita mundi umue ku bantu nkama itanu, ne umue wa ngombe ne wa nyama wa mpunda ne wa mikoko kabidi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
              "NUM.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nutshiangate kudi tshituha tshiabo, nutshine kudi Eleazâ muakuidi bu mulambu udibo banyukula kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshituha tshia Bena Isalele nenuangate umue kudi makumi atanu, wa bantu ne wa ngombe ne wa nyama wa mpunda ne wa mikoko, nubifile kudi Bena Lewi badi balama nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ne Eleazâ bakenza muakambila Yehowa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
