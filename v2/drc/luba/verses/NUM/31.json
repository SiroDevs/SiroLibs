              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "(tshituha tshiabo tshiakadi mikoko binu nu nkama isatu ne makumi asatu ne muanda mutekete ne nkama itanu, ",
          "type": "text",
          "attrs": {
