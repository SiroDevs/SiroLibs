        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku dinudi nuhuola bintu bia kumudilu, hanuafila mulambu wa bukula buhia-buhia kudi Yehowa, nenuikale ne disangisha dia tshijila, kanuenji mudimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "hadi nenufile mulambu wa kuosha ha kahia udi utua dihembu kudi Yehowa bana balume ba ngombe babidi ne tshimpanga tshimue ne bana balume ba mikoko muanda mutekete ba tshidimu tshimue, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
