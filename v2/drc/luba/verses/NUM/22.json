          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dinda Balaka wakaya ne Belâma ku mutu kua mikuna ya Bâla; yeye wakatangila tô ne ku matshika onso a tshitudilu tshia bantu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
        }
      ]
