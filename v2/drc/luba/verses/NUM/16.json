          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikisheye kubambila mei a onso, buloba buakahandika muinshi mua makasa abo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "buloba buakubulula mukana muabu, buakabamina ne bantu bonso ba mu nsubu yabo ne bantu bonso bakalamata Kola ne bintu biabo bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bobo ne bantu bonso bakalamata kudibo bakaya mu Muaba wa Bafue hakadibo ne muoyo, ne buloba buakabuikila mukana muabu ku mutu kuabo, ne bobo biakajimina munkatshi mua tshisumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bonso bakadi ha buihi habo bakanyema hakunvuabo muadi wabo, bobo bakamba ne, Buloba kabutuminyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahia bakahatuka kudi Yehowa, kakosha balume nkama ibidi ne makumi atanu bakadi bafila musenga wa manananshi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
