  "copyright": "PUBLIC DOMAIN",
  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "NUM 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kola, muana mulume wa Yiseha, muana mulume wa Kohata, muana mulume wa Lewi, ne Datana ne Abilama, bana balume ba Eliaba, ne Ono, muana mulume wa Pelete, bana balume ba Lubena, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.1",
            "verseOrgIds": [
              "NUM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabika ne Bena Isalele bakuabo ne bakelenge ba mu tshisumbu bu nkama ibidi ne makumi atanu, bantu bakadi ne lumu lunene, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.2",
            "verseOrgIds": [
              "NUM.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakadisangisha bua kufuilangana ne Mose ne Alona, bakabambila ne, Nudi nutamba kudienzela malu, bualu bua bantu bonso mbantu ba tshijila ne Yehowa udi munkatshi muabo nuenu nudi nudibandisha ku mutu kua bantu ba Yehowa munyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.3",
            "verseOrgIds": [
              "NUM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Mose dî edi, yeye wa kakuma mpala hanshi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.4",
            "verseOrgIds": [
              "NUM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakambila Kola ne bakadiye habo ne, Dinda Yehowa neadileshe bantu bandi, ne nganyi udi wa tshijila, neamubikile ku mpala kuandi, neabifile wasunguleye ku mpala kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.5",
            "verseOrgIds": [
              "NUM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenze bienu nunku Kola ne bantu hadiye habo bangate malonga a kahia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.6",
            "verseOrgIds": [
              "NUM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "batekemu kahia, batekehu musenga wa manananshi ku mpala kua Yehowa makelela, ne muntu udi musungudibue kudi Yehowa neikale muntu wa tshijila, nuenu bana balume ba Lewi nudi nutamba kudienzela malu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.7",
            "verseOrgIds": [
              "NUM.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila Kola ne, Unvuai, bana balume ba Lewi: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.8",
            "verseOrgIds": [
              "NUM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nudi nuelangana meji ne bualu ebu budi bukese bua Nzambi wa Isalele wakamujidila munkatshi mua Bena Isalele, bua nuenu nulue ha buihi nʼandi kumukuatshia mudimu mu nsubu wa Yehowa, ne bua kukuatshila tshisumbu tshonso mudimu kabidi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.9",
            "verseOrgIds": [
              "NUM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye wakanuhatula ne bana benu bonso ba Lewi ha buihi nʼandi, nuenu nudi nudikebela mudimu wa buakuidi kabidi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.10",
            "verseOrgIds": [
              "NUM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe ne bantu baudi nʼabo nuakudisangisha bua kuelangana ne Yehowa! Alona udi nganyi bua nuenu nudi numutontolola?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakabikila Datana ne Abilama, bana balume ba Eliaba, ne bobo bakamba ne, Katuena tulua, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.12",
            "verseOrgIds": [
              "NUM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu budi bukese bua wewe wakumuka nʼetu mu buloba budi bûle tente ne mabele ne buitshi bua kubishiha mu tshihela, udi musue kudibandisha bu mukelenge wetu kabidi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.13",
            "verseOrgIds": [
              "NUM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bukuabo, wewe kuena muanze kulua nʼetu mu buloba budi bûle tente ne mabele ne buitshi, kuena mutuhe buhianyi bua madimi ne madimi a tumuma, udi musue kuvuisha bantu aba bafofo, anyi? Katuena tulua.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakadi ne tshiji tshikole ne yeye wakambila Yehowa ne, Kuitabusha milambu yabo nansha, meme tshiakunyenga umue wabo nyama wandi wa mpunda, tshiakuenzela umue wabo bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.15",
            "verseOrgIds": [
              "NUM.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakambila Kola ne, Wewe ne bantu bonso baudi habo nuikale ku mpala kua Yehowa ne kua Alona makelela: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.16",
            "verseOrgIds": [
              "NUM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundi yonso angate dilonga diandi dia kahia, atekehu musenga wa manananshi, bantu bonso balue ne malonga nkama ibidi ne makumi atanu ku mpala kua Yehowa, ne wewe ne Alona, mundi ne dilonga diandi mundi ne dilonga diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.17",
            "verseOrgIds": [
              "NUM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso wakangata dilonga diandi, wakatekamu kahia, wakatekahu musenga wa manananshi, bakimana ne Mose ne Alona ku mbelu kua nsubu wa tshitendelelu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.18",
            "verseOrgIds": [
              "NUM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kola wakabikila tshisumbu tshonso tshia batomboki ku mbelu kua nsubu wa tshitendelelu, ne butumbi bua Yehowa buakamueneka kudi tshisumbu tshonso.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne Alona ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.20",
            "verseOrgIds": [
              "NUM.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukai bienu munkatshi mua tshisumbu etshi, nembashihe mu tshituha tshikese. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakadikuma hanshi, bakamba ne, Nzambi, Nzambi wa mioyo ya bantu, wewe newikale ne tshisumbu tshonso tshiji bua bubi bua mundi umue, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.23",
            "verseOrgIds": [
              "NUM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile tshisumbu tshonso ne, Umukai ku nsubu wa tshitendelelu wa Kola ne Datana ne Abilama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakabika, wakaya kudi Datana ne Abilama, ne bakulu ba mu Isalele bakamulonda ku nyima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakambila tshisumbu tshia bantu ne, Umukai, ndi nnusengelela, ku ntenta ya bantu aba babi, kanulengi tshintu tshiabo tshianza, kabanushihi bua mibi yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.26",
            "verseOrgIds": [
              "NUM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakumuka ku nsubu wa tshitendelelu wa Kola ne Datana ne Abalama ku nseke yonso: ne Datana ne Abilama bakaluhuka, bakimana ku mbelu kua ntenta yabo ne bakashi babo ne bana babo balume ne bana babo bakese. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakamba ne, Nenumanye ne Yehowa wakatuma bua kuenza malu au onso, tshiakadienzela bualu bua mutshima wanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biafila balume aba bu mudi bantu bonso bafue, anyi biabakuata bualu bu mudibu bukuata bantu bonso, nunku Yehowa kena muntume. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bikala Yehowa wenza bualu buhia-buhia, ne buloba bubulula mukana muabu bubamina ne bantu bonso hadibo nʼabo, ne bobo baya ku Muaba wa Bafue hatshidibo ne muoyo, nunku nenumanye ne bantu aba bakalengulula Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
