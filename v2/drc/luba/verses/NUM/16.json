        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
