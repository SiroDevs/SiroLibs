        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ne Alona bakangata balume aba bakabikilabo ku mena abo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakasangisha tshisumbu tshionso tshia Bena Isalele ku dituku dia kumudilu dia ngondo muibidi, bakababadila milongo ya bankambua babo ku meku abo, ku nsubu ya batatuʼabo, bungi bua mena abo ku bidimu makumi abidi tô ne ha mutu, muntu ne muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu muakambila Yehowa Mose, wakababadila mu tshihela tshia Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
