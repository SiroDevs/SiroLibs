          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba Lubena, muanʼa bute wa Isalele, ku bikondo biabo, ku meku abo, ku nsubu ya batatuʼabo, bungi bua mena abo muntu ne muntu, ku bidimu makumi abidi tô ne ha mutu balume bonso bakamanya mua kuya mu nvita, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabala ba mu tshisamba tshia Lubena binunu makami anai ne bisambombo ne nkama itanu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
