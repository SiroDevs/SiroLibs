          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kabakabala Bena Lewi munkatshi muabo ku tshisamba tshia batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
