          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshisamba tshia Gada, Eleyasafa muana mulume wa Luele neikale mukelenge wa bana ba Gada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
