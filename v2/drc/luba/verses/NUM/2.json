          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bandi bakamubadilabo bakadi binunu makumi anai ne bisambombo ne nkama itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
