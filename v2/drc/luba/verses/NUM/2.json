              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu ba mu tshisamba tshia Shimeona nebashikame hehi nʼandi Shelumiele muana mulume wa Sulishadai neikale mukelenge wa bana ba Shimeona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
