          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bandi bakamubadilabo bakadi binunu makumi anai ne bitanu ne nkama isambombo ne makumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
