              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bandi bakamubadilabo bakadi binunu makumi atanu ne tshitema ne nkama isatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
