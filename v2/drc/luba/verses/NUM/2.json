          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kabakabala Bena Lewi munkatshi mua Bena Isalele, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
              "NUM.2.33"
            ]
          }
        },
        {
