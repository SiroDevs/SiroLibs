          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Lubena bakasa Heshebona ne Eleale ne Kiyatayima, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
