          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yai muana mulume wa Manashe wakaya wakanyenga misoko mikuabo wakayidika ne, Hawota-yai (misoko ya Yai). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
