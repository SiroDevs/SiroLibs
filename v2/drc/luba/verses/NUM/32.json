          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Maki muana mulume wa Manashe bakaya ku Gilada, bakihata Bena Amole bakadimu bakanyenga musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
