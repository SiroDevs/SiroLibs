          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Betenimela ne Betehalana, misoko yakadi ne mpangu ya mabue, ne mpangu ya mikoko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
