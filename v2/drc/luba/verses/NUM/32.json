          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netusabuke ne bintu bia nvita ku mesu kua Yehowa mu buloba bua Kanâna, netuikale ne buhianyi buetu dishiya dia munemu dia Yadene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
