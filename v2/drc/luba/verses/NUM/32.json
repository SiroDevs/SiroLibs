          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Nebo ne Bâla-meona (bakidika misoko ei mena mahia-mahia) ne Sibema; bakidika misoko mikuabo yakasabo mena mahia-mahia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
