          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalota shofana ne Yazê ne Yogebeha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
