      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi mbikondo bia Alona ne Mose mu dituku diakasomba Yehowa ne Mose mu mukuna wa Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.1",
            "verseOrgIds": [
              "NUM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au mmena a bana ba balume ba Alona Nadaba muanʼa bute ne Abihu ne Eleazâ ne Itamâ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au mmena a bana ba balume ba Alona bakuidi bakadi ne manyi mela ha mitu, bakajidilabo bua kuenza mudimu wa buakuidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.3",
            "verseOrgIds": [
              "NUM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadaba ne Abihu bakafua ku mpala kua Yehowa, hakaluabo ne kahia kakadi kakayi kajidila ku mpala kua Yehowa, mu tshihela tshia Sinai, bobo kabakadi ne bana, ne Eleazâ ne Itamâ bakenza mudimu wa buakuidi ku mesu kua Alona tatuʼabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulue biebe ne tshisamba tshia Lewi, ubateke ku mpala kua Alona muakuidi, bua bobo bamuenzele mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo nebalame bintu biandi ne bintu bia bantu bonso ku mpala kua ntenta wa kusambakena, bua kuenzelabo mudimu wa mu nsubu wa tshitendelelu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo nebalame bintu bia mu nsubu wa tshitendelelu, ne bintu bia Bena Isalele, bua kuenzelabo mudimu wa mu ntenta wa kusambakena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neufue Bena Lewi kudi Alona ne kudi bana bandi balume bobo badi bafidibue kudi Alona, bua kukuatshishabo Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neusungule Alona ne bana bandi balume, ne bobo nebashale ne mudimu wa buakuidi, bialua muenyi ha buihi nebamushihe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
