          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalela Âpakashada Shela, yeye wakashala ne muoyo bidimu nkama mai ne bidimu bisatu, wakalela bana balume ne bana bakashi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
