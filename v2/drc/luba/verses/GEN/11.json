          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Âpakashada wakashala ne muoyo bidimu makumi asatu ne bitanu, wakalela Shela ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
