  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "GEN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku a Amalafele, mukelenge wa Shinâ, ne Ayoka, mukelenge wa Elasa, ne Kedôlaome, mukelenge wa Elama, ne Tidala, mukelenge wa Goyima, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.1",
            "verseOrgIds": [
              "GEN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakaluangana nvita ne Bela, mukelenge wa Sodoma, ne Bisha, mukelenge wa Amola, ne Shinaba, mukelenge wa Adema, ne Shemebê, mukelenge wa Bena Seboi, ne mukelenge wa Belê (eu udi Soâ). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu aba bonso bakadisangisha mu tshibanda tshia Sidima (etshi ntshibanda tshia Dishiba dia Mai a Luehu). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalamata Kedolaomê to bidimu dikumi ne bibidi, ne mu tshidimu tshia dikumi ne bisatu, bakatomboka ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia dikumi ne binai Kedôlaome wakalua ne bakelenge bakadi nʼandi, bakahita Bena Lefa ba mu Ashelota kânayima bukole, ne Bena Zusa ba mu Hama, ne Bena Eme ba mu Shawe kiyatayima, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Bena Holi ba ku mikuna ya Sei to ne ku Ele-palana, hehi ne tshihela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakahingana, bakalua ku Ene-mishapata (eu udi Kadesha), bakahaula buloba buonso bua Bena Amaleka ne Bena Amole bakadi bashikama mu Hasasona-tamâ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Sodoma ne mukelenge wa Amole ne mukelenge wa Adema ne mukelenge wa Bena Seboi ne mukelenge wa Bela (eu udi Soa) bakaluhuka, bakaluangana nʼabo mu tshibanda tshia Sidima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.8",
            "verseOrgIds": [
              "GEN.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaluangana ne Kedolaomê, mukelenge wa Elama, ne Tidala, mukelenge wa Goyima, ne Amalafele, mukelenge wa Shinâ, ne Aliyoka, mukelenge wa Elasa, ku luseke lukuabo bakelenge banai, ku luseke lukuabo batanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.9",
            "verseOrgIds": [
              "GEN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshibanda tshia Sidima tshiakadi tshiule tente ne bina bia bitume",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14.10",
              "type": "text"
            },
            {
              "text": "Tangila Genese 11.3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne bakelenge ba Sodoma ne Amola bakanyema, bakahonamu, bakuabo bakashala bakanyemena ku mukuna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.10",
            "verseOrgIds": [
              "GEN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakahaula biuma bionso bia mu Sodoma ne Amola ne bintu bia kudia, bakaya mu nshila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.11",
            "verseOrgIds": [
              "GEN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakuata Lota, muana wa muanʼabo ne Abalama, wakadi ushikama mu Sodoma, ne bintu biandi bionso, bakaya nʼabi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakadi muhanduke mu bianza biabo wakaya, wakamanyisha Abalama, Muena Ebelu, wakadi ushikama hehi ne mitshi ya telebinta ya Mamale, muena Amole, muanʼabo ne Eshekola, muanʼabo ne Ane, bobo bakalamatangana ne Abalama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.13",
            "verseOrgIds": [
              "GEN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Abalama lumu ne, Bakaya ne muanʼetu, yeye wakaya ne bahika bandi bakadiye mueyemene bakadi baledibue mu nsubu muandi, nkama isatu ne dikumi ne muanda mukulu, wakabihata to ne ku Dana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalama wakatahulula bantu bandi, wakatuangana nʼabo butuku, yeye ne bahika bandi bakabatamba bukole, wakabihata to ne ku Hoba, udi ku tshianza tshia bakashi tshia Damaseke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahingana ne biuma biabo bionso ne muanʼabo Lota, ne bintu biandi ne bakashi ne bantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Sodoma wakaluhuka bua kumuakidila hakahinganeye ku dishiha dia Kedolaome ne bakelenge bakadi nʼandi, mu tshibanda tshia Shawe (etshi ntshibanda tshia Bakelenge). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
              "GEN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melekisedeke, mukelenge wa Salema, wakalua ne mampa ne nvinyo. Yeye wakadi muakuidi wa Nzambi Mutambe Bunene wa mu Diulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuvudishila disanka, wakamba ne, Nzambi Mutambe Bunene wa mu Diulu, mufuki wa diulu ne buloba asankishe Abalama, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Nzambi Mutambe Bunene wa mu Diulu, wakafua bena lukuna bebe mu tshianza tshiebe, atumbishibue Abalama wakamuha tshia dikumi tshia bintu bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Sodoma wakambila Abalama ne, Umpe bantu, wewe wangate biuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalama wakambila mukelenge wa Sodoma ne, Nakamana kubisha tshianza tshianyi bua kuditshiha kudi Yehowa, Nzambi Mutambe Bunene wa mu Diulu, mufuki wa diulu ne buloba, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne, Tshiena ngangata nansha nshinga nansha muonshi wa bisabata nansha kantu kebe kamue, bua wewe kuambi ne, Nakavuisha Abalama bubanji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.23",
            "verseOrgIds": [
              "GEN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu bintu bia kudia bia bansongalume ne bia bantu bakaya nʼanyi, Anê ne Eshekola ne Mamale, bobo bangate tshituha tshiabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.24",
            "verseOrgIds": [
              "GEN.14.24"
            ]
          }
        }
      ]
    }
  ],
