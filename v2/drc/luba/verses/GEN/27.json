  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "GEN 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku dikuabo hakadi Isaka muntu mununu ne mesu andi akadi bileshileshi, kakamanya mua kutangila bimpe, yeye Wakabikila Esau muanʼandi, muanʼa bute, wa kamuambila ne, Muan anyi Yeye wakitaba ne, Ndiku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wa kamba ne, Tangila, ndi muntu mununu, tshiena mumanye dituku dia lufu luanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.2",
            "verseOrgIds": [
              "GEN.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nkutendekena ne, Wangata bintu biebe bia bule mbi, mukulu wa mikete ne buta buebe, uye mu tshisuku, unkebele ntole ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.3",
            "verseOrgIds": [
              "GEN.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "undambile munyinyi wa dihembu undi musue Ulue nʼau kundi, nengudie, bua mutshima wanyi ukuvudishile disanka diambedi tshiyi muanze kufua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebeka wakunvua bakambila Isaka Esau muanʼandi mei au Esau wakaya mu budimi bua kukebeye ntole, ne bua kuhinganeye nʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.5",
            "verseOrgIds": [
              "GEN.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebeka wakambila Ya koba muanʼandi ne, Tangila, nakunvua tatuʼebe wambila Esau, mukuluʼebe ne, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.6",
            "verseOrgIds": [
              "GEN.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulue kundi ne munyinyi wa ntole, undambile munyinyi muimpe wa dihembu, bua meme ngudie, nkuvudishile disanka ku mpala kua Yehowa diambedi tshiyi muanze kufua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.7",
            "verseOrgIds": [
              "GEN.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku muanʼanyi, utumikile dî dindi nkua mbila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.8",
            "verseOrgIds": [
              "GEN.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya biebe ku tshisumbu tshia mbushi, Ulue kundi ne nku ngulu ya mbushi ibidi idi mimpe, nendambile tatu webe munyinyi muimpe wa dihembu udiye musue. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.9",
            "verseOrgIds": [
              "GEN.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neulue nʼau kudi tatu webe, yeye audie, akuvudishile disanka diambedi yeye kayi muanze kufua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila Lebeka mamuʼandi ne, Tangila, Esau, mukuluʼanyi udi ne miosa ya bungi hamʼbidi bandi kadi meme ndi ne mubidi mutuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.11",
            "verseOrgIds": [
              "GEN.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bumue tatuʼanyi neandengele tshianza, ne meme nengikale bu muena mashimi ku mesu kuandi nendieleshe mulau, tshidivuishi disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamuʼa ndi wakamuambila ne, Mulau webe wikale ha mutu hanyi, muanʼanyi, anji kutumikila di dianyi, Ulue ne nkungulu ya mbushi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.13",
            "verseOrgIds": [
              "GEN.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakaya, wakalua nʼai kudi mamuʼandi, ne mamuʼandi wakalamba munyinyi muimpe wa dihembu bu muakasua tatuʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebeka wakangata bilulu bimpe bia Esau, muanʼandi muanʼa bute, biakadiye nʼabi mu nsubu, wakabiluatshisha Yakoba, muanʼandi muanʼa mukala, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.15",
            "verseOrgIds": [
              "GEN.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamuluatshisha biseba bia nkungulu ya mbushi ha bianza ne ha dikoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.16",
            "verseOrgIds": [
              "GEN.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakateka munyinyi muimpe ne bidia biakalambeye mu bianza bia Yakoba muan andi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakaya kudi tatu andi, wakamba ne, Tatu anyi, ne yeye wakamukudimuna ne, Ndiku wewe udi nganyi, muan anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila tatuʼandi ne, Ndi bianyi Esau, muan ebe muanʼa bute, nakuenza bu mu dî diebe, ndi nkutendekena ne, Bika biebe, ushikame, udie munyinyi wanyi wa ntole, bua mutshima webe unvudishile disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wakebesha muanʼandi ne, Muanʼanyi, wakamona ntole lubilu nunku munyi? Yeye wakamuambila ne, Bualu bua Yehowa Nzambi webe wakungendesha dikasa dimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wakambila Yakoba ne, Ndi nkutendekena ne, Lua ha buihi, nenkulengele tshianza tshianyi, muanʼanyi, nemmanye ne, Wewe udi muanʼanyi Esau bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.21",
            "verseOrgIds": [
              "GEN.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakasemena ha buihi ne Isaka tatuʼandi, yeye wakamulengela tshianza tshiandi, wakamba ne, Dî ndia Yakoba kadi bianza mbia Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kakamujingulula bimpe bualu bua bianza biandi biakadi ne miosa bu bianza bia muanʼabo Esau, nunku yeye waka-muvudishila disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wakamuebesha ne, Wewe udi muanʼanyi Esau bulelela, anyi? Yeye wakamba ne, E. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne Lua nʼau kundi nendie munyinyi wa ntole wa muanʼanyi bua mutshima wanyi ukuvudishile disanka. Yeye wakalua nʼau kudiye, yeye wakadia, wakalua kudiye ne nvinyo, yeye wakanua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatu wandi Isaka wakamuambila ne, Semena ha buihi, muanʼanyi, utuangane nʼanyi mishiku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakasemena ha buihi, wakatuangana nʼandi mishiku, yeye wakanunkila muhuya wa bilulu biandi, wakamuvudishila disanka ne,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikisha Isaka kusankisha Yakoba ne Yakoba mumuke anu tshituha ku mesu kua tatu wandi Isaka, Esau mukulu andi wakahingana kuakadiye muye bua kumukebela nyama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.30",
            "verseOrgIds": [
              "GEN.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakalamba munyinyi muimpe wa dihembu kabidi, wakalua nʼau kudi tatuʼandi, yeye wakambila tatuʼandi ne Tatu anyi abike biandi adie munyinyi wa ntole wa muanʼandi, bua mutshi ma webe unvudishile disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.31",
            "verseOrgIds": [
              "GEN.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka tatu andi wakamukonka ne, Wewe udi nganyi? Yeye wakamukudimuna ne, Ndi muan ebe, muan a bute Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wakatamba kuhampakana, wakamba ne, Muntu kai wakangata munyinyi wa ntole, wakulua nʼau kundi, ne nakudia diambedi wewe kuyi muanji kulua, ne nakamuvudishila disanka? Yeye neikale ne disanka bulelela ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kunvua Esau mei a tatu andi waka dila muadi bikole ne mutshima wandi munyingalala, wakambila tatu andi ne, Unsankishe meme kabidi, tatuʼanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuambila ne, Muakunyʼebe wakulua ne bu dimu wakumana kuangata disanka diebe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Dina dia Yakoba kadiena dimukumbane, anyi? Bualu bua yeye wakandinga misangu ibidi wakamana kuangata bintu bianyi bia buanʼa bute, ne lelu wakangata disanka dianyi kabidi. Yeye wakebesha Isaka ne, Wewe kuakunshilaku disanka, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wakambila Esau ne, Mona, nakumana kumuvuisha mukelenge, webe nakufila bana benu bonso kudiye bu bahika bandi nakumujadika ne manvua ne nvinyo muhiamuhia nenkuenzele wewe tshinyi, muan anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau wakambila tatu andi ne, Wewe udi ne disanka anu dimue, anyi? Unvudishile meme kabidi disanka tatuʼanyi Esau wa kabandisha di diandi wakadila ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka tatu andi wakamuambila ne,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau wakadi ne Yakoba lukuna bualu bua disanka diakamusankisha nʼadi tatu andi Esau wakamba mu mutshima wandi ne, Hashika matuku a madilu a tatu anyi, hashishe, nenshihe muakunyʼanyi Yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambila Lebeka mei a Esau, muanʼandi muan a bute yeye Wakabikila Yakoba muanʼandi muan a mukala, wakamuambila ne Esau mukulu ebe udi welangana meji a kukushiha bua kutokesheye munda muandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku muanʼanyi witabusha di dianyi, bika biebe, unyemene kudi Labana muan etu wa balume, udi mu Halana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ushale nʼandi matuku makese to ne hashika lukuna lua mukuluʼebe ludiye nʼalu kudi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ne hashika tshiji tshia muan enu kudi, ne hahueye bualu buwakamuenzela muoyo, hashishe nenkutumine di nenkubikile, nennujimishile bubidi buenu dituku dimue bualu kai?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        }
      ]
    },
