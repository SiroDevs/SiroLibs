        },
        {
          "text": "Eu udi mukanda wa ndelanganyi ya Adama Mu dituku diakafuka Nzambi bantu mu tshifuanyikishi tshiandi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakabafuka mulume ne mukashi, wakabasankisha, wakabidika ne, Adama, mu dituku diakabafukeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adama wakikala ne muoyo bidimu lukama ne makumi asatu, wakalela muana mulume ne tshifuanyikishi tshiandi, mufuanangane nʼandi, wakamuidika dina ne, Sheta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua kulela kua Sheta Adama wakikala ne muoyo bidimu nkama muanda mukulu, wakalela bana balume ne bana bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku onso a Adama akadi nkama tshitema ne makumi asatu, yeye wakafua biandi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
