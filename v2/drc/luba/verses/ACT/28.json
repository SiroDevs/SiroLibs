  "copyright": "PUBLIC DOMAIN",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakahanduka, tuakamanya ne, Tshisenga etshi ntshidibo babikila ne, Melita. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basenshi bakadi batutua luse lua bungi: bakatutemena kahia, bakatubikila buonso buetu, bualu bua nvula wakadi muloke ne bua mashika akadiku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu Paulo tshisumbu tshia nkunyi, hakatshieleye mu kahia, nyoka wakahatukamu bualu bua luiya lua kahia, wakalamata ku tshianza tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila basenshi nyoka mubi mulembelele ku tshianza tshiandi, bakambilangana ne, Bulelela, muntu eu udi mutahianganyi; wakuhanduka mu mai, kadi dilumbulula dilelela kadiena ditabusha bua yeye kuikala ne muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakakuha nyoka mu kahia, kakunvua disama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakadi batekemena ne, Neûle, anyi neahone hanshi lukasa mufue; kadi hakatekemenabo nunku musangu mule, hakadibo kabai bamone bualu bulue kudiye, bakakudimuna meshi abo bamba ne, Yeye udi nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha buihi ne muaba au hakadi madimi a muntu mimene, mukelenge wa tshisenga, dina diandi Popolio, wakatubuesha mu nsubu muandi, wakatuenzela bimpe matuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tatu wa Popolio wakadi mulale musame mubidi kahia ne munda mashi; Paulo wakaya kudiye, wakatendelela Nzambi, wakamulenga bianza, wakashikisha masama andi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakenzeye nunku, bakuabo ba mu tshisenga bakadi ne mabedi bakadi balua kudiye, bakadi bukoleshibua; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bobo bakatamba tutu tumbisha; hatuakamba kumuka, bakabuesha bintu bitu akadi nʼabi bualu mu bualu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita ngondo isatu, tuakabuha mu buatu bua ku Alesandelia buakadi bulale ku tshisenga bua ngondo ya mashika, tshimanyinu tshiabu ne, Diosokuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakafika ku Sulakusa, tuakalalaku matuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakumukaku, tuakatshinguluka, yakafika ku Legio. Hakahita dituku, luhelele lua ku Sude luakajuka, yakafika ku Potiolo dituku dibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.13",
            "verseOrgIds": [
              "ACT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuakasanganamu bana betu ba Nzambi, bobo bakatusengelela bua kushala nʼabo matuku muanda mutekete. Nunku tuakalua ku Lomo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.14",
            "verseOrgIds": [
              "ACT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakunvua bana betu ba Nzambi ba mu Lomo lumu luetu, bakalua kutuakidila ku Tshisalu tshia Apio ne ha Nsubu Isatu ya Tshilala Benyi; bakabamona Paulo, wakasakidila Nzambi, mutshima wandi wakakankamana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakabuela mu Lomo, bakitabusha bua Paulo ashikame ha nkayandi ne disalayi dimulame.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku asatu, Paulo wakabikila bakadi ku mutu kua Bena Yuda; hakunguilabo, wakabambila ne, Bana betu, tshiakenza bibi kudi bantu anyi ku bilele bia bankambua betu, kadi mu Yelushalema bakaufila musuika mu bianza bia Bena Lomo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakankonkabo bualu, bakasua kundekela, bualu bua kabakasangana ne bualu bua meme kufuila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakahidia Bena Yuda kuitabusha dî diabo, bunakadi nʼabu mbua kulayidila kudi Kaisa; tshiakadi ne bualu bua kubanda nʼabu tshisamba tshianyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bualu ebu nunku bunakunubikidila bua kulua kuntangila ne bua kuakula nʼanyi; ndi musuikibue ne lukanu elu bualu bua ditekemena dia Isalele ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuambila ne, Tuetu katuakangata mikanda mifume ku Yudaya bua bualu buebe, kakuena umue wa bana betu wakalua kunoko utuambila lumu, anyi ukutela ne bualu bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudi basue kunvua bualu bûdi wela meshi; bualu bua tshisumbu etshi, tudi bamanye ne, Badi batshibanda kuonso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamusunguilabo dituku, bakalua ba bungi mu nsubu muandi; yeye wakabalondoluela malu, wakabayisha bua bukelenge bua Nzambi, wakateta bua kubitabushisha Yesu, ne ku mikenshi ya Mose ne ku mei a baprofete, dinda tô ne ku dilolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuabo bakadi bitabusha malu akambeye, bakuabo bakadi bâhidia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabangabo kuhunga mei munkatshi muabo, bakumuka, hakamana Paulo kubambila anu dî dimue ne, Nyuma Muimpe wakambidila bankambua benu bimpe kudi muprofete Yeshaya ne,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
            "verseOrgIds": [
              "ACT.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo wakalalamu bidimu bibidi, wakadi mu wandi nsubu ufuta muena nsubu, wakadi witabusha bantu bonso bakahia kudiye, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubambila bua bukelenge bua Nzambi, ubayisha malu a Mukelenge Yesu Kilisto ne dikima dionso, muntu kakamukanda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
            "verseOrgIds": [
              "ACT.28.31"
            ]
          }
        }
      ]
    }
  ],
