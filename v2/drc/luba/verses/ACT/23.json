          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku masalayi akangata Paulo, bu muakâmbilabo, akalua nʼandi mu butuku tô ne ku Antipati. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakatshiabu, akashîa masalayi akadi ha tubalu bua kuyau nʼandi, akahingana ku nsubu wau. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalukau ku Kaisalia, Hakaluau mukanda kudi ngovena, akateka Paulo ku mesu kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
