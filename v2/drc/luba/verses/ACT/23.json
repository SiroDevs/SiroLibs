          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaubaleye, wakakonka luseke luakadiye; hakamanyeye ne, Ngua ku Kilikia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
