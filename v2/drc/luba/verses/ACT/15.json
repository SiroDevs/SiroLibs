  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ACT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakuabo bakadi bafume mu Yudaya bakalua, bakadi bayisha bana betu ba mu Kilisto ne, Binuikala kanui batengula bu mu tshilele tshia Mose, kanuena bamanye mua kusungidibua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadi Paulo ne Bânaba nʼabo mpata ne dikonka musangu mule, bana babo ba mu Kilisto bakasungula Paulo ne Bânaba ne bakuabo babo bua kuyabo ku Yelushalema kudi bapostolo ne bakulu bua dikonka edi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena ekelesia bakabashindikila, bakahitshila mu Foineke ne Samalea, benda bambila bantu bua kukudimuna kua mitshima kua bisamba bia bende; bakatamba kusankisha mitshima ya bana babo bonso ba mu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.3",
            "verseOrgIds": [
              "ACT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafikabo ku Yelushalema, bakabitabusha kudi bena ekelesia ne kudi bapostolo ne bakulu; Paulo ne Bânaba bakabambila malu onso akenza nʼabo Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.4",
            "verseOrgIds": [
              "ACT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bakuabo ba mu luseke lua Bafalese, bakadi bamane kuitabusha, bakabika bamba ne, Butudi nʼabu mbua kutengula ba bisamba bia bende, ne bua kubambila bua kuenzabo mikenshi ya Mose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapostolo ne bakulu bakadisangisha bua kulondabo bualu ebu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo ne mpata ya bungi, Petelo wakabika, wakabambila ne,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, nudi bamanye ne, Mu matuku a kai e Nzambi wakasungula munkatshi muenu bua bisamba bia bende biunvue dî dia lumu luimpe mukana muanyi, bitabushe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi mumanyi wa mu mitshima, wakabavidila, wakabaha Nyuma Muimpe bu muakutuheye bietu: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakatahulula hankatshi hetu nʼabo, wakuvua mitshima yabo ku ditabusha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
              "ACT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka nudi nutetshila Nzambi munda tshinyi, bua nudi basue kuteka tshikokedi ha nshingu ya bayidi tshiakadi bankambua betu kabai bamanye mua kutshituala ne tuetu kabidi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
              "ACT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tuetu tudi tuitabusha ne, Tudi tusungidibua ku ngasa wa Mukelenge Yesu muomumue nʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buonso buabo bakahua, bakatelesha muakadi Bânaba ne Paulo bamba bua bimanyinu ne malu a kukema biakenza nʼabo Nzambi munkatshi mua bisamba bia bende. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakayabo, Yakobo wakamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, teleshai dî dianyi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simona wakalonda bu muakadianjila Nzambi kumueneka kudi bisamba bia bende bua kusungula munkatshi muabo bantu bua kuikalabo ne dina diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mei a baprofete adi makanangane ne bualu ebu, bu muakafundabo ne,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.15",
            "verseOrgIds": [
              "ACT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bapostolo ne bakulu ne bena ekelesia bonso bakelangana meshi ne, Mbimpe tusungule ba mu tshisumbu tshietu, tubatume ne Paulo ne Bânaba ku Antiokia; bakatuma nunku Yuda, udi ne dina dikuabo ne, Bâsaba, ne Sila, hakadi bantu banene ba munkatshi mua bana babo ba mu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabaha mukanda mufunda nunku ne, Bapostolo ne bana betu badi bakulu badi batumina bana betu ba mu bisamba bia bende mu Antiokia ne mu Sulia ne mu Kilikia muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua tuakulua lumu ne, Bakuabo ba munkatshi muetu bakuya kunudi, bakunutatshisha ne mei abo, badi bamba kuona mioyo yenu; tuetu katuakubatuma ne mukenshi kunudi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "hatuakuhunga dî dimue, tuakula meshi ne, Mbimpe tusungule bantu, tubatume kunudi ne bana betu bananga, Bânaba ne Paulo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bobo mene bakafila mioyo yabo bualu bua dina dia Mukelenge wetu Yesu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku tuakutuma Yuda ne Sila, bobo kabidi nebanuambile mei momumue mukana muabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Nyuma Muimpe wakamona, ne tuetu kabidi, ne, Kembimpe bia kunutekela bunga bujitu, anu malu atudi nʼau bualu: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nulekele bintu bidi bishihela mpingu, nulekele kabidi mashi ne nyama mifiekela mu nshingu ha kuishiha, ne masandi; binualekela malu â, nenuenze bimpe. Nushale ne bukole.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku hakalayanganabo nʼabo, bakahueka ku Antiokia, hakasangishabo bantu, bakabaha mubanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaubalabo, mitshima yabo yakasanka bua disamba diakabasambabo nʼadi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yuda ne Sila bakadi baprofete, bakambila bantu mei a bungi, bakakolesha mitshima yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalelabo kuakua musangu, bana babo ba mu Kilisto bakabahingisha talalâ kudi bakabatuma. [ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Minga mikanda ya kale idi ne mai â:",
              "type": "text"
            },
            {
              "text": "Kad Sila wakelangana meshi ne, Bidi bimpe nshaleku.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Paulo ne Bânaba bakashala mu Antiokia, bayisha ne bambila bantu dî dia Mukelenge; bakuabo ba bungi bakadi nʼabo kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku makuabo, Paulo wakambila Bânaba ne, Tuhingane bua kutangila bana betu ba mu Kilisto ba mu misoko yonso ituakadi tuambila dî dia Mukelenge, tumone ne badi munyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bânaba wakasua kuya kabidi ne Yone wakadibo babikila ne, Mâko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Paulo wakelangana meshi ne, Kembimpe bia kuya ne muntu wakumuka watushîa mu Pampulia, kai muye nʼetu ku mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo ne mpata mikole, nunku bakahanduluka, Bânaba wakangata Mâko, wakasabuka nʼandi ku Kupulio. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Paulo wakasungula Sila, wakaya, hakamufilabo mu ngasa wa Mukelenge kudi bana babo ba mu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahitshila mu Sulia ne Kilikia wenda ukolesha mitshima ya bena ekelesia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
      ]
    }
