  "copyright": "PUBLIC DOMAIN",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "ACT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakasungulabo bua tuetu kuya mu bualu ku Italia bakafila Paulo ne bakuabo bakadi mu nsubu wa lukanu mu bianza bia Yulio, kapitene ka mu tshisumbu tshia masalayi tshiakadibo babikila ne, Tshia Augusto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakabuela mu buatu bua ku Adulamutiona buakadi buamba kuya ku miaba yakadi kukala kua mai a luseke lua Asia, tuakaya; Alistâko, Muena Makedonia wa ku Tesalonike wakadi nʼetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu, tuakafika ku Sidona; Yulio wakenzela Paulo bimpe, wakitabusha bua yeye kuya kudi balunda bandi bamukuatshishe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakumukaku, tuakayila ku nyima kua Kupulio, bualu bua luhehele luakadi lutuhingisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakasabuka mai akadi hehi ne Kilikia ne Pampulia, tuakafika ku Mula, musoko wa mu luseke lua Lukia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapitene wakasanganaku buatu bua Alesandelia buakadi buya ku Italia, wakatubueshamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakadi tuya matuku a bungi bitulu bitulu, tuakafika ha buihi ne Kinido, benda ne ditata dikole; bua luhehele luakadi lutuhumbisha bua kufikaku, tuakayila ku nyima kua Kulete hehi ne Salamone. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakahitshilaku ne ditata dikole, tuakafika ku muaba udibo babikila ne, Dilobo Dimpe; musoko wa Lasaya wakadi ha buihi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku a bungi, luendu lumane kutukuata buowa, bualu bua matuku a Dijila dia bia kudia akamana, kuhita, Paulo wakabanga kubadimusha: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakabambila ne, Balumiana, udi mona ne, Luendu elu neluikale ne dibuluka ne dijimina dikole, kendia bintu ne buatu nkayabi, kadi ndia mioyo yetu kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kapitene ka masalayi wakatamba kuitabusha dî dia muena yende ne dia muena buatu ku mpala kua mei akamba Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua dilobo adi kadiakadi diakane dia kushikishilaku ngondo ya mashika, bakadi batambe bungi bakamba ne, Tumukai kunoko, ne tuamanya mua kufika ku Foinike bua kushikishilaku ngondo ya mashika, aku kudi dilobo dikuabo dia Kulete, didi ditangila ku node-esete ne ku sude-esete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaheha luhehele lua ku Sude bitulu bitulu, bakelangana meshi ne, Tuakuheta butudi basue, bakabisha luongo, bakadi bayila ku muelelu wa mai wa Kulete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakahita tshituha tshihi, tshihuhu tshikole tshidibo babikila ne, Eulakulo, tshifuma ku mpata, tshiakatukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatutatshi ku buatu, kabuakamanya mua kutulama kuakadi kuvuila tshihuhu, tuakalekela kuita, luhehele luakatuendesha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakafika ku nyima kua tshisenga tshikese, dina diatshi Kauda, tuakadi ne bualu bukole bua kuambula buatu bukese; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakabubandishabu, bakanyengela buatu bunene mionshi ha nyima bua kubukuatakasha. Hakatshinabo ne, Luhehele nelutuele ha lusenga lua ku Suti, bakatulula tshilulu tshiakadi tshiendesha buatu, luhehele luakatuendesha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakatata bikole ne tshihuhu, hakatshiabu, bakabanga kuela biakadibo batuala mu buatu mu mai; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakafika dituku disatu, bakela bintu bikuabo bia mu buatu mu mai ne bianza biabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diba ne mitoto kabiakatutemena matuku a bungi, tshihuhu tshitambe bukole tshiakatukuata, katuakadi ne ditekemena kabidi ne, Netusungidibue. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo kabai badie musangu mule, Paulo wakimana munkatshi muabo, wakamba ne, Balumiana, biakadi bimpe bia nuenu kunvua dî dianyi; bu nuenu benze nunku, kanuakadi kumuka ku Kuleta, kanuakadi kuikala ne bualu bukole ebu ne bua dibutuisha dia bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka ndi nusengelela ne, Koleshai mitshima yenu, bualu bua muoyo wa muntu umue wa munkatshi muenu kawena ujimina, anu buatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua muanjelo wa Nzambi wanyi, undi nkuatshila mudimu, wakuimana ha buihi nʼanyi butuku ebu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakungambila ne, Paulo, kutshinyi; bûdi nʼabu mbua kuimana ku mpala kua Kaisa; ne mona, Nzambi wakukuha bonso badi benda nʼebe mu buatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku, bana betu, nukoleshe mitshima yenu; ndi ngitabusha Nzambi ne, Bualu nebuenjibue bu muakangambileye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi butudi nʼabu mbua kuedibua mu tshianga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua butuku bua dikumi ne anai, hakadi luhehele lututambakasha mu mai manene a Adulia, mundankulu bena buatu bakelangana meshi ne, Tukadi ha kufika ha buihi ne buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakateta bule bua mai, bakabusangana maboko makumi abidi; bakayabo tshituha, bakabuteta kabidi, bakabusangana maboko dikumi ne atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshinabo ne, Netuedibue ha mabue, bakela luongo inai mu mai ku tshitaku tshia buatu, bakadi bajinga ne, Buatshiahu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena buatu bakamba kunyema, bakadi batulula buatu bukese mu mai, badinga ne, Tudi basue kuela luongo mikuabo ku mpala kua buatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Paulo, wakambila kapitene ka masalayi ne masalayi mene ne, Bikala bantu aba kabai bashale mu buatu, kanuena mua kusungidibua. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe masalayi akakosa mionshi ya buatu bukese, buakahona mu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo wakadi ubasengelela buonso buabo tô ne hakamba butuku kutshia, bua kudiabo, wamba ne, Edi ndituku dia dikumi ne anai anuakadi bashale, bajile bia kudia kanui badie tshintu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku ndi nusengelela bua nuenu kudia, bualu ebu nduhandu luenu, bualu bua lusuki lua ku mutu kua umue wenu kaluena lujimina. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakambeye nunku, wakangata mutanda wa bidia, wakasakidila Nzambi ku mesu kua buonso buabo, wakautshibula, wakabanga kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buonso buabo bakakolesha mitshima yabo, ne bobo bine bakangata bia kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buonso buetu tuakadi mu buatu bantu nkama ibidi ne makumi muanda mutekete ne basambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakûkutabo, bakabanga kuhehesha buatu, bakela blé mu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu, kabakadi bamanye buloba abu; bakatangila tshinkonya tshia mai tshiakadi ne lusenga, bakasangisha dî ne, Ne tuamanya mua kutuma buatu mu muaba wawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakosa, mionshi ya luongo, bakahisha mu mai ne mionshi; ha diba adi mene bakasulula mionshi ya bidimba; bakabandisha tshilulu tshia ku mpala bua kukuata tshi luhehele, bakabanga kuya balulame ku muelelu wa mai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakafikabo ha nsangilu ibidi ya mai, bakatua buatu ku lusenga; mpala wa buatu wakatua ku lusenga, wakashindama, kadi tshitaku tshiabu tshiakabanga kutshibuka bualu bua bukole bua mambuanka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lungenyi lua masalayi luakadi lua kushiha bena lukanu, bua umue wabo kombedi, kanyemi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bualu bua kapitene kau wakasua kusungila Paulo, wakâkesha; wakamba ne, Badi bamanye mua kuombela badiele mu mai, badianjile ku mpata, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakuabo bangate mabaya anyi bintu bikuabo bia mu buatu, baye ha mutu habi. Nunku buonso buabo bakafika ku mpata, bakahanduka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
    }
