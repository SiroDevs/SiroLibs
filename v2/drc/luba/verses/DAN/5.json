          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dayawesha, Muena Madai, wakadia bukelenge, wakadi ne bidimu bu makumi asambombo ne bibidi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
