          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu butuku abu mene Beleshasâ, mukelenge wa Bena Kasada, wakashihibua. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
