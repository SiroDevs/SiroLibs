            "number": "29",
            "style": "v",
            "sid": "DAN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu diba adi Beleshasâ wakela dî diandi, bakaluatshisha Danyele bilulu bikunzubile, bakamuela lukanu lua or mu nshingu muandi, bakela mukenji bualu buandi ne ikale mukokeshi muisatu wa mu bukelenge.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
