            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Nebukadenesâ wakaya ha buihi ne mushiku wa tshikutu tshia kahia kakole, wakela dî ne, Shadalaka, Meshaka ne Abedenego, nuenu bantu ba Nzambi Mutambe Bunene wa mu diulu, hatukai, luai kunoku. Shadalaka, Meshaka ne Abedenego bakaluhuka munkatshi mua kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuhita, miloho, ba-gouverneur, ne bena meji ba mukelenge, bamane kudisangishaku, bakatangila bantu aba, bakamona ne kahia kakakenza bualu hamʼbidi habo, nsuki ya ku mitu yabo kayakababuka, binkutu biabo kabiakanyanguka ne muhuya wa kahia kawakadi hamʼbidi habo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadenesâ wakamba kabidi ne, Batumbishe Nzambi wa Shadalaka, Meshaka ne Abedenego, wakutuma muanjelo wandi bua kuhandisha bantu bandi bakamueyemena. Bakahidia mukenji wa mukelenge, bakafila mibidi yabo ku lufu bua kabakuatshidi nzambi mukuabo mudimu, kabamutendeledi mu muaba wa Nzambi wabo mene. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku ndi ngela mukenji ne, Muntu yonso, wa tshisamba tshionso, anyi wa muaku wonso wadiula Nzambi wa Shadalaka, Meshaka ne Abedenego, nebamukose bituha bituha, nebavuishe nsubu wandi bu diala; bualu bua kakuena nzambi mukuabo udi mua kuhandisha bantu bu muakuenzeye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, mukelenge wakahandisha Shadalaka, Meshaka ne Abedenego mu province wa Babulona.",
          "type": "text",
