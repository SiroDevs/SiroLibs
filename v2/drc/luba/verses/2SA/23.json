            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Â adi mena a bena nvita ba bukitu bakadi nʼabo Davidi: Yoshebashebeta, Muena Takemona, wakadi ku mutu kua tupitene tuonso; dina diandi dikuabo Adino, Muena Esene, wakela bantu nkama muanda mukulu difuma diandi, wakabashiha tshikondo tshimue.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazâ, muana wa Dodai, Muena Ahoa, wakamulonda, umue wa bena bukitu basatu bakadi nʼabo Davidi, hakafuna Bena Peleshete bulobo bakadi badisangisha bua kuluangana nvita, hakumuka Bena Isalele; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye wakajuka, wakashiha Bena Peleshete tô ne bakateketa diboko diandi, ne tshianza tshiandi tshiakala mata tshilabi tshia muele wandi wa nvita: Yehowa wakabayuisha luhandu lunene dituku adi; bantu bakalonda ku nyima kuandi anu bua kuhaula bintu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama, muana wa Age, Muena Halala, wakamulonda. Bena Peleshete bakadisangisha mu tshisumbu mu budimi bua nkunde; bantu bakanyema Bena Peleshete. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakimana munkatshi mua budimi, wakabusungila, wakashiha Bena Peleshete; Yehowa wakabayuisha luhandu lunene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu basatu bakuabo ba munkatshi mua bena bukitu makumi asatu bakaya kudi Davidi hakadiye mu lubuebue lua Adulama mu tshikondo tshia kunowa; Bena Peleshete bakasa tshitudilu tshiabo mu tshibanda tshia Lefayima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku tshikondo atshi Davidi wakadi mu musoko wa lumbu, ne masalayi Bena Peleshete akadi mu Beteleheme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutshima wa Davidi wakamusamina bua mai a kunua; wakamba ne, Bampeku mai a kunua a dî mu dina dia mu Beteleheme, didi ha buihi ne tshibi! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena bukitu basatu bakahita munkatshi mua ma salayi a Bena Peleshete, bakasuna mai mu dina dia mu Beteleheme diakadi ha buihi ne tshibi, bakalua nʼau kudi Davidi. Yeye wakabenga bua kunueye mai a, kadi wakâhongolola ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Yehowa, bualu ebu kabuikadi kundi, bua meme kuenza nunku: ndi mua kunua mashi a bantu bakamba kujimisha mioyo yabo, anyi? Nunku yeye wakabenga kuanua, A mmalu akenza bena bukitu basatu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai, muanʼabo ne Yoaba muana wa Seluya, wakadi ku mutu kua bantu basatu. Yeye wakela bantu nkama isatu difuma diandi, wakabashiha; nunku wakadi ne dina dinene munkatshi mua aba basatu, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kakadi ne dina dia butumbi munkatshi mua aba makumi asatu, anyi? Nunku bakamusungula kapitene kabo; kadi yeye kakadi wa mu mulongo wa basatu ba ku mpala.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, muana wa Yehoyada, muana wa muena bukitu wa mu Kabesele, Wakenza biandi malu manene, wakashiha bana balume babidi ba Aliele wa mu Moaba. Yeye wakahueka kabidi, wakashiha nyama wa ntambue mu lubuebue mu tshikondo tshia neige. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakashiha Muena Ejipitu, wakadi muena bukitu; Muena Ejipitu wakadi ne difuma mu tshianza tshiandi; kadi Benaya wakaya kudiye ne mulangala, wakanyenga difuma dia Muena Ejipitu mu tshianza tshiandi, wakamushiha ne difuma diandi mene. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mmalu akenza Benaya, muana wa Yehoyada, ne wakadi ne dina dinene munkatshi mua bantu basatu ba bukitu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakahita bantu aba makumi asatu butumbi, kadi yeye kakadi wa mu mulongo wa basatu ba ku mpala. Davidi wakamuteka ku mutu kua balami bandi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asahele, muanʼabo ne Yoaba, wakadi wa bantu aba makumi asatu; ne Elehanana, muana wa Dodo, wa mu Beteleheme, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama, Muena Haloda, ne Elika, Muena Haloda, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.25",
            "verseOrgIds": [
              "2SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helese, Muena Palati, ne Ila, muana wa Ikeshe, Muena Tekoa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.26",
            "verseOrgIds": [
              "2SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiesê, Muena Anatota, ne Mebunai, Muena Husha, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.27",
            "verseOrgIds": [
              "2SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salemona, Muena Ahoa, ne Mahalai, Muena Netofa, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.28",
            "verseOrgIds": [
              "2SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helebe, muana wa Bana, Muena Nefota, ne Itai, muana wa Libai wa mu Gibea wa Bena Benyamina, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.29",
            "verseOrgIds": [
              "2SA.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, Muena Pilatona, ne Hidai wakafuma ku tusulu tua mu Gâsha, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abi-alabona, Muena Âba, ne Asemaweta, Muena Bâhuma, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliaba, Muena Shâlebona, bana ba Yashena, Yonatana, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shama, Muena Halala, ne Ahiyama, muana wa Shala, Muena Alala, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifelete, muana wa Ahasabai, muana wa Mâka, ne Eliyama, muana wa Ahitofele, Muena Gilona, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
