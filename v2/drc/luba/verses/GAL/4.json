  "reference": "Galatia 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GAL 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ngamba ne, Hatshidi muhianyi muana mutekete, kena utahuluka kudi muhika, nasha bikaleye mukelenge wa bintu bionso; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi yeye udi ku nyima kua bakuatshishi ne balami tô ne halua dituku diakasungula tatu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku tuetu kabidi hatuakadi bana batekete, bakatuvuisha bahika ba mayisha a kumudilu a ha buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.3",
            "verseOrgIds": [
              "GAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakakumbana tshikondo, Nzambi wakatuma Muana wandi, muledibue kudi mukashi, muledibue munshi mua mikenshi, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.4",
            "verseOrgIds": [
              "GAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua yeye amanye mua kuhikula badi munshi mua mikenshi, bua tuetu tuangate buhianyi bua bana ba Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bualu bua nudi bana, Nzambi wakatuma Nyuma wa Muana wandi mu mitshima yetu, wela di diandi ne, Aba,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Aba,",
              "type": "text"
            },
            {
              "text": "kukudimuna mu muaku ne, Tatu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku wewe kuena muhika kabidi, kadi udi muana mulela; ne biwikala muana mulela, nunku udi muhianyi bua bualu bua Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi ku tshikondo atshi, bualu bua kanuakamanya Nzambi, nuakadi mu buhika bua bintu bidi kabi nzambi mu tshikadilu tshiabi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.8",
            "verseOrgIds": [
              "GAL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi katataka, bualu bua nuakumana kumanya Nzambi ne nudi bamanyibue kudi Nzambi, munyi munudi basue kuhingana ku mayisha matekete a kumudilu ne a hatuhu a ha buloba bua kudivuisha bahika kabidi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nudi nuj idila matuku ne ngondo ne bikondo ne bidimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.10",
            "verseOrgIds": [
              "GAL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ntshina bua bualu buenu ne, Bumue nakanuenzela mudimu hatuhu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, ndi nusengelela bua nuenu nulue bu meme, bualu bua meme nakulua bu nuenu. Kanuakangenzela bibi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nudi bamanye ne bualu bua butekete bua mubidi wanyi nakanuambila lumu luimpe musangu wa kumudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuakampetula, kanuakampidia bualu bua butekete bua mubidi wanyi buakadi bu buteyi kunudi; kadi nuakangitabusha bu muanjelo wa Nzambi, bu Kilisto Yesu mene. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudisankisha kuenu kuakuya hanyi? Ndi mumanyi wa bualu ne, Bu nuenu bamanye mua kuenza nunku, nuakadi kuntudila mesu enu bua kuampa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nakulua muena lukuna wenu bualu bua ndi nuambila bualu bulelela, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi banukeba ne lukunukunu, kembua kunuenzela bimpe, kadi badi basue kunusesuisha kutudi, bua nuenu nubakebe bobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuikala ne lukunukunu mu malu makane bikondo bionso kudi kuimpe, hangikala nʼenu, ne hangikala tshi nʼenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana banyi bakese, bandi mukuatshikile didinyenga dia ha kulela kabidi bua bualu buenu tô ne bamueneka Kilisto munda muenu, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.19",
            "verseOrgIds": [
              "GAL.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakadi musue kuikala nʼenu katataka bua kukudimuna dî dianyi; bualu bua mutshima wanyi udi uhampakana bua bualu buenu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nungambile bienu, nuenu badi basue kuikala munshi mua mikenshi, kanuena nunyua mikenshi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.21",
            "verseOrgIds": [
              "GAL.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bakafunda ne, Abalahama wakadi ne bana balume babidi, wakalela umue kudi mukashi muhika, ne mukuabo kudi mukashi, muena budishikaminyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.22",
            "verseOrgIds": [
              "GAL.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa mukashi muhika wakaledibua bu mudibo balela bana bonso, kadi muana wa mukashi, muena budishikaminyi, wakaledibua bua mulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.23",
            "verseOrgIds": [
              "GAL.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malu â nunku adi lusumuinu: bakashi aba badi bu bihungidi bibidi; umue wabo wa ku mukuna wa Sinai udi ulela bana bua kuikalabo bahika, yeye udi Haga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.24",
            "verseOrgIds": [
              "GAL.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga eu udi mukuna wa Sinai wa mu Alaba udi mu mulongo umue ne Yelushalema wa katataka; bualu bua yeye udi mu buhika ne bana bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.25",
            "verseOrgIds": [
              "GAL.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yelushalema wa mu diulu udi muena budishikaminyi, udi baba wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.26",
            "verseOrgIds": [
              "GAL.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bakafunda ne,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
              "GAL.4.27"
            ]
          }
        }
      ]
    }
  ],
