              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba udi wamba ne, Nenjuke bua kubaluisha, nengumushe ku Babulona badi babikidibue ku dina diau ne difuka dia bantu bau didi dishala, muana mulume ne muikuluʼandi, mmudi Yehowa wamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba udi Wamba ne, Nenvuishe musoko eu muaba wa nkese ne muaba wa bintampi. Nenkombemu ne lukombo lua kubutula nʼalu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
