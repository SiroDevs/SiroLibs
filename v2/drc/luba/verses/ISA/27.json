          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi nebele mpungi munene; bakadi bamba kufua mu buloba bua Ashû,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
