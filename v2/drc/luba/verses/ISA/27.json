          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi Yehowa neashihule miehu yandi ya blé ya ku musulu wa Pelata tô ne ku kasulu ka Ejipitu; ne ba nusangishe muntu ne muntu, nuenu, Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "name": "verse",
