            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua Yehowa udi wamba dî ne, Bakanuhana tshianana, nebanuhikule kabayi banuhikula ne argent. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua Mukelenge Yehowa udi wamba dî edi ne, Bantu banyi bakahueka ku Ejipitu ku tshibangidilu bua kushikamaku tshituha, ne Bena Ashû bakabakengesha hatuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku mpindiu Yehowa udi ukonka ne, Ndi mmona tshinyi kunoko, bualu bua bakuya ne bantu banyi mu buhika tshianana? Yehowa udi wamba ne, Badi babakokesha badi bela bibingu, ne dina dianyi ditu diahendibua dinda tô ne dilolo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bantu banyi nebamanye dina dianyi; nunku nebamanye halua difuku diadia ne, Mmeme Yehowa udi wamba dî edi; ka meme ndiku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    }
