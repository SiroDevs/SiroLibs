              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Mukelenge wakungambila dî edi ne, Hahita tshidimu tshimue, bu mudi muena mudimu wa ditutu ubala bidimu biandi, butumbi buonso bua Kedâ nebuhange. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
