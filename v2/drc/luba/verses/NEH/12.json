          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakuidi Eleyakima, Mâseya, Minyamina, Mikaya, Eleyehoenai, Zekâya ne Hananya bakadi ne mpungi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
