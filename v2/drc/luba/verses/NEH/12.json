          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Mâseya ne Shemaya ne Eleazâ ne Uzi ne Yehohanana ne Malakiya ne Elama ne Ezê. Bimbi ba misambu bakimba bikole ne Yizelaya wakadi ku mutu kuabo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
