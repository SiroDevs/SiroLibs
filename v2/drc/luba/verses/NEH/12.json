          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakafila milambu ya bungi dituku adi, bakasanka, bualu bua Nzambi wakabasankisha ne disanka dinene; bakashi ne bana bakasanka kabidi; nunku bakunvua disanka dia mu Yelushalema kudi bakadi kule.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
