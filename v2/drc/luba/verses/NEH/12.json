          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bîsumbu abi bibidi bia bimbi ba misambu biakimana mu nsubu wa Nzambi; meme ne tshituha tshia bantu banene tuakadiku, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
