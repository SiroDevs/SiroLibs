          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha mutu ha tshibi tshia Efelayima ne hehi ne tshibi tshia diambedi ne tshibi tshia ku luseke lua minyinyi ya mu mai ne tshibumba tshia Hananele ne tshibumba tshia Hamea tô ne ku tshibi tshia mikoko; bakimana talalâ ku tshibi tshia balami ba musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        },
        {
