          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenfile biuma biebe ne bidi mu tshibutshilu tshiebe bia mu maloba ebe onso kudi badi babinyenga ku hukole, kabayi bafile mushinga, nengenze nunku bua malu mabi ebe onso. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nembitume hohamue ne bena lukuna bebe mu buloba bûdi kuyi mumanye; bualu bua kadilu ka tshiji tshianyi kakutema nekakuoshe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    }
