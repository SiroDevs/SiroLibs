            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Yelemiya wakangata mukanda mukuabo, wakaha Baluka, muana wa Neliya, wakafundamu mei akaluhuka mukana mua Yelemiya, mei onso akadi mu mukanda wakoshabo mu kahia kudi Yehoyakima, mukelenge wa Yuda. Baluka wakasangishamu mei makuabo a bungi mafuanangane ne a diambedi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
