              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia makumi asatu ne muanda mutekete tshia mu buhika bua Yehoyakina, mukelenge wa Yuda, mu ngondo wa dikumi ne muibidi, mu dituku dia makumi abidi ne atanu dia ngondo, Ewile-melodaka, mukelenge wa Babulona, mu tshidimu tshia kumudilu tshia bukokeshi buandi, wakabandisha Yehoyakina, mukelenge wa Yuda, wakamuhatula mu nsubu wa lukanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamuambila mei a kalolo, wakajadika nkuasa wandi wa bukelenge ha mutu ha nkuasa ya bakeleye bakuabo bakadi nʼandi mu Babulona, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamûmusha bilulu biandi bia lukanu. Yehoyakina wakadia bia kudia biandi ku mpala kua mukelenge matuku onso a muoyo wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Babulona wakamuha dikuatshisha ku dituku ku dituku, tshituha tshia bintu bia buatshia-buatshia tô ne ku dituku dia lufu luandi. Wakenza nunku matuku onso a muoyo wandi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
