  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JER 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kudi Yelemiya mu tshidimu tshia dikumi tshia bukokeshi bua Sedekiya, mukelenge wa Yuda, tshiakadi tshidimu tshia dikumi ne muanda mukulu tshia bukokeshi bua Nebukadenesâ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.1",
            "verseOrgIds": [
              "JER.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshikondo atshi masalayi a mukelenge wa Babulona akadi atshintshimika Yelushalema, ne bakamana kubuesha muprofete Yelemiya mu lukanu luakadi mu tshiendelu tshia bansentedi tshia mu nsubu wa mukelenge wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.2",
            "verseOrgIds": [
              "JER.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Sedekiya, mukelenge wa Yuda, wakamana kumuela mu lukanu alu, umubanda ne, Bualu kai wewe udi wambila bantu dî, wamba ne, Yehowa udi wamba ne, Monai, nenfile musoko eu mu bianza bia mukelenge wa Babulona, ne yeye neaunyenge? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.3",
            "verseOrgIds": [
              "JER.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udi wamba kabidi ne, Sedekiya, mukelenge wa Yuda, kena uhanduka mu bianza bia Bena Kasada, kadi nebamufile mu bianza bia mukelenge wa Babulona bulelela, neayikile nʼandi mpala ne mpala, neamonangane nʼandi ku mesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.4",
            "verseOrgIds": [
              "JER.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Mukelenge eu neaye ne Sedekiya ku Babulona, ne yeye neikaleku tô ne hanalua kudiye. Nansha binualuangana ne Bena Kasada, kamuena nubatamba bukole. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelemiya wakamba ne, Di dia Yehowa diakalua kundi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.6",
            "verseOrgIds": [
              "JER.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangila, Hanamele, muana wa Shaluma mansebʼebe, nealue kudi wamba ne, Usumbe hudimi buanyi budi mu Anatota bualu bua bukokeshi bua kubuhikula ku mushinga budi kudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.7",
            "verseOrgIds": [
              "JER.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Hanamele, muana wa mansebʼanyi, wakalua kundi mu tshiendelu tshia balami ba nsubu wa lukanu bu muakadi di dia Yehowa, wakangambila ne, Ndi nkusengelela ne, Usumbe budimi buanyi budi mu Anatota, mu buloba bua Benyamina; bua bukokeshi bua buhianyi budi kûdi ne bua kubuhikula budi kûdi; udisumbilebu. Nunku nakamanya di adi ne ndi dia Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nakasumba budimi buakadi mu Anatota kudi Hanamele, muana wa mansebʼanyi, nakamuidikishila bituha bia argent, bu nshekele",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.9",
            "verseOrgIds": [
              "JER.32.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32.9:",
              "type": "text"
            },
            {
              "text": "Nshekele wa argent wakadi ne bujitu bu bua 15 grammes.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya argent dikumi ne muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.9",
            "verseOrgIds": [
              "JER.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakafunda dina dianyi ku mukanda, nakatekaku tshimanyinu, nakabikila bamanyi ba bualu, nakamuidikishila biuma mu tshiamu tshia kuidikisha nʼatshi bujitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.10",
            "verseOrgIds": [
              "JER.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nakangata mikanda ya kula kua budimi, wowo wakadi muvunga ne muteka ne tshimanyinu bu muakadi mikenji ne tshilele, ne mukuabo wakadi muvungulula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.11",
            "verseOrgIds": [
              "JER.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakafila mikanda ya kusumba kua budimi mu bianza bia Baluka, muana wa Neliya, muana wa Mâseya, ku mesu kua Hanamele, muana wa mansehʼanyi, ne ku mesu kua bamanyi bakadi bafunda mena abo mu mikanda ya kusumba kua budimi, ne ku mesu kua Bena Yuda bonso bakadi bashikama mu tshiendelu tshia bansentedi ba mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.12",
            "verseOrgIds": [
              "JER.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakela Baluka mukenji ku mesu kuabo ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.13",
            "verseOrgIds": [
              "JER.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba, Nzambi wa Isalele, udi wamba ne, Wangate mikanda ei ya kusumba kua budimi ne mukanda eu udi mulamika ne tshimanymu, ne mukuabo eu udi muvungulula, witeke mu mulondo wa dima, bua ishale milengele matuku a bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yehowa wa misumba, Nzambi wa Isalele, udi wamba ne, Haleha tshikondo, nebasumbishangane kabidi nsubu ne madimi a tumuma tua nvinyo ne madimi makuabo mu buloba ebu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanakafila mukanda wa kusumba kua budimi kudi Baluka, muana wa Neliya, nakatendelela Yehowa ngamba bianyi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Mukelenge Yehowa! Mona, wewe wakafuka diulu ne buloba ku bukole buebe bunene ne diboko diebe diolola, ne kakuena bualu budi bukuhita bukole. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.17",
            "verseOrgIds": [
              "JER.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe udi ufuila binunu ne binunu bia bantu luse, udi uhingasha difutu dia bubi bua batatu mu biadi bia bana bakalelabo badi babalonda. Wewe udi Nzambi munene ne wa bukole, Yehowa wa misumba ndina diebe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.18",
            "verseOrgIds": [
              "JER.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe udi munene mu kulesha kuebe kua lungenyi kudi bantu, udi ne bukole bua bungi mu bienzedi biebe, udi ne mesu ebe mabulule bua kumona nshila yonso ya bana ba bantu, ne bua kufuta muntu yonso bu mudi bienzedi biandi ne bu mudi mamuma a ku bienzedi biandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.19",
            "verseOrgIds": [
              "JER.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wakenza bimanyinu ne malu a kukema mu buloba bua Ejipitu, bu mûdi wenza tô ne lelu eu, munkatshi mua Bena Isalele ne munkatshi mua bantu bakuabo kabidi; wakadivuisha dina dinene diudi nʼadi tô ne lelu eu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.20",
            "verseOrgIds": [
              "JER.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaluhula bantu bebe Bena Isalele mu buloba bua Ejipitu ku bimanyinu ne ku malu a kukema, ku tshianza tshikole, ku diboko diolola ne ku ditshinyisha dikole dia bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.21",
            "verseOrgIds": [
              "JER.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabaha buloha ebu buwakaditshiha kudi batatu babo ne, Nennuhebu, buloba budi bûle tente ne mabele ne buitshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.22",
            "verseOrgIds": [
              "JER.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabuelamu, bakabuangata bu buloha buabo. Kadi kabakatumikila dî diebe, ne kabakenda mu mikenji yebe; kabakenza bualu bumue bua malu onso awakabambila bua kuenzabo. Nunku wewe wakubatumina malu â onso. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.23",
            "verseOrgIds": [
              "JER.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangila, mishiki ya buloba ya kutshintshimika nʼai musoko idiku; ne bua bukole bua muele wa nvita, tshiole ne tshihuhu, badi bamba kufila bena musoko mu bianza bia Bena Kasada hadi babaluisha. Malu awakuamba ne, Neafike, akufika; monai, wewe wakuatangila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.24",
            "verseOrgIds": [
              "JER.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe, mukelenge Yehowa, wakungambila ne, Usumbe budimi ebu ku nshekele,",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32.25:",
              "type": "text"
            },
            {
              "text": "Nshekele wa argent wakadi ne bujitu bu bua 15 grammes.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ubikile bamanyi ba bualu; kadi musoko udi mufidibue mu bianza bia Bena Kasada.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe dî dia Yehowa diakalua kudi Yelemiya ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.26",
            "verseOrgIds": [
              "JER.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangila, meme ndi Yehowa, Nzambi wa bonso ha ha buloba; bualu budiku budi mua kumpita bukole, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yehowa udi wamba ne, Mona, nenfile musoko eu mu bianza bia Bena Kasada ne mu bianza bia Nebukadenesâ, mukelenge wa Babulona, ne yeye neaunyenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Kasada badi baluangana ne bena musoko eu, nebalue bua kuwosha ne kahia, bua kûshidisha, hohamue ne nsubu kuakufidilabo musenga wa manananshi kudi Bâla ha mutu hai, kuakuhumunabo nzambi mikuabo milambu ya bia kunua bua kunkuatshishabo nʼabi tshiji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Bua Bena Isalele ne Bena Yuda bakuenza anu malu adi mabi ku mesu kuanyi ku buana buabo tô ne katataka; Bena Isalele kabena benza bunga bualu, anu buobu budi bunkuatshisha tshiji bua mudimu wa bianza biabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua ba mu musoko eu, ku dituku diakawasabo tô ne lelu eu, bakankuatshisha tshiji ne tshifike munda, bua meme kûmusha ku mesu kuanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua malu mabi onso adi Bena Isalele ne Bena Yuda benze bua kunkuatshishabo tshiji, ne bobo bine ne bakelenge babo ne baminyampala babo, bakuidi babo ne baprofete babo, bantu ba mu Yuda ne bantu badi bashikame mu Yelushalema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakunkoma nyima, kabena bandesha mpala yabo; nansha hanakubayisha, mbika ne lunkelu mene bua kubayisha, kabakuteleja matshu bua kunvua diyisha dianyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi bakateka bintu biabo bidi bimunyanga mu nsubu udibo binyika dina dianyi, bua kumunyangabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasa bibumba bia Bâla bidi mu tshibanda tshia muana wa Hinoma, bua kufilahu bana babo ba balume ne bana babo ba bakashi bu milambu ya kuoshila Moleke; muanda undi tshiyi mubambile bua kuenzabo, udi kauyi mubuele mu mutshima wanyi, bua bobo benze tshinyangu etshi, bua kuenzesha ba mu Yuda malu mabi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpindiu Yehowa, Nzambi wa Isalele, udi wamba dî edi bualu bua musoko eu, uwakuamba ne, Udi mufidibue mu bianza bia mukelenge wa Babulona ku muele wa nvita ne ku tshiole ne ku tshihuhu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona, nembasangishe munkatshi mua maloba onso anakabatuma mu tshiji tshianyi ne mu tshifikʼa munda ne mu tshiji tshianyi tshikole, nendue nʼabo mu muaba eu, nembashikamishemu ne ditalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo nebikale bantu banyi, ne meme nengikale Nzambi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nembahe mutshima umue ne nshila umue, bua bannemeke tshiendelele, bua diakalengele diabo ne dia bana babo badi babalonda ku nyima kuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nempunge nʼabo tshihungidi tshia tshiendelele ne, Tshiena ndekela kubalonda bua kubenzela bimpe; nenteke dintshina mu mitshima yabo, bua bobo kabahambuki kundi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulelela, nensanke bua kubenzela bimpe, ne nembakune mu buloba ebu mu bushuwa ne mutshima wanyi mujima ne muoyo wanyi mujima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yehowa udi wamba ne, Bu munakutumina bantu aba makenga â makole onso, nunku nembatumine masanka onso anakubalaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu nebasumbe madimi mu buloba ebu kabidi bunudi nuamba ne, Budi bushala bikulu, kabuyi ne bantu anyi bimuna, budi bufidibue mu bianza bia Bena Kasada. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Bantu nebasumbe madimi ku biuma, nebafunde mena abo mu mikanda, nebayilamike ne bimanyinu, nebabikile bamanyi ba bualu, mu buloba bua Benyamina ne mu miaba yonso idi ha buihi ne Yelushalema, ne mu misoko ya mu Yuda, ne mu misoko ya ku mikuna ne mu misoko ya mu tshibanda ne mu misoko ya ku luseke lua Sude; bualu bua nenkudimure buhika buabo bua kubahingashila diakalengele diabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
