          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya wele lusanzu mu matshu a Bena Yelushalema, ubambile ne, Yehowa udi wamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
