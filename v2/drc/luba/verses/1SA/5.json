    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakanyenga mushete wa Nzambi, bakalua nʼau ku Ebene-ezê tô ne ku Ashedodo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakangata mushete wa Nzambi, bakalua nʼau mu nsubu wa Dagona, bakauteka hehi ne Dagona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu bakabika Bena Ashedodo, monai, Dagona wakadi mudishinde mutue mpala hanshi ku mpala kua mushete wa Yehowa. Bakakuata Dagona, baka-mushikika mu muaba wandi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu hakabikabo, bakasangana Dagona mudishinde mutue mpala hanshi ku mpala kua mushete wa Yehowa; mutu wa Dagona ne bianza biandi bibidi biakadi bikoseke bimate hanshi ku tshibuelelu; anu tshitumpampa tshia Dagona tshiakadi tshishale. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bualu ebu bakuidi ba Dagona anyi bakuabo bakadi balue mu nsubu wa Dagona kabena hadiata makasa ku tshibuelelu tshia Dagona mu Ashedodo tô ne lelu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tshianza tshia Yehowa tshiakadi ne bujitu kudi Bena Ashedodo, yeye wakababutula, wakabashiha ne masungu, Bena Ashedodo mene ne bakadi ku matshika abo kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Bena Ashedodo ne bualu budi nunku, bakambilangana ne, Mushete wa Nzambi wa Isalele kaushadi kutudi, bualu bua tshianza tshiandi tshiakulua bujitu hamʼbidi hetu ne ha Dagona, nzambi wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakatuma dî, bakabikila bakelenge bonso ba Bena Peleshete kudibo, bakabakonka ne, Netuenze tshinyi ne mushete wa Nzambi wa Isalele? Bakabakudimuna ne, Baye ne mushete wa Nzambi wa Isalele ku Gata. Bakayaku ne mushete wa Nzambi wa Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakenzabo nunku, tshianza tshia Yehowa tshiakalesha bena musoko au, ne tshiakabahita bikole; yeye wakashiha bantu ba mu musoko ne bakese ne banene, masungu akabakuata kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bobo bakatuma mushete wa Nzambi ku Ekelona. Hakaluabo ne mushete wa Nzambi ku Ekelona, Bena Ekelona bakadila ne, Bakalua ne mushete wa Nzambi wa Isalele kutudi bua kutubutuisha ne bana betu kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakatuma dî, bakabikila bakelenge ba Bena Peleshete, bakabambila ne, Numushe mushete wa Nzambi wa Isalele kutudi, uye ku muaba wau, kautushihi ne bana betu. Bualu bua bena musoko bakadi ne dikenga dikole, tshianza tshia Nzambi tshiakatamba kubanemena bujitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masungu akakuata bantu bakashala ne muoyo ne mu adi wa bena musoko wakafika mu diulu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
