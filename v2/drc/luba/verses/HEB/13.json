  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HEB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dinangangana dia bana babo ba ma Kilisto dikaleku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuhu muoyo bua kulesha benyi luse, bua bualu ebu bakuabo bakasangila banjelo, kabai babamanye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.2",
            "verseOrgIds": [
              "HEB.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuvuluke badi mu nkanu, bu munudi basuika nʼabo; nuvuluke badibo benzela bibi, bua nuenu nutshidi mu mibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibaka dikale dinemekibua munkatshi mua bantu bonso, bulalu kabunyanguki; Nzambi nealumbuluishe bena masandi bajike ne bena masandi babake. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mioyo yenu kaikadi ne lukuka lua biuma, nuikale ne disanka ne bintu binudi nʼabi, bualu bua Nzambi muine wakuamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.5",
            "verseOrgIds": [
              "HEB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuvuluke bantu bakanukokesha, bakanuambila dî dia Nzambi; nuela meshi a nshikidilu wa tshikadilu tshimpe tshia mioyo yabo, nuidikishe ditabusha diabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.7",
            "verseOrgIds": [
              "HEB.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu Kilisto udi muomumue makelela ne lelu ne tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.8",
            "verseOrgIds": [
              "HEB.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanusesuishibu ku mayisha a bungi ne a bende; budi buimpe bua mutshima ujadikibue ku ngasa, kenku bia kudia biakadi kabi bikuatshisha bakadi benda nʼabi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudi ne tshioshelu, tshidi badi bakuata mudimu mu tshitendelelu kabai bamanye mua kudiaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.10",
            "verseOrgIds": [
              "HEB.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua mibidi ya nyama, miena mashi adi muakuidi mimene ulua nʼau mu muaba wa tshijila bu mulambu wa kubuikidila nʼau mibi ya bantu idi yoshibua ku butshika kua tshitudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku, Yesu kabidi, bua kujidileye bantu ne mashi andi, wakakenga ha bule ha tshibi tshia musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku, tuye bietu kudiye kukala kua tshitudilu, batuala bihendu bia bualu buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua katuena ne musoko kunoku udi wikalaku tshiendelele, kadi tudi tukeba musoko ulualua. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
              "HEB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bua bualu buandi, tufilafile kudi Nzambi mulambu wa kumutumbisha nʼau, udi biau mamuma a mishiku idi ijukula ditabusha dia dina diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kanuhu muoyo bua kuenzelangana bimpe ne bua kukuatshishangana; bua Nzambi udi usanka ne milambu ya nunku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutumikile badi banukokesha, nubakokele; bua bobo badi bikale ne tshitabala bua mioyo yenu, bu bantu balua kubadila Nzambi bintu; bua bobo benze bualu ebu ne disanka, kabai ne manunganyi, bua bualu ebu kabuena bamukuatshisha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nutulombele Nzambi; bua tudi tuitabushishibua ne tudi ne mioyomikese mimpe, tudi basue kuenda bimpe mu malu onso. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.18",
            "verseOrgIds": [
              "HEB.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nusengelela bua nuenu kutamba kuenza bualu ebu, bua meme mpingishibue kunudi lubilu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wa ditalala wakabisha mulami munene wa mikoko munkatshi mua bafue kabidi ku mashi a dihungila dia tshiendelele, Mukelenge wetu Yesu mene, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "anuvuishe bakane tshishiki mu bualu buimpe buonso bua kuenza bu mu disua diandi, wenza munda muetu bualu budi buimpe ku mesu kuandi bita Yesu Kilisto; butumbi buikale kudiye ku bikondo ne ku bikondo. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, ndi nusengelela bua kunvua dî edi dia disengelela ne lutulu; bualu bua nakunufundila mei makese. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
              "HEB.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numanye bienu ne muanʼetu wa mu Kilisto Timote wakulekedibua mu lukanu; ne bialueye lubilu, nendue nʼandi kunumona.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
              "HEB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
              "HEB.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuele bonso badi banukokesha muoyo, ne basanto bonso kabidi. Ba mu Italia badi banutumina muoyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasa ikale ne buonso buenu. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.25",
            "verseOrgIds": [
              "HEB.13.25"
            ]
          }
        }
      ]
    }
