{
  "id": "MAT.13",
  "number": "13",
  "bookId": "MAT",
  "reference": "Matayo 13",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku adi Yesu wakaluhuka mu nsubu, wakashikama ku muelelu wa dishiba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bisumbu binene bia bantu biakamunguila, nunku yeye wakabuela mu buatu, wakashikama; bantu bonso bakimana ku muelelu wa mai. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila malu a bungi mu nsumuinu ne, Mumiaminyi wakaya bua kumiamina maminu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakadiye umiamina, maminu makuabo akamata kukala kua nshila, nyunyu yakalua, yakâzokola; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "makuabo akamata ha buloba buakadi ha mutu ha mabue, kâkadihu ne buloba bua bungi; tshituha tshihi akatoloka bua kâkadi ne buloba bule; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakabanda diba, akababuka, akafubidila bualu bua kâkadi ne miji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuabo akamata mu mionshi ya meba; mionshi yakadiunda, yakânye-ngela: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "makuabo akamata ha buloba buimpe, akavudisha maminu; makuabo lukama lukama, makuabo makumi asambombo asambombo, makuabo makumi asatu asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udi ne matshu unvue biandi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayidi bakalua, bakamukonka ne, Udi ubambidila malu mu nsumuinu tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabandamuna ne, Bakanuha bienu lungenyi lua kumanya malu a bukelenge bua mu diulu adi masokoka, kadi kabakabahalu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua muntu yonso udi ne bintu, nebamuhe binga, neikale ne bia bungi; kadi muntu yonso udi kai ne tshintu, nebamunyenge tshidiye nʼatshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebu budi bualu bundi mbambila malu mu nsumuinu; bua kumona badi bamona kadi kabena bamona bimpe; kunvua badi bunvua kadi kabena bunvua bimpe, kabena bajingulula bualu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakushikisha mayisha a muprofete Yeshaya akambeye ne,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabelela lusumuinu lukuabo ne, Bukelenge bua mu diulu budi bu muntu wakela biandi maminu mimpe mu budimi buandi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi hakadi bantu balale tulu, wakadi nʼandi lukuna wakalua, wakela ntete ya luhela muakamanabo kuela mponda, wakaya biandi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakatolokabi, hakatoyabi, luhela luakamueneka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahika ba muena budimi bakalua, bakamukonka ne, Mukelenge, wewe kuakuela maminu mimpe mu budimi buebe, anyi? Budi ne luhela munyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Muntu udi nʼanyi lukuna nguakuenza bualu ebu. Bahika bandi bakamukonka ne, Udi musue tuye kusunguila luhela, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Nasha! Bualu bua hanuikala usungulula luhela, nenutule mponda hohamue. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bubidi buabi bidiunde hohamue tô ne halua dia kunowa; halua dia kunowa, nengambile banowi ne, Diambedi nusungulule luhela nulusuike mu bisumbu bua kuluosha; hadi nusangishe mponda mu diyeba dianyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabelela lusumuinu lukuabo ne, Bukelenge bua mu diulu budi bu lutete lua mutada luakangata muntu bua kukuna mu budimi buandi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.31",
            "verseOrgIds": [
              "MAT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ludi lutamba ntete yonso bukese; kadi hadiundalu, ludi lutamba midioko yonso bunene, ludi ludiunda mutshi munene, nyunyu ya mulu idi ilua kuikila ha matamba au.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabelela lusumuinu lukuabo ne, Bukelenge bua mu diulu budi bu luevene luakangata mukashi, wakalusokoka mu bihikilu bisatu bia bukula tô ne hakenduluka luevene mu bukula buonso.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakambila bantu malu â onso mu nsumuinu, yeye kakabambila malu tshianana, anu mu nsumuinu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
            "verseOrgIds": [
              "MAT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua dî diakambabo kudi muprofete dishikishibue ne,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Yesu wakashîa bisumbu bia bantu ku nyima, wakabuela mu nsubu; bayidi bandi bakalua kudiye, bakamuambila ne, Utujinguluile lusumuinu lua luhela luakadi mu budimi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.36",
            "verseOrgIds": [
              "MAT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakandamuna ne, Udi ukuna maminu mimpe udi Muana wa muntu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.37",
            "verseOrgIds": [
              "MAT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "budimi budi bantu ba ha buloba; maminu mimpe adi bana ba mu bukelenge bua Nzambi, ntete ya luhela idi bana ba mubi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.38",
            "verseOrgIds": [
              "MAT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "muena lukuna wakaikuna ndiabolo; dituku dia kunowa nkunshikidilu kua tshikondo etshi; banowi mbanjelo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.39",
            "verseOrgIds": [
              "MAT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu mudi bantu basangisha luhela bua kuluosha, bualu nebuikale nunku kunshikidilu kua tshikondo etshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.40",
            "verseOrgIds": [
              "MAT.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa muntu neatume banjelo bandi, nebasungule mu bukelenge buandi benji ba malu mabi ne bintu bionso bidi bilenduisha bantu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.41",
            "verseOrgIds": [
              "MAT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebabiele mu tshikutu tshia kahia; muadi newikalemu ne kusumakana menu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.42",
            "verseOrgIds": [
              "MAT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku diadia bantu bakane nebakenke bu diba mu bukelenge bua Tatu wabo. Udi ne matshu unvue biandi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukelenge bua mu diulu kabidi budi bu biuma biakadi bisokoka mu budimi; hakabisangana muntu, yeye wakabisokoka kabidi; mu disanka diandi, wakaya, wakahana bintu biandi bionso, wakasumba budimi abu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukelenge bua mu diulu kabidi budi bu muntu udi biandi muendi wa mushinga, udi ukeba mabue mimpe a mushinga mukole; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.45",
            "verseOrgIds": [
              "MAT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakasanganeye dibue dia mushinga mutambe bukole, wakaya, wakahana bintu biandi bionso, wakadisumba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukelenge bua mu diulu kabidi budi bu kahamba kakadi kela mu dishiha, kakakungisha mishiha ya mishindu yonso; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.47",
            "verseOrgIds": [
              "MAT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakûla kahamba tente, bakakakoka ku mpata; bakashikama, bakasangisha biakadi bimpe mu bihanza, bakimasha biakadi bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
            "verseOrgIds": [
              "MAT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu nebuikale nunku kunshikidilu kua tshikondo etshi; banjelo nebalue, nebumushe bantu babi bakadi munkatshi mua bantu bakane, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.49",
            "verseOrgIds": [
              "MAT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebabele mu tshikutu tshia kahia, muadi newikalemu ne kusumakana menu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakabakonka ne, Nuakunyua malu â onso, anyi? Bakamuitaba ne, E. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Mufundi yonso wakuvui-shabo muyidi mu bukelenge bua mu diulu udi bu muena nsubu udi uhatula bintu bihia-bihia ne bikulukulu mu tshibutshilu tshiandi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikisha Yesu nsumuinu ei, wakumukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.53",
            "verseOrgIds": [
              "MAT.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakayeye mu luseke luandi, wakayisha bantu mu nsunagoga wabo, nunku bakakema ne, Muntu eu wakangata lungenyi elu ne malu â a kukema kudi kunyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.54",
            "verseOrgIds": [
              "MAT.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kena muana wa muena mabaya, anyi? Kabena babikila mamuʼandi ne, Malia, anyi? Bana babo ba balume Yakobo ne Yosefe ne Simona ne Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.55",
            "verseOrgIds": [
              "MAT.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bana babo ba bakashi, kabena munkatshi muetu, buonso buabo, anyi? Nunku muntu eu wakangata malu â onso kudi kunyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.56",
            "verseOrgIds": [
              "MAT.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalenduka bua bualu buandi. Kadi Yesu wakabambila ne, Muprofete udi ne butumbi mu miaba yonso, kadi kena nʼabu ku luseke luabo ne mu nsubu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kakenzamu malu a kukema a bungi bualu bua buhidia buabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
            "verseOrgIds": [
              "MAT.13.58"
            ]
          }
        }
      ]
    }
