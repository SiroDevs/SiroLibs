          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.5",
            "verseOrgIds": [
              "MAT.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi ne nsala ne nyota ya buakane badi ne disanka bua bobo nebûkute.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.6",
            "verseOrgIds": [
              "MAT.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.6",
            "verseOrgIds": [
              "MAT.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi ne luse badi ne disanka, bua bantu bakuabo nebabafue luse.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.7",
            "verseOrgIds": [
              "MAT.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.7",
            "verseOrgIds": [
              "MAT.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi ne mitshima mitoke badi ne disanka, bua bobo nebamone Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.8",
            "verseOrgIds": [
              "MAT.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basungi ba bantu badi ne disanka, bua nebabidike ne, Bana ba Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.9",
            "verseOrgIds": [
              "MAT.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakengeshibua bua buakane buabo badi ne disanka, bua bukelenge bua mu diulu budi buabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.10",
            "verseOrgIds": [
              "MAT.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuhendabo ne hanukengeshabo ne hanushiminyinabo mashimi onso, bua bualu buanyi, nenuikale ne disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.11",
            "verseOrgIds": [
              "MAT.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nusanke, nuikale ne disanka dingi, bualu bua difutu dienu didi mu diulu ndinene; bakakengesha baprofete nunku bakadi ku mpala kuenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.12",
            "verseOrgIds": [
              "MAT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nudi lueho lua buloba; hatshihala lueho kutua kualu, nebalutuishe kabidi ne tshinyi? Ludi tshianana, nebaluimashe, nebaludiate mu makasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.13",
            "verseOrgIds": [
              "MAT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nudi munya wa buloba. Kabena bamanye mua kusokoka musoko udi muasa ha mukuna. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.14",
            "verseOrgIds": [
              "MAT.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu kabatu batemesha muinda bua kûbuesha munshi mua mushete, batu bauteka ha mesa a muinda, utemene bantu bonso mu nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.15",
            "verseOrgIds": [
              "MAT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku munya wenu uteme ku mesu kua bantu, bamone midimu yenu mimpe, batumbishe kabidi Tatu wenu udi mu diulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.16",
            "verseOrgIds": [
              "MAT.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuedianganyi meshi ne, Nakuluila bua kushiha mikenshi ya Mose ne mei a baprofete; tshiakuluila bua kubishiha, nakuluila bua kubishikisha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.17",
            "verseOrgIds": [
              "MAT.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulelela, ndi nuambila ne, Tô ne hajimina diulu ne buloba, kaleta kamue kakese ka mikenshi ya Mose kakena kajimina ne katoba kamue kakese tô ne hashika malu onso akafundabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.18",
            "verseOrgIds": [
              "MAT.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Washiha mukenshi umue wa mu mikenshi ei idi mitambe butekete, ne wayisha bantu bakuabo nunku, nebamuidike ne, Mutambe bukese mu bukelenge bua mu diulu; kadi wayenza, ne wayisha bantu bakuabo nunku, nebamuidike ne, Munene mu bukelenge bua mu diulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.19",
            "verseOrgIds": [
              "MAT.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nuambila ne, Bikala buakane buenu kabui butambe bua bafundi ne bua Bafalese, kanuena nubuela mu bukelenge bua mu diulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.20",
            "verseOrgIds": [
              "MAT.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nuakunvua dî diakane Habo bantu ba kale ne, Kushihi muntu mukuabo; washiha muntu mukuabo nebamubande ku tshilumbuluidi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.21",
            "verseOrgIds": [
              "MAT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi meme ndi nuambila ne, Muntu yonso udi ne muanʼabo tshishi nebamubande ku tshilumbuluidi; muntu yonso wamhila muanʼabo ne, Laka, nebamubande kudi balumbuludi banene; muntu yonso wambila munga muntu ne, Wewe udi muhote, udi mua kukengeshibua mu Ngena wa kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.22",
            "verseOrgIds": [
              "MAT.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hautshidi ufila kuha kuebe ku tshishihelu ne biwavuluka ne, Muanʼetu udi nʼanyi bualu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.23",
            "verseOrgIds": [
              "MAT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ushîe kuha kuebe ku mpala kua tshishihelu, uye biebe, ulengeshe nʼandi; hashishe ulue, ufile kuha kuebe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.24",
            "verseOrgIds": [
              "MAT.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulengeshe ne udi nʼebe lukuna lukasa, hautshidi nʼandi mu nshila; biwikala kui wenza nunku, udi nʼebe lukuna neakufile mu bianza bia mulumbuludi, ne mulumbuludi neakufile mu bianza bia mpolushe, nebakuele mu nsubu wa lukanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.25",
            "verseOrgIds": [
              "MAT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulelela, ndi nkuambila ne, Kuena uluhukamu tô ne hawafuta dibanza dionso, nasha kakuta kakese kushala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakunyua dî diakambabo ne, Kuendi masandi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi meme ndi nuambila ne, Muntu yonso udi utangila mukashi ne lukuka lua masandi wakumana kuenda nʼandi masandi mu mutshima wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala disu diebe dia ku tshianza tshia balume dikulenduisha, wadiula, wadimasha; bualu bua kujimisha tshintu tshimue tshia mubidi webe kudi kutamba kuedibua kua mubidi webe wonso mu Ngena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biakulenduisha tshianza tshiebe tshia balume, watshikosa, watshimasha, bualu bua kujimisha tshintu tshimue tshia mubidi webe kudi kutamba kuya kua mubidi wonso mu Ngena. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuamba kabidi ne, Biahidia mulume mukashi wandi, ahe mukashi makanda wa kushiha dibaka; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.31",
            "verseOrgIds": [
              "MAT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi meme udi nuambila ne, Biahidia mulume mukashi wandi, kabui bua masandi, neamuvuishe amena masandi; wabaka mukashi muhidia nunku neikale muena masandi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabidi, nuenu nuakunyua dî diakambilabo bantu ba kale ne, Kuditshihi tshianana, wenzele Nzambi mitshihu yebe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.33",
            "verseOrgIds": [
              "MAT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi meme ndi nuambila ne, Kanuditshihi; ne kudi diulu, bualu bua diulu didi nkuasa wa butumbi wa Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.34",
            "verseOrgIds": [
              "MAT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kudi buloba, bualu bua buloba budi tshitekelu tshia makasa andi; ne kudi Yelushalema, bualu bua Yelushalema udi musoko wa Mukelenge Munene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.35",
            "verseOrgIds": [
              "MAT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe kuditshihi kudi mutu webe, bualu bua wewe kuena mumanye mua kuvuisha lusuki lumue anyi lutoke anyi lufike. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.36",
            "verseOrgIds": [
              "MAT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuikale ne dî ne, E, E, anyi Nasha, Nasha. Dî ditentekesha ha mutu didi difuma kudi bualu bubi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakunyua dî diakambabo ne, Disu ku disu, dinu ku dinu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.38",
            "verseOrgIds": [
              "MAT.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi meme udi nuambila ne, Kanuluanganyi ne muntu mubi; biakukuma muntu dihi ku ditama dia ku tshianza tshia balume, umuandamuine dia ku bakashi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.39",
            "verseOrgIds": [
              "MAT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biasua muntu kuya nʼebe ku tshilumbu bua kuangateye nshemise webe, angate ne kazaku kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.40",
            "verseOrgIds": [
              "MAT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biakuendesha muntu ntanta wa kilometa umue ku bukole, wende nʼandi ntanta wa kilometa ibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.41",
            "verseOrgIds": [
              "MAT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udi ukulomba tshintu umuhetshi, udi musue kukusomba tshintu kumukomi nyima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.42",
            "verseOrgIds": [
              "MAT.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakunyua dî diakambabo ne, Sua mukuenu, ikala ne udi nʼebe lukuna tshishi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
              "MAT.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi meme ndi nuambila ne, Suai badi nʼenu lukuna, lombelai badi banukengesha Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku nenuikale bana ba Tatu wenu udi mu diulu; bualu bua yeye utu wabandishila bantu babi ne bantu bimpe diba, yeye kabidi utu watumina bantu bakane ne bantu babi nvula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuasua badi banusue, nenuikale ne difutu kai? Basangishi ba mulambu mene kabatu benza nunku, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuakidila anu bana benu, nenuenze bualu budi butambe bua banga bantu kudi kunyi? Bantu ba bende kabatu benza nunku, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.47",
            "verseOrgIds": [
              "MAT.5.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 5:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nuenu nenuikale bakane bu mudi Tatu wenu wa mu diulu muakane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.48",
            "verseOrgIds": [
              "MAT.5.48"
            ]
          }
        }
      ]
    }
  ],
