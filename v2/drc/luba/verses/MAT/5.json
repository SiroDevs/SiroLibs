          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.3",
            "verseOrgIds": [
              "MAT.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi badila badi ne disanka, bua bobo nebasambibue.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.4",
            "verseOrgIds": [
              "MAT.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
