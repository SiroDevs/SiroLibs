  "copyright": "PUBLIC DOMAIN",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakabandamuna, wakabelela nsumuinu kabidi, wakamba ne, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukelenge bua mu diulu budi bu mukelenge wakalambishila muanʼandi bidia bia dibanji; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatuma bantu bandi bua kubikila bakalayileye diambedi bua disanka dia dibanji; bakahidia kulua. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.3",
            "verseOrgIds": [
              "MAT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakatuma bantu bandi bakuabo kabidi ne, Nuambile bantu banakalayila diambedi ne, Nakulongolola bidia, ngombe yanyi idi mishiha ne bana ba ngombe ba manyi, bintu, bionso biakuhua, luai ku disanka dia dibanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.4",
            "verseOrgIds": [
              "MAT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bobo bakalengulula di diandi, bakaya ku malu abo, mukuabo ku budimi buandi, mukuabo ku kuenda mushinga; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "banga bakakuata bantu ba mukelenge, bakabenzela bibi, bakabashiha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakadi ne tshishi, wakatuma masalayi andi, wakashiha batahianganyi aba, wakosha musoko wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.7",
            "verseOrgIds": [
              "MAT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, yeye wakambila bantu bandi ne, Bintu bia dibanji bidi bilongolola, kadi bantu banakulayila kabena bimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yai bienu mu masanga a misesu, nubikile banuamona ku disanka dia dibanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bandi bakaya mu misesu, bakasangisha bantu bonso bakamonabo, babi ne bimpe; mu nsubu wa disanka dia dibanji muakadi benyi tente. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakabuela mukelenge bua kumona benyi, wakamonamu muntu wakadi kai ne tshilulu tshia dibanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakamukonka ne, Ka, mulunda, wakubuela munomo, kui ne tshilulu tshia dibanji? Muntu wakahua. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.12",
            "verseOrgIds": [
              "MAT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakambila bantu bandi ne, Numusuike ku bianza ne ku makasa, numuimashe ha bula mu midima. Muadi newikalemu ne kusumakana menu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.13",
            "verseOrgIds": [
              "MAT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bantu ba bungi badi babikidibua, kadi banya-banya badi basungudibua.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Bafalese bakaya, bakasangisha mei abo ne, Netumukuate ku mei andi munyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatuma bayidi babo kudiye ne Bena Helode, bakamuambila ne, Muyishi, tudi bamanye ne, Wewe udi muena bushua, udi uyisha bantu nshila wa Nzambi bulelela, wewe kuena utshina bantu, bualu bua kuena ne bualu ne muntu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuambile mûdi wamba munda muebe: Mbimpe kuha Kaisa mulambu, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yesu wakamanya budimu buabo, wakabakonka ne, Nuenu bena lubombo, nudi nuntetshila munda tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nundeshe tshidibo balambula nʼatshi. Bakalua ne ndenalio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabakonka ne, Tshindidimbi etshi ne mei â adi mafundahu mbia nganyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuambila ne, Mbia Kaisa. Yeye wakabambila ne, Nuhe Kaisa bintu bia Kaisa, nuhe Nzambi bintu bia Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvuabo dî edi, bakakema, bakamushîa, bakaya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku adi Basadoke bakalua kudi Yesu, badi bamba ne, Dibika dia ku lufu kadienaku; bakamukonka ne, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyishi, Mose wakamba ne, Biafua mulume, kai ne bana, muanʼabo abake mukashi wandi, alelele muanʼabo wakufua bana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munkatshi muetu muakadi balume muanda mutekete ba difu dimue; wa kumudilu wakabaka mukashi, wakafua biandi, kakadi ne bana, wakashîa mukashi wandi mu bianza bia muanʼabo; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "muibidi wakadi nʼandi nunku, ne muisatu tô ne wa muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafua buonso buabo, mukashi wakafua. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume bakadi muanda mutekete; yeye neikale mukashi wa mulume kai, halua dibika dia ku lufu? Bualu bua bakadi nʼandi buonso buabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yesu wakabandamuna ne, Nudi nuhambuka, kanuena bamanye Mukanda wa Nzambi ne bukole buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dibika dia ku lufu, kabena babaka, kabena babakibua, badi bu banjelo ba mu diulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua dibika dia bafue ku lufu nuenu kanuakabala dî diakanuambila Nzambi, anyi, ne, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi bianyi Nzambi wa Abalahama, ne Nzambi wa Isaka, ne Nzambi wa Yakoba? Nzambi kena wa bafue, udi wa badi ne muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua bisumbu bia bantu dî edi, diyisha diandi diakabakemesha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Bafalese ne, Yesu wakahuisha Basadoke, bakadisangisha hamue. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munkatshi muabo muakadi mumanyi wa mikenshi, yeye wakakonka Yesu bua kumuteta munda ne, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyishi, mukenshi kai udi mutambe mikuabo yonso? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakamuambila ne, Sua Mukelenge Nzambi webe ne mutshima webe wonso ne muoyo webe wonso ne lungenyi luebe luonso. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ke mukenshi munene, udi wa kumudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muibidi udi mufuanangane nʼau ne, Sua mukuenu bu mûdi mudisue. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikenshi yonso ya Mose ne mei a baprofete bidi bikudika ku mikenshi ei ibidi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
            "verseOrgIds": [
              "MAT.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
