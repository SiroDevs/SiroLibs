          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge Yehowa wakandesha tshikena kumona etshi: Monai, yeye wakadi utuma mikumbi ku tshibangidilu tshia kutoloka kuibidi kua bia kudia; monai, kuakadi kutoloka kuakalonda bia kudia biakanowelabo mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikishayi kudia mashinde onso a ha buloba, nakamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
