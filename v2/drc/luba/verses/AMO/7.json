            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Amasaya, muakuidi wa ku Betele, wakatumina Yalobama, mukelenge wa Isalele, dî ne, Amosa wakulelela tshifufu tshibi munkatshi mua tshisamba tshia Bena Isalele; buloba kabuena mua kulama mei andi onso. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Amosa udi wamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
