              "type": "text"
            }
          ]
        },
        {
          "text": "Halua tshikondo atshi, bikala bantu dikumi mu nsubu umue, nebafue biabo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua muanʼabo ne muntu mufue bua kumuambula, yeye mene ngudi ne bua kuosha tshitalu tshiandi, ne hambeye kuhatula mifuba yandi ha mbelu, neakose munga muntu udi munda mua nsubu ne, Muntu mukuabo udi nʼebe, anyi? Wakonkeye nunku neitabe ne, Nansha. Hashishe, mukuabo neamuambile ne, Huwa biebe talalâ, bualu bua katuena bamanye mua kutela dina dia Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
