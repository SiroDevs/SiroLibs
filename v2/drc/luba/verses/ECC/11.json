              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umushe kanyinganyinga mu mutshima webe ne malu mabi a mubidi webe; bualu bua bikondo bia buana ne bunsongalume bidi hatuhu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
