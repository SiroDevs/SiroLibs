  "bookId": "LUK",
  "reference": "Luka 24",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "LUK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakatshia butuku dituku dia kumudilu dia lumingu, bakashi bakalua ku lukita ne bintu bia muhuya muimpe biakalongololabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.1",
            "verseOrgIds": [
              "LUK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasangana dibue diumusha ku mushiku wa lukita. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.2",
            "verseOrgIds": [
              "LUK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabuelamu, kabakasangana tshitalu tshia Mukelenge Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.3",
            "verseOrgIds": [
              "LUK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo balubakana bua bualu ebu, monai, balume babidi bakadi bimane ha buihi nʼabo baluate bilulu biengelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.4",
            "verseOrgIds": [
              "LUK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshinabo, hakatuabo mpala hanshi, balume bakabakonka ne, Nudi nukebela udi ne muoyo munkatshi mua bafue tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.5",
            "verseOrgIds": [
              "LUK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kena kunoko, wakubika; numiluke bu muakanuambileye hakadiye mu Galela ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Budi Muana wa muntu nʼabu mbua kumufilabo mu bianza bia bantu babi ne bua kumushihabo ku mutshi mutshiamakane ne bua kubikeye kabidi hahita matuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakavuluka mei andi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.8",
            "verseOrgIds": [
              "LUK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakumuka ku lukita, bakahiana, bakambila bayidi dikumi ne umue ne bakuabo bonso malu â onso. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.9",
            "verseOrgIds": [
              "LUK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashi aba bakadi Malia wa ku Magadala ne Yoana ne Malia mamu wa Yakobo; bakashi bakuabo kabidi bakadi nʼabo bakambila bapostolo malu â. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.10",
            "verseOrgIds": [
              "LUK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mei â akadi bu biakulakula ku matshu abo, kabakitabusha muakambabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.11",
            "verseOrgIds": [
              "LUK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Petelo wakabika, wakaya lubilu ku lukita; wakinangila, wakatangilamu, wakamona bilulu bia line ha buabi; wakahingana kuandi ukema bua malu au.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku adi mene babidi babo bakadi baya ku musoko dina diau Emau, ku Yelushalema ne ku musoko au kuakadi ntanta bu kilometa dikumi ne umue. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.13",
            "verseOrgIds": [
              "LUK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakadi bayikila bua malu â onso akalua. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.14",
            "verseOrgIds": [
              "LUK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo bayikila bakonkangana, Yesu mene wakalua nʼabo ha buihi, wakenda nʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.15",
            "verseOrgIds": [
              "LUK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mesu abo akadi bitayitayi, kabakamumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabakonka ne, Nudi nuenda nuyikidila tshinyi? Bobo bakimana babungame. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuabo, dina diandi Keleopa, wakamukonka kabidi ne, Ahu wewe udi muenyi udi usomba ha nkayebe mu Yelushalema kui mumanye malu akulua matuku â? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.18",
            "verseOrgIds": [
              "LUK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabakonka ne, Malu kai? Bakamuambila ne, Malu a Yesu, Muena Nazaleta, wakadi biandi muprofete mukole mu bienzedi ne mu mei ku mpala kua Nzambi ne kua bantu bonso; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakuidi banene ne miloho yetu bakamufila bua kumuhishabo ne lufu, ne bua kumushihabo ku mutshi mutshiamakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.20",
            "verseOrgIds": [
              "LUK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tuetu tuakadi bamutekemene ne, Nyeye wahikula Isalele! Ne bualu bukuabo kabidi, matuku asatu akuhita akalua malu â. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.21",
            "verseOrgIds": [
              "LUK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bualu bukuabo bakashi bakuabo ba mu tshisumbu tshietu bakadi ku lukita dindadinda bakatukemesha; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.22",
            "verseOrgIds": [
              "LUK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakahangabo kumona tshitalu tshiandi, bakahingana, bakamba ne, Tuakumona bikena kumona bu banjelo bakatuambila ne, Yeye udi ne muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.23",
            "verseOrgIds": [
              "LUK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuabo bakadi nʼetu bakaya ku lukita, bakasangana bualu bu muakamba bakashi; kadi kabakamumona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakabambila ne, Nuenu bantu kabai ne lungenyi, nudi nunenga ha kuitabusha mei onso akamba baprofete! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.25",
            "verseOrgIds": [
              "LUK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabiakadi bimpe bia Kilisto kukengeye mu malu â ne bua kubueleye mu butumbi buandi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.26",
            "verseOrgIds": [
              "LUK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabangila ku Mose ne ku baprofete bonso, wakabajinguluila malu akafundabo mu Mukanda wa Nzambi wonso bualu buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafikabo ha buihi ne musoko wakadibo baya, yeye wakamba kuhita. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.28",
            "verseOrgIds": [
              "LUK.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamusengelela bikole ne, Ulale nʼetu kunoko; bualu bua diba dikadi dibuela, munya ukadi ushika. Yeye wakaya kulala nʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.29",
            "verseOrgIds": [
              "LUK.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikameye nʼabo ku mesa, wakamema mutanda wa bidia, wakatendelela Nzambi: hakautshibuleye bituha, wakabahabi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.30",
            "verseOrgIds": [
              "LUK.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesu abo akabuluka, bakamumanya; yeye wakabajimina ku mesu kuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambilangana ne, Mitshima yetu kayakadi itema munda muetu, anyi, hakadiye utuambila malu mu nshila, hakadiye utujinguluila Mukanda wa Nzambi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabika ha diba adi mene, bakahingana mu Yelushalema, bakasangana bayidi dikumi ne umue badisangishe hohamue ne bakuabo bakadi nʼabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakamba ne, Mukelenge wakubika ku lufu bulelela, wakumueneka kudi Simona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabalondela malu akanjibua mu nshila ne muakadiye mumanyibue kudibo mu kutshibula kua bidia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo bamba mei â, yeye mene wakimana munkatshi muabo, wakabambila ne, Nuikale talala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.36",
            "verseOrgIds": [
              "LUK.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mitshima yabo yakabandika, bakatshina, bakelangana meshi ne, Tudi lutangila mukishi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.37",
            "verseOrgIds": [
              "LUK.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabakonka ne, Nudi nutshinyina tshinyi? Makonka adi ajuka mu mitshima yenu bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.38",
            "verseOrgIds": [
              "LUK.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai bianza bianyi ne makasa anyi ne, Meme muine; nundenge bianza, nutangile, bualu bua mukishi kena ne munyinyi ne mifuba binudi nuntangila nʼabi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabambileye dî edi, wakabalesha bianza biandi ne makasa andi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.40",
            "verseOrgIds": [
              "LUK.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo kabai banze kuitabusha bualu bua disanka diabo, hakadibo bakema, yeye wakabakonka ne, Nudi ne tshintu tshia kudia kunoko, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.41",
            "verseOrgIds": [
              "LUK.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuhesha tshihesa tshia mushiha mukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.42",
            "verseOrgIds": [
              "LUK.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakatshiangata, wakatshidia ku mesu kuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabambila ne, Â adi mei anyi anakanuambila hanakadi nʼenu, ne, Budibo nʼabu mbua kushikisha malu onso akafundabo bualu buanyi mu mikenshi ya Mose ne mu luseke lua baprofete ne mu misambu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe yeye wakabulula mitshima yabo bua kujingululabo Mukanda wa Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Bakafunda ne, Mbimpe bia Kilisto kukengeye ne kubikeye ku lufu hahita matuku asatu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.46",
            "verseOrgIds": [
              "LUK.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbimpe kabidi bia kuambilabo bisamba bionso bualu bua kukudimuna kua mitshima ne bua kujimishibua kua mibi yabo mu dina diandi, babangile ku Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.47",
            "verseOrgIds": [
              "LUK.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nudi bamanyi ba malu â. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.48",
            "verseOrgIds": [
              "LUK.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, ndi nutumina mulayi wa Tatu wanyi; kadi nushale mu musoko eu tô ne hanuluatshishabo bukole bua mu diulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakabalombola tô ne ku muaba wakadi buludiludi ne Betania; wakabisha bianza biandi, wakabasankisha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadiye ubasankisha nunku, wakumuka kudibo, wakatuadibua mu diulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamutendelela, bakahingana ku musoko ne disanka dinene; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 24:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakadi mu ntempelo ku dituku ne ku dituku batumbisha Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.53",
            "verseOrgIds": [
              "LUK.24.53"
            ]
          }
        }
      ]
    }
