          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuabo kabidi wakamuambila ne, Mukelenge, nenkulonde; kadi witabushe bua meme nganje kuya diambedi kulaya badi mu nsubu muanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.61",
            "verseOrgIds": [
              "LUK.9.61"
            ]
          }
        },
