              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakamuambila ne, Shîa bafue bajike bafue babo; kadi wewe ya biebe, umanyishe bantu bualu bua bukelenge bua Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.60",
            "verseOrgIds": [
              "LUK.9.60"
            ]
          }
