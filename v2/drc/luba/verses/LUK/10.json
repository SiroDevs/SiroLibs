              "LUK.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakamukudimuna dî ne, Muntu wakabika mu Yelushalema, wakadi uhueka ku Yeleko; wakatukidila mu bianza bia banyengi, bakamuvula bilulu biandi, bakamukuma, bakaya, bakamushîa ne tshioyoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi wa Nzambi wakadi uhueka mu nshila au; hakamoneye muntu, wakahitshila ku luseke lukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.31",
            "verseOrgIds": [
              "LUK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muena Lewi muomumue, hakalueye ku muaba au, hakamumoneye, wakahitshila ku luseke lukuabo kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.32",
            "verseOrgIds": [
              "LUK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Muena Samalea wakadi ulua mu nshila, wakalua kudiye; hakamumoneye, luse luakamukuata, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.33",
            "verseOrgIds": [
              "LUK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakalua kudiye, wakamujingila tshilulu ha mputa, wakelabu manyi ne nvinyo; wakamushikika ha nyima ha nyama wandi, wakalua nʼandi ku nsubu wa tshilala benyi, wakamulama bimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.34",
            "verseOrgIds": [
              "LUK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu wakahatula ndenalio ibidi, wakaha umena nsubu wa tshilala benyi, wakamuambila ne, Umulame bimpe; hanahingana, nenkuhingishile binga bintu biwahana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.35",
            "verseOrgIds": [
              "LUK.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu aba basatu, wewe udi wela meshi ne, Muena kuabo ne wakatukidila mu bianza bia banyengi nganyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.36",
            "verseOrgIds": [
              "LUK.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakakudimuna di ne, Wakamufua luse. Yesu wakamuambila ne, Ya biebe wenze muomumue.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo baya mu nshila, Yesu wakafika ku musoko mukuabo; mukashi wakadimu, dina diandi Mâta, wakamubuesha mu nsubu muandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.38",
            "verseOrgIds": [
              "LUK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakadi ne muakunyiʼandi mukashi dina diandi Malia, yeye wakadi mushikame ku makasa a Mukelenge, ulelesha dî diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.39",
            "verseOrgIds": [
              "LUK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Mâta wakadi utata ne mudimu wa bungi wa mu nsubu; yeye wakalua kudi Yesu, wakamukonka ne, Mukelenge, kuena ubenga bua muakunyiʼanyi anshile mudimu nkayanyi, anyi? Umuambile alue kunkuatshisha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakamuandamuna ne, Mâta, Mâta, wewe udi utamba kuela meshi a malu a bungi adi akutatshisha; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "tudi anu ne tshintu tshimue bualu; Malia wakusungula luseke ludi luimpe, kabena bamanye mua kumunyengalu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.42",
            "verseOrgIds": [
              "LUK.10.42"
            ]
          }
        }
      ]
    }
