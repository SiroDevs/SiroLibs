          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bantu ba bungi bakabanga kufunda malu au akenjibua munkatshi muetu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.1",
            "verseOrgIds": [
              "LUK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatuambilabo kudi bamonyi ne benji badi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.2",
            "verseOrgIds": [
              "LUK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakuelangana meshi munda, Mukelenge Teofilo, ne, Mbimpe bia meme kabidi kukufundila malu au malondolola biakane, bualu bua meme nakualonda bimpe ku tshibangidilu tshiau tô ne katataka; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.3",
            "verseOrgIds": [
              "LUK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua wewe umanye ne, Malu akukumanyishabo adi malelela.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku a Helode, mukelenge wa Yudaya, muakuidi wa Nzambi wakadiku, dina diandi Zakâya, wakadi wa mu mulongo wa Abiya; mukashi wandi wakadi wa mu bana bakashi ba Alona, dina diandi Elisabeta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.5",
            "verseOrgIds": [
              "LUK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bubidi buabo bakadi bakane ku mesu kua Nzambi, bakadi balonda mikenshi yonso ya Mukelenge ne mei andi, kabakadi ne bualu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.6",
            "verseOrgIds": [
              "LUK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabakadi ne muana, bualu bua Elisabeta wakadi nkumba, bubidi buabo bakadi banunu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku hakadiye wenza mudimu wandi wa buakuidi ku mesu kua Nzambi mu mulongo wandi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.8",
            "verseOrgIds": [
              "LUK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bu muakadi tshilele tshia mudimu wa bakuidi, yeye wakasungudibua bua kubueleye mu ntempelo wa Mukelenge bua kuosha musenga wa mananashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.9",
            "verseOrgIds": [
              "LUK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafika diba dia kuosha musenga wa mananashi, tshisumbu tshionso tshia bantu tshiakadi tshitendelela Nzambi ku mbelu kua ntempelo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.10",
            "verseOrgIds": [
              "LUK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wa Mukelenge wakamueneka kudiye, muimane ku tshianza tshia balume tshia tshioshelu tshia mananashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.11",
            "verseOrgIds": [
              "LUK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutshima wa Zakâya wakahandika hakamumoneye, buowa buakamukuata. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.12",
            "verseOrgIds": [
              "LUK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi muanjelo wakamuambila ne, Zakâya, kutshinyi, bualu bua bakunvua kulomba kuebe, mukashi webe Elisabeta neakulelele muana, neumuidike ne, Yone. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.13",
            "verseOrgIds": [
              "LUK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe newikale ne diese ne disanka; bantu ba bungi nebasanke bualu bua kuledibua kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.14",
            "verseOrgIds": [
              "LUK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neikale muntu munene ku mesu kua Mukelenge; kanu biandi nvinyo ne bintu bidi bikuatangana; yeye neûshibue tente ne Nyuma Muimpe diambedi mamu wandi kai muanze kumulela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.15",
            "verseOrgIds": [
              "LUK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neakudimushe mitshima ya bana ba Isalele ba bungi kudi Mukelenge Nzambi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.16",
            "verseOrgIds": [
              "LUK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neaye ku mpala kuandi ne nyuma ne bukole bia Eliya, bualu bua kuhingisha mitshima ya batatu kudi bana, ne bua kualukisha bena buhidia ku meshi a badi bakane; ne bua kulongoluela Mukelenge bantu badi ne mitshima yabo mimana kulongolola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.17",
            "verseOrgIds": [
              "LUK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakâya wakakonka muanjelo ne, Nemanye bualu ebu munyi? Bualu bua meme ndi muntu mununu, ne mukashi wanyi udi ne bidimu bia bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.18",
            "verseOrgIds": [
              "LUK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wakamuandamuna ne, Ndi bianyi Gabaliele, ntu ngimana ku mesu kua Nzambi; nakutumibua bua kuakula nʼebe ne bua kukuluila ne lumu luimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.19",
            "verseOrgIds": [
              "LUK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangila, wewe neuhue, kuena umanya mua kuakula tô ne halua dituku dialua malu â, bualu bua wewe kuakuitabusha mei anyi, neajalame dituku dialua malu au.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakadi bindila Zakâya, bakakema bualu bua yeye wakanenga musangu mule mu ntempelo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.21",
            "verseOrgIds": [
              "LUK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaluhukeye, kakamanya mua kuakula nʼabo; bakamanya ye, Yeye wakumona tshikena kumona mu ntempelo; wakadi wakula nʼabo ne bianza biandi, wakashala kamama, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.22",
            "verseOrgIds": [
              "LUK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashika matuku a mudimu wandi, wakaya kuandi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku â, Elisabeta wakimita difu; yeye wakadisokoka ngondo itanu, wakamba ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.24",
            "verseOrgIds": [
              "LUK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakungenzela bimpe nunku, mu matuku akadiye untangila, bualu bua kumusha bundu buanyi munkatshi mua bantu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngondo muisambombo muanjelo Gabaliele wakatumibua kudi Nzambi mu musoko wa Galela, dina diau Nazaleta, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.26",
            "verseOrgIds": [
              "LUK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kudi mukashi wakatshidi kamama, mubangila kudi mulume, dina diandi Yosefe, wa mu tshiota tshia Davidi; dina dia mukashi au Malia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.27",
            "verseOrgIds": [
              "LUK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wakalua kudiye, wakamba ne, Muoyo, bakukufuila luse lua bungi, Mukelenge udi nʼebe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.28",
            "verseOrgIds": [
              "LUK.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakatamba kutshina bualu bua dî edi, wakelangana meshi munda ne, Eu muoyo mungelela tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.29",
            "verseOrgIds": [
              "LUK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wakamuambila ne, Malia, kutshinyi; wewe wakusangana luse kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.30",
            "verseOrgIds": [
              "LUK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona, wewe newimite difu, neulele muana mulume, neumuidike ne, Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.31",
            "verseOrgIds": [
              "LUK.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye neikale munene, nebamuidike dina ne, Muana wa Udi Mutambe Bunene wa mu diulu; Mukelenge Nzambi neamuhe nkuasa wa butumbi wa tatu wandi Davidi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.32",
            "verseOrgIds": [
              "LUK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "neikale mukelenge wa nsubu wa Yakoba tshiendelele; bukelenge buandi kabuena ne tshishikidilu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.33",
            "verseOrgIds": [
              "LUK.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.33",
            "verseOrgIds": [
              "LUK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malia wakakonka muanjelo ne, Bualu ebu nebulue munyi, meme tshi muanze kumanya mulume? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.34",
            "verseOrgIds": [
              "LUK.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wakamuandamuna ne, Nyuma Muimpe nealue kûdi, ne bukole bua Udi Mutambe Bunene wa mu diulu nebukubuikile bu ditutu; nebidike muana wa tshijila uwalela ne, Muana wa Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.35",
            "verseOrgIds": [
              "LUK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona, Elisabeta, mukashi wa mu tshiota tshienu, yeye kabidi, wakuimita difu dia muana mulume ku bununu buandi; bakadi bamuamba ne, Udi nkumba, kadi ngondo eu nguandi muisambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.36",
            "verseOrgIds": [
              "LUK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua kakuena dî dimue dia Nzambi didi kadî ne bukole. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.37",
            "verseOrgIds": [
              "LUK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malia wakamba ne, Mona, mukashi muhika wa Mukelenge; bangenzele bu muwakuamba. Muanjelo wakamushîa, wakaya biandi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku â Malia wakabika, wakaya lukasa mu buloba bua mikuna, mu musoko wa Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.39",
            "verseOrgIds": [
              "LUK.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakabuela mu nsubu wa Zakâya, wakela Elisabeta muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.40",
            "verseOrgIds": [
              "LUK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Elisabeta muoyo wakamuela Malia, muana wakatabuluka mu difu diandi; Elisabeta wakûshibua tente ne Nyuma Muimpe; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.41",
            "verseOrgIds": [
              "LUK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakela dî diandi bikole, wakamba ne, Wewe udi mukashi mutambe kusankishibua, muana udi munda muebe udi muvudishila disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.42",
            "verseOrgIds": [
              "LUK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu ebu buakulua kundi munyi, bua mamu wa Mukelenge wanyi wakulua kundi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.43",
            "verseOrgIds": [
              "LUK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakubuela dî dia muoyo uwakungela mu matshu anyi, muana wakutabuluka mu difu dianyi bualu bua disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.44",
            "verseOrgIds": [
              "LUK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukashi wakitabusha udi ne disanka, bua nebashikishe malu onso akamuambilabo kudi Mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.45",
            "verseOrgIds": [
              "LUK.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malia wakamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.46",
            "verseOrgIds": [
              "LUK.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 1:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.55",
            "verseOrgIds": [
              "LUK.1.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malia wakasomba nʼandi bu ngondo isatu, wakahingana kuabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 1:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngondo ya Elisabeta yakakumbana ya kuleleye, yeye wakalela muana mulume. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.57",
            "verseOrgIds": [
              "LUK.1.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuandi ne bena tshiota tshiandi bakunvua ne, Nzambi wakumuvudishila luse luandi: bakasanka nʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 1:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua dituku dia muanda mukulu, bakalua kutengula muana; bakamba kumuidika ne, Zakâya, bu dina dia tatuʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 1:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamuʼandi wakandamuna ne, Nasha, bamuidike ne, Yone. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.60",
            "verseOrgIds": [
              "LUK.1.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 1:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuambila ne, Kakuena umena tshiota tshienu udi muidika dinu edi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.61",
            "verseOrgIds": [
              "LUK.1.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 1:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakidikishila tatuʼandi bianza ne, Udi musue bamuidike dina kai? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.62",
            "verseOrgIds": [
              "LUK.1.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "LUK 1:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakalomba mukanda wa kufundahu, wakafunda ne, Dina diandi Yone. Buonso buabo bakakema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.63",
            "verseOrgIds": [
              "LUK.1.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "LUK 1:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukana muandi muakabuluka lubilu, ludimi luandi luakambuluka, wakakula utumbisha Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.64",
            "verseOrgIds": [
              "LUK.1.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "LUK 1:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buowa buakakuata bantu bonso bakadi ha buihi nʼabo; malu â onso akadi enda ambibua mu buloba buonso bua mikuna ya Yudaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.65",
            "verseOrgIds": [
              "LUK.1.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso bakaunvua bakâteka mu mitshima yabo, bakakonka ne, Eu muana neikale muana kai? Bualu bua tshianza tshia Mukelenge tshiakadi nʼandi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatuʼandi Zakâya, mûshibue tente ne Nyuma Muimpe, wakamba malu akadi kâi manze kulua ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "LUK 1:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batumbishe Mukelenge, Nzambi wa Isalele,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.68",
            "verseOrgIds": [
              "LUK.1.68"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "79",
            "style": "v",
            "sid": "LUK 1:79"
          },
          "items": [
            {
              "text": "79",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.79",
            "verseOrgIds": [
              "LUK.1.79"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "80",
            "style": "v",
            "sid": "LUK 1:80"
          },
          "items": [
            {
              "text": "80",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wakadiunda, wakakola mu mutshima wandi, wakadi biandi mu bihela tô ne ku dituku diakamuenekeye kudi Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.80",
            "verseOrgIds": [
              "LUK.1.80"
            ]
          }
        }
      ]
    }
