              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nuambila ne, Butuku abu balume babidi nebikale mu bulalu; nebangate munga, nebashie mukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
