  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JDG 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume bonso ba mu Isalele hakamana kuditshiha ku Misepa ne, Nansha umue wetu kafidi muanʼandi mukashi kudi Muena Benyamina bu mukashi wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.1",
            "verseOrgIds": [
              "JDG.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakadisangisha ku Betele, bakashikamaku ku mpala kua Nzambi tô ne dilolo, bakabisha dî diabo, bakadila bikole. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.2",
            "verseOrgIds": [
              "JDG.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamba ne, Yehowa, Nzambi wa Bena Isalele, bualu ebu buakulua munyi, bua tshisamba tshimue katshiyi munkatshi mua Bena Isalele lelu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.3",
            "verseOrgIds": [
              "JDG.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu, bantu bakabika ne dinda dionso, bakasaku tshioshelu, bakafua milambu ya kuosha ne milambu ya kubavuisha ditalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.4",
            "verseOrgIds": [
              "JDG.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakamba ne, Nganyi wa munkatshi mua bisamba bia Bena Isalele wahidia kulua ku disangisha dia Yehowa? Bualu bua bobo bakadi baditshiha ne kuditshiha kukole ne, Wahidia kulua kudi Yehowa ku Misepa neafue bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.5",
            "verseOrgIds": [
              "JDG.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakakudimuna mitshima yabo bualu bua Bena Benyamina, bana babo, bamba ne, Tshisamba tshimue tshidi tshiumushibua munkatshi mua Bena Isalele lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.6",
            "verseOrgIds": [
              "JDG.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyi mutuangatshila badi bashala bujike bakashi, bualu bua tuetu tuakamana kuditshiha ne, Katuena tuhia bana betu bakashi kudibo bu bakashi babo?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.7",
            "verseOrgIds": [
              "JDG.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.7",
            "verseOrgIds": [
              "JDG.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakemangana ne, Tshisamba kai tshia Bena Isalele tshidi katshiyi tshitua kudi Yehowa ku Misepa? Ne monai, nansha muetu umue wa mu tshitudilu tshia Yabesha-gilada wakalua ku disangisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.8",
            "verseOrgIds": [
              "JDG.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua hakabalabo bantu, monai, kakuakadi umue wa munkatshi mua Bena Yabesha-gilada. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.9",
            "verseOrgIds": [
              "JDG.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakadi mu disangisha bakatumaku balume ba bukitu binunu dikumi ne bibidi, bakabambila ne, Yai bienu, nushihe Bena Yabesha-gilada ne miele ya nvita, ne bakashi ne bana bakese. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebu mbualu bunudi ne bua kuenza: nushihe mulume yonso ne mukashi yonso wakamana kulala ne mulume. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
            "verseOrgIds": [
              "JDG.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasangana munkatshi mua Bena Yabesha-gilada bakashi nkama inai bakatshidi tumama, kabakadi bamanyibue kudi mulume; bakalua nʼabo ku tshitudilu tshia mu Shilo, tshidi mu buloba bua Kanâna.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.12",
            "verseOrgIds": [
              "JDG.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.12",
            "verseOrgIds": [
              "JDG.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena disangisha bonso bakatumina Bena Benyamina bakadi ku dibue dia Limona dî dia kubadisha nʼadi ditalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.13",
            "verseOrgIds": [
              "JDG.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Benyamina bakahingana ku tshikondo atshi; bakabaha bakashi bakakuatabo ne muoyo ku Yabesha-gilada; kadi kabakabakumbana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.14",
            "verseOrgIds": [
              "JDG.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakakudimuna mitshima yabo bualu bua Bena Benyamina bualu bua Yehowa wakabayuisha batahuluki kudi bisamba bia Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, bakulu ba mu disangisha diabo bakamba ne, Munyi mutuangatshila badi bashala bakashi, bualu bua bakashi ba mu Benyamina bakabutudibua? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.16",
            "verseOrgIds": [
              "JDG.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamba ne, Butudi nʼabu mbua kuha Bena Benyamina badi bashala buhianyi, bua tshisamba tshimue katshijiminyi munkatshi mua Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.17",
            "verseOrgIds": [
              "JDG.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi katuena mua kubaha bana betu bakashi; bualu bua Bena Isalele hakamana kuditshiha ne, Muntu udi ufila muanʼandi mukashi kudi Muena Benyamina udi ne mulau. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.18",
            "verseOrgIds": [
              "JDG.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamba ne, Monai, batu badia bia kudia bia disanka dia Yehowa ku tshidimu ku tshidimu ku Shilo udi ku node kua Betele ne ku esete kua nshila udi mubande ku Betele muye ku Shekeme, ne udi ku sude kua Lebona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.19",
            "verseOrgIds": [
              "JDG.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambila Bena Benyamina ne, Yai bienu, nualamine mu madimi a tumuma tukese; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.20",
            "verseOrgIds": [
              "JDG.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "numone ne halua bana bakashi ba mu Shilo bua kujabo maja, nuluhuke mu madimi a tumuma tukese, ne muntu ne muntu adiangatshile mukashi wandi munkatshi mua bana bakashi ba mu Shilo, aye biandi mu buloba bua Benyamina. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.21",
            "verseOrgIds": [
              "JDG.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, bialua batatuʼabo anyi bana babo kutudi bua kutandangana nʼetu, netubambile ne, Nubafile kutudi bu matabisha bualu bua tuetu katuakubangatshila, muntu ne muntu, mukashi mu nvita, ne nuenu kanuakabahabo; bu nuenu babahebo, nuenu nuakadi kuhila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.22",
            "verseOrgIds": [
              "JDG.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Benyamina bakenza nunku, bakadiangatshila bakashi bakabakumbana bungi buabo ba munkatshi mua bakadi baja maja, bakakuatabo; bakaya nʼabo, bakahingana ku buhianyi buabo, bakasa misoko, bakashikamamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.23",
            "verseOrgIds": [
              "JDG.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakumukaku mu tshikondo atshi, bakaya muntu ne muntu ku tshisamba tshiandi ne ku tshiota tshiandi; bakumukaku, muntu ne muntu wakaya ku buhianyi buandi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.24",
            "verseOrgIds": [
              "JDG.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.24",
            "verseOrgIds": [
              "JDG.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku au kamuakadi mukelenge mu Isalele; muntu ne muntu wakenza anu malu akadi mimpe ku mesu kuandi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
        }
      ]
    }
  ],
