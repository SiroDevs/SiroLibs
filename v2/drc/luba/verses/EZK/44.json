        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabikadi ne buhianyi, bualu bua meme ndi buhianyi buabo; kanubahi luhetu mu Isalele, bualu bua meme ndi luhetu luabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badie mulambu wa bia kudia, mulambu wa kubuikila nʼau bubi ne mulambu wa kumusha nʼau dihila; tshintu tshionso tshidibo bajidila kudi Nzambi mu buloba bua Isalele tshikale tshiabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bidi bihita buakane munkatshi mua bintu binudi nuhuola diambedi, ne maha a munkatshi mua bintu bionso binudi nufila kudi Nzambi, bikale bintu bia bakuidi. Nuheshe bakuidi bukula buhite buimpe bua mampa anudi milamba, bua disanka dikale mu nsubu muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuidi kabadi tshintu tshidifuila anyi tshituanya, kudi nyunyu anyi kudi nyama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
      ]
