          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nenumuke bilele Dienu bibi, ne bienzedi bienu biakadi kabiyi biakane; malu enu mabi ne a bundu neanutonde mene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.31",
            "verseOrgIds": [
              "EZK.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge Yehowa udi wamba ne, Numanye muanda eu ne, Tshiena ngenza malu â bua bualu buenu, nukuatshike bundu, nudihuekeshe bua bienzedi bienu, nuenu Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        }
