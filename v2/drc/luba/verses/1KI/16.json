    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kudi Yehu, muana wa Hanani, bualu bua Bâsha ne, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua meme nakakubisha ha buloba, nakakusungula mukelenge ku mutu kua bantu banyi Bena Isalele, ne bua wewe wakalonda anu mu nshila wa Yalobama, wakenzesha bantu banyi Bena Isalele malu mabi, bua kunfuisha tshiji ne malu mabi abo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku meme nembutule Bâsha ne bonso ba mu nsubu wandi: nenvuishe ba mu nsubu webe bu munakenzela ba mu nsubu wa Yalobama, muana wa Nebata. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbua neyidie muntu yonso wa mu nsubu wa Bâsha udi ufuila mu musoko; ne nyunyu ya mulu neyizokole muntu yonso wa mu nsubu wandi udi ufuila mu tshisuku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bia Bâsha bikuabo ne malu onso akenzeye ne bukole buandi kabiena bifunda mu mukanda wa kulondolola kua malu a bakelenge ba Isalele, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bâsha wakalala tulu ne bankambua bandi, bakamujika mu Tîsa; Ela, muanʼandi mulume, wakakokesha mu muaba wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kudi muprofete wandi Yehu, muana wa Hanani, bualu bua Bâsha ne bua ba mu nsubu wandi, bua malu mabi akenzeye ku mesu kua Yehowa ne bu muakamufuisheye tshiji bu muakenza ba mu nsubu wa Yalobama; bua malu au yeye wakamushiha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia makumi abidi ne bisambombo tshia bukelenge bua Asa, mukelenge wa Yuda, Ela, muana wa Bâsha, wakabanga kukokesha Bena Isalele mu Tîsa; wakabakokesha bidimu bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wandi Zimeli, kapitene ka tshituha tshia makalu andi, wakamuelela tshifufu: yeye wakadi mu Tîsa mukuatshike maluvu mu nsubu wa Âsa wakadi ku mutu kua nsubu wandi mu Tîsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimeli wakabuela mu nsubu, wakamushiha mu tshidimu tshia makumi abidi ne muanda mutekete tshia bukelenge bua Asa, mukelenge wa Yuda; wakakokesha mu muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahinganeye mu bukelenge, ne hakabangeye kushikama mu nkuasa wa bukelenge, yeye wakashiha bonso ba mu nsubu wa Bâsha; kakashiya muana mulume mu nsubu wandi, nansha mu nsubu ya bana babo nansha mu nsubu ya balunda bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Zimeli wakashiha bonso ba mu nsubu wa Bâsha: bu mu dî dia Yehowa diakambeye mukana mua Yehu muprofete bualu bua Bâsha; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua malu mabi a Bâsha ne a muanʼandi Ela akenzabo ne akenzeshabo Bena Isalele, bua kufuishabo nʼau Yehowa, Nzambi wa Isalele, tshiji bua mpingu yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bia Ela bikuabo biakenzeye ne malu onso akenzeye kabiena bifunda mu mukanda wa kulondolola kua malu a bakelenge ba Isalele, anyi?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia makumi abidi ne muanda mutekete tshia bukelenge bua Asa, mukelenge wa Yuda, Zimeli wakakokesha mu Tîsa matuku muanda mutekete. Bantu bakasa tshitudilu tshiabo bua kuluisha Bena Gibetona, mu buloba bua Bena Peleshete. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena nvita ba mu tshitudilu bakunvua lumu ne, Zimeli wakela tshifufu, wakashiha mukelenge wetu; nunku Bena Isalele bonso bakasungula Omeli, kapitene ka masalayi abo, mukelenge ku mutu kua Bena Isalele dituku adi mu tshitudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omeli wakafuma ku Gibetona, wakaya ne Bena Isalele bonso, bakatshintshimika Tîsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Zimeli ne, Bakanyenga musoko, yeye wakabuela mu nsubu wa mukelenge, wakamuosha, wakafuilamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua malu mabi akenzeye ku mesu kua Yehowa bua kuendeye mu nshila wa Yalobama ne bua malu mabi akenzesheye Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bia Zimeli bikuabo biakenzeye, ne tshitungu tshiakatungileye, kabiena bifunda mu mukanda wa kulondolola kua malu a bakelenge ba Isalele, anyi?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Bena Isalele bakadihandulula bituha bibidi; bakuabo bakalonda Tibeni, muana wa Ginata, bakamusungula mukelenge; bakuabo bakalonda Omeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bantu bakalonda Omeli bakahita bantu bakalonda Tibeni, muana wa Ginata, bukole; nunku Tibeni wakafua ne Omeli wakakokesha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia makumi asatu ne tshimue tshia bukelenge bua Asa, mukelenge wa Yuda, Omeli wakabanga kukokesha Bena Isalele; wakabakokesha bidimu dikumi ne bibidi; wakabakokesha bidimu bisambombo mu Tîsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.23",
            "verseOrgIds": [
              "1KI.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasumba mukuna wa Samalea kudi Sheme ku ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16.24:",
              "type": "text"
            },
            {
              "text": "Ntalanta wa argent wakadi ne bujitu bua 44 kg.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ibidi ya argent; wakasa musoko wa lumbu ha mutu ha mukuna, wakawidika Samalea bu dina dia muena mukuna Shemê. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omeli Wakenza malu mabi ku mesu kua Yehowa; wakatamba bonso ba diambedi bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua yeye wakenda mu nshila yonso ya Yalobama, muana wa Nebata, ne mu malu mabi onso akenzesheye Bena Isalele bua kufuishabo Yehowa, Nzambi wa Isalele, tshiji bua mpingu yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bia Omeli bikuabo biakenzeye ne bukole buakadiye nʼabu kabiena bifunda mu mukanda wa kulondolola kua malu a bakelenge ba Isalele, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omeli wakalala tulu ne bankambua bandi, bakamujika mu Samalea; Ahaba, muanʼandi mulume, wakakokesha mu muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia makumi asatu ne muanda mukulu tshia bukelenge bua Asa, mukelenge wa Yuda, Ahaba, muana wa Omeli, wakabanga kukokesha Bena Isalele; Ahaba, muana wa Omeli, wakakokesha Bena Isalele mu Samalea bidimu makumi abidi ne bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaba, muana wa Omeli, Wakenza malu mabi ku mesu kua Yehowa akahita a bonso bakadi ku mpala kuandi bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu ebu buakadi butekete ku mesu kuandi bua kuendeye mu malu mabi a Yalohama, muana wa Nebata: nunku wakabaka Izebele, muana wa bakashi wa Etebâla, mukelenge wa Bena Sidona, wakakuatshila Bâla mudimu, wakamutendelela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenzela Bâla tshioshelu mu nsubu wa Bâla wakaseye mu Samalea. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaba wakalonda malu a Bashela kabidi; Ahaba wakahita bakelenge ba Isalele bonso bakadi ku mpala kuandi kuenza malu mabi a kuluisha nʼau Yehowa, Nzambi wa Isalele, tshiji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku andi Hiele, Muena Betele, wakasa musoko wa Yeleko; hakajadikeye makunshi a musoko, muanʼa bute wandi Abilama wakafua, hakatekeye bibi bia musoko, muaha mukala wandi Seguba wakafua, bu mu dî dia Yehowa diakambileye Yoshua, muana wa Nuna.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
