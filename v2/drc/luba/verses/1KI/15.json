            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshisatu tshia bukelenge bua Asa, mukelenge wa Yuda, Bâsha wakamushiha, wakakokesha mu muaba wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahinganeye mu bukelenge, yeye wakashiha bonso ba mu nsubu wa Yalobama; yeye kakashila Yalobama muntu umue ne muoyo; yeye wakabashiha bonso bu mu dî dia Yehowa diakambeye mukana mua muntu wandi Ahiya, Muena Shilo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua malu mabi akenza Yalobama ne akenzesheye Bena Isalele ne bua tshiji tshiakafuisheye Yehowa, Nzambi wa Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
