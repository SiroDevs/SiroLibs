          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshisatu tshia bukelenge bua Asa, mukelenge wa Yuda, Bâsha, muana wa Ahiya, wakabanga kukokesha Bena Isalele mu Tîsa; wakabakokesha bidimu makumi abidi ne binai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
