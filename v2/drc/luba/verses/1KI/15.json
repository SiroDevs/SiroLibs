          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza malu mabi ku mesu kua Yehowa; wakenda mu nshila wa Yalobama ne mu malu mabi akenzesheye Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
