          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kudi Eliya, Muena Tishebe, ne, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakutangila bu mudi Ahaba mudihuekeshe ku mesu kuanyi, anyi? Bualu bua yeye wakudihuekesha nunku ku mesu kuanyi, tshiena ngenza malu au makole onso mu matuku andi: kadi nentume malu au makole ku nsubu wandi mu matuku a bana bandi ba balume.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
