          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe tuakumuka ku musulu wa Ahawa mu dituku dia dikumi ne abidi dia ngondo wa kumudilu bua kuya ku Yelushalema; tshianza tshia Nzambi wetu tshiakadi kutudi, wakatusungila mu bianza bia bena lukuna ne kudi balaminyi bakadi mu nshila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuakafika ku Yelushalema, tuakashikamaku matuku asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku dinai tuakidikisha bujitu bua argent ne or ne malonga onso mu nsubu wa Nzambi wetu, tuakabiteka mu tshianza tshia Melemota, muana wa Uliya muakuidi; Eleazâ, muana wa Pinehasa, wakadi nʼandi; Yozabada, muana wa Yeshua, ne Noadaya, muana wa Binui, Bena Lewi, bakadi nʼabo kabidi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuakabala bintu bionso ne bujitu buabi; bakafunda bujitu bua bintu bionso tshikondo atshi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
