          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au mmena a bakadi ku mitu ya nsubu ya batatu babo, eku nkulondolola kua bakafuma nʼanyi ku Babulona, mu bukokeshi bua mukelenge Atashasete: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa bana balume ba Pinehasa, Gêshoma; wa bana ba Itamâ, Danyele; wa bana ba Davidi, Hatusha; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa bana ba Shekanya ne ba Palosha, Zekâya; bakamubalabo nʼabo bakadi balume lukama ne makumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Pahata-moaba, Eleyehoenai, muana wa Zelaya; bakadi nʼandi bakadi balume nkama ibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana balume ba Zatu, Shekanya, muana wa Yahaziele; bakadi nʼandi bakadi balume nkama isatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Adina, Ebede, muana wa Yonatana; bakadi nʼandi bakadi balume makumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Elama, Yeshaya, muana wa Atalaya; bakadi nʼandi bakadi balume makumi muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Shefataya, Zebadaya, muana wa Mikaele; bakadi nʼandi bakadi balume makumi muanda mukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ha Yoaba, Obadaya, muana wa Yehiele; bakadi nʼandi bakadi balume nkama ibidi ne dikumi ne muanda mukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Bani, Shelomita, muana wa Yosifiya; bakadi nʼandi bakadi balume lukama ne makumi asambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Bebai, Zekâya, muana wa Bebai; bakadi nʼandi bakadi balume makumi abidi ne muanda mukulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa bana ba Azegada, Yohanana, muana wa Hakatana; bakadi nʼandi bakadi balume lukama ne dikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bana ba Adonikama, bakadi ba kunshikidilu, â mmena abo, Elefilete, Yeule ne Shemaya; bakadi nʼabo bakadi balume makumi asambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bana ba Bigewai, Utai ne Zabuda; bakadi nʼabo bakadi balume makumi muanda mutekete.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabasangisha ku musulu udi uya ku Ahawa; tuakashikamaku matuku asatu; hanakatangila bantu ne bakuidi, tshiakasangana bana ba Lewi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nakabikila Elieze ne Aliele ne Shemaya ne Elenatana ne Yaliba ne Elenatana mukuabo ne Natana ne Zekâya ne Meshulama, bakadi ne lungenyi luhita; ne Yoyaliba ne Elenatana mukuabo bakadi bayishi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabatuma kudi Ido, muntu munene, ku muaba wa Kasifaya; nakabambila mei a kuambilabo Ido ne bana babo, Bena Netinima,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.17:",
              "type": "text"
            },
            {
              "text": "Tangila Ezela 2.43.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku muaba wa Kasifaya, bua bobo balue kutudi ne benji ba mudimu wa nsubu wa Nzambi wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu muakadi tshianza tshimpe tshia Nzambi kutudi, bakahingana ne muntu wa lungenyi, umue wa bana ba Mali, muana wa Lewi, muana wa Isalele; ne Shelebaya ne bana bandi balela ne bana babo dikumi ne muanda mukulu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Hashabaya ne bakadi nʼandi, Yeshaya wa bana balume ba Melali ne bana babo ne bana babo balela makumi abidi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Bena Netinima bakajidila Davidi ne miloho bua kuenzabo mudimu wa Bena Lewi, Bena Netinima nkama ibidi ne makumi abidi: mena a buonso buabo akadi matedibue.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nakela mukenji bua tuetu kujila bia kudia ku musulu wa Ahawa, bua tuetu kudihuekesha ku mesu kua Nzambi wetu, ne bua yeye atuleshe ne bana betu bakese ne bintu bietu nshila mululame. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bundu buakadi bunkuata bua kulomba mukelenge masalayi ne badi benda ha tubalu bua kutusungilabo kudi bena lukuna bakadi mu nshila; bualu bua tuetu tuakadianjila kuambila mukelenge ne, Tshianza tshia Nzambi wetu tshidi kudi bonso badi bamukeba bua kubenzela bimpe; kadi bukole ne tshiji tshiandi bidi kudi bonso badi bamubenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku tuakajila bia kudia, tuakananukila kulomba Nzambi wetu bualu ebu; yeye wakatunvuila.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nakatahulula bakuidi banene dikumi ne babidi, Shelebaya ne Hashabaya ne bana babo dikumi bakadi nʼabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakidikisha nʼabo bujitu bua argent ne or ne malonga ne bintu bionso biakafilabo mu nsubu wa Nzambi wetu kudi mukelenge ne bena lungenyi bandi ne bantu bandi banene ne Bena Isalele bonso bakadiku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakidikisha bujitu bua ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.26:",
              "type": "text"
            },
            {
              "text": "Tangila Ezela 7.22.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya argent nkama isambombo ne makumi atanu, nakayiteka mu bianza biabo; ne malonga a argent, bujitu bua ntalanta lukama; ne or, bujitu bua ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.26:",
              "type": "text"
            },
            {
              "text": "Ntalanta wa or wakadi ne bujitu bua 59 kg.",
              "type": "text"
            }
          ]
        },
        {
          "text": " lukama; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "malonga a or makumi abidi, bujitu bua dariques",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.27:",
              "type": "text"
            },
            {
              "text": "Tangila Ezela 2.69.",
              "type": "text"
            }
          ]
        },
        {
          "text": " tshinunu; ne malonga abidi a tshiamu tshia mitaku akadi a mushinga mukole bu or mene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
