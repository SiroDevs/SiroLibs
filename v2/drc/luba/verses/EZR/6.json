      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe mukelenge Dayawesha wakela mukenji, bakakebakeba mu nsubu wa mikanda wakadibo babutshila bintu bia mushinga mukole mu Babulona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasangana mukandu ku Akemeta mu nsubu wa mukelenge udi mu buloba bua Bena Madai, wakadi mufunda nunku: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia kumudilu tshia bukelenge bua mukelenge Kolesha mene, mukelenge Kolesha wakela mukenji eu bua nsubu wa Nzambi wa mu Yelushalema ne: Base nsubu au mu muaba wakadibo bafila milambu, bajadike bishimikidi biandi bikole; bule buabi nebuikale coudées",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.3:",
              "type": "text"
            },
            {
              "text": "Coudêe wakadi bule bua 44 cm.",
              "type": "text"
            }
          ]
        },
        {
          "text": " makumi asambombo ne butshiama buabi nebuikale coudées makumi asambombo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "base ne milongo ya mabue manene isatu ne mulongo wa mabaya mahia-mahia; difutu dia mudimu eu difume mu nsubu wa mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
            "verseOrgIds": [
              "EZR.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahingishe malonga a or ne a argent mu nsubu wa Nzambi, akangata Nebukadenesâ mu ntempelo udi mu Yelushalema, akalueye nʼau ku Babulona; baye nʼau kabidi mu ntempelo udi mu Yelushalema, bateke dilonga ne dilonga mu muaba wadi; bateke mu nsubu wa Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku wewe Tatenai, gouver-neur wa buloba bua dishiya dia musulu wa Pelata, ne Shetâ-bozenai ne Bena Afâsateka, bena mulongo webe badi dishiya dia musulu wa Pelata, kanufiki ha buihi nʼabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanuhumbishi mudimu wa nsubu eu wa Nzambi; gouverneur wa Bena Yuda ne bakulu ba Bena Yuda base nsubu eu wa Nzambi mu muaba wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.7",
            "verseOrgIds": [
              "EZR.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bukuabo kabidi, ndi mulelela mukenji unudi ne bua kuenzela bakulu aba ba Bena Yuda badi basa nsubu eu wa Nzambi ne, Nuangate biuma bia mukelenge bia mu milambu ya mu buloba bua dishiya dia musulu wa Pelata, nubifile kudi bantu aba lubilu bua kubakuatshisha; kabahumbishibu kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babahe kabidi bintu bidibo nʼabi bualu, bana balume ba ngombe ne bimpanga ne bana ba mikoko bu milambu ya kuoshila Nzambi wa mu diulu; ne blé, luehu, nyinyo ne manyi, bu mudi bakuidi ba mu Yelushalema bamba; babahebi ku dituku ne ku dituku, kabahangi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.9",
            "verseOrgIds": [
              "EZR.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua bobo bafile milambu idi mitue dihembu kudi Nzambi wa mu diulu, balombele muoyo wa mukelenge ne wa bana bandi ba balume Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
              "EZR.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakela mukenji mukuabo kabidi ne, Yonso udi ukudimuna dî edi, batule dibaya dinene dia ku nsubu wandi, bamuoweleku, muasa ku dibaya; bavuishe nsubu wandi bu diala bua bualu ebu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.11",
            "verseOrgIds": [
              "EZR.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi nguakajadikishaku dina diandi abutule hakelenge bonso ne bantu bonso badi bolola bianza biabo bua kukudimunabo bualu ebu ne bua kuhaulabo nsubu eu wa Nzambi udi mu Yelushalema. Meme Dayawesha, nakela mukenji eu; batumikile mukenji eu ne mitshima yabo yonso.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Tatenai, gouverneur wa buloba budi dishiya dia musulu wa Pelata, ne Shetâ-bozenai ne bena mulongo wabo bakenza bualu buakabambila mukelenge Dayawesha ne mitshima yabo yonso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakulu ba Bena Yuda bakasa nsubu, bakadi ne diakalengele bualu bua dî dia Nzambi diakabambila Hagai muprofete ne Zekâya, muana wa Ido. Bakasa nsubu, bakamushikisha bu muakadi mukenji wa Nzambi wa Bena Isalele, ne bu muakadi mukenji wa Kolesha ne Dayawesha ne Atashasete, mukelenge wa Pelasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamana nsubu eu ku dituku disatu dia mu ngondo wa Adâ mu tshidimu tshisambombo tshia bukokeshi bua mukelenge Dayawesha.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele ne bakuidi ne Bena Lewi ne bantu bakuabo bakahingana ku buhika bakajidila nsubu eu wa Nzambi ne disanka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakajidilabo nsubu eu wa Nzambi bakafila milambu ya ngombe lukama ne bimpanga nkama ibidi ne bana ba mikoko nkama inai; bakafila milambu ya kubuikila nʼai mibi ya Bena Isalele bonso mpumbu ya mbushi dikumi ne ibidi bu bungi bua bisamba bia Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakateka bakuidi mu bisumbu biabo ne Bena Lewi mu milongo yabo bua kukuatshilabo Nzambi mudimu mu nsubu udi mu Yelushalema, bu muakafundabo mu mukanda wa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakahingana ku buhika bakadia bidia bia disanka dia kuhita kua Yehowa ku dituku dia dikumi ne inai dia ngondo wa kumudilu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bakuidi ne Bena Lewi bakadianjila kudilengesha diatshimue; buonso buabo bakadi balengeshibue; bakashihela bantu bonso bakahingana ku buhika ne bana babo bakuidi mikoko ya disanka dia kuhita kua Yehowa; bakadishihelayi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bonso bakadi bumuka mu buhika ne bantu bonso bakadi baditahulule ku malu a bundu a bisamba bia bantu ba ha buloba bua kukebabo Yehowa, Nzambi wa Isalele, bakabidia; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakadia bidia bidi kabiyi ne luevene ne disanka matuku muanda mutekete; bualu bua Yehowa wakabavudishila disanka, wakakudimusha mutshima wa mukelenge wa Ashû kudibo bua kukolesheye maboko abo mu mudimu wa nsubu wa Nzambi, Nzambi wa Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        }
      ]
    }
