    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi umanye bualu ebu ne, Halua matuku a kunshikidilu, malu makole nealue. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu nebikale badisui, banangi ba biuma, baditumbishi, badileshi, bahendi ba Nzambi, kabai batumikila mei a baledi babo, kabai ne kusakidila, kabai ne tshijila, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabai banangi ba bana babo, bashihi ba bihungidi, bena bunsonge, kabai mua kudikanda, bena luonji, kabai basue malu mimpe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebikale batungidianganyi, bena lukuluku, bûshibui ne diamba, banangi ba masanka, kabai banangi ba Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebikale ne tshimuenekelu tshia buimpe bua Nzambi, kadi bamane kudiula bukole buabu; umuke biebe kudi bantu aba kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua munkatshi mua bantu aba mudi badi babombelela mu nsubu bua babueshe bakashi bahote mu buhika badi bûle tente ne malu mabi, badi bahambuishibua ku mibi ya mishindu yonso; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "badi bayilayila misangu yonso, kadi tshiendelele kabena bamanye mua kufika ku dimanya dia bualu bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu mudi Yane ne Yambele bakatantamena Mose, nunku bobo kabidi badi batantamena bualu bulelela; mbantu mene badi ne meshi abo moneka, kabai bajadikibua mu ditabusha diabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bobo kabena mua kuhita ku mpala; bualu bua buhote buabo nebumueneke ku mesu kua bonso, bu muakamueneka buhote bua bantu aba bakuabo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi wewe wakalonda diyisha dianyi, bienzedi bianyi, bualu bunakahangidisha, ditabusha dianyi, lutulu luanyi, dinanga dianyi, kutantamana kuanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "makengeshibua anyi ne makenga anyi; ne wakalonda malu akankuata ku Antiokia ne ku Ikonio ne ku Luseta, ne makengesha anakakenga ne mutshima wa dikima; ne Mukelenge wakampandisha munkatshi mua buonso buau. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bantu bonso badi basue kuikala bena kanemu mu Kilisto Yesu nebakengeshibue. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bantu babi ne badingi ba bakuabo nebadiundadiunde mu malu mabi abo matuku onso, badingangana, badingila. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi wewe wikale mu malu awakayila ne awakeyemena ne, Nga bushua; umanya biebe bantu bakakuyishau; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku buana buebe wewe wakamanya Mukanda wa Nzambi, udi mumanye mua kukuvuisha muena meshi tô ne ku luhandu luakulua bua ditabusha dia mu Kilisto Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dionso dia mu Mukanda wa Nzambi didi difume munda mua Nzambi bu muhuya wandi, ne didi ne mudimu muimpe wa kuyisha bantu, ne wa kubabela, ne wa kubadimusha, ne wa kubalongesha mu buakane bua Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua muntu wa Nzambi ikale mukumbashibue, mulongolola tshishiki bua midimu yonso mimpe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
  ],
