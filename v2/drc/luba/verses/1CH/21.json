            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamona Davidi ne, Yehowa wakitaba kundi ku tshihehudi tshia Ônana, Muena Yebuse, yeye wakafilaku milambu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
