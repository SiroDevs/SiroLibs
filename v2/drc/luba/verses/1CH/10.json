    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakaluangana nvita ne Bena Isalele; Bena Isalele bakanyema ku mpala kua Bena Peleshete, bakadishinda hanshi bafue ku mukuna wa Gileboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakihata Shaula ne bana bandi balume; Bena Peleshete bakashiha Yonatana ne Abinadaba ne Maleki-shua, bana balume ba Shaula. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatamba Shaula mu nvita, bena mata a mikete bakamuheta mu nshila; yeye wakatahibua kudi bena mata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Shaula wakambila muambudi wa ngabu wandi ne, Hatula muele wa nvita webe, untahe, unsompole; bua bantu aba badi kabayi batengula kabalu ha buihi nʼanyi bua kutekabo. Kadi muambudi wa ngabu wandi wakahidia; bualu bua yeye wakatamba kutshina. Nunku Shaula wakahatula muele wa nvita wandi, wakadishindahu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamona muambudi wa ngabu wandi ne, Shaula wakamana kufua, yeye kabidi wakadishinda ha muele wandi, wakafua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Shaula wakafua ne bana bandi balume basatu; bonso ba mu nsubu wandi bakafua diatshimue. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Bena Isalele bakadi bashikama mu tshibanda ne, Bakadi ku mukuna bakanyema, ne Shaula ne bana bandi balume bakafua, bakahatuka mu misoko yabo, bakanyema kabidi; Bena Peleshete bakatua, bakashikamamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu, hakalua Bena Peleshete bua kunyengabo bintu bia bantu bafue, bakasangana Shaula ne bana bandi ba balume bahone hanshi ku mukuna wa Gileboa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamunyenga bintu biandi; bakatuma mutu wandi ne bintu biandi bia nvita mu buloba buonso bua Bena Peleshete bua kumanyishabo nzambi yabo ne bantu babo bonso lumu elu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakateka bintu biandi bia nvita mu nsubu wa nzambi yabo; bakakumina mutu wandi mu nsubu wa Dagona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Bena Yabesha-gilada lumu lua malu onso akenzela Bena Peleshete Shaula, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe bena bukitu bonso bakabika, bakangata tshitalu tshia Shaula ne bia bana bandi ba balume, bakatua nʼabi ku Yabesha, bakajika mifuba yabo muinshi mua mitshi ya telebinta ya mu Yabesha, bakajila bia kudia matuku muanda mutekete.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Shaula wakafua bualu bua bubi buandi buakenzeleye Yehowa ne bua dî dia Yehowa diakahidieye; ne bualu bua yeye wakakeba lungenyi kudi muena buloshi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakebesha Yehowa; nunku yeye wakamushiha, wakaha Davidi, muana wa Yishai, bukelenge buandi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    }
