          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biasangakena mulume ne mushikankunde utshidi kamama, kayi mubangila kudi mukuabo, biamukuateye ku bukole bua kulala nʼandi, ne bantu badi babasangana; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe mulume wakalala nʼandi, neafute tatu wa mushikankunde nshekele ya argent makumi atanu, ne yeye neikale mukashi wandi, bualu bua yeye wakamunyanga, kena mua kumuhidia matuku andi onso.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
