        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi usonga luhingu anyi udi wenza luhingu ne tshiamu tshiakatulabo kudi muntu udi ne lungenyi lule, udi kujadika mu musokoko, ntshintu tshibi ku mesu kua Yehowa, udi ne mulau. Bantu bonso nebakudimune dî ne, Amen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
