          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi uhenda tatu wandi anyi mamu wandi udi ne mulau; bantu bonso nebakudimune dî ne, Amen.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
