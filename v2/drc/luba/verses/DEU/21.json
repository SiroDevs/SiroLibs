  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "DEU 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biasanganabo muntu mufue mu buloba budi Yehowa, Nzambi wenu, unuha bua nuenu nubuhiane, kabayi bamanye muntu wakamushiha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe bakulu ne balumbuluishi nebaluhuke, nebahime mutantshi kubangila ku muaba udi tshitalu tô ne ku misoko idi ha buihi ne muntu mufue; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakulu ba mu musoko udi utamba ha buihi ne muntu mufue nebangate kana ka ngombe kadi kakayi kanze kuenza mudimu ne tshikokedi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakulu ba mu musoko nebahueke ne kana ka ngombe mu tshibanda tshidi ne mai adi ahueka, tshidibo kabayi banze kudimamu ne kukunamu bintu, nebatshibule nshingu wa kana ka ngombe mu tshibanda atshi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuidi, bana balume ba Lewi, bakasungulabo kudi Yehowa, Nzambi wenu, bua kumuenzelabo mudimu ne bua kuvudishila bantu disanka mu dina dia Yehowa, nebalue ha buihi: bua mei abo malu onso ne bilumbu bionso bia kukumangana nebijalame. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakulu bonso ba mu musoko eu udi utamba ha buihi ne muntu mufue, nebuvuwe bianza biabo ha mutu ha kana ka ngombe kadi ne nshingu waku mutshibula mu tshibanda; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bobo nebitabe ne, Bianza bietu kabiakamatshisha mashi au, mesu etu kaena mâmone. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
            "verseOrgIds": [
              "DEU.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa, ubuikile bubi bua bantu bebe Bena Isalele, bawakahikula, kuitabushi bua mashi a muntu udi kayi ne tshilumbu ashale munkatshi mua bantu bebe Bena Isalele. Ne mashi au neabuikidibue. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nenumushe mashi adi kâyi ne tshilumbu munkatshi muenu hanuenza malu adi mimpe ku mesu kua Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuaya kuluangana nvita ne bantu badi nʼenu lukuna ne Yehowa, Nzambi wenu, udi ubafila mu bianza bienu, nuenu nudi nuya nʼabo mu buluka, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne umue wenu udi utangila mukashi udi ne mpala muimpe munkatshi muabo, ne yeye udi mumusue, udi musue kumubaka bu mukashi wandi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe yeye nealue nʼandi ku nsubu kuandi; nebamubeye nsuki ya ku mutu, nebamukose nzadi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye neavule bilulu biandi bia buluka, neashale mu nsubu wa muntu eu: neadile tatu wandi ne mamu wandi tô ngondo mujima; ne ku nyima muntu eu neaye kudiye bu mulume wandi, ne yeye neikale mukashi wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikaleye kayi ne disanka bualu bua mukashi eu, hashishe yeye neamutume kudiye musue kuya; kadi kamuhanyi ku biuma, kamuenji bu muhika, bualu bua yeye wakamukehesha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala mulume ne bakashi babidi, udi musue umue, udi ukina mukuabo, ne bubidi buabo ne mukashi wakadiye musue ne mukuabo wakadiye ukina, hakamulelela bana; ne bikala mukashi wakadiye ukina mumulelele muanʼa bute wandi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe mu dituku didiye uhianyisha bana bandi balume bintu bidiye nʼabi, yeye kena mua kuteka muana wa mukashi wakadiye musue ku mpala kua muanʼa bute wandi wa mukashi wakadiye ukina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye neitabushe muanʼa bute wandi wa mukashi udiye ukina, neamuhe bituha bibidi bia bintu bionso bidiye nʼabi; bualu bua yeye udi wa tshibangidilu tshia bukole buandi; bintu bia buanʼa bute mbiandi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muntu ne muana mulume udi ne tshitshu ne buhidia, katu watumikila dî dia tatu wandi anyi dia mamu wandi, ne yeye katu wabahvuila biamukengeshaho, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe tatu wandi ne mamu wandi nebamukuate, nebaluhuke nʼandi kudi bakulu ba mu musoko wabo ne ku tshibi tshia musoko; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebambile bakulu ba mu musoko wabo ne, Muana wetu eu udi ne tshitshu ne buhidia, kena utumikila mei etu; udi muena lumpukusu ne mukuatshiki wa maluvu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume bonso ba mu musoko wabo nebamukume ne mabue tô ne hafueye: nunku nenumushe malu mabi munkatshi muenu; ne Bena Isalele nebunvue, nebatshine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muntu muenze bualu bubi bua lufu, ne badi bamushiha, nebamuowe ku mutshi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabashiyi tshitalu tshiandi ku mutshi butuku bujima, bamujike anu dituku adi mene; muntu yonso muowa ku mutshi udi muedibue mulau kudi Nzambi; kanunyangi buloba budi Yehowa, Nzambi wenu, unuha bua nuenu kubuhiana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
      ]
    }
  ],
