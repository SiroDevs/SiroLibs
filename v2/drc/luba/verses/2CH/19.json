    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafata, mukelenge wa Yuda, wakahingana ku nsubu wandi mu Yelushalema ne ditalala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.1",
            "verseOrgIds": [
              "2CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu, muana wa Hanani, mumonyi wa malu a Nzambi, wakaya kusangakena nʼandi, wakambila mukelenge Yehoshafata ne, Bûdi nʼabu mbua kukuatshisha bantu babi ne bua kunanga badi ne Yehowa lukuna, anyi? Bua bualu ebu Yehowa wakakulesha tshiji tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi malu mimpe makuabo adi munda muebe bualu bua wewe wakumusha mpingu ya Bashela ku buloba, wakajadika mutshima webe bua kukeba Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafata wakashikama mu Yelushalema; yeye wakendakana munkatshi mua bantu ku Bê-sheba tô ne ku mikuna ya Efelayima, wakabaluisha kudi Yehowa, Nzambi wa batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakateka balumbuluishi mu misoko yonso ya ngumbu ya mu buloba buonso bua Yuda, ku musoko ku musoko, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakambila balumbuluishi ne, Nuelangane meji bimpe bua malu anudi nuenza; kanulumbuluishi mu dinu dia bantu, kadi mu dina dia Yehowa; yeye udi nʼenu mu kulumbulula kuenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku ditshina dia Yehowa dikale kunudi; nudimuke bimpe bu munudi nuenza bualu bua kakuena malu mabi kudi Yehowa Nzambi wetu, yeye kena ne kansungusungu, kena witabusha bintu bia mbueshilu kudi muntu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bukuabo kabidi, Yehoshafata wakateka Bena Lewi ne bakuidi ne bakadi ku mutu kua biota bia batatuʼabo ba mu Isalele mu Yelushalema bua kulumbuluishabo mu dina dia Yehowa ne bua kukosabo bilumbu. Bakahingana ku Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabatshihisha ne, Nuenze malu mu ditshina dia Yehowa ne lulamatu ne mitshima miakane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialua bana benu ba ku misoko yonso kunudi ne tshilumbu tshia mashi ne mashi, nansha tshia mikenji, nansha tshia mei mafunda a Yehowa, nansha tshia mei andi majalame, bunudi nʼabu mbua kubadimusha bua bobo kabahidi kudi Yehowa, bua Yehowa kaleshi tshiji tshiandi kunudi ne kudi bana benu; binuenza nunku, kanuena nuhila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, Amalia, muakuidi munene, udi ku mutu kuenu mu malu onso a Yehowa, ne Zebadaya, muana wa Yishemaele, mukokeshi wa tshisamba tshia Bena Yuda, udi ku mutu kuenu mu malu onso a mukelenge; Bena Lewi kabidi nebikale tuhita ku mpala kuenu. Nuikale ne mitshima mikole, Yehowa ikale ne bantu bimpe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
      ]
    }
  ],
