          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bikuabo bia Hezikiya, ne malu mimpe akenzeye, monai, bidi bifunda mu mukanda wa tshikena kumona wa Yeshaya muprofete, muana wa Amoza, ne mu mukanda wa bakelenge ba Yuda ne ba Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
