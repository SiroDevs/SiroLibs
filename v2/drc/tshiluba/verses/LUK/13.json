          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banga badi ku nyima katataka nebikale ku mpala, banga badi ku mpala katataka nebikale ku nyima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
      ]
    },
    {
