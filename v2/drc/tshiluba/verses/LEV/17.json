    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Alona ne bana bandi balume ne Bena Isalele bonso ne, Ebu mbualu buakuamba Yehowa ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso wa munkatshi mua Bena Isalele udi ushiha nansha ngombe nansha mukoko nansha mbushi mu tshitudilu anyi ku butshika bua tshitudilu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kayi nulue n andi ku mbelu kua ntenta wa kusangakena bua kumufila bu mulambu wa Yehowa ku mpala kua nsubu wa Yehowa, nebamubale bu muhite bua mashi akamatshisheye hanshi, yeye wakamatshisha mashi hanshi, nebumushe mundi au munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua ndi musue Bena Isalele bangate milambu idibo basue kushihela mu tshisuku, balue nʼai kudi Yehowa, ku mbelu kua ntenta wa kusangakena kudi muakuidi, bayifile bu mulambu ya kuvuisha nʼai ditalala kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neamiamine mashi ku tshioshelu tshia Yehowa, neoshe dianyi bu mulambu udi ulua dihembu kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku kabena bashihela ba-demon milambu yabo hadibo benda nʼabo masandi. Eu newikale mukenji kudibo bikondo biabo bionso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe ubambile ne, Muntu yonso wa mu bisamba bia Bena Isalele anyi wa benyi badi munkatshi muabo udi ufila mulambu wa kuosha ha kahia anyi mulambu mukuabo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne udi uhidia kulua ne mulambu ku mbelu kua ntenta wa kusangakena bua kûshihela Yehowa nebumushe muntu au munkatshi mua bana babo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso wa mu bisamba bia Bena Isalele anyi wa benyi ba munkatshi muabo udi udia mashi, meme nengumushe mesu anyi kudi muntu au udi udia mashi nemmumushe munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua mashi adi bu muoyo wa tshintu nakanuha mashi ha tshioshelu bualu bua kunubuikidila nʼau bubi buenu mashi adi anubuikidila bubi bualu bua muoyo wau. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bualu ebu nakambila Bena Isalele ne, Muntu wa munkatshi muenu kadi mashi nansha muenyi udi munkatshi muenu kadi mashi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso wa munkatshi mua Bena Isalele anyi wa benyi badi munkatshi muabo udi ulemba nyama anyi nyunyu bua kudia neahongolole mashi andi hanshi, neajibikile ne dinfuenkenya dia buloba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua mashi adi bu muoyo wa bintu bionso, mashi a tshintu ne muoyo watshi bidi muomumue nunku nakambila Bena Isalele ne, Kanudi mashi a mu munyinyi, bualu bua muoyo wa bintu bionso udi mu mashi, muntu yonso udi udia mashi nebamumushe munkatshi mua bana babo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi udia tshintu tshidifuile anyi tshidi tshihandulule kudi nyama, bikaleye muledibue mu nsubu yenu anyi muenyi, yeye neuvuwe bilulu biandi ne mubidi wandi ne mai, neikale bu muntu udi kayi muakane tô ne dilolo, hashishe yeye neikale muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi biahidieye kuvuwa bilulu biandi anyi mubidi wandi, yeye neadituadile bubi buandi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
    }
