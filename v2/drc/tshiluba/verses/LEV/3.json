          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tumuma tubidi ne dianyi didi ha mutu hatu hehi ne bituntuku bia bibelu ne lukutu lua mutshima ne lua tumuma kabidi yeye neabiumushe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
