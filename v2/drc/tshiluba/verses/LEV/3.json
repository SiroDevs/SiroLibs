          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biafileye muana wa mukoko bu mulambu wandi, nealue handi ku mesu kua Yehowa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "neatenteke tshianza tshiandi ha mutu ha muana wa mukoko wa mulambu wandi, neamushihe ku mbelu kua ntenta wa kusangakena, bana balume ba Alona nebamiamine mashi ku tshioshelu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
