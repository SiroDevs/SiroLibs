            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala mulambu wa mundi wa kumuvuisha nʼau ditalala wa munkatshi mua mikoko wa kudia kudi Yehowa, neafue mulume nansha mukashi udi kayi ne tshilema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
