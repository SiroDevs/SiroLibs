              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neabioshe ha tshioshelu etshi ntshintu tshia kudia tshidibo bafila bu mulambu wa kuoshila Yehowa ha kahia.",
          "type": "text",
          "attrs": {
