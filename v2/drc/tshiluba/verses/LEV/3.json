          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neoshe mulambu wa kuvuisha nʼau ditalala bu mulambu wa kuoshila Yehowa ha kahia, yeye neumushe dianyi dionso ne dianyi dia mukila didi hehi ne muongo ne dianyi didi ha mutu ha bintu bia munda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
