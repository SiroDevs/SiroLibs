        },
        {
          "text": "Kanuangatshi bintu bia buhikudi kudi mushihi wa muntu udi muhile bulelela, bualu bua nebamushihe bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
