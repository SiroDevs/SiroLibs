              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuangatshi bintu bia buhikudi kudi muntu wakasemena ku musoko wa kunyemena, bualu bua kumuhingisha ku buloba buandi to ne hafua muakuidi munene. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
