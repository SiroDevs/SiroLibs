          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha mutu ha milambu idibo bosha babala ngondo, ne milambu ya bukula ne milambu ya bintu bidibo banua, bu mudi mukenji wamba, milambu ya kuosha ha kahia, idi itua dihembu kudi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
