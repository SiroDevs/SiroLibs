          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bua kulua ne bintu bia diambedi bia mu buloba buetu ne mamuma a diambedi a mitshi yonso, ku tshidimu ku tshidimu, mu nsubu wa Yehowa; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
