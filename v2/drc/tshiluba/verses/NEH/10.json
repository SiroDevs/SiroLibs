          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuakadielela mikenji kabidi bua kufila tshituha tshia nshekele",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.32:",
              "type": "text"
            },
            {
              "text": "Nshekele wakadi ne bujitu bu bua 15 grammes.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bua mudimu wa mu nsubu wa Nzambi wetu ku tshidimu ku tshidimu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bua kufila bintu bia mampa ne bia mulambu wa bukula ne bia dituku dia lumingu ne bia ngondo mihia-mihia ne bia bidia bia disanka ne bia bintu bia tshijila ne bia milambu ya kubuikidila nʼai Bena Isalele mibi yabo ne bia mudimu wonso wa mu nsubu wa Nzambi wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
