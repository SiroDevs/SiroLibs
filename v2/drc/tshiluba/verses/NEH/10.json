          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakuabo ne bakuidi ne Bena Lewi ne batuadi ba majitu ne bimbi ba misambu ne Bena Netinima",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.28:",
              "type": "text"
            },
            {
              "text": "Tangila Nehemiya 3.26.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne bonso bakadilamununa kudi bena buloba bua kulondabo mikenji ya Nzambi ne bakashi babo ne bana babo balume ne bana babo bakashi ne muntu yonso wakadi ne lungenyi lua kujingulula malu ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakalamata kudi bana babo ne kudi bantu babo banene, bakadiela mulau, bakaditshiha bua kulondabo mikenji ya Nzambi yakabambileye kudi Mose, muntu wa Nzambi, ne bua kutumikilabo mikenji yonso ya Yehowa, Mukelenge wetu, ne mikenji yandi mijalame ne mei andi mafunda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katufidi bana betu bakashi kudi bena buloba, katuangatshidi bana betu balume bakashi kudibo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "bialua bena buloba kutudi ne bintu biabo anyi blé yabo bua kutubanyishabi dituku dia lumingu, katuena tubiula dituku dia lumingu anyi dituku dikuabo dia tshijila; netujile tshidimu tshia muanda mutekete, netulekelelangane mabanza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
