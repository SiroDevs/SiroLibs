            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuna ne Bena Zanoa bakalongolola mushiku wa mbelu mutangile tshibanda, bakawasa, bakateka bibi biau ne milonda ne biamu biau; bakasa mutantshi wa coudées",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.13:",
              "type": "text"
            },
            {
              "text": "Coudée wakadi ne bule bua 44 cm.",
              "type": "text"
            }
          ]
        },
        {
          "text": " tshinunu wa lumbu tô ne ku tshibi tshia ku luseke lua diala.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malakiya, muana wa Lekaba, mukokeshi wa luseke lua Bete-hakeleme, wakalongolola mushiku wa mbelu wa ku luseke lua ku diala; wakawasa, wakateka bibi ne milonda ne biamu biau.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushiku wa mbelu wa ku mpokolo wa mai bakalongolola kudi Shaluma, muana wa Kole-hosa, mukokeshi wa luseke lua Misepa; wakawasa, wakaubulula, wakateka bibi ne milonda ne biamu; wakalongolola lumbu lua ku dina dia mai a Shela hehi ne tshibunda tshia mukelenge tô ne ku tshibandilu tshidi tshihueka ku musoko wa Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Nehemiya, muana wa Azabuka, mukokeshi wa luseke lua Bete-sû, wakalongolola tô ne ku muaba wa nkita ya Davidi ne ku dina dia mai diakumbulabo ne ku nsubu wa bena bukitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Bena Lewi bakalongolola: Lehuma, muana wa Bani, wakalongolola. Ku luseke luandi lukuabo bakalongolola kudi Hashabiya, mukokeshi wa tshituha tshia luseke lua Kila, bua luseke luandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi bakalongolola kudi bana babo, Bawai, muana wa Henedada, mukokeshi wa tshituha tshia luseke lua Kila. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku luseke luandi lukuabo Ezê, muana wa Yeshua, mukokeshi wa Misepa, wakalongolola tshituha tshikuabo, buludiludi ne nsubu wa bintu bia nvita ku ditumba dia lumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Baluka, muana wa Zabai, wakananukila kulongolola tshituha tshikuabo ku ditumba dia lumbu tô ne ku tshibi tshia nsubu wa Eleyashiba muakuidi munene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Melemota, muana wa Uliya, muana wa Hakosa, wakalongolola tshituha tshikuabo ku tshibi tshia ku nsubu wa Eleyashiba tô ne ku ndekelu wa nsubu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi bakuidi, bantu ba ku Mpata, bakalongolola. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuabo Benyamina ne Hashuba bakalongolola buludiludi ne nsubu wabo. Ku nyima kuabo Azaya, muana wa Mâseya, muana wa Ananiya, wakalongolola ku luseke lua nsubu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Binui, muana wa Henedada, wakalongolola tshituha tshikuabo, ku nsubu wa Azaya tô ne ku ditumba dia lumbu tô ne ku tshibumba. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palala, muana wa Uzai, wakalongolola buludiludi ne ditumba dia lumbu tô ne ku tshibumba tshiakadi tshiasa hehi ne nsubu wa mukelenge wakadi ku mukuna, tshidi ku luseke lua luhangu lua balami ba ku bibi. Ku nyima kuandi Pedaya, muana wa Palosha, wakalongolola. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Netinima",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.26, 31:",
              "type": "text"
            },
            {
              "text": "Bena Netinima bakadi bantu bakadifila ku mudimu wa bianza wa mu ntempelo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hakadi bashikama mu Ofele ku muaba wa buludiludi ne mushiku wa mbelu wa ku mai ku luseke lua esete ne ku tshibumba tshiakadi tshisompoka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kuandi Bena Tekoa bakalongolola tshituha tshikuabo buludiludi ne tshibumba tshinene tô ne ku lumbu lua Ofele.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
