            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi nebambe ne, Monai, eu udi Nzambi wetu utuakutekemena ne, Neatusungile; eu udi Yehowa utuakutekemena; netuikale ne disanka, netusanke mu luhandu luandi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
