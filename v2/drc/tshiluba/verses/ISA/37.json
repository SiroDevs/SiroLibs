              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Saneheliba, mukelenge wa Ashû, wakumukaku, wakaya kuabo, wakashikama mu Ninewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
