        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe muntu wakadi muluate bivualu hia lin, wakadi ne kalondo ka mai a mukanda ka mufundi kasuika mu tshifuka tshiandi, wakahingana ne dî ne, Nakuenza bu muwakungambila.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
