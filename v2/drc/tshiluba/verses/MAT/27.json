          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe amba di diebe ne, Balame lukita bimpe tô ne ku dituku disatu, nunku bayidi bandi kabalu kumuiba, bambila bantu ne, Yeye wakubika ku lufu; bienzabo nunku, dihanga dia ku mpala neditambe dia ku nyima bunene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.64",
            "verseOrgIds": [
              "MAT.27.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "MAT 27:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato wakabambila ne, Nuenu nudi ne balami, yai bienu, milulame ne lungenyi luonso lunudi nʼalu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.65",
            "verseOrgIds": [
              "MAT.27.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "MAT 27:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaya biabo, bakalama lukita bimpe, bakateka tshimanyishilu ku dibue, balami bakadi nʼabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.66",
            "verseOrgIds": [
              "MAT.27.66"
            ]
          }
