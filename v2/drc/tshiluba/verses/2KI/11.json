    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Atalaya, mamu wa Ahazaya, ne, Muanʼanyi mulume udi mufue, yeye wakajuka, wakashiha bana balume bonso ba mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yehosheba, muana wa mukelenge Yolama, muanʼabo mukashi ne Ahazaya, wakangata Yoasha, muana wa balume wa Ahazaya, wakamuangata munkatshi mua bana ba mukelenge bakashihabo, wakamuteka ne mulami wandi mu nsubu wandi wa bulalu; bakamusokoka kudi Atalaya, yeye kakashihibua. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamusokoka nunku mu nsubu wa Yehowa tô bidimu bisambombo. Atalaya wakakokesha mu buloba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia muanda mutekete tshia Yoasha Yehoyada wakabikila tupitene tua bantu nkama bantu nkama ba Bena Kala ne ba balami, bakalua kudiye mu nsubu wa Yehowa; yeye wakahunga nʼabo tshihungidi, wakabatshihisha mu nsubu wa Yehowa, wakabalesha muana wa mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Bunudi nʼabu mbua kuenza nunku: tshituha tshienu tshisatu tshialua dituku dia Lumingu netshikale balami ba nsubu wa mukelenge, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.5",
            "verseOrgIds": [
              "2KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tshituha tshisatu tshikuabo netshikale ku tshibi tshia ku Sû; ne tshituha tshisatu tshikuabo netshikale ku tshibi ku nyima kua balami aba; nunku nenumanye mua kulama nsubu bua muntu kabuedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.6",
            "verseOrgIds": [
              "2KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bisumbu bienu bibidi bidi biluhuka dituku dia Lumingu nebikale balami ba nsubu wa Yehowa mudi mukelenge muana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.7",
            "verseOrgIds": [
              "2KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenunyunguluke mukelenge nunku, muntu yonso ne bintu bia nvita mu bianza biandi; biakela muntu kubuela munkatshi muenu, nebamushihe. Nunku nenuikale ne mukelenge haluhukeye ne habueleye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupitene tua bantu nkama bantu nkama tuakenza bu muakadi dî dia Yehoyada, muakuidi wa Nzambi. Bakangata muntu ne muntu bantu bandi, bakuabo bakadi ne bua kubuela dia Lumingu, bakuabo bakadi ne bua kuluhuka dia Lumingu, bakaya kudi Yehoyada, muakuidi wa Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi wa Nzambi wakafila mafuma ne ngabu bia mukelenge Davidi, biakadi mu nsubu wa Yehowa, mu bianza bia tupitene tua bantu nkama bantu nkama. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami aba bakimana muntu ne muntu ne bintu bia nvita mu bianza biabo ku luseke lua nsubu lua ku tshianza tshia balume tô ne ku luseke lua nsubu lua ku tshianza tshia bakashi, bakanyunguluka tshioshelu ne nsubu ne mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bakaluhuka ne muana wa mukelenge, bakateka tshifulu tshia butumbi ha mutu handi; bakamuha mukanda wa dihungila, bakamujadika mukelenge, bakamuela manyi ha mutu handi; bakamututshila nkashi, bamba ne, Mukelenge ikale ne muoyo!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Atalaya mbila ya balami ne ya bantu, yeye wakaya kudi bantu mu nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamona mukelenge muimane ha tshiambidi bu mudi tshilele tshiabo ne tupitene ne bedi ba mpungi bimane ha buihi ne mukelenge; bantu bonso bakadi hasanka, bela mpungi. Hashishe Atalaya wakadihanda bilulu biandi, wakela dî diandi ne, Bakungelela tshifufu! Bakungelela tshifufu! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada, muakuidi wa Nzambi, wakela tupitene tua masalayi dî ne, Balue nʼandi munkatshi mua balami; muntu wamulonda bamushihe ne muele wa nvita. Bualu bua muakuidi wakamba ne, Kabamushihi mu nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakamushila mpunga, wakenda mu nshila wa tubalu wa ku nsubu wa mukelenge, bakamushihelaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada wakahunga tshihungidi hankatshi ha Yehowa ne mukelenge ne bantu ne, Tuetu netuikale bantu ba Yehowa; wakahunga tshihungidi tshikuabo hankatshi ha mukelenge ne bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso ba mu ditunga bakaya ku nsubu wa Bala, bakamushimbula; bakabutula bioshelu biandi ne mpingu yandi bituha bituha; bakashiha Matana, muakuidi wa Bâla, ku mpala kua tshioshelu. Muakuidi wa Nzambi wakasungula balami ba nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakasangisha tupitene tua bantu nkama bantu nkama, ne Bena Kala ne balami ne bantu bonso ba mu ditunga; bakafuma ne mukelenge mu nsubu wa Yehowa, bakaya nʼandi mu nshila wa ku tshibi tshia balami tô ne mu nsubu wa mukelenge, Yeye wakashikama mu nkuasa wa butumbi wa bakelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.19",
            "verseOrgIds": [
              "2KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bantu bonso ba mu ditunga bakasanka, bakashikama talalâ. Bakashiha Atalaya ne muele wa nvita hehi ne nsubu wa mukelenge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        }
      ]
    },
    {
