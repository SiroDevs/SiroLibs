              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoaza wakadi ne bidimu makumi abidi ne bisatu hakabangeye kukokesha; wakakokesha mu Yelushalema ngondo isatu. Dina dia mamu wandi diakadi Hamutula, muana mukashi wa Yelemiya wa mu Libena. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza malu mabi ku mesu kua Yehowa bu muakenza bankambua bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pâlo-neko wakamuela mu lukanu mu Libela mu buloba bua Hamata bua yeye kakokeshi mu Yelushalema; yeye wakalambuisha bena buloba milambu ya ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.33:",
              "type": "text"
            },
            {
              "text": "Tangila 2 Bakelenge 5.5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya argent lukama ne ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.33:",
              "type": "text"
            },
            {
              "text": "Tangila 1 Bakelenge 18.14.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa or umue. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palô-neko wakasungula Eleyakima, muana wa Yoshiya, mukelenge mu muaba wa Yoshiya, tatu wandi; wakamuidika dina dikuabo ne, Yehoyakima; yeye wakumusha Yehoaza, wakamutuma mu Ejipitu, wakafuilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakima wakafila argent ne or kudi Palô; kadi wakalambuisha bena buloba bu muakamba Palô; wakalambuisha muntu ne muntu bu mu bintu biakadiye nʼabi, bua kulambuleye Palô-neko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
