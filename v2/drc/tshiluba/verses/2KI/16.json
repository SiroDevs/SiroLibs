    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia dikumi ne muanda mutekete tshia bukelenge bua Peka, muana wa Lemalaya, Ahaza, muana wa Yotama, mukelenge wa Yuda, wakabanga kukokesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaza wakadi ne bidimu makumi abidi hakabangeye kukokesha; wakakokesha mu Yelushalema bidimu dikumi ne bisambombo. Yeye kakenza malu mimpe ku mesu kua Yehowa, Nzambi wandi, bu muakenza Davidi, tatu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakenda mu nshila wa bakelenge ba Isalele; wakahitshisha muanʼandi wa balume mu kahia bu mu malu a bundu a bantu ba mu bisamba bia bende bakihatabo kudi Yehowa ku mesu kua Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafila milambu ya kuosha ha kahia ne musenga wa manananshi ha mutu ha mikuna ne ha tukuna ne muinshi mua mitshi mibishi yonso.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Lesinyi, mukelenge wa Sulia, ne Peka, muana wa Lemalaya, mukelenge wa Isalele, bakalua kuluangana ne Bena Yelushalema; bakatshintshimika Ahaza kadi kabakamanya mua kumutshimuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku tshikondo atshi Lesinyi, mukelenge wa Sulia, wakahingisha Elata ku Sulia; wakihata Bena Yuda mu Elata; Bena Sulia bakalua ku Elata, bakashikamamu tô ne ku dituku edi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Ahaza wakatuma ba-messager kudi Tigelata-pilesê, mukelenge wa Ashû, ne, Meme ndi muntu webe ne muana webe mulume; lua biebe, ansungile mu bianza bia mukelenge wa Sulia ne bia mukelenge wa Isalele, badi baluangana neanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaza wakangata biamu bia argent ne bia or biakadi mu nsubu wa Yehowa ne bintu bilengele biakadi mu nsubu wa mukelenge, wakabituma bu matabisha kudi mukelenge wa Ashû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Ashû wakamunvuila; mukelenge wa Ashû wakaya kuluangana ne musoko wa Damaseke, wakaunyenga, wakaya ne bantu ku Kî mu buhika; wakashiha Lesinyi kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaza wakaya ku Damaseke bua kusangileye ne Tigelata-pilesê, mukelenge wa Ashû; wakatangilaku tshioshelu tshiakadi mu Damaseke. Ahaza wakatuma tshinfuanyi tshia tshioshelu ne luidi luatshi ne buakane buatshi buonso kudi Uliya muakuidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uliya muakuidi wakenza tshioshelu tshikuabo; wakatshifuanyikisha bu bintu bionso biakamutumina mukelenge Ahaza ku Damaseke. Uliya muakuidi wakatshienza ku mpala kua dihingana dia mukelenge Ahaza ku Damaseke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafuma mukelenge ku Damaseke, yeye wakatangila tshioshelu; wakasemena ha buihi ne tshioshelu, wakafilahu milambu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafila milambu ya kuosha ha kahia ne milambu ya bukula; wakahongolola milambu ya bintu bia kunuabo, wakamiamina mashi a milambu ya kuvuisha nʼai ditalala ha tshioshelu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakumusha tshioshelu tshia tshiamu tshia mitaku tshiakadi ku mpala kua Yehowa hankatshi ha tshioshelu tshiandi ne nsubu wa Yehowa, wakatshiteka ku luseke lua ku node lua tshioshelu tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge Ahaza wakelela Uliya muakuidi mukenji ne, Ufile milambu ya kuosha ha kahia ya dinda ha tshioshelu tshinene, ne milambu ya bukula ya dilolo ne milambu ya kuosha ne milambu ya bukula ya mukelenge, ne milambu ya kuosha ne milambu ya bukula ne milambu ya bintu bidibo banua ya bantu bonso; umiaminehu mashi a milambu yonso idibo bosha ha kahia; kadi meme nkayanyi nendifidile milambu ha tshioshelu tshia tshiamu tshia mitaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uliya muakuidi wakenza malu onso akamba mukelenge Ahaza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge Ahaza wakakosa biamu bia ku nseke ya bitekelu, wakumusha biowelu biakadi ha mitu habi, wakumusha tshiowelu tshinene tshiakadi ha nyima ha ngombe ya tshiamu tshia mitaku, wakatshiteka ha mutu ha mabue. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Ahaza wakatshina mukelenge wa Ashû, wakandamuna mu nsubu wa Yehowa tshibuelelu tshiakadi ne tshibuikilu ku mutu, tshiakadi bantu babuelamu dituku dia Lumingu tshiakibakabo mu nsubu ne tshibi tshia ku mbelu tshiakadi mukelenge mubuele. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bia Ahaza bikuabo biakenzeye kabiena bifunda mu mukanda wa kulondolola kua malu a bakelenge ba Yuda, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaza wakalala tulu ne bankambua bandi, bakamujika hohamue ne bankambua bandi mu musoko wa Davidi; Hezikiya, muanʼandi, wakakokesha mu muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
