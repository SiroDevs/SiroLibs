    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia kumudilu dia ngondo wa kumudilu, ushimike ntenta wa kusambakena. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
              "EXO.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubueshemu mushete wa tshihungidi tshia mei a Nzambi, ubuikile mushete ne tshilulu tshia mu nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uluemu ne mesa, ulongolole bintu bidihu, uluemu ne bitekelu bia minda, utekemu minda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uteke tshioshelu tshia or tshia musenga wa manananshi ku mpala kua mushete, ukudike tshilulu ku mbelu kua nsubu wa tshitendelelu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uteke tshioshelu tshia mulambu wa kuosha ku mbelu kua nsubu wa tshitendelelu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uteke tshiowelu hankatshi ha ntenta wa kusambakena ne tshioshelu tshia milambu, welemu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushimike luhangu lua tshilulu lunyunguluke, ukudike tshilulu tshia ku mbelu kua luhangu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangate manyi adibo bela ha mutu, wamiamine ha nsubu wa tshitendelelu ne ha bintu bionso bidimu, ujidile nsubu ne bintu biandi bionso, neikale mujidila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuamine manyi ha tshioshelu tshia mulambu wa kuosha, ne ha bintu biatshi bionso, ujidile tshioshelu tshioshelu netshikale tshijidila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umiamine manyi ha tshiowelu ne ha mesa atshi, utshijidile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulue ne Alona ne bana bandi balume ku mbelu kua ntenta wa kusambakena, uboweshe mai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uluatshishe Alona bilulu bijidila, umuele manyi, umujidike, bua angenzele biandi mudimu wa buakuidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulue ne bana bandi balume kabidi, ubaluatshishe bikowelu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubele manyi bu muwakela tatuʼabo bua kukuatshilabo mudimu wa buakuidibualu ebu nebubajidile mu mudimu wa buakuidi bua tshiendelele mu bikondo biabo bionso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakenza nunku, wakenza malu onso akamuambila Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashimika nsubu wa tshitendelelu mu dituku dia kumudilu dia ngondo wa kumudilu mu tshidimu tshibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.17",
            "verseOrgIds": [
              "EXO.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakashimika nsubu, wakalongolola nkanu ne mabaya, wakabueshamu mitshi, wakajadika makunshi a nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.18",
            "verseOrgIds": [
              "EXO.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabikila nsubu ne tshilulu tshia ha mutu ha nsubu, wakateka tshilulu tshikuabo ha mutu hatshi, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabuesha mabue a mikenji mu mushete, wakateka mitshi ya kutuala nʼai mushete, wakateka tshibuikilu ha mutu ha mushete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalua ne mushete mu nsubu wa tshitendelelu, wakakudika tshilulu, wakajibikila mushete bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateka mesa mu nsubu wa tshitendelelu ku luseke lua ku nôde, ku mpala kua tshilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalongolola mampa ha mesa ku mpala kua Yehowa, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateka bitekelu bia minda mu nsubu wa tshitendelelu ku mpala kua mesa ku luseke lua nsubu lua ku sude. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
            "verseOrgIds": [
              "EXO.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatemesha minda ku mpala kua Yehowa bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateka tshioshelu tshia or mu nsubu wa tshitendelelu ku mpala kua tshilulu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakoshahu musenga wa manananshi, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.27",
            "verseOrgIds": [
              "EXO.40.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakudika tshilulu ku mbelu kua nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.28",
            "verseOrgIds": [
              "EXO.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateka tshioshelu tshia mulambu wa kuosha ku mbelu kua nsubu wa tshiendelele wakoshahu mulambu wa bukula bua manvua bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakateka tshiowelu hankatshi ha ntenta wa kusambakena ne tshioshelu tshia mulambu ya kuosha, wakelamu mai a kuowa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "akadi Mose ne Alona ne bana bandi balume bowesha nʼau bianza ne makasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
              "EXO.40.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 40:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo babuela mu nsubu wa tshiendelele ne hakaluabo hehi ne tshioshelu, bakowa mai, bu muakambila Yehowa Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashimika luhangu ludi lunyunguluka nsubu wa tshitendelelu ne tshioshelu tshia milambu ya kuosha, wakakudika tshilulu ku mbelu kua luhangu. Mose wakashikisha mudimu wonso nunku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 40:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe ditutu diakabuikila ntenta wa kusangakena, ne butumbi bua Yehowa buakûla nsubu tente. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
