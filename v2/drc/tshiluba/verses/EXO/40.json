              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose kakamanya mua kubuela mu ntenta bualu bua difutu diakimana ha mutu ha nsubu, ne butumbi bua Yehowa buakula nsubu tente. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
