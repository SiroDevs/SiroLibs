            "number": "37",
            "style": "v",
            "sid": "EXO 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakadi difutu kadiyi dibandishibua, kabakaya mu luendu tô ne ku dituku diakabandishibua difutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
        {
