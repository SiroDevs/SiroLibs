          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngendu yabo yonso, hakabandishibua difutu ha mutu ha nsubu, Bena Isalele bakadi babanga luendu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
        {
          "name": "verse",
