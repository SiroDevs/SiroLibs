  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, mubikidibue mupostolo wa Yesu Kilisto bua disua dia Nzambi, ne Sosetene, muanʼetu wa mu Kilisto, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tudi tufunda mei kudi bena ekelesia ba Nzambi badi mu Kolinto, bajidibue mu Kilisto Yesu, babikidibue bua kuikalabo basanto, ne kudi bonso badi babikila dina dia Mukelenge Yesu Kilisto mu muaba wonso, Mukelenge wabo ne wetu kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasa kunudi ne ditalala bia kudi Nzambi Tatu wetu ne kudi Mukelenge Yesu. Kilisto.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nsakidila Nzambi misangu yonso bua bualu buenu, bua ngasa wa Nzambi wakanuhebua mu Kilisto Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua nuakavuishibua babanshi mu malu onso munda muandi, mu dî dionso ne mu lungenyi luonso; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bu muakajadikibua tshimanyishilu tshia Kilisto munda muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku kanuena nuhanga mu tshihedi tshimue; nudi nuindila dimueneka dia Mukelenge wetu Yesu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kabidi neanujadike tô ne kunshikidilu, bua kanuikadi ne tshia kunubandabo nʼatshi mu dituku dia Mukelenge wetu Yesu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi udi wa kueyemena, yeye nguakanubikila mu buobumue bua Muana wandi Yesu Kilisto Mukelenge wetu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, ndi nusengelela bua dina dia Mukelenge Yesu Kilisto, bua buonso buenu nuambe dî diodiumue, ne bua kakuikadi matahuluka munkatshi muenu; kadi bua nuenu nuikale bâkashibue tshishiki mu meshi amue ne mu lungenyi lumue. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bakanmanyisha bua bualu buenu, bana betu, kudi ba mu nsubu wa Kaloe ne, Kutandangana kudi munkatshi muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ngamba nunku ne, Muntu ne muntu wa munkatshi muenu udi wamba ne, Meme ndi wa Paulo; meme ndi wa Apolo; meme ndi wa Kefa; meme ndi wa Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilisto udi mutahuluka, anyi? Paulo wakanufuila ha mutshi mutshiamakane, anyi? Nuakabatijibua mu dina dia Paulo, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nsakidila Nzambi ne tshiakabatiza umue wenu anu Kulisipo ne Gayo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua muntu kambi biandi ne, Bakanubatiza mu dina diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabatiza ba mu nsubu wa Stefana kabidi; bua munga muntu, tshiena mumanye ne nakabatiza mukuabo anyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Kilisto kakantuma bua kubatiza, kadi wakantuma bua kuamba lumu luimpe; kembua kuamba mu lungenyi lua mei, bua mutshi mutshiamakane wa Kilisto kauvuishibu bu tshintu tshia hatuhu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua kuamba bua mutshi mutshiamakane kudi bualu buhote kudi bantu batshidi bajimina; kadi kudi bukole bua Nzambi kudi tuetu batshidi basungidibua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bakafunda ne,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, tangilai dibikidibua dienu ne, Kakuena ba bungi babikidibue badi bena meshi mu buntu buabo, kakuena ba bungi badi bakole, kakuena ba bungi badi baledibue bena butumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Nzambi wakasungula malu mahote a ha buloba bua kufuisheye nʼau bena meshi bundu; ne Nzambi wakasungula bintu bitekete bia ha buloba bua kufuisheye nʼabi bintu bikole bundu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Nzambi wakasungula malu mahuekela a ha buloba, ne malu adibo bahetula, ne bintu bidi kabîku, bua kuvuisheye nʼabi bintu bidiku ne ntshianana; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua kakuikadi wa mu mubidi udi mua kutumba ku mesu kua Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bua bualu buandi nuenu nudi mu Kilisto Yesu, wakayuishibua meshi a kudi Nzambi kutudi: ne buakane ne bujidibu ne buhikudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua mbu muakafundabo ne,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        }
      ]
    }
  ],
