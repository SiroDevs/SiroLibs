          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bivuadi ne nkasu ne bihanza: bintu ebi bionso biakenzela Hilama mukelenge Solomo mu nsubu wa Yehowa biakadi bia tshiamu tshia mitaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakafudila biamu ebi bionso mu maloba a dime a mu mpata wa Yadene, hankatshi ha Sukota ne Saletana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo kakidikisha majitu a biamu ebi bionso, bualu bua biakatamba bungi, nunku kabakamanya bujitu bua tshiamu tshia mitaku tshinonoka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
