          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua bualu ebu Yalobama kakalekela bubi buandi; kadi wakasungula bakuidi munkatshi mua bantu bonso ba tshianana, wakabateka mu bitendelelu biakadi ku mikuna. Yeye wakajidila muntu yonso wakadi musue, bua bakuidi bikale mu bitendelelu bia ha mikuna. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
