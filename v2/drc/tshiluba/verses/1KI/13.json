            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu ebu buakalua bubi kudi ba mu nsubu wa Yalobama, bua kubahidiabo ne bua kubajimishabo ha buloba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
