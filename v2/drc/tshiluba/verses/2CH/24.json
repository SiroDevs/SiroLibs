  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoasha wakadi ne bidimu muanda mutekete hakababangeye kukokesha; wakakokesha mu Yelushalema bidimu makumi anai; dina dia mamu wandi diakadi Sibeya wa mu Bê-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoasha wakenza malu mimpe ku mesu kua Yehowa matuku onso a Yehoyada muakuidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada wakamubakisha bakashi babidi; yeye wakalela nʼabo bana ba balume ne bana ba bakashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua malu â Yoasha wakasua kukankamasha nsubu wa Yehowa kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakasangisha bakuidi ne Bena Lewi, wakabambila ne, Yai bienu ku misoko yonso ya Yuda, nusangishe argent kudi Bena Isalele bonso ya kulongolola nʼai nsubu wa Nzambi wenu ku tshidimu ku tshidimu; nudimuke bua nuenu nuenzeshe bualu ebu lukasa. Kadi Bena Lewi kabakenzesha bualu ebu lukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakabikila Yehoyada muakuidi, wakamuambila ne, Wewe kuakuenzesha Bena Lewi bua bobo balue ne milambu ya Mose, muntu wa Yehowa, kudi Bena Yuda ne ba mu Yelushalema ne ba mu nseke yonso ya Isalele, mu ntenta wa bumanyishi bishi? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bana balume ba Atalaya, mukashi au mubi, bakadi habutula nsubu wa Nzambi, bakaha Bâla bintu bia tshijila biakadi mu nsubu wa Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku mukelenge wakela mukenji, bakalongolola mushete; bakauteka ha mbelu ku tshibi tshia ku nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakela mukenji ku nseke yonso ya Yuda ne Yelushalema bua bantu balue kudi Yehowa ne milambu yakambila Mose Bena Isalele mu tshihela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu banene ne bantu bonso bakasanka, bakatua nʼai, bakayela mu mushete tô ne hakasangishabo yonso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo balue ne mushete kudi bena mudimu ba mukelenge ku bianza bia Bena Lewi, ne hakamonabo ne argent ya bungi yakadi mu mushete, secrétaire wa mukelenge ne mukuatshishi wa muakuidi bakahatula bintu mu mushete, bakauhingisha mu muaba wau kabidi. Bakenza nunku ku dituku ku dituku, bakasangisha argent ya bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge ne Yehoyada bakayifila kudi bantu bakadi benza mudimu mu nsubu wa Yehowa; bobo bakabikila bahandi ba mabue ne bena mabaya bua kulongololabo nsubu wa Yehowa, ne bena biamu bifike ne bena biamu bia mitaku kabidi bua kulongololabo nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena mudimu bakenza mudimu wabo; mudimu wakenda bimpe mu bianza biabo, bakalongolola nsubu wa Nzambi bu muakadiye diambedi, bakamuakasha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamanabo mudimu wonso, bakalua ne argent yakashala kudi mukelenge ne kudi Yehoyada, bakatula nʼai mpanza ya kuteka mu nsubu wa Yehowa, mpanza mene ya kuenza nʼai mudimu ne nkutu ne mpanza ya or ne ya argent. Bakafila milambu ya kuosha ha kahia mu nsubu wa Yehowa misangu yonso mu matuku a Yehoyada.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yehoyada wakalua muntu mununu, wakadi ne matuku a bungi; wakafua; wakadi ne bidimu lukama ne makumi asatu hakafueye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamujika mu musoko wa Davidi diatshimue ne bakelenge, bualu bua yeye wakenza bimpe mu Isalele, ne kudi Nzambi ne ku nsubu wandi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua lufu lua Yehoyada bantu banene ba mu Yuda bakalua, bakakukuila mukelenge. Mukelenge wakunvua mei abo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalekela nsubu wa Yehowa, Nzambi wa bankambua babo, bakakuatshila Bashela ne mpingu mudimu; tshiji tshia Nzambi tshiakadi kudi Bena Yuda ne ba mu Yelushalema bualu bua bobo bakenza bualu ebu bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakabatumina baprofete bandi bua kubahingisha kudi Yehowa kabidi; bobo bakababela; kadi kabakateleja matshu abo kudibo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma wa Nzambi wakatulukila Zekâya, muana wa Yehoyada muakuidi; yeye wakimana ku mpala kua bantu, wakabambila ne, Nzambi udi wamba ne, Nuenu nudi mishiha mikenji ya Yehowa bua tshinyi? Kanuena ne diakalengele bishi? Bualu bua nuenu nuakulekela Yehowa, ka yeye wakunulekela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakamuela tshifufu, bakamuela mabue ku mukenji wa mukelenge mene mu tshiendedi tshia mu nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku mukelenge Yoasha kakavuluka luse luakamulesha Yehoyada tatu wandi; kadi wakashiha muanʼandi. Hakafueye, yeye wakamba ne, Yehowa atangile bualu ebu, anufute.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunshikidilu kua tshidimu atshi masalayi a Bena Sulia bakatua bua kuluangana nʼandi; bakafika ku Yuda ne Yelushalema, bakashiha bantu banene bonso ba munkatshi mua bantu, bakatuma bintu biabo bionso kudi mukelenge wa Damaseke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Sulia bakalua ne tshisumbu tshikese tshia masalayi; Yehowa wakafila tshisumbu tshia bantu tshinene mu bianza biabo, bualu bua bobo bakadi bahidie Yehowa, Nzambi wa bankambua babo. Nunku bakalumbuluisha Yoasha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumukabo kudiye (bualu bua bakamushiya ne disama dikole), bantu bandi mene bakamuelela tshifufu, bualu bua mashi a bana balume ba Yehoyada muakuidi, bakamushiha mu bulalu buandi, wakafua; bakamujika mu musoko wa Davidi, kadi kabakamujika mu nkita ya bakelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
