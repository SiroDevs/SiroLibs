  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "2CH 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manashe wakadi ne bidimu dikumi ne bibidi hakabangeye kukokesha; wakakokesha mu Yelushalema bidimu makumi atanu ne bitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza malu mabi ku mesu kua Yehowa bu muakenza bisamba biakalonda malu a bundu, biakadi Yehowa muihate ku mpala kua Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua yeye wakasa kabidi bioshelu ha mutu ha mikuna biakashimbula Hezikiya tatuʼandi; wakashila Bâla bioshelu, wakakuna mitshi ya Bashela, wakatendelela bintu bia mu diulu, wakabikuatshila mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakasa bioshelu mu nsubu wa Yehowa, muakadi Yehowa wamba ne, Dina dianyi nedikale mu Yelushalema tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakashila bintu bionso bia mu diulu bioshelu mu biendedi bibidi bia mu nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakahitshisha bana bandi mu kahia mu tshibanda tshia muana wa Hinoma; wakatempa matempu, wakatendelela bakishi, wakahaka manga, wakasangisha dî ne batempeshanganyi ba mbuku ne bena buloshi; yeye wakenza malu mabi a bungi ku mesu kua Yehowa bua kumufuisha nʼau tshiji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakateka luhingu luakasongeye mu nsubu wa Nzambi, muakadi Nzambi wamhila Davidi ne Solomo muanʼandi ne, Nenteke dina dianyi mu nsubu eu wa mu Yelushalema unakasungula munkatshi mua bisamba bionso bia mu Isalele, nentekemu dina dianyi tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshiena ngumusha makasa a Bena Isalele ku buloba bunakaha bankambua babo, biatumikilabo mei onso anakabambila, mikenji ne mei mafunda ne mei majalame binakabambila mukana mua Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manashe wakibidisha Bena Yuda ne ba mu Yelushalema bua kuenzabo malu mabi; nunku bakahita bantu ba mu bisamba biakashihabo kudi Yehowa ku mpala kua Bena Isalele kuenza malu mabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Manashe ne bantu bandi dî diandi; kadi bobo bakamuhetula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yehowa wakatuma tupitene tua masalayi a mukelenge wa Ashû kudibo, bakakuata Manashe, bakamusuika nkanu, bakaya nʼandi ku Babulona. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadiye mu ntatu nunku yeye wakakeba Yehowa Nzambi wandi, wakatamba kudihuekesha ku mesu kua Nzambi wa bankambua bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamutendelela; Nzambi wakamunvuila, wakitabusha kutendekena kuandi, wakamuhingisha ku Yelushalema mu bukelenge buandi kabidi. Hashishe Manashe wakamanya ne, Yehowa udi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua bualu ebu yeye wakasa lumbu luakadi ku mpenge kua musoko wa Davidi ku luseke lua ku wesete kua Gihona, mu tshibanda, tô ne ku tshibuelelu tshia bahanyishi ba minyinyi ya mu mai; wakanyunguluka nʼalu Ofele, wakalulungakasha tô ne kulu; wakateka tupitene tua bukitu mu misoko yonso ya Yuda yakadi ne ngumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakumusha nzambi ya bende ne luhingu luakatekeye mu nsubu wa Yehowa, ne bioshelu biakaseye ku mukuna kuakadi nsubu wa Yehowa ne mu Yelushalema, wakabimasha ku mpenge kua musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakalongolola tshioshelu tshia Yehowa, wakafilahu milambu ya kuosha ne ya kuvuisha nʼai ditalala ne ya kusakidila nʼai Nzambi; wakelela Bena Yuda mukenji bua bobo batendelele Yehowa, Nzambi wa Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bantu bakatshidi bashiha milambu ha mutu ha mikuna, kadi bakayishihela anu Yehowa Nzambi wabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienzedi bikuabo bia Manashe ne mei akalombeye nʼau Nzambi, ne mei akamuambila bamonyi ba malu mu dina dia Yehowa, Nzambi wa Isalele, monai, bidi bifunda mu mukanda wa bienzedi bia bakelenge ba Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mei akalombeye nʼau Nzambi bakitabusha Nzambi kutendekena kuandi, ne malu mabi onso akenzeye, ne ditomboka diandi, ne bioshelu biakaseye ha mutu ha mikuna, ne mitshi ya Bashela yakakuneye, ne mpingu yakasongeye diambedi yeye kayi muanji kudihuekesha, monai, bidi bifunda mu mukanda wa bamonyi ba malu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Manashe wakalala tulu ne bankambua bandi, bakamujika mu nsubu muandi; Amona muanʼandi wakakokesha mu muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amona wakadi ne bidimu makumi abidi ne bibidi hakabangeye kukokesha; wakakokesha mu Yelushalema bidimu bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza malu mabi ku mesu kua Yehowa bu muakenza Manashe tatuʼandi; Amona wakashihela mpingu yonso yakasonga tatuʼandi milambu, wakayikuatshila mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kakadihuekesha ku mesu kua Yehowa bu muakenza Manashe tatu wandi hakadihuekesheye; kadi Amona eu wakatamba kuenzenza malu mabi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bandi mene bakamuelela tshifufu, bakamushiha mu nsubu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
              "2CH.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bena buloba bakashiha bantu aba bakelela Amona tshifufu; bena buloba bakahingisha Yoshiya muanʼandi mu bukelenge mu muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.25",
            "verseOrgIds": [
              "2CH.33.25"
            ]
          }
        }
      ]
    }
  ],
