          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakajika mifuba ya Yosefe, yakalua nʼai Bena Isalele ku Ejipitu, mu Shekeme mu tshituha tshia buloba tshiakasumba Yakoba kudi bana ba Hamo, tatu wa Shekeme, ku bituha lukama bia argent; buakalua buhianyi bua tunkanunuma tua Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
