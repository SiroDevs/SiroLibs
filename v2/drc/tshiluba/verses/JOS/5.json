    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua bakelenge bonso ba Bena Amole bakadi dishiya dia Yadene dia ku wesete, ne bakelenge bonso ba Bena Kanâna bakadi bashikama kukala kua mai manene, lumu ne, Yehowa wakûmisha mai a Yadene ku mpala kua Bena Isalele tô ne hakasabukabo bonso, hashishe mitshima yabo yakahandika, kabakadi ne dikima kabidi bualu bua Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku au Yehowa wakambila Yoshua ne, Enza tuele tua mabue, utengule Bena Isalele tshiakabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua Wakenza tuele atu, wakatengula Bena Isalele ku muaba udibo babikila ne, Mukuna wa tshitenguidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebu mbualu buakabatenguila Yoshua; bualu bua balume bonso, bena nvita, bakaluhuka mu Ejipitu bakafua mu nshila mu tshihela, ku nyima kua kuhatuka kuabo mu Ejipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso bakaluhuka mu Ejipitu bakadi batengula, kadi bantu bonso bakalelabo mu nshila mu tshihela hakaluhukabo mu Ejipitu kabakadi batengula. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Bena Isalele bakendakana mu tshihela bidimu makumi anai tô ne hakajimishibua bena nvita bonso bakaluhuka mu Ejipitu, bualu bua bobo kabakunvua dî dia Yehowa; bakadi Yehowa muditshihe kudibo ne, Nuenu kanuena nutangila buloba buakalaya Yehowa batatu benu ne, Nennuhebu; buloba budi bûle tente ne mabele ne buitshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana babo bakahingasheye mu muaba wabo Yoshua wakabatengula; bualu bua kabakadi batengudibue mu nshila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikishabo kutengula bantu bonso, bobo bakashala mu miaba yabo mu tshitudilu tô ne hakondahibuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Yoshua ne, Lelu nakumusha bundu bua Ejipitu kunudi. Nunku badi babikila muaba au ne, Gilegala tô ne lelu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakasa tshitudilu mu Gilegala; dilolo bakadia bidia bia disanka dia Kuhita kua Yehowa mu mpata ya Yeleko mu matuku dikumi ne anai a ngondo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua disanka dia Kuhita kua Yehowa bakadia bintu biakasanganabo mu buloba, ne mampa adi kayi ne luevene ne manvua",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.11:",
              "type": "text"
            },
            {
              "text": "Kabakadi ne manvua mene mene; bakadi ne bintu bidi bifuana nunyua.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akoshabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana akashika hakabangabo kudia bintu biakasanganabo mu buloba; Bena Isalele kabakadi ne mana kabidi; bakadia anu bintu biakasanganabo mu buloba bua Kanâna tshidimu atshi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadi Yoshua hehi ne Yeleko, wakabanduluka, wakatangila ne, monai, muntu wakadi muimane hehi nʼandi ne muele wa nvita mu tshianza tshiandi, ne Yoshua wakaya kudiye, wakamukonka ne, Wewe udi ku luseke luetu anyi ku luseke lua badi nʼetu lukuna? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakitaba ne, Nansha, nakutuma bu mukelenge wa musumba wa Yehowa. Yoshua wakamututshila mpala hanshi, wakamutendelela, wakamukonka ne, Mukelenge wanyi udi Wambila muntu wandi tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa musumba wa Yehowa wakambila Yoshua ne, Umushe bisabata ku makasa ebe; bua muaba ûdi muimane udi wa tshijila. Yoshua Wakenza nunku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    }
  ],
