          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua, muana wa Nuna, wakatuma batentekedi babidi ku Shitima mu musokoko, wakabambila ne, Yai, nutangile buloba, ne Yeleko. Bobo bakaya, bakabuela mu nsubu wa mukashi muena tshiendenda dina diandi Lahaba, bakalalamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambila mukelenge wa Yeleko ne, Mona, balume ba Bena Isalele bakafika munemu butuku bua kutentekela buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wa Yeleko wakatumina Lahaba dî ne, Hatula balume bakulua kudi, bakubuela mu nsubu muebe; bualu bua bobo bakulua bua kutentekela buloba buonso. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukashi eu wakangata bantu aba babidi, wakabasuika; yeye wakamba ne, Bulelela, bantu aba bakulua kundi kadi tshiakamanya kuakafumabo; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakulua diba didibo binshila bibi bia musoko, hakuila butuku, bantu aba bakaluhuka; kadi meme tshiena mumanye kuakuyabo; nubalonde lubilu, nenubahete. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakamana kuya nʼabo ku musaka wa nsubu wandi, wakabasokoka muinshi mua mitshi ya lin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.6:",
              "type": "text"
            },
            {
              "text": "lin — badi benza tshilulu ne lin.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yakadiye mulonge ha musaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume bakabalonda mu nshila tô ne ku malobo a Yadene; bakaluhuka bantu, bakaya bua kubakeba, bakinshila tshibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diambedi kabayi banze kulala tulu, yeye wakabanda kudibo ku musaka wa nsubu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye wakambila balume aba ne, Ndi mumanye ne, Yehowa wakanuha buloba, ne buowa buakatukuata bualu buenu ne bena buloba bonso badi batekete-teketê ku mpala kuenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuakunvua lumu bu muakumisha Yehowa mai a Dishiba Dikunze ku mpala kuenu, hanuakaluhuka mu Ejipitu; ne bu munuakenzela bakelenge babidi ba Bena Amole, Sihona ne Oga, bakadi dishiya dia Yadene, banuakashiha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatuakunvua lumu alu, mitshima yetu yakahandika, kakuena muntu umue udi mushale ne dikima mu mutshima wandi bualu buenu; bualu bua Yehowa, Nzambi wenu, udi Nzambi wa mu diulu ne ha buloba kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku, ndi nnusengelela ne, Nuditshihe kudi Yehowa bua bualu buanyi bu munakunuenzela bimpe, nuenu kabidi nungenzele meme ne nsubu wa tatu wanyi bimpe, numpe bianyi tshieya tshilelela; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuenu nusungile tatu wanyi ne mamu wanyi, ne bana betu balume ne bana betu bakashi, ne bonso hadibo nʼabo, nusungile mioyo yetu ku lufu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume aba bakamuambila ne, Netudie mioyo yetu bua kukufuila. Biwikala kuyi usokolola bualu buetu ebu hatuha Yehowa buloba, netukuenzele malu a luse ne a bushuwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku yeye wakabatuma ne muonshi ha dididishi dia nsubu, bualu bua nsubu wandi wakadi mutuangane ne lumbu lua musoko, yeye wakashikama ha mutu ha lumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Yai bienu ku mikuna, nunku bantu badi banulonda kabanuhetshi; nusokomeku matuku asatu tô ne hahinganabo; ne ku nyima nudi bamanye mua kuya mu nshila wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume bakamuambila ne, Tuetu netubinge ku mutshihu uwakututshihisha nʼau. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona, hatuabuela mu buloba, wewe neusuike nshinga eu mukunze ku dididishi dia nsubu kuwakututuila: udisangishe mu nsubu webe ne tatu webe ne mamu webe ne bana benu ne bonso ba mu nsubu wa tatu webe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.18",
            "verseOrgIds": [
              "JOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi muntu yonso udi uluhuka ku bibi bia nsubu webe, Uyaya mu misesu, mashi andi neikale ha mutu handi, ne tuetu netubinge; ne muntu yonso udi wikala nʼebe mu nsubu, mashi andi neikale ha mitu hetu, biamulengabo tshianza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.19",
            "verseOrgIds": [
              "JOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi biwamba bualu ebu, hashishe tuetu netubinge bua mutshihu uwakututshihisha nʼau. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Bualu buikale bu mudi mei enu. Yeye wakabatuma, ne bobo bakaya; yeye wakasuika nshinga mukunze eu ku dididishi dia nsubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakumuka ne bakaya ku mikuna, bakashalaku matuku asatu tô ne kakahingana babakebi; bantu bakabakeba mu nshila yonso, kadi kabakabamona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balume aba babidi bakahueka bafume ku mikuna, bakasabuka musulu, bakatua kudi Yoshua, muana wa Nuna; bakamuambila malu onso akabakuata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
              "JOS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakambila Yoshua ne, Bulelela, Yehowa wakadia buloba buonso mu bianza bietu; ne bualu bukuabo kabidi, bena buloba bonso badi batekete-teketê ku mpala kuetu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        }
      ]
    }
  ],
