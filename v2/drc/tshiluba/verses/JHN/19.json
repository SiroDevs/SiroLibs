  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JHN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Pilato wakangata Yesu, wakamukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masalayi akaluka tshifulu tshia bukelenge tshia meba akamubuesha ku mutu, akamuluatshisha tshikowelu tshikunze; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akalua kudiye, akamuambila ne, Muoyo, Mukelenge wa Bena Yuda. Akamukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato wakaluhuka, wakalua kudibo kabidi, wakabambila ne, Tangilai, nakulua nʼandi kunudi bua nuenu mimanye ne, Tshiena mumusangane ne dihila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakaluhuka muluate tshifulu tshia meba ne tshikowelu tshikunze. Pilato wakabambila ne, Monai, muntu eu kayeu! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamumona bakuidi banene ne tuhalai, bakela mbila ne, Umushihe ku mutshi mutshiamakane, umushihe ku mutshi mutshiamakane. Pilato wakabambila ne, Nuenu nudiangatshileye, numushihe; meme tshiena mumusangane ne dihila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Yuda bakamukudimuna ne, Tudi ne mukenshi wetu, mbimpe bia yeye afue biandi bu mudi mukenshi wetu, bua yeye wakudivuisha bu Muana wa Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Pilato dî edi, wakatamba kutshina; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakabuela kabidi mu nsubu munene wa mukelenge, wakakonka Yesu ne, Wewe Wakufuma kudi kunyi? Kadi Yesu kakamukudimuna dî. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato wakamuambila ne, Kuena ungambila dî? Kuena munmanye ne, Meme ndi ne bukokeshi bua kukulekela, ndi ne bukokeshi kabidi bua kukushiha ku mutshi mutshiamakane? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakamuandamuna ne, Bu bukokeshi kabui bukuhebue kudi wa mu diulu, wewe kuakadi kuikala nʼabu bua kungenzela bualu; bua bualu ebu nunku wakunfila mu bianza biebe ngudi ne bualu butambe bubi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha diba adi Pilato wakakeba mua kumulekela; kadi Bena Yuda bakela mei abo bikole ne, Biwalekela muntu eu, kuena mulunda wa Kaisa; muntu yonso udi udivuisha bu mukelenge udi utombokela Kaisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Pilato mei â, wakaluhuka ne Yesu, wakashikama mu nkuasa wa bulumbuludi ha muaba wakadibo babikila ne, Wa Mabue Malongolola Hanshi, kadi mu Buena Yuda ne, Gabata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dilongolola dia Kuhita kua Yehowa diakafika, diba diakadi bu munda munya. Yeye wakambila Bena Yuda ne, Monai Mukelenge wenu! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakela mei abo bikole ne, Umumushe, umumushe, umushihe ku mutshi mutshiamakane! Pilato wakabakonka ne, Nshihe Mukelenge wenu, anyi? Bakuidi banene bakamukudimuna ne, Katuena ne mukelenge mukuabo, anu Kaisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe yeye wakamufila mu bianza biabo bua kumushihabo ku mutshi mutshiamakane.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakangata Yesu; yeye wakaluhuka mudituadile mutshi wandi mutshiamakane, wakaya ku muaba udibo babikila ne, Muaba wa Kabalubalu ka Mutu, mu Buena Yuda ne, Gologota. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamukuminaku milonda mu bianza ne ku makasa ku mutshi mutshiamakane, bakenzela bakuabo babidi muomumue, mukuabo eku, munga eku, Yesu hankatshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.18",
            "verseOrgIds": [
              "JHN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato wakafunda makanda, wakauteka ku mutshi mutshiamakane. Wakafunda ne: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Yuda ba bungi bakabala mukanda eu, bualu bua muaba wakashihabo Yesu wakadi hehi ne musoko; mukanda wakadi mufunda mu muaku wa Bena Yuda ne wa Bena Lomo ne wa Bena Gelika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.20",
            "verseOrgIds": [
              "JHN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bakuidi banene ba Bena Yuda bakambila Pilato ne, Kufundi ne, Mukelenge wa Bena Yuda; ufunde ne, Yeye wakamba ne, Ndi Mukelenge wa Bena Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato wakabambila ne, Nakuenda munakufunda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masalayi, hakamukuminau milonda mu bianza ne ku makasa ku mutshi mutshiamakane, akangata bilulu biandi akabanyangana anai, disalayi biadi, disalayi biadi; ne tshikowelu tshiandi kabidi, kadi tshikowelu katshiakadi ne mitelu, tshiakadi tshikuma tshijima kulu tô ne hanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambilangana ne, Katutshihandi, tutshielele nshobo ne tshikala tshia nganyi; nunku bakashikisha dî diakafundabo mu Mukanda wa Nzambi ne,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Yesu wakamanya ne, Malu onso akushika; bualu bua kushikisha dî diakadi difunda mu Mukanda wa Nzambi, yeye wakamba biandi ne, Ndi ne nyota. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dilonga diakadihu diule tente ne nvinega; bakateka musukulampampa mûsha tente ne nvinega ku mutshi wa hisopa, bakauteka ku mishiku yandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakangateye nvinega, wakamba ne, Bualu buakushika; wakinyika mutu, wakahuola muoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku adi diakadi dia Dilongolola; bualu bua bitalu kabishadî ku mitshi mitshiamakane dia Lumingu (Lumingu alu luakadi dituku dinene), Bena Yuda bakalomba Pilato bua kubitshibulabo bibelu ne kubiumusha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masalayi akalua, akutshibula bibelu bia wa kumudia, ne bia mukuabo wakabashihabo nʼandi ku mutshi mutshiamakane; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi hakalau kudi Yesu, akamusangana mumane kufua, kâkatshibula bibelu biandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi dinga disalayi diakamutua difuma mu lubadi, mashi ne mai biakahatuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatangila bualu abu nguakabuamba, dî diandi ndelela; udi mumanye biandi, ne, Dî dianyi ndilelela, bua nuenu kabidi nuitabushe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malu â akulua bua kushikisha dî diakafundabo mu Mukanda wa Nzambi ne, Kabena batshibula mukuha wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dinga dî didi mu Mukanda wa Nzambi kabidi ne, Nebatangile wakutuabo difuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashika malu â, Yosefe wa ku Alimataya, wakadi muyidi wa Yesu mu musokoko bualu bua wakadi utshina Bena Yuda, wakalomba Pilato bua kuangata tshitalu tshia Yesu; Pilato wakitabusha. Nunku yeye wakalua, wakangata tshitalu tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikodemo, nguakalua kudi Yesu butuku diambedi, wakalua ne mula ne alo bisangisha, biakadi ne bujitu bua kilogama bu makumi anai. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakangata tshitalu tshia Yesu, bakatshinyengela ne bintu ebi bia muhuya muimpe mu bilulu bia line, bu mudi tshilele tshia Bena Yuda ha kujikabo bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuakashihelabo Yesu kuakadi muaba wa mitshi ya mamuma; mu muaba au muakadi lukita luhia-luhia, muakadi tshitalu katshi tshianze kujikibuamu diambedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Dilongolola dia Bena Yuda, ne bua lukita luakadi ha buihi, bakajikamu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
