            "number": "5",
            "style": "v",
            "sid": "JER 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.5",
            "verseOrgIds": [
              "JER.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yehowa udi wamba ne, Ku nyima kua malu â nempingashe diakalengele dia Bena Amona mu muaba wa buhika buabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.6",
            "verseOrgIds": [
              "JER.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.11",
            "verseOrgIds": [
              "JER.49.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua Yehowa udi wamba ne, Mona, bikala badi kabayi bahile ne bua kunua luhanza, wewe neuhanduke kuyi mulengeshibue, anyi? Kuena uhanduka kabayi bakakengesha, kadi neunue luhanza bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.12",
            "verseOrgIds": [
              "JER.49.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yehowa udi wamba ne, Nakuditshiha meme nkayanyi ne, Musoko wa Bosela neulue tshintu tshidi tshikuatshi ha bantu buowa ne tshidibo bahenda, bu tshihela ne tshidibo bela mulau; misoko yau yonso idi mu ntshiamba neyikale bikulu tô ne tshiendelele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.13",
            "verseOrgIds": [
              "JER.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.16",
            "verseOrgIds": [
              "JER.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edome nealue bu tshintu tshidi tshikuatshisha bakuabo huowa; mufitu yonso wahitaku neakeme, neamubingile bua makenga adi amukuata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.17",
            "verseOrgIds": [
              "JER.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Bu muakadi kubutula kua Sodoma ne Amola, ne misoko yakadi hehi nʼai, kakuena muntu washikamamu, kakuena muana wa muntu watulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, neabandeku bu mudi nyama wa ntambue mufume ku ditu dia ku musulu wa Yadene bua kuluisheye mikoko idi mu luhangu ludi hola, nunku nembihate mu muaba wabo lukasa, nenteke muntu yonso undi nsungula ha mutu hau. Bualu bua udi bu meme nganyi! Nganyi udi mua kusunguila tshikondo tshia kuenza bualu? Mulami wa mikoko kai udi mua kuimana ku mpala kuanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.19",
            "verseOrgIds": [
              "JER.49.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku unvuai bualu budi Yehowa muhangidishe bua kuenzela Edome, ne malu akahangidisheye bua kuenzela badi bashikame mu Temana. Bulelela, nebabahulumune bua kuya nʼabo, nansha bana bakese ba mu tshisumbu tshia mikoko mene; bushuwa, ba mu luhangu luabo lua mikoko nebakeme bua bualu bubi bubakuata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.20",
            "verseOrgIds": [
              "JER.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buloba budi buzakala bualu bua tshiona tshia kubutuka kuabo, muadi udiku ne tshiona tshiau tshidi tshiunvuika tô ne ku Mai Manene Makunze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, yeye neabuke kulu, neahahale bu nyunyu wa mukanku, neolole mahuahua andi bua kuluisha ba mu Bosela; mitshima ya bena nvita ba mu Edome mu dituku adi neyikale bu mutshima wa mukashi mu didinyenga diandi dia ha kulela.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi ndi dia Yehowa bualu bua Kedâ ne makelenge a Hasô akayishabo benʼau kudi Nebukadenesâ, mukelenge wa Babulona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi ndî dia Yehowa diakalua kudi Yelemiya muprofete bualu bua Elama, ku tshibangidilu tshia bukokeshi bua Sedekiya, mukelenge wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba udi wamba ne, Mona, nentshibule buta bua Elama, tshieyemenu tshia bukole buabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nentumine Elama mpehele mai ya ku nseke mai ya diulu, nembatangadishe ku mpehele ei yonso, kakuena kuikala tshisamba tshidibo kabayi bafika kudi badibo bihata mu Elama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenkuatshishe Bena Elama buowa ku mpala kua badi nʼabo lukuna, ku mpala kua badi bakeba mioyo yabo. Yehowa udi wamba ne, Nembavuishile ntatu, tshiji tshianyi tshikole mene. Nentume muele wa nvita ku nyima kuabo, tô ne hanababutula bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Nenjadike nkuasa wanyi wa bukelenge mu Elama, ne ku muaba wawa nenshihe mukelenge ne baminyampala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Kadi mu matuku alualua ku mpala nempingashe diakalengele dia Elama mu muaba wa buhika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
    }
