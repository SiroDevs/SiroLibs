              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi ndî diakambila Yehowa Yelemiya muprofete bualu bua Nebukadenesâ, mukelenge wa Babulona, ne, Nealue kubutula buloba bua Ejipitu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
