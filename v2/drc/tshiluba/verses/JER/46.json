          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Ejipitu bualu bua masalayi a Palô-Neko, mukelenge wa Ejipitu, akadi ne tshitudilu tshiau ku muelelu wa musulu wa Pelata mu Kâkemisha, akadi Nebukadenesâ, mukelenge wa Babulona, mutambe bukole mu tshidimu tshinai tshia Yehoyakima, muana wa Yoshiya, mukelenge wa Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
