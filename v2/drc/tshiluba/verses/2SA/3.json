              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakambila Yoaba ne bantu bonso bakadi nʼandi ne, Nulonde bilulu bienu, nuangate bilulu bikayabala, nudivuadikabi, nujinge Abinê. Mukelenge Davidi wakalonda tshituadilu tshia tshitalu tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakajika Abinê mu Hebelone; mukelenge wakabandisha di diandi, wakadila muadi ku lukita lua Abinê; ne bantu bonso bakadila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakajinga Abinê, wakamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
