  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2SA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu mubi wakadiku, dina diandi Sheba, muana wa Bikili, Muena Benyamina; yeye wakela mpungi, Wamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakabuela mu nsubu wandi mu Yelushalema; mukelenge wakangata bakashi bahika dikumi babakibue kudiye, bakashiyeye bua kulamabo nsubu, wakabateka ha buabo, wakabadisha, kadi yeye kakaya kudibo. Bakashala ha muaba au tô ne ku dituku dia lufu luabo bu bakashi ba mu lufuila.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe mukelenge wakambila Amasa ne, Umbikidile Bena Yuda bonso, badisangishe kunoko hahita matuku asatu, wewe wikaleku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Amasa wakaya kusangisha Bena Yuda; kadi yeye wakashala musangu mutambe wakamuambila mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakambila Abishai ne, Katataka Sheba, muana wa Bikili, neatuenzele bibi bidi bihita biakatuenzela Abashaloma; wangate bantu ba mukelenge webe, umulonde, yeye kabuedi mu misoko ya ngumbu, kahanduki kutudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu ba Yoaba ne Bena Kelete ne Bena Pelete ne bena bukitu bonso bakamulonda; bakumuka mu Yelushalema bua kulonda Sheba, muana wa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafikabo ku dibue dinene dia mu Gibeona, Amasa wakasangila habo. Yoaba wakadi muluate bintu biandi bia nvita, wakadi ne muele wa nvita mubuesha ha lukundu luandi mu tshibubu tshiau; hakayeye, muele wakahatuka, wakahona hanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba wakebesha Amasa ne, Muanʼetu, udi mukole, anyi? Yoaba wakakuata Amasa ku muedi ne tshianza tshiandi tshia balume bua kumutua mishiku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Amasa kakadimuka bua muele wakadi mu tshianza tshia Yoaba; yeye wakamutua muele mu mbale, ne mala andi akahatuka hanshi; yeye kakamutua tshiakabidi, wakafua.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba ne muanʼabo Abishai bakalonda Sheba, muana wa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umue wa bansongalume ba Yoaba, wakadi muimane ha buihi handi, wakamba ne, Muntu yonso udi musue Yoaba, udi ku luseke lua Davidi, alonde biandi Yoaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa wakadi mubunguluke mu mashi andi munkatshi mua nshila. Hakatangila nsongalume ne bantu bonso bakadi bimanaku, yeye wakumusha Amasa mu nshila, wakaya nʼandi mu mpata, wakamubuikila tshilulu; bualu bua yeye wakatangila ne muntu yonso wakafika hakadiye wakimanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamûmusheye mu nshila, bantu bonso bakaya ne Yoaba bua kulondabo Sheba, muana wa Bikili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheba wakahitshila munkatshi mua bisamba bionso bia Bena Isalele tô ne ku Abele ne Bete-mâka ne kudi Bena Beli bonso; bakadisangisha hamue, bakamulonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamutshintshimikila mu Abele wa Bete-mâka; bakunguisha mushiki wa mabue ku buludiludi ne lumbu; bantu bonso bakadi ne Yoaba bakumbula kuinshi kua lumbu, bua kulushimbula. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe mukashi wa lungenyi wa mu musoko, wakela dî diandi ne, Unvuai! Telejai! Ndi nnusengelela ne, Ambilai Yoaba alue kunoko bua meme kuyikila handi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakalua ha buihi handi ne mukashi wakamuebesha ne, Wewe udi Yoaba, anyi? Yeye wakamba ne, Mmeme. Hashishe yeye wakamuambila ne, Unvua mei a muntu webe mukashi. Yeye wakamukudimuna ne, Ndi munvue. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe yeye wakamuambila ne, Bantu ba kale bakadi ne lusumuinu ne, Bulelela, nebakonke lungenyi ku Abele, nunku bualu nebushike. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme ndi wa munkatshi mua badi bakeba ditalala ne badi ne kanemu mu Isalele; wewe udi ukeba kushiha musoko ne muledi wa bana wa mu Isalele; wewe udi musue kumina buhianyi bua Yehowa bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba wakamukudimuna ne, Bualu ebu kabuikadi kundi bua kumina anyi bua kushiha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu kabuena nunku, kadi muntu wa ku mikuna ya Efelayima, dina diandi Sheba, muana wa Bikili, wakatombokela mukelenge Davidi mene; anji kumufila mu bianza bianyi, tuetu netumuke tushiya musoko. Mukashi wakambila Yoaba ne, Mona, nebele mutu wandi kûdi ku nyima ha lumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe mukashi wakaha kudi bantu bonso ne lungenyi luandi. Bakakosa Sheba, muana wa Bikili, mutu, bakawela kudi Yoaba. Yeye wakela mpungi, bantu bonso bakumuka ku musoko, bakaya muntu ne muntu ku ntenta wandi. Yoaba wakahingana kudi mukelenge mu Yelushalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba wakadi ku mutu kua masalayi onso a Bena Isalele; Benaya, muana wa Yehoyada, wakadi ku mutu kua Bena Kelete ne Bena Pelete; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adolama wakadi ku mutu kua bena mudimu; Yehoshafata, muana wa Ahiluda, wakadi mufundi wa malu a bukelenge; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sewa wakadi mufundi; Sadoka ne Ebeyatâ bakadi bakuidi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Ila, Muena Yaî, wakadi muakuidi ku mutu kua miloho ya Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
            "verseOrgIds": [
              "2SA.20.26"
            ]
          }
        }
      ]
    }
  ],
