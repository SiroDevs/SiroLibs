          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakidika musoko eu dina ne, Dana, ndina dia Dana nkambua wabo, wakaledibua kudi Isalele; kadi dina dia musoko diakadi Layisha diambedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
