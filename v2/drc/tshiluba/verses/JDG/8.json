          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafua Gideona, Bena Isalele bakalukila ku nyima, bakalonda malu a masandi kudi Babala, ne bakavuisha Bâla-belita nzambi wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele kabakavuluka Yehowa, Nzambi wabo, nguakabasungila mu bianza bia bantu bakadi nʼabo lukuna bonso ba ku nseke yonso; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabakalesha ba mu nsubu wa Yelubâla, udi Gideona mene, luse bu malu mimpe akalesheye Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
            "verseOrgIds": [
              "JDG.8.35"
            ]
