          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelubâla, muana wa Yoasha, wakaya, wakashikama mu nsubu muandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
              "JDG.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideona wakadi ne bana balume makumi muanda mutekete bakaleleye, bualu bua yeye wakadi ne bakashi ba bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
              "JDG.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukashi, muhika wandi wakadiye mubake, wa mu Shekeme, wakamulelela muana wa balume kabidi, wakamuidika dina ne Abimeleke. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideona, muana wa Yoasha, wakafua biandi ku bununu buandi, bakamujika mu majambu a tatu wandi Yoasha mu musoko wa Ofela wa Bena Abiezê.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        }
      ]
    },
