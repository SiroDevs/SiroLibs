  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JDG 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakenza malu mabi ku mesu kua Yehowa; ne Yehowa wakabafila mu bianza bia Bena Midiyana bidimu muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshianza tshia Bena Midiyana tshiakahita Bena Isalele bukole; bualu bua Bena Midiyana, Bena Isalele bakadimbila mena mu mikuna ne mbuebue, bakadiashila ngumbu ya mabue. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakakuna Bena Isalele bintu mu buloba, hashishe Bena Midiyana ne Bena Amaleka ne bantu ba ku esete bakatua kudibo, bakafila kubalesha; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakabatshintshimika, bakahaula bintu biakamena mu buloba, tô ne nakafikabo ku Gaza; kabakashila Bena Isalele tshia kudia, nansha mukoko nansha ngombe nansha mpunda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua hobo bakulua ne bimuna biabo ne ntenta yabo; bakafila bu bungi bua mikumbi; hobo ne tumelo tuabo kabakabadibua; bakafila mu buloba bua kububutula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakatamba kulua bahele bualu bua Bena Midiyana; ne Bena Isalele bakadila kudi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakadila Bena Isalele kudi Yehowa bualu bua Bena Midiyana, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe Yehowa wakatumina Bena Isalele muprofete; yeye wakabambila ne, Yehowa, Nzambi wa Isalele, udi wamba ne, Meme nakafuma nʼenu mu Ejipitu, nakanuhatula mu nsubu wa buhika; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakanusungila mu bianza bia Bena Ejipitu ne mu bianza bia bantu bonso bakadi banukengesha, nakabihata ku mesu kuenu, nakanuha buloba buabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakanuambila ne, Meme ndi Yehowa, Nzambi wenu; kanutshinyi nzambi ya Bena Amole, bena buloba bunudi bashikame. Kadi nuenu ka-nuakunvua dî dianyi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wa Yehowa wakalua, wakashikama muinshi mua mutshi wa telebinta wa mu Ofela, mu buloba bua Yoasha, muena Abiezê; ne muanʼandi Gideona wakadi ushihula blé mu tshikaminu tshia tumuma bua kuyisokoka kudi Bena Midiyana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wa Yehowa wakamueneka kudiye, wakamuambila ne, Yehowa udi nʼebe, wewe muntu mukole wa bukitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideona wakamukudimuna dî ne, Mukelenge wanyi, bikala Yehowa nʼetu, malu â onso akatukuata bualu kai? Malu andi a kukema akatuambilabo kudi bakaku betu ehi, hakatuambilabo ne, Yehowa kakatuhatula mu Ejipitu, anyi? Kadi katataka Yehowa wakatula dia, wakatuma mu bianza bia Bena Midiyana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakatshunguluka kudiye, wakamuambila ne, Ya mu bukole ebu mbuebe, usungile Bena Isalele mu bianza bia Bena Midiyana; tshiakakutuma, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamukonka ne, Mukelenge, meme nensungile Bena Isalele munyi? Mona, ba mu diku dianyi badi bahita Bena Manashe bonso bahele, ne meme ndi mutambe buhuekele mu nsubu wa tatu wanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakamuambila ne, Bulelela, meme nengikale nʼebe, ne wewe neushihe Bena Midiyana bu muntu umue. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuambila ne, Bingikala musangane diakalengele ku mesu kuebe, undeshe tshimanymu ne, Nguewe mene udi wakula nʼanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nkusengelela ne, Kumuki aha tô ne hanalua ne matabisha anyi a kuteka ku mpala kuebe. Yeye wakamba ne, Nenkuindile tô ne hawalua kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideona wakabuela mu nsubu, wakalongolola muana wa mbushi ne mikata ya tshihiminu tshia bukula buakadi kabuyi ne luevene; wakateka munyinyi mu tshisaka ne nsuhu mu luesu, wakalua nʼabi kudiye muinshi mua mutshi, wakabifila kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wa Nzambi wakamuambila ne, Angata munyinyi ne mikata idi kayiyi ne luevene, ubiteke ha mutu ha dibue edi, witshikishe nsuhu. Yeye Wakenza nunku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe muanjelo wa Yehowa wakatua lusongo lua mulangala wakadi mu tshianza tshiandi ha munyinyi ne ha mikata yakadi kayiyi ne luevene; ne kahia kakahatuka mu dibue, kakosha munyinyi ne mikata yakadi kayiyi ne luevene; muanjelo wa Yehowa wakumuka ku mesu kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideona wakamanya ne, Yeye udi muanjelo wa Yehowa; Gideona wakamba ne, Aka, Mukelenge Yehowa! Bualu bua nakumonangana ne muanjelo wa Yehowa mpala ha mpala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakamuambila ne, Ditalala dikale kûdi, kutshinyi, wewe kuena ufila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Gideona wakibakilaku Yehowa tshioshelu, wakatshibikila ne, Yehowa-Shaloma; tshitshidiku tô ne lelu mu Ofela wa Bena Abiezê.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Butuku abu mene Yehowa wakamuambila ne, Wangate ngombe wa tatu webe, ngombe wandi muibidi bidimu muanda mutekete, ushimbule tshioshelu tshia Bâla tshidi tatu webe nʼatshi, utahe mutshi wa Ashela udi hehi nʼatshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "wibakile Yehowa, Nzambi webe, tshioshelu ha mutu ha dibue edi, mu muaba mulongolola, wangate ngombe au muibidi, umufileku bu mulambu wa kuosha ha kahia ne nkunyi ya mutshi wa Ashela uwataba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Gideona wakangata bena mudimu bandi dikumi, wakenza bu muakamuambila Yehowa; bualu bua yeye wakadi nutshine ba mu nsubu wa tatu wandi, ne bena musoko kabidi, yeye kakenza bualu ebu mu munya, kadi wakabuela mu butuku.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
