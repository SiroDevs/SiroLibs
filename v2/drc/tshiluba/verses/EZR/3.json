            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakajadika bibaki bishimikidi bia ntempelo wa Yehowa, bakuidi baluata bilulu biabo bakalua ne mpungi, ne Bena Lewi, bana balume ba Asafa, bakalua ne makasa bua kutumbishabo Yehowa bu muakadi dî dijadika kudi Davidi, mukelenge wa Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakimba misambu, bakuabo batume, bakuabo bahungidishe, bakasakidila Yehowa bamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
