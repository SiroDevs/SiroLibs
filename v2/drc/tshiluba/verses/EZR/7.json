      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua malu â, mu bukokeshi bua Atashasete, mukelenge wa Pelasa, Ezela, muana wa Selaya, muana wa Azaya, muana wa Hilekiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana wa Shaluma, muana wa Sadoka, muana wa Ahituba, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana wa Amalia, muana wa Azaya, muana wa Melayota, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana wa Zelaya, muana wa Uzi, muana wa Buki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana wa Abishua, muana wa Pinehasa, muana wa Eleazâ, muana wa Alona, muakuidi mutambe bakuabo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezela eu mene wakafuma mu Babulona; wakadi mufundi muakane wa mikenji ya Mose yakafila Yehowa, Nzambi wa Bena Isalele; mukelenge wakamunvuila mu malu onso akamuebesheye bualu bua tshianza tshia Yehowa, Nzambi wandi, tshiakadi kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakuabo ne bakuidi ne Bena Lewi ne bimbi ba misambu ne batuadi ba bintu ne Bena Netinima",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.7:",
              "type": "text"
            },
            {
              "text": "Tangila Ezela 2.43.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bakaya nʼandi ku Yelushalema mu tshidimu tshia muanda mutekete tshia bukokeshi bua mukelenge Atashasete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye Wakafika ku Yelushalema mu ngondo muitanu wa mu tshidimu tshia muanda mutekete tshia bukokeshi bua mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabanga luendu luandi dituku dia kumudilu mu ngondo wa kumudilu mu Babulona; Wakafika ku Yelushalema ku dituku dia kumudilu dia ngondo muitanu bualu bua tshianza tshimpe tshia Nzambi wandi tshiakadi kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Ezela wakadi mujadike mu mutshima wandi bua kukeba mikenji ya Yehowa ne bua kuyenza ne bua kuyisheye Bena Isalele mikenji ne mei majalame.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eu mmukanda wakaha mukelenge Atashasete Ezela muakuidi ne mufundi, mufundi mene wa mei a mikenji ya Yehowa ne wa malu akadiye musue benze kudi Bena Isalele: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atashasete, mukelenge wa bakelenge, kudi Ezela, muakuidi, mufundi wa mikenji ya Nzambi wa mu diulu udi muakane: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme ndi ngela mukenji ne, Bena Isalele bonso ne bakuidi babo ne Bena Lewi badi mu bukelenge buanyi badi basue mu mitshima yabo bua kuya ku Yelushalema, baye nʼebe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua wewe udi mutumibue kudi mukelenge ne bena lungenyi bandi muanda mutekete, bua wewe kuebesha bua Yuda ne Yelushalema bu mudi mikenji ya Nzambi webe idi mu bianza biebe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua wewe kutuala argent ne or biakafua mukelenge ne bena lungenyi bandi bu mudi disua diabo kudi Nzambi wa Isalele, udi mushikame mu Yelushalema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne argent yonso ne or yonso biudi usangana mu bukelenge bua Babulona, ne bintu bia bantu bonso ne bakuidi biakasuabo kufila bua nsubu wa Nzambi wabo udi mu Yelushalema; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku bûdi nʼabu mbua kusumba ne argent ei ngombe ne bimpanga ne bana ba mikoko ne milambu yabi ya bukula ne ya bintu bia kunua, biudi ufila ha tshioshelu tshidi mu nsubu wa Nzambi webe udi mu Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshionso tshidi tshimueneka tshimpe kûdi ne kudi bana benu tshia mua kuenza ne argent ne or bidi bishala, nuenze bu mudi disua dia Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malonga adibo bafila kûdi bua kuenza nʼau mudimu wa mu nsubu wa Nzambi webe, wâfila ku mpala kua Nzambi mu Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshionso tshiudi ukengela bua nsubu wa Nzambi webe, tshiudi ne bua kufila, utshiangate mu tshibutshilu tshia mu nsubu wa mukelenge.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme, mukelenge Atashasete mene, Ndi ndelela balami bonso ba bintu badi dishiya dia musulu wa Pelata mukenji ne, Nuhe Ezela muakuidi ne mufundi wa mikenji ya Nzambi wa diulu tshionso tshidiye unulomba lubilu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "tô ne ku ntalanta",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.22:",
              "type": "text"
            },
            {
              "text": "Ntalanta wa argent wakadi ne bujitu bua 44 kg.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya argent lukama, ne ku bihiminu bia blé lukama, ne ku bihiminu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.22:",
              "type": "text"
            },
            {
              "text": "Tshihiminu etshi tshiakadi tshia 37 litres.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bia nvinyo lukama ne ku bihiminu bia manyi lukama; ne luehu ludi kaluyi lubadibue bungi bualu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshionso tshidi Nzambi wa mu diulu wamba tshienjibue mene mene bua nsubu wa Nzambi wa mu diulu; bua tshiji netshikale ku bukokeshi bua mukelenge ne bana bandi ba balume bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuditunuelela mukenji kabidi ne, Kanulambuishi bakuidi ne Bena Lewi ne bimbi ba misambu ne batuadi ba bintu ne Bena Netinima",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.24:",
              "type": "text"
            },
            {
              "text": "Tangila Ezela 2.43.",
              "type": "text"
            }
          ]
        },
        {
          "text": " anyi bena mudimu bonso ba mu nsubu wa Nzambi milambu, ya bia bungendʼa mushinga ne ya mpunga.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe, Ezela, bu mudi lungenyi lua Nzambi webe lûdi nʼalu mu tshianza tshiebe, sungula balumbuluishi banene ne ba-juge bua bobo balumbuluile bantu bonso badi dishiya dia musulu wa Pelata, bonso badi bamanye mikenji ya Nzambi webe; uyishe yonso udi kayi muyimanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.25",
            "verseOrgIds": [
              "EZR.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi ubenga mua kutumikila mikenji ya Nzambi webe ne mikenji ya mukelenge, bamulumbuluishe lubilu, bamuhishe bua lufu anyi bua kumuihatabo mu buloba buandi, anyi bua kumunyengabo bintu biandi anyi bua kumuelabo mu lukanu.",
          "type": "text",
