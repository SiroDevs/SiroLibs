          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele wakamba ne, Bulelela, bu muakadi muele webe wa nvita mushiye bakashi kabayi ne bana, nunku mamu webe neikale munkatshi mua bakashi kayi ne bana. Samuele wakakosa Agaga bituha bituha ku mpala kua Yehowa mu Gilegala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
