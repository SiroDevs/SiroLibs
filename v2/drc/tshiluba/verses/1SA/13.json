  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula wakadi ne bidimu makumi anai hakabangeye kukokesha mu Isalele. Hakakokesheye bidimu bibidi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula wakadisunguila Bena Isalele binunu bisatu: binunu bibidi biakadi ne Shaula mu Mikemasha ne ku mukuna wa Betele, ne tshinunu tshikuabo tshiakadi ne Yonatana mu Gibea wa mu buloba bua Benyamina; yeye wakatuma mundi ne mundi ku ntenta wandi wa mu bantu bakashala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatana wakashiha masalayi a Bena Peleshete akadi mu Geba; Bena Peleshete bakunvua lumu elu. Shaula wakelesha mpungi ku nseke yonso ya buloba, wamba ne, Bena Ebelu bonso, unvuai. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bonso bakunvua lumu ne, Shaula wakashiha masalayi a Bena Peleshete ne Bena Isalele bakahetudibua kudi Bena Peleshete. Bantu bonso bakadisangisha kudi Shaula mu Gilegala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakadisangisha bua kuluanganabo nvita ne Bena Isalele, bungi bua bena makalu buakadi binunu makumi asatu, ne bua bakadi babanda ha nyima ha tubalu buakadi binunu bisambombo, ne bungi bua bantu bakadi benda hanshi buakadi bu nsenga ya ku muelelu wa mai manene; bakalua, bakasa tshitudilu tshiabo mu Mikemasha ku esete kua Bete-awena. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Bena Isalele ne didi munkatshi mua malu makole (bualu bua bantu bakadi ne ntatu), nunku bakasokoma mu mbuebue ne mu bisuku ne mu mabue ne mu miaba mikuabo ya kusokoma ne mu mena a mikela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Ebelu bakuabo bakadi basabuka musulu wa Yadene ku buloba bua Gada ne bua Gilada; kadi Shaula wakatshidi mushale mu Gilegala, ne bantu bonso bakadi bamulonda bazakala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakindilaku Samuele matuku muanda mutekete bu muakahungeye nʼandi dî; kadi Samuele kakaha ku Gilegala; bantu bakabanga kumumuangalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula wakamba ne, Balue ne milambu ya kuosha ne ya kuvuisha nʼai bantu ditalala kundi. Yeye wakafila milambu ya kuosha ha kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikisheye kufila milambu ya kuosha ha kahia, monai, Samuele wakafika; Shaula wakaya bua kumuakidila bua kumuela muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele wakamba ne, Wewe wakuenza tshinyi? Shaula ne, Bualu bua nakatangila bantu babanga kummuangalala, ne wewe kuakulua mu dituku dituakasungula, ne Bena Peleshete hakamana kudisangisha ku Mikemasha; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku nakamba ne, Bena Peleshete nebalue kunduisha ku Gilegala diambedi tshiyi muanze kukeba diakalengele kudi Yehowa: nunku nakadienzesha nkayanyi ku bukole, nakafila mulambu wa kuosha ha kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele wakambila Shaula ne, Wewe wakenza buhote: wewe kuakanemeka mukenji wa Yehowa, Nzambi webe, wakakuambileye; bu wewe muenze nunku, Yehowa wakadi kujadika bukelenge buebe mu Isalele tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi katataka bukelenge buebe kabuena buikalaku; Yehowa wakamana kudikebela muntu udi mutshima wandi musue, Yehowa wakamana kumusungula mukelenge ku mutu kua bantu bandi bualu bua wewe kuakanemeka mukenji wakabambila Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele wakajuka ku Gilegala, wakaya ku Gibea wa mu buloba bua Benyamina.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula wakabala bantu bakashala nʼandi bakadi bu nkama isambombo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula ne muanʼandi wa balume Yonatana ne bantu hakadibo nʼabo bakashala mu Geba wa mu buloba bua Benyamina; kadi Bena Peleshete bakasa tshitudilu tshiabo mu Mikemasha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahaudi ba bintu bakafuma mu tshitudilu tshia Bena Peleshete ku bisumbu bisatu: tshisumbu tshimue tshiakayila mu nshila wa ku Ofela wa mu buloba bua Shuala, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "tshinga tshisumbu tshiakayila ku nshila wa ku Bete-holona, tshisumbu tshikuabo tshiakayila ku nshila wa ku mukalu wakatangila ku tshibanda tshia Seboyima ku luseke lua tshihela.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamuakadi mufudi wa biamu mu buloba buonso bua Bena Isalele: bualu bua Bena Peleshete bakadi bamba ne, Bena Ebelu kabadifudidi miele ya nvita anyi mafuma: ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi Bena Isalele bonso bakaya kudi Bena Peleshete bua kusakisha bikasu biabo ne miele yabo ne bisui biabo ne nkasu yabo ya kumbula nʼai buloba; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi bakadi ne makangu a kusakisha nʼau nkasu ne bikasu, ne biamu bia kuboya nʼabi bisonsa, ne bisui ne misonsolo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku hakalua dituku dia nvita kakuakadi muele anyi difuma mu bianza bia bantu bakadi ne Shaula ne Yonatana; kadi Shaula ne muanʼandi Yonatana bakadi nʼabi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masalayi a Bena Peleshete hakaya kuala mu nshila mubumbakane wa ku Mikemasha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.23",
            "verseOrgIds": [
              "1SA.13.23"
            ]
          }
        }
      ]
    }
  ],
