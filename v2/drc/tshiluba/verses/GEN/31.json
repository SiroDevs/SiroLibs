  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakunvua mei a bana ba balume ba Labana bamba ne, Yakoba wakakongolola bintu bionso bia tatu wetu wakadiangatshila bubanji buakadi bua tatu wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakatangila mpala wa Labana, kakadi bu muvueye dia mbedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Yakoba ne, Uhingane ku buloba bua batatuʼebe, ne bua bana benu, nengikale nʼebe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakatuma di wakabikila Lakele ne Lea mu budimi buakadi bimuna biandi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakabambila ne, Ndi ntangila ne mpala wa tatuʼenu kena bu muvueye diambedi kadi Nzambi wa tatu wanyi wakadi nʼanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nudi bamanye ne nakukuatshila tatuʼenu mudimu ne bukole buanyi buonso ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatu wenu wakundinga, wakakudimuna difutu dianyi misangu dikumi, kadi Nzambi kakitabusha bua yeye kunkengesha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakambeve ne, Bimuna bionso bia matoba ndifutu diebe, hashishe, bimuna bionso biakalela bana bakadi ne matoba, hakambeye ne, Bimuna bionso bia mihola ndifutu diebe, hashishe, bimuna bionso biakalela bana bakadi ne mihola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Nzambi wakumusha bimuna bia tatu enu, wakubimpa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalua tshikondo tshidi bimuna bimita mafu, nakabandisha mesu anyi mu tshiota, nakatangila ne mbushi ya bimpanga yakadi ne matoba yakaya kudi mashina a mbushi akadi ne mihola mihola ne matoba matoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo wa Nzambi wakungambila mu tshiota tshianyi ne, Yakoba, nakuitaba ne, Ndiku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakungambila ne, Ubanduluke, utangile ne mbushi ya bimpanga yonso idi iya kudi mashina a mbushi idi ne mihola mihola ne matoba matoba bualu bua nakutangila malu onso akukuenzela Labana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi Nzambi wa ku Betele kuwakela manyi ha mutu ha dibue, ne kuwakaditshihila kundi, bika biebe, umuka ku buloba ebu, uhingane ku buloba buakakulelabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakele ne Lea bakamukonka ne, Tuetu tudi ne tshituha tshietu anyi buhianyi buetu mu nsubu wa tatuʼetu, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuetu tudi bu benyi ku mesu kua tatuʼetu nansha? Bualu bua yeye wakatuhana, wakatudila bintu bietu bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bintu bionso biakumusha Nzambi kudi tatuʼetu mbietu ne bia bana betu, nunku wenza malu onso akukuambila Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Yakoba wakabika, wakateka bakashi bandi ne bana bandi ha nyima ha tumelo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakasangisha bimuna biandi bionso ne bintu bionso biakangateye mu Padana-alama bua kuyeye kudi tatuʼandi Isaka mu buloba bua Kanana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaya Labana bua kukoseye mikoko miosa, Lakele wakiba mpingu ya mu nsubu wa tatuʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakanyema mu musokoko, Labana, Muena Alama, kakadi mumanye bualu, yeye kakamuambila ne, Nyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakanyema ne bintu bionso biaka diye nʼabi, wakabika, wakasabuka musulu wa Pelata, wakabisha luendu bua kuya ku mukuna wa Gilada.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku asatu bakambila Labana ne, Yakoba wakunyema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakangata bantu bandi, bakamulonda to luendu lua matuku muanda mutekete, bakamuhetela ku mukuna wa Gilada. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wakamueneka kudi La bana, Muena Alama, mu tshiota butuku, wakamuambila ne, Udimuke, kuambidi Yakoba nansha di dimpe nansha di dibi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaheta Labana Yakoba, wakamusangana mumane kushimika ntenta yandi ku mukuna, Labana ne bantu bandi bakalala ku mukuna wa Gilada. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakebesha Yakoba ne, Bualu ebu buwakungenzela budi tshinyi, wakunyema kundi mu musokoko, wakuya ne bana banyi bakashi bu bahika bakuata mu nvita, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu kai wewe wakunyema mu musokoko kuakungambila, bua meme kukutuma ne disanka ne misambu ne biombelu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuakuitabusha bua meme kusangana mishiku ne bana banyi ba balume ne bana banyi ba bakashi munyi? Wewe wakuenza bualu buhote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme ndi ne bukole bua kukukengesha nʼabu, kadi Nzambi wa tatuʼebe wakungambila butuku bua lelu ne, Udimuke, kuambidi Yakoba nansha dî dimpe nansha di dibi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wakusua kuhingana bualu bua mutshima webe wakadi ujinga ku nsubu wa tatu ebe, kadi wewe wakuiba mpingu yanyi bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila Labana ne, Bualu bua nakatshina, nakelangana meji ne wewe neunyenge bana bebe ba bakashi ku bukole. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biwasangana mpingu yebe mu bianza bia muntu wanyi afue biandi, usungule bintu biebe bionso ku mpala kua bana betu, uye nʼabi Bualu bua Yakoba hakadi mumanye ne, Lakele wakayiba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakabuela mu ntenta wa Yakoba ne mu ntenta wa Lea ne mu ntenta ya bena mudimu babo ba bakashi, kakasangana mpingu. Wakaluhuka mu ntenta wa Lea, wakabuela mu ntenta wa Lakele ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Lakele wakamana kumusha mpingu, wakayiteka muinshi mua biseba bia tumelo, wakashikama ha mutu hai Labana wakakeba ne bianza, kakayisangana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakele wakambila tatuʼandi ne, Mukelenge kanfuidi tshiji, bualu bua meme tshiena mbika ku mpala kuebe, bualu bua ndi mujingakana tshilele tshia bakashi tshidi nʼanyi. Yeye wakakebulula kakasangana mpingu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakadi ne tshiji, wakatanda ne Labana, wakebesha Labana ne, Dihanga bianyi didi hanyi, anyi bubi buanyi budi hanyi bua wakundonda lukasa nunku? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wakasasula bintu bianyi bionso, wakasanganamu tshintu tshiebe tshimue, anyi? Utshiteke ku mpala kua bantu banyi ne kua bantu bebe, bobo balumbulule tshilumbu tshietu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuikala nʼebe to bidimu ebi makumi abidi, mashina a mikoko ne mashina a mbushi kakatula mafu nansha, ne meme tshiakudia mbushi yebe ya bimpanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahandibua kudi nyama mibi tshiakalua nʼau kûdi, meme nkayanyi nakaujimisha wakibabo nansha munya nansha butuku, wewe wakateka difutu edi hamʼbidi hanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakadi ne dikenga nunku, munya wakangosha, mashika akankuata butuku, tshitabala tshiakankuata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakadi mu nsubu webe nunku to bidimu makumi abidi, nakakukuatshila mudimu bidimu dikumi ne binai bua bana bebe ba bakashi babidi, ne bidimu bisambombo bua bimuna biebe, ne wewe wakakudimuna difutu dianyi misangu dikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu Nzambi wa tatuʼanyi, Nzambi wa Abalahama, ne ditshina dia Isaka kabiyi bikale nʼanyi, wewe wakadi kuntuma ne bianza bituhu bulelela Nzambi wakutangila dikenga dianyi ne mudimu wa bianza bianyi, ne yeye wakukubela butuku bua lelu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakambila Yakoba ne, Bana aba bakashi mbana banyi, bana bakalelabo mbana banyi, ne bimuna mbianyi, ne bintu bionso biudi nʼabi mbianyi, ne lelu ndi mua kuenzela bana banyi ba bakashi ne bana bakalelabo tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuye nʼebe, tuhunge tshihungidi, wewe ne meme, tshihungidi etshi tshikale bu kuditshiha kua bualu munkatshi muetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakangata dibue, wakadimanyika bu tshibumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila bantu bandi ne, Sangishai mabue, bobo bakangata mabue, bakunguisha mushiki wa mabue, bakadia bidia kukala kua mushiki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana Wakabikila dina dia muaba au ne, Yegâsahaduta, kadi Yakoba wakaubikila ne, Galede. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakamba ne Mushiki eu udi bu mutshihu wa bualu hankatshi hetu lelu Nunku bakabikila muaba au ne, Galede ne, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misepa, bualu bua yeye wakamba ne, Yehowa atulame meme ne wewe, hatuamuangalaka muntu ne muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biwakengesha bana banyi ba bakashi, anyi biwabaka bakashi bakuabo, kakuena mumanyi mukuabo hankatshi hetu, anu Nzambi udi mumanyi wa bualu buetu, meme ne wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakambila Yakoba ne, Tangila mushiki eu ne dibue edi binakuimanyika hankatshi hetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushiki eu wikale mumanyi wa bualu ne dibue edi dikale mumanyi wa bualu, ne, Meme tshiena nsambuka mushiki eu bua kukuenzela bibi, ne wewe kuena usambuka mushiki eu ne dibue bua kungenzela bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wa Abalahama, Nzambi wa Naho ne Nzambi wa tatu wabo ikale mulumbuluishi hankatshi hetu Yakoba wakaditshiha ku ditshina dia tatu wandi Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakafua mulambu wa kuosha ba kalua ku mukuna, Wakabikila bantu bandi bua kudiabo bidia, bakadia bidia, bakalala ku mukuna butuku abu ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 31:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakabika hatshiatshia, wakatuangana mishiku ne bana bandi ba balume ne bana bandi ba bakashi, wakabavudishila disanka Labana wakahingana ku muaba wandi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.31.55"
            ]
          }
        }
      ]
    }
