  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "GEN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banjelo aba babidi bakafikaku Sodoma dilolo Lota wakadi ushikama ku tshibi tshia ku Sodoma. Lota wakabamona, wakabika bua kubakidila, wakabakukiula hanshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Tangilai, ba kelenge banyi ndi nnusengelela ne Luai kunu, nubuele mu nsubu wa muntu wenu, nulalemu butuku ebu, nuvuwe makasa enu, hashishe, ne nubike dinda dionso, nenuye mu nshila wenu Bobo bakamba ne, Nansha, netuikale mu misesu butuku ebu buonso. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabatendekena bikole, bobo bakaya nʼandi bakabuela mu nsubu wandi, yeye wakabalambishila bintu bia bungi ne bidia bidi kabiyi ne luevene ne bobo bakabidia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi dia mbedi bobo kabayi banze kulala bena musoko wa Sodoma, ne banso ngalume ne bantu banunu ba nseke yonso bakanyunguluka nsubu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.4",
            "verseOrgIds": [
              "GEN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba kabikila Lota, bakamukonka ne Balume aba bakulua kudi butuku ebu badi hanyi? Uluhuke nʼabo, bua tuetu tubamanye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lota waka luhuka kudibo wakinshila tshibi ku nyima kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.6",
            "verseOrgIds": [
              "GEN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Bakuetu, ndi nnusengelela ne kanuenji bualu bubi nunku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.7",
            "verseOrgIds": [
              "GEN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangilai, ndi ne bana bakashi babidi badi kabayi banze kumanya balume, binuitabusha, nendue nʼabo kunudi, nubenzele bu munudi basue, kadi kanuenji balume aba bualu, bualu bua bobo bakulua mu diledi dia nsubu wanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakamba ne, Umuke Bobo bakamba ne, Mulumiana eu, wakahatula bua kushikameye kunoko, ne katataka yeye udi musue kuikala bu mulumbuluishi, nenkuenzele bualu bubi budi butamba bualu butudi tubenzela bobo. Bobo bakamunguila ba bungi, Lota mene mene bakasemena ha buihi bua kuhandabo tshibi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bantu bakolola bianza biabo, bakakoka Lota mu nsubu kudibo, ba-kinshila tshibi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.10",
            "verseOrgIds": [
              "GEN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakafofomesha mesu a balume bakadi bimane ku tshibi tshia nsubu, bakese ne banene, bakateketa, kabakamona tshibi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bakakonka Lota ne, Bantu bakuabo badi nʼebe anyi? Baku ne bana bebe balume ne bana bebe bakashi ne bonso baudi nʼabo mu musoko eu, umuke nʼabo mu muaba eu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.12",
            "verseOrgIds": [
              "GEN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua netubutule musoko eu, bualu bua muadi wabo wakulua munene ku mesu kua Yehowa, ne Yehowa wakatutuma bua kûshiha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lota wakaluhuka, wakambila baku bakadi babangila bana bandi bakashi ne, Jukai, numuke mu musoko eu, bualu bua Yehowa neashihe musoko Kadi yeye wakadi bu muntu udi wakula biakulakula kudi baku bandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshia butuku banjelo bakenzesha Lota ne, Bika biebe, wangate mukashi webe ne bana bebe bakashi babidi badiku diambedi kanuyi banze kufua mu dikenga dia musoko eu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakajanguluka bantu bakamukuata ku tshianza tshiandi, ne tshianza tshia mukashi wandi, ne bianza bia bana bandi bakashi babidi bualu bua Yehowa wakamufuila luse, bobo bakalua nʼandi, bakamuteka ku butshika bua musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakayabo nʼabo ha bule umue wabo wakamba ne Nyema lubilu, bua kuhandisha muoyo webe kutangidi ku nyima kuebe, kushadi ha mpata nyema ku mikuna kufu biebe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lota wakabambila ne, Mukelenge wanyi, kuenji nunku, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "tangila, muntu webe wakamana kusangana luse ku mesu kuebe, ne wewe wakavudisha luse luebe kundi hawakasungila muoyo wanyi, tshiena mua kunyemena ku mikuna, bua bualu bubi nebunkuate, nenfue bianyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangila musoko eu udi ha buihi bua kunyemenamu, udi mukese, witabushe bua mpandilemu (musoko eu udi mukese nansha?) ne mutshima wanyi newikale ne muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuambila ne, Nakuitabusha bualu ebu kabidi, tshiena nshiha musoko eu uwakulombela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyemenamu lubilu, bualu bua tshiena mua kuenza bualu wewe kuyi muanze kufikaku. Nunku bakabikila dina dia musoko au ne, Soâ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diba diakadi dimane kubanda mulu hakabuela Lota mu Soa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe, Yehowa wakamatshisha mu Sodoma ne Amola soufre",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19.24",
              "type": "text"
            },
            {
              "text": "Soufre udi “buanga” bukunzubile, hadibo babuosha, budi buhatula muishi mubi udi ushiha bantu ne bionso bidi ne muoyo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne kalua bia mu diulu kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabutula misoko ai ne mpata yonso, ne bantu bonso ba mu misoko, ne bintu biakadi bidiunda mu buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mukashi wa Lota wakatangila ku nyima kuandi, wakakudimuka dibue dia luehu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalahama wakabika ne dinda dionso, wakaya ku muaba wakimaneye ku mpala kua Yehowa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatangila ku luseke lua Sodoma ne Amola ne Mpata yonso, ne tangilai, muishi wakadi ubanda bu muishi wa tshikutu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakabutula Nzambi misoko ya mu Mpala, yeye wakavuluka Abalahama, wakumusha Lota munkatshi mua dikenga hakabutuleye misoko kuakadi Lota mushikame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lota wakumuka ku Soâ, wakaya kushikama ku mikuna, yeye ne bana bandi bakashi babidi, wakatshina bua kushikama ku Soâ, wakikala biandi ne bana bandi bakashi babidi mu lubuebue. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanʼa bute wakambila muanʼa mukala ne, Tatu wetu udi mununu, ne kakuena mulume mukuabo udi mua kulua kutudi bu mudi tshilele tshia bonso ba ha buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lua, tunuishe tatu wetu nvinyo, netulale nʼandi, bua tuetu tulelele tatu wetu bana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakanuisha tatu wabo nvinyo butuku abu, ne muaba bute wakabuela, wakalala ne tatu wandi, tatu wandi kakamanya hakalaleye ne hakabikeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu muanʼa bute wakambila muanʼa mukala ne, Butuku bua lelu nakulala ne tatu wanyi, tumunuishe nvinyo butuku ebu kabidi, wewe ubuele, ulale bandi, bua tuetu tulelele tatu wetu bana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakanuisha tatu wabo nvinyo butuku abu kabidi, ne muanʼa mukala wakabika, wakalala nʼandi, ne tatu wandi kakamanya hakalaleye ne hakabikeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bana bakashi ba Lota babidi bakimita mafu kudi tatu wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanʼa bute wakalela muana mulume, wakamulelela dina ne, Moaba, yeye wakadi nkambua wa Bena Moaba to ne lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanʼa mukala wakalela muana mulume kabidi, wakamuidika dina ne, Beneami, yeye wakadi nkambua wa Bena Amona tô ne lelu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
