  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "GEN 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakaya ku luendu luandi wakateka ku buloba bua bantu ba ku esete. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakabandisha mesu andi, wakamona dina dia mai mu budimi ne bisumbu bia mikoko bisatu biakadi bilalaku, bualu bua bakadi banuishaku mikoko, ne dibue dinene diakadi ku mushiku wa dina dia mai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.2",
            "verseOrgIds": [
              "GEN.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakadi basangisha bisumbu bia mikoko bionso kunoko, bakumusha dibue diakadi ku mushiku wa dina, bakanuisha mikoko mai, bakahingasha dibue dia ku mushiku wa ku muaba wadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakabebesha ne Bakuetu, nuakufuma kudi kunyi? Bakamukudimuna di ne, Tudi ba ku Halana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabebesha kabidi ne, Nudi bamanye Labana, muana wa Naho, anyi? Bakamukudimuna ne, Tudi bamumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabebesha ne, Yeye udi ne bukole, anyi? Bobo bakamuitaba ne, E, yeye udi ne bukole, ne tangila, muanʼandi wa bakashi, Lakele, ulualua ne mikoko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne Monai, diba ditshidi mulu, kandiba dia kusangisha bimuna nansha, nuishai mikoko mai, yai bienu nuyidishe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamukudi muna di ne, Nansha, katuena bamanye mua kuenza nunku, anu hatuasangisha mikoko yonso ne humushabo dibue ku mushiku wa dina, hashishe netunuishe mikoko mai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadiye uyikila nʼabo, Lakele wakalua ne mikoko ya tatu andi, bualu bua yeye wakadi muyilame. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Yakoba Lakele, muana wa Labana, muanʼabo wa balume ne mamu andi, ne mikoko ya Labana muanʼabo wa balume ne mamu andi, Yakoba wakasemena ha buihi, wakumusha dibue diakadi ku mushiku wa dina, wakanuisha mikoko ya Labana, muan abo wa balume ne mamuʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakatuangana ne Lakele mishiku wakabandisha di diandi, wakadia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila Lakele ne, Ndi muan abo ne tatu ebe, ndi muana wa Lebeka, Lakele wakaya lubilu, wakamanyisha tatu andi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Labana lumu lua Yakoba muana wa muan abo mukashi, yeye wakaya lubilu bua kumuakidila, wakamuhukila, wakatuangana nʼandi mishiku, wakalua nʼandi ku nsubu wandi Yeye wakambila Labana malu onso ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakamuambila ne Bulelela, wewe udi mufuba wanyi ne musunyi wanyi Yeye wakashala nʼandi to ngondo mujima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakambila Yakoba ne, Bualu bua wewe udi muanʼetu wa balume, bidi bimpe wewe unkuatshile mudimu tshianana, anyi? Ungambile, difutu diebe nedikale tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakadi ne bana bakashi babidi dina dia muan a bute diakadi Lea, ne dina dia mukunyʼandi diakadi Lakele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea wakadi ne mesu a bulengu, kadi Lakele wakadi muimpe mubidi ne mpala wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakananga Lakele, yeye wakambila Labana ne, Nenkukuatshile mudimu bidimu muanda mutekete bualu bua muanʼebe muana wa bakashi muanʼa mukala ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakamuambila ne, Bualu bua meme kumufila kudi budi butamba bua meme kumufila kudi mulume mukuabo ushale nʼanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakamukuatshila mudimu to bidimu muanda mutekete bualu bua Lakele, ne bidimu ebi biakadi bu anu matuku makese bualu bua dinanga diakamunangeye nʼadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakambila Labana ne, Umpe mukashi wanyi, bualu bua matuku anyi akukumbana bua meme kuikala nʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakasangisha bantu bonso bakadiye nʼabo, wakabalambishila bidia bia dibanji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakila butuku yeye wakangata Lea, muanʼandi wa bakashi, wakamufila kudiye, ne yeye wakabuela nʼandi mu nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakafua Zilepa, muena mudimu wandi wa bakashi, kudi Lea muanʼandi wa bakashi bu muena mudimu wandi wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshia butuku Yakoba wakamona ne Lea wakambila Labana ne, Bualu ebu buwakungenzela budi munyi? Tshiakukukuatshila mudimu bualu bua Lakele, anyi? Wakundinga nunku bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakamuambila ne, Kabena benza nunku mu buloba buetu, katuena tufila muanʼa mukala ku dibaka diambedi mukuluʼandi kayi muanze kuya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushikishe lumingu lua muana eu, hashishe, netukuhe muana mukuabo kabidi biwankuatshila mudimu bidimu muanda mutekete bikuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba Wakenza nunku, wakashikisha lumingu luandi, ne yeye wakamuha Lakele bu mukashi wandi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labana wakafua Bileha, muena mudimu wandi wa bakashi, kudi Lakele bu muena mudimu wandi wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakaya kudi Lakele kabidi, wakatamba kunanga Lakele ku mpala kua Lea, yeye wakakuatshila Labana mudimu bidimu muanda mutekete bakuabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Yehowa ne Lea wakadi mubengibue, yeye wakamulelesha bana, kadi Lakele wakadi nkumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
