    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafarizeo mpe Basaduseo bayaki epai na Yesu mpo na kotiela Ye motambo ; basengaki na Ye ete alakisa bango elembo moko kowuta na Likolo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Na pokwa, bolobaka : « Mokolo ya lobi ekozala mokolo malamu, pamba te likolo ezali motane ! »",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe na tongo, bolobaka : « Mvula makasi ekobeta lelo, pamba te mapata eyindi. » Solo, boyebi kososola bilembo oyo elakisaka soki mvula ekobeta to ekobeta te, kasi bozangi makoki ya kososola bilembo ya tango !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oh bato ya ekeke oyo ! Bazali bato mabe mpe bazangi botosi na miso ya Nzambe, kasi bazali mpe kosenga elembo ! Bakopesamela elembo mosusu te longola kaka elembo ya Yona.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 16:4"
      },
      "items": [
        {
          "text": "Bongo atikaki bango wana mpe akendeki.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.14-MRK.8.21"
          },
          "items": [
            {
              "text": "Mlk 8.14-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayekoli bakatisaki na ngambo mosusu ya ebale, babosanaki komema mapa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bosala keba na levire ya Bafarizeo mpe ya Basaduseo !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayekoli bakomaki kokanisa mpe komituna bango na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:7"
      },
      "items": [
        {
          "text": "— Azali koloba bongo mpo ete tomemi mapa te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu asosolaki makanisi na bango ; alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bato ya kondima moke ! Bozali kolobana bino na bino mpo ete bozali na mapa te ! Mpo na nini ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boni, bozwi kaka bososoli nanu te ? Bobosani penza mapa mitano oyo bokabolelaki bato nkoto mitano, mpe motango ya bitunga oyo bozongaki na yango sima na kokabolela bato ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bobosani lisusu mapa sambo oyo bokabolelaki bato nkoto minei, mpe motango ya bitunga oyo bozongaki na yango sima na kokabolela bato ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndenge nini bozali kososola te ete nazalaki koloba na tina na mapa te, tango nalobaki na bino : bosala keba na levire ya Bafarizeo mpe ya Basaduseo ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bayekoli basosolaki ete alobaki na bango te ete basala keba na levire ya mapa, kasi nde basala keba na mateya ya Bafarizeo mpe ya Basaduseo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petelo andimi ete Yesu azali Mwana na Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.27-MRK.8.30"
          },
          "items": [
            {
              "text": "Mlk 8.27-30",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.18-LUK.9.21"
          },
          "items": [
            {
              "text": "Lk 9.18-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.6.66-JHN.6.71"
          },
          "items": [
            {
              "text": "Yn 6.66-71",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu akomaki na etuka ya Sezarea ya Filipo, atunaki bayekoli na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bato balobaka ete Mwana na Moto azali nani ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:14"
      },
      "items": [
        {
          "text": "— Bamoko balobaka ete ozali Yoane Mobatisi ; bamosusu, Eliya ; mpe bamosusu lisusu, Jeremi to moko kati na basakoli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atunaki bango lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bongo bino, bolobaka ete Ngai nazali nani ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simona Petelo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:16"
      },
      "items": [
        {
          "text": "— Ozali Masiya, Mwana na Nzambe na bomoi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Esengo na yo Simona, mwana mobali ya Yona ! Pamba te ezali moto te nde ayebisi yo makambo oyo, kasi Tata na Ngai, oyo azali kati na Likolo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe Ngai, nazali koloba na yo : Ozali Libanga, mpe ezali na likolo ya libanga oyo nde Ngai nakotonga Lingomba na Ngai ; bongo bikuke ya mboka ya bakufi ekotikala kolonga yango te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nakopesa yo bafungola ya Bokonzi ya Likolo ; nyonso oyo okokanga awa na mokili ekokangama mpe na Likolo, mpe nyonso oyo okofungola awa na mokili ekofungwama mpe na Likolo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yesu apekisaki makasi bayekoli na Ye koloba na moto ete Ye azali Masiya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu asakoli kufa mpe lisekwa na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.31-MRK.9.1"
          },
          "items": [
            {
              "text": "Mlk 8.31–9.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.22-LUK.9.27"
          },
          "items": [
            {
              "text": "Lk 9.22-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na tango wana, Yesu akomaki koloba polele na bayekoli na Ye ete asengeli kokende na Yelusalemi, asengeli komona pasi mingi na maboko ya bakambi ya bato, bakonzi ya Banganga-Nzambe mpe balakisi ya Mobeko ; basengeli koboma Ye, mpe asengeli kosekwa na mokolo ya misato.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo abendaki Yesu na pembeni mpe akomaki kopamela Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:22"
      },
      "items": [
        {
          "text": "— Nkolo, tika ete Nzambe abatela Yo mosika ya makambo wana ! Ekokomela Yo te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yesu abalukaki, alobaki na Petelo :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mosika na Ngai, Satana ! Ozali epekiselo mpo na Ngai ! Makanisi na yo ezali makanisi ya Nzambe te, ezali penza makanisi ya bato.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndenge nini kolanda Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.34-MRK.9.1"
          },
          "items": [
            {
              "text": "Mlk 8.34–9.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.23-LUK.9.27"
          },
          "items": [
            {
              "text": "Lk 9.23-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yesu alobaki na bayekoli na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 16:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Moto nyonso oyo alingi kolanda Ngai asengeli komiboya ye moko, kokamata ekulusu na ye mpe kolanda Ngai.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te moto nyonso oyo akolinga kobikisa bomoi na ye akobungisa yango, kasi moto nyonso oyo akobungisa bomoi na ye mpo na Ngai akozwa yango lisusu.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Litomba nini ekozala mpo na moto, soki azwi mokili mobimba, kasi abungisi bomoi na ye ? Moto akoki penza kopesa nini mpo na kosikola bomoi na ye ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te Mwana na Moto akoya elongo na ba-anjelu na Ye kati na nkembo ya Tata na Ye mpe akofuta moto nyonso kolanda misala na ye.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : kati na bato oyo bazali awa, ezali na ba-oyo bakokufa te kino bakomona Mwana na Moto koya kati na nkembo ya bokonzi na Ye.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
