  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mateya na tina na makabo epai na babola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosala keba ete bosalelaka te bosembo na bino liboso ya bato, mpo ete bamona bino ; soki te, bokozanga lifuti oyo Tata na bino ya Likolo abombela bino.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.1",
                "verseOrgIds": [
                  "MAT.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango ozali kokabela babola, kobetela yango tangwa te ndenge bato ya bilongi mibale basalaka kati na bandako ya mayangani mpe na babalabala mpo ete bato bakumisa bango. Nazali koloba na bino penza ya solo : basili kozwa lifuti na bango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.2",
                "verseOrgIds": [
                  "MAT.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi tango yo ozali kokabela babola, sala yango na ndenge ete loboko na yo ya mwasi eyeba ete likambo oyo loboko na yo ya mobali ezali kosala,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.3",
                "verseOrgIds": [
                  "MAT.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo ete likabo na yo ya mawa etikala sekele ; bongo Tata na yo, oyo amonaka makambo oyo esalemaka na nkuku, akopesa yo lifuti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.4",
                "verseOrgIds": [
                  "MAT.6.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mateya na tina na libondeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango bozali kosambela, bosalaka te lokola bato ya bilongi mibale oyo balingaka kosambela ya kotelema kati na bandako ya mayangani mpe na bisika oyo babalabala ekutana, mpo ete bato bamona bango. Nazali koloba na bino penza ya solo : basili kozwa lifuti na bango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.5",
                "verseOrgIds": [
                  "MAT.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi yo, soki olingi kosambela, kota na shambre na yo, kanga ekuke mpe sambela Tata na yo, oyo azali kati na esika wana ya sekele ; bongo Ye, Tata na yo, oyo amonaka makambo oyo esalemaka na nkuku, akopesa yo lifuti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.6",
                "verseOrgIds": [
                  "MAT.6.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango bozali kosambela, bozongelaka-zongelaka te maloba ndenge bapagano basalaka ; pamba te bakanisaka ete Nzambe akoyanola bango soki balobi mingi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.7",
                "verseOrgIds": [
                  "MAT.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosalaka lokola bango te, pamba te Tata na bino ayebi posa na bino liboso ete botalisa Ye yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.8",
                "verseOrgIds": [
                  "MAT.6.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.11.2-LUK.11.4"
          },
          "items": [
            {
              "text": "Lk 11.2-4",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tala ndenge nini bosengeli kosambela :",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "‹ Tata na biso,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yo oyo ozali kati na Likolo ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tika ete Kombo na Yo ebulisama,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tika ete Bokonzi na Yo eya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tika ete mokano na Yo esalema,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "awa na mokili ndenge esalemaka kuna na Likolo !",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pesa biso, na mokolo ya lelo,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bilei na biso ya mokolo na mokolo ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "limbisa mabe na biso,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndenge biso mpe tolimbisi bato oyo basalaki biso mabe ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "komema biso na komekama te,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi kangola biso longwa na misala ya Satana ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pamba te bokonzi, nguya mpe nkembo",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ezali ya Yo seko na seko.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        },
        {
          "text": "›",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te soki bolimbisi baninga, na mabe oyo basali bino, Tata na bino ya Likolo mpe akolimbisa bino ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.14",
                "verseOrgIds": [
                  "MAT.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi soki bolimbisi te, Tata na bino mpe akolimbisa te mabe na bino.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.15",
                "verseOrgIds": [
                  "MAT.6.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mateya na tina na kokila bilei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango bozali kokila bilei, bozalaka mawa-mawa te ndenge bato ya bilongi mibale basalaka ; pamba te bakomisaka bilongi na bango mawa-mawa mpo na kolakisa na bato ete bazali kokila bilei. Nazali koloba na bino penza ya solo : basili kozwa lifuti na bango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.16",
                "verseOrgIds": [
                  "MAT.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi tango yo ozali kokila bilei, sukola elongi na yo malamu mpe pakola moto na yo malasi,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo ete moto moko te ayeba ete ozali kokila bilei, longola kaka Tata na yo, oyo amonanaka te ; bongo Ye, Tata na yo, oyo amonaka makambo oyo esalemaka na nkuku akopesa yo lifuti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
