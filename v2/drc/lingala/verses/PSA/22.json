        "style": "c",
        "sid": "PSA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Mpo na nini osundoli ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi, ya koyemba lokola nzembo na kombo « Mboloko ya tongo. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe na ngai, Nzambe na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "mpo na nini osundoli ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "Mpo na nini otelemi mosika ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "Mpo na nini ozali kobikisa ngai te ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "Mpo na nini ozali koyoka te koganga na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe na ngai, na moyi, nabeleli Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "kasi oyanoli ngai te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "na butu, nabeleli lisusu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "mpe natikali kovanda nye te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, ozali Mosantu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "ovandaka na Kiti na Yo ya Bokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "kati na masanzoli ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batata na biso batiaki elikya na bango kati na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "bamipesaki epai na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "mpe okangolaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagangaki epai na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "mpe Yo okangolaki bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "batiaki elikya na bango kati na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "mpe bayokisamaki soni te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali lisusu moto te, kasi mutsopi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:7"
      },
      "items": [
        {
          "text": "bato nyonso bazali kofinga mpe kotiola ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso oyo bazali komona ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "bazali koseka ngai, bazali kokamwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "koningisa mito mpe koloba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Atiaka motema na ye epai na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "tika ete Yawe abikisa ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "Tika ete Yawe akangola ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "pamba te asepelaka na Ye ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, Yawe, obimisaki ngai na libumu ya mama na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:10"
      },
      "items": [
        {
          "text": "obatelaki ngai na kimia na tolo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta mbotama na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "batikaki ngai na maboko na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "wuta libumu ya mama na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "ozali Nzambe na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kozala mosika na ngai te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "pamba te pasi ekomi pene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "mpe nazangi moto oyo akosunga ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguna na ngai bazingeli ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "text": "lokola lisanga ya bangombe ya mibali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "text": "bazingeli ngai lokola banyama mabe",
