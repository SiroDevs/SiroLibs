  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "PSA 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Boboto ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi, mowumbu ya Yawe. Wuta na buku ya mokambi ya bayembi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na motema na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "nazali na sango kowuta na Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "na tina na bato mabe oyo batondi na masumu :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "Kotosa Nzambe ezali na tina ata moke te na miso na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamipesaka lokumu makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:3"
      },
      "items": [
        {
          "text": "bandimaka te mpe bayinaka masumu na bango te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minoko na bango ebimisaka maloba mabe mpe lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "baboyaka kosala na bokebi mpe kosala bolamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala na bambeto na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "basalaka kaka mabongisi ya kosala mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "batambolaka te mpo na kosala bolamu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "mpe baboyaka mabe te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, bolingo na Yo ekenda kino na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "boyengebene na Yo kino na mapata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosembo na Yo ezali lokola bangomba ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "mikano na Yo ezali mozindo lokola lubwaku ya molayi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "Yawe, obikisaka bato mpe banyama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, tala ndenge nini bolingo na Yo ezali motuya !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:8"
      },
      "items": [
        {
          "text": "Bato bazwaka ebombamelo na elili ya mapapu na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baliaka mpe batondaka bilei ya Ndako na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:9"
      },
      "items": [
        {
          "text": "mpe omelisaka bango mayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:9"
      },
      "items": [
        {
          "text": "kowuta na bolingo monene na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te etima ya bomoi ezali elongo na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:10"
      },
      "items": [
        {
          "text": "kati na pole na Yo nde tomonaka pole.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koba kotalisa bolingo na Yo epai ya bato oyo bayebi Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:11"
      },
      "items": [
        {
          "text": "mpe bosembo na Yo epai ya bato ya mitema alima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato ya lolendo bakoma te kino epai na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:12"
      },
      "items": [
        {
          "text": "mpe tika ete bato mabe babengana ngai te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge nini bato ya misala mabe bakweyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.13",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:13"
      },
      "items": [
        {
          "text": "balali na mabele, bazangi makoki ya kotelema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.13",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    }
  ],
