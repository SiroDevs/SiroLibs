      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:11"
      },
      "items": [
        {
          "text": "bakomikumisa mpo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.11",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
