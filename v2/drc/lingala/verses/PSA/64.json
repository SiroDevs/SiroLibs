      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 64:11"
      },
      "items": [
        {
          "text": "bato nyonso oyo bazali na mitema alima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.11",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
