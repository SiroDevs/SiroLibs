          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya sembo akosepela",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.11",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
