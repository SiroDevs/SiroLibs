      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 121",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe, Mosungi mpe Mobateli na ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 121:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya mobembo tango bazalaki kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 121:1"
      },
      "items": [
        {
          "text": "Natomboli miso na ngai na ngambo ya bangomba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:1"
      },
      "items": [
        {
          "text": "lisungi na ngai ekowuta wapi ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 121:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisungi na ngai ewutaka na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:2"
      },
      "items": [
        {
          "text": "oyo akela likolo mpe mabele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 121:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akotika te ete lokolo na yo eselumuka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:3"
      },
      "items": [
        {
          "text": "Ye oyo abatelaka yo animbaka te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 121:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te, Ye oyo abatelaka Isalaele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:4"
      },
      "items": [
        {
          "text": "animbaka te mpe alalaka pongi te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 121:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali mobateli na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:5"
      },
      "items": [
        {
          "text": "Yawe azali, na ngambo ya loboko na yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:5"
      },
      "items": [
        {
          "text": "lokola elili oyo ebatelaka yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 121:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala na moyi to na butu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:6"
      },
      "items": [
        {
          "text": "moyi mpe sanza ekosala yo mabe ata moke te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 121:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akobatela yo na mabe nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:7"
      },
      "items": [
        {
          "text": "akobatela bomoi na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 121:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akobatela kokende",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:8"
      },
      "items": [
        {
          "text": "mpe kozonga na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:8"
      },
      "items": [
        {
          "text": "sik'oyo mpe libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
    }
  ],
