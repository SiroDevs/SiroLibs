  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "PSA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe, Mosungi na ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi ; ezali ya koyemba na lindanda ya basinga mwambe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, kopesa ngai etumbu te na kanda na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:2"
      },
      "items": [
        {
          "text": "kopesa ngai etumbu te na kanda makasi na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, yokela ngai mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "pamba te nazangi makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "Yawe, bikisa ngai na bokono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "pamba te mikuwa na ngai elembi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo na ngai ezali kotungisama makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:4"
      },
      "items": [
        {
          "text": "bongo Yo, Yawe, kino tango nini ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, zongela ngai, mpe kokangola ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:5"
      },
      "items": [
        {
          "text": "bikisa ngai, mpo na bolingo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te bakufi bakoki lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "kotatola Kombo na Yo te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "Mpe kati na mboka ya bakufi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "nani akoki kokumisa Yo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolela elembisi ngai nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 6:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:7"
      },
      "items": [
        {
          "text": "Butu nyonso, nalelaka na mbeto na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:7"
      },
      "items": [
        {
          "text": "mpe napolisaka na mpinzoli, esika oyo nalalaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miso na ngai ebebi mpo na mawa ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:8"
      },
      "items": [
        {
          "text": "ezali lisusu komona malamu te likolo ya banyokoli na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino nyonso oyo bosalaka mabe, bolongwa liboso na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:9"
      },
      "items": [
        {
          "text": "pamba te Yawe ayoki kolela na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.9",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe ayanoli mabondeli na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:10"
      },
      "items": [
        {
          "text": "mpe ayambi losambo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banguna na ngai nyonso bakoyoka soni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.11",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:11"
      },
      "items": [
        {
          "text": "mpe somo monene ekokanga bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.11",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:11"
      },
      "items": [
        {
          "text": "bakozonga na sima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.11",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:11"
      },
      "items": [
        {
          "text": "mpe bakoyoka mbala moko soni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.11",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
    }
  ],
