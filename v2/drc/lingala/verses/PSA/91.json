    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Ebombamelo ya malonga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 91:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo awumelaka kati na ebombamelo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "ya Ye-Oyo-Aleki-Likolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "avandaka na se ya bobatelami",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "ya Nkolo-Na-Nguya-Nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 91:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaka na tina na Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "« Nzambe na ngai azali ebombamelo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "mpe ndako makasi na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "natiaka elikya na ngai kati na Ye ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 91:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye nde akangolaka yo wuta na mitambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "ya mokangi bandeke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "mpe na bokono oyo ebikisaka te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 91:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abombaka yo na se ya mapapu na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "mpe ozwaka ebombamelo ya malonga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "na se ya mapapu na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "bolingo na Ye ebatelaka lokola nguba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "mpe lokola elamba ya ebende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 91:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobanga te somo ya butu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:5"
      },
      "items": [
        {
          "text": "makonga oyo epumbwaka na moyi makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 91:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bokono oyo etambolaka kati na molili",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "mpe pasi oyo ebebisaka na midi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 91:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala bato nkoto moko bakweyi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "pembeni na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "mpe bato nkoto zomi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "na ngambo ya loboko na yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "ekozwa yo ata moke te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 91:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotala kaka na miso na yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "mpe okomona ndenge nini bato mabe bazali",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "kozwa etumbu lokola lifuti na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 91:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki otatoli :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "« Yawe azali ebombamelo na ngai, »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "mpe okomisi Ye-Oyo-Aleki-Likolo ekimelo na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 91:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mabe ata moko te ekokweyela yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:10"
      },
      "items": [
        {
          "text": "pasi ata moko te ekopusana na ndako na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 91:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te akopesa mitindo na ba-anjelu na Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:11"
      },
      "items": [
        {
          "text": "ete babatela yo malamu na banzela na yo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 91:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakomema yo na maboko na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:12"
      },
      "items": [
        {
          "text": "mpo ete lokolo na yo etutana na libanga te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 91:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "okotambola na likolo ya nkosi mpe ya etupa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:13"
      },
      "items": [
        {
          "text": "okonyata nkosi ya monene mpe dalagona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
