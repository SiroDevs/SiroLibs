      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Bileli mpo na kobebisama ya Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 74:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Azafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "Oh Nzambe, mpo na nini kosundola biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "mpo na tango nyonso ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "Mpo na nini kongalisa kanda na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "likolo ya etonga oyo oleisaka ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 74:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanisa lisusu lisanga ya bato na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "oyo osikola wuta kala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "libota oyo okomisa libula na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "Kanisa ngomba Siona epai wapi ovandaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 74:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete matambe na Yo ekoma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "kino na bisika oyo ebebi nye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "Kati na Esika na Yo ya bule,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "monguna abebisi nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 74:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayini na Yo bagangi lokola nkosi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "ata kati na esika oyo okutanaka na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "batelemisi bendele na bango lokola elembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 74:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali lokola bato oyo basimbi bipasola",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:5"
      },
      "items": [
        {
          "text": "mpe bazali kokata banzete kati na zamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 74:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuki-buki bililingi nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "oyo batobola na mabaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "na nzela ya bipasola mpe bamarto na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 74:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "batumbi Esika na Yo ya bule,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "bakweyisi mpe bakomisi mbindo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "esika oyo Kombo na Yo evandaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 74:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalaki komilobela :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "« Tokopanza yango nyonso ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "Kati na mokili, bazikisi esika nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "epai wapi bagumbamelaka Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 74:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tozali lisusu komona te bilembo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "basakoli bazali lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "mpe moko te kati na biso ayebi tango boni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "makambo oyo ekowumela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 74:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, kino tango nini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "monguna akofinga Yo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "Boni, akokoba tango nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "kotiola Kombo na Yo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 74:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini ozongisi loboko na Yo na sima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "loboko na Yo ya mobali ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "Mpo na nini okangi maboko na Yo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 74:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Yo Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "ozali Mokonzi na ngai wuta kala ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "Yo nde omemaka lobiko kati na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
