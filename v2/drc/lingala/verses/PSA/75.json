      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "kasi ezali ngai nde nalendisaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.4"
