      "attrs": {
        "style": "q2",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "bato bazali kotatola bikamwa na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
