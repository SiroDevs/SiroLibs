  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "PSA 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Lobiko ya Nzambe epai ya mosali na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Wuta na buku ya mokambi ya bayembi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natiaki elikya na ngai kati na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "abalukaki epai na ngai mpe ayokaki koganga na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimisaki ngai na libulu ya mozindo, kati na potopoto ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "atelemisaki ngai na likolo ya libanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "mpe alendisaki makolo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaka nzembo ya sika kati na monoko na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "nzembo ya masanzoli mpo na Nzambe na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "Bato ebele bakomona, bakobanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "mpe bakotiela Yawe motema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na moto oyo atiaka elikya kati na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "kasi atalelaka te bato ya lolendo mpe bakosi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe na ngai, bikamwa mpe mabongisi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "oyo osalaka mpo na biso ezali ebele penza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "Moko te akokani na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "nalingi kotatola mpe kopanza sango na yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "kasi motango na yango eleki ebele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osepelaki te na bambeka mpe na makabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "kasi ofungolaki matoyi na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "osengaki te makabo ya kotumba mpe bambeka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "mpo masumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo nalobaki : « Ngai oyo, nayei epai na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:8"
      },
      "items": [
        {
          "text": "kolanda ndenge ekomami na tina na ngai kati na buku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe na ngai, nasepelaka kosala mokano na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "Mobeko na Yo ezali kati na motema na ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasakolaka bosembo na Yo kati na mayangani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "nakokanga monoko na ngai te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "Yawe, oyebi yango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabombaka bosembo na Yo te kati na motema na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:11"
      },
      "items": [
        {
          "text": "natatolaka boyengebene mpe lobiko na Yo kati na mayangani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:11"
      },
      "items": [
        {
          "text": "nakobomba yango ata moke te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, kopimela ngai mawa na Yo te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "kasi sala ete bolingo mpe bosolo na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "ebatelaka ngai tango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te makambo ebele ya pasi ezingeli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:13"
      },
      "items": [
        {
          "text": "mabunga na ngai ekomi konyokola ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:13"
      },
      "items": [
        {
          "text": "mpe nazali kokoka lisusu te kotala yango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:13"
      },
      "items": [
        {
          "text": "ezali ebele koleka suki ya moto na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:13"
      },
      "items": [
        {
          "text": "mpe motema na ngai elembi kati na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.13",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
