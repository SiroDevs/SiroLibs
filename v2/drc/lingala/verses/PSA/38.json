    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Losambo ya mobeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi mpo na kokanisa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, kopamela ngai te kati na kanda na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:2"
      },
      "items": [
        {
          "text": "to kopesa ngai etumbu te kati na kanda makasi na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.2",
            "verseOrgIds": [
              "PSA.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te makonga na Yo etoboli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:3"
      },
      "items": [
        {
          "text": "mpe loboko na Yo ebeti ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.3",
            "verseOrgIds": [
              "PSA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na kanda na Yo, nzoto na ngai ebeli ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:4"
      },
      "items": [
        {
          "text": "mpo na masumu na ngai, mikuwa na ngai elembi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.4",
            "verseOrgIds": [
              "PSA.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabe na ngai eleki moto na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:5"
      },
      "items": [
        {
          "text": "ezali kilo makasi epai na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:5"
      },
      "items": [
        {
          "text": "lokola mokumba ya kilo makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.5",
            "verseOrgIds": [
              "PSA.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapota na ngai epoli mpe ekomi kolumba solo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:6"
      },
      "items": [
        {
          "text": "mpo na bozoba na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.6",
            "verseOrgIds": [
              "PSA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagumbami, nalembi makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:7"
      },
      "items": [
        {
          "text": "nakomi moto ya mawa mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.7",
            "verseOrgIds": [
              "PSA.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te nazali koyoka pasi makasi na mokongo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:8"
      },
      "items": [
        {
          "text": "eteni ata moko te ya nzoto na ngai ezali malamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.8",
            "verseOrgIds": [
              "PSA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalembi, makasi na ngai nyonso esili ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:9"
      },
      "items": [
        {
          "text": "mobulu ekoti na motema na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:9"
      },
      "items": [
        {
          "text": "nakomi koganga na kolemba te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.9",
            "verseOrgIds": [
              "PSA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo, oyebi posa na ngai nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:10"
      },
      "items": [
        {
          "text": "kolela na ngai ezali ya kobombama te na miso na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.10",
            "verseOrgIds": [
              "PSA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema na ngai ezangi kimia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:11"
      },
      "items": [
        {
          "text": "makasi na ngai ekomi kosila,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:11"
      },
      "items": [
        {
          "text": "nabungisi ata pole ya miso na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.11",
            "verseOrgIds": [
              "PSA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo balingaka ngai mpe baninga na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "bakimi pasi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:12"
      },
      "items": [
        {
          "text": "ba-oyo bazalaka na ngai esika moko batelemi mosika na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.12",
            "verseOrgIds": [
              "PSA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo balukaka kufa na ngai bazali kotia mitambo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:13"
      },
      "items": [
        {
          "text": "ba-oyo balukaka pasi na ngai bazali koloba mpo na kosala ngai mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:13"
      },
      "items": [
        {
          "text": "bakomi mikolo nyonso kobongisa lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.13",
            "verseOrgIds": [
              "PSA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ngai nazali kosala lokola mokufi matoyi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:14"
      },
      "items": [
        {
          "text": "mpe lokola baba, nakangi monoko, naboyi koloba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.14",
            "verseOrgIds": [
              "PSA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakomi lokola mokufi matoyi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:15"
      },
      "items": [
        {
          "text": "oyo akoki kopesa eyano ata moko te na monoko na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.15",
            "verseOrgIds": [
              "PSA.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, natiaka elikya na ngai kati na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:16"
      },
      "items": [
        {
          "text": "oh Nkolo, Nzambe na ngai, solo, okoyanola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.16",
            "verseOrgIds": [
              "PSA.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki : « Kopesa nzela te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 38:17"
      },
      "items": [
        {
          "text": "ete basepela na tina na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.38.17",
            "verseOrgIds": [
              "PSA.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
