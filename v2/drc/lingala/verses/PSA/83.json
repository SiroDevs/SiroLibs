        {
          "text": "oyo bazalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:13"
      },
      "items": [
        {
          "text": "« Tobotola mabele ya Nzambe ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.13",
            "verseOrgIds": [
              "PSA.83.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 83:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe na ngai, balola bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:14"
      },
      "items": [
        {
          "text": "lokola matiti oyo mopepe ezali kopumbwisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.14",
            "verseOrgIds": [
              "PSA.83.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 83:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge moto ezikisaka zamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:15"
      },
      "items": [
        {
          "text": "ndenge moto makasi ezikisaka bangomba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.15",
            "verseOrgIds": [
              "PSA.83.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 83:16"
          },
          "items": [
