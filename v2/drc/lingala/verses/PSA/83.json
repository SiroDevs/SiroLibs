          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:16"
      },
      "items": [
        {
          "text": "mpe bangisa bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.16",
            "verseOrgIds": [
              "PSA.83.16"
            ]
          }
        }
      ]
    },
