          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Azafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 83:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, kovanda nye te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "Nzambe, kokanga monoko na Yo te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:2"
      },
      "items": [
        {
          "text": "kotikala kimia te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.2",
            "verseOrgIds": [
              "PSA.83.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 83:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge banguna na Yo bazali kotomboka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "tala ndenge bayini na Yo bazali kotombola",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:3"
      },
      "items": [
        {
          "text": "mito na bango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.3",
            "verseOrgIds": [
              "PSA.83.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 83:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali kosalela bato na Yo likita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:4"
      },
      "items": [
        {
          "text": "kokanela bato oyo obatelaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.4",
            "verseOrgIds": [
              "PSA.83.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 83:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali koloba : « Boya, toboma bango nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "mpo ete ekolo na bango ezala lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:5"
      },
      "items": [
        {
          "text": "mpo ete batanga lisusu kombo ya Isalaele te. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.5",
            "verseOrgIds": [
              "PSA.83.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 83:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basangani mpe bayokani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:6"
      },
      "items": [
        {
          "text": "basali boyokani mpo na kotelemela Yo :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.6",
            "verseOrgIds": [
              "PSA.83.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 83:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bato ya Edomi mpe bato ya Isimaeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:7"
      },
      "items": [
        {
          "text": "bato ya Moabi mpe bato ya Agari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.7",
            "verseOrgIds": [
              "PSA.83.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 83:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gebali, Amoni mpe Amaleki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:8"
      },
      "items": [
        {
          "text": "bato ya Filisitia elongo na bato ya Tiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.8",
            "verseOrgIds": [
              "PSA.83.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 83:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Asiri mpe basangani elongo na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:9"
      },
      "items": [
        {
          "text": "mpo na kobakisa bakitani ya Loti makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.9",
            "verseOrgIds": [
              "PSA.83.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 83:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala bango ndenge osalaki Madiani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "ndenge osalaki Sisera mpe Yabini,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:10"
      },
      "items": [
        {
          "text": "kuna na mayi ya Kishoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.10",
            "verseOrgIds": [
              "PSA.83.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 83:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babebisamaki na Eyini-Dori,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:11"
      },
      "items": [
        {
          "text": "bakomaki lokola matiti ya kopola mpo na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.11",
            "verseOrgIds": [
              "PSA.83.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 83:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala bato na bango ya lokumu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "ndenge osalaki Orebi mpe Zeebi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "mpe sala bakambi na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 83:12"
      },
      "items": [
        {
          "text": "ndenge osalaki Zeba mpe Tsalimuna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.83.12",
            "verseOrgIds": [
              "PSA.83.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
