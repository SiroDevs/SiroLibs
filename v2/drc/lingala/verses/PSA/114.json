          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebale monene emonaki yango mpe ekimaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "mayi ya Yordani ezongaki na sima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
