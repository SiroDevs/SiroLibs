          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bangomba epumbwaki lokola bameme,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "bangomba mike epumbwaki lokola bana ya ntaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
