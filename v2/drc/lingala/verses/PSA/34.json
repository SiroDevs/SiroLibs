  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "PSA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe, mokangoli na ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Ayembaki yango tango akosanaki liboma liboso ya Abimeleki oyo abenganaki ye, mpe akendeki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakopambola Yawe tango nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:2"
      },
      "items": [
        {
          "text": "nakokumisa Ye mikolo nyonso na bibebu na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bomoi na ngai emikumisa kati na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:3"
      },
      "items": [
        {
          "text": "tika ete banyokolami bayoka mpe basepela !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boya kosakola elongo na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:4"
      },
      "items": [
        {
          "text": "ete Yawe azali monene !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:4"
      },
      "items": [
        {
          "text": "Tonetola Kombo na Ye, biso nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalukaki Yawe, mpe ayanolaki ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:5"
      },
      "items": [
        {
          "text": "akangolaki ngai na somo na ngai nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batalaka epai na Ye bangengaka na esengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:6"
      },
      "items": [
        {
          "text": "mpe bayokisamaka soni ata moke te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobola agangaki, mpe Yawe ayokaka ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:7"
      },
      "items": [
        {
          "text": "abikisaki ye na pasi na ye nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anjelu ya Yawe atongaka molako na ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:8"
      },
      "items": [
        {
          "text": "zingazinga ya bato oyo batosaka Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:8"
      },
      "items": [
        {
          "text": "mpe akangolaka bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bomeka elengi mpe botala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "ndenge nini Yawe azali malamu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "Esengo na moto oyo azwaka Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "lokola ebombamelo na ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino basantu ya Yawe, botosa Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:10"
      },
      "items": [
        {
          "text": "pamba te bato oyo batosaka Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:10"
      },
      "items": [
        {
          "text": "bazangaka eloko moko te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya nkosi ezangaka mpe ekufaka nzala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:11"
      },
      "items": [
        {
          "text": "kasi bato oyo balukaka Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:11"
      },
      "items": [
        {
          "text": "bakozanga eloko moko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana na ngai, boya, boyoka ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:12"
      },
      "items": [
        {
          "text": "Nakolakisa bino kotosa Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani asepelaka na bomoi ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:13"
      },
      "items": [
        {
          "text": "Nani alingaka kobika mikolo ebele ya esengo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batela lolemo na yo mosika na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:14"
      },
      "items": [
        {
          "text": "mpe bibebu na yo ete eloba lokuta te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zala mosika na mabe mpe sala bolamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:15"
      },
      "items": [
        {
          "text": "luka kimia mpe koba na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miso ya Yawe etalaka bato ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:16"
      },
      "items": [
        {
          "text": "mpe matoyi na Ye eyokaka koganga na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi Yawe apesaka bato mabe mokongo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
