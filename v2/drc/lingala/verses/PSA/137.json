    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 137",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Pembeni ya bibale ya Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 137:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki biso ya kovanda pembeni ya bibale ya Babiloni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:1"
      },
      "items": [
        {
          "text": "tozalaki kolela na tozalaki kokanisa Siona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 137:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todiembikaki mandanda na biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:2"
      },
      "items": [
        {
          "text": "na banzete ya pepiliye ya etuka yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 137:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna, bato oyo bamemaki biso na bowumbu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "bazalaki kosenga biso banzembo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "mpe banyokoli na biso bazalaki kosenga biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "ete tozala na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "Bazalaki koloba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "« Boyembela biso banzembo ya Siona ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 137:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokoyemba banzembo ya Yawe ndenge nini",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:4"
      },
      "items": [
        {
          "text": "na mabele ya bapaya ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 137:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yelusalemi, soki nabosani yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:5"
      },
      "items": [
        {
          "text": "wana tika ete loboko na ngai ya mobali elemba !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 137:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki natiki penza kokanisa yo, Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "soki natie yo te liboso ya esengo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "wana tika ete lolemo na ngai ekangama kati na monoko na ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 137:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, kobosana te bato ya Edomi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "oyo basekaki Yelusalemi na mokolo na yango ya mawa ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "bazalaki koganga :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "« Bobuka yango, bobuka kino na miboko na yango ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 137:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babiloni, engumba kitoko, yo oyo okobebisama solo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "esengo na moto oyo akozongisela yo mabe na mabe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "oyo osalaki biso !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 137:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na moto oyo akokanga bana na yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:9"
      },
      "items": [
        {
          "text": "mpe akonika bango na libanga !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    }
  ],
