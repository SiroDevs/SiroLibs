    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe Mokeli mpe Mobikisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bato ya sembo, bobeta milolo ya esengo na tina na Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:1"
      },
      "items": [
        {
          "text": "Kokumisa Nzambe ebongi na bato oyo bazali alima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosanzola Yawe na nzenze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:2"
      },
      "items": [
        {
          "text": "bosanzola Ye na lindanda ya basinga zomi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyembela Yawe nzembo ya sika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:3"
      },
      "items": [
        {
          "text": "bobetisa bibetelo mindule elongo na koganga ya esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Liloba na Yawe ezali alima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:4"
      },
      "items": [
        {
          "text": "misala na Ye nyonso ekokisamaka na boyengebene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alingaka bosembo mpe alima ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:5"
      },
      "items": [
        {
          "text": "mokili etondi na bolingo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo ekelamaki na Liloba na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "mampinga na yango nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "na nzela ya pema ya monoko na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asangisaka mayi ya bibale minene esika moko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:7"
      },
      "items": [
        {
          "text": "mpe atiaka yango na bisika ya mozindo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete mokili mobimba etosa Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:8"
      },
      "items": [
        {
          "text": "Tika ete bavandi nyonso ya mokili balenga liboso na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te alobaki, mpe likambo esalemaki ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:9"
      },
      "items": [
        {
          "text": "mpe apesaki mitindo, mpe emonanaki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akweyisaka mikano ya bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:10"
      },
      "items": [
        {
          "text": "abebisaka mabongisi ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi mikano ya Yawe etikalaka mpo na seko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:11"
      },
      "items": [
        {
          "text": "mabongisi ya motema na Ye, mpo na bikeke nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na ekolo oyo Yawe azali Nzambe na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:12"
      },
      "items": [
        {
          "text": "Esengo na bato oyo aponaki mpo na libula na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atalaka wuta na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:13"
      },
      "items": [
        {
          "text": "amonaka bana nyonso ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na evandelo na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:14"
      },
      "items": [
        {
          "text": "atalaka bavandi nyonso ya mokili.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye oyo asalaka mitema nyonso ya bato",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:15"
      },
      "items": [
        {
          "text": "asosolaka makambo nyonso oyo basalaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali te limpinga monene nde ebikisaka mokonzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:16"
      },
      "items": [
        {
          "text": "to nguya monene nde ekangolaka elombe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpunda ezali na nguya te ya kopesa lobiko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:17"
      },
      "items": [
        {
          "text": "makasi na yango nyonso ekangolaka te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande Yawe atalaka bato oyo batosaka Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:18"
      },
      "items": [
        {
          "text": "ba-oyo batiaka elikya na bolingo kati na Ye,",
