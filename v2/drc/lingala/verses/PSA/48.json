          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azali kati na bandako na yango ya bokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
