            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:3"
      },
      "items": [
        {
          "text": "Ngambo na yango ya Nor nde ezali",
