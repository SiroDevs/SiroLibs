    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 146",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe alongisaka banyokolami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 146:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokumisa Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 146:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:1"
      },
      "items": [
        {
          "text": "Oh molimo na ngai, kumisa Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 146:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakokumisa Yawe bomoi na ngai mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:2"
      },
      "items": [
        {
          "text": "nakosanzola Nzambe na ngai tango nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:2"
      },
      "items": [
        {
          "text": "nakozala na bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 146:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botia elikya te na bakambi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "to na bato oyo bazangi makoki ya kobikisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 146:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bakufi, bazongaka na mabele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:4"
      },
      "items": [
        {
          "text": "mpe, mbala moko, mabongisi na bango elimwaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 146:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na moto oyo Nzambe ya Jakobi azali mosungi na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:5"
      },
      "items": [
        {
          "text": "oyo atiaka elikya na ye kati na Yawe, Nzambe na ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 146:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akelaki Likolo mpe mabele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "ebale monene mpe nyonso oyo ezali kati na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "azali sembo seko na seko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 146:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akataka na sembo makambo ya banyokolami",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "mpe apesaka bilei na bato oyo bazali na nzala ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "abimisaka bakangami na boloko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 146:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe abikisaka miso ya bakufi miso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "Yawe asembolaka bato oyo bazali ya kogumbama ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "Yawe alingaka bato ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 146:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe abatelaka bapaya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "asungaka mwana etike mpe mwasi oyo akufisa mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "kasi abebisaka banzela ya bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 146:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali Mokonzi seko na seko ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Nzambe na yo, oh Siona, libela na libela !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 146:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Bokumisa Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
