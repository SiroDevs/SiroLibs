      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:5"
      },
      "items": [
        {
          "text": "mpe bogumbama liboso ya enyatelo makolo na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
