        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Bogumbamela Yawe, pamba te azali Mosantu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 99:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali kokonza ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "tika ete bato balenga !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "Avandi na Kiti ya Bokonzi kati na basheribe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:1"
      },
      "items": [
        {
          "text": "tika ete mabele eningana !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.1",
            "verseOrgIds": [
              "PSA.99.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 99:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali monene kati na Siona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:2"
      },
      "items": [
        {
          "text": "mpe Bokonzi na Ye ezali likolo ya bikolo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.2",
            "verseOrgIds": [
              "PSA.99.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 99:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Kombo na Yo ya monene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:3"
      },
      "items": [
        {
          "text": "mpe ya somo esanzolama ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:3"
      },
      "items": [
        {
          "text": "ezali bule !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.3",
            "verseOrgIds": [
              "PSA.99.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
