      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 99:7"
      },
      "items": [
        {
          "text": "Babatelaki malako na Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.7",
            "verseOrgIds": [
              "PSA.99.7"
            ]
