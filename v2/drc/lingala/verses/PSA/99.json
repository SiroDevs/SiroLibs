          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonetola Yawe, Nzambe na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.5",
            "verseOrgIds": [
              "PSA.99.5"
            ]
          }
        }
      ]
    },
    {
