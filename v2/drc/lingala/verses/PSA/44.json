    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe abwaki biso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya bana ya Kore. Wuta na buku ya mokambi ya bayembi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, toyokaki na matoyi na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "bakoko na biso babetelaki biso lisolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "ya makambo oyo osalaki na tango na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "na tango ya kala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nguya na Yo, obenganaki bikolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "mpe otiaki bakoko na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "obetaki bikolo ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "mpe ofulukisaki bakoko na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ezalaki na mopanga na bango te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "nde babotolaki mokili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "ezalaki mpe maboko na bango te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "nde ebikisaki bango ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "kasi ezalaki nde loboko na Yo ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "nguya na Yo mpe pole ya elongi na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "pamba te ozalaki kolinga bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, Yo oyo ozali Mokonzi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:5"
      },
      "items": [
        {
          "text": "pesa mitindo mpo na elonga ya Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na lisungi na Yo, tolongaka banguna na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:6"
      },
      "items": [
        {
          "text": "mpe na Kombo na Yo, tonyataka bayini na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te natiaka elikya te na tolotolo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:7"
      },
      "items": [
        {
          "text": "mpe mopanga na ngai ebikisaka ngai te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezali Yo nde obikisaka biso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "wuta na maboko ya bayini na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "mpe oyokisaka bayini na biso soni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomikumisaka mikolo nyonso kati na Nzambe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:9"
      },
      "items": [
        {
          "text": "mpe tokokumisa Kombo na Yo mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi obwaki biso, oyokisi biso soni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "mpe ozali lisusu kotambola te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "elongo na mampinga na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otiki biso kokima liboso ya banguna na biso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:11"
      },
      "items": [
        {
          "text": "mpe bayini na biso bazwi biloko na biso na makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osundoli biso na maboko na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "lokola bameme ya koboma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "mpe opanzi biso kati na bikolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oteki bato na Yo na pamba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:13"
      },
      "items": [
        {
          "text": "mpe ozwi ata litomba te kowuta na boteki yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomisi biso eloko ya lisuma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "na miso ya bato oyo bazali pembeni na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "eloko ya litio mpe ya liseki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.14"
