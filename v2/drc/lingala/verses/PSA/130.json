    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 130",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Wuta na mozindo ya pasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 130:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya mobembo mpo na kokende na Ndako ya Nkolo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 130:1"
      },
      "items": [
        {
          "text": "Nkolo, nazali kobelela Yo wuta na mozindo ya pasi !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 130:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo, yoka ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "Yoka mabondeli na ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 130:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, soki obosanaka masumu te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:3"
      },
      "items": [
        {
          "text": "Nkolo, nani akokaki kotelema ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bolimbisi ezali epai na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:4"
      },
      "items": [
        {
          "text": "yango wana basengeli kotosa Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 130:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na motema na ngai mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "nazali na elikya kati na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "nazali penza na elikya ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "nazali kozela maloba na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 130:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali na elikya kati na Nkolo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "koleka kutu ndenge mokengeli azelaka kotana ya tongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "koleka penza ndenge mokengeli azelaka kotana ya tongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 130:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele, tia elikya kati na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "pamba te azali bolingo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "mpe kokangolama ya kokoka ezali elongo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 130:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye nde akokangola Isalaele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:8"
      },
      "items": [
        {
          "text": "na bambeba na yango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    }
