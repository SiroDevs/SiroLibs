      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "mpe na makambo na kanza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
