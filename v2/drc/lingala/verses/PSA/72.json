      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:13"
      },
      "items": [
        {
          "text": "mpe akobikisa moto akelela na kufa ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
