          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te akokangola moto akelela",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "oyo azali koganga mpo na kosenga lisungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "mpe mobola oyo azangi mosungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoyokela mobola mpe moto akelela mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
