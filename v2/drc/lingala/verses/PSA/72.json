      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "pamba te bomoi na bango ezali motuya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
