      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "abimisaka mopepe wuta na bibombelo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
