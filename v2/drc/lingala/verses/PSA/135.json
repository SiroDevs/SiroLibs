          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe aponaki Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
