      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "Isalaele, mpo ete azala ya Ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
