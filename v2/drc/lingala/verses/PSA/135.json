      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "ete Nkolo na biso aleki banzambe nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
