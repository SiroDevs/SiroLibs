      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:12"
      },
      "items": [
        {
          "text": "lokola libula epai ya bato na Ye, Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
