          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe akolimbisa bato na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:14"
      },
      "items": [
        {
          "text": "akoyokela basali na Ye mawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
