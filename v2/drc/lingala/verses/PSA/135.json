          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "pamba te ezali kitoko makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
