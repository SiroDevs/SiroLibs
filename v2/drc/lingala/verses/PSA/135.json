          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikoni, mokonzi ya bato ya Amori ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
