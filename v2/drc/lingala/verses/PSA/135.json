    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "kuna na likolo mpe awa na mabele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "kati na bibale minene mpe kati na mozindo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
