            "number": "6",
            "style": "v",
            "sid": "PSA 135:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asalaka nyonso oyo alingi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
