          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, sango ya Kombo na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "ewumelaka libela na libela !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "Yawe, bakopanza sango ya Kombo na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
