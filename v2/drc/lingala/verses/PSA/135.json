            "sid": "PSA 135:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, ngai nayebi malamu ete Yawe azali monene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
