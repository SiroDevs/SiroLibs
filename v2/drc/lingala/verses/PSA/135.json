      "attrs": {
        "style": "q2",
        "vid": "PSA 135:8"
      },
      "items": [
        {
          "text": "kobanda na bato kino na banyama ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
