      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "Ogi, mokonzi ya Bashani ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "mpe bakonzi nyonso ya Kanana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
