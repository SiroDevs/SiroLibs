  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo azalaki kokonza bikolo wana nyonso, kobanda na ebale Efrate kino na mokili ya bato ya Filisitia, mpe kino koleka mondelo ya Ejipito. Na bomoi na ye mobimba, bikolo yango ezalaki kofuta mpako epai na ye mpe ezalaki na se ya bokonzi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilei ya Salomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bilei ya Salomo ya mokolo na mokolo : bakilo nkoto libwa ya semule mpe bakilo nkoto zomi na mwambe ya farine,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bangombe zomi ya mafuta, bangombe tuku mibale ya esobe, bameme mpe bantaba nkama moko, bakisa bamboloko, bambuli, bankayi mpe bandeke ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki kokonza bikolo nyonso na ngambo ya weste ya Efrate, kobanda na Tifisa kino na Gaza, elongo na bakonzi nyonso ya ngambo yango ; mpe azalaki na kimia elongo na bikolo nyonso ya zingazinga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo nyonso ya bomoi ya Salomo, bato ya Yuda mpe ya Isalaele, kobanda na Dani kino na Beri-Sheba, bazalaki na kimia, moto na moto azalaki kovanda na se ya banzete na ye ya vino mpe ya figi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo azalaki na mapango nkoto minei ya bampunda mpe basoda oyo batambolaka likolo ya bampunda, nkoto zomi na mibale.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayangeli ya bituka bazalaki komema bilei, moto na moto na sanza na ye, mpo na mokonzi Salomo mpe mpo na bato nyonso oyo bazalaki kolia na mesa ya mokonzi ; bazalaki kosala ete eloko moko te ezanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalaki mpe komema bambuma ya orje mpe matiti mpo na bampunda, ndenge mobateli biloko ya mokonzi azalaki kokatela bango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bwanya ya Salomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe apesaki Salomo bwanya, boyebi mingi, mpe mayele ya kososola makambo mingi, ata ezali ebele lokola zelo ya libongo ya ebale monene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanya ya Salomo ezalaki makasi koleka bwanya ya bato nyonso ya ngambo ya este mpe ya Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki na bwanya koleka bato nyonso ; koleka ata Etani, moto ya Ezera ; Emani, Kalikoli mpe Darida, bana mibali ya Maoli. Boye, sango na ye epanzanaki kati na bikolo nyonso ya zingazinga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki masese nkoto misato mpe banzembo nkoto moko na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na tina na banzete, kobanda na nzete ya sedele ya Libani kino na nzete ya izope oyo ebimaka na mir ; azalaki mpe koloba na tina na banyama mpe bandeke, na tina na bikelamu oyo etambolaka na libumu mpe na tina na bambisi ya mayi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakonzi ya bikolo nyonso ya mokili, oyo bazalaki koyoka sango ya bwanya ya Salomo, bazalaki kotinda bato, wuta na bikolo na bango, mpo na kokende koyoka bwanya na ye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boyokani elongo na mokonzi ya Tiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.2.1-2CH.2.17"
          },
          "items": [
            {
              "text": "2Ma 2.1-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Irami, mokonzi ya Tiri, ayokaki sango ete bapakolaki Salomo mafuta mpo ete akoma mokonzi mpo na kokitana na Davidi, tata na ye, atindaki bantoma epai ya Salomo, pamba te azalaki tango nyonso molingami ya Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo azongiselaki Irami maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "— Oyebi malamu ete Davidi, tata na ngai, alongaki te kotonga Ndako mpo na Yawe, Nzambe na ye, likolo ya bitumba oyo azalaki na yango na bikolo oyo ezingelaki ye, kino tango Yawe atiaki bikolo yango na se ya matambe na ye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi sik'oyo, Yawe, Nzambe na ngai, apesi ngai bopemi na bangambo nyonso, mpe ezali lisusu na monguna moko te mpe na likambo moko te oyo ekoki kobangisa ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, nazwi mokano ya kotonga Ndako mpo na lokumu ya Yawe, Nzambe na ngai, ndenge Yawe alobaki na Davidi, tata na ngai : « Ezali mwana na yo ya mobali oyo nakovandisa na kiti na yo ya bokonzi mpo na kokitana na yo nde akotonga Ndako mpo na lokumu ya Kombo na Ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.19",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, pesa mitindo ete bakatela ngai banzete ya sedele ya Libani. Basali na ngai bakosunga basali na yo, mpe ngai nakofuta yo lifuti oyo okokata mpo na basali na yo, pamba te oyebi malamu ete ezali na bato te kati na biso oyo bayebi kokata banzete lokola bino, bato ya Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.20",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Irami ayokaki maloba ya Salomo, asepelaki na yango makasi mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.21",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:21"
      },
      "items": [
        {
          "text": "— Tika ete Yawe apambolama, Ye oyo apesaki Davidi mwana oyo atondi na bwanya mpo na kokamba ekolo monene oyo !",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.21",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irami atindelaki Salomo eyano oyo :",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.22",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:22"
      },
      "items": [
        {
          "text": "— Nayambaki maloba oyo otindelaki ngai mpe nakosala nyonso oyo ozali na yango posa : banzete ya sedele mpe ya sipele.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.22",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basali na ngai bakomema banzete yango wuta na Libani kino na ebale monene, bakokangisa yango na basinga mpo na kotinda yango na nzela ya ebale monene ; mpe nakosala ete ekoma kino na esika oyo okoyebisa ngai. Kuna nde nakofungola yango basinga ; mpe yo, okoki kozwa mpe komema yango. Kasi yo, okokokisa posa na ngai oyo : okobanda kopesa basali ya ndako na ngai bilei.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.23",
            "verseOrgIds": [
              "1KI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irami apesaki epai ya Salomo banzete ya sedele mpe ya sipele nyonso oyo azalaki na yango na bosenga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.24",
            "verseOrgIds": [
              "1KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo mpe, na ngambo na ye, azalaki kopesa mobu na mobu epai ya Irami batone nkoto motoba ya ble, balitele nkoto libwa ya mafuta ya olive ya kitoko koleka, mpo na ndako ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.25",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe apesaki Salomo bwanya kolanda elaka oyo apesaki ye. Boye, kimia ezalaki kati na Irami mpe Salomo, mpe bango mibale basalaki boyokani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.26",
            "verseOrgIds": [
