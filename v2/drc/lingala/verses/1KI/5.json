              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apesaki mitindo ete bapasola mabanga minene mpe ya kitoko mpo na kosalela yango moboko ya Tempelo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.31",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
