        "style": "s1"
      },
      "items": [
        {
          "text": "Mabongisi mpo na kotonga Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
