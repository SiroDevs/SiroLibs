  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "HOS 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kozonga epai na Yawe : nzela ya lobiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Masumu ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efrayimi azingeli Ngai na lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "mpe libota ya Isalaele, na kokosa ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "kasi Yuda azali nanu kotambola elongo na Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "elongo na Mosantu ya solo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efrayimi aliaka mopepe ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "mikolo nyonso, alandaka mopepe ya este ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "mosala na ye kokosa mpe kosala bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "Asalaka boyokani elongo na Asiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "mpe atindaka mafuta ya olive na Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alingi kosamba na Yuda ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:3"
      },
      "items": [
        {
          "text": "akopesa Jakobi etumbu kolanda etamboli na ye",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:3"
      },
      "items": [
        {
          "text": "mpe akofuta ye kolanda misala na ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na libumu ya mama na bango,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:4"
      },
      "items": [
        {
          "text": "akangaki ndeko na ye ya mobali na litambe ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:4"
      },
      "items": [
        {
          "text": "tango akomaki mokolo, abundaki na Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abundaki na anjelu mpe alongaki,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:5"
      },
      "items": [
        {
          "text": "alelaki mpe asengaki ngolu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:5"
      },
      "items": [
        {
          "text": "Jakobi akutanaki na ye na Beteli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:5"
      },
      "items": [
        {
          "text": "mpe ezali kuna nde asololaki na ye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe Nzambe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:6"
      },
      "items": [
        {
          "text": "Kombo na Ye ya lokumu ezali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi yo, osengeli kozonga epai ya Nzambe na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:7"
      },
      "items": [
        {
          "text": "batela bolingo mpe bosembo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:7"
      },
      "items": [
        {
          "text": "mpe tia tango nyonso elikya na Nzambe na yo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Kanana basalelaka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:8"
      },
      "items": [
        {
          "text": "emekelo kilo ya lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:8"
      },
      "items": [
        {
          "text": "balingaka kaka kokosa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efrayimi alobaka na lolendo nyonso :",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "« Ngai nazali mozwi, nakomi na bozwi mingi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "Na mosala na Ngai nyonso, bakotikala komona Ngai",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "na mbeba ata moko te oyo bakoki kobenga lisumu. »",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali Yawe, Nzambe na yo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:10"
      },
      "items": [
        {
          "text": "oyo abimisaki yo wuta na Ejipito ;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:10"
      },
      "items": [
        {
          "text": "nakosala ete ovanda lisusu na se ya bandako ya kapo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:10"
      },
      "items": [
        {
          "text": "lokola na mikolo ya bafeti na yo, oyo ekatama.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki na nzela ya basakoli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:11"
      },
      "items": [
        {
          "text": "napesaki bango bimoniseli ebele",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:11"
      },
      "items": [
        {
          "text": "mpe nalobaki na masese na nzela na bango.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola Galadi etondi na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:12"
      },
      "items": [
        {
          "text": "ekokoma eloko pamba",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:12"
      },
      "items": [
        {
          "text": "mpo ete bato na yango babonzaki",
