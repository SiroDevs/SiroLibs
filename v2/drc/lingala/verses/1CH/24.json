    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kokabola misala ya Balevi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bituka ya bana mibali ya Aron : Nadabi, Abiyu, Eleazari mpe Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadabi mpe Abiyu bakufaki liboso ya tata na bango mpe batikalaki kobota te. Eleazari mpe Itamari basalaki mosala na bango ya bonganga-Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge Davidi akabolaki bango kolanda misala oyo bapesaki bango : Tsadoki, na etuka ya Eleazari ; Ayimeleki, na etuka ya Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamonaki ete kati na bakitani ya Eleazari, bana mibali bazalaki ebele koleka bato oyo bazalaki kati na bakitani ya Itamari. Boye, bakabolaki bana mibali ya Eleazari lokola bakonzi ya mabota zomi na motoba mpe bana mibali ya Itamari lokola bakonzi ya mabota mwambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babetaki zeke mpo na kokabola bango, pamba te kati na bakitani ya Eleazari mpe ya Itamari, ezalaki na bakambi ya Esika ya bule mpe bakambi ya mosala ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaya, mokomi mikanda, mwana mobali ya Netaneeli, na libota ya Levi, akomaki bakombo na bango na miso ya mokonzi, ya bakambi, ya Nganga-Nzambe Tsadoki, ya Ayimeleki, mwana mobali ya Abiatari ; mpe ya bakambi ya mabota ya Banganga-Nzambe mpe Balevi. Babetaki zeke mbala mibale mpo na etuka ya Eleazari, mpe mbala moko, mpo na etuka ya Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        }
      ]
    },
    {
