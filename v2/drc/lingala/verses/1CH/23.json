          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Merari :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Maali mpe Mushi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Bana mibali ya Maali :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:21"
      },
      "items": [
        {
          "text": "Eleazari mpe Kishi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.21",
            "verseOrgIds": [
              "1CH.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazari akufaki mpe atikalaki kobota bana mibali te, azalaki kaka na bana basi oyo babalanaki na bandeko na bango, bana mibali ya tata leki na bango Kishi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
            "verseOrgIds": [
              "1CH.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Mushi :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:23"
      },
      "items": [
        {
          "text": "Maali, Ederi mpe Yeremoti. Bango nyonso bazalaki misato.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bango nde bazalaki bakitani ya Levi kolanda bituka na bango, mpe bakambi ya bituka na bango kolanda ndenge bakomamaki, moto na moto, na buku ya mabota. Bazwaki mokumba ya kosala misala kati na Tempelo ya Yawe, kobanda na oyo azalaki na mibu tuku mibale mpe koleka.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi alobaki : « Yawe, Nzambe ya Isalaele, apesi bopemi na bato na Ye mpe avandi libela kati na Yelusalemi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Balevi bazala lisusu te na mokumba ya komema Mongombo mpe bisalelo na yango nyonso. »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki kolanda malako ya suka ya Davidi nde batangaki bakitani ya Levi kobanda na mibu tuku mibale mpe koleka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosala ya Balevi ezalaki mpo na kosunga bakitani ya Aron na mosala ya Tempelo ya Yawe : kolandela bopeto ya veranda mpe ya bashambre, kopetola biloko nyonso ya bule mpe kosala misala nyonso ya Tempelo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalaki na mokumba ya kotanda mapa na mesa, kobongisa farine mpo na makabo ya bagato ezanga levire, bagalete mpe bagato batumba na kikalungu, mpe bagato basangisa na mafuta mpe biloko nyonso oyo bamekelaka kilo mpe molayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalaki mpe na mokumba ya kotelema liboso ya Yawe, tongo mpe pokwa nyonso, mpo na kokumisa mpe kosanzola Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe kobonza tango nyonso bambeka ya kotumba oyo bazalaki komema epai na Yawe na mikolo ya Saba, na ebandeli ya sanza mpe na mikolo nyonso ya bafeti oyo ekatama, kolanda motango oyo bakatelaki bango mpo na libela liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Balevi bazalaki kosala mosala na bango ya kokengela Ndako ya kapo ya Bokutani mpe Esika ya bule, mpe ya kosunga bandeko na bango ya mibali, bana ya Aron, na mosala ya Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
  ],
