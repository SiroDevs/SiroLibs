        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balevi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Davidi akomaki mobange makasi, akomisaki Salomo, mwana na ye ya mobali, mokonzi ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asangisaki bakambi nyonso ya Isalaele elongo na Banganga-Nzambe mpe Balevi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batangaki Balevi nyonso oyo bazalaki na mibu tuku misato mpe koleka : motango nyonso ya Balevi ezalaki nkoto tuku misato na mwambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alobaki : « Tika ete Balevi nkoto tuku mibale na minei bazala bakambi ya misala ya Tempelo ya Yawe, Balevi nkoto motoba bazala bakomi mikanda mpe basambisi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balevi nkoto minei bazala bakengeli bikuke, mpe Balevi nkoto minei bakumisa Yawe na bibetelo mindule oyo nasalaki na tina na yango. »",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi akabolaki bango na masanga kolanda buku ya mabota ya bana mibali ya Levi : Gerishoni, Keati mpe Merari.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na libota ya Gerishoni :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:7"
      },
      "items": [
        {
          "text": "Laedani mpe Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.7",
            "verseOrgIds": [
              "1CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laedani azalaki na bana mibali misato :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:8"
      },
      "items": [
        {
          "text": "mokonzi Yeyeli, Zetami mpe Joeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.8",
            "verseOrgIds": [
              "1CH.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei azalaki na bana mibali misato :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:9"
      },
      "items": [
        {
          "text": "Shelomiti, Azieli mpe Arani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:9"
      },
      "items": [
        {
          "text": "Bango nde bazalaki bakambi ya mabota ya Laedani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.9",
            "verseOrgIds": [
              "1CH.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei azalaki na bana mibali mosusu minei :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:10"
      },
      "items": [
        {
          "text": "Yaati, Ziza, Yewushi mpe Beria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.10",
            "verseOrgIds": [
              "1CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaati azalaki mwana ya liboso, mpe Ziza, mwana ya mibale. Nzokande Yewushi mpe Beria bazalaki na bakitani ebele te. Boye batangaki bango lokola libota moko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.11",
            "verseOrgIds": [
              "1CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keati azalaki na bana mibali minei :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:12"
      },
      "items": [
        {
          "text": "Amirami, Yitseari, Ebron mpe Uzieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.12",
            "verseOrgIds": [
              "1CH.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amirami azalaki na bana mibali mibale :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:13"
      },
      "items": [
        {
          "text": "Aron mpe Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:13"
      },
      "items": [
        {
          "text": "Aron aponamaki mpo na libela, elongo na bana na ye ya mibali, mpo na kobulisa Esika-Oyo-Eleki-Bule, mpo na kotumba mbeka ya malasi liboso ya Yawe, mpo na kosalela Ye mpe kopambola bato mpo na libela na Kombo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.13",
            "verseOrgIds": [
              "1CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya Moyize, moto na Nzambe, batangaki bango na ekolo ya Levi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.14",
            "verseOrgIds": [
              "1CH.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:15"
      },
      "items": [
        {
          "text": "Gerishomi mpe Eliezeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.15",
            "verseOrgIds": [
              "1CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Gerishomi :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:16"
      },
      "items": [
        {
          "text": "Shebueli azalaki mwana mobali ya liboso.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.16",
            "verseOrgIds": [
              "1CH.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Eliezeri :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:17"
      },
      "items": [
        {
          "text": "Reabia azalaki mwana na ye se moko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CH 23:17"
      },
      "items": [
        {
          "text": "Eliezeri azalaki na bana mosusu te, kasi Reabia azalaki na bana ebele.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.17",
            "verseOrgIds": [
              "1CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Yitseari :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:18"
      },
      "items": [
        {
          "text": "Shelomiti azalaki mwana ya liboso kati na bana mibali ya Yitseari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.18",
            "verseOrgIds": [
              "1CH.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Ebron :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:19"
      },
      "items": [
        {
          "text": "Yeriya, mwana ya liboso ; Amaria, mwana ya mibale ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:19"
      },
      "items": [
        {
          "text": "Yaazieli, mwana ya misato mpe Yekameami, mwana ya minei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Uzieli :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:20"
      },
      "items": [
        {
          "text": "Mishe, mwana ya liboso ; mpe Yishiya, mwana ya mibale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.20",
            "verseOrgIds": [
              "1CH.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
