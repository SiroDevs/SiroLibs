      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:19"
      },
      "items": [
        {
          "text": "tata ya Keila, moto ya Garima ; mpe Eshitemoa, moto ya mboka Maakati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        }
      ]
    },
    {
