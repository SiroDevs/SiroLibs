            "id": "2SA.8.1-2SA.8.14"
          },
          "items": [
            {
              "text": "2Sa 8.1-14",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Davidi alongaki bato ya Filisitia mpe abukaki lolendo na bango. Abotolaki na maboko ya bato ya Filisitia engumba Gati elongo na bamboka na yango ya zingazinga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alongaki lisusu bato ya Moabi. Bato ya Moabi bakomaki bawumbu ya Davidi mpe bakomaki kofuta mpako ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alongaki lisusu Adadezeri, mokonzi ya Tsoba, na engumba Amati, tango Adadezeri akendeki kovandisa bokonzi na ye pembeni ya ebale Efrate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi abotolaki Adadezeri bashar nkoto moko, akangaki basoda nkoto sambo oyo babundaka bitumba likolo ya bampunda mpe basoda nkoto tuku mibale oyo babundaka bitumba na makolo ; akataki misisa ya makolo ya bampunda nyonso, kasi atikaki kaka bampunda nkama moko oyo ezalaki kobenda bashario.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bato ya Siri oyo bazalaki kovanda na engumba Damasi bayaki kosunga Adadezeri, mokonzi ya Tsoba, Davidi abomaki kati na bango bato nkoto tuku mibale.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi atiaki bayangeli na ye kati na engumba Damasi ya Siri ; boye bato ya Siri bakomaki na se ya bokonzi ya Davidi mpe bakomaki kofuta mpako epai na ye. Yawe azalaki kopesa Davidi elonga na bisika nyonso oyo azalaki kokende.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi abotolaki banguba ya wolo oyo bakonzi ya basoda ya Adadezeri bazalaki na yango mpe amemaki yango na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Tibati mpe na Kuni, bingumba ya mokonzi Adadezeri, Davidi azwaki bronze ebele oyo, na mikolo oyo elandaki, Salomo asalaki na yango nzungu ya monene, makonzi mpe bisalelo mosusu ya bronze.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Towu, mokonzi ya Amati, ayokaki ete Davidi alongi mampinga nyonso ya Adadezeri, mokonzi ya Tsoba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "atindaki Adorami, mwana na ye ya mobali, kopesa mokonzi Davidi mbote mpe longonya mpo ete abundisaki mpe alongaki Adadezeri oyo azalaki monguna ya Towu. Adorami amemelaki Davidi lolenge nyonso ya biloko ya wolo, ya palata mpe ya bronze.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Davidi abulisaki biloko yango epai na Yawe, ndenge asalaki na wolo mpe palata oyo azwaki na bikolo nyonso, na Edomi, na Moabi, na Amoni, na Filisitia mpe na Amaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishayi, mwana mobali ya Tseruya, abomaki bato ya Edomi nkoto zomi na mwambe, kati na Lubwaku ya Mungwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atiaki bayangeli kati na Edomi, mpe bato nyonso ya Edomi bakomaki bawumbu ya Davidi. Yawe apesaki Davidi elonga na bisika nyonso oyo azalaki kokende.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakalaka ya Davidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.8.15-2SA.8.18"
          },
          "items": [
            {
              "text": "2Sa 8.15-18",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi azalaki mokonzi ya Isalaele mobimba, mpe azalaki kosalela bato na ye nyonso makambo ya sembo mpe ya alima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabi, mwana mobali ya Tseruya, azalaki mokonzi ya liboso ya mampinga ; Jozafati, mwana mobali ya Ayiludi, azalaki mobombi mikanda ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsadoki, mwana mobali ya Ayitubi, mpe Abimeleki, mwana mobali ya Abiatari, bazalaki Banganga-Nzambe ; Shavisha azalaki mokomi mikanda ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, mwana mobali ya Yeoyada, azalaki kokamba bato ya Kereti mpe ya Peleti ; mpe bana mibali ya Davidi bazalaki bakalaka ya liboso pembeni ya mokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
  ],
