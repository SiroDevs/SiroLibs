              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitani ya ndambo ya libota ya Manase bavandaki na mokili oyo ezalaki longwa na Bashani kino na Bala-Erimoni, Seniri mpe ngomba Erimoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.23",
            "verseOrgIds": [
              "1CH.5.23"
