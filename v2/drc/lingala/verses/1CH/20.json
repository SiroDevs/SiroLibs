      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mobu oyo elandaki, na tango oyo bakonzi bazalaka na momesano ya kokende na bitumba, Joabi akambaki mampinga na bitumba mpe abebisaki mokili ya bato ya Amoni ; bongo akendeki kotonga molako liboso ya Raba. Kasi Davidi atikalaki na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 20:1"
      },
      "items": [
        {
          "text": "Joabi abundisaki engumba Raba mpe apanzaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi alongolaki motole oyo ezalaki na moto ya mokonzi na yango. Bamonaki ete esalemaki na bakilo ya wolo koleka tuku misato mpe ezalaki na libanga ya talo likolo na yango. Wuta na tango wana, ekomaki na moto ya Davidi. Akamataki bomengo ebele ya bitumba kati na engumba yango.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amemaki na bowumbu bato oyo bazalaki kuna, atiaki bango na misala oyo basalaka na si, na piki",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "text": "mpe na epasola. Davidi asalaki ndenge wana na bavandi ya bingumba nyonso ya bato ya Amoni ; bongo azongaki na Yelusalemi elongo na mampinga na ye nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bitumba na bato ya Filisitia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.21.15-2SA.21.22"
          },
          "items": [
            {
              "text": "2Sa 21.15-22",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mwa tango, ezalaki lisusu na bitumba na bato ya Filisitia, kuna na mboka Gezeri. Ezalaki na tango yango nde Sibekayi, moto ya Usha, abomaki Sipayi, moko kati na bakitani ya Rafa ; mpe bato ya Filisitia bayokisamaki soni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki lisusu na bitumba na bato ya Filisitia ; mpe Elanani, mwana mobali ya Yairi, abomaki Lami, ndeko mobali ya Goliati, moto ya Gati, oyo nzete ya likonga na ye ezalaki monene lokola libaya oyo basali bilamba na maboko basalelaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki lisusu na bitumba oyo esalemaki kuna na Gati ; mpe ezalaki kuna na mbinga mobali moko, mokitani ya Rafa, oyo azalaki na misapi motoba na loboko moko na moko, mpe misapi motoba na lokolo moko na moko. Na kosangisa, azalaki na misapi tuku mibale na minei.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiolaki Isalaele ; mpe Jonatan, mwana mobali ya Shimea mpe ndeko mobali ya Davidi, abomaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato wana bazalaki bakitani ya Rafa, babotama na Gati mpe bakufaki liboso ya Davidi mpe ya basoda na ye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
