        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kokabolama ya mokili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bokokabola mokili na zeke lokola libula, bokopesa epai na Yawe eteni moko lokola etuka ya bule : ekozala na bametele pene nkoto zomi na mibale na nkama mitano na molayi, mpe bametele nkoto mitano na mokuse. Etuka yango ekozala bule na etando na yango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokotika bametele pene nkama mibale na tuku mitano na molayi, mpe bametele pene nkama mibale na tuku mitano na mokuse mpo na kotonga Esika ya bule ; bongo bokozingela yango na lopango moko ya polele ya bametele pene tuku mibale na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na etuka wana ya bametele pene nkoto zomi na mibale na nkama mitano na molayi, mpe bametele pene nkoto mitano na mokuse, bokokata eteni ya mabele mpo na Esika ya bule, Esika-Oyo-Eleki-Bule.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala eteni ya bule oyo balongoli kati na mokili : ezali ya Banganga-Nzambe oyo basalaka mosala kati na Esika ya bule mpe bapusanaka pene ya Yawe mpo na kosalela Ye ; ezali kuna nde bakotonga bandako na bango, mpe ekozala esika oyo ebulisami mpo na Esika ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etuka moko ya bametele pene nkoto zomi na mibale na nkama mitano na molayi mpe bametele pene nkoto mitano na mokuse ekozala mpo na Balevi oyo basalaka kati na Tempelo ; lokola libula na bango, ekozala kuna nde bakotonga bingumba na bango ya kovanda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pembeni ya etuka ya bule, bokokata etando ya bametele pene nkoto zomi na mibale na nkama mitano na molayi mpe bametele pene nkoto mitano na mokuse mpo na kotonga engumba ; ekozala mpo na libota mobimba Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi akozwa mabele oyo ezali kokabola etuka ya bule mpe mabele ya engumba ; mabele yango ekokende eteni moko na ngambo ya weste, mpe eteni mosusu na ngambo ya este. Molayi ya etuka yango ekobanda longwa na ngambo ya weste kino na mondelo ya ngambo ya este oyo etalana na moko ya biteni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etuka yango ekozala libula na ye kati ya Isalaele. Boye, bakambi na Ngai bakonyokola lisusu bato na Ngai te, kasi bakotika mokili na maboko ya lisanga ya Isalaele kolanda mabota na bango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Nkolo Yawe alobi : Oh bakambi ya Isalaele, bino mpe bolekisi ! Botika makambo mabe mpe botika konyokola bato. Bosala makambo oyo ezali solo mpe alima. Botika kobotola bato na Ngai biloko na bango, elobi Nkolo Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosengeli te kosalela emekelo kilo ya lokuta, efa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "text": "ya lokuta to bati",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "text": "ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efa mpe bati ekotaka biloko ndenge moko : ekotaka ndambo moko kati na bandambo zomi ya omeri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "text": ". Bamekaka monene ya efa mpe bati kolanda monene ya omeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbongo moko ya ebende ya palata ekokani na bagrame zomi na mibale, mpe mine moko ekokani na mbongo ya bibende ya palata, tuku motoba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makabo mpo na mokolo ya bafeti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biloko oyo bokotia pembeni lokola makabo ya kopesa epai na Yawe : mpo na omeri moko ya ble mpe orje, eteni ya motoba ya efa moko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobeko mpo na mafuta, bakomeka yango na bati : eteni ya zomi ya omeri moko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe bokozwa ntaba moko ya mwasi to meme moko ya mobali kati na bibwele nkama mibale, oyo ekobimela na etonga ya bibwele oyo eliaka matiti kitoko ya Isalaele. Bakosalela yango lokola likabo ya bambuma, mbeka ya kotumba mpe mbeka mpo na kozongisa boyokani, mpo na kosala mosala ya bolimbisi masumu ya bato, elobi Nkolo Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso ya mokili basengeli kolongola likabo yango mpo na mokambi kati na Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi akozala na mokumba ya kopesa bambeka ya kotumba, makabo ya bambuma mpe makabo ya masanga ya vino na tango ya bafeti, na bafeti ya ebandeli ya sanza, ya basaba mpe na bafeti nyonso ya lisanga ya Isalaele, oyo ekatama ; akopesa mbeka ya masumu, makabo ya bambuma, mbeka ya kotumba mpe mbeka mpo na kozongisa boyokani mpo na kosala mosala ya bolimbisi masumu mpo na libota ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Nkolo Yawe alobi : Na mokolo ya liboso ya sanza ya liboso, okokamata mwana ngombe ya mobali oyo ezanga mbeba mpe okopetola Esika ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.18",
            "verseOrgIds": [
              "EZK.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe akozwa ndambo ya makila ya mbeka ya masumu, akotia yango na mabaya oyo esimbaka ekuke ya Tempelo, na basonge nyonso minei ya moboko ya etumbelo mpe na mabaya oyo esimbaka ekuke ya lopango ya kati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.19",
            "verseOrgIds": [
              "EZK.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosala ndenge moko na mokolo ya sambo ya sanza, mpo na moto nyonso oyo akosala masumu na nko te to na kozanga boyebi ; bongo nde okosala mosala ya bolimbisi masumu mpo na Tempelo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.20",
            "verseOrgIds": [
              "EZK.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya zomi na minei ya sanza ya liboso, bokosala feti ya Pasika oyo ekosala mikolo sambo. Na mikolo wana, bokolia mapa ezanga levire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo yango, mokambi akopesa ngombe ya mobali lokola mbeka ya masumu mpo na ye moko mpe mpo na bato nyonso ya mokili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo nyonso sambo ya feti, mokonzi akopesa bangombe ya mibali sambo mpe bameme ya mibali sambo, oyo ezanga mbeba, lokola mbeka ya kotumba mpo na Yawe, mpe ntaba moko ya mobali lokola mbeka ya masumu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na ngombe moko na moko ya mobali, akobonza yango elongo na likabo ya bakilo zomi na mitano ya bambuma mpe likabo ya balitele misato na ndambo ya mafuta ; mpe mpo na meme moko na moko ya mobali, akobonza yango elongo na likabo ya bakilo zomi na mitano ya bambuma mpe likabo ya balitele misato na ndambo ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo nyonso sambo ya feti oyo ebandaka na mokolo ya zomi na mitano ya sanza ya sambo, akobanda kobonza bambeka kaka wana : bambeka ya masumu, ya kotumba, ya bambuma mpe ya mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.25",
            "verseOrgIds": [
              "EZK.45.25"
            ]
          }
        }
      ]
    }
  ],
