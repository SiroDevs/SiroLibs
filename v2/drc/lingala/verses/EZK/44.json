        },
        {
          "text": "Bakolia makabo ya bambuma, bambeka ya masumu mpe bambeka ya kozongisa boyokani ; biloko nyonso oyo, kati na Isalaele, ebulisama mpo na Yawe ekozala ya bango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
