            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe bakoki kolia te ndeke to nyama oyo ekufi yango moko to oyo nyama mosusu esili koboma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
