      "attrs": {
        "style": "li2",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "mondelo na yango ekolekela na nzela ya Etiloni kino na Lebo-Amati, Atsari-Enani mpe mondelo ya nor ya mokili ya Damasi pembeni ya Amati ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
