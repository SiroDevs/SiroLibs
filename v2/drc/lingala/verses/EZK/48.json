            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eteni ya mabele ya Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni ya mabele oyo bakopesa Yawe lokola likabo ya motuya ekozala na mondelo ya etuka ya Yuda :",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZK 48:8"
      },
      "items": [
        {
          "text": "longwa na ngambo ya este kino na ngambo ya weste ; ekozala na bametele pene nkoto zomi na mibale na nkama mitano na mokuse, mpe molayi na yango ekozala ndenge moko na biteni ya mabele ya mabota mosusu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZK 48:8"
      },
      "items": [
        {
          "text": "Boye, Esika ya bule ekozala na kati-kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni ya mabele ya motuya oyo bokopesa Yawe lokola likabo ekozala na bametele pene nkoto zomi na mibale na nkama mitano na molayi mpe bametele pene nkoto mitano na mokuse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni yango ya mabele ekozala bule mpe ekopesama mpo na Banganga-Nzambe : ekozala na bametele pene nkoto zomi na mibale na nkama mitano na molayi na ngambo ya nor, bametele pene nkoto mitano na mokuse na ngambo ya weste, bametele pene nkoto mitano na mokuse na ngambo ya este mpe bametele pene nkoto zomi na mibale na nkama mitano na molayi na ngambo ya sude. Esika ya bule ya Yawe ekozala na kati-kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni yango ya mabele ekozala mpo na Banganga-Nzambe oyo babulisama, oyo bazali bakitani ya Tsadoki, mpo ete basalelaki Ngai na boyengebene mpe bapengwaki te na nzela na Ngai tango bana ya Isalaele bapengwaki ndenge mpe Balevi basalaki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala mpo na bango lokola likabo ya motuya oyo ewuti na eteni ya mabele oyo ebulisama kati na mokili, eteni ya mabele oyo eleki na bule na bandelo ya etuka ya Balevi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na zingazinga ya etuka ya Banganga-Nzambe, Balevi bakozwa eteni moko ya mabele ya bametele pene nkoto zomi na mibale na nkama mitano na molayi mpe bametele pene nkoto mitano na mokuse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoki te koteka to kopesa eloko moko kati na eteni ya mabele yango na bato mosusu, pamba te yango ezali mabele oyo eleki kitoko, mpo ete ebulisama mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni ya mabele oyo ekotikala, eteni ya bametele pene nkoto mibale na nkama mitano na mokuse mpe bametele pene nkoto zomi na mibale na nkama mitano na molayi, ekozala ebulisama te ; ekozala mpo na kosala misala ya engumba lokola kotonga bandako mpe kobokola bibwele ; engumba ekozala na kati-kati na yango",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe ekozala na molayi ya bametele pene nkoto mibale na nkama mibale na tuku mitano, na bangambo nyonso : nor, sude, este mpe weste.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, lopango ya kobokolela bibwele ya engumba ekozala na bametele pene nkama moko na tuku mibale na mitano, na bangambo nyonso : nor, sude, este mpe weste.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni ya mabele oyo ekotikala na etuka, zingazinga ya eteni ya bule, longwa na molayi na yango, ekozala na bametele pene nkoto mitano na ngambo ya este mpe bametele pene nkoto mitano na ngambo ya weste. Bambuma ya mabele na yango ekoleisa bato oyo bakosala mpo na engumba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basali oyo bakobanda kowuta na engumba epai wapi basalaka mpo na kosala mosala ya bilanga bakobimela na mabota nyonso ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteni nyonso ya mabele oyo bakobulisa mpo na Yawe ekozala na molayi moko, na bangambo nyonso : bametele pene nkoto zomi na mibale na nkama mitano ndenge likabo ya motuya ezalaka ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
