      "attrs": {
        "style": "li2",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "boye mondelo na yango ekobanda longwa na ngambo ya este kino na ngambo ya weste.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
