              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye Faraon elongo na mampinga na ye nyonso bakomona bango mpe bakobondisama na tina na bato nyonso oyo bakufaki na mopanga, elobi Nkolo Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
