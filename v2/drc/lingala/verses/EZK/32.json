    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "boye bakoyeba solo ete Ngai, nazali Yawe. ›",
          "type": "text",
          "attrs": {
