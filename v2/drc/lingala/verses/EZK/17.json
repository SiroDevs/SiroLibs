        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisese ya bampongo mpe nzete ya vino",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Mwana na moto, bongisa sambole moko mpe loba yango lokola lisese epai ya libota ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango : ‹ Tala liloba oyo Nkolo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:3"
      },
      "items": [
        {
          "text": "Mpongo moko ya monene",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:3"
      },
      "items": [
        {
          "text": "oyo ezalaki na mapapu milayi soki efungwami,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:3"
      },
      "items": [
        {
          "text": "na basala ebele ya balangi ya ndenge na ndenge,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:3"
      },
      "items": [
        {
          "text": "ekendeki kotelema na Libani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:3"
      },
      "items": [
        {
          "text": "Tango etutaki songe ya nzete moko ya sedele,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebukaki etape moko ya moke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.4",
            "verseOrgIds": [
              "EZK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:4"
      },
      "items": [
        {
          "text": "oyo ezalaki na songe ya nzete yango",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.4",
            "verseOrgIds": [
              "EZK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:4"
      },
      "items": [
        {
          "text": "mpe ememaki yango na mokili ya bato ya mombongo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.4",
            "verseOrgIds": [
              "EZK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:4"
      },
      "items": [
        {
          "text": "epai wapi elonaki yango kati na engumba ya bateki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.4",
            "verseOrgIds": [
              "EZK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekamataki ndambo ya milona ya mokili wana,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.5",
            "verseOrgIds": [
              "EZK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:5"
      },
      "items": [
        {
          "text": "ekendeki kolona yango na mabele ya malamu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.5",
            "verseOrgIds": [
              "EZK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:5"
      },
      "items": [
        {
          "text": "lokola nzete oyo elingaka esika ya mayi, pene ya mayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.5",
            "verseOrgIds": [
              "EZK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkona yango ekolaki mpe ekomaki nzete ya vino ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "ezalaki penza mokuse,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "kasi bitape na yango ezalaki efungwama",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "mpe etala na ngambo ya mpongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "Bongo misisa na yango ezalaki kaka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "etikala na se na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "Ekomaki nzete ya vino,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:6"
      },
      "items": [
        {
          "text": "ebotaki bitape mpe ebimisaki makasa ebele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezalaki lisusu na mpongo mosusu ya monene",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "oyo ezalaki na mapapu ya milayi mpe basala ebele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "Nzokande, nzete ya vino wana ebimisaki",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "misisa na yango na ngambo ya mpongo wana,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "longwa na esika oyo balonelaki yango",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "mpe epanzaki bitape na yango kino epai na mpongo wana,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:7"
      },
      "items": [
        {
          "text": "mpo na kosopela yango mayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balonaki yango na mabele ya malamu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.8",
            "verseOrgIds": [
              "EZK.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:8"
      },
      "items": [
        {
          "text": "lokola nzete oyo elingaka esika ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.8",
            "verseOrgIds": [
              "EZK.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:8"
      },
      "items": [
        {
          "text": "pene ya mayi ebele mpo ete ebota bitape mpe bambuma,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.8",
            "verseOrgIds": [
              "EZK.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:8"
      },
      "items": [
        {
          "text": "mpe ekoma nzete monene ya vino. ›",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.8",
            "verseOrgIds": [
              "EZK.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndimbola ya lisese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango : ‹ Tala liloba oyo Nkolo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "Boni, ekokoma solo monene ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "Boni, mpongo ya liboso ekopikola yango te",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "mpo ete ezanga kobota mbuma mpe ekawuka ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "Makasa na yango nyonso ya sika ekokawuka ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "ekoluka na yango makasi mingi te",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:9"
      },
      "items": [
        {
          "text": "mpe bato ebele te mpo na kopikola yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata soki bakei kolona yango esika mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:10"
      },
      "items": [
        {
          "text": "okanisi ete ekokola ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 17:10"
      },
      "items": [
        {
          "text": "Ekokawuka nyonso tango mopepe ya este",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:10"
      },
      "items": [
        {
          "text": "ekoya kobeta yango ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 17:10"
      },
      "items": [
        {
          "text": "solo ekokawuka ata na esika oyo ezalaki kokola malamu. › »",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Loba na ndako ya batomboki oyo : ‹ Boni, bozali solo koyeba soki makambo oyo elakisi nini ? › Loba na bango : ‹ Mokonzi ya Babiloni ayaki na Yelusalemi, akangaki mokonzi elongo na bakalaka na yango mpe amemaki bango na mokili na ye, elingi koloba na Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamataki moko kati na libota ya bokonzi, asalaki boyokani elongo na ye mpe alapisaki ye ndayi ; mpe amemaki lisusu bankumu ya mokili",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete bokonzi ekweya, ekoka lisusu kotelema te mpe ewumela kobika kaka na kobatela mibeko ya boyokani na ye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi atombokelaki mokonzi ya Babiloni mpe atindaki bantoma na ye, na Ejipito mpo ete bapesa ye bampunda mpe basoda ebele. Akolonga solo ? Moto oyo azali kosala makambo ya boye akobika solo ? Boni, abuka solo boyokani mpe abika ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Kombo na Ngai, elobi Nkolo Yawe, akokufa kati na Babiloni, kati mokili ya mokonzi oyo atiaki ye na bokonzi ; pamba te atosaki te ndayi oyo alapaki liboso na ye mpe abukaki boyokani oyo asalaki elongo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraon elongo na ebele ya basoda na ye ya mpiko mpe basoda na ye mosusu ebele bakokoka kosunga ye te na tango ya bitumba ; tango bato ya Babiloni bakotonga bamir ya zelo mpo na kobatamela mpe bakotimola mabulu mpo na koboma bato ebele.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.17",
            "verseOrgIds": [
              "EZK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atosaki te ndayi oyo alapaki mpe abukaki boyokani. Lokola atombolaki loboko na ye na ndayi mpe asali makambo ya boye, akobika te !",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, tala liloba oyo Nkolo Yawe alobi : Na Kombo na Ngai, nakomemisa ye ngambo ya ndayi na Ngai, oyo atioli mpe ya boyokani na Ngai, oyo abuki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakotiela ye motambo na Ngai, mpe akokangama na motambo na Ngai ; nakomema ye na Babiloni mpe nakosambisa ye kuna, pamba te atambolaki na boyengebene te liboso na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basoda na ye nyonso ya mpiko bakokufa na mopanga mpe bato oyo bakotikala na bomoi bakopanzana bisika nyonso. Na bongo, bokoyeba solo ete ezali Ngai Yawe nde nalobaki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Nkolo Yawe alobi : Ngai moko nakokamata etape ya songe ya nzete ya sedele mpe nakolona yango ; nakobuka na songe ya etape yango moto ya nzete moko, oyo nakolona na likolo ya ngomba oyo eleki molayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakolona yango na likolo ya ngomba ya Isalaele oyo eleki molayi ; ekopanza bitape na yango mpe ekobota bambuma, ekokoma nzete ya sedele moko ya kitoko ; bandeke ya ndenge na ndenge ekotonga bazala na yango kuna mpe ekopema na se ya pio ya bitape na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.23",
            "verseOrgIds": [
              "EZK.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banzete nyonso ya zamba ekoyeba solo ete Ngai Yawe nde nakweyisaka nzete ya molayi mpe nakomisaka nzete ya mokuse molayi, nakawusaka nzete ya mobesu mpe nakomisaka nzete ya kokawuka nzete ya mobesu. Ngai Yawe nde nalobi mpe nakosala oyo nalobi. › »",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
        }
      ]
    }
  ],
