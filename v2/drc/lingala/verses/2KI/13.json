              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaeli, mokonzi ya Siri, akufaki, mpe Beni-Adadi, mwana na ye ya mobali, akitanaki na ye na bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
              "2KI.13.24"
            ]
          }
        },
