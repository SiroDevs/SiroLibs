              "text": "2Ma 34.29-32",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Joziasi abengisaki bampaka nyonso ya Yuda mpe ya Yelusalemi epai na ye,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe akendeki na Tempelo ya Yawe elongo na bato nyonso ya Yuda, bavandi nyonso ya Yelusalemi, Banganga-Nzambe mpe basakoli, bato nyonso, kobanda na oyo aleki na se kino na oyo aleki na lokumu. Mokonzi atangelaki bango makomi nyonso ya buku ya Boyokani oyo emonanaki kati na Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi atelemaki na etemelo ya kolobela, asalaki boyokani oyo liboso ya Yawe : « Nalapi ndayi ete nakolanda Yawe, nakotosa mibeko, mitindo mpe malako na Ye, na motema mpe na elimo na ngai mobimba ; mpe nakotosa maloba ya boyokani, oyo ekomama kati na buku oyo. » Bato nyonso bandimaki kotosa boyokani yango.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joziasi abongisi lolenge ya kosambela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.34.3-2CH.34.7"
          },
          "items": [
            {
              "text": "2Ma 34.3-7",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.34.33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apesaki mitindo epai ya Ilikia, mokonzi ya Banganga-Nzambe, epai ya Banganga-Nzambe oyo balandi mpe epai ya bakengeli bikuke ya Tempelo ya Yawe, mpo ete balongola kati na Tempelo ya Yawe, biloko nyonso oyo esalema mpo na Bala, mpo na nzambe mwasi Ashera, mpe mpo na mampinga nyonso ya likolo. Mokonzi atumbaki yango libanda ya Yelusalemi, kati na bilanga ya lubwaku ya Sedron, mpe amemaki putulu na yango na Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi alongolaki banganga-nzambe ya bapaya oyo bakonzi ya Yuda batiaki mpo na kotumba ansa na bisambelo ya likolo ya bangomba ya bingumba ya Yuda mpe ya zingazinga ya Yelusalemi : bango nde bazalaki kotumba ansa mpo na Bala, mpo na moyi, mpo na sanza, mpo na minzoto mpe mpo na mampinga nyonso ya likolo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alongolaki kati na Tempelo ya Yawe likonzi ya nzambe mwasi Ashera, mpe amemaki yango na lubwaku ya Sedron, libanda ya Yelusalemi, epai wapi batumbaki yango. Akomisaki yango putulu mpe asopaki yango na kunda epai wapi bakundaka bato ebele na libulu moko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi abukaki kati na Tempelo ya Yawe, bandako ya mibali oyo bazalaki komipesa na kindumba ya bule, bandako epai wapi basi bazalaki kotonga banzambala mpo na nzambe mwasi Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joziasi abengisaki Banganga-Nzambe nyonso ya bingumba ya Yuda mpe bapanzaki bisambelo ya likolo ya bangomba oyo ezalaki longwa na Geba kino na Beri-Sheba epai wapi banganga-nzambe wana bazalaki kotumba ansa. Abukaki mpe bisika ya bule oyo batonga pene ya bikuke ya bingumba : oyo ezalaki na ebandeli ya ekuke ya Jozue, moyangeli ya engumba, mpe oyo ezalaki na ngambo ya loboko ya mwasi ya ekuke ya engumba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atako banganga-nzambe ya bisambelo ya likolo ya bangomba bakokaki te kosala mosala na etumbelo ya Yawe kati na Yelusalemi, kasi bazalaki kolia mapa ezanga levire elongo na Banganga-Nzambe mosusu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apanzaki etumbelo ya Tofeti, oyo ezalaki na Lubwaku ya Beni-Inomi mpo ete moto moko te asalela yango lisusu mpo na kotumba mwana na ye ya mobali to ya mwasi lokola mbeka epai ya Moloki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alongolaki, wuta na ekuke kino na Tempelo ya Yawe, bampunda oyo bakonzi ya Yuda babonzaki na nzambe Moyi, oyo ezalaki na lopango pembeni ya shambre ya Netani-Meleki, soda oyo baboma mokongo. Mokonzi atumbaki bashar oyo bazalaki kosalela losambo ya nzambe Moyi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi abukaki bitumbelo oyo bakonzi ya Yuda batongaki na likolo ya shambre ya likolo ya Akazi, mpe bitumbelo oyo Manase atongisaki kati na mapango mibale ya Tempelo ya Yawe. Alongolaki yango wana, abukaki yango na biteni, mpe abwakaki yango na lubwaku ya Sedron.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apanzaki mpe bisambelo ya likolo ya bangomba oyo ezalaki na este ya Yelusalemi, na ngambo ya loboko ya mobali ya ngomba ya Libebi, oyo Salomo, mokonzi ya Isalaele, atongaki mpo na Asitarite, nzambe mwasi ya makambo mabe ya bato ya Sidoni ; mpo na Kemoshi, nzambe ya makambo mabe ya bato ya Moabi ; mpe mpo na Moloki, nzambe ya makambo mabe ya bato ya Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joziasi abukaki mabanga ya bule, akweyisaki makonzi ya Ashera, mpe atondisaki esika yango na mikuwa ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joziasi abongisi losambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joziasi abukaki mpe etumbelo oyo ezalaki na Beteli mpe esambelo ya likolo ya ngomba oyo Jeroboami, mwana mobali ya Nebati, atongaki mpo na kopengwisa bana ya Isalaele. Abukaki etumbelo yango mpe akomisaki yango putulu. Bongo atumbaki mpe likonzi ya Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Joziasi atalaki na zingazinga, amonaki bakunda oyo ezalaki na likolo ya ngomba ; boye akundolaki mikuwa oyo ezalaki kuna mpe atumbaki yango na likolo ya etumbelo. Na nzela yango, abebisaki lokumu ya etumbelo yango kolanda Liloba na Yawe, oyo moto na Nzambe asakolaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi atunaki :",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "— Kunda oyo nazali komona ezali ya nani ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "Bato ya engumba bazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "— Ezali kunda ya moto na Nzambe oyo awutaki na Yuda mpe asakolaki makambo oyo owuti kosala na etumbelo ya Beteli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2KI 23:18"
      },
      "items": [
        {
          "text": "— Botika yango, moto moko te asimba mikuwa na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:18"
      },
      "items": [
        {
          "text": "Boye batikaki mikuwa na ye mpe mikuwa ya mosakoli oyo awutaki na Samari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge asalaki na Beteli, Joziasi abukaki bisika nyonso ya bule ya bisambelo ya likolo ya bangomba oyo bakonzi ya Isalaele batongaki kati na bingumba ya Samari, oyo na tina na yango Yawe asilikaki makasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joziasi abomaki banganga-nzambe nyonso ya bisambelo ya likolo ya bangomba oyo bazalaki kuna, abonzaki bango lokola mbeka na likolo ya bitumbelo na bango moko mpe atumbaki mikuwa ya bato na likolo ya bitumbelo yango. Bongo azongaki na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Feti ya Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.35.1"
          },
          "items": [
            {
              "text": "2Ma 35.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.35.18-2CH.35.19"
          },
          "items": [
            {
              "text": "18-19",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apesaki mitindo epai ya bato nyonso : « Bosala feti ya Pasika mpo na Yawe, Nzambe na bino, kolanda ndenge ekomama kati na buku ya Boyokani. »",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Feti ya Pasika ya lolenge wana etikalaki nanu kosalema te wuta na tango oyo bilombe bakambaki Isalaele to na tango nyonso ya bakonzi ya Isalaele mpe ya bakonzi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tango Joziasi akokisaki mibu zomi na mwambe na bokonzi, basalaki lisusu feti ya Pasika mpo na Yawe, na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joziasi abomaki mpe bato oyo basololaka na milimo ya bakufi, bamoni makambo, bikilakila, banzambe ya bikeko, mpe biloko nyonso oyo ezalaki kati na mokili ya Yuda mpe ya Yelusalemi. Asalaki bongo mpo na kokokisa mitindo oyo ekomama kati na buku oyo Nganga-Nzambe Ilikia amonaki kati na Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi moko te azongelaki Yawe lokola Joziasi, na motema na ye mobimba, na molimo na ye mobimba mpe na makasi na ye nyonso, kolanda mibeko nyonso ya Moyize. Mpe sima na ye, mokonzi moko te azalaki lokola ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Yawe atikaki te kanda makasi na Ye, oyo apeliselaki Yuda likolo ya mabe nyonso oyo Manase asalaki mpo na kopesa Ye kanda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Yawe alobaki : « Nakobengana mpe Yuda na miso na Ngai ndenge nabenganaki Isalaele ; nakobwaka Yelusalemi, engumba oyo napona, elongo na Tempelo na yango, oyo na tina na yango nalobaki : ‹ Kombo na Ngai ekozala kuna. › »",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Suka ya Joziasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
