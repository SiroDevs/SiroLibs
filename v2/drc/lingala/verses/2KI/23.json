    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeoyakimi azalaki na mibu tuku mibale na mitano ya mbotama tango akomaki mokonzi, mpe akonzaki mibu zomi na moko na Yelusalemi. Kombo ya mama na ye ezalaki « Zebuda. » Zebuda azalaki mwana ya Pedaya, moto ya Ruma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeoyakimi asalaki makambo mabe na miso ya Yawe ndenge kaka bakoko na ye basalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
      ]
    }
