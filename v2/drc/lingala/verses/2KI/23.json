              "text": "2Ma 35.20–36.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo mosusu oyo etali bokonzi ya Joziasi mpe misala na ye nyonso, ekomama kati na buku ya masolo ya bakonzi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Joziasi azalaki mokonzi, Faraon Neko, mokonzi ya Ejipito, akendeki na ebale Efrate mpo na kosunga mokonzi ya Asiri. Mokonzi Joziasi akendeki kokutana na ye mpo na kokanga ye nzela, kasi Neko abundisaki ye mpe abomaki ye, na Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basoda ya Joziasi bamemaki ebembe na ye na likolo ya shar, longwa na Megido kino na Yelusalemi epai wapi bakundaki ye kati na kunda na ye moko. Bato ya mokili bazwaki Yoakazi, mwana mobali ya Joziasi, bapakolaki ye mafuta mpe bakomisaki ye mokonzi mpo na kokitana na tata na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoakazi, mokonzi ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.36.2-2CH.36.4"
          },
          "items": [
            {
              "text": "2Ma 36.2-4",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoakazi azalaki na mibu tuku mibale na misato ya mbotama tango akomaki mokonzi, mpe akonzaki basanza misato na Yelusalemi. Kombo ya mama na ye ezalaki « Amutali. » Amutali azalaki mwana ya Jeremi, moto ya Libina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoakazi asalaki makambo mabe na miso ya Yawe ndenge bakoko na ye basalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraon Neko atiaki ye na boloko mpe akangaki ye minyololo, na Ribila, kati na mokili ya Amati, mpo ete akonza lisusu te na Yelusalemi. Faraon Neko afutisaki na makasi mokili ya Yuda mpako ya nkoto misato nkama minei ya bakilo ya palata mpe bakilo tuku misato na minei ya wolo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraon Neko akomisaki Eliakimi, mwana mobali ya Joziasi, mokonzi mpo na kokitana na Joziasi, tata na ye ; abongolaki kombo na ye mpe akomisaki yango « Yeoyakimi. » Kasi akangaki Yoakazi mpe amemaki ye na Ejipito. Mpe Yoakazi akufaki kuna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeoyakimi afutaki epai ya Faraon Neko palata mpe wolo oyo asengaki. Mpo na kofuta yango, Yeoyakimi asengaki ete bato ya mokili bafuta mpako. Afutisaki bato mpako ya palata to ya wolo kolanda bozwi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
