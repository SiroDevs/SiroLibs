            "sid": "JER 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Masumu ya Yuda ezali lokola makomi",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "oyo bakoma na ekomeli ya ebende",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "oyo ezali na songe ya diama ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "bakoma yango na bitando ya mitema na bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "mpe na maseke ya bitumbelo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge bakanisaka bana na bango ya mibali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "ndenge wana mpe bakanisaka bitumbelo na bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "mpe makonzi ya Ashera, nzambe mwasi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "pembeni ya banzete ya mibesu",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "na likolo ya bangomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh ngomba na Ngai kati na mokili,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "nakokaba lokola bomengo ya bitumba :",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "biloko na yo, bozwi na yo nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "mpe bisambelo na yo ya likolo ya bangomba",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "mpo na masumu oyo osalaki kati na mokili na yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo ya mabe na yo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "okobungisa libula oyo napesaki yo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "nakokomisa yo mowumbu ya banguna na yo",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "kati na mokili oyo oyebi te ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "pamba te opelisi kanda na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "mpe ekopela mpo na libela. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "« Tika ete moto oyo atiaka elikya na moto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "oyo ayekamelaka eloko ya pete",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "mpe atalelaka Yawe te,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "alakelama mabe !",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akozala lokola mwa nzete ekawuka kati na esobe ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "akomona bolamu te tango ekoya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "akovanda na bisika ya kokawuka ya esobe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "na mokili ya mungwa epai wapi bato bazalaka te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tika ete moto oyo atiaka elikya na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:7"
      },
      "items": [
        {
          "text": "mpe atalelaka Ye apambolama !",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akozala lokola nzete oyo balona pembeni ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "oyo epanzaka misisa na yango kino na mayi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "ezalaka na somo ya moyi makasi te ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "makasa na yango ezalaka kaka mibesu tango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "Ezalaka na somo ya koya ya mobu ya bokawuki te",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "mpe ebotaka mbuma tango nyonso. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema eleki biloko nyonso na lokuta",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:9"
      },
      "items": [
        {
          "text": "mpe ekoki kobika te ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:9"
      },
      "items": [
        {
          "text": "nani akoki koyeba yango ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
