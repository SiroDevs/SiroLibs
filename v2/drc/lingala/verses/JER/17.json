          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ngai Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.10",
            "verseOrgIds": [
              "JER.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:10"
      },
      "items": [
        {
          "text": "nayebi motema mpe nasosolaka malamu",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.10",
            "verseOrgIds": [
              "JER.17.10"
            ]
          }
        }
      ]
    },
