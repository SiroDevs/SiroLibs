  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JER 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lobiko ya bana ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobaki na nzela ya Jeremi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala liloba oyo Yawe, Nzambe ya Isalaele, alobi : ‹ Koma kati na buku makambo nyonso oyo nayebisaki yo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango ezali koya, › elobi Yawe, ‹ tango oyo nakokangola bato na Ngai, Isalaele, mpe Yuda kati na bowumbu ; mpe nakozongisa bango na mokili oyo napesaki epai ya bakoko na bango mpo ete bakamata yango, › elobi Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobaki na tina na Isalaele mpe Yuda :",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala liloba oyo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "‹ Koganga ya kobanga mpe ya somo",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "nde ezali koyokana ; kimia ezali lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botuna mpe botala :",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Boni, mobali akoki kobota bana ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Bongo mpo na nini nazali komona",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "moto nyonso ya makasi asimbi libumu na ye",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "lokola mwasi oyo azali na pasi ya kobota",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "mpe elongi na ye ekomi mawa-mawa ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa ! Ekozala penza mokolo ya somo !",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Mokolo moko te ekokokana na yango !",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Ekozala tango ya pasi mpo na Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "kasi akobikisama na pasi yango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "elobi Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "‹ nakobuka ekangiseli na bakingo na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "nakokata basinga oyo bakangelaki bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "mpe bakozala lisusu te bawumbu ya bapaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, bakosalela Yawe, Nzambe na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "mpe Davidi, mokonzi oyo nakotia",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "mpo ete akamba bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Jakobi, mosali na Ngai, kobanga te !",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "Oh Isalaele, kozala na somo te, ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "‹ Solo, nakobikisa yo wuta na mokili ya mosika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "mpe bakitani na yo, wuta na mokili ya bowumbu !",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "Jakobi akozwa lisusu kimia mpe bopemi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "mpe moto moko te akobangisa ye lisusu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali elongo na yo mpe nakobikisa yo, ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "elobi Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "‹ Ata nakobebisa nye bikolo nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "epai wapi napanzaki bino ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "kasi bino, nakobebisa bino nye te ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "solo, nakopesa bino etumbu, kasi ekozala na ndenge ya bosembo ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "nakozanga te kopamela bino. ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:12"
      },
      "items": [
        {
          "text": "‹ Pota na yo ekobika te",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
