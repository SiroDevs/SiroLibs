      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:33"
      },
      "items": [
        {
          "text": "moto oyo akotiela yango motema",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
            ]
          }
        }
