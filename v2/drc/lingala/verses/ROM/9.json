      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:28"
      },
      "items": [
        {
          "text": "na mobimba na yango",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
