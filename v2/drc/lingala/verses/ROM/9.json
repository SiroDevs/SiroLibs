      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "ezalaki lokola zelo ya ebale monene,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "ndambo kaka nde bakobika.",
          "type": "text",
          "attrs": {
