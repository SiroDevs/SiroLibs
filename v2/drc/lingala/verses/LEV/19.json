          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokosalela lokuta te tango bokomeka molayi, bakilo mpe tango bokoluka koyeba ebele oyo ekoki kozala na kati.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokosalela bimekelo ya malamu, bakilo ya malamu, efa ya malamu ; Ngai nazali Yawe, Nzambe na bino, oyo abimisaki bino na Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
