              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokotelema liboso ya bato oyo banuni, bokolakisa botosi na bino epai ya mibange ; na nzela wana, bokokumisa Nzambe na bino. Nazali Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
