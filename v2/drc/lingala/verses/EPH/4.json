          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolimwisaka kati na bino bololo ya mitema, koyinana, kanda, koswana, mafinga mpe lolenge nyonso ya misala mabe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
