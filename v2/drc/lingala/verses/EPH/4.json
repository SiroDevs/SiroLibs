          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyokisaka Molimo Mosantu ya Nzambe mawa te ; pamba te, na nzela ya Molimo yango, Nzambe abetaki bino kashe na Ye mpo na mokolo ya kokangolama.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        }
