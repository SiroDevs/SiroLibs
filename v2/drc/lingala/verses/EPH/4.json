          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botalisanaka boboto, boyokelanaka mawa mpe bolimbisanaka ndenge Nzambe alimbisaki bino kati na Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
