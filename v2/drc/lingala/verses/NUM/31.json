          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndambo oyo epesamelaki bana ya Isalaele, Moyize alongolaki moto moko kati na bato tuku mitano mpe nyama moko kati na banyama tuku mitano, ndenge Yawe atindaki ye mpe apesaki yango epai ya Balevi oyo bazalaki na mokumba ya kobatela Mongombo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
