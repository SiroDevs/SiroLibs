          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, bakonzi ya mampinga, bakonzi ya bankoto ya basoda mpe ya bankama bayaki epai ya Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
