              "type": "text"
            }
          ]
        },
        {
          "text": "ndambo oyo epesamelaki lisanga ezalaki : meme elongo na bantaba nkoto nkama misato na tuku misato na sambo na nkama mitano ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
