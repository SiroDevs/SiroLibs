          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize mpe Nganga-Nzambe Eleazari bazwaki na maboko na bango, biloko nyonso oyo basala na wolo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wolo nyonso oyo Moyize mpe Nganga-Nzambe Eleazari bazwaki lokola makabo mpo na Yawe, na maboko ya bakonzi ya bankoto mpe ya bankama, ezalaki bakilo nkama moko na tuku mwambe na minei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soda na soda akamataki na makasi mpo na ye moko bomengo na ye ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize mpe Nganga-Nzambe Eleazari bazwaki wolo na maboko ya bakonzi ya nkoto ya basoda mpe ya nkama ya basoda mpe bamemaki yango kati na Ndako ya kapo ya Bokutani lokola ekaniseli mpo na bana ya Isalaele liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
            "verseOrgIds": [
              "NUM.31.54"
            ]
          }
        }
      ]
