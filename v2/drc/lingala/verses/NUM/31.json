          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobaki na Moyize : « Basali na yo batangi motango ya basoda oyo bazali na se ya bokonzi na biso mpe ata moko te azangi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, tomemi epai na Yawe lokola makabo, biloko ya wolo oyo : biloko oyo balataka na maboko, bapete, bamedayi, biloko ya matoyi, basheneti oyo moko na moko na biso azwaki mpo na kosala mosala ya bolimbisi masumu liboso ya Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
