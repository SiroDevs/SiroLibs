              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, ndambo oyo epesamelaki bana ya Isalaele, oyo Moyize alongolaki na bomengo ya bato oyo bakendeki na bitumba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
