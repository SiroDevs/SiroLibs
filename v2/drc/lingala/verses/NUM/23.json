  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "NUM 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balami apamboli Isalaele mpo na mbala ya liboso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami alobaki na Balaki : « Tongela ngai bitumbelo sambo awa mpe bongisela ngai bangombe ya mibali mpe bameme ya mibali sambo. »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki asalaki ndenge Balami alobaki, mpe bango mibale babonzaki bangombe ya mibali mpe bameme ya mibali wana na etumbelo moko na moko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na Balaki : « Telema awa, pembeni ya mbeka na yo, bongo ngai napusani mwa mosika. Tango mosusu Yawe akoya kokutana na ngai, bongo nakoyebisa yo makambo nyonso oyo akolakisa ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 23:3"
      },
      "items": [
        {
          "text": "Balami akendeki likolo ya ngomba moko ya mokuse mpe ezanga matiti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe akutanaki na Balami, mpe Balami alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:4"
      },
      "items": [
        {
          "text": "— Nabongisaki bitumbelo sambo ; mpe na etumbelo moko na moko, nasili kobonza ngombe ya mobali mpe meme ya mobali moko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atiaki maloba na monoko ya Balami mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:5"
      },
      "items": [
        {
          "text": "— Zonga epai ya Balaki mpe yebisa ye maloba oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Balami azongaki epai ya Balaki mpe akutaki ye atelemi pembeni ya mbeka na ye, elongo na bakambi nyonso ya Moabi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Balami akomaki koloba maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:7"
      },
      "items": [
        {
          "text": "« Balaki abengisaki ngai wuta na Arami,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:7"
      },
      "items": [
        {
          "text": "mokonzi ya Moabi abengisaki ngai",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:7"
      },
      "items": [
        {
          "text": "wuta na bangomba ya este.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:7"
      },
      "items": [
        {
          "text": "Alobaki : ‹ Yaka, lakela Jakobi mabe mpo na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:7"
      },
      "items": [
        {
          "text": "yaka, loba mabe mpo na Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge nini nakoki solo kolakela mabe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.8",
            "verseOrgIds": [
              "NUM.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:8"
      },
      "items": [
        {
          "text": "bato oyo Nzambe alakela mabe te ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.8",
            "verseOrgIds": [
              "NUM.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:8"
      },
      "items": [
        {
          "text": "Ndenge nini nakoki solo koloba mabe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.8",
            "verseOrgIds": [
              "NUM.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:8"
      },
      "items": [
        {
          "text": "mpo na bato oyo Yawe alobela mabe te ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.8",
            "verseOrgIds": [
              "NUM.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, wuta na likolo ya mabanga,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:9"
      },
      "items": [
        {
          "text": "nazali komona bango ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:9"
      },
      "items": [
        {
          "text": "wuta na likolo ya bangomba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:9"
      },
      "items": [
        {
          "text": "nazali kotala bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:9"
      },
      "items": [
        {
          "text": "Tala, nazali komona bato moko bavanda bango moko,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:9"
      },
      "items": [
        {
          "text": "bazali komitanga na molongo ya bikolo te.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akoki kotanga putulu ya Jakobi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:10"
      },
      "items": [
        {
          "text": "to kotanga motango ya bakitani ya Isalaele ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:10"
      },
      "items": [
        {
          "text": "Tika ete nakufa kufa ya bato ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:10"
      },
      "items": [
        {
          "text": "mpe tika ete suka na ngai ezala lokola ya bango ! › »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki alobaki na Balami :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:11"
      },
      "items": [
        {
          "text": "— Likambo nini osali ngai ? Nabengisaki yo mpo ete olakela banguna na ngai mabe ; kasi tala, opamboli bango koleka.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:12"
      },
      "items": [
        {
          "text": "— Boni, naloba te maloba oyo Yawe atie na monoko na ngai ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balami apamboli Isalaele mpo na mbala ya mibale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki alobaki na Balami :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:13"
      },
      "items": [
        {
          "text": "— Yaka elongo na ngai esika mosusu, epai okoki komona bango ; okomona bango nyonso te, kasi kaka ndambo. Mpe wuta na esika yango, lakela bango mabe mpo na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Balaki amemaki Balami na elanga ya Tsofimi, na songe ya ngomba Pisiga, mpe atongaki kuna bitumbelo sambo mpe abonzaki bangombe ya mibali mpe bameme ya mibali wana na etumbelo moko na moko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami alobaki na Balaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:15"
      },
      "items": [
        {
          "text": "— Telema awa, pembeni ya mbeka na yo, wana ngai nakopusana mwa mosika mpo na kokutana na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akutanaki na Balami, atiaki maloba na monoko na ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:16"
      },
      "items": [
        {
          "text": "— Zonga epai ya Balaki mpe yebisa ye maloba oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, Balami azongaki epai ya Balaki mpe akutaki ye atelemi pembeni ya mbeka na ye, elongo na bakambi nyonso ya Moabi. Balaki atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:17"
      },
      "items": [
        {
          "text": "— Yawe alobi nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Balami akomaki koloba maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:18"
      },
      "items": [
        {
          "text": "« Balaki, telema mpe yoka !",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:18"
      },
      "items": [
        {
          "text": "Mwana mobali ya Tsipori, yoka ngai malamu !",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azali moto te mpo ete akosa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "azali mpe mwana ya moto te mpo ete akoka kobongola makanisi na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "Boni, akoki solo koloba mpe kosala eloko moko te ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "Akoki solo kopesa elaka mpe kokokisa yango te ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazwaki nde mokumba ya kopambola.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.20",
            "verseOrgIds": [
              "NUM.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:20"
      },
      "items": [
        {
          "text": "Asila kopambola, mpe ngai nakokoka kobongola te.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.20",
            "verseOrgIds": [
              "NUM.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amonaka mbeba moko te epai ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:21"
      },
      "items": [
        {
          "text": "amonaka minyoko te kati na Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:21"
      },
      "items": [
        {
          "text": "Yawe, Nzambe na bango, azali elongo na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:21"
      },
      "items": [
        {
          "text": "koganga ya mokonzi ezalaka kati na bango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe abimisaki bango na Ejipito ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.22",
            "verseOrgIds": [
              "NUM.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:22"
      },
      "items": [
        {
          "text": "bazalaka makasi lokola mpakasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.22",
            "verseOrgIds": [
              "NUM.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elakeli mabe moko te ekoki kozwa Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.23",
            "verseOrgIds": [
              "NUM.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:23"
      },
      "items": [
        {
          "text": "mpe kindoki ezali na nguya te likolo ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.23",
            "verseOrgIds": [
              "NUM.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:23"
      },
      "items": [
        {
          "text": "Bakoloba sik'oyo mpo na Jakobi mpe Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.23",
            "verseOrgIds": [
              "NUM.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:23"
      },
      "items": [
        {
          "text": "‹ Tala makambo oyo Nzambe asali ! ›",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.23",
            "verseOrgIds": [
              "NUM.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batelemi lokola nkosi ya mwasi ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:24"
      },
      "items": [
        {
          "text": "epemaka te soki epasoli te mosuni na yango",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:24"
      },
      "items": [
        {
          "text": "mpe emeli te makila ya nyama oyo ekangi. »",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Balaki alobaki na Balami :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:25"
      },
      "items": [
        {
          "text": "— Ezala soki okoki te kolakela bango mabe, kasi kopambola bango te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami azongiselaki Balaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:26"
      },
      "items": [
        {
          "text": "— Nayebisaki yo te ete nakosala kaka makambo oyo Yawe akoloba na ngai ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balami apamboli Isalaele mpo na mbala ya misato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki alobaki na Balami :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:27"
      },
      "items": [
        {
          "text": "— Yaka, tika ete namema yo esika mosusu ! Tango mosusu Nzambe akosepela ete olakela bango mabe mpo na ngai wuta na esika yango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki amemaki Balami na likolo ya ngomba Peori, esika oyo emonisaka esobe mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.28",
            "verseOrgIds": [
              "NUM.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami alobaki na Balaki :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "NUM 23:29"
      },
      "items": [
        {
          "text": "— Tongela ngai bitumbelo sambo mpe bongisela ngai bangombe ya mibali mpe bameme ya mibali sambo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki asalaki ndenge Balami alobaki, mpe abonzaki ngombe moko ya mobali mpe meme moko ya mobali na etumbelo moko na moko.",
          "type": "text"
        }
      ]
    }
