    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:12"
      },
      "items": [
        {
          "text": "Yoanani, mwana mobali ya Akatani, elongo na bato na ye nkama moko na zomi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
