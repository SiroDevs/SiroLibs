    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:11"
      },
      "items": [
        {
          "text": "Zakari, mwana mobali ya Bebayi, elongo na bato na ye tuku mibale na mwambe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        }
