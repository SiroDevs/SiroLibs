    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:10"
      },
      "items": [
        {
          "text": "Shelomiti, mwana mobali ya Yosifia, elongo na bato na ye nkama moko na tuku motoba.",
