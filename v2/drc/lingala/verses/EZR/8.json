      "attrs": {
        "style": "li2",
        "vid": "EZR 8:9"
      },
      "items": [
        {
          "text": "Abidiasi, mwana mobali ya Yeyeli, elongo na bato na ye nkama mibale na zomi na mwambe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
