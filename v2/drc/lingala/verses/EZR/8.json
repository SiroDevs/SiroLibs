            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bakitani ya Adonikami :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:13"
      },
      "items": [
        {
          "text": "bana ya suka oyo bakombo na bango ezalaki Elifeleti, Yeyeli mpe Shemaya, elongo na bato na bango tuku motoba.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bakitani ya Bigivayi :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:14"
      },
      "items": [
        {
          "text": "Utayi mpe Zabudi elongo na bato na bango tuku sambo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esidrasi azongi na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasangisaki bango pene ya ebale oyo ezalaki kotiola na ngambo ya Akava, mpe tovandaki kuna mikolo misato. Tango natalaki malamu bato mpe Banganga-Nzambe, namonaki ata Molevi moko te kuna.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye nabengisaki Eliezeri, Arieli, Shemaya, Elinatani, Yaribi, Elinatani, Natan, Zakari mpe Meshulami oyo bazalaki bakambi ; Yoyaribi mpe Elinatani oyo bazalaki bato ya mayele.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natindaki bango epai ya Ido, mokambi ya mboka Kasifia ; nayebisaki bango makambo oyo basengeli koloba na Ido mpe bandeko na ye ya mosala, basali ya Tempelo, oyo bazalaki kovanda na Kasifia, mpo ete bamemela biso basali mpo na Ndako ya Nzambe na biso.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola loboko ya ngolu ya Nzambe na biso ezalaki likolo na biso, bamemelaki biso Sherebia, moto ya mayele, kati na bakitani ya Maali, mwana mobali ya Levi, mwana mobali ya Isalaele, elongo na bana na ye ya mibali mpe bandeko na ye ya mibali, bango nyonso zomi na mwambe,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na Ashabia mpe Ezayi, bakitani ya Merari, elongo na bandeko na ye ya mibali mpe bana na bango ya mibali. Bango nyonso bazalaki tuku mibale.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamemaki lisusu basali ya Tempelo, nkama mibale na tuku mibale, bakitani ya bato oyo Davidi mpe lisanga ya bakalaka na ye batiaki mpo na kosunga Balevi. Batangaki bango nyonso na bakombo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esidrasi akati mokolo ya kokila bilei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna, pene ya ebale Akava, napesaki mitindo ya kokila bilei mpo na komikitisa liboso ya Nzambe na biso mpe kosenga Ye mobembo malamu mpo na biso, mpo na bana na biso mpe mpo na biloko na biso nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayokaki soni mpo na kosenga epai ya mokonzi basoda mpe basoda oyo batambolaka likolo ya bampunda, mpo na kobatela biso na nzela liboso ya banguna na biso ; pamba te tolobaki na mokonzi : « Loboko ya ngolu ya Nzambe na biso ezali likolo ya moto nyonso oyo alukaka Ye, kasi kanda makasi na Ye ekitelaka bato nyonso oyo basundolaka Ye. »",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, tokilaki bilei mpe tosengaki ngolu yango epai ya Nzambe na biso, mpe Ye ayanolaki libondeli na biso.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Banganga-Nzambe bayambi biloko ya kotongela Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo na sima, natiaki kati na bakonzi ya Banganga-Nzambe bakonzi zomi na mibale : Sherebia, Ashabia elongo na bandeko na bango zomi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namekaki liboso na bango makabo ya palata, ya wolo mpe bisalelo nyonso oyo mokonzi, bapesi toli na ye, bakalaka na ye mpe Isalaele mobimba bapesaki mpo na Ndako ya Nzambe na biso.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesaki bango kilo nkoto tuku mibale ya palata, kilo nkoto misato ya bisalelo basala na palata, kilo nkoto misato ya wolo,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakopo ya wolo tuku mibale oyo ezali na motuya ya mbongo ya bibende ya wolo nkoto moko mpe biloko mibale ya kitoko basala na bronze oyo engalaka lokola wolo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki na bango : « Bino elongo na biloko oyo, bobulisami mpo na Yawe. Palata mpe wolo oyo ezali makabo oyo bato bakati bango moko kopesa wuta na mokano ya mitema na bango, epai na Yawe, Nzambe ya tata na bino.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosenzela mpe bobatela yango malamu kino tango bokomeka kilo na yango liboso ya bakonzi ya Banganga-Nzambe, ya Balevi mpe ya bakambi ya mabota ya Isalaele, kati na bashambre ya Tempelo ya Yawe, na Yelusalemi. »",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe mpe Balevi bayambaki palata, wolo mpe bisalelo ya bule oyo bamekaki kilo na yango, mpo na komema yango na Ndako ya Nzambe na biso, na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokomi na Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya zomi na mibale ya sanza ya liboso, tolongwaki na ebale Akava mpo na kokende na Yelusalemi. Loboko ya Nzambe na biso ezalaki likolo na biso, mpe abatelaki biso na nzela liboso ya banguna mpe ya bato ya mobulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokomaki na Yelusalemi mpe topemaki kuna mikolo misato.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya minei, tomekaki kilo ya palata, ya wolo mpe bisalelo ya bule kati na Ndako ya Nzambe na biso, liboso ya kopesa yango na maboko ya Nganga-Nzambe Meremoti, mwana mobali ya Uri ; azalaki elongo na Eleazari, mwana mobali ya Pineasi, mpe Balevi Yozabadi, mwana mobali ya Jozue, mpe Noadia, mwana mobali ya Binuwi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batangaki mpe bamekaki kilo ya biloko nyonso ; mpe bakomaki yango na buku kaka na tango wana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bakendeki na bowumbu bazongaki wuta na bowumbu mpe babonzaki mpo na Isalaele mobimba lokola mbeka ya kotumba epai ya Nzambe ya Isalaele : bangombe ya mibali zomi na mibale, bameme ya mibali tuku libwa na motoba, bana meme tuku sambo na sambo, mpe bantaba zomi na mibale lokola mbeka ya masumu. Babonzaki nyonso lokola mbeka ya kotumba mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batindaki lisusu sango ya mitindo ya mokonzi epai ya bayangeli oyo mokonzi atiaki na bituka mpe epai ya bayangeli ya etuka ya ngambo ya weste ya ebale Efrate, oyo basungaki bato mpe Tempelo ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
      ]
    }
  ],
