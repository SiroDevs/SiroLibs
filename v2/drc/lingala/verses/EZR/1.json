        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokano ya mokonzi Sirisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mobu ya liboso ya Sirisi, mokonzi ya Persi, Yawe alamusaki molimo ya Sirisi, mokonzi ya Persi, mpo na kokokisa liloba oyo alobaki na nzela ya mosakoli Jeremi, mpo ete asakola mpe akoma boye kati na mokili na ye mobimba :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala makambo oyo Sirisi, mokonzi ya Persi, alobi :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 1:2"
      },
      "items": [
        {
          "text": "‹ Yawe, Nzambe ya Likolo, apesi ngai babokonzi nyonso ya mabele mpe mokumba ya kotongela Ye Tempelo, na Yelusalemi kati na Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto nyonso oyo, kati na bino, azali na molongo ya bato ya Yawe akende na Yelusalemi kati na Yuda mpo na kotonga Tempelo ya Yawe, Nzambe ya Isalaele, oyo azali Nzambe kati na Yelusalemi !",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bavandi ya bisika nyonso oyo bato ya Yuda bazali bapesa bango, mpo na Ndako ya Nzambe oyo ezali na Yelusalemi, makabo oyo : palata, wolo, bibwele, biloko ya ndenge na ndenge mpe makabo oyo bakati bango moko kopesa wuta na mokano ya mitema na bango. › »",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo bakambi ya mabota ya Yuda mpe ya Benjame, Banganga-Nzambe mpe Balevi, elongo na moto nyonso oyo Nzambe atutaki motema babongamaki mpo na kokende kotonga Tempelo ya Yawe, na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso oyo bazalaki zingazinga na bango basungaki bango ; bapesaki biloko esalema na palata mpe na wolo, bibwele, biloko ya ndenge na ndenge, bakado ya talo mpe makabo oyo bakataki bango moko kopesa wuta na mokano ya mitema na bango.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Sirisi abimisaki biloko ya Tempelo ya Yawe, oyo Nabukodonozori amemaki wuta na Yelusalemi mpo na kotia yango kati na tempelo ya nzambe na ye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirisi, mokonzi ya Persi, atindaki Mitredati, mobombi bozwi na ye, ete abimisa, atanga mpe apesa yango epai ya Sheshibatsari, moto ya libota ya bakambi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala biloko yango mpe motango na yango :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZR 1:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 1:9"
      },
      "items": [
        {
          "text": "bakopo ya wolo ezalaki tuku misato ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 1:9"
      },
      "items": [
        {
          "text": "bakopo ya palata ezalaki nkoto moko ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 1:9"
      },
      "items": [
        {
          "text": "basani ya mbele ya palata ezalaki tuku mibale na libwa ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "basani ya wolo ezalaki tuku misato ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 1:10"
      },
      "items": [
        {
          "text": "basani minene ya palata ezalaki nkama minei na zomi ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 1:10"
      },
      "items": [
        {
          "text": "biloko mosusu ezalaki nkoto moko.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motango ya biloko nyonso ya wolo mpe ya palata ezalaki nkoto mitano na nkama minei.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZR 1:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZR 1:11"
      },
      "items": [
        {
          "text": "Sheshibatsari amemaki biloko yango nyonso tango bato oyo bakendeki na bowumbu balongwaki na Babiloni mpo na kozonga na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
  ],
