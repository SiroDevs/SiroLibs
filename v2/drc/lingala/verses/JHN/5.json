          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi boboyi na bino koya epai na Ngai mpo na kozwa bomoi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.40",
                "verseOrgIds": [
