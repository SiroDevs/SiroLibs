        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : tango ezali koya mpe esili kokoka oyo bakufi bakoyoka mongongo ya Mwana na Nzambe, mpe ba-oyo bakoyoka yango bakozala na bomoi ;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.25",
                "verseOrgIds": [
                  "JHN.5.25"
                ]
