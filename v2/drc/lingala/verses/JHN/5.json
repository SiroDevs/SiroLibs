        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : moto oyo azali koyoka maloba na Ngai mpe azali kondima Ye oyo atindaki Ngai, azali na bomoi ya seko mpe akosambisama te, kasi asili kolongwa na kufa mpe akomi na bomoi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.24",
                "verseOrgIds": [
                  "JHN.5.24"
                ]
