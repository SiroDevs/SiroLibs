        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye esengeli ete motatoli mosusu apesa yango mpo na Ngai ; mpe nayebi ete litatoli oyo akopesa na tina na Ngai ezali ya solo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.32",
                "verseOrgIds": [
