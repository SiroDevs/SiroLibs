          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ye moko, Tata, oyo atindaki Ngai atatolaki mpo na Ngai. Botikala nanu te koyoka mongongo na Ye mpe komona elongi na Ye ;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
                "verseOrgIds": [
                  "JHN.5.37"
                ]
              }
            }
