        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzokande Ngai, nazali na litatoli moko ya monene na tina na Ngai moko koleka kutu oyo ya Yoane : misala oyo nazali kosala na Kombo ya Tata etatolaka na tina na Ngai ete ezali Tata nde atindaki Ngai.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.36",
                "verseOrgIds": [
