              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kutu nayebi bino malamu, nayebi ete, kati na mitema na bino, bozali na bolingo te mpo na Nzambe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.42",
                "verseOrgIds": [
                  "JHN.5.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngai, nayei na Kombo ya Tata na Ngai, kasi boboyi koyamba Ngai ! Nzokande, soki moto mosusu ayei na kombo na ye moko, bokoyamba ye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
                "verseOrgIds": [
                  "JHN.5.43"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lokola bolukaka kaka kopesana lokumu bino na bino mpe boboyaka lokumu oyo ewutaka kaka na Nzambe, ndenge nini bokoki kondima Ngai ?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
                "verseOrgIds": [
                  "JHN.5.44"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokanisa te ete Ngai nde nakofunda bino liboso ya Tata na Ngai, ezali Moyize oyo bondimaka nde akofunda bino.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.45",
                "verseOrgIds": [
                  "JHN.5.45"
                ]
