              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokundolaka Makomi na bokebi, mpo ete bokanisaka ete bokozwa bomoi ya seko kati na yango ; nzokande, Makomi yango etatolaka na tina na Ngai,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.39",
                "verseOrgIds": [
                  "JHN.5.39"
                ]
              }
            }
