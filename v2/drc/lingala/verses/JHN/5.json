        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nakoki kosala eloko moko te na ndenge na Ngai moko : nakataka makambo kolanda oyo nayokaka kowuta epai na Tata, mpe kosambisa na Ngai ezali sembo ; pamba te nalukaka te kosala mokano na Ngai moko, kasi mokano ya Ye oyo atindaki Ngai.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
                "verseOrgIds": [
                  "JHN.5.30"
                ]
              }
            }
