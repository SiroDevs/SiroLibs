        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nalukaka na Ngai te lokumu oyo ewutaka na bato.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.41",
                "verseOrgIds": [
                  "JHN.5.41"
                ]
              }
            }
          ]
        },
