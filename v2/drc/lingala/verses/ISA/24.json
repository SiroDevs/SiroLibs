  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "ISA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Masakoli na tina na mbongwana oyo ekoya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yawe akobebisa mokili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, Yawe akobebisa mokili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "mpe akokomisa yango lokola esobe ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "akokotisa mobulu kati na yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "mpe akopanza bato na yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala mpe kaka ndenge moko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na Banganga-Nzambe mpe bato,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na nkolo mpe mowumbu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na nkolo ya mwasi mpe mwasi mosali na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na moteki mpe mosombi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na modefisi mpe modefi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpo na moto oyo bakofuta ye niongo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "mpe mpo na moto oyo akofuta niongo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili ekobebisama penza nye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "text": "mpe bakopanza yango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "text": "Yawe nde alobaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili ezali na matanga mpe ekawuki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "mokili mobimba ebebi mpe ekawuki ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "ezala likolo mpe ebebi elongo na mokili !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya mokili bakomisi yango mbindo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "bazali kotosa mibeko te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "banyati-nyati bikateli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "mpe babuki boyokani ya seko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, bilakeli mabe ezali kozikisa mokili ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "bato na yango bakomema mokumba ya mabe na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "Yango wana, bato ya mokili bazali kokufa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "mpe ndambo moke kaka nde etikali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vino ya sika ezali na matanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:7"
      },
      "items": [
        {
          "text": "elanga ya vino ekawuki ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:7"
      },
      "items": [
        {
          "text": "bato nyonso oyo bamesana na esengo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:7"
      },
      "items": [
        {
          "text": "bakomi kolela na pasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo ya mbonda esili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "makelele ya bato ya biyenga esili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "esengo ya lindanda esili ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "komela vino etikali lisusu na banzembo te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:9"
      },
      "items": [
        {
          "text": "masanga ya makasi ekomi bololo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:9"
      },
      "items": [
        {
          "text": "mpo na bato oyo bamelaka yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engumba oyo ebeba etikali pamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:10"
      },
      "items": [
        {
          "text": "bikuke ya bandako nyonso ekangami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na babalabala, koganga na koganga ete vino ezali lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "kosepela nyonso ebongwani molili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "esengo nyonso elongwe na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libebi kaka nde etikali kati na engumba,",
