      "attrs": {
        "style": "q2",
        "vid": "ISA 42:23"
      },
      "items": [
        {
          "text": "Nani akozala na bokebi na makambo oyo ekoya ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
