    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etumbu ya Yuda mpe ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "akomi pene ya kobotola masungi nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "kati na Yelusalemi mpe kati na Yuda :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "lisungi ya bilei mpe lisungi ya mayi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bilombe mpe basoda ya mpiko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "basambisi mpe basakoli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "bato oyo balobaka makambo oyo ekoya mpe bakambi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakonzi ya basoda mpe bato ya lokumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:3"
      },
      "items": [
        {
          "text": "bapesi toli, bato mayele ya misala ya maboko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:3"
      },
      "items": [
        {
          "text": "mpe bato oyo basalelaka maji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosala ete bilenge mibali bakoma bakonzi na bango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:4"
      },
      "items": [
        {
          "text": "mpe bana mike bakamba bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bakokoma konyokolana bango na bango :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "moko akonyokola mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "mpe moninga akonyokola moninga na ye mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "bilenge bakotosa mikolo te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "bato pamba bakotelemela bato ya lokumu ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "moko akokanga ndeko na ye ya mobali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "kati na ndako ya tata na bango mpe akoloba :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "« Yo oyo ozali na kazaka, okozala mokonzi na biso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "kamata mokumba ya libebi oyo na maboko ! »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi na mokolo wana, akoganga :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "« Te, nazali na ngai monganga te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "mpe nazali na bilei to bilamba te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "kati na ndako na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "bokomisa ngai mokonzi te ! »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelusalemi ezali kotepatepa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "mpe Yuda ekweyi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "mpo ete maloba mpe misala na bango ezali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "ya botomboki liboso ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "ezali kotelemela lokumu ya Kombo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilongi na bango ezali kofunda bango ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "bazali kolakisa masumu na bango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "ndenge bato ya Sodome bazalaki kosala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "bazali kobomba yango te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "Mawa na bango, pamba te bamilukeli nde makambo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na moto ya sembo : « Bolamu ekobila yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:10"
      },
      "items": [
        {
          "text": "pamba te okosepela na mbuma ya misala na yo. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na moto mabe !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "Pasi ezali likolo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "pamba te akozwa lifuti kolanda misala na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilenge bazali konyokola bato na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
            "verseOrgIds": [
              "ISA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:12"
      },
      "items": [
        {
          "text": "basi bazali koyangela bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.12",
