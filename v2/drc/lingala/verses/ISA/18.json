        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya kosambisa Etiopi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na mokili oyo ezali na bamasuwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:1"
      },
      "items": [
        {
          "text": "oyo ezalaka na bavwale lokola mabanki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:1"
      },
      "items": [
        {
          "text": "bongo enanaka na ebale ya Kushi !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na yo oyo otindaka bantoma na nzela ya ebale",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "kati na bamasuwa oyo basala na papirisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "na likolo ya ebale monene !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "Bino bapanzi sango ya mbangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "bokende epai ya bato ya ekolo oyo bazalaka milayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "mpe baposo ya nzoto na bango engengaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "epai ya bato ya ekolo oyo babangisaka na mosika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "bato ya makasi oyo banyataka banguna na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:2"
      },
      "items": [
        {
          "text": "mpe oyo bibale eleka kati na mokili na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino nyonso, bavandi ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "bino oyo botondisi mabele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "tango bakotombola bendele na likolo ya bangomba, bokomona ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:3"
      },
      "items": [
        {
          "text": "tango bakobeta kelelo, bokoyoka !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, tala liloba oyo Yawe alobi na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "« Nakovanda kimia mpe nakotala wuta na ndako na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:4"
      },
      "items": [
        {
          "text": "lokola kongala ya moyi to lokola mapata na tango ya molunge. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete liboso ya kobuka bambuma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "tango bafololo ya mike etikaka kobima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "mpe ekomaka bambuma mibesu oyo ekomi pene ya kotela,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "bakataka bitape na likwangola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "babwakaka mpe batiaka pembeni bitape.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakosundola yango epai ya bandeke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "oyo eliaka misuni na likolo ya bangomba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "mpe epai ya banyama ya zamba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "Bandeke minene ekolia yango na tango ya molunge",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "mpe banyama ya zamba ekolia yango na tango ya malili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango wana, bakomema bakado epai na Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "wuta epai ya ekolo ya bato milayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "oyo poso ya nzoto na bango engengaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "wuta epai ya ekolo ya bato oyo babangisaka na mosika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "bato ya makasi oyo banyataka banguna na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "mpe oyo bibale eleka kati na mokili na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "bakomema bakado yango na ngomba Siona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "esika oyo Kombo ya Yawe, Mokonzi ya mampinga, ezalaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    }
