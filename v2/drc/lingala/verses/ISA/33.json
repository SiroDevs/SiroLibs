      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:18"
      },
      "items": [
        {
          "text": "Wapi moto oyo amekaka bakilo ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        }
      ]
    },
