  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ISA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bazalaki kotambola kati na molili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:1"
      },
      "items": [
        {
          "text": "bamoni pole makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:1"
      },
      "items": [
        {
          "text": "ba-oyo bazalaki kovanda kati na mokili ya bakufi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:1"
      },
      "items": [
        {
          "text": "pole engengeli bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomisaki bango ekolo monene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "obakisaki esengo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "Bazali kosepela liboso na Yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "ndenge basepelaka tango babukaka milona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "ndenge mibali basepelaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "tango bakabolaka bomengo ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ekangiseli oyo ezalaki na likolo na bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "nzete oyo ezalaki na mapeka na bango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "mpe fimbu oyo na nzela na yango bazalaki konyokola bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "Yo, obukaki yango lokola na mokolo ya kokweya ya Madiani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basapato nyonso ya basoda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "oyo lokito na yango eningisaka mabele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "mpe bilamba nyonso oyo etondaki na makila,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "ekobwakama na moto",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "mpo ete ezika makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te mwana mobali moko abotami mpo na biso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "mwana mobali moko apesameli biso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "mpe bokonzi ezali na likolo ya mapeka na ye ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "bakobenga ye : Mosungi ya kokamwa, Nzambe ya nguya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "Tata ya seko, Mokonzi ya kimia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokonzi na ye ekokende mosika penza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "mpe kimia na ye ekozala na suka te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Akovanda na kiti ya bokonzi ya Davidi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "akozala mokonzi ya mokili na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "akolendisa mpe akokamba yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "na bosembo mpe na boyengebene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "wuta na tango oyo kino libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Yango nde makambo oyo Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "akosala na bolingo makasi na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanda ya Yawe mpo na Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo atindaki liloba mpo na kotelemela Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "mpe liloba yango ekomeli Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso bakoyeba yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:8"
      },
      "items": [
        {
          "text": "Efrayimi mpe bavandi ya Samari,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:8"
      },
      "items": [
        {
          "text": "oyo balobaka na lofundu mpe na lolendo ya mitema :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ata babiliki ekweyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "tokotonga lisusu na mabanga bakata ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "ata bakati banzete ya sikomori,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "tokotia na esika na yango banzete ya sedele. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yawe alendisaki bayini ya Retsini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:10"
      },
