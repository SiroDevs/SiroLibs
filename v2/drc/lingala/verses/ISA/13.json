  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ISA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Masakoli na tina na bikolo ya bapaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya kosambisa Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba ya kosambisa Babiloni, oyo Ezayi, mwana mobali ya Amotsi, azwaki na emoniseli :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botombola bendele likolo ya ngomba oyo ezanga banzete,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "boganga epai na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "bopepa bango loboko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "mpo ete bakota na bikuke ya bakambi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napesaki mitindo epai na bato",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "oyo babulisama mpo na Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "nabengisaki lisusu bilombe na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "bato oyo basepelaka na lokumu na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "mpo na kosilisa kanda na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka makelele likolo ya bangomba :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "ezali lokola makelele ya bato ebele !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Boyoka lokito ya makelele ya bikolo :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "ezali lokola bikolo esangana esika moko !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Yawe, Mokonzi ya mampinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "azali kotala mampinga ya basoda oyo bazali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "pene ya kokende na etumba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawuti na mikili ya mosika, na suka ya likolo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "Yawe elongo na bisalelo ya kanda na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "mpo na kobebisa mokili mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolela, pamba te mokolo na Yawe ekomi pene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:6"
      },
      "items": [
        {
          "text": "ekoya lokola kobebisama oyo ewuti na Nkolo-Na-Nguya-Nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, maboko nyonso ekolemba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:7"
      },
      "items": [
        {
          "text": "mpe mitema ya bato nyonso ekobukana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Somo makasi ekokweyela bango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "pasi mpe kobanga ekotika bango te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "bakobunda-bunda lokola mwasi oyo azali na pasi ya kobota.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "Bango na bango bakotalana na kokamwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "mpe bilongi na bango ekokoma lokola moto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, mokolo na Yawe ezali koya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "ezali mokolo moko ya pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "mokolo ya kotomboka mpe ya kanda makasi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "mpo na kobebisa mokili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "mpe koboma bato ya masumu kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minzoto na likolo mpe minda nyonso oyo ezali pene na yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "ekopesa lisusu pole na yango te :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "moyi ekokoma molili tango tongo ekotana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "mpe sanza ekopesa lisusu pole na yango te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakopesa etumbu na mokili mpo na mabe na yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "mpe bato mabe, mpo na masumu na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "Nakosukisa lofundu ya bato ya lolendo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "mpe nakokitisa lolendo ya banyokoli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
