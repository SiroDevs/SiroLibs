        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano na Yobo epai ya Bilidadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.1",
            "verseOrgIds": [
              "JOB.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ah ! Tala ndenge osungi moto oyo azangi makasi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:2"
      },
      "items": [
        {
          "text": "ndenge osungi loboko oyo elembi !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.2",
            "verseOrgIds": [
              "JOB.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala toli oyo opesi na moto azangi bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:3"
      },
      "items": [
        {
          "text": "mpe tala ebele na mayele oyo olakisi !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.3",
            "verseOrgIds": [
              "JOB.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozwi maloba oyo wapi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:4"
      },
      "items": [
        {
          "text": "Molimo oyo elobi na monoko na yo ezali ya nani ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.4",
            "verseOrgIds": [
              "JOB.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakufi balengaka na se ya mayi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:5"
      },
      "items": [
        {
          "text": "mpe ya bikelamu oyo ezalaka kuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.5",
            "verseOrgIds": [
              "JOB.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liboso ya Nzambe, mboka ya bakufi ezali bolumbu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:6"
      },
      "items": [
        {
          "text": "mpe libulu ya molili ezali polele.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.6",
            "verseOrgIds": [
              "JOB.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atandaka likolo na esika oyo ezali na eloko moko te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:7"
      },
      "items": [
        {
          "text": "atelemisaka mabele na likolo ya eloko moko te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.7",
            "verseOrgIds": [
              "JOB.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akangaka mayi kati na mapata,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:8"
      },
      "items": [
        {
          "text": "kasi mapata epasukaka te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.8",
            "verseOrgIds": [
              "JOB.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "azipaka kiti ya bokonzi na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:9"
      },
      "items": [
        {
          "text": "atandaka mapata na likolo na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.9",
            "verseOrgIds": [
              "JOB.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akataka mondelo na likolo ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:10"
      },
      "items": [
        {
          "text": "na suka ya pole mpe na molili.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.10",
            "verseOrgIds": [
              "JOB.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makonzi ya Lola ezali kolenga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:11"
      },
      "items": [
        {
          "text": "mpe ezali kokamwa na pamela na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.11",
            "verseOrgIds": [
              "JOB.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nguya na Ye, apasoli ebale monene ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:12"
      },
      "items": [
        {
          "text": "mpe na mayele na Ye, abuki-buki Rakabe na biteni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.12",
            "verseOrgIds": [
              "JOB.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na pema na Ye, Likolo ekomaka kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:13"
      },
      "items": [
        {
          "text": "loboko na Ye etobolaka nyoka oyo ekimaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.13",
            "verseOrgIds": [
              "JOB.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki makambo wana ezali kaka ndambo moke",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "ya misala na Ye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "mpe mongongo na Ye ya se oyo toyokaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 26:14"
      },
      "items": [
        {
          "text": "nani akoki kososola bakake ya nguya na Ye ? »",
          "type": "text",
          "attrs": {
            "verseId": "JOB.26.14",
            "verseOrgIds": [
              "JOB.26.14"
            ]
          }
        }
      ]
    }
  ],
