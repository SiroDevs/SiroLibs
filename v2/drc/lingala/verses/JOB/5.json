  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganga na yo, soki olingi !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Nani akoyanola yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Okotombokela mosantu nini ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotomboka ebomaka moto oyo azangi mayele,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:2"
      },
      "items": [
        {
          "text": "zuwa ebomaka zoba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, namonaki zoba kozwa misisa ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:3"
      },
      "items": [
        {
          "text": "kasi, mbala moko, nalakelaki ndako na ye mabe :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "‹ Tika ete bana na ye ya mibali bazanga lisungi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "balonga te na kosambisama",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "mpe bazangela moto oyo akobundela bango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto oyo azali na nzala",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "asilisa mbuma ya elanga na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "akamata yango kino kati na basende ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "mpe tika ete moto ya lokoso asilisa bomengo na ye ! ›",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te pasi ewutaka na putulu te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:6"
      },
      "items": [
        {
          "text": "mpe minyoko ewutaka na mabele te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "moto abotamaka mpo na komona pasi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:7"
      },
      "items": [
        {
          "text": "ndenge kaka mikalikali ebimaka mpo na kopanzana na likolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi soki ezalaki ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "nalingaki komimonisa liboso ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "nalingaki kotalisa Ye likambo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe asalaka makambo minene",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "oyo bato bakokaka kososola te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "mpe bikamwa oyo bato bakokaka kotanga te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "anokisaka mvula na mokili,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:10"
      },
      "items": [
        {
          "text": "mpe atindaka mayi na bilanga ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "atombolaka bato oyo babwakama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:11"
      },
      "items": [
        {
          "text": "mpe apesaka esengo na bato oyo bazali kolela ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abebisaka mabongisi ya bato",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "oyo bazalaka na mayele mabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "mpe maboko na bango ekokisaka te mikano na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
