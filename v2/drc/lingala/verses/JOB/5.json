      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "na mopanga ya monoko na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "akangolaka moto akelela",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
