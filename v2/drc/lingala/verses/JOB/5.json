          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akangaka bato ya bwanya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "kati na mitambo ya mayele mabe na bango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "mpe abebisaka mabongisi ya bakosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molili eyelaka bango na moyi ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:14"
      },
      "items": [
        {
          "text": "na moyi makasi, batambolaka na kotepatepa lokola na butu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
