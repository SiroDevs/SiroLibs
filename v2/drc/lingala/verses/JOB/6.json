  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano ya Yobo epai ya Elifazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.1",
            "verseOrgIds": [
              "JOB.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ah ! Soki ezalaki na makoki ya komeka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "kilo ya mawa na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "mpe ya kotia pasi na ngai nyonso na emekelo kilo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakanisi ete elingaki koleka zelo ya bibale minene na kilo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:3"
      },
      "items": [
        {
          "text": "Yango wana, maloba na ngai ezali koleka ndelo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makonga ya Nkolo-Na-Nguya-Nyonso etoboli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "mpe molimo na ngai ezali komela ngenge na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "Nzambe atelemeli ngai na kanda na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, ane ya zamba elelaka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "soki ezali kolia matiti ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "Ngombe ya mobali elelaka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "soki ezali kolia bilei na yango ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, baliaka na mungwa te bilei oyo ezanga elengi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:6"
      },
      "items": [
        {
          "text": "Mayi oyo ezalaka kati na maki ezalaka elengi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo oyo nazalaki koboya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:7"
      },
      "items": [
        {
          "text": "yango nde ekomi bilei na ngai, atako ezali mabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ah ! Nani akoki kosala ete",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "bosenga na ngai ekokisama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "mpe ete Nzambe akokisela ngai",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "likambo oyo nazali kozela !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Nzambe aboma na Ye ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:9"
      },
      "items": [
        {
          "text": "asembola loboko na Ye mpo na kokata ngai moto !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na boye nde nakoki kozwa kobondisama mpe esengo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "kati na pasi na ngai, oyo eleki ndelo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "pamba te nawangani te maloba ya Ye oyo azali Mosantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makasi nini penza nazali na yango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "mpo ete nazala lisusu na elikya ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "Mpo na nini nawumela lisusu kotala",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "suka ya bomoi na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, nazali makasi lokola libanga ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:12"
      },
      "items": [
        {
          "text": "Nzoto na ngai ezali ya ebende ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazali na nguya ya komisunga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:13"
      },
      "items": [
        {
          "text": "awa natikali lisusu na makoki te ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo azali na pasi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:14"
      },
      "items": [
        {
          "text": "asengeli na mawa ya baninga na ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:14"
      },
      "items": [
        {
          "text": "ata soki atiki kotosa Nkolo-Na-Nguya-Nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tala, bandeko na ngai bakosi ngai lokola moluka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:15"
      },
      "items": [
        {
          "text": "lokola mayi ya moluka oyo ekawuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
