  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JOB 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano ya liboso ya Yobo epai ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe ayanolaki Yobo :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Boni, moto oyo atiaka tembe na Nkolo-Na-Nguya-Nyonso",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "akoki koteya Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "Tika ete oyo azali koswanisa Nzambe ayanola Ye ! »",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo azongiselaki Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala ngai, nazali se ekelamu ya pamba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "eyano nini nakoki kopesa Yo ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "Natie loboko na ngai na monoko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki mbala moko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "kasi nakoyanola lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "na mbala ya mibale, nakobakisa lisusu eloko te. »",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya mibale ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Yobo wuta na mopepe makasi :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Kanga mokaba na loketo na yo lokola elombe mobali ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "nakotuna yo mituna, mpe okoyanola ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olingi kotiola bosembo na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:8"
      },
      "items": [
        {
          "text": "Okani kokweyisa ngai mpo ete yo moko omilongisa ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozali na loboko lokola oyo ya Nzambe ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:9"
      },
      "items": [
        {
          "text": "Mongongo na yo ekoki konguluma makasi lokola oyo ya Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata nkembo mpe kongenga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:10"
      },
      "items": [
        {
          "text": "milatisa lokumu mpe monene !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sopa nguya ya kanda na yo likolo ya bato,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "tala bato nyonso ya lolendo liboso na yo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "mpe kitisa bango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bato nyonso ya lolendo, yokisa bango soni !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:12"
      },
      "items": [
        {
          "text": "Nyata-nyata bato mabe na esika oyo bazali.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunda bango nyonso kati na putulu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:13"
      },
      "items": [
        {
          "text": "zipa bilongi na bango na esika ya kobombama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, ngai moko nakopesa yo lokumu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:14"
      },
      "items": [
        {
          "text": "pamba te loboko na yo ya mobali ekoki mpo na kobikisa yo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ngubu : nakelaki yango ndenge nakelaki yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "kasi eliaka kaka matiti lokola ngombe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala makasi oyo ezali kati na loketo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:16"
      },
      "items": [
        {
          "text": "nguya oyo ezali kati na misuni ya libumu na yango !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekembisaka mokila na yango lokola nzete ya sedele ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:17"
      },
      "items": [
        {
          "text": "misisa ya mipende na yango elingama-lingama ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mikuwa na yango ezali lokola bibende ya bronze ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:18"
      },
      "items": [
        {
          "text": "mipanzi na yango ezali lokola biteni ya bibende.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.18",
            "verseOrgIds": [
              "JOB.40.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
