        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato nyonso ya Yuda baponaki Oziasi oyo azalaki na mibu zomi na motoba ya mbotama mpe bakomisaki ye mokonzi na esika ya Amatsia, tata na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na kufa ya tata na ye, Amatsia, Oziasi atongaki lisusu engumba Eyiloti mpe azongisaki yango na se ya bokonzi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziasi azalaki na mibu zomi na motoba ya mbotama tango akomaki mokonzi, mpe akonzaki mibu tuku mitano na mibale na Yelusalemi. Kombo ya mama na ye ezalaki « Yekolia. » Yekolia azalaki moto ya Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki makambo ya sembo na miso ya Yawe ndenge kaka Amatsia, tata na ye, asalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziasi akangamaki na Nzambe mikolo nyonso ya bomoi ya Zakari, pamba te azalaki kolakisa ye kotosa Nzambe. Na tango nyonso oyo Oziasi awumelaki kokangama na Yawe, Nzambe azalaki kolongisa ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akendeki kobundisa bato ya Filisitia mpe atobolaki madusu kati na bamir ya Gati, ya Yabine mpe ya Asidodi. Atongaki lisusu bingumba ebele kati na etuka ya Asidodi mpe kati na bituka mosusu ya bato ya Filisitia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe asungaki ye tango abundisaki bato ya Filisitia, ya Arabi oyo bazalaki kovanda na Guri-Bala, mpe tango abundisaki bato ya Maoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Amoni bafutaki mpako ya mokonzi epai ya Oziasi, mpe kombo na ye ekendeki sango kino na bandelo ya Ejipito, pamba te akomaki na nguya makasi koleka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziasi atongaki bandako milayi kati na Yelusalemi, na ekuke ya suka, na ekuke ya lubwaku mpe na suka ya mir ; mpe alendisaki yango makasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongaki lisusu bandako milayi kati na esobe mpe atimolaki mabulu ebele ya mayi mpo ete azalaki na bibwele ebele na se ya bangomba mpe na etando. Azalaki mpe na basali ebele oyo bazalaki kotimola mabele mpe kosala kati na bilanga na ye ya vino kati na bituka ya bangomba mpe na mabele oyo ebotaka malamu, pamba te azalaki kolinga mingi misala ya bilanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziasi azalaki na basoda oyo baselingwa mpo na bitumba ; mpe babongisamaki na masanga kolanda motango na bango ndenge Yeyeli, mokomi mikanda, mpe kalaka Maaseya, na bokambami ya Anania, moko kati na bakonzi ya bakalaka ya mokonzi, bazwaki bango na mosala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motango nyonso ya bakambi ya mabota, oyo bazalaki kokamba basoda ya mpiko, ezalaki nkoto mibale na nkama motoba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakonzi ya mabota bazalaki kokamba basoda nkoto nkama misato na sambo na nkama mitano oyo baselingwa mpo na bitumba mpe bazalaki basoda ya mpiko, mpo na kobundela mokonzi liboso ya banguna na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango nyonso ya bitumba, Oziasi azalaki kopesa banguba, makonga, bikoti ya bibende, bilamba ya bibende oyo ebatelaka tolo, matolotolo mpe bibambelo mabanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalisaki kati na Yelusalemi, epai ya bato ya mayele, bamashini mpo na kotia yango likolo ya bandako milayi mpe na suka ya bamir mpo na kobwaka makonga mpe mabanga minene. Kombo na ye ekendeki sango, pamba te asungamaki makasi kino kokoma moto na nguya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lolendo mpe mbeba ya Oziasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tango Oziasi akomaki na nguya, atondaki na lolendo oyo ememaki ye na kokweya. Atambolaki lisusu na bosembo te liboso ya Yawe, Nzambe na ye, kino kokota na Tempelo ya Yawe mpo na kotumba mbeka ya malasi na likolo ya etumbelo ya malasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganga-Nzambe Azaria alandaki Oziasi na sima, elongo na Banganga-Nzambe mosusu ya Yawe, tuku mwambe, bango nyonso batonda na mpiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batelemelaki mokonzi Oziasi mpe balobaki na ye : « Oziasi, kotumba mbeka ya malasi mpo na Yawe ezali mosala na yo te ! Ezali nde mosala ya Banganga-Nzambe, bakitani ya Aron, oyo babulisama mpo na mosala yango. Bima wuta na Esika ya bule, pamba te ozali kosala likambo ya nkele, mpe Yawe Nzambe akosepela na yo te ! »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Oziasi, oyo asimbaki mbabola na loboko na ye, atombokelaki Banganga-Nzambe. Kaka na tango yango, wana azalaki kati na Tempelo ya Yawe liboso ya etumbelo ya ansa, bokono ya maba ebimaki na elongi na ye na miso ya Banganga-Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Azaria, mokonzi ya Banganga-Nzambe, mpe Banganga-Nzambe mosusu batalaki ye mpe bamonaki ete akomi na bokono ya maba na elongi, babenganaki ye na lombangu wana ye moko mpe azalaki kobima na lombangu, pamba te Yawe asambwisaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.15.5-2KI.15.7"
          },
          "items": [
            {
              "text": "2Ba 15.5-7",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Oziasi abelaki bokono ya maba kino na mokolo na ye ya kufa. Lokola azalaki kobela bokono ya maba, akomaki kovanda na ndako moko batonga mosika, pamba te babenganaki ye mosika ya Tempelo ya Yawe. Yotami, mwana na ye ya mobali, mobateli biloko ya ndako ya mokonzi, ayangelaki bato ya mokili.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo mosusu oyo etali bokonzi ya Oziasi mpe misala na ye, kobanda na ebandeli kino na suka, ezali mosakoli Ezayi, mwana mobali ya Amotsi, nde akomaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziasi akendeki kokutana na bakoko na ye, mpe bakundaki ye esika moko na bango kati na lilita ya bakonzi, pamba te bato bazalaki koloba : « Abelaki bokono ya maba. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 26:23"
      },
      "items": [
        {
          "text": "Yotami, mwana na ye ya mobali, akitanaki na ye na bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        }
      ]
    }
  ],
