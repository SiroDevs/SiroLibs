        "style": "s1"
      },
      "items": [
        {
          "text": "Oziasi, mokonzi ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
