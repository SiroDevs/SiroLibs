              "text": "1Ba 10.1-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mwasi mokonzi ya Saba ayokaki sango ya lokumu ya Salomo, ayaki na Yelusalemi mpo na komeka ye na nzela ya mituna ya makasi ; ayaki elongo na bato ebele mpe bashamo oyo ememaki biloko ya mike-mike oyo epesaka solo kitoko, wolo ebele mpe mabanga ya talo. Tango akomaki epai ya Salomo, ayebisaki ye nyonso oyo azalaki na yango kati na motema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo apesaki ye biyano na mituna na ye nyonso ; ezalaki ata na motuna moko te oyo Salomo alongaki te kopesa eyano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mwasi mokonzi ya Saba amonaki bwanya ya Salomo, ndako oyo atongaki,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bilei oyo azalaki kolia na mesa na ye, ndako ya basali na ye, esaleli mpe elateli ya basali na ye, basali oyo bapesaka ye masanga mpe bambeka ya kotumba oyo azalaki kobonza kati na Tempelo ya Yawe, mwasi mokonzi ya Saba akamwaki makasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na mokonzi : « Makambo oyo nayokaki wuta na mokili na ngai na tina na misala mpe na bwanya na yo ezali ya solo !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandimaki te makambo oyo bazalaki koloba na tina na yango kino tango ngai moko nayei mpe namoni yango na miso na ngai moko. Nzokande, kolanda oyo ngai namoni, makambo oyo bayebisaki ngai te na tina na bwanya yango ezali penza kati-kati ! Solo, oleki sango ya lokumu oyo nayokaki na tina na yo !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na bato na yo, esengo na basali na yo, oyo batelemaka tango nyonso liboso na yo mpe bayokaka maloba na yo, oyo etonda na bwanya !",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe, Nzambe na yo, apambolama ; Ye oyo asepelaki na yo mpe atiaki yo na kiti na Ye ya bokonzi lokola mokonzi mpo na kosalela Yawe, Nzambe na yo ! Ezali mpo ete Nzambe na yo alingaka Isalaele mpe alingi ete ewumela mpo na libela nde atiaki yo lokola mokonzi na yango, mpo ete osala na bosolo mpe na bosembo. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi mokonzi ya Saba apesaki mokonzi Salomo bakilo nkoto misato na nkama mitano ya wolo, biloko ebele penza ya solo kitoko mpe mabanga ya talo. Etikala lisusu kozala te na biloko ebele ya solo kitoko lokola biloko oyo mwasi mokonzi ya Saba amemelaki mokonzi Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisusu, basali ya Irami mpe ya Salomo, oyo bamemaki wolo wuta na Ofiri bamemaki mpe mabaya ya santale mpe mabanga ya talo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi asalaki na mabaya wana ya santale makonzi ya Tempelo ya Yawe mpe ya ndako ya mokonzi, banzenze mpe mandanda mpo na bayembi. Batikalaki nanu komona nyonso wana te kati na mokili ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngambo na ye, mokonzi Salomo apesaki na mwasi mokonzi ya Saba biloko nyonso oyo azalaki na yango posa mpe oyo asengaki, koleka kutu biloko oyo amemelaki mokonzi. Sima na yango, mwasi mokonzi ya Saba azongaki elongo na basali na ye, na mokili na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lokumu mpe bozwi ya Salomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1KI.10.14-1KI.10.29"
          },
          "items": [
            {
              "text": "1Ba 10.14-29",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.1.14-2CH.1.17"
          },
          "items": [
            {
              "text": "2Ma 1.14-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobu na mobu, Salomo azalaki kozwa bakilo ya wolo nkoto tuku mibale,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbongo ya mpako ya bato ya mombongo oyo bazalaki koteka biloko oyo bazalaki kosomba na bamboka ya bapaya, mpe mbongo ya mpako ya bateki biloko ya ndenge na ndenge. Bakonzi nyonso ya Arabi mpe bayangeli ya bituka bazalaki komema wolo mpe palata epai ya Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Salomo asalisaki na wolo batuta banguba minene nkama mibale ; nguba moko na moko esengaki bakilo motoba ya wolo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalisaki lisusu na wolo batuta banguba mike nkama misato ; nguba moko na moko ya moke esengaki bakilo misato ya wolo. Mokonzi atiaki yango kati na ndako na ye, oyo bazalaki kobenga « ndako ya zamba ya Libani. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi asalaki na pembe ya nzoko kiti moko monene ya bokonzi mpe abambaki yango wolo ya peto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiti yango ya bokonzi ezalaki na ematelo ya binyatelo motoba, enyatelo makolo ya wolo ekanganaki na kiti. Na bangambo nyonso mibale, ezalaki na bisika ya kotia maboko, mpe bikeko mibale ya nkosi na pembeni ya bisika ya kotia maboko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikeko zomi na mibale ya nkosi ezalaki na likolo ya binyatelo motoba ya ematelo : enyatelo moko na moko ezalaki na bikeko mibale, ekeko moko na ngambo moko na moko. Kati na mikili nyonso, eloko ya ndenge wana etikala nanu kosalema te.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakopo nyonso ya mokonzi Salomo ezalaki ya wolo, mpe biloko nyonso ya ndako ya Zamba ya Libani ezalaki ya wolo ya peto. Pamba te, na tango oyo Salomo azalaki mokonzi, palata ezalaki na motuya ata te.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi azalaki na bamasuwa oyo ezalaki kokende na Tarsisi, elongo na basali ya Irami. Sima na mibu nyonso misato, bamasuwa ezalaki kozonga wuta na Tarsisi mpe ezalaki komema wolo, palata, pembe ya nzoko, bamakaku mpe bandeke oyo babengaka « Paoni. »",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Salomo alekaki bakonzi nyonso ya mokili na bozwi mpe na bwanya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakonzi nyonso ya mokili bazalaki koluka kokutana na Salomo mpo na koyoka bwanya oyo Nzambe atiaki kati na motema na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moko na moko azalaki komemela ye lokola kado biloko ya palata, biloko ya wolo, bilamba, bibundeli, biloko ya mike-mike ya solo kitoko, bampunda mpe bamile. Mpe ezalaki bongo mibu nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo azalaki na bashambre nkoto minei mpo na kobomba bampunda elongo na bashar, mpe batambolisi nkoto zomi na mibale mpo na bashar. Atiaki yango kati na bingumba ya bashar mpe epai na ye, Salomo, kati na Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki likolo ya bakonzi nyonso, longwa na Ebale (Efrate) kino na mokili ya bato ya Filisitia mpe na mondelo ya Ejipito.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi asalaki ete palata ekoma ebele kati na Yelusalemi lokola mabanga, mpe banzete ya sedele ekoma ebele lokola banzete ya sikomori oyo ezali kati na mokili ya lubwaku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
