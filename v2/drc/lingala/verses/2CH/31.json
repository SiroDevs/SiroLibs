        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezekiasi abongisi mosala ya Tempelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango feti nyonso esilaki, bato nyonso ya Isalaele oyo bazalaki kuna bakendeki na bingumba ya Yuda, babukaki makonzi ya bule, bakweyisaki bikeko ya nzambe mwasi Ashera mpe bapanzaki bisambelo ya likolo ya bangomba mpe bitumbelo kati na Yuda nyonso, kati na Benjame, kati na Efrayimi mpe kati na Manase. Sima na kobebisa biloko wana nyonso, bato ya Isalaele bazongaki kati na bingumba na bango mpe bandako na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezekiasi atiaki Banganga-Nzambe mpe Balevi na masanga mpe apesaki na moko na moko mosala kati na lisanga na ye. Banganga-Nzambe mpe Balevi bapesamelaki mosala ya bambeka ya kotumba mpe bambeka ya boyokani, mosala ya kozongisa matondi mpe ya koyemba banzembo mpo na kokumisa mpe kosanzola Yawe, na bikuke ya Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi azwaki ndambo ya bozwi na ye mpe apesaki mpo na bambeka ya kotumba : bambeka ya kotumba ya tongo mpe ya pokwa, ya mikolo ya Saba, ya ebandeli ya sanza mpe ya bafeti oyo ekatama, kolanda ndenge ekomama kati na mibeko ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi apesaki mitindo epai ya bavandi ya Yelusalemi ete bapesa ndambo oyo esengeli kopesama epai ya Banganga-Nzambe mpe Balevi mpo ete bamipesa na misala oyo mibeko ya Yawe ezali kotinda bango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango kaka bapanzaki sango ya mitindo oyo, bato ya Isalaele bapesaki na esengo bambuma na bango ya liboso ya ble, ya vino ya sika, ya mafuta, ya mafuta ya nzoyi mpe ya biloko nyonso oyo ebimaka na bilanga. Bamemaki lisusu biloko ebele lokola eteni ya zomi ya nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Isalaele elongo na bato ya Yuda oyo bazalaki kovanda kati na bingumba ya Yuda bamemaki eteni na bango ya zomi ya bangombe, ya bameme, ya bantaba mpe ya makabo ya bule oyo ebulisamaki mpo na Yawe, Nzambe na bango, mpe batiaki yango na mipiku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babandaki kosala mipiku yango na sanza ya misato mpe basilisaki na sanza ya sambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Ezekiasi elongo na bakalaka na ye bayaki komona mipiku yango, bakumisaki Yawe mpe bapambolaki Isalaele, bato na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezekiasi atunaki Banganga-Nzambe mpe Balevi na tina na mipiku yango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria, mokonzi ya Banganga-Nzambe, moto ya libota ya Tsadoki, azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "2CH 31:10"
      },
      "items": [
        {
          "text": "— Wuta tango bato babandaki komema makabo na bango kati na Tempelo ya Yawe, toliaki, totondaki mpe totiki ebele, pamba te Yawe apambolaki bato na Ye. Mipiku ya biloko oyo ozali komona awa ezali nde oyo etikali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezekiasi apesaki mitindo ete babongisa bisika mpo na kobomba biloko yango kati na Tempelo ya Yawe ; mpe esalemaki bongo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakomaki kotia kuna na boyengebene makabo ya bato, biteni ya zomi mpe makabo mosusu ya bule. Molevi Konania azalaki na mokumba ya kobatela biloko yango elongo na Shimei, ndeko na ye ya mobali, lokola molandi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolandisama na mokano ya mokonzi Ezekiasi mpe ya Azaria, mokonzi ya Banganga-Nzambe ya Tempelo ya Nzambe, Yeyeli, Azazia, Naati, Asaeli, Yerimoti, Yozabadi, Elieli, Yisimakia, Maati mpe Benaya bazalaki bakengeli ya misala na bokambami ya Konania mpe Shimei, ndeko na ye ya mobali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molevi Kore, mwana mobali ya Yimina, oyo azalaki mokengeli ekuke ya ngambo ya este azalaki na mokumba ya koyamba makabo oyo bato bazalaki kopesa epai ya Nzambe, wuta na mokano ya mitema na bango ; azalaki mpe na mokumba ya kokabola makabo oyo bazalaki kokongola mpo na Yawe mpe makabo ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bingumba ya Banganga-Nzambe, Kore asungamaki na Edeni, Minyamini, Jozue, Shemaya, Amaria mpe Shekania, mpo na kokabola biloko na boyengebene epai ya bandeko na bango Banganga-Nzambe kolanda masanga na bango ; bazalaki kosala bokeseni te kati na bato minene mpe bato mike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazalaki kopesa kaka te na mibali oyo bakombo na bango ekomamaki, kobanda na mibu misato ya mbotama mpe komata, kasi bazalaki mpe kopesa na bato nyonso oyo bazalaki kokota na Tempelo ya Yawe mpo na kosala misala na bango ya mokolo na mokolo kolanda mikumba mpe masanga na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapesaki na Banganga-Nzambe oyo bakombo na bango ekomamaki kolanda mabota na bango ya botata mpe na Balevi oyo bazalaki na mibu ya mbotama kobanda mibu tuku mibale mpe komata, kolanda mikumba mpe masanga na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bapesaki na bana mike nyonso, na basi, na bana mibali mpe na bana basi ya lisanga mobimba, ba-oyo bakombo na bango ekomamaki kati na buku ya milongo ya mbotama, pamba te bazalaki kokokisa na boyengebene mibeko ya libulisi mpo na kozala bule.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola ndenge ezalaki mpo na Banganga-Nzambe, bakitani ya Aron, oyo bazalaki kovanda na bamboka ya zingazinga ya bingumba na bango, bato baponamaki na bakombo mpo na kokabola biloko epai ya bato nyonso kati na Banganga-Nzambe mpe epai ya Balevi nyonso oyo bakomamaki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.18.5-2KI.18.7"
          },
          "items": [
            {
              "text": "2Ba 18.5-7",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali boye nde Ezekiasi asalaki kati na mokili na ye mobimba ya Yuda. Asalaki makambo ya malamu, ya sembo mpe ya solo na miso ya Yawe, Nzambe na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na nyonso oyo Ezekiasi asalaki, ezala mpo na mosala ya Ndako ya Nzambe to mpo na botosi mibeko mpe mitindo, azalaki koluka Nzambe na ye mpe kosala na motema na ye mobimba ; mpe azalaki kolonga na makambo nyonso oyo azalaki kosala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
