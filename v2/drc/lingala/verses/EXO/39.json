      "attrs": {
        "style": "li1",
        "vid": "EXO 39:40"
      },
      "items": [
        {
          "text": "bisalelo nyonso mpo na mosala ya Mongombo, Ndako ya kapo ya Bokutani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
