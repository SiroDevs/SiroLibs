          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "batapi ya lopango, makonzi na yango, makolo na yango, rido mpo na ekotelo ya lopango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        }
      ]
    },
