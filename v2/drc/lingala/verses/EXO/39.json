      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 39:40"
      },
      "items": [
        {
          "text": "basinga na yango, bapike na yango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        }
      ]
    },
