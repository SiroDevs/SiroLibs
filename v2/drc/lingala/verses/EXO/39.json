          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "mesa, bisalelo na yango nyonso mpe mapa oyo esengeli kozala liboso ya Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        }
      ]
    },
    {
