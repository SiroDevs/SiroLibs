          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "etumbelo esalema na bronze, motalaka na yango ya bronze, mabaya ya komemela yango mpe bisalelo na yango nyonso, sani ya bronze mpe evandelo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
