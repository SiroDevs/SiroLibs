      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Bilamba ya Banganga-Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batongaki na langi ya ble, ya motane ya pete mpe ya motane makasi bilamba ya mosala ya bonganga-Nzambe kati na Mongombo ; batongaki mpe bilamba ya bule mpo na Aron, ndenge kaka Yawe atindaki yango na Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elamba ya likolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betisaleyeli atongaki efode ya wolo, ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo batongaki bililingi na likolo na yango ; asalaki yango kitoko penza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batandaki mabende mike-mike ya wolo, bakataki-kataki yango lokola basinga mpe bakotisaki kati na langi ya ble mpe ya motane ya pete, langi ya motane makasi mpe lino ya kitoko ; ezalaki mosala ya bato oyo basalaka bililingi na maboko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.3",
            "verseOrgIds": [
              "EXO.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki bankamba mibale na basuka na yango mibale mpo na kolata efode yango ; bankamba elekaki likolo ya mapeka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.4",
            "verseOrgIds": [
              "EXO.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokaba ya efode esalemaki lolenge moko na efode : ezalaki ya wolo, ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo batongaki bililingi na likolo na yango, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abongisaki mabanga ya onikisi, mpe bakangaki yango na bikangelo ya wolo ; akomaki likolo na yango bakombo ya bana mibali ya Isalaele, ndenge basalaka bililingi na kashe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki yango na bankamba ya efode lokola mabanga ya ekaniseli mpo na bana mibali ya Isalaele, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elamba ya tolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betisaleyeli asalaki elamba ya tolo ; esalemaki kitoko penza. Atongaki yango ndenge moko na efode : ezalaki ya wolo, ya langi ya ble, ya motane ya pete, ya motane makasi mpe na lino ya kitoko oyo batongaki bililingi na likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.8",
            "verseOrgIds": [
              "EXO.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agumbaki yango na biteni mibale ; molayi mpe mokuse ezalaki ndenge moko, basantimetele pene tuku mibale na mitano.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.9",
            "verseOrgIds": [
              "EXO.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki milongo minei ya mabanga ya talo na likolo ya elamba ya tolo : na molongo ya liboso, libanga ya saridwane, ya topaze mpe ya emerode.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na molongo ya mibale, libanga ya ribisi, ya safiri mpe ya diama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na molongo ya misato, libanga ya opale, ya agate mpe ya ametisite ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.12",
            "verseOrgIds": [
              "EXO.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na molongo ya minei, libanga ya krizolite, ya onikisi mpe ya jasipe. Akangaki mabanga yango na bikangelo ya wolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabanga yango ezalaki zomi na mibale kolanda bakombo ya bana mibali ya Isalaele. Na likolo ya libanga moko na moko, bakomaki kombo ya moko kati na mabota zomi na mibale ; bakomaki yango ndenge basalaka bililingi na kashe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.14",
            "verseOrgIds": [
              "EXO.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki basheneti ya wolo ya peto mpo na elamba ya tolo ; basalaki yango ndenge bakangaka suki ya maboko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.15",
            "verseOrgIds": [
              "EXO.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki bikangelo mibale ya wolo mpe bapete mibale ya wolo mpe bakangisaki yango na basonge mibale ya elamba ya tolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.16",
            "verseOrgIds": [
              "EXO.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alekisaki basheneti mibale ya wolo kati na bapete mibale oyo atiaki na basonge mibale ya elamba ya tolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.17",
            "verseOrgIds": [
              "EXO.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akangisaki basonge mibale mosusu ya basheneti oyo mibale na bikangelo mibale oyo atiaki na bankamba ya efode ; bankamba yango elekaki na liboso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.18",
            "verseOrgIds": [
              "EXO.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki lisusu bapete mibale ya wolo mpe atiaki yango na basonge mibale ya se ya elamba ya tolo, na ngambo ya kati oyo etala efode.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.19",
            "verseOrgIds": [
              "EXO.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki bapete mosusu mibale ya wolo oyo atiaki na bankamba mibale ya efode, na se, na liboso mpe na pembeni ya mokaba ya efode.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.20",
            "verseOrgIds": [
              "EXO.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akangisaki na singa ya langi ya ble bapete ya wolo ya elamba ya tolo mpe bapete ya wolo ya efode, mpo ete elamba ya tolo ezala likolo ya efode mpe elongwa te na likolo na yango. Asalaki yango ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilamba mosusu ya Banganga-Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki nzambala oyo ezalaki na se ya efode : ezalaki ya langi ya ble na mobimba na yango, mpe ezalaki mosala ya bato oyo basalaka bilamba na maboko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.22",
            "verseOrgIds": [
              "EXO.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambala ezalaki na lidusu na kati-kati mpo na kokotisa moto ; batongaki pembeni-pembeni ya lidusu yango poso ya makasi mpo ete epasuka te.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na se mpe zingazinga ya nzambala, batiaki bambuma ya grenade bakangisa na singa ya langi ya ble, ya motane ya pete, ya motane makasi mpe na singa ya lino ya kitoko oyo batongaki bililingi na likolo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki na wolo ya peto bangonga ya mike-mike mpe batiaki yango kati na bagrenade, na se ya nzambala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balandisaki yango boye : ngonga moko ya moke, grenade moko, mpe bongo na bongo, zingazinga ya basonge nyonso ya nzambala mpo na mosala, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batongaki na lino ya kitoko, mpo na Aron mpe bana na ye ya mibali, banzambala,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bitendi ya lino ya kitoko mpo na moto, bikoti, bakaputula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe mikaba oyo batonga bililingi na likolo na yango na basinga ya lino ya langi ya ble, ya motane ya pete mpe ya motane makasi, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basalaki na wolo ya peto medaye lokola elembo ya libulisi na ye epai na Yawe mpe bakomaki na likolo na yango ndenge basalaka bililingi na kashe :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "EXO 39:30"
      },
      "items": [
        {
          "text": "abulisama mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiaki yango singa ya ble mpo na kokangisa yango na likolo ya kitendi ya moto, ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Misala ya kotonga Mongombo esili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye misala nyonso ya Mongombo, ya Ndako ya kapo ya Bokutani, esilaki. Bana ya Isalaele basalaki misala nyonso ndenge kaka Yawe atindaki Moyize.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamemaki Mongombo epai ya Moyize, elongo na biloko na yango nyonso :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 39:33"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 39:33"
      },
      "items": [
        {
          "text": "ndako ya kapo mpe bibende na yango oyo ezali lokola ndobo, bikangelo na yango, mabaya na yango, makonzi mpe bivandelo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezipelo ya poso ya meme oyo bapakola langi ya motane, ezipelo ya poso ya nyama ya ebale mpe barido,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanduku ya Litatoli, mabaya ya komemela yango mpe mofinuku na yango,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
