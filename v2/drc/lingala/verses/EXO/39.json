              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "bilamba ya mosala ya bonganga-Nzambe mpo na kosala kati na Mongombo, bilamba ya bule mpo na Nganga-Nzambe Aron mpe bilamba ya mosala ya bonganga-Nzambe mpo na bana na ye ya mibali.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
