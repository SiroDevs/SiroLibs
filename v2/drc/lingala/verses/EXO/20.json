  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "EXO 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mibeko zomi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala maloba oyo Nzambe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Nazali Yawe, Nzambe na yo, oyo abimisaki yo wuta na mokili ya Ejipito epai wapi ozalaki na bowumbu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okozalaka na banzambe mosusu te, bobele Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.3",
            "verseOrgIds": [
              "EXO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomisalelaka te nzambe ya ekeko to bililingi ya biloko oyo ezali na likolo, na se to na mayi oyo ezali na se ya mabele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okogumbamelaka yango te mpe okosalelaka yango te, pamba te Ngai Yawe, Nzambe na yo, nazali Nzambe ya zuwa ; napesaka bana etumbu mpo na masumu ya batata kino na molongo ya misato mpe ya minei ya bato oyo bayinaka Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi natalisaka bolingo na Ngai kino na molongo ya nkoto epai ya bato oyo balingaka Ngai mpe babatelaka mibeko na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotangaka te na pamba Kombo ya Yawe, Nzambe na yo, pamba te Yawe akopesa etumbu na moto nyonso oyo akotanga Kombo na Ye na pamba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
            "verseOrgIds": [
              "EXO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanisaka mokolo ya Saba mpe bulisaka yango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.8",
            "verseOrgIds": [
              "EXO.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosalaka misala na yo nyonso mikolo motoba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi mokolo ya sambo ezali mokolo ya Saba ya Yawe, Nzambe na yo. Na mokolo wana, okosalaka mosala ata moko te ; ezala yo, mwana na yo ya mobali, mwana na yo ya mwasi, mowumbu na yo ya mobali, mwasi mowumbu na yo, bibwele na yo to mopaya oyo azali kati na bingumba na yo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te na mikolo motoba, Yawe asalaki Likolo, mabele, ebale monene mpe nyonso oyo ezali kati na yango, kasi akataki mosala na mokolo ya sambo. Yango wana, Yawe apambolaki mokolo ya Saba mpe abulisaki yango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okopesaka tata na yo mpe mama na yo lokumu mpo ete ozala na bomoi ya molayi kati na mokili oyo Yawe, Nzambe na yo, azali kopesa yo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobomaka te.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.13",
            "verseOrgIds": [
              "EXO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okosalaka ekobo te.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.14",
            "verseOrgIds": [
              "EXO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoyibaka te.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.15",
            "verseOrgIds": [
              "EXO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okolobaka te matatoli ya lokuta mpo na kokosela moninga na yo makambo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.16",
            "verseOrgIds": [
              "EXO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okolulaka te ndako ya moninga na yo ; okolulaka te mwasi ya moninga na yo, mowumbu na ye ya mobali to mwasi mowumbu na ye, ngombe na ye, ane na ye to eloko nyonso oyo ezali ya moninga na yo. »",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moyize alobeli bato epai ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bato bayokaki bakake mpe koganga ya kelelo, mpe bamonaki mikalikali mpe milinga kobima na ngomba, balengaki. Batelemaki mosika",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe balobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "EXO 20:19"
      },
      "items": [
        {
          "text": "— Tika ete yo moko oloba na biso, mpe tokoyoka yo ; kasi Nzambe te, noki te tokokufa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "EXO 20:20"
      },
      "items": [
        {
          "text": "— Bobanga te ! Nzambe ayei nde komeka bino mpo ete kobanga Nzambe ezala kati na bino mpe bosala masumu te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bazalaki kaka mosika, wana Moyize apusanaki pembeni ya lipata oyo kati na yango Nzambe azalaki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Banzambe ya bikeko mpe bitumbelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na Moyize :",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "EXO 20:22"
      },
      "items": [
        {
          "text": "— Yebisa makambo oyo epai ya bana ya Isalaele : « Bomonaki bino moko ndenge nini nalobelaki bino wuta na likolo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokomisalela te banzambe ya bikeko ya palata to ya wolo, mpo na kosangisa yango na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okotongela Ngai etumbelo ya mabele epai wapi okobonza bambeka na yo ya kotumba, bambeka na yo ya boyokani, meme na yo, ntaba na yo, ngombe na yo. Esika nyonso oyo nakomimonisa mpo na lokumu ya Kombo na Ngai, nakoya epai na yo mpe nakopambola yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki otongeli Ngai etumbelo ya mabanga, okotonga yango te na mabanga oyo bakata ; pamba te soki okati yango, okobebisa bosantu na yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okomata te na etumbelo na Ngai na ematelo mpo ete bolumbu na yo emonana te. »",
          "type": "text"
        }
      ]
    }
  ],
