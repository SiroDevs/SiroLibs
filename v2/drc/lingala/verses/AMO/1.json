      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "mpe azali koloba wuta na Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
