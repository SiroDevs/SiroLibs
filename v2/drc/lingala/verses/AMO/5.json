          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh libota ya Isalaele, boyoka maloba oyo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:1"
      },
      "items": [
        {
          "text": "eleli oyo nazali koloba na tina na bino :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Isalaele, mboka kitoko, ekweyi na mabele,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "ezali kokoka kotelema lisusu te !",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "Basundoli yango kaka bongo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 5:2"
      },
      "items": [
        {
          "text": "mpe moto akotelemisa yango azali te. »",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
