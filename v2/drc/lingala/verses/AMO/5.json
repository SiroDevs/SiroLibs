          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Nkolo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
