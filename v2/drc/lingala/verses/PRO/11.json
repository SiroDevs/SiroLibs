          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bimekelo kilo ya lokuta ezali lokola makambo ya nkele",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:1"
      },
      "items": [
        {
          "text": "na miso ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:1"
      },
      "items": [
        {
          "text": "kasi kilo ya sembo ezali elengi na miso na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango lolendo eyaka, soni mpe eyaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:2"
      },
      "items": [
        {
          "text": "kasi bwanya ezali elongo na bato oyo bamikitisaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyengebene ya bato ya sembo etambolisaka bango,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:3"
      },
      "items": [
        {
          "text": "kasi mayele mabe ya bato oyo batambolaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:3"
      },
      "items": [
        {
          "text": "na boyengebene te ebebisaka bango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
