      "attrs": {
        "style": "q2",
        "vid": "PRO 11:7"
      },
      "items": [
        {
          "text": "boye, elikya nyonso oyo etiami na bomengo na ye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:7"
      },
      "items": [
        {
          "text": "mpe ekufi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
