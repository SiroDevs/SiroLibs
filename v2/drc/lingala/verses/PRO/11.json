        {
          "text": "Moto oyo atiolaka moninga na ye azangi mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
