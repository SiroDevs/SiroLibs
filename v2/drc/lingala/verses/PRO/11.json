          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 11:6"
      },
      "items": [
        {
          "text": "kasi bato oyo batambolaka na boyengebene te",
