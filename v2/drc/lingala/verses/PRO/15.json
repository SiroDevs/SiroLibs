          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyano ya kimia ekimisaka kanda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:1"
      },
      "items": [
        {
          "text": "kasi maloba oyo ezokisaka ebakisaka kanda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolemo ya moto ya bwanya ekomisaka boyebi elengi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:2"
      },
      "items": [
        {
          "text": "kasi monoko ya bato oyo bazangi mayele",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:2"
      },
      "items": [
        {
          "text": "ebimisaka bozoba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miso na Yawe ezalaka bisika nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:3"
      },
      "items": [
        {
          "text": "mpo na kotala bato mabe mpe bato ya malamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba ya kimia ezali lokola nzete ya bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:4"
      },
      "items": [
        {
          "text": "kasi maloba ya botomboki ezokisaka motema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo azangi mayele atiolaka mateya ya tata na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:5"
      },
      "items": [
        {
          "text": "kasi moto oyo andimaka pamela akokoma mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaka na bomengo ebele kati na ndako ya moyengebene,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:6"
      },
      "items": [
        {
          "text": "kasi lifuti ya moto mabe ememaka pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibebu ya moto ya bwanya esopaka boyebi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:7"
      },
      "items": [
        {
          "text": "kasi ezali bongo te na motema ya zoba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
