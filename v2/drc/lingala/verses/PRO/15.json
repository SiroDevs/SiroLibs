      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:8"
      },
      "items": [
        {
          "text": "kasi libondeli ya moto ya sembo esepelisaka Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
