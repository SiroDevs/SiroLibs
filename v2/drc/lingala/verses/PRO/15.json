          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 15:11"
      },
      "items": [
        {
          "text": "ndenge wana mpe mitema ya bana ya bato",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
