      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:9"
      },
      "items": [
        {
          "text": "kasi alingaka moto oyo alandaka nzela ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
