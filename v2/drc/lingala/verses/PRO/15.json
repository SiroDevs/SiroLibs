          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeka ya moto mabe ezalaka nkele na miso ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
