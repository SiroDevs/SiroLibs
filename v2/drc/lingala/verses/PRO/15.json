      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:10"
      },
      "items": [
        {
          "text": "moto oyo aboyaka pamela akokufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
