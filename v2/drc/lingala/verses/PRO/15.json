      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:13"
      },
      "items": [
        {
          "text": "kasi motema ya mawa elembisaka molimo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
