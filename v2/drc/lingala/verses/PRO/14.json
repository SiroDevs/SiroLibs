        "style": "c",
        "sid": "PRO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi ya bwanya atongaka ndako na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:1"
      },
      "items": [
        {
          "text": "kasi mwasi oyo azangi mayele abukaka yango",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:1"
      },
      "items": [
        {
          "text": "na maboko na ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo atambolaka alima atosaka Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:2"
      },
      "items": [
        {
          "text": "kasi moto oyo nzela na ye etengama-tengama atiolaka Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na monoko ya moto oyo azangi mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:3"
      },
      "items": [
        {
          "text": "ezalaka na nzete ya lolendo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:3"
      },
      "items": [
        {
          "text": "kasi bibebu ya moto ya bwanya ebatelaka ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esika oyo ezalaka na ngombe te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:4"
      },
      "items": [
        {
          "text": "elielo mpe ezalaka na eloko te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:4"
      },
      "items": [
        {
          "text": "pamba te ezali makasi ya bangombe nde epesaka bomengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motatoli ya sembo akosaka te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:5"
      },
      "items": [
        {
          "text": "kasi motatoli ya mabe alobaka lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motioli alukaka bwanya mpe azwaka yango te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:6"
      },
      "items": [
        {
          "text": "kasi boyebi eyaka na pete epai na moto ya mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zala mosika ya zoba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:7"
      },
      "items": [
        {
          "text": "pamba te okotikala kozwa boyebi te na bibebu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanya ya moto ya mayele esosolisaka ye nzela na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:8"
      },
      "items": [
        {
          "text": "kasi bozoba ya bato oyo bazangi mayele : lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoba balingaka te kosenga bolimbisi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:9"
      },
      "items": [
        {
          "text": "kasi ngolu na Nzambe ezalaka kati na bato ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema eyebaka pasi na yango moko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:10"
      },
      "items": [
        {
          "text": "moko te akoki kokabola na yango esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndako ya moto mabe ekobukana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:11"
      },
      "items": [
        {
          "text": "kasi ndako ya kapo ya bayengebene ekofuluka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzela mosusu emonanaka sembo na miso ya bato,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:12"
      },
      "items": [
        {
          "text": "nzokande, na suka, ememaka na kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala kati na koseka, motema ekoki kozala na mawa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:13"
      },
      "items": [
        {
          "text": "mpe esengo ekoki kosuka na mawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batambolaka na boyengebene te",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "bakozwa lifuti kolanda misala na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "kasi moto ya sembo mpe akozwa lifuti",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "kolanda misala na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo azangi mayele andimaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:15"
      },
      "items": [
        {
          "text": "makambo nyonso oyo balobaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 14:15"
      },
      "items": [
        {
          "text": "kasi moto ya mayele atambolaka na bokebi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
