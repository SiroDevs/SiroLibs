  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PRO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komikumisa te mpo na mokolo ya lobi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:1"
      },
      "items": [
        {
          "text": "pamba te oyebi te likambo nini mokolo ekoki kobota.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto mosusu akumisa yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "kasi monoko na yo moko te ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "tika ete mopaya akumisa yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "kasi bibebu na yo moko te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libanga mpe zelo ezalaka kilo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:3"
      },
      "items": [
        {
          "text": "kasi kanda ya zoba ezalaka kilo koleka nyonso mibale.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotomboka ememaka makambo ya somo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "mpe kanda ebebisaka ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "kasi nani akoki kotelema liboso ya zuwa ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamela oyo epesami na polele ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:5"
      },
      "items": [
        {
          "text": "koleka moto oyo aboyi kopamela mpo na bolingo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapota oyo molingami azokisi ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:6"
      },
      "items": [
        {
          "text": "koleka babeze ebele ya monguna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo atondi aboyaka ata mafuta ya nzoyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "kasi moto oyo azali na nzala",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "ayokaka ata bilei ya bololo elengi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo ayengaka-yengaka mosika ya mokili na ye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "azali lokola ndeke oyo ezali koyengayenga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "mosika ya zala na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuta mpe malasi esepelisaka motema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "mpe molingami malamu apesaka toli na motema ya esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosundola te molingami na yo to molingami ya tata na yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "mpe kokende te na ndako ya ndeko na yo tango ozali na pasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "kozala na molingami ya pembeni ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "koleka kozala na ndeko ya mosika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, zala moto ya bwanya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "mpe sepelisa motema na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "mpo ete nazala na eyano ya kopesa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "na moto oyo akoluka kotiola ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya mayele amonaka likama na mosika",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "mpe amibombaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "kasi moto oyo azangi mayele alekaka kaka wana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "mpe akutanaka na pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamata elamba ya moto oyo alapi ndayi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "mpo na niongo ya moto mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "bomba yango lokola ndanga",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "soki alapi ndayi mpo na mwasi mopaya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
