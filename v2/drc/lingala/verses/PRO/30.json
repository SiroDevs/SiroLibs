        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge mwasi ya ndumba asalaka :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "Soki alie, apangusaka monoko ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "mpe na sima, akoloba : « Nasali na ngai mabe te ! »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
