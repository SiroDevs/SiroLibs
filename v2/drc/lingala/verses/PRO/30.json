      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "nzela ya nyoka na likolo ya libanga,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "nzela ya masuwa kati na ebale,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "mpe nzela ya elenge mobali epai ya elenge mwasi.",
          "type": "text"
        }
