      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "minei oyo elobaka te : « Ekoki ! »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
