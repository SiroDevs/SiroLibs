      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "mpe bana ya mpongo ekolia yango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
