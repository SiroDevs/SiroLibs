      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:18"
      },
      "items": [
        {
          "text": "ata kutu minei oyo nayebaka te :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.18",
            "verseOrgIds": [
              "PRO.30.18"
            ]
          }
        }
      ]
    },
    {
