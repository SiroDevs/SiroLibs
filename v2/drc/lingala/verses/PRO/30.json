      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "ekotobolama na bayanganga ya lubwaku,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
