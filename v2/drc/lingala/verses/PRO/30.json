      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:16"
      },
      "items": [
        {
          "text": "mpe moto oyo elobaka te : « Ekoki ! »",
          "type": "text"
        }
      ]
    },
    {
